4955   
4956  *=============================== Energy =====================================================================
4957   TREND(z,time) = 1;
4958   
4959   valAEEI(z,time,'NZS')                  = AEEI(z,time);
4960   
4961   valEE(p_coal,j,z,time,'NZS')           =  EEI(p_coal,j,z)*TREND(z,time)*DE.L('02_COAL',j,z,time)*AEEI(z,time);
4962   valEE(p_oil,j,z,time,'NZS')            =  EEI(p_oil,j,z)*TREND(z,time)*DE.L('03_OIL',j,z,time)*AEEI(z,time);
4963   valEE(p_gas,j,z,time,'NZS')            =  EEI(p_gas,j,z)*TREND(z,time)*DE.L('04_GAS',j,z,time)*AEEI(z,time);
4964   valEE(p_oilproduct,j,z,time,'NZS')     =  EEI(p_oilproduct,j,z)*TREND(z,time)*DE.L('10_PETROLCOAL',j,z,time)*AEEI(z,time);
4965   valEE(p_elecheat,j,z,time,'NZS')       =  EEI(p_elecheat,j,z)*TREND(z,time)*DE.L('18_ELEC',j,z,time)*AEEI(z,time);
4966   
4967   valNE(p_coal,j,z,time,'NZS')           =  NEI(p_coal,j,z)*TREND(z,time)*DE.L('02_COAL',j,z,time)*AEEI(z,time);
4968   valNE(p_oil,j,z,time,'NZS')            =  NEI(p_oil,j,z)*TREND(z,time)*DE.L('03_OIL',j,z,time)*AEEI(z,time);
4969   valNE(p_gas,j,z,time,'NZS')            =  NEI(p_gas,j,z)*TREND(z,time)*DE.L('04_GAS',j,z,time)*AEEI(z,time);
4970   valNE(p_oilproduct,j,z,time,'NZS')     =  NEI(p_oilproduct,j,z)*TREND(z,time)*DE.L('10_PETROLCOAL',j,z,time)*AEEI(z,time);
4971   valNE(p_elecheat,j,z,time,'NZS')       =  NEI(p_elecheat,j,z)*TREND(z,time)*DE.L('18_ELEC',j,z,time)*AEEI(z,time);
4972   
4973   valEH(p_coal,z,time,'NZS')             =  EHI(p_coal,z)*TREND(z,time)*C.L('02_COAL',z,time)*AEEI(z,time);
4974   valEH(p_oil,z,time,'NZS')              =  EHI(p_oil,z)*TREND(z,time)*C.L('03_OIL',z,time)*AEEI(z,time);
4975   valEH(p_gas,z,time,'NZS')              =  EHI(p_gas,z)*TREND(z,time)*C.L('04_GAS',z,time)*AEEI(z,time);
4976   valEH(p_oilproduct,z,time,'NZS')       =  EHI(p_oilproduct,z)*TREND(z,time)*C.L('10_PETROLCOAL',z,time)*AEEI(z,time);
4977   valEH(p_elecheat,z,time,'NZS')         =  EHI(p_elecheat,z)*TREND(z,time)*C.L('18_ELEC',z,time)*AEEI(z,time);
4978   
4979   valTFC_product(product,time,z,'NZS')   = valEH(product,z,time,'NZS') + Sum(j5,valEE(product,j5,z,time,'NZS'))+Sum(j,valNE(product,j,z,time,'NZS'));
4980   
4981   valTFC(time,z,'NZS')                   = sum(product, valEH(product,z,time,'NZS') + Sum(j5,valEE(product,j5,z,time,'NZS'))+Sum(j,valNE(product,j,z,time,'NZS')));
4982   valNEA_TFC(product,time,'NZS')         = sum(NEA,valEH(product,NEA,time,'NZS')) + Sum((j5,NEA),valEE(product,j5,NEA,time,'NZS'))+Sum((j,NEA),valNE(product,j,NEA,time,'NZS'));
4983   valKOR_TFC(product,time,'NZS')         = valEH(product,'01_KOR',time,'NZS') + Sum(j5,valEE(product,j5,'01_KOR',time,'NZS'))+Sum(j,valNE(product,j,'01_KOR',time,'NZS'));
4984   valCHN_TFC(product,time,'NZS')         = valEH(product,'02_CHN',time,'NZS') + Sum(j5,valEE(product,j5,'02_CHN',time,'NZS'))+Sum(j,valNE(product,j,'02_CHN',time,'NZS'));
4985   valJPN_TFC(product,time,'NZS')         = valEH(product,'03_JPN',time,'NZS') + Sum(j5,valEE(product,j5,'03_JPN',time,'NZS'))+Sum(j,valNE(product,j,'03_JPN',time,'NZS'));
4986   
4987  *============================== CO2 ========================================================================
4988   valCO2I(product,j,z,time,'NZS')        = valEE(product,j,z,time,'NZS')*41.868*GHGsEF(product,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
4989   valCO2NE(product,j,z,time,'NZS')       = valNE(product,j,z,time,'NZS')*41.868*GHGsEF(product,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF')*(1-GHGsEF(product,'Stored_rate')) ;
4990   valCO2I2(j,z,time,'NZS')               = sum(product,valCO2I(product,j,z,time,'NZS'));
4991   valCO2NE2(j,z,time,'NZS')              = sum(product,valCO2NE(product,j,z,time,'NZS'));
4992   valCO2I3(j,z,time,'NZS')               = valCO2I2(j,z,time,'NZS') + valCO2NE2(j,z,time,'NZS') ;
4993   valTCO2I(z,time,'NZS')                 = sum((product,j),valCO2I(product,j,z,time,'NZS'));
4994   valTCO2NE(z,time,'NZS')                = sum((product,j),valCO2NE(product,j,z,time,'NZS'));
4995   valCO2H(product,z,time,'NZS')          = valEH(product,z,time,'NZS')*41.868*GHGsEF(product,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
4996   valTCO2H(z,time,'NZS')                 = sum((product),valCO2H(product,z,time,'NZS'));
4997   valTCO2(z,time,'NZS')                  = valTCO2H(z,time,'NZS') + valTCO2I(z,time,'NZS') +valTCO2NE(z,time,'NZS') ;
4998   valEndo_CO2(ene,j,z,time,'NZS')        = DE.L(ene,j,z,time)*CO2FACTOR2(ene,j,z,time)*10*1000;
4999   valEndo_TotalCO2(z,time,'NZS')         = sum((ene,j), valEndo_CO2(ene,j,z,time,'NZS'));
5000   
5001  *============================== CH4 =======================================================================
5002   valCH4I(product,j,z,time,'NZS')        = valEE(product,j,z,time,'NZS')*41.868*GHGsEF(product,'CH4EF')/10**6 ;
5003   valCH4H(product,z,time,'NZS')          = valEH(product,z,time,'NZS')*41.868*GHGsEF(product,'CH4EF')/10**6 ;
5004   valCH4I2(j,z,time,'NZS')               = sum(product, valCH4I(product,j,z,time,'NZS'));
5005   valTCH4I(z,time,'NZS')                 = sum(j, valCH4I2(j,z,time,'NZS'));
5006   valTCH4H(z,time,'NZS')                 = sum(product,valCH4H(product,z,time,'NZS'));
5007   valTCH4(z,time,'NZS')                  = valTCH4I(z,time,'NZS')+ valTCH4H(z,time,'NZS') ;
5008   valTCH4_CO2eq(z,time,'NZS')            = valTCH4(z,time,'NZS')*GWP('CH4EF');
5009   
5010  *============================== N2O ========================================================================
5011   valN2OI(product,j,z,time,'NZS')        = valEE(product,j,z,time,'NZS')*41.868*GHGsEF(product,'N2OEF')/10**6 ;
5012   valN2OH(product,z,time,'NZS')          = valEH(product,z,time,'NZS')*41.868*GHGsEF(product,'N2OEF')/10**6 ;
5013   valN2OI2(j,z,time,'NZS')               = sum(product, valN2OI(product,j,z,time,'NZS'));
5014   valTN2OI(z,time,'NZS')                 = sum(j, valN2OI2(j,z,time,'NZS'));
5015   valTN2OH(z,time,'NZS')                 = sum(product,valN2OH(product,z,time,'NZS'));
5016   valTN2O(z,time,'NZS')                  = valTN2OI(z,time,'NZS')+ valTN2OH(z,time,'NZS') ;
5017   valTN2O_CO2eq(z,time,'NZS')            = valTN2O(z,time,'NZS')*GWP('N2OEF');
5018   
5019  *============================= Global GHGs emission =============================================
5020   valGlobal_CO2(time,'NZS')              = sum(z, valTCO2(z,time,'NZS'));
5021   valGlobal_CH4(time,'NZS')              = sum(z, valTCH4(z,time,'NZS'));
5022   valGlobal_N2O(time,'NZS')              = sum(z, valTN2O(z,time,'NZS'));
5023   valGlobal_CO2eq(time,'NZS')            = valGlobal_CO2(time,'NZS')+valGlobal_CH4(time,'NZS')*GWP('CH4EF')+valGlobal_N2O(time,'NZS')*GWP('N2OEF');
5024   
5025   valGHG('CO2',z,time,'NZS')             = valTCO2(z,time,'NZS');
5026   valGHG('CH4',z,time,'NZS')             = valTCH4_CO2eq(z,time,'NZS');
5027   valGHG('N2O',z,time,'NZS')             = valTN2O_CO2eq(z,time,'NZS');
5028   
5029  *============================== Power Generation ============================================
5030   valPOWER(power,i,z,time,scen)          = XS.l(power,i,z,time);
5031   valElecGen('19_eNuclear',z,time,'NZS') = DS.l('19_eNuclear','18_ELEC',z,time)*EGINucGWh('19_eNuclear',z);
5032   valElecGen('20_eCoal',z,time,'NZS')    = DS.l('20_eCoal','18_ELEC',z,time)*EGICoalGWh('20_eCoal',z);
5033   valElecGen('21_eGas',z,time,'NZS')     = DS.l('21_eGas','18_ELEC',z,time)*EGIGasGWh('21_eGas',z);
5034   valElecGen('22_eOil',z,time,'NZS')     = DS.l('22_eOil','18_ELEC',z,time)*EGIOilGWh('22_eOil',z);
5035   valElecGen('23_eWind',z,time,'NZS')    = DS.l('23_eWind','18_ELEC',z,time)*EGIWindGWh('23_eWind',z);
5036   valElecGen('24_eSolar',z,time,'NZS')   = DS.l('24_eSolar','18_ELEC',z,time)*EGISolarGWh('24_eSolar',z);
5037   valElecGen('25_eHydro',z,time,'NZS')   = DS.l('25_eHydro','18_ELEC',z,time)*EGIHydroGWh('25_eHydro',z);
5038   valElecGen('26_eOther',z,time,'NZS')   = DS.l('26_eOther','18_ELEC',z,time)*EGIOtherGWh('26_eOther',z);
5039   
5040  *============================== Carbon Tax ============================================
5041   valCTAX(z,time,'NZS') = CTAX.l(z,time) ;
5042   
5043  *================== Backstop technology ===========================================================
5044   valswitch(i3,z,time,'NZS') = switch(i3,z,time) ;
5045   valpenetration_rate(i3,z,time,'NZS') = penetration_rate(i3,z,time) ;
5046   valC_Conventional(i3,z,time,'NZS') = C_Conventional.l(i3,z,time) ;
5047   valXDBS(i3,z,time,'NZS')  = XDBS.l(i3,z,time) ;
5048   valXDBS2(j,z,time,'NZS')  = XDBS2.l(j,z,time) ;
5049   valLBS(l,j,z,time,'NZS')  = LBS.l(l,j,z,time) ;
5050   valKBS(k,j,z,time,'NZS')  = KBS.l(k,j,z,time) ;
5051   valCLBS(i3,z,time,'NZS')  = CLBS.l(i3,z,time) ;
5052   valCKBS(i3,z,time,'NZS')  = CKBS.l(i3,z,time) ;
5053   valMARKUP(i3,z,time,'NZS')= MARKUP.l(i3,z,time) ;
