4617  *==============================================================================
4618  *   6.2.2.3 Resolution
4619  *==============================================================================
4620   
4621  SOLVE PEPWT USING CNS;
4622  *SOLVE PEPWT using NLP maximizing OBJ;
4623  *SOLVE PEPWT USING MCP;
4624   
4625  *==============================================================================
4626  *   Taking account of the existence or not of a feasible solution
4627  *==============================================================================
4628   If_Feasibl(time,'NZS') = PEPWT.modelstat;
4629   StatSolver(time,'NZS') = PEPWT.solvestat;
4630   
4631   Solstop = 1$(PEPWT.modelstat ne 16);
4632   LastGood('NZS')$(PEPWT.modelstat ne 16)= (time.val-1);
4633   
4634   put Status;
4635   put 'NZS', time.val, 'Optimality status', PEPWT.Tmodstat, 'Solver status', PEPWT.Tsolstat  /;
4636   
4637  * The single element in subset T(time) is removed, and the subset is now empty.
4638  T(time)          = NO;
4639  * End of LOOP over time periods
4640  ];
