7585   
7586  *=============================== Energy =====================================================================
7587   
7588   valAEEI(z,time,'NZS')                  = AEEI(z,time);
7589   
7590   valEE(p_coal,j,z,time,'NZS')           =  EEI(p_coal,j,z)*DE.L('02_COAL',j,z,time)*AEEI(z,time);
7591   valEE(p_oil,j,z,time,'NZS')            =  EEI(p_oil,j,z)*DE.L('03_OIL',j,z,time)*AEEI(z,time);
7592   valEE(p_gas,j,z,time,'NZS')            =  EEI(p_gas,j,z)*DE.L('04_GAS',j,z,time)*AEEI(z,time);
7593   valEE(p_oilproduct,j,z,time,'NZS')     =  EEI(p_oilproduct,j,z)*DE.L('10_PETROLCOAL',j,z,time)*AEEI(z,time);
7594   valEE(p_elecheat,j,z,time,'NZS')       =  EEI(p_elecheat,j,z)*DE.L('18_ELEC',j,z,time)*AEEI(z,time);
7595   
7596   valNE(p_coal,j,z,time,'NZS')           =  NEI(p_coal,j,z)*DE.L('02_COAL',j,z,time)*AEEI(z,time);
7597   valNE(p_oil,j,z,time,'NZS')            =  NEI(p_oil,j,z)*DE.L('03_OIL',j,z,time)*AEEI(z,time);
7598   valNE(p_gas,j,z,time,'NZS')            =  NEI(p_gas,j,z)*DE.L('04_GAS',j,z,time)*AEEI(z,time);
7599   valNE(p_oilproduct,j,z,time,'NZS')     =  NEI(p_oilproduct,j,z)*DE.L('10_PETROLCOAL',j,z,time)*AEEI(z,time);
7600   valNE(p_elecheat,j,z,time,'NZS')       =  NEI(p_elecheat,j,z)*DE.L('18_ELEC',j,z,time)*AEEI(z,time);
7601   
7602   valEH(p_coal,z,time,'NZS')             =  EHI(p_coal,z)*C.L('02_COAL',z,time)*AEEI(z,time);
7603   valEH(p_oil,z,time,'NZS')              =  EHI(p_oil,z)*C.L('03_OIL',z,time)*AEEI(z,time);
7604   valEH(p_gas,z,time,'NZS')              =  EHI(p_gas,z)*C.L('04_GAS',z,time)*AEEI(z,time);
7605   valEH(p_oilproduct,z,time,'NZS')       =  EHI(p_oilproduct,z)*C.L('10_PETROLCOAL',z,time)*AEEI(z,time);
7606   valEH(p_elecheat,z,time,'NZS')         =  EHI(p_elecheat,z)*C.L('18_ELEC',z,time)*AEEI(z,time);
7607   
7608   valTFC_product(product,time,z,'NZS')   = valEH(product,z,time,'NZS') + Sum(j5,valEE(product,j5,z,time,'NZS'))+Sum(j,valNE(product,j,z,time,'NZS'));
7609   
7610   valTFC(time,z,'NZS')                   = sum(product, valEH(product,z,time,'NZS') + Sum(j5,valEE(product,j5,z,time,'NZS'))+Sum(j,valNE(product,j,z,time,'NZS')));
7611   valNEA_TFC(product,time,'NZS')         = sum(NEA,valEH(product,NEA,time,'NZS')) + Sum((j5,NEA),valEE(product,j5,NEA,time,'NZS'))+Sum((j,NEA),valNE(product,j,NEA,time,'NZS'));
7612   valKOR_TFC(product,time,'NZS')         = valEH(product,'01_KOR',time,'NZS') + Sum(j5,valEE(product,j5,'01_KOR',time,'NZS'))+Sum(j,valNE(product,j,'01_KOR',time,'NZS'));
7613   valCHN_TFC(product,time,'NZS')         = valEH(product,'02_CHN',time,'NZS') + Sum(j5,valEE(product,j5,'02_CHN',time,'NZS'))+Sum(j,valNE(product,j,'02_CHN',time,'NZS'));
7614   valJPN_TFC(product,time,'NZS')         = valEH(product,'03_JPN',time,'NZS') + Sum(j5,valEE(product,j5,'03_JPN',time,'NZS'))+Sum(j,valNE(product,j,'03_JPN',time,'NZS'));
7615   
7616   valTES_coal(z,time,'NZS')             = sum(p_coal_TES,TES_coal(p_coal_TES,z))*[valQ('02_COAL',z,time,'NZS')/valQ('02_COAL',z,'2019','NZS')];
7617   valTES_oil(z,time,'NZS')              = sum(p_oil,TES_oil(p_oil,z))*[valQ('03_OIL',z,time,'NZS')/valQ('03_OIL',z,'2019','NZS')];
7618   valTES_gas(z,time,'NZS')              = sum(p_gas,TES_gas(p_gas,z))*[valQ('04_GAS',z,time,'NZS')/valQ('04_GAS',z,'2019','NZS')];
7619   valTES(z,time,'NZS')                  = valTES_coal(z,time,'NZS') + valTES_oil(z,time,'NZS') + valTES_gas(z,time,'NZS') ;
7620   
7621  *============================== CO2 ========================================================================================
7622   valCO2I(product,j,z,time,'NZS')        = valEE(product,j,z,time,'NZS')*41.868*GHGsEF(product,'CO2EF')*1*(44/12)*0.001 ;
7623   valCO2NE(product,j,z,time,'NZS')       = valNE(product,j,z,time,'NZS')*(1-GHGsEF(product,'Stored_rate'))*41.868*GHGsEF(product,'CO2EF')*1*(44/12)*0.001 ;
7624   valCO2I2(j,z,time,'NZS')               = sum(product,valCO2I(product,j,z,time,'NZS'));
7625   valCO2NE2(j,z,time,'NZS')              = sum(product,valCO2NE(product,j,z,time,'NZS'));
7626   valCO2I3(j,z,time,'NZS')               = valCO2I2(j,z,time,'NZS') + valCO2NE2(j,z,time,'NZS') ;
7627   valTCO2I(z,time,'NZS')                 = sum((product,j),valCO2I(product,j,z,time,'NZS'));
7628   valTCO2NE(z,time,'NZS')                = sum((product,j),valCO2NE(product,j,z,time,'NZS'));
7629   valCO2H(product,z,time,'NZS')          = valEH(product,z,time,'NZS')*41.868*GHGsEF(product,'CO2EF')*1*(44/12)*0.001 ;
7630   valTCO2H(z,time,'NZS')                 = sum((product),valCO2H(product,z,time,'NZS'));
7631   valTCO2(z,time,'NZS')                  = valTCO2H(z,time,'NZS') + valTCO2I(z,time,'NZS') +valTCO2NE(z,time,'NZS') ;
7632   
7633   valEndo_CO2(ene,j,z,time,'NZS')        = DE.L(ene,j,z,time)*CO2FACTOR2(ene,j,z,time)*10*1000;
7634   valEndo_TotalCO2(z,time,'NZS')         = sum((ene,j), valEndo_CO2(ene,j,z,time,'NZS'));
7635   
7636  *============================== CH4(CO2equivalent) =========================================================================
7637  *Energy
7638   valCH4I(product,Energy,z,time,'NZS')    = valEE(product,Energy,z,time,'NZS')*41.868*GHGsEF(product,'CH4EF_Energy')/10**6*GWP_CH4 ;
7639  *Industry
7640   valCH4I(product,IndCon,z,time,'NZS')    = valEE(product,IndCon,z,time,'NZS')*41.868*GHGsEF(product,'CH4EF_Industry')/10**6*GWP_CH4 ;
7641  *LTRP
7642   valCH4I(product,Roadrail,z,time,'NZS')  = valEE(product,Roadrail,z,time,'NZS')*41.868*GHGsEF(product,'CH4EF_LTRP')/10**6*GWP_CH4 ;
7643  *ATRP
7644   valCH4I(product,Air,z,time,'NZS')       = valEE(product,Air,z,time,'NZS')*41.868*GHGsEF(product,'CH4EF_ATRP')/10**6*GWP_CH4 ;
7645  *WTRP
7646   valCH4I(product,Water,z,time,'NZS')     = valEE(product,Water,z,time,'NZS')*41.868*GHGsEF(product,'CH4EF_WTRP')/10**6*GWP_CH4 ;
7647  *Other
7648   valCH4I(product,Other,z,time,'NZS')     = valEE(product,Other,z,time,'NZS')*41.868*GHGsEF(product,'CH4EF_Other')/10**6*GWP_CH4 ;
7649  *Household
7650   valCH4H(product,z,time,'NZS')           = valEH(product,z,time,'NZS')*41.868*GHGsEF(product,'CH4EF_Other')/10**6*GWP_CH4 ;
7651   
7652   valCH4I2(j,z,time,'NZS')                = sum(product,valCH4I(product,j,z,time,'NZS'));
7653   valCH4I3(j,z,time,'NZS')                = valCH4I2(j,z,time,'NZS') ;
7654   valTCH4I(z,time,'NZS')                  = sum((product,j),valCH4I(product,j,z,time,'NZS'));
7655   valTCH4H(z,time,'NZS')                  = sum((product),valCH4H(product,z,time,'NZS'));
7656   valTCH4(z,time,'NZS')                   = valTCH4H(z,time,'NZS') + valTCH4I(z,time,'NZS') ;
7657   
7658  *============================== N2O(CO2equivalent) ========================================================================
7659  *Energy
7660   valN2OI(product,Energy,z,time,'NZS')    = valEE(product,Energy,z,time,'NZS')*41.868*GHGsEF(product,'N2OEF_Energy')/10**6*GWP_N2O ;
7661  *Industry
7662   valN2OI(product,IndCon,z,time,'NZS')    = valEE(product,IndCon,z,time,'NZS')*41.868*GHGsEF(product,'N2OEF_Industry')/10**6*GWP_N2O ;
7663  *LTRP
7664   valN2OI(product,Roadrail,z,time,'NZS')  = valEE(product,Roadrail,z,time,'NZS')*41.868*GHGsEF(product,'N2OEF_LTRP')/10**6*GWP_N2O ;
7665  *ATRP
7666   valN2OI(product,Air,z,time,'NZS')       = valEE(product,Air,z,time,'NZS')*41.868*GHGsEF(product,'N2OEF_ATRP')/10**6*GWP_N2O ;
7667  *WTRP
7668   valN2OI(product,Water,z,time,'NZS')     = valEE(product,Water,z,time,'NZS')*41.868*GHGsEF(product,'N2OEF_WTRP')/10**6*GWP_N2O ;
7669  *Other
7670   valN2OI(product,Other,z,time,'NZS')     = valEE(product,Other,z,time,'NZS')*41.868*GHGsEF(product,'N2OEF_Other')/10**6*GWP_N2O ;
7671  *Household
7672   valN2OH(product,z,time,'NZS')           = valEH(product,z,time,'NZS')*41.868*GHGsEF(product,'N2OEF_Other')/10**6*GWP_N2O ;
7673   
7674   valN2OI2(j,z,time,'NZS')               = sum(product,valN2OI(product,j,z,time,'NZS'));
7675   valN2OI3(j,z,time,'NZS')               = valN2OI2(j,z,time,'NZS') ;
7676   valTN2OI(z,time,'NZS')                 = sum((product,j),valN2OI(product,j,z,time,'NZS'));
7677   valTN2OH(z,time,'NZS')                 = sum((product),valN2OH(product,z,time,'NZS'));
7678   valTN2O(z,time,'NZS')                  = valTN2OH(z,time,'NZS') + valTN2OI(z,time,'NZS') ;
7679   
7680  *============================= Global GHGs emission ========================================================
7681   valGlobal_CO2(time,'NZS')              = sum(z, valTCO2(z,time,'NZS'));
7682   valGlobal_CH4(time,'NZS')              = sum(z, valTCH4(z,time,'NZS'));
7683   valGlobal_N2O(time,'NZS')              = sum(z, valTN2O(z,time,'NZS'));
7684   
7685  *============================== Power Generation ============================================
7686   valPOWER(power,i,z,time,scen)          = XS.l(power,i,z,time);
7687   
7688   valElecGen('Nuclear',z,time,'NZS')    = XS.l('19_eNuclear','18_ELEC',z,time)*EGINucGWh('19_eNuclear',z);
7689   valElecGen('Coal',z,time,'NZS')       = XS.l('20_eCoal','18_ELEC',z,time)*EGICoalGWh('20_eCoal',z);
7690   valElecGen('Gas',z,time,'NZS')        = XS.l('21_eGas','18_ELEC',z,time)*EGIGasGWh('21_eGas',z);
7691   valElecGen('Oil',z,time,'NZS')        = XS.l('22_eOil','18_ELEC',z,time)*EGIOilGWh('22_eOil',z);
7692   valElecGen('Wind',z,time,'NZS')       = XS.l('23_eWind','18_ELEC',z,time)*EGIWindGWh('23_eWind',z);
7693   valElecGen('Solar',z,time,'NZS')      = XS.l('24_eSolar','18_ELEC',z,time)*EGISolarGWh('24_eSolar',z);
7694   valElecGen('Hydro',z,time,'NZS')      = XS.l('25_eHydro','18_ELEC',z,time)*EGIHydroGWh('25_eHydro',z);
7695   valElecGen('Waste',z,time,'NZS')      = XS.l('26_eOther','18_ELEC',z,time)*EGIWasteGWh('26_eOther',z);
7696   valElecGen('Bio',z,time,'NZS')        = XS.l('26_eOther','18_ELEC',z,time)*EGIBioGWh('26_eOther',z);
7697   valElecGen('Geothermal',z,time,'NZS') = XS.l('26_eOther','18_ELEC',z,time)*EGIGeoGWh('26_eOther',z);
7698   valElecGen('Other',z,time,'NZS')      = XS.l('26_eOther','18_ELEC',z,time)*EGIOtherGWh('26_eOther',z);
7699   
7700   valElecGen('Total',z,time,'NZS')      = valElecGen('Nuclear',z,time,'NZS') + valElecGen('Coal',z,time,'NZS')+ valElecGen('Gas',z,time,'NZS')
7701                                           + valElecGen('Oil',z,time,'NZS') + valElecGen('Wind',z,time,'NZS')+ valElecGen('Solar',z,time,'NZS')
7702                                           + valElecGen('Hydro',z,time,'NZS') + valElecGen('Waste',z,time,'NZS')+ valElecGen('Bio',z,time,'NZS')
7703                                           + valElecGen('Geothermal',z,time,'NZS') + valElecGen('Geothermal',z,time,'NZS') + valElecGen('Other',z,time,'NZS') ;
7704   
7705  *============================== Carbon Tax ============================================
7706   valCTAX(z,time,'NZS') = CTAX.l(z,time) ;
7707   
7708  *$Ontext
7709  *================== Backstop technology ===========================================================
7710   valswitch(i3,z,time,'NZS') = switch(i3,z,time) ;
7711   valpenetration_rate(i3,z,time,'NZS') = penetration_rate(i3,z,time) ;
7712   valC_Conventional(i3,z,time,'NZS') = C_Conventional.l(i3,z,time) ;
7713   valXDBS(i3,z,time,'NZS')  = XDBS.l(i3,z,time) ;
7714   valXDBS2(j,z,time,'NZS')  = XDBS2.l(j,z,time) ;
7715   valLBS(l,j,z,time,'NZS')  = LBS.l(l,j,z,time) ;
7716   valKBS(k,j,z,time,'NZS')  = KBS.l(k,j,z,time) ;
7717   valCLBS(i3,z,time,'NZS')  = CLBS.l(i3,z,time) ;
7718   valCKBS(i3,z,time,'NZS')  = CKBS.l(i3,z,time) ;
7719   valMARKUP(i3,z,time,'NZS')= MARKUP.l(i3,z,time) ;
7720  *$Offtext
7721   
7722   execute_unload 'Output_w-t\NZS_Results_GTAP11b.gdx',
