7232  *==============================================================================
7233  *   6.2.2.3 Resolution
7234  *==============================================================================
7235   
7236  SOLVE PEPWT USING CNS ;
7237  *SOLVE PEPWT USING NLP maximizing OBJ;
7238  *SOLVE PEPWT USING MCP;
7239   
7240  *==============================================================================
7241  *   Taking account of the existence or not of a feasible solution
7242  *==============================================================================
7243   If_Feasibl(time,'NZS') = PEPWT.modelstat;
7244   StatSolver(time,'NZS') = PEPWT.solvestat;
7245   
7246   Solstop = 1$(PEPWT.modelstat ne 16);
7247   LastGood('NZS')$(PEPWT.modelstat ne 16)= (time.val-1);
7248   
7249   put Status;
7250   put 'NZS', time.val, 'Optimality status', PEPWT.Tmodstat, 'Solver status', PEPWT.Tsolstat  /;
7251   
7252  * The single element in subset T(time) is removed, and the subset is now empty.
7253  T(time)          = NO;
7254  * End of LOOP over time periods
7255  ];
INCLUDE    C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.RD_CGE\NZS_RESULTS_GTAP11b.gms
