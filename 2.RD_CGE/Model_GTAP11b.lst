2853   CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*(1000/(10**8));
2854   
2855  * CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*10/100;
2856  * CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z) = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*10/100;
2857  * CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*10/100;
2858   
2859  *PetrolCoal
2860   CO2FACTOR('10_PETROLCOAL','10_PETROLCOAL',z) = 0;
2861   CO2FACTOR('02_COAL','10_PETROLCOAL',z) = CO2FACTOR('02_COAL','13_IRONSTL',z);
2862   
2863  *KOR
2864  * CO2FACTOR('02_COAL','10_PETROLCOAL','01_KOR') = 0;
2865  * CO2FACTOR(ene,'20_eCoal','01_KOR') =  CO2FACTOR(ene,'20_eCoal','03_JPN');
2866   
2867  *PRK
2868   CO2FACTOR('02_COAL','01_AGRICULT','06_PRK')        = CO2FACTOR('02_COAL','01_AGRICULT','05_MNG');
2869   CO2FACTOR('10_PETROLCOAL','01_AGRICULT','06_PRK')  = CO2FACTOR('10_PETROLCOAL','01_AGRICULT','05_MNG');
2870   CO2FACTOR('02_COAL','28_LTRP','06_PRK')            = CO2FACTOR('02_COAL','28_LTRP','05_MNG');
2871   CO2FACTOR('02_COAL','17_OTHERIND','06_PRK')        = CO2FACTOR('02_COAL','17_OTHERIND','05_MNG');
2872   
2873  *RUS
2874   CO2FACTOR('02_COAL','08_WOODPRO','04_RUS')         = CO2FACTOR('02_COAL','08_WOODPRO','10_EEU');
2875   
2876  *LAM
2877   CO2FACTOR('04_GAS','02_COAL','08_LAM')             = CO2FACTOR('04_GAS','02_COAL','07_NAM');
2878   
2879   CTAX0(z)  = 0;
2880   TCTAX0(z) = 0;
2881   
2882  * CO2FACTOR2(ene,j,z,time) = CO2FACTOR(ene,j,z)*AEEI(z,time);
2883   CO2FACTOR2(ene,j,z,time) = CO2FACTOR(ene,j,z);
2884   
2885  *execute_unload 'CO2FACTOR_w-t',
2886  * CO2FACTOR, CO2FACTOR2 ;
2887   
2888  *==============================================================================
2889  *  4.13 Backstop technology
2890  *==============================================================================
2891   switch(i3,z,time)  = 0 ;
2892   penetration_rate(i3,z,time) = 0.01 ;
2893   
2894  *==============================================================================
2895   elas_Hou_ENER(ene,z)     = CMINO(ene,z)/CO(ene,z)*(1-gamma_LES(ene,z)) -1 ;
2896   elas_Firm_KLE(j,z)       = -1*(1-CEO(j,z)/KLEO(j,z))*sigma_KLE(j,z) ;
2897   elas_Firm_ENER(ene,j,z)  = -1*(1-DEO(ene,j,z)/CEO(j,z))*sigma_ENER(j,z) ;
2898   
2899  execute_unload 'Calibration_Check';
2900  *$exit
