6199   
6200  *==============================================================================
6201  *   6.3 Simulation 1 scenarios and Results
6202  *==============================================================================
6203  *$INCLUDE CPS_SOLVE_GTAP11b.gms
6204  *$INCLUDE CPS_RESULTS_GTAP11b.gms
6205  *$INCLUDE CPS_IAMC.gms
6206   
6207  *==============================================================================
6208  *   6.4 Simulation 2 scenarios and Results
6209  *==============================================================================
INCLUDE    C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.RD_CGE\NZS_SOLVE_GTAP11b.gms
6211  *==============================================================================
6212  *  6.2.1.1 Choice of multifactor productivity
6213  *==============================================================================
6214  *  6.2.1.1.1 Input for multifactor productivity
6215  *==============================================================================
6216  * Multifactor productivity is retrieved from a model BAU solution with
6217  * endogenous A_VA(z,time) in equation 3, and exogenous real GDPs, fixed at
6218  * values that are projected using Four?, Benassy-Qu?r? and Fontagn? projected
6219  * growth rates. So the solution is forced to follow the GDP projected growth
6220  * paths. The solution values of A_VA are stored as parameter A_VA_RES.
6221  *-------------------------------------------------------------------------------
6222   
      PARAMETER
       A_VA_RES(z,time)     Value of A_VA to reproduce real GDP projections
       GX(z,time)           Current government expenditures on goods and services in region z
       G_REALX(z,time)      Current real government expenditures on goods and services in region z
       INDX(k,j,z,time)     Volume of new type k capital investment to industry j in region z
       sh0X(z,time)     Intercept (household savings)
       sh1X(z,time)     Household savings rate
       phi_BAU(z,time)
      ;
       
      $GDXIN Input_w-t\B_line_GTAP11b.gdx
      *$LOAD A_VA_RES, sh0X, sh1X, GX, G_REALX, INDX
      $LOAD A_VA_RES, GX, G_REALX, INDX, sh1X, sh0X, phi_BAU
       
      display  A_VA_RES;
      *$EXIT
6241   
6242  *==============================================================================
6243  *  6.2.1.1.2 Choice of multifactor productivity
6244  *==============================================================================
6245  * If you want to reproduce the real GDP projections, set:
6246   A_VA.FX(z,time)  = A_VA_RES(z,time);
6247   
6248  * Otherwise, simply put A_VA equal to one:
6249   
6250  *==============================================================================
6251  *   6.2.1.2 Choice of reference region
6252  *==============================================================================
6253  * By default, the reference region is USA,
6254   zr(z)           = no;
6255   zr('07_NAM')    = yes;
6256  *zr('ChinaHK')   = yes;
6257   z1(z)           = NOT[zr(z)];
6258   
6259  *==============================================================================
6260  *   6.2.1.3 Choice between closures FE and FP
6261  *==============================================================================
6262  *$ontext
6263  * FP CLOSURE: fixed PIXGDPs; numeraire is exchange rate of reference region
6264  * The exchange rates are endogenous, except for the reference region.
6265   e.FX(zr,time)      = eO(zr);
6266   PIXGDP.FX(z,time)  = PIXGDPO(z)/sum(zr,eO(zr));
6267  *$offtext
6268   
      * FE CLOSURE: fixed exchange rates; numeraire is PIXGDP of reference region
      * The exchange rates can be fixed at arbitrary values
       PIXGDP.FX(zr,time)  = PIXGDPO(zr);
       e.FX(z,time)        = eO(z);
6275   
6276   
6277  *==============================================================================
6278  *   Taking account of the existence or not of a feasible solution
6279  *==============================================================================
6280  PARAMETER
6281   SolStop
6282   If_Feasibl(time,scen)    Optimality status code
6283   StatSolver(time,scen)    Solver status code
6284   LastGood(scen)           Last feasible solution year
6285  ;
6286   SolStop = 0;
6287   LastGood(scen)=Endtime;
6288   file Status / 'Output_w-t/ModelStatus.xls'/;
6289  * Column separator: 6 = tab-separated file
6290  *                   5 = comma-separated file
6291       Status.pc=6;
6292  * Number of decimal places (maximum 10)
6293       Status.nd=0;
6294   
6295  * EndTime is the final year for model resolution.
6296  * Parameter EndTime is defined in the main program.
6297  LOOP[time$(time.val le EndTime),
6298  * T(time) is a subset of set TIME. It was previously empty. It now contains
6299  * a single element: it is the current value of the TIME index.
6300  T(time) = YES;
6301   
6302  *==============================================================================
6303  *   6.2.1.4 Other exogenous variables
6304  *==============================================================================
6305   G_REAL.FX(z,time)    = G_REALX(z,time);
6306   IND.fx(k,pub,z,time) = INDX(k,pub,z,time);
6307  * phi.fx(z,time)       = phi_BAU(z,time);
6308   
6309   sh0.fx(z,time)       = sh0X(z,time);
6310   sh1.fx(z,time)       = sh1X(z,time);
6311  * ttdh0.fx(z,time)    = ttdh0O(z)*exogro(z,time);
6312   phi.fx(z,time)       = phiO(z);
6313   ttdh0.fx(z,time)     = ttdh0O(z);
6314   ttdh1.fx(z,time)     = ttdh1O(z);
6315   ttic.fx(i,z,time)    = tticO(i,z);
6316   ttik.fx(k,j,z,time)  = ttikO(k,j,z);
6317   ttim.fx(i,zj,z,time) = ttimO(i,zj,z);
6318   ttip.fx(j,z,time)    = ttipO(j,z);
6319   ttiw.fx(l,j,z,time)  = ttiwO(l,j,z);
6320   ttix.fx(i,z,zj,time) = ttixO(i,z,zj);
6321  * CTAX.fX(z,time)     = CTAX1(z,time);
6322   CTAX.fX(z,time)      = CTAX0(z);
6323   beta_X4_t.fx(power,z,time) = beta_X4(power,z);
6324   
6325   A_VA2.FX(j,z,time) = 1 ;
6326   
6327  * LDC.fx('02_COAL','01_KOR',time)   = LDCO('02_COAL','01_KOR');
6328  * LDC.fx('02_COAL','01_KOR',time)$[ord(time) gt 1]
6329  *                                 = LDCO('02_COAL','01_KOR');
