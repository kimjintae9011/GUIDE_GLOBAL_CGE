 553   PO4(i,j,z)
 554   PPOWERO(z)
 555   PIO(i,z)
 556   PTO(j,z)        Basic price of industry js output
 557   PCO(i,z)        Purchaser price of composite commodity i (including all taxes and margins) in region z
 558   PCIO(j,z)       Intermediate consumption price index of industry j in region z
 559   PCEO(j,z)       Intermediate energy consumption price index of industry j in region z
 560   PDO(i,z)        Price of local product i sold on region z domestic market (including all taxes)
 561   PEO(i,z,zj)     Price received for commodity i exported to region zj by region z (excluding export taxes)
 562   PETO(i,z)       Border price of composite commodity i exported by region z
 563   PIXCONO(z)      Consumer price index in region z
 564   PIXGDPO(z)      GDP deflator in region z
 565   PIXGDP_WO       World GDP deflator
 566   PIXGVTO(z)      Public expenditures price index in region z
 567   PIXINVO(z)      Investment price index in region z
 568   PKO(z)          Price of new capital in region z
 569   PLO(i,z)        Price of local product i (excluding all taxes on products) in region z
 570   PMO(i,zj,z)     Price of commodity i imported by region z from region zj (including all taxes duties and margins)
 571   PMTO(i,z)       Price of composite commodity i imported by region z (including all taxes duties and margins)
 572   PPO(j,z)        Unit cost of industry j in region z including taxes directly related to the use of capital and labor but excluding other taxes on production
 573   PVAO(j,Z)       Price of industry j value added in region z (including taxes on production directly related to the use of capital and labor)
 574   PKLEO(j,z)      Price of industry j KLE in region z
 575   PWMO(i,zj,z)    World price of commodity i imported from country zj by region z (expressed in international currency)
 576   PWMGO(i)        World price of margin i (expressed in international currency)
 577   PWXO(i,z,zj)    World price of commodity i exported to country zj by region z (expressed in international currency)
 578   RO(k,j,z)       Rental rate of type k capital in industry j of region z
 579   RCO(j,z)        Rental rate of industry j composite capital in region z
 580   RKO(k,z)        Rental rate of type k capital in region z
 581   RTIO(k,j,z)     Rental rate paid by industry j for type k capital in region z including capital taxes
 582   UO(z)           User cost of capital in region z
 583   WO(l,z)         Wage rate of type l labor in region z
 584   WCO(j,z)        Wage rate of industry j composite labor in region z
 585   WTIO(l,j,z)     Wage rate paid z by industry j for type l labor in region including payroll taxes
 586   
 587  *==============================================================================
 588  *   2.2.3 Nominal (value) variables
 589  *==============================================================================
 590   CABO(z)         Current account balance of region z
 591   CTHO(z)         Consumption budget of households in region z
 592   DEPO(z)         Amount of depreciation (capital consumption allowance) in region z
 593   GO(z)           Current government expenditures on goods and services in region z
 594   GDP_BPO(z)      Region z GDP at basic prices
 595   GDP_BP_WO       World GDP at basic prices
 596   GDP_FDO(z)      Region z GDP at purchasers prices from the perspective of final demand
 597   GDP_IBO(z)      Region z GDP at market prices (income-based)
 598   GDP_MPO(z)      Region z GDP at market prices
 599   ITO(z)          Total investment expenditures in region z
 600   RKDO(k,j,z)     Type k capital income in industry j in region z
 601   SGO(z)          Government savings in region z
 602   SHO(z)          Household savings in region z
 603   SROWO(z)        Rest-of-the-world savings with respect to region z
 604   TDHO(z)         Household income taxes in region z
 605   TICO(i,z)       Government revenue from indirect taxes on commodity i in region z
 606   TICTO(z)        Total government receipts of indirect taxes on commodities in region z
 607   TIKO(k,j,z)     Government revenue from taxes on type k capital used by industry j in region z
 608   TIKTO(z)        Total government revenue from from taxes on capital in region z
 609   TIMO(i,zj,z)    Government revenue from duties on commodity i imported from region zj by region z
 610   TIMTO(z)        Total government revenue from import duties in region z
 611   TIPO(j,z)       Government revenue from taxes on industry j production in region z (excluding taxes directly related to the use of capital and labor)
 612   TIPTO(z)        Total government revenue from production taxes in region z (excluding taxes directly related to the use of capital and labor)
 613   TIWO(l,j,z)     Government revenue from payroll taxes on type l labor in industry j of region z
 614   TIWTO(z)        Total government revenue from payroll taxes in region z
 615   TIXO(i,z,zj)    Government revenue from export taxes on commodity i exported by region z to region zj
 616   TIXTO(z)        Total government revenue from export taxes in region z
 617   TPRCTSO(z)      Total government revenue from taxes on products and imports in region z
 618   TPRODNO(z)      Total government revenue from other taxes on production in region z
 619   YDHO(z)         Household disposable income in region z
 620   YGO(z)          Total government income in region z
 621   YHO(z)          Household total income in region z
 622   YHKO(z)         Household capital income in region z
 623   YHLO(z)         Household labor income in region z
 624   YROWO(z)        Rest-of-the-world total income from region z
 625   
 626  *==============================================================================
 627  *   2.2.4 Rates and intercepts
 628  *==============================================================================
 629   phiO(z)         Scale variable (allocation of investment to industries)
 630   sh0O(z)         Intercept (household savings)
 631   sh1O(z)         Slope (household savings)
 632   ttdh0O(z)       Intercept (household income tax)
 633   ttdh1O(z)       Slope (household income tax)
 634   tticO(i,z)      Tax rate on commodity i
 635   ttikO(k,j,z)    Tax rate on capital k used in industry j
 636   ttimO(i,zj,z)   Rate of taxes and duties on imports of commodity i from country zj
 637   ttipO(j,z)      Tax rate on the production of industry j
 638   ttiwO(l,j,z)    Tax rate on type l worker compensation in industry j
 639   ttixO(i,z,zj)   Export tax rate on exported commodity x
 640  ;
 641   
 642  Scalar
 643   Tiny small figure / 0.000000000001/ ;
 644   
 645  *==============================================================================
 646  * 3 Data
 647  *==============================================================================
 648  *  3.1 Data input from GTAP8.1
 649  *==============================================================================
 650  *   3.1.1 Reading data aggregated with DATA_AGG-2007.gms
 651  *==============================================================================
 652  *  The PEP w-t model uses aggregated data from GTAP8.1. The following file
 653  *  includes data for some variables and substitution elasticities.
 654   
--- LOAD  CO = 13:CO
--- LOAD  CGO = 14:CGO
--- LOAD  DDO = 15:DDO
--- LOAD  DEPO = 16:DEPO
--- LOAD  DIO = 17:DIO
--- LOAD  DSO = 18:DSO
--- LOAD  DSO_I = 19:DSO_I
--- LOAD  EXO = 20:EXO
--- LOAD  IMO = 21:IMO
--- LOAD  INVO = 22:INVO
--- LOAD  KSTO = 23:KSTO
--- LOAD  LDO = 24:LDO
--- LOAD  MRGNO = 25:MRGNO
--- LOAD  XSO = 39:XSO
--- LOAD  XSO_I = 40:XSO_I
--- LOAD  XSTO = 41:XSTO
--- LOAD  TOT_POP = 62:TOT_POP
--- LOAD  g_GDP = 63:g_GDP
--- LOAD  g_POP = 64:g_POP
--- LOAD  g_SDR = 65:g_SDR
--- LOAD  AEEI_low = 66:AEEI_low
--- LOAD  AEEI_high = 67:AEEI_high
--- LOAD  CTAX_Cal = 69:CTAX_Cal
--- LOAD  CTAX_CPS = 70:CTAX_CPS
--- LOAD  CTAX_NZS = 71:CTAX_NZS
--- LOAD  RKDO = 27:RKDO
--- LOAD  TDHO = 28:TDHO
--- LOAD  TICO = 30:TICO
--- LOAD  TIKO = 31:TIKO
--- LOAD  TIMO = 32:TIMO
--- LOAD  TIPO = 33:TIPO
--- LOAD  TIWO = 34:TIWO
--- LOAD  TIXO = 35:TIXO
--- LOAD  tmrg = 38:tmrg
--- LOAD  sigma_M1 = 43:sigma_M1
--- LOAD  sigma_M2 = 44:sigma_M2
--- LOAD  sigma_VA = 45:sigma_VA
--- LOAD  sigma_KLE = 46:sigma_KLE
--- LOAD  POPO = 26:POPO
 658   
 659  * Other exogenous parameters can be defined if the Excel file VAL_PAR.XLS
 660  PARAMETER
 661  PARZ;
 662   
GDXIN   C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.RD_CGE\Input_w-t\PAR.gdx
--- LOAD  sigma_KD = 1:sigma_KD
--- LOAD  sigma_LD = 2:sigma_LD
--- LOAD  sigma_X1 = 4:sigma_X1
--- LOAD  sigma_X2 = 5:sigma_X2
--- LOAD  sigma_X3 = 6:sigma_X3
--- LOAD  sigma_X0 = 7:sigma_X0
--- LOAD  sigma_Y = 8:sigma_y
--- LOAD  sigma_INV = 10:sigma_inv
--- LOAD  PARZ = 9:PARZ
 666   
 667  *===============================================================================
 668  * CES - composite capital
 669   sigma_KD(j,z)   = 2*sigma_VA(j,z);
 670   
 671  * CES - composite labor
 672   sigma_LD(j,z)   = 2*sigma_VA(j,z);
 673   
 674  * CES - composite K-L
 675  * 02_COAL, 20_e_Coal, 22_eOil -> 0.1
 676  * Exec Error at line 3250: rPower: FUNC DOMAIN: x**y, x < 0
 677  * Evaluation error(s) in equation "EQ4(02_COAL,03_JPN,2046)"
 678  * Exec Error at line 3670: rPower: FUNC DOMAIN: x**y, x < 0
 679  * Evaluation error(s) in equation "EQ96(cap,02_COAL,03_JPN,2046)"
 680  * Evaluation error(s) in equation "EQ96(natr,02_COAL,03_JPN,2046)"
 681  * 02_COAL, 20_e_Coal, 22_eOil -> 0.2
 682   sigma_VA('02_COAL',z)  = 0.2;
 683   sigma_VA('20_eCoal',z) = 0.2;
 684   sigma_VA('22_eOil',z)  = 0.2;
 685   
 686   sigma_VA('10_PETROLCOAL',z) = 1.260;
 687   
 688   
 689  * CES - composite ENER
 690   sigma_ENER(j,z) = 1.1 ;
 691   
 692  * CES - DOM vs. IMP
 693   sigma_M1('03_OIL','06_PRK') = 0.5;
 694   sigma_M1('04_GAS',Z) = 6;
 695   
 696  * CES - IMP sourcing
 697   sigma_M2('03_OIL',Z) = 2;
 698   sigma_M2('04_GAS',Z) = 2;
 699   
 700  * CET - total output
 701   sigma_X2(i,Z)  = 2;
 702   
 703  * CES - composite Power sector
 704   sigma_X4(z)    = 2;
 705   sigma_X4(NEA2) = 5;
 706   
 707  * Investment demand elasticity
 708   sigma_INV(k,j,z) = 2;
 709   sigma_INV(k,j,'05_MNG') = 0.1;
 710   
 711  * Income elasticity of consumption
 712   sigma_Y('03_OIL','06_PRK') = 1.01;
 713   
 714  * LES parameters - Frisch all (1.1)
 715   frisch(z)      = PARZ(z,'frisch');
 716   
 717  *==============================================================================
 718  *   3.1.2 Rescaling the variables
 719  *==============================================================================
 720  * GTAP 8.1 data are in millions of (2004 and 2007) US dollars
 721  * (see www.gtap.agecon.purdue.edu/resources/download/5679.pdf)
 722  * With RES = 10000, model results are in tens of billions (10G$)
 723  RES              = 10000;
 724  *RES              = 1000;
 725   
 726  * NOTE: In GTAP parlance, "agents' prices" are prices paid by buyers, and
 727  *       "market prices" are prices received by sellers.
 728   
 729  * Household consumption = GTAP domestic purchases (VDPA) + import purchases (VIPA)
 730  * by households at agents' prices.
 731  CO(i,z)          = CO(i,z)/RES;
 732   
 733  * Public final consumption = domestic purchases (VDGA) + import purchases (VIGA)
 734  * by government at agents' prices.
 735  CGO(i,z)         = CGO(i,z)/RES;
 736   
 737  * Domestic purchases = domestic absorption:
 738  * (CO + CGO + INVO + DIO) - [ imports (IMO) + transport margins (tmrg)
 739  *                              + indirect taxes (TICO + TIMO) ]
 740  DDO(i,z)         = DDO(i,z)/RES;
 741   
 742  * Capital depreciation (DEP)
 743  DEPO(z)          = DEPO(z)/RES;
 744   
 745  * Intermediate consumption = domestic purchases (VDFA) + import purchases (VIFA)
 746  * by firms belonging to sectors other than CGDS, at agents' prices.
 747  DIO(i,j,z)       = DIO(i,j,z)/RES;
 748   
 749  * Domestic supply = domestic demand (DDO) in GTAP_AGG.gms
 750  DSO(j,i,z)        = DSO(j,i,z)/RES;
 751  DSO_I(i,z)        = DSO_I(i,z)/RES;
 752   
 753  * Exports = exports at world prices (VXWD) = imports at world prices
 754  * Note: the GTAP variable VXWD is NOT used in the DATA_AGG.gms program; the
 755  * value recorded in DATA_AGG.gdx is actually identical to IMO
 756  EXO(i,z,zj)      = EXO(i,z,zj)/RES;
 757   
 758  * Imports = imports at world prices (VIWS) - sum of transport margins on imports (VTWR)
 759  IMO(i,z,zj)      = IMO(i,z,zj)/RES;
 760   
 761  * Demand for investment purposes = domestic purchases (VDFA)+ import purchases (VIFA)
 762  * by firms of the CGDS sector at agents' prices.
 763  INVO(i,z)        = INVO(i,z)/RES;
 764   
 765  * Total capital stock at the beginning of the period (VKB)
 766  KSTO(z)          = KSTO(z)/RES;
 767   
 768  * Labor demand = Remuneration of labor at market prices, before taxes
 769  * (components of VFM, "primary factor purchases, by households, at market prices")
 770  LDO(l,j,z)       = LDO(l,j,z)/RES;
 771   
 772  * Supply of transport margins at market prices (VST), adjusted proportionately
 773  * so that MRGNO = sum of tmrg for every margin commodity
 774  MRGNO(i,z)       = MRGNO(i,z)/RES;
 775   
 776  * Remuneration of capital at market prices, before taxes
 777  * (components of VFM, "primary factor purchases, by households, at market prices")
 778  RKDO(k,j,z)      = RKDO(k,j,z)/RES;
 779   
 780  * Direct taxes = factor payment at market prices (VFM)
 781  *                - primary factor sales at agents' prices (EVOA)
 782  TDHO(z)          = TDHO(z)/RES;
 783   
 784  * Domestic taxes on commodities = demand at agents' prices - demand at market prices:
 785  * Include 6 pairs of GTAP components
 786  *       VDPA - VDPM
 787  *       VIPA - VIPM
 788  *       VDGA - VDGM
 789  *       VIGA - VIGM
 790  *       VDFA - VDFM
 791  *       VIFA - VIFM
 792  TICO(i,z)        = TICO(i,z)/RES;
 793   
 794  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 795  *                                     - factor-based subsidies (FBEP).
 796  TIKO(k,j,z)      = TIKO(k,j,z)/RES;
 797   
 798  * Import duties = "ordinary" import duties (TFRV)
 799  TIMO(i,z,zj)     = TIMO(i,z,zj)/RES;
 800   
 801  * Taxes on production = MINUS "ordinary output subsidies" (OSEP)
 802  TIPO(j,z)        = TIPO(j,z)/RES;
 803   
 804  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 805  *                                     - factor-based subsidies (FBEP).
 806  TIWO(l,j,z)      = TIWO(l,j,z)/RES;
 807   
 808  * Taxes on exports = export tax equivalent of the Multi-Fiber Agreement (MFA)
 809  * quota premium(MFRV) + "ordinary" export taxes (XTRV)
 810  TIXO(i,z,zj)     = TIXO(i,z,zj)/RES;
 811   
 812  * Transport margins at world prices = sum of margins on imports (VTWR)
 813  tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj)/RES;
 814   
 815  * Domestic output = domestic supply (DSO) + supply of transport margins (MRGNO)
 816  *                   + exports (EXO) - taxes on exports (TIXO)
 817   
 818  XSO_I(i,z)        = XSO_I(i,z)/RES;
 819  XSO(j,i,z)        = XSO(j,i,z)/RES;
 820  XSTO(j,z)         = XSTO(j,z)/RES;
 821   
 822  growthz(z)        = 0.02;
 823   
 824  *==============================================================================
 825  *  3.3 Exogenous prices and parameters
 826  *==============================================================================
 827  *  Price elasticity (should be equal to one to verify homogeneity)
 828  eta = 1;
 829   
 830  *------------------------------------------------------------------------------
 831  *  Slopes of taxation functions
 832  *   One can either choose to assign a value to the intercepts and calibrate
 833  *   the slopes accordingly, or the other way around. This type of modelling
 834  *   can be useful to take into account known marginal savings or taxation rates
 835  *   or to deal with negative average saving rates in cases where savings are
 836  *   negative for some household groups.
 837  *   When no further information is available, one can simply set the intercepts
 838  *   to zero and calibrate an average rate: this is what we do here for ttdh0O.
 839  *   If the user wishes to assume otherwise, he can fill the appropriate area in
 840  *   the Excel file VAL_PAR.xls.
 841  * ttdh0O(z)       = PARZ(z,'ttdh0O');
 842   
 843   ttdh0O(z)       = 0;
 844  *   The slope ttdh1O is calibrated below in the mane GAMS file
 845   
 846  *------------------------------------------------------------------------------
 847  * Also we need to assign values to some prices
 848  * All of the prices below, EXCEPT eO, may be set at arbitrary values
 849  * without loss of generality.
 850  *
 851  * In the case of eO, although exchange rates may be given arbitrary values
 852  * in the model, they must all be equal for calibration at this stage. The reason
 853  * is that the supply of margin transport services MRGNO must equal global demand.
 854  * Since there is a single world price for international transport margins
 855  * (rather than bilateral world prices for other commodities) the unit of
 856  * measurement of the volume of margin services must be the same for all regions,
 857  * and in turn, that implies that the divisor that converts the nominal value to
 858  * volume be the same for all regions. Since that divisor involves the exchange
 859  * rate, all exchange rates must be equal.
 860   
 861  * Normally, prices that may be given arbitrary values are set at 1:
 862   eO(z)           = 1;
 863   PEO(i,z,zj)     = 1;
 864   PLO(i,z)        = 1;
 865   PWMGO(i)        = 1;
 866   WO(l,z)         = 1;
 867   
 868  *==============================================================================
 869  * 4 Calibration
 870  *==============================================================================
 871  *  4.1 Calculation of income and savings related variables and parameters
 872  *==============================================================================
 873   YHKO(z)         = SUM[(k,j),RKDO(k,j,z)];
 874   YHLO(z)         = SUM[(l,j),LDO(l,j,z)];
 875   YHO(z)          = YHLO(z)+YHKO(z);
 876   YDHO(z)         = YHO(z)-TDHO(z);
 877   CTHO(z)         = SUM[i,CO(i,z)];
 878   SHO(z)          = YDHO(z)-CTHO(z);
 879   
 880   TICTO(z)        = SUM[i,TICO(i,z)];
 881   TIMTO(z)        = SUM[(i,zj),TIMO(i,zj,z)];
 882   TIWTO(z)        = SUM[(l,j),TIWO(l,j,z)];
 883   TIKTO(z)        = SUM[(k,j),TIKO(k,j,z)];
 884   TIPTO(z)        = SUM[j,TIPO(j,z)];
 885   TIXTO(z)        = SUM[(i,zj),TIXO(i,z,zj)];
 886   TPRODNO(z)      = TIKTO(z)+TIWTO(z)+TIPTO(z);
 887   TPRCTSO(z)      = TICTO(z)+TIMTO(z)+TIXTO(z);
 888   YGO(z)          = TDHO(z)+TPRCTSO(z)+TPRODNO(z);
 889   GO(z)           = SUM[i,CGO(i,z)];
 890   SGO(z)          = YGO(z)-GO(z);
 891   
 892   YROWO(z)        = SUM[(i,zj),IMO(i,zj,z)]+SUM[(i,ij,zj),tmrg(i,ij,zj,z)];
 893   SROWO(z)        = YROWO(z)-SUM[(i,zj),EXO(i,z,zj)]-SUM[i,MRGNO(i,z)];
 894   CABO(z)         = -SROWO(z);
 895   
 896   ITO(z)          = SHO(z)+SGO(z)+SROWO(z);
 897   
 898  *==============================================================================
 899  *  4.2 Calibration of parameters and other variables
 900  *==============================================================================
 901  *  4.2.1 Calibration of investment and government spending shares
 902  *==============================================================================
 903   gamma_GVT(i,z)  = CGO(i,z)/SUM[ij,CGO(ij,z)];
 904   gamma_INV(i,z)  = INVO(i,z)/SUM[ij,INVO(ij,z)] ;
 905   
 906  *==============================================================================
 907  *  4.2.2 Calibration of other prices and revised volumes (part 1)
 908  *==============================================================================
 909   LDO(l,j,z)      = LDO(l,j,z)/WO(l,z);
 910   LDCO(j,z)       = SUM[l,LDO(l,j,z)];
 911   LSO(l,z)        = SUM[j,LDO(l,j,z)];
 912   EXO(i,z,zj)     = [EXO(i,z,zj)-TIXO(i,z,zj)]/PEO(i,z,zj);
 913   EXTO(i,z)       = SUM[zj,EXO(i,z,zj)];
 914   
 915   PWXO(i,z,zj)$EXO(i,z,zj)
 916                   = {[PEO(i,z,zj)*EXO(i,z,zj)+TIXO(i,z,zj)]/EXO(i,z,zj)}/eO(z);
 917   
 918   PETO(i,z)       = SUM[zj,PEO(i,z,zj)*EXO(i,z,zj)]/EXTO(i,z);
 919   PWMO(i,z,zj)    = PWXO(i,z,zj);
 920   IMO(i,zj,z)     = EXO(i,zj,z);
 921   IMTO(i,z)       = SUM[zj,IMO(i,zj,z)];
 922   
 923   DSO(j,i,z)      = DSO(j,i,z)/PLO(i,z);
 924   DSO_I(i,z)      = SUM(j,DSO(j,i,z));
 925   DSO_J(j,z)      = SUM(i,DSO(j,i,z));
 926   QO(i,z)         = IMTO(i,z)+DDO(i,z);
 927   
 928   MRGNO(i,z)$MRGNO(i,z)
 929                   = MRGNO(i,z)/[eO(z)*PWMGO(i)];
 930   
 931   XSO_I(i,z)      = EXTO(i,z)+DDO(i,z)+MRGNO(i,z);
 932   
 933   XSTO(j,z)       = sum(i, XSO(j,i,z));
 934   
 935   PO(i,z)         = [PETO(i,z)*EXTO(i,z)+PLO(i,z)*DSO_I(i,z)
 936                    +eO(z)*PWMGO(i)*MRGNO(i,z)]/XSO_I(i,z);
 937   
 938   PO2(j,i,z)$XSO(j,i,z) = 1;
 939   
 940   PO3(i,j,z)$XSO(j,i,z) = 1;
 941   
 942   PIO(i,z)       = SUM[j$XSO(j,i,z),PO2(J,I,z)*XSO(j,i,z)]/XSO_I(i,z);
 943   
 944   PTO(j,z)       = SUM[i$XSO(j,i,z),PO2(j,i,z)*XSO(j,i,z)]/XSTO(j,z);
 945   
 946   PPO(j,z)       = [SUM[l,TIWO(l,j,z)+WO(l,z)*LDO(l,j,z)]
 947                    +SUM[k,TIKO(k,j,z)+RKDO(k,j,z)]
 948                    +SUM[nene,DIO(nene,j,z)]+SUM[ene,DIO(ene,j,z)]]/XSTO(j,z);
 949   
 950   theta2(j,i,z)  = DSO(j,i,z)/sum(jj, DSO(jj,i,z));
 951   
 952   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z)*EXTO(i,z);
 953   
 954  *==============================================================================
 955  *  4.3 Calibration of tax rates, margins, prices and volumes
 956  *==============================================================================
 957  *  4.3.1 Margin rates and tax rates
 958  *==============================================================================
 959   ttixO(i,z,zj)   = [eO(z)*PWXO(i,z,zj)/PEO(i,z,zj)]-1;
 960   tticO(i,z)      = TICO(i,z)/{PLO(i,z)*DDO(i,z)
 961                     +SUM[zj,IMO(i,zj,z)*eO(z)*PWMO(i,zj,z)
 962                     +TIMO(i,zj,z)+SUM[ij,tmrg(ij,i,zj,z)]]};
 963   
 964   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
 965                   = tmrg(i,ij,zj,z)/(PWMGO(i)*eO(z)*IMO(ij,zj,z));
 966   
 967   ttimO(i,zj,z)$IMO(i,zj,z)
 968                   = TIMO(i,zj,z)/{IMO(i,zj,z)*eO(z)*(PWMO(i,zj,z)
 969                    +SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])};
 970   
 971   ttiwO(l,j,z)$LDO(l,j,z)
 972                   = TIWO(l,j,z)/[WO(l,z)*LDO(l,j,z)];
 973   
 974   ttikO(k,j,z)$RKDO(k,j,z)
 975                   = TIKO(k,j,z)/RKDO(k,j,z);
 976   
 977   ttipO(j,z)      = [PTO(j,z)/PPO(j,z)]-1;
 978   
 979   ttdh1O(z)       = [TDHO(z)-ttdh0O(z)]/YHO(z);
 980   
 981  *==============================================================================
 982  *  4.3.2 Calibration of other prices and revised volumes (part 2)
 983  *==============================================================================
 984   PDO(i,z)        = PLO(i,z)*(1+tticO(i,z));
 985   PMO(i,zj,z)     = eO(z)*(PWMO(i,zj,z)+SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])
 986                   *(1+ttimO(i,zj,z))*(1+tticO(i,z));
 987   PMTO(i,z)       = SUM[zj,PMO(i,zj,z)*IMO(i,zj,z)]/IMTO(i,z);
 988   PCO(i,z)        = [PMTO(i,z)*IMTO(i,z)+PDO(i,z)*DDO(i,z)]/QO(i,z);
 989   
 990   CO(i,z)         = CO(i,z)/PCO(i,z);
 991   CGO(i,z)        = CGO(i,z)/PCO(i,z);
 992   DIO(nene,j,z)   = DIO(nene,j,z)/PCO(nene,z);
 993   DEO(ene,j,z)    = DIO(ene,j,z)/PCO(ene,z);
 994   INVO(i,z)       = INVO(i,z)/PCO(i,z);
 995   
 996   CIO(j,z)        = SUM[nene,DIO(nene,j,z)];
 997   CEO(j,z)        = SUM[ene,DEO(ene,j,z)];
 998   
 999   DITO(nene,z)     = SUM[j,DIO(nene,j,z)];
1000   DITO(ene,z)      = SUM[j,DEO(ene,j,z)];
1001   
1002   PO4(ene,j,z)    = PCO(ene,z);
1003   
1004   PCIO(j,z)       = SUM[nene,PCO(nene,z)*DIO(nene,j,z)]/CIO(j,z);
1005   PCEO(j,z)       = SUM[ene,PCO(ene,z)*DEO(ene,j,z)]/CEO(j,z) ;
1006   
1007   WTIO(l,j,z)     = WO(l,z)*(1+ttiwO(l,j,z));
1008   
1009   WCO(j,z)$LDCO(j,z)
1010                   = SUM[l,WTIO(l,j,z)*LDO(l,j,z)]/LDCO(j,z);
1011   
1012  *==============================================================================
1013  *  4.4 Calibration of dynamic parameters
1014  *==============================================================================
1015  * Calibration of dynamic parameters following new procedure.
1016  * The price of capital is arbitrary:
1017   PKO(z) = 1;
1018   
1019  * The calibration of depreciation rates is based on two hypotheses:
1020  * 1. The rate of depreciation is the same for all types of capital and all
1021  *    industries in each region (this hypothesis is made to accommodate the fact
1022  *    that, in the GTAP data base, capital consumption allowance is not detailed;
1023  *    as a matter of fact, the GTAP capital consumption allowance is set at
1024  *    4% of the value of the capital stock).
1025  * 2. The rental rate of capital is uniform across industries and types of
1026  *    capital in each region.
1027  * 3. The investment rate (IND/KD) is uniform across industries and types of
1028  *    capital in each region.
1029  * These hypotheses lead to the following formulae:
1030   
1031  * From GTAP, we know KSTO.
1032   KSTO(z)         = KSTO(z)/PKO(z);
1033   
1034  * Assuming a uniform depreciation rate for all types
1035  * of capital and all industries:
1036   delta(z)        = DEPO(z)/[PKO(z)*KSTO(z)];
1037   
1038  * From GTAP, we know KSTO. Assuming a uniform rental rate R for all types
1039  * of capital and all industries:
1040   RO(k,j,z)$RKDO(k,j,z)
1041                   = SUM[(kj,jj),RKDO(kj,jj,z)]/KSTO(z);
1042   
1043  * Then from the GTAP value of income paid to capital RKD we calibrate KDO:
1044   KDO(k,j,z)$RKDO(k,j,z)
1045                   = RKDO(k,j,z)/RO(k,j,z);
1046   
1047  * The supply of capital is equal to demand:
1048   KSO(k,z)        = SUM[j,KDO(k,j,z)];
1049   
1050  * The rate of return on capital, net of depreciation, is:
1051   IRO(z)         = {SUM[(k,j)$RKDO(k,j,z),RKDO(k,j,z)]-DEPO(z)}/[PKO(z)*KSTO(z)];
1052   
1053  * The user cost of capital follows
1054   UO(z)           = PKO(z)*(IRO(z)+delta(z));
1055   
1056  * Combining
1057  * - the hypothesis of uniform investment rates
1058  * - the hypothesis of uniform rental rates
1059  * - the hypothesis of uniform depreciation rates
1060  * leads to
1061   phiO(z)         = [ITO(z)/PKO(z)]/KSTO(z);
1062   
1063  * Investment by destination follows:
1064   INDO(k,j,z)$KDO(k,j,z)
1065                   = phiO(z)*KDO(k,j,z);
1066   
1067   A_K(z)          = 1/PKO(z)*{PROD[i$gamma_INV(i,z),(PCO(i,Z)/gamma_INV(i,z))
1068                     **gamma_INV(i,z)]};
1069   
1070   KDCO(j,z)       = SUM[k,KDO(k,j,z)];
1071   RTIO(k,j,z)     = RO(k,j,z)*(1+ttikO(k,j,z));
1072   RCO(j,z)$KDCO(j,z)
1073                   = SUM[k,RTIO(k,j,z)*KDO(k,j,z)]/KDCO(j,z);
1074   
1075  *==============================================================================
1076  *  4.5 Calibration of other prices and revised volumes (part 3)
1077  *==============================================================================
1078   VAO(j,z)        = LDCO(j,z)+KDCO(j,z);
1079   
1080   PVAO(j,z)       = [WCO(j,z)*LDCO(j,z)+RCO(j,z)*KDCO(j,z)]/VAO(j,z);
1081   
1082  * PIXGDPO is tautologically equal to 1, based on its formula
1083  * PIXGDPO(z)      = {SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1084  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1085  *                   *SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1086  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]}**0.5;
1087   PIXGDPO(z)      = 1;
1088   
1089  * PIXGDP_WO is tautologically equal to 1, based on its formula
1090  * PIXGDP_WO       = {SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1091  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1092  *                   *SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1093  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]/eO(z)}**0.5;
1094   PIXGDP_WO       = 1;
1095   
1096  * PIXCONO(z) is tautologically equal to 1, based on its formula
1097  * PIXCONO(z)      = SUM[i,PCO(i,z)*CO(i,z)]
1098  *                  /SUM[i,PCO(i,z)*CO(i,z)];
1099   PIXCONO(z)      = 1;
1100   
1101  * PIXINVO(z) is tautologically equal to 1, based on its formula
1102  * PIXINVO(z)      = PROD[i$gamma_INV(i,z),(PCO(i,z)/PCO(i,z))**gamma_INV(i,z)];
1103   PIXINVO(z)      = 1;
1104   
1105  * PIXGVTO(z) is tautologically equal to 1, based on its formula
1106  * PIXGVTO(z)      = PROD[i$gamma_GVT(i,z),(PCO(i,z)/PCO(i,z))**gamma_GVT(i,z)];
1107   PIXGVTO(z)      = 1;
1108   
1109  *==============================================================================
1110  *  4.6 Calibration of function parameters
1111  *==============================================================================
1112  *   4.6.1 Leontief functions
1113  *==============================================================================
1114   io(j,z)         = CIO(j,z)/XSTO(j,z) ;
1115   
1116   io2(j,z)        = CEO(j,z)/XSTO(j,z) ;
1117   
1118   v(j,z)          = VAO(j,z)/XSTO(j,z) ;
1119   
1120   v2(j,z)         = (CEO(j,z)+VAO(j,z))/XSTO(j,z) ;
1121   
1122   aij(nene,j,z)   = DIO(nene,j,z)/CIO(j,z);
1123   
1124   aij2(ene,j,z)   = DEO(ene,j,z)/CEO(j,z);
1125   
1126   aij2_t(ene,j,z,time) =  aij2(ene,j,z)*AEEI_low(z,'2019') ;
1127   
1128   io2_t(j,z,time) = io2(j,z)*AEEI_low(z,'2019') ;
1129   
1130  *==============================================================================
1131  *   4.6.2 Calibration of CET parameters
1132  *==============================================================================
1133  *    4.6.2.1 CET between total exports, domestic supply and margins
1134  *==============================================================================
1135   rho_X1(i,z)     = (1+sigma_X1(i,z))/sigma_X1(i,z);
1136   
1137   beta_EX_X1(i,z)$MRGNO(i,z)
1138                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1139                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1140                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1141                     eO(z)*PWMGO(i)*MRGNO(i,z)$MRGNO(i,z)**(1-rho_X1(i,z))+Tiny];
1142   
1143   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1144                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1145                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1146                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+Tiny];
1147   
1148   beta_D_X1(i,z)$MRGNO(i,z)
1149                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1150                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1151                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1152                     eO(z)*PWMGO(i)*MRGNO(i,z)**(1-rho_X1(i,z))];
1153   
1154   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1155                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1156                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1157                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1158   
1159   B_X1(i,z)       = XSO_I(i,z)/[beta_EX_X1(i,z)*EXTO(i,z)**rho_X1(i,z)
1160                    +beta_D_X1(i,z)*DSO_I(i,z)**rho_X1(i,z)+(1-beta_EX_X1(i,z)
1161                    -beta_D_X1(i,z))*MRGNO(i,z)**rho_X1(i,z)]**(1/rho_X1(i,z));
1162   
1163  *==============================================================================
1164  *    4.6.2.2 CET between exports to different trading partners
1165  *==============================================================================
1166   rho_X2(i,z)     = (1+sigma_X2(i,z))/sigma_X2(i,z);
1167   
1168   beta_X2(i,z,zj)$EXO(i,z,zj)
1169                   = [PEO(i,z,zj)*EXO(i,z,zj)**(1-rho_X2(i,z))]/
1170                     SUM[zjj$EXO(i,z,zjj),PEO(i,z,zjj)*EXO(i,z,zjj)
1171                     **(1-rho_X2(i,z))];
1172   
1173   B_X2(i,z)       = EXTO(i,z)/{SUM[zj,beta_X2(i,z,zj)*EXO(i,z,zj)**rho_X2(i,z)]
1174                     **(1/rho_X2(i,z))};
1175   
1176  *==============================================================================
1177  *   4.6.3 Calibration of CES parameters
1178  *==============================================================================
1179  *    4.6.3.0 Composite output
1180  *==============================================================================
1181   rho_X3(i,z)   = (1-sigma_X3(i,z))/sigma_X3(i,z);
1182   
1183   beta_X3(j,i,z)$XSO(j,i,z)
1184                 = [PO2(j,i,z)*XSO(j,i,z)**(1+rho_X3(i,z))]/
1185                     SUM[jj$XSO(jj,i,z),PO2(jj,i,z)*XSO(jj,i,z)**(1+rho_X3(i,z))];
1186   
1187   B_X3(i,z)     = XSO_I(i,z)
1188                    /SUM[jj$XSO(jj,i,z),beta_X3(jj,i,z)*XSO(jj,i,z)**(-rho_X3(i,z))
1189                    ]**(-1/rho_X3(i,z));
1190   
1191   POWERQO(Z) = SUM(POWER, XSO(power,'18_ELEC',z));
1192   
1193   rho_X4(z)   = (1-sigma_X4(z))/sigma_X4(z);
1194   
1195   beta_X4(power,z)
1196                 = [PO2(power,'18_ELEC',z)*XSO(power,'18_ELEC',z)**(1+rho_X4(z))]/
1197                     SUM[powerr$XSO(powerr,'18_ELEC',z),PO2(powerr,'18_ELEC',z)*XSO(powerr,'18_ELEC',z)**(1+rho_X4(z))];
1198   
1199   B_X4(z)     = POWERQO(Z)
1200                    /SUM[powerr$XSO(powerr,'18_ELEC',z),beta_X4(powerr,z)*XSO(powerr,'18_ELEC',z)**(-rho_X4(z))
1201                    ]**(-1/rho_X4(z));
1202   
1203   TnDShare(z) = XSO('18_TnD','18_ELEC',z)/XSO_I('18_ELEC',z);
1204   
1205   PPOWERO(z) = 1;
1206   
1207  *==============================================================================
1208  *    4.6.3.1 Composite good
1209  *==============================================================================
1210   rho_M1(i,z)     = (1-sigma_m1(i,z))/sigma_m1(i,z);
1211   
1212   beta_M1(i,z)    = PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)/
1213                    {PDO(i,z)*DDO(i,z)**(rho_M1(i,z)+1)
1214                    +PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)};
1215   
1216   B_M1(i,z)       = QO(i,z)/{beta_M1(i,z)*IMTO(i,z)**(-rho_M1(i,z))
1217                    +(1-beta_M1(i,z))*DDO(i,z)**(-rho_M1(i,z))}**(-1/rho_M1(i,z));
1218   
1219  *==============================================================================
1220  *    4.6.3.2 CES between imports from different trading partners
1221  *==============================================================================
1222   rho_M2(i,z)     = (1-sigma_M2(i,z))/sigma_M2(i,z);
1223   
1224   beta_M2(i,zj,z)$IMO(i,zj,z)
1225                   = [PMO(i,zj,z)*IMO(i,zj,z)**(rho_M2(i,z)+1)]/
1226                     SUM[zjj$IMO(i,zjj,z),PMO(i,zjj,z)*IMO(i,zjj,z)
1227                      **(rho_M2(i,z)+1)];
1228   
1229   B_M2(i,z)       = IMTO(i,z)/{SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*IMO(i,zj,z)
1230                     **(-rho_M2(i,z))]**(-1/rho_M2(i,z))};
1231   
1232  *==============================================================================
1233  *    4.6.3.3 Composite capital
1234  *==============================================================================
1235   rho_KD(j,z)     = (1-sigma_KD(j,z))/sigma_KD(j,z);
1236   
1237   beta_KD(k,j,z)$KDO(k,j,z)
1238                   = [RTIO(k,j,z)*KDO(k,j,z)**(1+rho_KD(j,z))]/
1239                     SUM[kj$KDO(kj,j,z),RTIO(kj,j,z)*KDO(kj,j,z)**(1+rho_KD(j,z))];
1240   
1241   B_KD(j,z)$KDCO(j,z)
1242                   = KDCO(j,z)/{SUM[k$KDO(k,j,z),beta_KD(k,j,z)*KDO(k,j,z)
1243                     **(-rho_KD(j,z))]**(-1/rho_KD(j,z))};
1244   
1245   B_KD2(j,z,time) = B_KD(j,z) ;
1246   
1247  *==============================================================================
1248  *    4.6.3.4 Composite labor
1249  *==============================================================================
1250   rho_LD(j,z)     = (1-sigma_LD(j,z))/sigma_LD(j,z);
1251   
1252   beta_LD(l,j,z)$LDO(l,j,z)
1253                   = [WTIO(l,j,z)*LDO(l,j,z)**(1+rho_LD(j,z))]/
1254                     SUM[lj$LDO(lj,j,z),WTIO(lj,j,z)*LDO(lj,j,z)
1255                     **(1+rho_LD(j,z))];
1256   
1257   B_LD(j,z)$LDCO(j,z)
1258                   = LDCO(j,z)/{SUM[l$LDO(l,j,z),beta_LD(l,j,z)*LDO(l,j,z)
1259                     **(-rho_LD(j,z))]**(-1/rho_LD(j,z))};
1260   
1261   B_LD2(j,z,time) = B_LD(j,z) ;
1262   
1263  *===============================================================================
1264  *   Composite E
1265  *===============================================================================
1266   rho_ENER(j,z)   = (1-sigma_ENER(j,z))/sigma_ENER(j,z);
1267   
1268   beta_ENER(ene,j,z)$DEO(ene,j,z)
1269                   = [PO4(ene,j,z)*DEO(ene,j,z)**(1+rho_ENER(j,z))]/
1270                     SUM[enee$DIO(ene,j,z),DEO(enee,j,z)**(1+rho_ENER(j,z))];
1271   
1272   B_ENER(j,z)$CEO(j,z)
1273                   = CEO(j,z)/{SUM[ene$DEO(ene,j,z),beta_ENER(ene,j,z)*DEO(ene,j,z)
1274                     **(-rho_ENER(j,z))]**(-1/rho_ENER(j,z))};
1275   
1276   B_ENER_t(j,z,time) = B_ENER(j,z)*(1/AEEI_low(z,'2019'));
1277   
1278  *==============================================================================
1279  *    4.6.3.5 Value added
1280  *==============================================================================
1281   rho_VA(j,z)     = (1-sigma_VA(j,z))/sigma_VA(j,z);
1282   
1283   beta_VA(j,z)$KDCO(j,z)
1284                   = WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)/
1285                    {WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)+
1286                     RCO(j,z)*KDCO(j,z)**(rho_VA(j,z)+1)};
1287   B_VA(j,z)$KDCO(j,z)
1288                   = VAO(j,z)
1289                     /{[beta_VA(j,z)*LDCO(j,z)**(-rho_VA(j,z))+
1290                     (1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
1291                     ]**(-1/rho_VA(j,z))};
1292   
1293   B_VA2(j,z,time) = B_VA(j,z);
1294   
1295  *==============================================================================
1296  *    Composite KLE
1297  *==============================================================================
1298   KLEO(j,z)       = CEO(j,z) + VAO(j,z) ;
1299   
1300   PKLEO(j,z)      = [PCEO(j,z)*CEO(j,z)+PVAO(j,z)*VAO(j,z)]/KLEO(j,z);
1301   
1302   rho_KLE(j,z)    = (1-sigma_KLE(j,z))/sigma_KLE(j,z);
1303   
1304   beta_KLE(j,z)$KLEO(j,z)
1305                   = PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)/
1306                    {PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)+
1307                     PCEO(j,z)*CEO(j,z)**(rho_KLE(j,z)+1)};
1308   
1309   beta_KLE2(j,z)$KLEO(j,z)
1310                   = 1-beta_KLE(j,z);
1311   
1312   B_KLE(j,z)$KLEO(j,z)
1313                   = KLEO(j,z)
1314                     /{[beta_KLE(j,z)*VAO(j,z)**(-rho_KLE(j,z))+
1315                     (beta_KLE2(j,z))*CEO(j,z)**(-rho_KLE(j,z))
1316                     ]**(-1/rho_KLE(j,z))};
1317   
1318   beta_KLE2_t(j,z,time) = beta_KLE2(j,z)*AEEI_low(z,'2019');
1319   
1320  *==============================================================================
1321  *   4.6.4 Calibration of LES parameters
1322  *==============================================================================
1323  *   As the assigned values of income elasticities may not result in
1324  *   consumption shares that add up to 1, this first step
1325  *   adjusts the elasticities proportionally
1326   sigma_Y(i,z)    = sigma_Y(i,z)/{SUM[ij,sigma_Y(ij,z)*PCO(ij,z)*CO(ij,z)]
1327                     /CTHO(z)};
1328   gamma_LES(i,z)  = PCO(i,z)*CO(i,z)*sigma_Y(i,z)/CTHO(z);
1329   CMINO(i,z)      = CO(i,z)+gamma_LES(i,z)*CTHO(z)/{PCO(i,z)*frisch(z)};
1330   
1331  *==============================================================================
1332  *  4.7 Calibration of gross domestic products
1333  *==============================================================================
1334   GDP_BPO(z)      = SUM[j,PVAO(j,z)*VAO(j,z)]+TIPTO(z);
1335   GDP_MPO(z)      = GDP_BPO(z)+TPRCTSO(z);
1336   GDP_IBO(z)      = SUM[(l,j),WO(l,z)*LDO(l,j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1337                     +TPRODNO(z)+TPRCTSO(z);
1338   GDP_FDO(z)      = SUM[i,PCO(i,z)*(CO(i,z)+CGO(i,z)+INVO(i,z))]
1339                    +eO(z)*SUM[(i,zj),PWXO(i,z,zj)*EXO(i,z,zj)]
1340                    +eO(z)*SUM[i,PWMGO(i)*MRGNO(i,z)]
1341                    -eO(z)*SUM[(i,zj),IMO(i,zj,z)*(PWMO(i,zj,z)
1342                    +SUM{ij,PWMGO(ij)*tmrg(ij,i,zj,z)})];
1343   GDP_BP_WO       = SUM[z,GDP_BPO(z)/eO(z)];
1344   
1345  *==============================================================================
1346  *  4.8 Calibration of real (volume) variables computed from price indices
1347  *==============================================================================
1348   CABXO(z)        = CABO(z)/[PIXGDP_WO*eO(z)];
1349   
1350  *------------------------------------------------------------------------------
1351  * Calculation of CAB index
1352  * If every region's CABX grows exogenously according to exogro, then the
1353  * worldwide sum of CABX's will not be zero. If, due to redundancy, the reference
1354  * region's CABX is left implicit, then it will not grow according to that
1355  * region's exogro (it follows that the solution will depend on the choice of
1356  * reference region). CABix is formed from exogro by inflating or deflating the
1357  * updating factors of positive (SURplus) and negative (DEFicit) CABX's in such
1358  * a way that their sum remains zero.
1359   
      Parameter CABXsur(z,time), CABXdef(z,time), bal(time), mu(time), CABix(z,time);
       CABXsur(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) gt 0];
       CABXdef(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) lt 0];
       Bal(time)       = sum(zj,CABXsur(zj,time))+sum(zj,CABXdef(zj,time));
       mu(time)        = sum(zj,CABXsur(zj,time))/
                           {sum(zj,CABXsur(zj,time))+sum(zj,abs[CABXdef(zj,time)])};
       CABXsur(z,time) = CABXsur(z,time)*{1-mu(time)*Bal(time)/sum(zj,CABXsur(zj,time))};
       CABXdef(z,time) = CABXdef(z,time)*{1-[1-mu(time)]*Bal(time)/sum(zj,CABXdef(zj,time))};
       CABix(z,time)   = [CABXsur(z,time)+CABXdef(z,time)]/CABXO(z);
1371  *------------------------------------------------------------------------------
1372   
1373   CTH_REALO(z)    = CTHO(z)/PIXCONO(z);
1374   G_REALO(z)      = GO(z)/PIXGVTO(z);
1375   GDP_BP_REALO(z) = GDP_BPO(z)/PIXGDPO(z);
1376   GDP_BP_W_REALO  = GDP_BP_WO/PIXGDP_WO;
1377   GDP_MP_REALO(z) = GDP_MPO(z)/PIXCONO(z);
1378   IT_REALO(z)     = ITO(z)/PIXINVO(z);
1379   
1380  *==============================================================================
1381  *  4.9 Parameters of the household savings function
1382  *==============================================================================
1383  * sh1O(z)         = SHO(z)/YDHO(z);
1384  * sh0O(z)         = 0 ;
1385   
1386   sh1O(z)         = [SHO(z)+SGO(z)]/GDP_IBO(z);
1387   sh0O(z)         = SHO(z)-sh1O(z)*YDHO(z);
1388   
1389  *==============================================================================
1390  *  4.10 Re-calibration of indexed transfers and parameters
1391  *==============================================================================
1392   sh0O(z)         = sh0O(z)/PIXCONO(z)**eta;
1393   ttdh0O(z)       = ttdh0O(z)/PIXCONO(z)**eta;
1394   
1395  *==============================================================================
1396  *  4.9 CO2 emission
1397  *==============================================================================
