2234  *Sets
2235  WEB, GHGsEF  ;
2236   
2237  Parameter
2238   TCoke_Share(f_cokeoven,product,z)
2239   TBlast_Share(f_balstfur,product,z)
2240  ;
2241   
2242  Parameter
2243   Coal_DIO(p_coal,j,z)            Intermediate consumption of coal products by industry j in region z
2244   Coal_CO(p_coal,z)               Household consumption of coal products in region z
2245   CoalR_DIO(p_coal,j,z)           Intermediate consumption ratio of coal products by industry j in region z
2246   CoalR_CO(p_coal,z)              Household consumption ratio of coal products in region z
2247   
2248   Gas_DIO(p_gas,j,z)              Intermediate consumption of gas products by industry j in region z
2249   Gas_CO(p_gas,z)                 Household consumption of gas products in region z
2250   GasR_DIO(p_gas,j,z)             Intermediate consumption ratio of gas products by industry j in region z
2251   GasR_CO(p_gas,z)                Household consumption ratio of gas products in region z
2252   
2253   Oil_DIO(p_oil,j,z)              Intermediate consumption of crudeoil by industry j in region z
2254   Oil_CO(p_oil,z)                 Household consumption of crudeoil in region z
2255   OilR_DIO(p_oil,j,z)             Intermediate consumption ratio of crudeoil by industry j in region z
2256   
2257   Oilp_DIO(p_oilproduct,j,z)      Intermediate consumption of petrolcoal by industry j in region z
2258   Oilp_CO(p_oilproduct,z)         Household consumption of petrolcoal products in region z
2259   OilpR_DIO(p_oilproduct,j,z)     Intermediate consumption ratio of petrolcoal products by industry j in region z
2260   OilpR_CO(p_oilproduct,z)        Household consumption ratio of petrolcoal products in region z
2261   
2262   Elec_DIO(p_elecheat,j,z)        Intermediate consumption of electricity by industry j in region z
2263   Elec_CO(p_elecheat,z)           Household consumption of electricity in region z
2264   ElecR_DIO(p_elecheat,j,z)       Intermediate consumption ratio of electricity by industry j in region z
2265   ElecR_CO(p_elecheat,z)          Household consumption ratio of electricity in region z
2266   
2267   NCoal_DIO(p_coal,j,z)           Intermediate consumption of non energy coal products by industry j in region z
2268   NCoalR_DIO(p_coal,j,z)          Intermediate consumption ratio of non energy coal products by industry j in region z
2269   
2270   NGas_DIO(p_gas,j,z)             Intermediate consumption of non energy gas products by industry j in region z
