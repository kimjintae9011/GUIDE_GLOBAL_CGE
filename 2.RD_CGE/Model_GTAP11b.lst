5087   valTIX(i,z,zj,time,'bau')   = TIX.l(i,z,zj,time);
5088   valTIXT(z,time,'bau')       = TIXT.l(z,time);
5089   valTPRCTS(z,time,'bau')     = TPRCTS.l(z,time);
5090   valTPRODN(z,time,'bau')     = TPRODN.l(z,time);
5091   valttdh0(z,time,'bau')      = ttdh0.l(z,time);
5092   valttdh1(z,time,'bau')      = ttdh1.l(z,time);
5093   valttic(i,z,time,'bau')     = ttic.l(i,z,time);
5094   valttik(k,j,z,time,'bau')   = ttik.l(k,j,z,time);
5095   valttim(i,zj,z,time,'bau')  = ttim.l(i,zj,z,time);
5096   valttip(j,z,time,'bau')     = ttip.l(j,z,time);
5097   valttiw(l,j,z,time,'bau')   = ttiw.l(l,j,z,time);
5098   valttix(i,z,zj,time,'bau')  = ttix.l(i,z,zj,time);
5099   valU(z,time,'bau')          = U.l(z,time);
5100   valVA(j,z,time,'bau')       = VA.l(j,z,time);
5101   valKLE(j,z,time,'bau')      = KLE.l(j,z,time);
5102   valW(l,z,time,'bau')        = W.l(l,z,time);
5103   valWC(j,z,time,'bau')       = WC.l(j,z,time);
5104   valWTI(l,j,z,time,'bau')    = WTI.l(l,j,z,time);
5105   valXS(j,i,z,time,'bau')     = XS.l(j,i,z,time);
5106   valXS_I(i,z,time,'bau')     = XS_I.l(i,z,time);
5107   valXST(j,z,time,'bau')      = XST.l(j,z,time);
5108   valYDH(z,time,'bau')        = YDH.l(z,time);
5109   valYG(z,time,'bau')         = YG.l(z,time);
5110   valYH(z,time,'bau')         = YH.l(z,time);
5111   valYHK(z,time,'bau')        = YHK.l(z,time);
5112   valYHL(z,time,'bau')        = YHL.l(z,time);
5113   valYROW(z,time,'bau')       = YROW.l(z,time);
5114   
5115  *=============================== Energy =====================================================================
5116   valAEEI(z,time,'bau')                  =  AEEI(z,time);
5117   
5118   valEE(p_coal,j,z,time,'bau')           =  EEI(p_coal,j,z)*DE.L('02_COAL',j,z,time)*AEEI(z,time);
5119   valEE(p_oil,j,z,time,'bau')            =  EEI(p_oil,j,z)*DE.L('03_OIL',j,z,time)*AEEI(z,time);
5120   valEE(p_gas,j,z,time,'bau')            =  EEI(p_gas,j,z)*DE.L('04_GAS',j,z,time)*AEEI(z,time);
5121   valEE(p_oilproduct,j,z,time,'bau')     =  EEI(p_oilproduct,j,z)*DE.L('10_PETROLCOAL',j,z,time)*AEEI(z,time);
5122   valEE(p_elecheat,j,z,time,'bau')       =  EEI(p_elecheat,j,z)*DE.L('18_ELEC',j,z,time)*AEEI(z,time);
5123   
5124   valNE(p_coal,j,z,time,'bau')           =  NEI(p_coal,j,z)*DE.L('02_COAL',j,z,time)*AEEI(z,time);
5125   valNE(p_oil,j,z,time,'bau')            =  NEI(p_oil,j,z)*DE.L('03_OIL',j,z,time)*AEEI(z,time);
5126   valNE(p_gas,j,z,time,'bau')            =  NEI(p_gas,j,z)*DE.L('04_GAS',j,z,time)*AEEI(z,time);
5127   valNE(p_oilproduct,j,z,time,'bau')     =  NEI(p_oilproduct,j,z)*DE.L('10_PETROLCOAL',j,z,time)*AEEI(z,time);
5128   valNE(p_elecheat,j,z,time,'bau')       =  NEI(p_elecheat,j,z)*DE.L('18_ELEC',j,z,time)*AEEI(z,time);
5129   
5130   valEH(p_coal,z,time,'bau')             =  EHI(p_coal,z)*C.L('02_COAL',z,time)*AEEI(z,time);
5131   valEH(p_oil,z,time,'bau')              =  EHI(p_oil,z)*C.L('03_OIL',z,time)*AEEI(z,time);
5132   valEH(p_gas,z,time,'bau')              =  EHI(p_gas,z)*C.L('04_GAS',z,time)*AEEI(z,time);
5133   valEH(p_oilproduct,z,time,'bau')       =  EHI(p_oilproduct,z)*C.L('10_PETROLCOAL',z,time)*AEEI(z,time);
5134   valEH(p_elecheat,z,time,'bau')         =  EHI(p_elecheat,z)*C.L('18_ELEC',z,time)*AEEI(z,time);
5135   
5136   valTFC_product(product,time,z,'bau')   =  valEH(product,z,time,'bau') + Sum(j4,valEE(product,j4,z,time,'bau')) + Sum(j,valNE(product,j,z,time,'bau'));
5137   valTFC(time,z,'bau')                   =  sum(product, valEH(product,z,time,'bau') + Sum(j4,valEE(product,j4,z,time,'bau'))+ Sum(j,valNE(product,j,z,time,'bau')));
5138   
5139   valNEA_TFC(product,time,'bau')         = sum(NEA,valEH(product,NEA,time,'bau')) + Sum((j4,NEA),valEE(product,j4,NEA,time,'bau')) + Sum((j,NEA),valNE(product,j,NEA,time,'bau'));
5140   valKOR_TFC(product,time,'bau')         = valEH(product,'01_KOR',time,'bau') + Sum(j4,valEE(product,j4,'01_KOR',time,'bau')) + Sum(j,valNE(product,j,'01_KOR',time,'bau'));
5141   valCHN_TFC(product,time,'bau')         = valEH(product,'02_CHN',time,'bau') + Sum(j4,valEE(product,j4,'02_CHN',time,'bau')) + Sum(j,valNE(product,j,'02_CHN',time,'bau'));
5142   valJPN_TFC(product,time,'bau')         = valEH(product,'03_JPN',time,'bau') + Sum(j4,valEE(product,j4,'03_JPN',time,'bau')) + Sum(j,valNE(product,j,'03_JPN',time,'bau'));
5143   
5144   valTES_coal(z,time,'bau')              = sum(p_coal_TES,TES_coal(p_coal_TES,z))*[valQ('02_COAL',z,time,'bau')/valQ('02_COAL',z,'2019','bau')];
5145   valTES_oil(z,time,'bau')               = sum(p_oil,TES_oil(p_oil,z))*[valQ('03_OIL',z,time,'bau')/valQ('03_OIL',z,'2019','bau')];
5146   valTES_gas(z,time,'bau')               = sum(p_gas,TES_gas(p_gas,z))*[valQ('04_GAS',z,time,'bau')/valQ('04_GAS',z,'2019','bau')];
5147   valTES(z,time,'bau')                   = valTES_coal(z,time,'bau') + valTES_oil(z,time,'bau') + valTES_gas(z,time,'bau') ;
5148   
5149  * TES_Coal(p_coal,z) =  sum(f_TES, WEB(f_TES, p_coal2, z));
5150  * TES_Gas(p_coal,z)  =  sum(f_TES, WEB(f_TES, p_gas, z));
5151  * TES_Oil(p_oil,z)   =  sum(f_TES, WEB(f_TES, p_oil, z));
5152   
5153  *============================== CO2 =========================================================================
5154   valCO2I(product,j,z,time,'bau')        = valEE(product,j,z,time,'bau')*41.868*GHGsEF(product,'CO2EF')*1*(44/12)*0.001 ;
5155   valCO2NE(product,j,z,time,'bau')       = valNE(product,j,z,time,'bau')*(1-GHGsEF(product,'Stored_rate'))*41.868*GHGsEF(product,'CO2EF')*1*(44/12)*0.001 ;
5156   valCO2I2(j,z,time,'bau')               = sum(product,valCO2I(product,j,z,time,'bau'));
5157   valCO2NE2(j,z,time,'bau')              = sum(product,valCO2NE(product,j,z,time,'bau'));
5158   valCO2I3(j,z,time,'bau')               = valCO2I2(j,z,time,'bau') + valCO2NE2(j,z,time,'bau') ;
5159   valTCO2I(z,time,'bau')                 = sum((product,j),valCO2I(product,j,z,time,'bau'));
5160   valTCO2NE(z,time,'bau')                = sum((product,j),valCO2NE(product,j,z,time,'bau'));
5161   valCO2H(product,z,time,'bau')          = valEH(product,z,time,'bau')*41.868*GHGsEF(product,'CO2EF')*1*(44/12)*0.001 ;
5162   valTCO2H(z,time,'bau')                 = sum((product),valCO2H(product,z,time,'bau'));
5163   valTCO2(z,time,'bau')                  = valTCO2H(z,time,'bau') + valTCO2I(z,time,'bau') +valTCO2NE(z,time,'bau') ;
5164   
5165   valEndo_CO2(ene,j,z,time,'bau')        = DE.L(ene,j,z,time)*CO2FACTOR2(ene,j,z,time)*10*1000;
5166   valEndo_TotalCO2(z,time,'bau')         = sum((ene,j), valEndo_CO2(ene,j,z,time,'bau'));
5167   
5168  *============================== CH4(CO2equivalent) =========================================================================
5169  *Energy
5170   valCH4I(product,Energy,z,time,'bau')    = valEE(product,Energy,z,time,'bau')*41.868*GHGsEF(product,'CH4EF_Energy')/10**6*GWP_CH4 ;
5171  *Industry
5172   valCH4I(product,IndCon,z,time,'bau')    = valEE(product,IndCon,z,time,'bau')*41.868*GHGsEF(product,'CH4EF_Industry')/10**6*GWP_CH4 ;
5173  *LTRP
5174   valCH4I(product,Roadrail,z,time,'bau')  = valEE(product,Roadrail,z,time,'bau')*41.868*GHGsEF(product,'CH4EF_LTRP')/10**6*GWP_CH4 ;
5175  *ATRP
5176   valCH4I(product,Air,z,time,'bau')       = valEE(product,Air,z,time,'bau')*41.868*GHGsEF(product,'CH4EF_ATRP')/10**6*GWP_CH4 ;
5177  *WTRP
5178   valCH4I(product,Water,z,time,'bau')     = valEE(product,Water,z,time,'bau')*41.868*GHGsEF(product,'CH4EF_WTRP')/10**6*GWP_CH4 ;
5179  *Other
5180   valCH4I(product,Other,z,time,'bau')     = valEE(product,Other,z,time,'bau')*41.868*GHGsEF(product,'CH4EF_Other')/10**6*GWP_CH4 ;
5181  *Household
5182   valCH4H(product,z,time,'bau')           = valEH(product,z,time,'bau')*41.868*GHGsEF(product,'CH4EF_Other')/10**6*GWP_CH4 ;
5183   
5184   valCH4I2(j,z,time,'bau')                = sum(product,valCH4I(product,j,z,time,'bau'));
5185   valCH4I3(j,z,time,'bau')                = valCH4I2(j,z,time,'bau') ;
5186   valTCH4I(z,time,'bau')                  = sum((product,j),valCH4I(product,j,z,time,'bau'));
5187   valTCH4H(z,time,'bau')                  = sum((product),valCH4H(product,z,time,'bau'));
5188   valTCH4(z,time,'bau')                   = valTCH4H(z,time,'bau') + valTCH4I(z,time,'bau') ;
5189   
5190  *============================== N2O(CO2equivalent) ========================================================================
5191  *Energy
5192   valN2OI(product,Energy,z,time,'bau')    = valEE(product,Energy,z,time,'bau')*41.868*GHGsEF(product,'N2OEF_Energy')/10**6*GWP_N2O ;
5193  *Industry
5194   valN2OI(product,IndCon,z,time,'bau')    = valEE(product,IndCon,z,time,'bau')*41.868*GHGsEF(product,'N2OEF_Industry')/10**6*GWP_N2O ;
5195  *LTRP
5196   valN2OI(product,Roadrail,z,time,'bau')  = valEE(product,Roadrail,z,time,'bau')*41.868*GHGsEF(product,'N2OEF_LTRP')/10**6*GWP_N2O ;
5197  *ATRP
5198   valN2OI(product,Air,z,time,'bau')       = valEE(product,Air,z,time,'bau')*41.868*GHGsEF(product,'N2OEF_ATRP')/10**6*GWP_N2O ;
5199  *WTRP
5200   valN2OI(product,Water,z,time,'bau')     = valEE(product,Water,z,time,'bau')*41.868*GHGsEF(product,'N2OEF_WTRP')/10**6*GWP_N2O ;
5201  *Other
5202   valN2OI(product,Other,z,time,'bau')     = valEE(product,Other,z,time,'bau')*41.868*GHGsEF(product,'N2OEF_Other')/10**6*GWP_N2O ;
5203  *Household
5204   valN2OH(product,z,time,'bau')           = valEH(product,z,time,'bau')*41.868*GHGsEF(product,'N2OEF_Other')/10**6*GWP_N2O ;
5205   
5206   valN2OI2(j,z,time,'bau')               = sum(product,valN2OI(product,j,z,time,'bau'));
5207   valN2OI3(j,z,time,'bau')               = valN2OI2(j,z,time,'bau') ;
5208   valTN2OI(z,time,'bau')                 = sum((product,j),valN2OI(product,j,z,time,'bau'));
5209   valTN2OH(z,time,'bau')                 = sum((product),valN2OH(product,z,time,'bau'));
5210   valTN2O(z,time,'bau')                  = valTN2OH(z,time,'bau') + valTN2OI(z,time,'bau') ;
5211   
5212  *============================= Global GHGs emission ========================================================
5213   valGlobal_CO2(time,'bau')              = sum(z, valTCO2(z,time,'bau'));
5214   valGlobal_CH4(time,'bau')              = sum(z, valTCH4(z,time,'bau'));
5215   valGlobal_N2O(time,'bau')              = sum(z, valTN2O(z,time,'bau'));
5216   
5217  *============================== Power Generation ============================================
5218   valPOWER(power,i,z,time,scen)          = XS.l(power,i,z,time);
5219   valElecGen('Nuclear',z,time,'bau')     = XS.l('19_eNuclear','18_ELEC',z,time)*EGINucGWh('19_eNuclear',z);
5220   valElecGen('Coal',z,time,'bau')        = XS.l('20_eCoal','18_ELEC',z,time)*EGICoalGWh('20_eCoal',z);
5221   valElecGen('Gas',z,time,'bau')         = XS.l('21_eGas','18_ELEC',z,time)*EGIGasGWh('21_eGas',z);
5222   valElecGen('Oil',z,time,'bau')         = XS.l('22_eOil','18_ELEC',z,time)*EGIOilGWh('22_eOil',z);
5223   valElecGen('Wind',z,time,'bau')        = XS.l('23_eWind','18_ELEC',z,time)*EGIWindGWh('23_eWind',z);
5224   valElecGen('Solar',z,time,'bau')       = XS.l('24_eSolar','18_ELEC',z,time)*EGISolarGWh('24_eSolar',z);
5225   valElecGen('Hydro',z,time,'bau')       = XS.l('25_eHydro','18_ELEC',z,time)*EGIHydroGWh('25_eHydro',z);
5226   valElecGen('Waste',z,time,'bau')       = XS.l('26_eOther','18_ELEC',z,time)*EGIWasteGWh('26_eOther',z);
5227   valElecGen('Bio',z,time,'bau')         = XS.l('26_eOther','18_ELEC',z,time)*EGIBioGWh('26_eOther',z);
5228   valElecGen('Geothermal',z,time,'bau')  = XS.l('26_eOther','18_ELEC',z,time)*EGIGeoGWh('26_eOther',z);
5229   valElecGen('Other',z,time,'bau')       = XS.l('26_eOther','18_ELEC',z,time)*EGIOtherGWh('26_eOther',z);
5230   
5231   valElecGen('Total',z,time,'bau')       = valElecGen('Nuclear',z,time,'bau') + valElecGen('Coal',z,time,'bau')+ valElecGen('Gas',z,time,'bau')
5232                                           + valElecGen('Oil',z,time,'bau') + valElecGen('Wind',z,time,'bau')+ valElecGen('Solar',z,time,'bau')
5233                                           + valElecGen('Hydro',z,time,'bau') + valElecGen('Waste',z,time,'bau')+ valElecGen('Bio',z,time,'bau')
5234                                           + valElecGen('Geothermal',z,time,'bau') + valElecGen('Geothermal',z,time,'bau') + valElecGen('Other',z,time,'bau') ;
5235   
5236  *============================== Carbon Tax ============================================
5237   valCTAX(z,time,'bau') = CTAX.l(z,time) ;
5238   
5239  *================== Backstop technology ===========================================================
5240   valswitch(i3,z,time,'NZS') = switch(i3,z,time) ;
5241   valpenetration_rate(i3,z,time,'NZS') = penetration_rate(i3,z,time) ;
5242   valC_Conventional(i3,z,time,'NZS') = C_Conventional.l(i3,z,time) ;
5243   valXDBS(i3,z,time,'NZS')  = XDBS.l(i3,z,time) ;
5244   valXDBS2(j,z,time,'NZS')  = XDBS2.l(j,z,time) ;
5245   valLBS(l,j,z,time,'NZS')  = LBS.l(l,j,z,time) ;
5246   valKBS(k,j,z,time,'NZS')  = KBS.l(k,j,z,time) ;
5247   valCLBS(i3,z,time,'NZS')  = CLBS.l(i3,z,time) ;
5248   valCKBS(i3,z,time,'NZS')  = CKBS.l(i3,z,time) ;
5249   valMARKUP(i3,z,time,'NZS')= MARKUP.l(i3,z,time) ;
