4453  *$ontext
4454  * FP CLOSURE: fixed PIXGDPs; numeraire is exchange rate of reference region
4455  * The exchange rates are endogenous, except for the reference region.
4456   e.FX(zr,time)      = eO(zr);
4457   PIXGDP.FX(z,time)  = PIXGDPO(z)/sum[zr,eO(zr)];
4458  *$offtext
4459   
      * FE CLOSURE: fixed exchange rates; numeraire is PIXGDP of reference region
      * The exchange rates can be fixed at arbitrary values
       PIXGDP.FX(zr,time)  = PIXGDPO(zr);
       e.FX(z,time)        = eO(z);
4466   
4467  *==============================================================================
4468  *   6.2.2.2 Variables fixed each period according to their lagged values
4469  *==============================================================================
4470   CABX.FX(z1,t1)      = CABXO(z1);
4471   CABX.FX(z1,time)$[ord(time) gt 1]
4472  *                     = CABX.l(z1,time-1)*[1+growthz(z1)];
4473                       = CABX.l(z1,time-1)*[1+g_GDP(z1,time)];
4474   
4475   CMIN.FX(i,z,t1)     = CMINO(i,z);
4476   CMIN.FX(i,z,time)$[ord(time) gt 1]
4477  *                     = CMIN.l(i,z,time-1)*[1+growthz(z)];
4478                        = CMIN.l(i,z,time-1)*[1+g_GDP(z,time)];
4479   
4480   KD.fx(k,j,z,t1)$KDO(k,j,z)
4481                       = KDO(k,j,z);
4482   KD.fx(k,j,z,time)${[ord(time) gt 1] and KDO(k,j,z)}
4483                       = KD.l(k,j,z,time-1)*[1-delta(z)]+IND.l(k,j,z,time-1);
4484   
4485   KD.fx('natr',j,z,time)${[ord(time) gt 1] and KDO('natr',j,z)}
4486                       = KD.l('natr',j,z,time-1)*(1-0.01);
4487   
4488   KD.fx('land',j,z,time)${[ord(time) gt 1] and KDO('land',j,z)}
4489                       = KD.l('land',j,z,time-1);
4490   
4491   LS.FX(l,z,t1)       = LSO(l,z);
4492   LS.FX(l,z,time)$[ord(time) gt 1]
4493  *                     = LS.l(l,z,time-1)*[1+growthz(z)];
4494                       = LS.l(l,z,time-1)*[1+g_POP(z,time)];
4495   
4496  *==============================================================================
4497  *   CTAX
4498  *==============================================================================
4499   CTAX.fx(z,time)$[ord(time) gt 1]
4500                              = CTAX_Cal(z,time);
4501   
4502  * CTAX.fx('06_PRK',time)$[ord(time) gt 1]
4503  *                            = 0 ;
4504   
4505  *==============================================================================
4506  *   AEEI
4507  *==============================================================================
4508  * B_ENER_t(j2,'01_KOR',time) = B_ENER(j2,'01_KOR')*(AEEI_low('01_KOR',time));
4509  * beta_KLE2_t(j2,z,time) = beta_KLE2(j2,z)*AEEI(z,time);
4510  * aij2_t(ene,j3,'01_KOR',time)  =  aij2(ene,j3,'01_KOR')*AEEI_low('01_KOR',time) ;
4511  * io2_t(j,'01_KOR',time) = io2(j,'01_KOR')*(1/AEEI_low('01_KOR',time)) ;
4512   
4513  * io2_t(j,'01_KOR',t1)   = io2(j,'01_KOR');
4514  * io2_t(j,'01_KOR',time)$[ord(time) gt 1]
4515  *                        =  io2_t(j,'01_KOR',time-1)*[1- 0.01 ];
4516   
4517   AEEI(z,time) = AEEI_low(z,time);
4518   CO2FACTOR2(ene,j2,z,time) = CO2FACTOR(ene,j2,z)*AEEI(z,time);
4519   
4520  *==============================================================================
4521  *Backstop technologies
4522  *==============================================================================
4523  penetration_rate(i3,z,time)$[CTAX.L(z,time) gt 0.5]
4524                               = penetration_rate(i3,z,time-1)+0.02;
4525   
4526  if ((CTAX.L('01_KOR',time)  gt 0.5), switch(i3,'01_KOR',time) = 1  ;
4527  else switch(i3,'01_KOR',time) = 0 ;
4528  );
4529   
4530  if ((CTAX.L('02_CHN',time)  gt 1.0), switch(i3,'02_CHN',time) = 1  ;
4531  else switch(i3,'02_CHN',time) = 0 ;
4532  );
4533   
4534  if ((CTAX.L('03_JPN',time)  gt 1.0), switch(i3,'03_JPN',time) = 1  ;
4535  else switch(i3,'03_JPN',time) = 0 ;
4536  );
4537   
4538  if ((CTAX.L('04_RUS',time)  gt 1.0), switch(i3,'04_RUS',time) = 1  ;
4539  else switch(i3,'04_RUS',time) = 0 ;
4540  );
4541   
4542  if ((CTAX.L('05_MNG',time)  gt 1.0), switch(i3,'05_MNG',time) = 1  ;
4543  else switch(i3,'05_MNG',time) = 0 ;
4544  );
4545   
4546  if ((CTAX.L('06_PRK',time)  gt 1.0), switch(i3,'06_PRK',time) = 1  ;
4547  else switch(i3,'06_PRK',time) = 0 ;
4548  );
4549   
4550  if ((CTAX.L('07_NAM',time)  gt 1.0), switch(i3,'07_NAM',time) = 1  ;
4551  else switch(i3,'07_NAM',time) = 0 ;
4552  );
4553   
4554  if ((CTAX.L('08_LAM',time)  gt 1.0), switch(i3,'08_LAM',time) = 1  ;
4555  else switch(i3,'08_LAM',time) = 0 ;
4556  );
4557   
4558  if ((CTAX.L('09_WEU',time)  gt 1.0), switch(i3,'09_WEU',time) = 1  ;
4559  else switch(i3,'09_WEU',time) = 0 ;
4560  );
4561   
4562  if ((CTAX.L('10_EEU',time)  gt 1.0), switch(i3,'10_EEU',time) = 1  ;
4563  else switch(i3,'10_EEU',time) = 0 ;
4564  );
4565   
4566  if ((CTAX.L('11_FSU',time)  gt 1.0), switch(i3,'11_FSU',time) = 1  ;
4567  else switch(i3,'11_FSU',time) = 0 ;
4568  );
4569   
4570  if ((CTAX.L('12_MEA',time)  gt 1.0), switch(i3,'12_MEA',time) = 1  ;
4571  else switch(i3,'12_MEA',time) = 0 ;
4572  );
4573   
4574  if ((CTAX.L('13_AFR',time)  gt 1.0), switch(i3,'13_AFR',time) = 1  ;
4575  else switch(i3,'13_AFR',time) = 0 ;
4576  );
4577   
4578  if ((CTAX.L('14_CPA',time)  gt 1.0), switch(i3,'14_CPA',time) = 1  ;
4579  else switch(i3,'14_CPA',time) = 0 ;
4580  );
4581   
4582  if ((CTAX.L('15_SAS',time)  gt 1.0), switch(i3,'15_SAS',time) = 1  ;
4583  else switch(i3,'15_SAS',time) = 0 ;
4584  );
4585   
4586  if ((CTAX.L('16_PAS',time)  gt 1.0), switch(i3,'16_PAS',time) = 1  ;
4587  else switch(i3,'16_PAS',time) = 0 ;
4588  );
4589   
4590  if ((CTAX.L('17_PAO',time)  gt 1.0), switch(i3,'17_PAO',time) = 1  ;
4591  else switch(i3,'17_PAO',time) = 0 ;
4592  );
4593   
4594   
      penetration_rate('10_PETROLCOAL','01_KOR',time)$[CTAX.L('01_KOR',time) gt 1.0]
                                   = penetration_rate('10_PETROLCOAL','01_KOR',time-1)+0.02;
       
      penetration_rate('13_IRONSTL','01_KOR',time)$[PCE.L('13_IRONSTL','01_KOR',time) gt 2.0]
                                   = penetration_rate('13_IRONSTL','01_KOR',time-1)+0.04;
       
      penetration_rate('20_LTRP','01_KOR',time)$[CTAX.L('01_KOR',time) gt 1.0]
                                   = penetration_rate('20_LTRP','01_KOR',time-1)+0.04;
       
      if ((CTAX.L('01_KOR',time)  gt 1.0), switch('10_PETROLCOAL','01_KOR',time) = 1  ;
      else switch('10_PETROLCOAL','01_KOR',time) = 0 ;
      );
       
      if ((PCE.L('13_IRONSTL','01_KOR',time)  gt 2.0), switch('13_IRONSTL','01_KOR',time) = 1  ;
      else switch('13_IRONSTL','01_KOR',time) = 0 ;
      );
       
      if ((CTAX.L('01_KOR',time)  gt 1.0), switch('20_LTRP','01_KOR',time) = 1  ;
      else switch('20_LTRP','01_KOR',time) = 0 ;
      );
4617   
4618  *==============================================================================
4619  *   6.2.2.3 Resolution
4620  *==============================================================================
4621   
4622  SOLVE PEPWT USING CNS;
4623  *SOLVE PEPWT using NLP maximizing OBJ;
4624  *SOLVE PEPWT USING MCP;
4625   
4626  * The single element in subset T(time) is removed, and the subset is now empty.
4627  T(time)          = NO;
4628  * End of LOOP over time periods
4629  ];
4630  *$exit
