7581  * EQ34(z,t)..       SROW(z,t) =e= YROW(z,t)-e(z,t)*SUM[(i,zj)$EXO(i,z,zj),
7582  *                               EX(i,z,zj,t)*PWX(i,z,zj,t)]-e(z,t)
7583  *                               *SUM[i$MRGNO(i,z),MRGN(i,z,t)*PWMG(i,t)];
