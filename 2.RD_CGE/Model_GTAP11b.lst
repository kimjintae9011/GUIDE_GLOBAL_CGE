6358   
6359  *==============================================================================
6360  * A. Initialization
6361  *    Assignment of initial values to variables prior to resolution
6362  *==============================================================================
6363  *  A.1 Initialization for the first period
6364  *==============================================================================
6365  *   A.1.1 Volume variables
6366  *==============================================================================
6367   CABX.L(z,t1)      = CABXO(z);
6368   C.L(i,z,t1)       = CO(i,z);
6369   CG.L(i,z,t1)      = CGO(i,z);
6370   CI.L(j,z,t1)      = CIO(j,z);
6371   CE.L(j,z,t1)      = CEO(j,z);
6372   CMIN.L(i,z,t1)    = CMINO(i,z);
6373   CTH_REAL.L(z,t1)  = CTH_REALO(z);
6374   DI.L(i,j,z,t1)    = DIO(i,j,z);
6375   DE.L(ene,j,z,t1)  = DEO(ene,j,z);
6376   DIT.L(i,z,t1)     = DITO(i,z);
6377   DD.L(i,z,t1)      = DDO(i,z);
6378   DS.L(j,i,z,t1)    = DSO(j,i,z);
6379   DS_I.L(i,z,t1)    = DSO_I(i,z);
6380   EX.L(i,z,zj,t1)   = EXO(i,z,zj);
6381   EXT.L(i,z,t1)     = EXTO(i,z);
6382   EXTT.L(j,i,z,t1)  = EXTTO(j,i,z);
6383   G_REAL.L(z,t1)    = G_REALO(z);
6384   GDP_BP_REAL.l(z,t1) = GDP_BP_REALO(z);
6385   GDP_MP_REAL.l(z,t1) = GDP_MP_REALO(z);
6386   GDP_BP_W_REAL.l(t1) = GDP_BP_W_REALO;
6387   IM.L(i,zj,z,t1)   = IMO(i,zj,z);
6388   IMT.L(i,z,t1)     = IMTO(i,z);
6389   IND.L(k,j,z,t1)   = INDO(k,j,z);
6390   INV.L(i,z,t1)     = INVO(i,z);
