3230  *==============================================================================
3231  *   5.3.1 Production
3232  *==============================================================================
3233   EQ1(j3,z,t)..     VA(j3,z,t) =e= v(j3,z)*XST(j3,z,t);
3234   
3235   EQ1_1(j2,z,t)..   KLE(j2,z,t) =e= v2(j2,z)*XST(j2,z,t);
3236   
3237   EQ2(j,z,t)..      CI(j,z,t) =e= io(j,z)*XST(j,z,t);
3238   
3239  * EQ2_1(j3,z,t)..   CE(j3,z,t) =e= io2(j3,z)*XST(j3,z,t);
3240   EQ2_1(j3,z,t)..   CE(j3,z,t) =e= io2_t(j3,z,t)*XST(j3,z,t);
3241   
3242  * EQ3(j,z,t)..      VA(j,z,t) =e= A_VA(z,t)*B_VA(j,z)*{
3243   EQ3(j,z,t)..      VA(j,z,t) =e= A_VA(z,t)*B_VA2(j,z,t)*{
3244                      [beta_VA(j,z)*LDC(j,z,t)**(-rho_VA(j,z))]$LDCO(j,z)
3245                     +[(1-beta_VA(j,z))*KDC(j,z,t)**(-rho_VA(j,z))]$KDCO(j,z)
3246                                                     }**(-1/rho_VA(j,z));
3247   
3248   EQ3_1(j2,z,t)..   KLE(j2,z,t) =e= B_KLE(j2,z)*{
3249  *                    [beta_KLE(j2,z)*VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
3250  *                   +[(beta_KLE2(j2,z))*CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
3251  *                                                   }**(-1/rho_KLE(j2,z));
3252                      [(1-beta_KLE2_t(j2,z,t))*VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
3253                     +[(beta_KLE2_t(j2,z,t))*CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
3254                                                     }**(-1/rho_KLE(j2,z));
3255   
3256   EQ4(j,z,t)$[LDCO(j,z) and KDCO(j,z)]..
3257                   LDC(j,z,t) =e= {[beta_VA(j,z)/(1-beta_VA(j,z))]
3258                                *[RC(j,z,t)/WC(j,z,t)]}**sigma_VA(j,z)*KDC(j,z,t);
3259   
3260   EQ4_1(j2,z,t)$[VAO(j2,z) and CEO(j2,z)]..
3261  *                 VA(j2,z,t) =e= {[beta_KLE(j2,z)/(beta_KLE2(j2,z))]
3262  *                              *[PCE(j2,z,t)/PVA(j2,z,t)]}**sigma_KLE(j2,z)*CE(j2,z,t);
3263                   VA(j2,z,t) =e= {[(1-beta_KLE2_t(j2,z,t))/(beta_KLE2_t(j2,z,t))]
3264                                *[PCE(j2,z,t)/PVA(j2,z,t)]}**sigma_KLE(j2,z)*CE(j2,z,t);
3265   
3266   EQ5(j,z,t)$LDCO(j,z)..
3267  *                 LDC(j,z,t) =e= B_LD2(j,z,t)*SUM[l$LDO(l,j,z),beta_LD(l,j,z)
3268  *                                *(LD(l,j,z,t)*A_VA2(j,z,t))**(-rho_LD(j,z))]**(-1/rho_LD(j,z)) ;
3269  *                 LDC(j,z,t)/B_LD(j,z) =e= SUM[l$LDO(l,j,z),beta_LD(l,j,z)*LD(l,j,z,t)**(-rho_LD(j,z))]**(-1/rho_LD(j,z));
3270   
3271  LDC(j,z,t) =e= B_LD2(j,z,t) * EXP((-1/rho_LD(j,z)) * LOG(SUM(l$LDO(l,j,z), beta_LD(l,j,z)
3272                                 * EXP(-rho_LD(j,z) * LOG(LD(l,j,z,t) * A_VA2(j,z,t))))));
3273   
3274   EQ6(l,j,z,t)$LDO(l,j,z)..
3275                   LD(l,j,z,t) =e= [beta_LD(l,j,z)*WC(j,z,t)/WTI(l,j,z,t)]
3276                                 **sigma_LD(j,z)*B_LD(j,z)**(sigma_LD(j,z)-1)
3277                                 *LDC(j,z,t);
3278   
3279   EQ7(j,z,t)$KDCO(j,z)..
3280  *                 KDC(j,z,t) =e= B_KD(j,z)*SUM[k$KDO(k,j,z),beta_KD(k,j,z)
3281                   KDC(j,z,t) =e= B_KD2(j,z,t)*SUM[k$KDO(k,j,z),beta_KD(k,j,z)
3282                                  *KD(k,j,z,t)**(-rho_KD(j,z))]**(-1/rho_KD(j,z));
3283   
3284   EQ8(k,j,z,t)$KDO(k,j,z)..
3285                   KD(k,j,z,t) =e= [beta_KD(k,j,z)*RC(j,z,t)/RTI(k,j,z,t)]
3286                                   **sigma_KD(j,z)*B_KD(j,z)**(sigma_KD(j,z)-1)
3287                                   *KDC(j,z,t);
3288   
3289   EQ9(nene,j,z,t)..    DI(nene,j,z,t) =e= aij(nene,j,z)*CI(j,z,t) ;
3290   
3291   EQ9_1(ene,j3,z,t)..  DE(ene,j3,z,t) =e= aij2_t(ene,j3,z,t)*CE(j3,z,t) ;
3292   
3293  * EQ9_3(j2,z,t)..      CE(j2,z,t) =e= B_ENER_t(j2,z,t)*SUM[ene,beta_ENER(ene,j2,z)
3294  *                                *DE(ene,j2,z,t)**(-rho_ENER(j2,z))]**(-1/rho_ENER(j2,z));
3295   
3296  * EQ9_2(ene,j2,z,t)..  DE(ene,j2,z,t) =e= [beta_ENER(ene,j2,z)*PCE(j2,z,t)/((P4(ene,j2,z,t)+PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j2,z,t)))]
3297   EQ9_2(ene,j2,z,t)..  DE(ene,j2,z,t) =e= [beta_ENER(ene,j2,z)*PCE(j2,z,t)/((P4(ene,j2,z,t)+P4(ene,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j2,z,t)))]
3298                                     **sigma_ENER(j2,z)*B_ENER_t(j2,z,t)**(sigma_ENER(j2,z)-1)
3299                                     *CE(j2,z,t);
3300   
3301  *==============================================================================
3302  *   5.3.2 Income and savings
3303  *==============================================================================
3304  *    5.3.2.1 Households
3305  *==============================================================================
3306   EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t)+TCTAX(z,t)+SUM(i3,MARKUP(i3,z,t));
3307   
3308  * EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t)+TCTAX(z,t);
3309  * EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t) ;
3310   
3311   EQ11(z,t)..       YHL(z,t) =e= SUM[(l,j)$LDO(l,j,z),W(l,z,t)*LD(l,j,z,t)];
3312   
3313   EQ12(z,t)..       YHK(z,t) =e= SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*KD(k,j,z,t)];
3314   
3315   EQ13(z,t)..       YDH(z,t) =e= YH(z,t)-TDH(z,t);
3316   
3317   EQ14(z,t)..       CTH(z,t) =e= YDH(z,t)-SH(z,t);
3318   
3319   EQ15(z,t)..       SH(z,t) =e= PIXCON(z,t)**eta*sh0(z,t)+sh1(z,t)*YDH(z,t);
3320  * EQ15(z,t)..       SH(z,t) =e= sh1(z,t)*YDH(z,t);
3321   
3322  *==============================================================================
3323  *    5.3.2.2 Government
3324  *==============================================================================
3325   EQ16(z,t)..       YG(z,t) =e= TDH(z,t)+TPRODN(z,t)+TPRCTS(z,t)+TCTAX(z,t);
3326  *TCTAX(z,t)
3327   EQ16_1(z,t)..     TCTAX(z,t) =e= sum((ene,j), PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t));
3328   
3329   EQ17(z,t)..       TPRODN(z,t) =e= TIWT(z,t)+TIKT(z,t)+TIPT(z,t);
3330   
3331   EQ18(z,t)..       TIWT(z,t) =e= SUM[(l,j)$LDO(l,j,z),TIW(l,j,z,t)];
3332   
3333   EQ19(z,t)..       TIKT(z,t) =e= SUM[(k,j)$KDO(k,j,z),TIK(k,j,z,t)];
3334   
3335   EQ20(z,t)..       TIPT(z,t) =e= SUM[j,TIP(j,z,t)];
3336   
3337   EQ21(z,t)..       TPRCTS(z,t) =e= TICT(z,t)+TIMT(z,t)+TIXT(z,t);
3338   
3339   EQ22(z,t)..       TICT(z,t) =e= SUM[i,TIC(i,z,t)];
3340   
3341   EQ23(z,t)..       TIMT(z,t) =e= SUM[(i,zj)$IMO(i,zj,z),TIM(i,zj,z,t)];
3342   
3343   EQ24(z,t)..       TIXT(z,t) =e= SUM[(i,zj)$EXO(i,z,zj),TIX(i,z,zj,t)];
3344   
3345   EQ25(z,t)..       TDH(z,t) =e= PIXCON(z,t)**eta*ttdh0(z,t)+ttdh1(z,t)*YH(z,t);
3346   
3347   EQ26(l,j,z,t)$LDO(l,j,z)..
3348                     TIW(l,j,z,t) =e= ttiw(l,j,z,t)*W(l,z,t)*LD(l,j,z,t);
3349   
3350   EQ27(k,j,z,t)$KDO(k,j,z)..
3351                     TIK(k,j,z,t) =e= ttik(k,j,z,t)*R(k,j,z,t)*KD(k,j,z,t);
3352   
3353   EQ28(j,z,t)..     TIP(j,z,t) =e= ttip(j,z,t)*PP(j,z,t)*XST(j,z,t);
3354   
3355   EQ29(i,z,t)..     TIC(i,z,t) =e= ttic(i,z,t)*{[PL(i,z,t)*DD(i,z,t)]$DDO(i,z)
3356                   +[SUM[zj$IMO(i,zj,z),(1+ttim(i,zj,z,t))*IM(i,zj,z,t)*e(z,t)
3357                    *(PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z)))]]};
3358   
3359   EQ30(i,zj,z,t)$IMO(i,zj,z)..
3360                   TIM(i,zj,z,t) =e= ttim(i,zj,z,t)*IM(i,zj,z,t)*e(z,t)*
3361                                     (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
3362                                     *tmrg(ij,i,zj,z)]);
3363   
3364   EQ31(i,z,zj,t)$EXO(i,z,zj)..
3365                   TIX(i,z,zj,t) =e= ttix(i,z,zj,t)*PE(i,z,zj,t)*EX(i,z,zj,t);
3366   
3367   EQ32(z,t)..       SG(z,t) =e= YG(z,t)-G(z,t)-TCTAX(z,t);
3368  * EQ32(z,t)..       SG(z,t) =e= YG(z,t)- sum(i,PC(i,z,t)*CG(i,z,t));
3369   
3370  *==============================================================================
3371  *    5.3.2.4 Rest of the world
3372  *==============================================================================
3373   EQ33(z,t)..       YROW(z,t) =e= e(z,t)*SUM{(i,zj)$IMO(i,zj,z),IM(i,zj,z,t)*
3374                             [PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z))]};
3375   
3376   EQ34(z,t)..       SROW(z,t) =e= YROW(z,t)-e(z,t)*SUM[(i,zj)$EXO(i,z,zj),
3377                                 EX(i,z,zj,t)*PWX(i,z,zj,t)]-e(z,t)
3378                                 *SUM[i$MRGNO(i,z),MRGN(i,z,t)*PWMG(i,t)];
3379   
3380   EQ35(z,t)..       SROW(z,t) =e= -CAB(z,t);
3381   
3382  *==============================================================================
3383  *   5.3.3 Demand
3384  *==============================================================================
3385   EQ36(i,z,t)..     PC(i,z,t)*C(i,z,t) =e= PC(i,z,t)*CMIN(i,z,t)+gamma_LES(i,z)
3386                                   *{CTH(z,t)-SUM[ij,PC(ij,z,t)*CMIN(ij,z,t)]};
3387   
3388   EQ37(i,z,t)..     PC(i,z,t)*INV(i,z,t) =e= gamma_INV(i,z)*IT(z,t);
3389   
3390   EQ38(i,z,t)..     PC(i,z,t)*CG(i,z,t) =e= gamma_GVT(i,z)*G(z,t);
3391   
3392   EQ39(nene,z,t)..    DIT(nene,z,t) =e= SUM[j,DI(nene,j,z,t)];
3393   
3394   EQ39_1(ene1,z,t)..  DIT(ene1,z,t) =e= SUM[j,DE(ene1,j,z,t)];
3395   
3396   EQ39_2(ene2,z,t)..  DIT(ene2,z,t) =e= SUM[j,DE(ene2,j,z,t)+EBS(ene2,j,z,t)];
3397   
3398  * EQ72(l,z,t)..     LS(l,z,t) =e= SUM[j$LDO(l,j,z),LD(l,j,z,t)+LBS(l,j,z,t)];
3399   
3400  *==============================================================================
3401  *   5.3.4 International trade
3402  *==============================================================================
       EQB_1(i,z)..    XS_I(i,z) =e= B_X3(i,z)*SUM[j$XSO(j,i,z),beta_X3(j,i,z)
                                      *XS(j,i,z)**(-rho_X3(i,z))]**(-1/rho_X3(i,z));
       
       EQB_2(j,i,z)${DSO(j,i,z) and [DSO(j,i,z) ne DSO_I(i,z)]}..
                       XS(j,i,z) =e= XS_I(i,z)/B_X3(i,z)**(1-sigma_X3(i,z))*
                                     [beta_X3(j,i,z)*PI(i,z)/P2(j,i,z)]
                                     **sigma_X3(i,z);
       
       EQB_3(j,i,z)${DSO(j,i,z)}..   P2(j,i,z) =e= PT(j,z);
       
       EQB_4(j,i,z)$DSO(j,i,z)..
                       P2(j,i,z)*XS(j,i,z) =e= [PET(i,z)*EXTT(j,i,z)]$EXTTO(j,i,z)
                                              +[e(z)*MRGN(i,z)*PWMG(i)]$MRGNO(i,z)
                                              +[PL(i,z)*DS(j,i,z)]$DSO(j,i,z);
       
       EQB_5(j,i,z)$DSO(j,i,z)..  EXTT(j,i,z)  =e= theta2(j,i,z)*EXT(i,z);
3421   
3422  *[Top Nest - Leontief function]
3423   EQA_1(z,t)..  XS('18_TnD','18_ELEC',z,t) =e= TnDShare(z)*XS_I('18_ELEC',z,t);
3424   EQA_2(z,t)..  XS_I('18_ELEC',z,t) =e= XS('18_TnD','18_ELEC',z,t) + POWERQ(z,t);
3425   
3426   
3427  *[Second Nest - CES function]
3428  * EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
3429  *                                *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
3430   EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4_t(power,z,t)
3431                                  *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
3432  *beta_X4_t(power2,z,time)
3433   
3434  * EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
3435  *                               [beta_X4(power,z)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
3436  *                               **sigma_X4(z);
3437   
3438   EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
3439                                 [beta_X4_t(power,z,t)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
3440                                 **sigma_X4(z);
3441   
3442  * exclude electiricity
3443   EQB_1(i2,z,t)..    XS_I(i2,z,t) =e= B_X3(i2,z)*SUM[j$XSO(j,i2,z),beta_X3(j,i2,z)
3444                                  *XS(j,i2,z,t)**(-rho_X3(i2,z))]**(-1/rho_X3(i2,z));
3445   
3446   
3447   EQB_3(j,i,z,t)${DSO(j,i,z)}..   P2(j,i,z,t) =e= PT(j,z,t);
3448   
3449   EQB_4(j,i,z,t)$DSO(j,i,z)..
3450                   P2(j,i,z,t)*XS(j,i,z,t) =e= [PET(i,z,t)*EXTT(j,i,z,t)]$EXTTO(j,i,z)
3451                                          +[e(z,t)*MRGN(i,z,t)*PWMG(i,t)]$MRGNO(i,z)
3452                                          +[PL(i,z,t)*DS(j,i,z,t)]$DSO(j,i,z);
3453   
3454   EQB_5(j,i,z,t)$DSO(j,i,z)..  EXTT(j,i,z,t)  =e= theta2(j,i,z)*EXT(i,z,t);
3455   
3456   EQ40_3(i,z,t)..   DS_I(i,z,t) =e= sum(j,DS(j,i,z,t)$DSO(j,i,z));
3457   
3458   EQ40_4(j,z,t)..   XST(j,z,t)  =e= sum(i,XS(j,i,z,t)$XSO(j,i,z));
3459   
3460   EQ40_5(i,z,t)..   XS_I(i,z,t) =e= B_X1(i,z)*{
3461                   [beta_EX_X1(i,z)*EXT(i,z,t)**rho_X1(i,z)]$EXTO(i,z)
3462                  +[beta_D_X1(i,z)*DS_I(i,z,t)**rho_X1(i,z)]$DSO_I(i,z)
3463                  +[(1-beta_EX_X1(i,z)-beta_D_X1(i,z))*MRGN(i,z,t)**rho_X1(i,z)]$MRGNO(i,z)
3464                                            }**(1/rho_X1(i,z));
3465   
3466   EQ41(i,z,t)$[EXTO(i,z) and DSO_I(i,z)]..
3467                   EXT(i,z,t) =e= {[beta_D_X1(i,z)/beta_EX_X1(i,z)]*[PET(i,z,t)/PL(i,z,t)]}
3468                                **sigma_X1(i,z)*DS_I(i,z,t);
3469   
3470   EQ42(i,z,t)$[MRGNO(i,z) and DSO_I(i,z)]..
3471                   MRGN(i,z,t) =e= {[beta_D_X1(i,z)/(1-beta_EX_X1(i,z)
3472                                   -beta_D_X1(i,z))]*[e(z,t)*PWMG(i,t)/PL(i,z,t)]}
3473                                   **sigma_X1(i,z)*DS_I(i,z,t);
3474   
3475   EQ43(i,z,t)$EXTO(i,z)..
3476                   EXT(i,z,t) =e= B_X2(i,z)*SUM[zj$EXO(i,z,zj),beta_X2(i,z,zj)
3477                                  *EX(i,z,zj,t)**rho_X2(i,z)]**(1/rho_X2(i,z));
3478   
3479   EQ44(i,z,zj,t)$EXO(i,z,zj)..
3480                   EX(i,z,zj,t) =e= EXT(i,z,t)/B_X2(i,z)**(1+sigma_X2(i,z))*
3481                                    [PE(i,z,zj,t)/(beta_X2(i,z,zj)*PET(i,z,t))]
3482                                    **sigma_X2(i,z);
3483   
3484   EQ45(i,z,t)..     Q(i,z,t) =e= B_M1(i,z)*{
3485                      [beta_M1(i,z)*IMT(i,z,t)**(-rho_M1(i,z))]$IMTO(i,z)
3486                     +[(1-beta_M1(i,z))*DD(i,z,t)**(-rho_M1(i,z))]$DDO(i,z)
3487                                          }**(-1/rho_M1(i,z));
3488   
3489   EQ46(i,z,t)$[IMTO(i,z) and DDO(i,z)]..
3490                   IMT(i,z,t) =e= {[beta_M1(i,z)/(1-beta_M1(i,z))]*[PD(i,z,t)
3491                                  /PMT(i,z,t)]}**sigma_m1(i,z)*DD(i,z,t);
3492   
3493   EQ47(i,z,t)$IMTO(i,z)..
3494                   IMT(i,z,t) =e= B_M2(i,z)*SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*
3495                                  IM(i,zj,z,t)**(-rho_M2(i,z))]**(-1/rho_M2(i,z));
3496   
3497   EQ48(i,zj,z,t)$IMO(i,zj,z)..
3498                   IM(i,zj,z,t) =e= IMT(i,z,t)/B_M2(i,z)**(1-sigma_M2(i,z))*
3499                                    [beta_M2(i,zj,z)*PMT(i,z,t)/PM(i,zj,z,t)]
3500                                    **sigma_M2(i,z);
3501   
3502  *==============================================================================
3503  *   5.3.5 Prices
3504  *==============================================================================
3505   EQ49(j2,z,t)..     PP(j2,z,t)*XST(j2,z,t) =e= PKLE(j2,z,t)*KLE(j2,z,t)+PCI(j2,z,t)*CI(j2,z,t);
3506   
3507   EQ49_1(j3,z,t)..   PP(j3,z,t)*XST(j3,z,t) =e= PVA(j3,z,t)*VA(j3,z,t)+PCI(j3,z,t)*CI(j3,z,t)+PCE(j3,z,t)*CE(j3,z,t);
3508   
3509   EQ50(j,z,t)..     PT(j,z,t) =e= (1+ttip(j,z,t))*PP(j,z,t);
3510   
3511   EQ51(j,z,t)..     PCI(j,z,t)*CI(j,z,t) =e= SUM[nene,PC(nene,z,t)*DI(nene,j,z,t)];
3512   
3513   EQ51_1(j,z,t)..   PCE(j,z,t)*CE(j,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j,z,t) + PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t)];
3514   
3515  * EQ51_1(j,z)..   PCE(j,z)*CE(j,z) =e= SUM[ene,P4(ene,j,z)*DE(ene,j,z)];
3516   
3517   EQ52(j,z,t)..     PVA(j,z,t)*VA(j,z,t) =e= [WC(j,z,t)*LDC(j,z,t)]$LDCO(j,z)
3518                                       +[RC(j,z,t)*KDC(j,z,t)]$KDCO(j,z);
3519   
3520   EQ52_1(j2,z,t)..   PKLE(j2,z,t)*KLE(j2,z,t) =e= [PVA(j2,z,t)*VA(j2,z,t)]$VAO(j2,z)
3521                                         +[PCE(j2,z,t)*CE(j2,z,t)]$CEO(j2,z);
3522   
3523  * Given equations 5 and 6, equation 53 is redundant
3524  * EQ53(j,z)..     WC(j,z)*LDC(j,z) =e= SUM[l$LDO(l,j,z),WTI(l,j,z)*LD(l,j,z)];
3525   
3526   EQ54(l,j,z,t)$LDO(l,j,z)..
3527                   WTI(l,j,z,t) =e= W(l,z,t)*(1+ttiw(l,j,z,t));
3528   
3529   EQ54_1(ene,j2,z,t)$DEO(ene,j2,z)..
3530                   P4(ene,j2,z,t) =e= PC(ene,z,t);
3531   
3532  * Given equations 7 and 8, equation 55 is redundant
3533  * EQ55(j,z)$(kmob and KDCO(j,z))..
3534  *                 RC(j,z)*KDC(j,z) =e= SUM[k$KDO(k,j,z),RTI(k,j,z)*KD(k,j,z)];
3535   
3536   EQ56(k,j,z,t)$KDO(k,j,z)..
3537                   RTI(k,j,z,t) =e= R(k,j,z,t)*(1+ttik(k,j,z,t));
3538   
3539  * EQ57(k,j,z,t)$(kmob and KDO(k,j,z))..
3540  *                 R(k,j,z,t) =e= RK(k,z,t);
3541   
3542  * EQ58(j,z)..     P(j,z)*XST(j,z) =e= [PL(j,z)*DS(j,z)]$DSO(j,z)
3543  *                                   +[PET(j,z)*EXT(j,z)]$EXTO(j,z)
3544  *                                   +[e(z)*PWMG(j)*MRGN(j,z)]$MRGNO(j,z);
3545   
3546   EQ58(i,z,t)..     P(i,z,t)*XS_I(i,z,t) =e= [PL(i,z,t)*DS_I(i,z,t)]$DSO_I(i,z)
3547                                       +[PET(i,z,t)*EXT(i,z,t)]$EXTO(i,z)
3548                                       +[e(z,t)*PWMG(i,t)*MRGN(i,z,t)]$MRGNO(i,z);
3549   
3550  * Given equations 43 and 44, equation 59 is redundant
3551  * EQ59(i,z)$EXTO(i,z)..
3552  *                 PET(i,z)*EXT(i,z) =e= SUM[zj$EXO(i,z,zj),
3553  *                                           PE(i,z,zj)*EX(i,z,zj);
3554   
3555   EQ60(i,z,zj,t)$EXO(i,z,zj)..
3556                   PE(i,z,zj,t)*(1+ttix(i,z,zj,t)) =e= e(z,t)*PWX(i,z,zj,t);
3557   
3558   EQ61(i,z,t)$DDO(i,z)..
3559                   PD(i,z,t) =e= (1+ttic(i,z,t))*PL(i,z,t);
3560   
3561   EQ62(i,zj,z,t)$IMO(i,zj,z)..
3562                   PM(i,zj,z,t) =e= (1+ttic(i,z,t))*(1+ttim(i,zj,z,t))*e(z,t)*
3563                                    (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
3564                                    *tmrg(ij,i,zj,z)]);
3565   
3566  * Given equations 47 and 48, equation 63 is redundant
3567  * EQ63(i,z)$IMTO(i,z)..
3568  *                 PMT(i,z)*IMT(i,z) =e= SUM[zj$IMO(i,zj,z),
3569  *                                           PM(i,zj,z)*IM(i,zj,z);
3570   
3571   EQ64(i,z,t)..     PC(i,z,t)*Q(i,z,t) =e= [PD(i,z,t)*DD(i,z,t)]$DDO(i,z)+
3572                                      [PMT(i,z,t)*IMT(i,z,t)]$IMTO(i,z);
3573   
3574  * EQ65(z,t)..       PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
3575  *                               /gamma_INV(i,z))**gamma_INV(i,z)];
3576   
3577   EQ66(z,t)..       PIXGDP(z,t) =e=
3578                   {SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)]
3579                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
3580                   *SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)]
3581                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)]}**0.5;
3582   
3583   EQ67(t)..         PIXGDP_W(t) =e=
3584                   {SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)/e(z,t)]
3585                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
3586                   *SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)/e(z,t)]
3587                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)/eO(z)]}**0.5;
3588   
3589   EQ68(z,t)..       PIXCON(z,t) =e= SUM[i,PC(i,z,t)*CO(i,z)]/SUM[i,PCO(i,z)*CO(i,z)];
3590   
3591   EQ69(z,t)..       PIXINV(z,t) =e= PROD[i$gamma_INV(i,z),(PC(i,z,t)/PCO(i,z))
3592                                   **gamma_INV(i,z)];
3593   
3594   EQ70(z,t)..       PIXGVT(z,t) =e= PROD[i$gamma_GVT(i,z),(PC(i,z,t)/PCO(i,z))
3595                                   **gamma_GVT(i,z)];
3596   
3597  *==============================================================================
3598  *   5.3.6 Equilibrium
3599  *==============================================================================
3600   EQ71(i1,z,t)..    Q(i1,z,t) =e= C(i1,z,t)+CG(i1,z,t)+INV(i1,z,t)+DIT(i1,z,t);
3601   
3602   EQ71_2(i3,z,t)..  Q(i3,z,t) =e= C_Conventional(i3,z,t);
3603   
3604   EQ72(l,z,t)..     LS(l,z,t) =e= SUM[j$LDO(l,j,z),LD(l,j,z,t)+LBS(l,j,z,t)];
3605  * EQ72(l,z,t)..     LS(l,z,t) =e= SUM[j$LDO(l,j,z),LD(l,j,z,t)];
3606   
3607   EQ73(k,z,t)$KSO(k,z)..
3608                     KS(k,z,t) =e= SUM[j$KDO(k,j,z),KD(k,j,z,t)+KBS(k,j,z,t)];
3609  *                   KS(k,z,t) =e= SUM[j$KDO(k,j,z),KD(k,j,z,t)];
3610   
3611   EQ74(z,t)..       IT(z,t)   =e= SH(z,t)+SG(z,t)-CAB(z,t);
3612   
3613   EQ75(z,t)..       DEP(z,t)  =e= PK(z,t)*delta(z)*SUM[k$KSO(k,z),KS(k,z,t)];
3614   
3615   EQ76(i,z,t)$DDO(i,z)..
3616                   SUM[j$DSO(j,i,z),DS(j,i,z,t)] =e= DD(i,z,t);
3617   
3618   EQ77(i,z,zj,t)$EXO(i,z,zj)..
3619                   EX(i,z,zj,t) =e= IM(i,z,zj,t);
3620   
3621   EQ78(i,z,zj,t)$EXO(i,z,zj)..
3622                   PWX(i,z,zj,t) =e= PWM(i,z,zj,t);
3623   
3624   EQ79(i,t)..       SUM[z$MRGNO(i,z),MRGN(i,z,t)] =e= SUM[(z,zj,ij)$IMO(ij,zj,z),
3625                                                   tmrg(i,ij,zj,z)*IM(ij,zj,z,t)];
3626   
3627  * Given equations 33, 34 and 77, equation 80 is redundant
3628  * EQ80..          SUM[z,SROW(z)/e(z)] =e= 0;
3629   
3630  *==============================================================================
3631  *   5.3.7 Gross domestic product
3632  *==============================================================================
3633   EQ81(z,t)..       GDP_BP(z,t) =e= SUM[j,PVA(j,z,t)*VA(j,z,t)]+TIPT(z,t);
3634   
3635   EQ82(z,t)..       GDP_MP(z,t) =e= GDP_BP(z,t)+TPRCTS(z,t);
3636   
3637   EQ83(z,t)..       GDP_IB(z,t) =e= SUM[(l,j)$LDO(l,j,z),W(l,z,t)*LD(l,j,z,t)]
3638                                +SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*KD(k,j,z,t)]
3639                                +TPRCTS(z,t)+TPRODN(z,t);
3640   
3641   EQ84(z,t)..       GDP_FD(z,t) =e=
3642                   SUM[i,PC(i,z,t)*(C(i,z,t)+CG(i,z,t)+INV(i,z,t))]
3643                  +SUM[(i,zj)$EXO(i,z,zj),e(z,t)*PWX(i,z,zj,t)*EX(i,z,zj,t)]
3644                  +SUM[i$MRGNO(i,z),e(z,t)*PWMG(i,t)*MRGN(i,z,t)]
3645                  -SUM[(i,zj)$IMO(i,zj,z),e(z,t)*IM(i,zj,z,t)
3646                      *(PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)*tmrg(ij,i,zj,z)])]-TCTAX(z,t);
3647   
3648   EQ85(t)..          GDP_BP_W(t) =e= SUM[z,GDP_BP(z,t)/e(z,t)];
3649   
3650  *==============================================================================
3651  *  5.3.8 Real (volume) variables computed from price indices
3652  *==============================================================================
3653   EQ86(z,t)..       CTH_REAL(z,t) =e= CTH(z,t)/PIXCON(z,t);
3654   
3655   EQ87(z,t)..       G_REAL(z,t) =e= G(z,t)/PIXGVT(z,t);
3656   
3657   EQ88(z,t)..       GDP_BP_REAL(z,t) =e= GDP_BP(z,t)/PIXGDP(z,t);
3658   
3659   EQ89(t)..         GDP_BP_W_REAL(t) =e= GDP_BP_W(t)/PIXGDP_W(t);
3660   
3661   EQ90(z,t)..       GDP_MP_REAL(z,t) =e= GDP_MP(z,t)/PIXCON(z,t);
3662   
3663   EQ91(z,t)..       IT_REAL(z,t) =e= IT(z,t)/PIXINV(z,t);
3664   
3665   EQ92(z,t)..       CABX(z,t) =e= CAB(z,t)/[PIXGDP_W(t)*e(z,t)];
3666   
3667   EQ93..            OBJ =e= 1;
3668   
3669  *==============================================================================
3670  *   5.3.8 Dynamic equations
3671  *==============================================================================
3672   EQ94(z,t)..     IT(z,t) =e= PK(z,t)*SUM[(k,j)$KDO(k,j,z),IND(k,j,z,t)];
3673   
3674   EQ95(z,t)..     PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
3675                                 /gamma_INV(i,z))**gamma_INV(i,z)];
3676   EQ96(k,bus,z,t)$KDO(k,bus,z)..
3677                   IND(k,bus,z,t) =e= phi(z,t)*[R(k,bus,z,t)/U(z,t)]
3678                                    **sigma_INV(k,bus,z)*KD(k,bus,z,t);
3679   
3680  * EQ97a(z,t)..    IR(z,t) =e= {SUM[(k,j)$KDO(k,j,z),
3681  *                              R(k,j,z,t)*KD(k,j,z,t)]-DEP(z,t)}/
3682  *                             {PK(z,t)*SUM[(k,j)$KDO(k,j,z),KD(k,j,z,t)]};
3683   
3684   EQ97b(z,t)..    U(z,t) =e= PK(z,t)*(delta(z)+IR(z,t));
3685   
3686  *==============================================================================
3687  *   5.3.9 Other
3688  *==============================================================================
3689   WALRAS(z,t)..   LEON(z,t) =e= Q('01_AGRICULT',z,t)-C('01_AGRICULT',z,t)-CG('01_AGRICULT',z,t)-INV('01_AGRICULT',z,t)
3690                              -DIT('01_AGRICULT',z,t);
3691   
3692  *==============================================================================
3693  *   5.3.10 Backstop technology
3694  *==============================================================================
3695   EQ98(i3,z,t)..    C_Conventional(i3,z,t) =e= (1-penetration_rate(i3,z,t)*switch(i3,z,t))*[C(i3,z,t)+CG(i3,z,t)+INV(i3,z,t)+DIT(i3,z,t)];
3696   
3697   EQ99(i3,z,t)..    XDBS(i3,z,t) =e= penetration_rate(i3,z,t)*switch(i3,z,t)*[C(i3,z,t)+CG(i3,z,t)+INV(i3,z,t)+DIT(i3,z,t)];
3698   
3699   EQ100(j,z,t)..    XDBS2(j,z,t) =e= sum{i3$COMtoIND(j,i3),XDBS(i3,z,t)};
3700   
3701   EQ101(l,j,z,t)..  LBS(l,j,z,t) =e= 0.2*XDBS2(j,z,t)*LDO(l,j,z)/sum(lj,LDO(lj,j,z));
3702   
3703   EQ102(k,j,z,t)..  KBS(k,j,z,t) =e= 0.5*XDBS2(j,z,t)*KDO(k,j,z)/sum(kj,KDO(kj,j,z));
3704   
3705   EQ103(i3,z,t)..   CLBS(i3,z,t)  =e= sum(l,sum{j$INDtoCOM(i3,j),LBS(l,j,z,t)*WC(j,z,t)});
3706   
3707   EQ104(i3,z,t)..   CKBS(i3,z,t)  =e= sum(k,sum{j$INDtoCOM(i3,j),KBS(k,j,z,t)*RC(j,z,t)});
3708   
3709   EQ105(i3,z,t)..   MARKUP(i3,z,t) =e= {PC(i3,z,t)*XDBS(i3,z,t)-CLBS(i3,z,t)-CKBS(i3,z,t)}*switch(i3,z,t) ;
3710   
3711   EQ106(ene2,j,z,t)..  EBS(ene2,j,z,t) =e= 0.06*XDBS2(j,z,t);
3712   
3713  *==============================================================================
3714  * 6 Numerical resolution to compute A_VA, sh0, G, G_REAL and IND
3715  *==============================================================================
3716  *option cns = Snopt;
3717  *option cns = Ipopt;
3718  *option NLP = Ipopt;
3719  *option cns = path;
3720  option cns = conopt4;
3721  *option cns = convert;
3722  *option cns = IPOPTH;
3723  *option cns = minos;
3724  *option NLP = conopt4;
3725  *option NLP = minos;
3726  *option NLP = pathnlp ;
3727   
3728  *Option conopt4.TolPiv = 1e-6;
3729   
3730  option iterlim = 100;
3731  *option iterlim = 0;
3732  *option lmmxsf = t ;
3733   
3734  * Eliminating display of solution makes it easier to check whether model solves
3735  * and to identify year when it crashes.
3736  *option profile=1;
3737  *option profile=3;
3738  option profiletol=10;
3739   
3740  option limrow=0, limcol=0, solprint = off;
3741  *$Offlisting
3742  *$Offsymlist
3743  *$Offinclude
3744  *option limrow=0, limcol=0, iterlim= 100 ;
3745  *option reslim = 1000;
3746   
3747  MODEL PEPWT World wide dynamic model /all/ ;
3748  PEPWT.holdfixed=1;
3749  *$EXIT
3750   
3751  *PEPWT.Optfile =1;
3752   
3753  *==============================================================================
3754  *  6.1 Scenarios
3755  *==============================================================================
3756  * Define the set of scenarios
3757  * For each scenario, there are two files to $INCLUDE:
3758  * SOLVE, and RESULTS.
3759   
3760  SET
3761  SCEN  List of scenarios
3762  /
3763   BAU             Business as usual values
3764   CPS             Current Policy Scenario
3765   NZS             Net Zero Scenario
3766  /
3767  ;
3768   
3769  *==============================================================================
3770  *  6.2 BAU scenario and Results
3771  *==============================================================================
INCLUDE    C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.RD_CGE\BAU_SOLVE_GTAP11b.gms
3773  *==============================================================================
3774  *  6.2.1.1 Choice of multifactor productivity
3775  *==============================================================================
3776  *  6.2.1.1.1 Input for multifactor productivity
3777  *==============================================================================
3778  * Multifactor productivity is retrieved from a model BAU solution with
3779  * endogenous A_VA(z,time) in equation 3, and exogenous real GDPs, fixed at
3780  * values that are projected using Four?, Benassy-Qu?r? and Fontagn? projected
3781  * growth rates. So the solution is forced to follow the GDP projected growth
3782  * paths. The solution values of A_VA are stored as parameter A_VA_RES.
3783  *-------------------------------------------------------------------------------
3784   
3785  PARAMETER
3786   A_VA_RES(z,time)     Value of A_VA to reproduce real GDP projections
3787   GX(z,time)           Current government expenditures on goods and services in region z
3788   G_REALX(z,time)      Current real government expenditures on goods and services in region z
3789   INDX(k,j,z,time)     Volume of new type k capital investment to industry j in region z
3790   sh0X(z,time)     Intercept (household savings)
3791   sh1X(z,time)     Household savings rate
3792   phi_BAU(z,time)
3793  ;
3794   
GDXIN   C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.RD_CGE\Input_w-t\B_line_GTAP11b.gdx
3796  *$LOAD A_VA_RES, sh0X, sh1X, GX, G_REALX, INDX
--- LOAD  A_VA_RES = 1:A_VA_RES
--- LOAD  GX = 2:GX
--- LOAD  G_REALX = 3:G_REALX
--- LOAD  INDX = 4:INDX
--- LOAD  sh1X = 26:sh1X
--- LOAD  sh0X = 27:sh0X
--- LOAD  phi_BAU = 28:phi_BAU
3798   
3799  display  A_VA_RES;
3800  *$EXIT
3801   
3802  *==============================================================================
3803  *  6.2.1.1.2 Choice of multifactor productivity
3804  *==============================================================================
3805  * If you want to reproduce the real GDP projections, set:
3806   A_VA.FX(z,time)  = A_VA_RES(z,time);
3807  * Otherwise, simply put A_VA equal to one:
3808  * A_VA.FX(z,time)    = 1;
3809   
3810  *==============================================================================
3811  *   6.2.1.2 Choice of reference region
3812  *==============================================================================
3813  * By default, the reference region is USA,
3814   zr(z)           = no;
3815   zr('07_NAM')    = yes;
3816  *zr('ChinaHK')   = yes;
3817   z1(z)           = NOT[zr(z)];
3818   
3819  *==============================================================================
3820  *   6.2.1.3 Choice between closures FE and FP
3821  *==============================================================================
3822  *$ontext
3823  * FP CLOSURE: fixed PIXGDPs; numeraire is exchange rate of reference region
3824  * The exchange rates are endogenous, except for the reference region.
3825   e.FX(zr,time)      = eO(zr);
3826   PIXGDP.FX(z,time)  = PIXGDPO(z)/sum(zr,eO(zr));
3827  *$offtext
3828   
      * FE CLOSURE: fixed exchange rates; numeraire is PIXGDP of reference region
      * The exchange rates can be fixed at arbitrary values
       PIXGDP.FX(zr,time)  = PIXGDPO(zr);
       e.FX(z,time)        = eO(z);
3835   
3836  *==============================================================================
3837  *   6.2.1.4 Other exogenous variables
3838  *==============================================================================
3839   G_REAL.FX(z,time)    = G_REALX(z,time);
3840   IND.fx(k,pub,z,time) = INDX(k,pub,z,time);
3841   phi.fx(z,time)       = phi_BAU(z,time);
3842   
3843   sh0.fx(z,time)       = sh0X(z,time);
3844   sh1.fx(z,time)       = sh1X(z,time);
3845  * ttdh0.fx(z,time)    = ttdh0O(z)*exogro(z,time);
3846   ttdh0.fx(z,time)     = ttdh0O(z);
3847   ttdh1.fx(z,time)     = ttdh1O(z);
3848   ttic.fx(i,z,time)    = tticO(i,z);
3849   ttik.fx(k,j,z,time)  = ttikO(k,j,z);
3850   ttim.fx(i,zj,z,time) = ttimO(i,zj,z);
3851   ttip.fx(j,z,time)    = ttipO(j,z);
3852   ttiw.fx(l,j,z,time)  = ttiwO(l,j,z);
3853   ttix.fx(i,z,zj,time) = ttixO(i,z,zj);
3854   CTAX.fX(z,time)      = CTAX0(z);
3855   beta_X4_t.fx(power,z,time) = beta_X4(power,z);
3856   A_VA2.FX(j,z,time)   = 1 ;
3857  *==============================================================================
3858  *   6.2.2 Solution
3859  *==============================================================================
3860  * Resolution for the BAU
3861  * Begin LOOP over time periods
3862  *==============================================================================
3863   
3864  * EndTime is the final year for model resolution.
