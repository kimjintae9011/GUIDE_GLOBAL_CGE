3147  *==============================================================================
3148  *  5.3 Equations
3149  *==============================================================================
3150  *   5.3.1 Production
3151  *==============================================================================
3152   EQ1(j3,z,t)..     VA(j3,z,t) =e= v(j3,z)*XST(j3,z,t);
3153   
3154   EQ1_1(j2,z,t)..   KLE(j2,z,t) =e= v2(j2,z)*XST(j2,z,t);
3155   
3156   EQ2(j,z,t)..      CI(j,z,t) =e= io(j,z)*XST(j,z,t);
3157   
3158  * EQ2_1(j3,z,t)..   CE(j3,z,t) =e= io2(j3,z)*XST(j3,z,t);
3159   EQ2_1(j3,z,t)..   CE(j3,z,t) =e= io2_t(j3,z,t)*XST(j3,z,t);
3160   
3161   
3162   EQ3(j,z,t)..      VA(j,z,t) =e= A_VA(z,t)*B_VA(j,z)*{
3163                      [beta_VA(j,z)*LDC(j,z,t)**(-rho_VA(j,z))]$LDCO(j,z)
3164                     +[(1-beta_VA(j,z))*KDC(j,z,t)**(-rho_VA(j,z))]$KDCO(j,z)
3165                                                     }**(-1/rho_VA(j,z));
3166   
3167   EQ3_1(j2,z,t)..   KLE(j2,z,t) =e= B_KLE(j2,z)*{
3168  *                    [beta_KLE(j2,z)*VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
3169  *                   +[(beta_KLE2(j2,z))*CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
3170  *                                                   }**(-1/rho_KLE(j2,z));
3171                      [(1-beta_KLE2_t(j2,z,t))*VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
3172                     +[(beta_KLE2_t(j2,z,t))*CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
3173                                                     }**(-1/rho_KLE(j2,z));
3174   
3175   EQ4(j,z,t)$[LDCO(j,z) and KDCO(j,z)]..
3176                   LDC(j,z,t) =e= {[beta_VA(j,z)/(1-beta_VA(j,z))]
3177                                *[RC(j,z,t)/WC(j,z,t)]}**sigma_VA(j,z)*KDC(j,z,t);
3178   
3179   EQ4_1(j2,z,t)$[VAO(j2,z) and CEO(j2,z)]..
3180  *                 VA(j2,z,t) =e= {[beta_KLE(j2,z)/(beta_KLE2(j2,z))]
3181  *                              *[PCE(j2,z,t)/PVA(j2,z,t)]}**sigma_KLE(j2,z)*CE(j2,z,t);
3182                   VA(j2,z,t) =e= {[(1-beta_KLE2_t(j2,z,t))/(beta_KLE2_t(j2,z,t))]
3183                                *[PCE(j2,z,t)/PVA(j2,z,t)]}**sigma_KLE(j2,z)*CE(j2,z,t);
3184   
3185   EQ5(j,z,t)$LDCO(j,z)..
3186                   LDC(j,z,t) =e= B_LD(j,z)*SUM[l$LDO(l,j,z),beta_LD(l,j,z)
3187                                  *LD(l,j,z,t)**(-rho_LD(j,z))]**(-1/rho_LD(j,z));
3188   
3189   EQ6(l,j,z,t)$LDO(l,j,z)..
3190                   LD(l,j,z,t) =e= [beta_LD(l,j,z)*WC(j,z,t)/WTI(l,j,z,t)]
3191                                 **sigma_LD(j,z)*B_LD(j,z)**(sigma_LD(j,z)-1)
3192                                 *LDC(j,z,t);
3193   
3194   EQ7(j,z,t)$KDCO(j,z)..
3195                   KDC(j,z,t) =e= B_KD(j,z)*SUM[k$KDO(k,j,z),beta_KD(k,j,z)
3196                                  *KD(k,j,z,t)**(-rho_KD(j,z))]**(-1/rho_KD(j,z));
3197   
3198   EQ8(k,j,z,t)$KDO(k,j,z)..
3199                   KD(k,j,z,t) =e= [beta_KD(k,j,z)*RC(j,z,t)/RTI(k,j,z,t)]
3200                                   **sigma_KD(j,z)*B_KD(j,z)**(sigma_KD(j,z)-1)
3201                                   *KDC(j,z,t);
3202   
3203   EQ9(nene,j,z,t)..    DI(nene,j,z,t) =e= aij(nene,j,z)*CI(j,z,t) ;
3204   
3205   EQ9_1(ene,j3,z,t)..  DE(ene,j3,z,t) =e= aij2_t(ene,j3,z,t)*CE(j3,z,t) ;
3206   
3207  * EQ9_3(j2,z,t)..      CE(j2,z,t) =e= B_ENER_t(j2,z,t)*SUM[ene,beta_ENER(ene,j2,z)
3208  *                                *DE(ene,j2,z,t)**(-rho_ENER(j2,z))]**(-1/rho_ENER(j2,z));
3209   
3210  * EQ9_2(ene,j2,z,t)..  DE(ene,j2,z,t) =e= [beta_ENER(ene,j2,z)*PCE(j2,z,t)/((P4(ene,j2,z,t)+PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j2,z,t)))]
3211   EQ9_2(ene,j2,z,t)..  DE(ene,j2,z,t) =e= [beta_ENER(ene,j2,z)*PCE(j2,z,t)/((P4(ene,j2,z,t)+P4(ene,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j2,z,t)))]
3212                                     **sigma_ENER(j2,z)*B_ENER_t(j2,z,t)**(sigma_ENER(j2,z)-1)
3213                                     *CE(j2,z,t);
3214   
3215  *==============================================================================
3216  *   5.3.2 Income and savings
3217  *==============================================================================
3218  *    5.3.2.1 Households
3219  *==============================================================================
3220   EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t)+TCTAX(z,t)+SUM(i3,MARKUP(i3,z,t));
3221  * EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t)+TCTAX(z,t);
3222  * EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t) ;
3223   
3224   EQ11(z,t)..       YHL(z,t) =e= SUM[(l,j)$LDO(l,j,z),W(l,z,t)*LD(l,j,z,t)];
3225   
3226   EQ12(z,t)..       YHK(z,t) =e= SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*KD(k,j,z,t)];
3227   
3228   EQ13(z,t)..       YDH(z,t) =e= YH(z,t)-TDH(z,t);
3229   
3230   EQ14(z,t)..       CTH(z,t) =e= YDH(z,t)-SH(z,t);
3231   
3232  * EQ15(z,t)..       SH(z,t) =e= PIXCON(z,t)**eta*sh0(z,t)+sh1(z,t)*YDH(z,t);
3233   EQ15(z,t)..       SH(z,t) =e= sh1(z,t)*YDH(z,t);
3234   
3235  *==============================================================================
3236  *    5.3.2.2 Government
3237  *==============================================================================
3238   EQ16(z,t)..       YG(z,t) =e= TDH(z,t)+TPRODN(z,t)+TPRCTS(z,t)+TCTAX(z,t);
3239  *TCTAX(z,t)
3240   EQ16_1(z,t)..     TCTAX(z,t) =e= sum((ene,j), PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t));
3241   
3242   EQ17(z,t)..       TPRODN(z,t) =e= TIWT(z,t)+TIKT(z,t)+TIPT(z,t);
3243   
3244   EQ18(z,t)..       TIWT(z,t) =e= SUM[(l,j)$LDO(l,j,z),TIW(l,j,z,t)];
3245   
3246   EQ19(z,t)..       TIKT(z,t) =e= SUM[(k,j)$KDO(k,j,z),TIK(k,j,z,t)];
3247   
3248   EQ20(z,t)..       TIPT(z,t) =e= SUM[j,TIP(j,z,t)];
3249   
3250   EQ21(z,t)..       TPRCTS(z,t) =e= TICT(z,t)+TIMT(z,t)+TIXT(z,t);
3251   
3252   EQ22(z,t)..       TICT(z,t) =e= SUM[i,TIC(i,z,t)];
3253   
3254   EQ23(z,t)..       TIMT(z,t) =e= SUM[(i,zj)$IMO(i,zj,z),TIM(i,zj,z,t)];
3255   
3256   EQ24(z,t)..       TIXT(z,t) =e= SUM[(i,zj)$EXO(i,z,zj),TIX(i,z,zj,t)];
3257   
3258   EQ25(z,t)..       TDH(z,t) =e= PIXCON(z,t)**eta*ttdh0(z,t)+ttdh1(z,t)*YH(z,t);
3259   
3260   EQ26(l,j,z,t)$LDO(l,j,z)..
3261                     TIW(l,j,z,t) =e= ttiw(l,j,z,t)*W(l,z,t)*LD(l,j,z,t);
3262   
3263   EQ27(k,j,z,t)$KDO(k,j,z)..
3264                     TIK(k,j,z,t) =e= ttik(k,j,z,t)*R(k,j,z,t)*KD(k,j,z,t);
3265   
3266   EQ28(j,z,t)..     TIP(j,z,t) =e= ttip(j,z,t)*PP(j,z,t)*XST(j,z,t);
3267   
3268   EQ29(i,z,t)..     TIC(i,z,t) =e= ttic(i,z,t)*{[PL(i,z,t)*DD(i,z,t)]$DDO(i,z)
3269                   +[SUM[zj$IMO(i,zj,z),(1+ttim(i,zj,z,t))*IM(i,zj,z,t)*e(z,t)
3270                    *(PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z)))]]};
3271   
3272   EQ30(i,zj,z,t)$IMO(i,zj,z)..
3273                   TIM(i,zj,z,t) =e= ttim(i,zj,z,t)*IM(i,zj,z,t)*e(z,t)*
3274                                     (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
3275                                     *tmrg(ij,i,zj,z)]);
3276   
3277   EQ31(i,z,zj,t)$EXO(i,z,zj)..
3278                   TIX(i,z,zj,t) =e= ttix(i,z,zj,t)*PE(i,z,zj,t)*EX(i,z,zj,t);
3279   
3280   EQ32(z,t)..       SG(z,t) =e= YG(z,t)-G(z,t)-TCTAX(z,t);
3281  * EQ32(z,t)..       SG(z,t) =e= YG(z,t)- sum(i,PC(i,z,t)*CG(i,z,t));
3282   
3283  *==============================================================================
3284  *    5.3.2.4 Rest of the world
3285  *==============================================================================
3286   EQ33(z,t)..       YROW(z,t) =e= e(z,t)*SUM{(i,zj)$IMO(i,zj,z),IM(i,zj,z,t)*
3287                             [PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z))]};
3288   
3289   EQ34(z,t)..       SROW(z,t) =e= YROW(z,t)-e(z,t)*SUM[(i,zj)$EXO(i,z,zj),
3290                                 EX(i,z,zj,t)*PWX(i,z,zj,t)]-e(z,t)
3291                                 *SUM[i$MRGNO(i,z),MRGN(i,z,t)*PWMG(i,t)];
3292   
3293   EQ35(z,t)..       SROW(z,t) =e= -CAB(z,t);
3294   
3295  *==============================================================================
3296  *   5.3.3 Demand
3297  *==============================================================================
3298   EQ36(i,z,t)..     PC(i,z,t)*C(i,z,t) =e= PC(i,z,t)*CMIN(i,z,t)+gamma_LES(i,z)
3299                                   *{CTH(z,t)-SUM[ij,PC(ij,z,t)*CMIN(ij,z,t)]};
3300   
3301   EQ37(i,z,t)..     PC(i,z,t)*INV(i,z,t) =e= gamma_INV(i,z)*IT(z,t);
3302   
3303   EQ38(i,z,t)..     PC(i,z,t)*CG(i,z,t) =e= gamma_GVT(i,z)*G(z,t);
3304   
3305   EQ39(nene,z,t)..   DIT(nene,z,t) =e= SUM[j,DI(nene,j,z,t)];
3306   
3307   EQ39_1(ene,z,t)..  DIT(ene,z,t) =e= SUM[j,DE(ene,j,z,t)];
3308   
3309  *==============================================================================
3310  *   5.3.4 International trade
3311  *==============================================================================
       EQB_1(i,z)..    XS_I(i,z) =e= B_X3(i,z)*SUM[j$XSO(j,i,z),beta_X3(j,i,z)
                                      *XS(j,i,z)**(-rho_X3(i,z))]**(-1/rho_X3(i,z));
       
       EQB_2(j,i,z)${DSO(j,i,z) and [DSO(j,i,z) ne DSO_I(i,z)]}..
                       XS(j,i,z) =e= XS_I(i,z)/B_X3(i,z)**(1-sigma_X3(i,z))*
                                     [beta_X3(j,i,z)*PI(i,z)/P2(j,i,z)]
                                     **sigma_X3(i,z);
       
       EQB_3(j,i,z)${DSO(j,i,z)}..   P2(j,i,z) =e= PT(j,z);
       
       EQB_4(j,i,z)$DSO(j,i,z)..
                       P2(j,i,z)*XS(j,i,z) =e= [PET(i,z)*EXTT(j,i,z)]$EXTTO(j,i,z)
                                              +[e(z)*MRGN(i,z)*PWMG(i)]$MRGNO(i,z)
                                              +[PL(i,z)*DS(j,i,z)]$DSO(j,i,z);
       
       EQB_5(j,i,z)$DSO(j,i,z)..  EXTT(j,i,z)  =e= theta2(j,i,z)*EXT(i,z);
3330   
3331  *[Top Nest - Leontief function]
3332   EQA_1(z,t)..  XS('18_TnD','18_ELEC',z,t) =e= TnDShare(z)*XS_I('18_ELEC',z,t);
3333   EQA_2(z,t)..  XS_I('18_ELEC',z,t) =e= XS('18_TnD','18_ELEC',z,t) + POWERQ(z,t);
3334   
3335   
3336  *[Second Nest - CES function]
3337  * EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
3338  *                                *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
3339   EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4_t(power,z,t)
3340                                  *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
3341  *beta_X4_t(power2,z,time)
3342   
3343  * EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
3344  *                               [beta_X4(power,z)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
3345  *                               **sigma_X4(z);
3346   
3347   EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
3348                                 [beta_X4_t(power,z,t)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
3349                                 **sigma_X4(z);
3350   
3351  * exclude electiricity
3352   EQB_1(i2,z,t)..    XS_I(i2,z,t) =e= B_X3(i2,z)*SUM[j$XSO(j,i2,z),beta_X3(j,i2,z)
3353                                  *XS(j,i2,z,t)**(-rho_X3(i2,z))]**(-1/rho_X3(i2,z));
3354   
3355   
3356   EQB_3(j,i,z,t)${DSO(j,i,z)}..   P2(j,i,z,t) =e= PT(j,z,t);
3357   
3358   EQB_4(j,i,z,t)$DSO(j,i,z)..
3359                   P2(j,i,z,t)*XS(j,i,z,t) =e= [PET(i,z,t)*EXTT(j,i,z,t)]$EXTTO(j,i,z)
3360                                          +[e(z,t)*MRGN(i,z,t)*PWMG(i,t)]$MRGNO(i,z)
3361                                          +[PL(i,z,t)*DS(j,i,z,t)]$DSO(j,i,z);
3362   
3363   EQB_5(j,i,z,t)$DSO(j,i,z)..  EXTT(j,i,z,t)  =e= theta2(j,i,z)*EXT(i,z,t);
3364   
3365   EQ40_3(i,z,t)..   DS_I(i,z,t) =e= sum(j,DS(j,i,z,t)$DSO(j,i,z));
3366   
3367   EQ40_4(j,z,t)..   XST(j,z,t)  =e= sum(i,XS(j,i,z,t)$XSO(j,i,z));
3368   
3369   EQ40_5(i,z,t)..   XS_I(i,z,t) =e= B_X1(i,z)*{
3370                   [beta_EX_X1(i,z)*EXT(i,z,t)**rho_X1(i,z)]$EXTO(i,z)
3371                  +[beta_D_X1(i,z)*DS_I(i,z,t)**rho_X1(i,z)]$DSO_I(i,z)
3372                  +[(1-beta_EX_X1(i,z)-beta_D_X1(i,z))*MRGN(i,z,t)**rho_X1(i,z)]$MRGNO(i,z)
3373                                            }**(1/rho_X1(i,z));
3374   
3375   EQ41(i,z,t)$[EXTO(i,z) and DSO_I(i,z)]..
3376                   EXT(i,z,t) =e= {[beta_D_X1(i,z)/beta_EX_X1(i,z)]*[PET(i,z,t)/PL(i,z,t)]}
3377                                **sigma_X1(i,z)*DS_I(i,z,t);
3378   
3379   EQ42(i,z,t)$[MRGNO(i,z) and DSO_I(i,z)]..
3380                   MRGN(i,z,t) =e= {[beta_D_X1(i,z)/(1-beta_EX_X1(i,z)
3381                                   -beta_D_X1(i,z))]*[e(z,t)*PWMG(i,t)/PL(i,z,t)]}
3382                                   **sigma_X1(i,z)*DS_I(i,z,t);
3383   
3384   EQ43(i,z,t)$EXTO(i,z)..
3385                   EXT(i,z,t) =e= B_X2(i,z)*SUM[zj$EXO(i,z,zj),beta_X2(i,z,zj)
3386                                  *EX(i,z,zj,t)**rho_X2(i,z)]**(1/rho_X2(i,z));
3387   
3388   EQ44(i,z,zj,t)$EXO(i,z,zj)..
3389                   EX(i,z,zj,t) =e= EXT(i,z,t)/B_X2(i,z)**(1+sigma_X2(i,z))*
3390                                    [PE(i,z,zj,t)/(beta_X2(i,z,zj)*PET(i,z,t))]
3391                                    **sigma_X2(i,z);
3392   
3393   EQ45(i,z,t)..     Q(i,z,t) =e= B_M1(i,z)*{
3394                      [beta_M1(i,z)*IMT(i,z,t)**(-rho_M1(i,z))]$IMTO(i,z)
3395                     +[(1-beta_M1(i,z))*DD(i,z,t)**(-rho_M1(i,z))]$DDO(i,z)
3396                                          }**(-1/rho_M1(i,z));
3397   
3398   EQ46(i,z,t)$[IMTO(i,z) and DDO(i,z)]..
3399                   IMT(i,z,t) =e= {[beta_M1(i,z)/(1-beta_M1(i,z))]*[PD(i,z,t)
3400                                  /PMT(i,z,t)]}**sigma_m1(i,z)*DD(i,z,t);
3401   
3402   EQ47(i,z,t)$IMTO(i,z)..
3403                   IMT(i,z,t) =e= B_M2(i,z)*SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*
3404                                  IM(i,zj,z,t)**(-rho_M2(i,z))]**(-1/rho_M2(i,z));
3405   
3406   EQ48(i,zj,z,t)$IMO(i,zj,z)..
3407                   IM(i,zj,z,t) =e= IMT(i,z,t)/B_M2(i,z)**(1-sigma_M2(i,z))*
3408                                    [beta_M2(i,zj,z)*PMT(i,z,t)/PM(i,zj,z,t)]
3409                                    **sigma_M2(i,z);
3410   
3411  *==============================================================================
3412  *   5.3.5 Prices
3413  *==============================================================================
3414   EQ49(j2,z,t)..     PP(j2,z,t)*XST(j2,z,t) =e= PKLE(j2,z,t)*KLE(j2,z,t)+PCI(j2,z,t)*CI(j2,z,t);
3415   
3416   EQ49_1(j3,z,t)..   PP(j3,z,t)*XST(j3,z,t) =e= PVA(j3,z,t)*VA(j3,z,t)+PCI(j3,z,t)*CI(j3,z,t)+PCE(j3,z,t)*CE(j3,z,t);
3417   
3418   EQ50(j,z,t)..     PT(j,z,t) =e= (1+ttip(j,z,t))*PP(j,z,t);
3419   
3420   EQ51(j,z,t)..     PCI(j,z,t)*CI(j,z,t) =e= SUM[nene,PC(nene,z,t)*DI(nene,j,z,t)];
3421   
3422   EQ51_1(j,z,t)..   PCE(j,z,t)*CE(j,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j,z,t) + PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t)];
3423   
3424  * EQ51_1(j,z)..   PCE(j,z)*CE(j,z) =e= SUM[ene,P4(ene,j,z)*DE(ene,j,z)];
3425   
3426   EQ52(j,z,t)..     PVA(j,z,t)*VA(j,z,t) =e= [WC(j,z,t)*LDC(j,z,t)]$LDCO(j,z)
3427                                       +[RC(j,z,t)*KDC(j,z,t)]$KDCO(j,z);
3428   
3429   EQ52_1(j2,z,t)..   PKLE(j2,z,t)*KLE(j2,z,t) =e= [PVA(j2,z,t)*VA(j2,z,t)]$VAO(j2,z)
3430                                         +[PCE(j2,z,t)*CE(j2,z,t)]$CEO(j2,z);
3431   
3432  * Given equations 5 and 6, equation 53 is redundant
3433  * EQ53(j,z)..     WC(j,z)*LDC(j,z) =e= SUM[l$LDO(l,j,z),WTI(l,j,z)*LD(l,j,z)];
3434   
3435   EQ54(l,j,z,t)$LDO(l,j,z)..
3436                   WTI(l,j,z,t) =e= W(l,z,t)*(1+ttiw(l,j,z,t));
3437   
3438   EQ54_1(ene,j2,z,t)$DEO(ene,j2,z)..
3439                   P4(ene,j2,z,t) =e= PC(ene,z,t);
3440   
3441  * Given equations 7 and 8, equation 55 is redundant
3442  * EQ55(j,z)$(kmob and KDCO(j,z))..
3443  *                 RC(j,z)*KDC(j,z) =e= SUM[k$KDO(k,j,z),RTI(k,j,z)*KD(k,j,z)];
3444   
3445   EQ56(k,j,z,t)$KDO(k,j,z)..
3446                   RTI(k,j,z,t) =e= R(k,j,z,t)*(1+ttik(k,j,z,t));
3447   
3448  * EQ57(k,j,z,t)$(kmob and KDO(k,j,z))..
3449  *                 R(k,j,z,t) =e= RK(k,z,t);
3450   
3451  * EQ58(j,z)..     P(j,z)*XST(j,z) =e= [PL(j,z)*DS(j,z)]$DSO(j,z)
3452  *                                   +[PET(j,z)*EXT(j,z)]$EXTO(j,z)
3453  *                                   +[e(z)*PWMG(j)*MRGN(j,z)]$MRGNO(j,z);
3454   
3455   EQ58(i,z,t)..     P(i,z,t)*XS_I(i,z,t) =e= [PL(i,z,t)*DS_I(i,z,t)]$DSO_I(i,z)
3456                                       +[PET(i,z,t)*EXT(i,z,t)]$EXTO(i,z)
3457                                       +[e(z,t)*PWMG(i,t)*MRGN(i,z,t)]$MRGNO(i,z);
3458   
3459  * Given equations 43 and 44, equation 59 is redundant
3460  * EQ59(i,z)$EXTO(i,z)..
3461  *                 PET(i,z)*EXT(i,z) =e= SUM[zj$EXO(i,z,zj),
3462  *                                           PE(i,z,zj)*EX(i,z,zj);
3463   
3464   EQ60(i,z,zj,t)$EXO(i,z,zj)..
3465                   PE(i,z,zj,t)*(1+ttix(i,z,zj,t)) =e= e(z,t)*PWX(i,z,zj,t);
3466   
3467   EQ61(i,z,t)$DDO(i,z)..
3468                   PD(i,z,t) =e= (1+ttic(i,z,t))*PL(i,z,t);
3469   
3470   EQ62(i,zj,z,t)$IMO(i,zj,z)..
3471                   PM(i,zj,z,t) =e= (1+ttic(i,z,t))*(1+ttim(i,zj,z,t))*e(z,t)*
3472                                    (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
3473                                    *tmrg(ij,i,zj,z)]);
3474   
3475  * Given equations 47 and 48, equation 63 is redundant
3476  * EQ63(i,z)$IMTO(i,z)..
3477  *                 PMT(i,z)*IMT(i,z) =e= SUM[zj$IMO(i,zj,z),
3478  *                                           PM(i,zj,z)*IM(i,zj,z);
3479   
3480   EQ64(i,z,t)..     PC(i,z,t)*Q(i,z,t) =e= [PD(i,z,t)*DD(i,z,t)]$DDO(i,z)+
3481                                      [PMT(i,z,t)*IMT(i,z,t)]$IMTO(i,z);
3482   
3483  * EQ65(z,t)..       PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
3484  *                               /gamma_INV(i,z))**gamma_INV(i,z)];
3485   
3486   EQ66(z,t)..       PIXGDP(z,t) =e=
3487                   {SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)]
3488                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
3489                   *SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)]
3490                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)]}**0.5;
3491   
3492   EQ67(t)..         PIXGDP_W(t) =e=
3493                   {SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)/e(z,t)]
3494                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
3495                   *SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)/e(z,t)]
3496                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)/eO(z)]}**0.5;
3497   
3498   EQ68(z,t)..       PIXCON(z,t) =e= SUM[i,PC(i,z,t)*CO(i,z)]/SUM[i,PCO(i,z)*CO(i,z)];
3499   
3500   EQ69(z,t)..       PIXINV(z,t) =e= PROD[i$gamma_INV(i,z),(PC(i,z,t)/PCO(i,z))
3501                                   **gamma_INV(i,z)];
3502   
3503   EQ70(z,t)..       PIXGVT(z,t) =e= PROD[i$gamma_GVT(i,z),(PC(i,z,t)/PCO(i,z))
3504                                   **gamma_GVT(i,z)];
3505   
3506  *==============================================================================
3507  *   5.3.6 Equilibrium
3508  *==============================================================================
3509   EQ71(i1,z,t)..    Q(i1,z,t) =e= C(i1,z,t)+CG(i1,z,t)+INV(i1,z,t)+DIT(i1,z,t);
3510   
3511   EQ71_2(i3,z,t)..  Q(i3,z,t) =e= C(i3,z,t)+CG(i3,z,t)+INV(i3,z,t)+C_Conventional(i3,z,t);
3512   
3513   EQ72(l,z,t)..     LS(l,z,t) =e= SUM[j$LDO(l,j,z),LD(l,j,z,t)+LBS(l,j,z,t)];
3514   
3515   EQ73(k,z,t)$KSO(k,z)..
3516                     KS(k,z,t) =e= SUM[j$KDO(k,j,z),KD(k,j,z,t)+KBS(k,j,z,t)];
3517   
3518   EQ74(z,t)..       IT(z,t)   =e= SH(z,t)+SG(z,t)-CAB(z,t);
3519   
3520   EQ75(z,t)..       DEP(z,t)  =e= PK(z,t)*delta(z)*SUM[k$KSO(k,z),KS(k,z,t)];
3521   
3522   EQ76(i,z,t)$DDO(i,z)..
3523                   SUM[j$DSO(j,i,z),DS(j,i,z,t)] =e= DD(i,z,t);
3524   
3525   EQ77(i,z,zj,t)$EXO(i,z,zj)..
3526                   EX(i,z,zj,t) =e= IM(i,z,zj,t);
3527   
3528   EQ78(i,z,zj,t)$EXO(i,z,zj)..
3529                   PWX(i,z,zj,t) =e= PWM(i,z,zj,t);
3530   
3531   EQ79(i,t)..       SUM[z$MRGNO(i,z),MRGN(i,z,t)] =e= SUM[(z,zj,ij)$IMO(ij,zj,z),
3532                                                   tmrg(i,ij,zj,z)*IM(ij,zj,z,t)];
3533   
3534  * Given equations 33, 34 and 77, equation 80 is redundant
3535  * EQ80..          SUM[z,SROW(z)/e(z)] =e= 0;
3536   
3537  *==============================================================================
3538  *   5.3.7 Gross domestic product
3539  *==============================================================================
3540   EQ81(z,t)..       GDP_BP(z,t) =e= SUM[j,PVA(j,z,t)*VA(j,z,t)]+TIPT(z,t);
3541   
3542   EQ82(z,t)..       GDP_MP(z,t) =e= GDP_BP(z,t)+TPRCTS(z,t);
3543   
3544   EQ83(z,t)..       GDP_IB(z,t) =e= SUM[(l,j)$LDO(l,j,z),W(l,z,t)*LD(l,j,z,t)]
3545                                +SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*KD(k,j,z,t)]
3546                                +TPRCTS(z,t)+TPRODN(z,t);
3547   
3548   EQ84(z,t)..       GDP_FD(z,t) =e=
3549                   SUM[i,PC(i,z,t)*(C(i,z,t)+CG(i,z,t)+INV(i,z,t))]
3550                  +SUM[(i,zj)$EXO(i,z,zj),e(z,t)*PWX(i,z,zj,t)*EX(i,z,zj,t)]
3551                  +SUM[i$MRGNO(i,z),e(z,t)*PWMG(i,t)*MRGN(i,z,t)]
3552                  -SUM[(i,zj)$IMO(i,zj,z),e(z,t)*IM(i,zj,z,t)
3553                      *(PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)*tmrg(ij,i,zj,z)])]-TCTAX(z,t);
3554   
3555   EQ85(t)..          GDP_BP_W(t) =e= SUM[z,GDP_BP(z,t)/e(z,t)];
3556   
3557  *==============================================================================
3558  *  5.3.8 Real (volume) variables computed from price indices
3559  *==============================================================================
3560   EQ86(z,t)..       CTH_REAL(z,t) =e= CTH(z,t)/PIXCON(z,t);
3561   
3562   EQ87(z,t)..       G_REAL(z,t) =e= G(z,t)/PIXGVT(z,t);
3563   
3564   EQ88(z,t)..       GDP_BP_REAL(z,t) =e= GDP_BP(z,t)/PIXGDP(z,t);
3565   
3566   EQ89(t)..         GDP_BP_W_REAL(t) =e= GDP_BP_W(t)/PIXGDP_W(t);
3567   
3568   EQ90(z,t)..       GDP_MP_REAL(z,t) =e= GDP_MP(z,t)/PIXCON(z,t);
3569   
3570   EQ91(z,t)..       IT_REAL(z,t) =e= IT(z,t)/PIXINV(z,t);
3571   
3572   EQ92(z,t)..       CABX(z,t) =e= CAB(z,t)/[PIXGDP_W(t)*e(z,t)];
3573   
3574   EQ93..            OBJ =e= 1;
3575   
3576  *==============================================================================
3577  *   5.3.8 Dynamic equations
3578  *==============================================================================
3579   EQ94(z,t)..     IT(z,t) =e= PK(z,t)*SUM[(k,j)$KDO(k,j,z),IND(k,j,z,t)];
3580   
3581   EQ95(z,t)..     PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
3582                                 /gamma_INV(i,z))**gamma_INV(i,z)];
3583   EQ96(k,bus,z,t)$KDO(k,bus,z)..
3584                   IND(k,bus,z,t) =e= phi(z,t)*[R(k,bus,z,t)/U(z,t)]
3585                                    **sigma_INV(k,bus,z)*KD(k,bus,z,t);
3586   
3587  * EQ97a(z,t)..    IR(z,t) =e= {SUM[(k,j)$KDO(k,j,z),
3588  *                              R(k,j,z,t)*KD(k,j,z,t)]-DEP(z,t)}/
3589  *                             {PK(z,t)*SUM[(k,j)$KDO(k,j,z),KD(k,j,z,t)]};
3590   
3591   EQ97b(z,t)..    U(z,t) =e= PK(z,t)*(delta(z)+IR(z,t));
3592   
3593  *==============================================================================
3594  *   5.3.9 Other
3595  *==============================================================================
3596   WALRAS(z,t)..   LEON(z,t) =e= Q('01_AGRICULT',z,t)-C('01_AGRICULT',z,t)-CG('01_AGRICULT',z,t)-INV('01_AGRICULT',z,t)
3597                              -DIT('01_AGRICULT',z,t);
3598   
3599  *==============================================================================
3600  *   5.3.10 Backstop technology
3601  *==============================================================================
3602   EQ98(i3,z,t)..  C_Conventional(i3,z,t) =e= (1-penetration_rate(i3,z,t)*switch(i3,z,t))*DIT(i3,z,t);
3603   
3604   EQ99(i3,z,t)..  XDBS(i3,z,t) =e= penetration_rate(i3,z,t)*switch(i3,z,t)*DIT(i3,z,t);
3605   
3606   EQ100(j,z,t)..  XDBS2(j,z,t) =e= sum{i3$COMtoIND(j,i3),XDBS(i3,z,t)};
3607   
3608   EQ101(l,j,z,t)..  LBS(l,j,z,t) =e= 0.2*XDBS2(j,z,t)*LDO(l,j,z)/sum(lj,LDO(lj,j,z));
3609   
3610   EQ102(k,j,z,t)..  KBS(k,j,z,t) =e= 0.5*XDBS2(j,z,t)*KDO(k,j,z)/sum(kj,KDO(kj,j,z));
3611   
3612   EQ103(i3,z,t)..   CLBS(i3,z,t)  =e= sum(l,sum{j$INDtoCOM(i3,j),LBS(l,j,z,t)*WC(j,z,t)});
3613   
3614   EQ104(i3,z,t)..   CKBS(i3,z,t)  =e= sum(k,sum{j$INDtoCOM(i3,j),KBS(k,j,z,t)*RC(j,z,t)});
3615   
3616  * EQ104(i3,z,t)..   CKBS(i3,z,t)  =e= sum(k,sum{j$INDtoCOM(i3,j),KBS(k,j,z,t)*RTI(k,j,z,t)});
3617   
3618   EQ105(i3,z,t)..   MARKUP(i3,z,t) =e= {PC(i3,z,t)*XDBS(i3,z,t)-CLBS(i3,z,t)}*switch(i3,z,t) ;
3619   
3620  *==============================================================================
3621  * 6 Numerical resolution to compute A_VA, sh0, G, G_REAL and IND
3622  *==============================================================================
3623  *option cns = Snopt;
3624  *option cns = Ipopt;
3625  *option NLP = Ipopt;
3626  *option cns = path;
3627  *option cns = conopt4;
3628  *option NLP = conopt4;
3629  *option NLP = minos;
3630  *option NLP = pathnlp ;
3631   
3632  *option iterlim = 100;
3633  *option iterlim = 0;
3634   
3635  *option lmmxsf = t ;
3636   
3637  * Eliminating display of solution makes it easier to check whether model solves
3638  * and to identify year when it crashes.
3639  *option profile=1;
3640  *option profile=3;
3641  *option profiletol=10;
3642   
3643  option limrow=0, limcol=0, solprint = off;
3644  *$Offlisting
3645  *$Offsymlist
3646  *$Offinclude
3647  *option limrow=0, limcol=0, iterlim= 100 ;
3648  *option reslim = 1000;
3649   
3650  MODEL PEPWT World wide dynamic model /all/ ;
3651  PEPWT.holdfixed=1;
3652  *$EXIT
3653   
3654  *==============================================================================
3655  *  6.1 Scenarios
3656  *==============================================================================
3657  * Define the set of scenarios
3658  * For each scenario, there are two files to $INCLUDE:
3659  * SOLVE, and RESULTS.
3660   
3661  SET
3662  SCEN  List of scenarios
3663  /
3664   BAU             Business as usual values
3665   CPS             Current Policy Scenario
3666   NZS             Net Zero Scenario
3667  /
3668  ;
3669   
3670  *==============================================================================
3671  *  6.2 BAU scenario and Results
3672  *==============================================================================
3673  *$INCLUDE BAU_SOLVE_GTAP11b.gms
3674  *$INCLUDE BAU_RESULTS_GTAP11b.gms
3675  *$include BAU_IAMC.gms
3676  * The user may run the BAU scenario with the command line parameter s=bau
3677  * to save the solution and exit at this point.
3678  * The SIM scenario may be solved later using the command line parameter r=bau
3679  * to restart from the BAU solution.
3680   
3681  *==============================================================================
3682  *   6.3 Simulation 1 scenarios and Results
3683  *==============================================================================
3684  *$INCLUDE CPS_SOLVE_GTAP11b.gms
3685  *$INCLUDE CPS_RESULTS_GTAP11b.gms
3686   
3687  *==============================================================================
3688  *   6.4 Simulation 2 scenarios and Results
3689  *==============================================================================
INCLUDE    C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.RD_CGE\NZS_SOLVE_GTAP11b.gms
3691  *==============================================================================
3692  *  6.2.1.1 Choice of multifactor productivity
3693  *==============================================================================
3694  *  6.2.1.1.1 Input for multifactor productivity
3695  *==============================================================================
3696  * Multifactor productivity is retrieved from a model BAU solution with
3697  * endogenous A_VA(z,time) in equation 3, and exogenous real GDPs, fixed at
3698  * values that are projected using Four?, Benassy-Qu?r? and Fontagn? projected
3699  * growth rates. So the solution is forced to follow the GDP projected growth
3700  * paths. The solution values of A_VA are stored as parameter A_VA_RES.
3701  *-------------------------------------------------------------------------------
3702   
3703  *$ONTEXT
3704  PARAMETER
3705   A_VA_RES(z,time)     Value of A_VA to reproduce real GDP projections
3706   GX(z,time)           Current government expenditures on goods and services in region z
3707   G_REALX(z,time)      Current real government expenditures on goods and services in region z
3708   INDX(k,j,z,time)     Volume of new type k capital investment to industry j in region z
3709   sh0X(z,time)     Intercept (household savings)
3710   sh1X(z,time)     Household savings rate
3711   phi_BAU(z,time)
3712  ;
3713   
GDXIN   C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.RD_CGE\Input_w-t\B_line_GTAP11b.gdx
3715  *$LOAD A_VA_RES, sh0X, sh1X, GX, G_REALX, INDX
--- LOAD  A_VA_RES = 1:A_VA_RES
--- LOAD  GX = 2:GX
--- LOAD  G_REALX = 3:G_REALX
--- LOAD  INDX = 4:INDX
--- LOAD  sh1X = 26:sh1X
--- LOAD  sh0X = 27:sh0X
--- LOAD  phi_BAU = 28:phi_BAU
3717   
3718  display  A_VA_RES;
3719  *$EXIT
3720  *$OFFTEXT
3721   
3722  *==============================================================================
3723  *  6.2.1.1.2 Choice of multifactor productivity
3724  *==============================================================================
3725  * If you want to reproduce the real GDP projections, set:
3726   A_VA.FX(z,time)  = A_VA_RES(z,time);
3727  * Otherwise, simply put A_VA equal to one:
3728  * A_VA.FX(z,time)    = 1;
3729   
3730  *==============================================================================
3731  *   6.2.1.2 Choice of reference region
3732  *==============================================================================
3733  * By default, the reference region is USA,
3734   zr(z)           = no;
3735   zr('07_NAM')    = yes;
3736  *zr('ChinaHK')   = yes;
3737   z1(z)           = NOT[zr(z)];
3738   
3739  *==============================================================================
3740  *   6.2.1.3 Choice between closures FE and FP
3741  *==============================================================================
3742  *$ontext
3743  * FP CLOSURE: fixed PIXGDPs; numeraire is exchange rate of reference region
3744  * The exchange rates are endogenous, except for the reference region.
3745   e.FX(zr,time)      = eO(zr);
3746   PIXGDP.FX(z,time)  = PIXGDPO(z)/sum(zr,eO(zr));
3747  *$offtext
3748   
      * FE CLOSURE: fixed exchange rates; numeraire is PIXGDP of reference region
      * The exchange rates can be fixed at arbitrary values
       PIXGDP.FX(zr,time)  = PIXGDPO(zr);
       e.FX(z,time)        = eO(z);
3755   
3756   
3757  *==============================================================================
3758  *   Taking account of the existence or not of a feasible solution
3759  *==============================================================================
3760  PARAMETER
3761   SolStop
3762   If_Feasibl(time,scen)    Optimality status code
3763   StatSolver(time,scen)    Solver status code
3764   LastGood(scen)           Last feasible solution year
3765  ;
3766   SolStop = 0;
3767   LastGood(scen)=Endtime;
3768   file Status / 'Output_w-t/ModelStatus.xls'/;
3769  * Column separator: 6 = tab-separated file
3770  *                   5 = comma-separated file
3771       Status.pc=6;
3772  * Number of decimal places (maximum 10)
3773       Status.nd=0;
3774   
3775  * EndTime is the final year for model resolution.
3776  * Parameter EndTime is defined in the main program.
3777  LOOP[time$(time.val le EndTime),
3778  * T(time) is a subset of set TIME. It was previously empty. It now contains
3779  * a single element: it is the current value of the TIME index.
3780  T(time) = YES;
3781   
3782  *==============================================================================
3783  *   6.2.1.4 Other exogenous variables
3784  *==============================================================================
3785   G_REAL.FX(z,time)    = G_REALX(z,time);
3786   IND.fx(k,pub,z,time) = INDX(k,pub,z,time);
3787   phi.fx(z,time)       = phi_BAU(z,time);
3788   
3789   sh0.fx(z,time)       = sh0X(z,time);
3790   sh1.fx(z,time)       = sh1X(z,time);
3791  * ttdh0.fx(z,time)    = ttdh0O(z)*exogro(z,time);
3792  * phi.fx(z,time)       = phiO(z);
3793   ttdh0.fx(z,time)     = ttdh0O(z);
3794   ttdh1.fx(z,time)     = ttdh1O(z);
3795   ttic.fx(i,z,time)    = tticO(i,z);
3796   ttik.fx(k,j,z,time)  = ttikO(k,j,z);
3797   ttim.fx(i,zj,z,time) = ttimO(i,zj,z);
3798   ttip.fx(j,z,time)    = ttipO(j,z);
3799   ttiw.fx(l,j,z,time)  = ttiwO(l,j,z);
3800   ttix.fx(i,z,zj,time) = ttixO(i,z,zj);
3801  * CTAX.fX(z,time)     = CTAX1(z,time);
3802   CTAX.fX(z,time)      = CTAX0(z);
3803  beta_X4_t.fx(power,z,time) = beta_X4(power,z);
3804   
3805   
