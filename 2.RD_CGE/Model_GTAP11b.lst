6913  *==============================================================================
6914  *   6.1.3 Closures
6915  *==============================================================================
6916  *$ontext
6917  * FP CLOSURE: fixed PIXGDPs; numeraire is exchange rate of reference region
6918  * The exchange rates are endogenous, except for the reference region.
6919   e.FX(zr,time)      = eO(zr);
6920   PIXGDP.FX(z,time)  = PIXGDPO(z)/sum[zr,eO(zr)];
6921  *$offtext
6922   
      * FE CLOSURE: fixed exchange rates; numeraire is PIXGDP of reference region
      * The exchange rates can be fixed at arbitrary values
       PIXGDP.FX(zr,time)  = PIXGDPO(zr);
       e.FX(z,time)        = eO(z);
6929   
6930  *==============================================================================
6931  *   6.2.2.2 Variables fixed each period according to their lagged values
6932  *==============================================================================
6933   CABX.FX(z1,t1)      = CABXO(z1);
6934   CABX.FX(z1,time)$[ord(time) gt 1]
6935                       = CABX.l(z1,time-1)*[1+g_GDP(z1,time)];
6936   
6937   CMIN.FX(i,z,t1)     = CMINO(i,z);
6938   CMIN.FX(i,z,time)$[ord(time) gt 1]
6939                        = CMIN.l(i,z,time-1)*[1+g_GDP(z,time)];
6940   
6941   KD.fx(k,j,z,t1)$KDO(k,j,z)
6942                       = KDO(k,j,z);
6943   KD.fx(k,j,z,time)${[ord(time) gt 1] and KDO(k,j,z)}
6944                       = KD.l(k,j,z,time-1)*[1-delta(z)]+IND.l(k,j,z,time-1);
6945   
6946   KD.fx('natr',j,z,time)${[ord(time) gt 1] and KDO('natr',j,z)}
6947                        = KD.l('natr',j,z,time-1)*(1-0.01);
6948   
6949   KD.fx('land',j,z,time)${[ord(time) gt 1] and KDO('land',j,z)}
6950                        = KD.l('land',j,z,time-1);
6951   
6952   LS.FX(l,z,t1)       = LSO(l,z);
6953   LS.FX(l,z,time)$[ord(time) gt 1]
6954                       = LS.l(l,z,time-1)*[1+g_POP(z,time)];
6955   
6956  * SH.fx(z,t1)         = SHO(z);
6957  * SH.fx(z,time)$[ord(time) gt 1]
6958  *                     = SH.l(z,time-1)*[1+growthz(z)];
6959  *                     = SH.l(z,time-1)*[1+g_GDP(z,time)];
