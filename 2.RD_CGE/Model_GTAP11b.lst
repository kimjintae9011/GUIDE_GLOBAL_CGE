3833   
3834  *==============================================================================
3835  * A. Initialization
3836  *    Assignment of initial values to variables prior to resolution
3837  *==============================================================================
3838  *  A.1 Initialization for the first period
3839  *==============================================================================
3840  *   A.1.1 Volume variables
3841  *==============================================================================
3842   CABX.L(z,t1)      = CABXO(z);
3843   C.L(i,z,t1)       = CO(i,z);
3844   CG.L(i,z,t1)      = CGO(i,z);
3845   CI.L(j,z,t1)      = CIO(j,z);
3846   CE.L(j,z,t1)      = CEO(j,z);
3847   CMIN.L(i,z,t1)    = CMINO(i,z);
3848   CTH_REAL.L(z,t1)  = CTH_REALO(z);
3849   DI.L(i,j,z,t1)    = DIO(i,j,z);
3850   DE.L(ene,j,z,t1)  = DEO(ene,j,z);
3851   DIT.L(i,z,t1)     = DITO(i,z);
3852   DD.L(i,z,t1)      = DDO(i,z);
3853   DS.L(j,i,z,t1)    = DSO(j,i,z);
3854   DS_I.L(i,z,t1)    = DSO_I(i,z);
3855   EX.L(i,z,zj,t1)   = EXO(i,z,zj);
3856   EXT.L(i,z,t1)     = EXTO(i,z);
3857   EXTT.L(j,i,z,t1)  = EXTTO(j,i,z);
3858   G_REAL.L(z,t1)    = G_REALO(z);
3859   GDP_BP_REAL.l(z,t1) = GDP_BP_REALO(z);
3860   GDP_MP_REAL.l(z,t1) = GDP_MP_REALO(z);
3861   GDP_BP_W_REAL.l(t1) = GDP_BP_W_REALO;
3862   IM.L(i,zj,z,t1)   = IMO(i,zj,z);
3863   IMT.L(i,z,t1)     = IMTO(i,z);
3864   IND.L(k,j,z,t1)   = INDO(k,j,z);
3865   INV.L(i,z,t1)     = INVO(i,z);
3866   IT_REAL.l(z,t1)   = IT_REALO(z);
3867   KD.L(k,j,z,t1)    = KDO(k,j,z);
3868   KDC.L(j,z,t1)     = KDCO(j,z);
3869   KS.L(k,z,t1)      = KSO(k,z);
3870   LD.L(l,j,z,t1)    = LDO(l,j,z);
3871   LDC.L(j,z,t1)     = LDCO(j,z);
3872   LS.L(l,z,t1)           = LSO(l,z);
3873   MRGN.L(i,z,t1)         = MRGNO(i,z);
3874   Q.L(i,z,t1)            = QO(i,z);
3875   VA.L(j,z,t1)           = VAO(j,z);
3876   KLE.L(j,z,t1)          = KLEO(j,z);
3877   XS.L(j,i,z,t1)         = XSO(j,i,z);
3878   XS_I.L(i,z,t1)         = XSO_I(i,z);
