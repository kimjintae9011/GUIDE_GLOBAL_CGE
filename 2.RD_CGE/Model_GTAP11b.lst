4402  *==============================================================================
4403  *   6.2.2.2 Variables fixed each period according to their lagged values
4404  *==============================================================================
4405   CABX.FX(z1,t1)      = CABXO(z1);
4406   CABX.FX(z1,time)$[ord(time) gt 1]
4407                       = CABX.l(z1,time-1)*[1+g_GDP(z1,time)];
4408   
4409   CMIN.FX(i,z,t1)     = CMINO(i,z);
4410   CMIN.FX(i,z,time)$[ord(time) gt 1]
4411                        = CMIN.l(i,z,time-1)*[1+g_GDP(z,time)];
4412   
4413   KD.fx(k,j,z,t1)$KDO(k,j,z)
4414                       = KDO(k,j,z);
4415   KD.fx(k,j,z,time)${[ord(time) gt 1] and KDO(k,j,z)}
4416                       = KD.l(k,j,z,time-1)*[1-delta(z)]+IND.l(k,j,z,time-1);
4417   
4418   KD.fx('natr',j,z,time)${[ord(time) gt 1] and KDO('natr',j,z)}
4419                        = KD.l('natr',j,z,time-1)*(1-0.01);
4420   
4421   KD.fx('land',j,z,time)${[ord(time) gt 1] and KDO('land',j,z)}
4422                        = KD.l('land',j,z,time-1);
4423   
4424   LS.FX(l,z,t1)       = LSO(l,z);
4425   LS.FX(l,z,time)$[ord(time) gt 1]
4426                       = LS.l(l,z,time-1)*[1+g_POP(z,time)];
4427   
