 857  *==============================================================================
 858  *   Rescaling
 859  *==============================================================================
 860  * GTAP data are in millions of US dollars With RES = 10000, model results are in tens of billions (10G$)
 861  RES              = 10000;
 862  CO(i,z)          = CO(i,z)/RES;
 863  CGO(i,z)         = CGO(i,z)/RES;
 864  DDO(i,z)         = DDO(i,z)/RES;
 865  DEPO(z)          = DEPO(z)/RES;
 866  DIO(i,j,z)       = DIO(i,j,z)/RES;
 867  DSO(j,i,z)       = DSO(j,i,z)/RES;
 868  DSO_I(i,z)       = DSO_I(i,z)/RES;
 869  EXO(i,z,zj)      = EXO(i,z,zj)/RES;
 870  IMO(i,z,zj)      = IMO(i,z,zj)/RES;
 871  INVO(i,z)        = INVO(i,z)/RES;
 872  KSTO(z)          = KSTO(z)/RES;
 873  LDO(j,z)         = LDO(j,z)/RES;
 874  MRGNO(i,z)       = MRGNO(i,z)/RES;
 875  RKDO(k,j,z)      = RKDO(k,j,z)/RES;
 876  TDHO(z)          = TDHO(z)/RES;
 877  TICO(i,z)        = TICO(i,z)/RES;
 878  TIKO(k,j,z)      = TIKO(k,j,z)/RES;
 879  TIMO(i,z,zj)     = TIMO(i,z,zj)/RES;
 880  TIPO(j,z)        = TIPO(j,z)/RES;
 881  TIWO(j,z)        = TIWO(j,z)/RES;
 882  TIXO(i,z,zj)     = TIXO(i,z,zj)/RES;
 883  tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj)/RES;
 884  XSO_I(i,z)       = XSO_I(i,z)/RES;
 885  XSO(j,i,z)       = XSO(j,i,z)/RES;
 886  XSTO(j,z)        = XSTO(j,z)/RES;
 887   
 888  *==============================================================================
 889  *  3.3 Exogenous prices and parameters
 890  *==============================================================================
 891  *  Price elasticity (should be equal to one to verify homogeneity)
 892  eta = 1;
 893   
 894  *------------------------------------------------------------------------------
 895  *  Slopes of taxation functions
 896  *   One can either choose to assign a value to the intercepts and calibrate
 897  *   the slopes accordingly, or the other way around. This type of modelling
 898  *   can be useful to take into account known marginal savings or taxation rates
 899  *   or to deal with negative average saving rates in cases where savings are
 900  *   negative for some household groups.
 901  *   When no further information is available, one can simply set the intercepts
 902  *   to zero and calibrate an average rate: this is what we do here for ttdh0O.
 903  *   If the user wishes to assume otherwise, he can fill the appropriate area in
 904  *   the Excel file VAL_PAR.xls.
 905  * ttdh0O(z)       = PARZ(z,'ttdh0O');
 906   ttdh0O(z)       = 0;
 907  *   The slope ttdh1O is calibrated below in the mane GAMS file
 908   
 909  *------------------------------------------------------------------------------
 910  * Also we need to assign values to some prices
 911  * All of the prices below, EXCEPT eO, may be set at arbitrary values
 912  * without loss of generality.
 913  *
 914  * In the case of eO, although exchange rates may be given arbitrary values
 915  * in the model, they must all be equal for calibration at this stage. The reason
 916  * is that the supply of margin transport services MRGNO must equal global demand.
 917  * Since there is a single world price for international transport margins
 918  * (rather than bilateral world prices for other commodities) the unit of
 919  * measurement of the volume of margin services must be the same for all regions,
 920  * and in turn, that implies that the divisor that converts the nominal value to
 921  * volume be the same for all regions. Since that divisor involves the exchange
 922  * rate, all exchange rates must be equal.
 923   
 924  * Normally, prices that may be given arbitrary values are set at 1:
 925   eO(z)            = 1;
 926   PEO(i,z,zj)      = 1;
 927   PLO(i,z)         = 1;
 928   PWMGO(i)         = 1;
 929   WO(z)            = 1;
 930   WO_lag(z)        = WO(z) ;
 931   
 932  *==============================================================================
 933  * Calibration
 934  *==============================================================================
 935   YHKO(z)         = SUM[(k,j),RKDO(k,j,z)];
 936   YHLO(z)         = SUM[(j),LDO(j,z)];
 937   YHO(z)          = YHLO(z)+YHKO(z);
 938   YDHO(z)         = YHO(z)-TDHO(z);
 939   CTHO(z)         = SUM[i,CO(i,z)];
 940   SHO(z)          = YDHO(z)-CTHO(z);
 941   TICTO(z)        = SUM[i,TICO(i,z)];
 942   TIMTO(z)        = SUM[(i,zj),TIMO(i,zj,z)];
 943   TIWTO(z)        = SUM[(j),TIWO(j,z)];
 944   TIKTO(z)        = SUM[(k,j),TIKO(k,j,z)];
 945   TIPTO(z)        = SUM[j,TIPO(j,z)];
 946   TIXTO(z)        = SUM[(i,zj),TIXO(i,z,zj)];
 947   TPRODNO(z)      = TIKTO(z)+TIWTO(z)+TIPTO(z);
 948   TPRCTSO(z)      = TICTO(z)+TIMTO(z)+TIXTO(z);
 949   YGO(z)          = TDHO(z)+TPRCTSO(z)+TPRODNO(z);
 950   GO(z)           = SUM[i,CGO(i,z)];
 951   SGO(z)          = YGO(z)-GO(z);
 952   YROWO(z)        = SUM[(i,zj),IMO(i,zj,z)]+SUM[(i,ij,zj),tmrg(i,ij,zj,z)];
 953   SROWO(z)        = YROWO(z)-SUM[(i,zj),EXO(i,z,zj)]-SUM[i,MRGNO(i,z)];
 954   CABO(z)         = -SROWO(z);
 955   ITO(z)          = SHO(z)+SGO(z)+SROWO(z);
 956   
 957  *==============================================================================
 958  *  Calibration of parameters and other variables
 959  *==============================================================================
 960  *  Calibration of investment and government spending shares
 961  *==============================================================================
 962   gamma_GVT(i,z)  = CGO(i,z)/SUM[ij,CGO(ij,z)];
 963   gamma_INV(i,z)  = INVO(i,z)/SUM[ij,INVO(ij,z)] ;
 964   
 965  *==============================================================================
 966  *  Calibration of other prices and revised volumes (part 1)
 967  *==============================================================================
 968   LDO(j,z)      = LDO(j,z)/WO(z);
 969   LDCO(j,z)     = LDO(j,z);
 970   LSO(z)        = SUM[j,LDO(j,z)];
 971   LSTO(z)       = LSO(z) ;
 972   LSO_lag(z)    = LSO(z) ;
 973   LSTO_lag(z)   = LSO(z) ;
 974   EXO(i,z,zj)  = [EXO(i,z,zj)-TIXO(i,z,zj)]/PEO(i,z,zj);
 975   EXTO(i,z)    = SUM[zj,EXO(i,z,zj)];
 976   PWXO(i,z,zj)$EXO(i,z,zj)
 977                   = {[PEO(i,z,zj)*EXO(i,z,zj)+TIXO(i,z,zj)]/EXO(i,z,zj)}/eO(z);
 978   
 979   PETO(i,z)       = SUM[zj,PEO(i,z,zj)*EXO(i,z,zj)]/EXTO(i,z);
 980  * PETO(i,z)$(EXTO(i,z) > 0) = SUM[zj, PEO(i,z,zj) * EXO(i,z,zj)] / EXTO(i,z);
 981  * PETO(i,z)$(EXTO(i,z) = 0) = 0;
 982   PWMO(i,z,zj)    = PWXO(i,z,zj);
 983   IMO(i,zj,z)     = EXO(i,zj,z);
 984   IMTO(i,z)       = SUM[zj,IMO(i,zj,z)];
 985   
 986   DSO(j,i,z)      = DSO(j,i,z)/PLO(i,z);
 987   DSO_I(i,z)      = SUM(j,DSO(j,i,z));
 988   DSO_J(j,z)      = SUM(i,DSO(j,i,z));
 989   QO(i,z)         = IMTO(i,z)+DDO(i,z);
 990   
 991   MRGNO(i,z)$MRGNO(i,z)
 992                   = MRGNO(i,z)/[eO(z)*PWMGO(i)];
 993   
 994   XSO_I(i,z)      = EXTO(i,z)+DDO(i,z)+MRGNO(i,z);
 995   
 996   XSTO(j,z)       = sum(i, XSO(j,i,z));
 997   
 998   PO(i,z)         = [PETO(i,z)*EXTO(i,z)+PLO(i,z)*DSO_I(i,z)
 999                    +eO(z)*PWMGO(i)*MRGNO(i,z)]/XSO_I(i,z);
1000   
1001   PO2(j,i,z)$XSO(j,i,z) = 1;
1002   
1003   PO3(i,j,z)$XSO(j,i,z) = 1;
1004   
1005   PIO(i,z)       = SUM[j$XSO(j,i,z),PO2(J,I,z)*XSO(j,i,z)]/XSO_I(i,z);
1006   
1007   PTO(j,z)       = SUM[i$XSO(j,i,z),PO2(j,i,z)*XSO(j,i,z)]/XSTO(j,z);
1008   
1009   PPO(j,z)       = (TIWO(j,z)+WO(z)*LDO(j,z)
1010                    +SUM[k,TIKO(k,j,z)+RKDO(k,j,z)]
1011                    +SUM[nene,DIO(nene,j,z)]+SUM[ene,DIO(ene,j,z)])/XSTO(j,z);
1012   
1013   theta2(j,i,z)  = DSO(j,i,z)/sum(jj, DSO(jj,i,z));
1014   
1015   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z)*EXTO(i,z);
1016   
1017  *==============================================================================
1018  *  Calibration of tax rates, margins, prices and volumes
1019  *==============================================================================
1020  *  Margin rates and tax rates
1021  *==============================================================================
1022   ttixO(i,z,zj)   = [eO(z)*PWXO(i,z,zj)/PEO(i,z,zj)]-1;
1023   tticO(i,z)      = TICO(i,z)/{PLO(i,z)*DDO(i,z)
1024                     +SUM[zj,IMO(i,zj,z)*eO(z)*PWMO(i,zj,z)
1025                     +TIMO(i,zj,z)+SUM[ij,tmrg(ij,i,zj,z)]]};
1026   
1027   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
1028                   = tmrg(i,ij,zj,z)/(PWMGO(i)*eO(z)*IMO(ij,zj,z));
1029   
1030   ttimO(i,zj,z)$IMO(i,zj,z)
1031                   = TIMO(i,zj,z)/{IMO(i,zj,z)*eO(z)*(PWMO(i,zj,z)
1032                    +SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])};
1033   
1034   ttiwO(j,z)$LDO(j,z)
1035                   = TIWO(j,z)/[WO(z)*LDO(j,z)];
1036   
1037   ttikO(k,j,z)$RKDO(k,j,z)
1038                   = TIKO(k,j,z)/RKDO(k,j,z);
1039   
1040   ttipO(j,z)      = [PTO(j,z)/PPO(j,z)]-1;
1041   
1042   ttdh1O(z)       = [TDHO(z)-ttdh0O(z)]/YHO(z);
1043   
1044  *==============================================================================
1045  *  Calibration of other prices and revised volumes (part 2)
1046  *==============================================================================
1047   PDO(i,z)        = PLO(i,z)*(1+tticO(i,z));
1048   PMO(i,zj,z)     = eO(z)*(PWMO(i,zj,z)+SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])
1049                   *(1+ttimO(i,zj,z))*(1+tticO(i,z));
1050   PMTO(i,z)       = SUM[zj,PMO(i,zj,z)*IMO(i,zj,z)]/IMTO(i,z);
1051   PCO(i,z)        = [PMTO(i,z)*IMTO(i,z)+PDO(i,z)*DDO(i,z)]/QO(i,z);
1052   
1053   CO(i,z)         = CO(i,z)/PCO(i,z);
1054   CGO(i,z)        = CGO(i,z)/PCO(i,z);
1055   DIO(nene,j,z)   = DIO(nene,j,z)/PCO(nene,z);
1056   DEO(ene,j,z)    = DIO(ene,j,z)/PCO(ene,z);
1057   
1058   DEelecO(j,z)    = DIO("18_ELEC",j,z)/PCO("18_ELEC",z);
1059   DEnelecO(j,z)   = sum(ene3,DEO(ene3,j,z));
1060   
1061   DEcoalgasO(j,z) = sum(ene5,DEO(ene5,j,z));
1062   DEcoalO(j,z)    = DEO("02_COAL ",j,z);
1063   DEgasO(j,z)     = DEO("04_GAS",j,z);
1064   
1065   DEoilpetrolO(j,z) = sum(ene6,DEO(ene6,j,z));
1066   DEoilO(j,z)       = DEO("03_OIL",j,z);
1067   DEpetrolO(j,z)    = DEO("10_PETROLCOAL",j,z);
1068   
1069   INVO(i,z)       = INVO(i,z)/PCO(i,z);
1070   
1071   CIO(j,z)        = SUM[nene,DIO(nene,j,z)];
1072   CEO(j3,z)        = SUM[ene,DEO(ene,j3,z)];
1073   CEO(j2,z)        = DEelecO(j2,z)+DEnelecO(j2,z);
1074   
1075   DITO(nene,z)    = SUM[j,DIO(nene,j,z)];
1076   DITO(ene,z)     = SUM[j,DEO(ene,j,z)];
1077   
1078   PO4(ene,j,z)    = PCO(ene,z);
1079   
1080   PCIO(j,z)       = SUM[nene,PCO(nene,z)*DIO(nene,j,z)]/CIO(j,z);
1081   
1082   PCEcoalO(j,z)   = PO4("02_COAL",j,z) ;
1083   PCEgasO(j,z)    = PO4("04_GAS",j,z) ;
1084   PCEoilO(j,z)    = PO4("03_OIL",j,z) ;
1085   PCEpetrolO(j,z) = PO4("10_PETROLCOAL",j,z) ;
1086   
1087   PCEoilpetrolO(j,z)  = [PCEoilO(j,z)*DEoilO(j,z)+PCEpetrolO(j,z)*DEpetrolO(j,z)]
1088                     /DEoilpetrolO(j,z) ;
1089   
1090   PCEcoalgasO(j,z)  = [PCEcoalO(j,z)*DEcoalO(j,z)+PCEgasO(j,z)*DEgasO(j,z)]
1091                     /DEcoalgasO(j,z) ;
1092   
1093   PCEnelecO(j,z)  = [PCEcoalgasO(j,z)*DEcoalgasO(j,z)+PCEoilpetrolO(j,z)*DEoilpetrolO(j,z)]
1094                     /DEnelecO(j,z) ;
1095   
1096   PCEelecO(j,z)   = SUM[ene4,PCO(ene4,z)*DEO(ene4,j,z)]/DEelecO(j,z) ;
1097   PCEO(j,z)       = [PCEelecO(j,z)*DEelecO(j,z)+PCEnelecO(j,z)*DEnelecO(j,z)]/CEO(j,z) ;
1098   PCEO(j3,z)       = SUM[ene,PCO(ene,z)*DEO(ene,j3,z)]/CEO(j3,z) ;
1099   WTIO(j,z)     = WO(z)*(1+ttiwO(j,z));
1100   WCO(j,z)$LDCO(j,z)
1101                   = (WTIO(j,z)*LDO(j,z))/LDCO(j,z);
1102   
1103  *==============================================================================
1104  *  Calibration of dynamic parameters
1105  *==============================================================================
1106  * Calibration of dynamic parameters following new procedure.
1107  * The price of capital is arbitrary:
1108   PKO(z) = 1;
1109   
1110  * The calibration of depreciation rates is based on two hypotheses:
1111  * 1. The rate of depreciation is the same for all types of capital and all
1112  *    industries in each region (this hypothesis is made to accommodate the fact
1113  *    that, in the GTAP data base, capital consumption allowance is not detailed;
1114  *    as a matter of fact, the GTAP capital consumption allowance is set at
1115  *    4% of the value of the capital stock).
1116  * 2. The rental rate of capital is uniform across industries and types of
1117  *    capital in each region.
1118  * 3. The investment rate (IND/KD) is uniform across industries and types of
1119  *    capital in each region.
1120  * These hypotheses lead to the following formulae:
1121   
1122  * From GTAP, we know KSTO.
1123   KSTO(z)         = KSTO(z)/PKO(z);
1124   
1125  * Assuming a uniform depreciation rate for all types
1126  * of capital and all industries:
1127   delta(z)        = DEPO(z)/[PKO(z)*KSTO(z)];
1128   
1129  * From GTAP, we know KSTO. Assuming a uniform rental rate R for all types
1130  * of capital and all industries:
1131   RO(k,j,z)$RKDO(k,j,z)
1132                   = SUM[(kj,jj),RKDO(kj,jj,z)]/KSTO(z);
1133   
1134  * Then from the GTAP value of income paid to capital RKD we calibrate KDO:
1135   KDO(k,j,z)$RKDO(k,j,z)
1136                   = RKDO(k,j,z)/RO(k,j,z);
1137   
1138  * The supply of capital is equal to demand:
1139   KSO(k,z)        = SUM[j,KDO(k,j,z)];
1140   
1141  * The rate of return on capital, net of depreciation, is:
1142   IRO(z)         = {SUM[(k,j)$RKDO(k,j,z),RKDO(k,j,z)]-DEPO(z)}/[PKO(z)*KSTO(z)];
1143   
1144  * The user cost of capital follows
1145   UO(z)           = PKO(z)*(IRO(z)+delta(z));
1146   
1147  * Combining
1148  * - the hypothesis of uniform investment rates
1149  * - the hypothesis of uniform rental rates
1150  * - the hypothesis of uniform depreciation rates
1151  * leads to
1152   phiO(z)         = [ITO(z)/PKO(z)]/KSTO(z);
1153   
1154  * Investment by destination follows:
1155   INDO(k,j,z)$KDO(k,j,z)
1156                   = phiO(z)*KDO(k,j,z);
1157   
1158   A_K(z)          = 1/PKO(z)*{PROD[i$gamma_INV(i,z),(PCO(i,Z)/gamma_INV(i,z))
1159                     **gamma_INV(i,z)]};
1160   
1161   KDCO(j,z)       = SUM[k,KDO(k,j,z)];
1162   RTIO(k,j,z)     = RO(k,j,z)*(1+ttikO(k,j,z));
1163   RCO(j,z)$KDCO(j,z)
1164                   = SUM[k,RTIO(k,j,z)*KDO(k,j,z)]/KDCO(j,z);
1165   
1166  *==============================================================================
1167  *  Calibration of other prices and revised volumes (part 3)
1168  *==============================================================================
1169   VAO(j,z)        = LDCO(j,z)+KDCO(j,z);
1170   
1171   PVAO(j,z)       = [WCO(j,z)*LDCO(j,z)+RCO(j,z)*KDCO(j,z)]/VAO(j,z);
1172   
1173  * PIXGDPO is tautologically equal to 1, based on its formula
1174  * PIXGDPO(z)      = {SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1175  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1176  *                   *SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1177  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]}**0.5;
1178   PIXGDPO(z)      = 1;
1179   
1180  * PIXGDP_WO is tautologically equal to 1, based on its formula
1181  * PIXGDP_WO       = {SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1182  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1183  *                   *SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1184  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]/eO(z)}**0.5;
1185   PIXGDP_WO       = 1;
1186   
1187  * PIXCONO(z) is tautologically equal to 1, based on its formula
1188  * PIXCONO(z)      = SUM[i,PCO(i,z)*CO(i,z)]
1189  *                  /SUM[i,PCO(i,z)*CO(i,z)];
1190   PIXCONO(z)      = 1;
1191   PIXCONO_lag(z)  = PIXCONO(z);
1192   
1193  * PIXINVO(z) is tautologically equal to 1, based on its formula
1194  * PIXINVO(z)      = PROD[i$gamma_INV(i,z),(PCO(i,z)/PCO(i,z))**gamma_INV(i,z)];
1195   PIXINVO(z)      = 1;
1196   
1197  * PIXGVTO(z) is tautologically equal to 1, based on its formula
1198  * PIXGVTO(z)      = PROD[i$gamma_GVT(i,z),(PCO(i,z)/PCO(i,z))**gamma_GVT(i,z)];
1199   PIXGVTO(z)      = 1;
1200   
1201  *==============================================================================
1202  *  Calibration of function parameters
1203  *==============================================================================
1204  *   Leontief functions
1205  *==============================================================================
1206   io(j,z)         = CIO(j,z)/XSTO(j,z) ;
1207   
1208   io2(j,z)        = CEO(j,z)/XSTO(j,z) ;
1209   
1210   v(j,z)          = VAO(j,z)/XSTO(j,z) ;
1211   
1212   v2(j,z)         = (CEO(j,z)+VAO(j,z))/XSTO(j,z) ;
1213   
1214   aij(nene,j,z)   = DIO(nene,j,z)/CIO(j,z);
1215   
1216   aij2(ene,j,z)   = DEO(ene,j,z)/CEO(j,z);
1217   
1218  *==============================================================================
1219  *   Calibration of CET parameters
1220  *==============================================================================
1221  *    CET between total exports, domestic supply and margins
1222  *==============================================================================
1223   rho_X1(i,z)     = (1+sigma_X1(i,z))/sigma_X1(i,z);
1224   
1225   beta_EX_X1(i,z)$MRGNO(i,z)
1226                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1227                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1228                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1229                     eO(z)*PWMGO(i)*MRGNO(i,z)$MRGNO(i,z)**(1-rho_X1(i,z))];
1230   
1231   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1232                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1233                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1234                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1235   
1236   beta_D_X1(i,z)$MRGNO(i,z)
1237                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1238                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1239                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1240                     eO(z)*PWMGO(i)*MRGNO(i,z)**(1-rho_X1(i,z))];
1241   
1242   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1243                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1244                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1245                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1246   
1247   B_X1(i,z)       = XSO_I(i,z)/[beta_EX_X1(i,z)*EXTO(i,z)**rho_X1(i,z)
1248                    +beta_D_X1(i,z)*DSO_I(i,z)**rho_X1(i,z)+(1-beta_EX_X1(i,z)
1249                    -beta_D_X1(i,z))*MRGNO(i,z)**rho_X1(i,z)]**(1/rho_X1(i,z));
1250   
1251  *==============================================================================
1252  *    CET between exports to different trading partners
1253  *==============================================================================
1254   rho_X2(i,z)     = (1+sigma_X2(i,z))/sigma_X2(i,z);
1255   
1256   beta_X2(i,z,zj)$EXO(i,z,zj)
1257                   = [PEO(i,z,zj)*EXO(i,z,zj)**(1-rho_X2(i,z))]/
1258                     SUM[zjj$EXO(i,z,zjj),PEO(i,z,zjj)*EXO(i,z,zjj)
1259                     **(1-rho_X2(i,z))];
1260   
1261   B_X2(i,z)       = EXTO(i,z)/{SUM[zj,beta_X2(i,z,zj)*EXO(i,z,zj)**rho_X2(i,z)]
1262                     **(1/rho_X2(i,z))};
1263   
1264  *==============================================================================
1265  *   Calibration of CES parameters
1266  *==============================================================================
1267  *    Composite output
1268  *==============================================================================
1269   rho_X3(i,z)   = (1-sigma_X3(i,z))/sigma_X3(i,z);
1270   
1271   beta_X3(j,i,z)$XSO(j,i,z)
1272                 = [PO2(j,i,z)*XSO(j,i,z)**(1+rho_X3(i,z))]/
1273                     SUM[jj$XSO(jj,i,z),PO2(jj,i,z)*XSO(jj,i,z)**(1+rho_X3(i,z))];
1274   
1275   B_X3(i,z)     = XSO_I(i,z)
1276                    /SUM[jj$XSO(jj,i,z),beta_X3(jj,i,z)*XSO(jj,i,z)**(-rho_X3(i,z))
1277                    ]**(-1/rho_X3(i,z));
1278   
1279   POWERQO(Z) = SUM(POWER, XSO(power,'18_ELEC',z));
1280   
1281   rho_X4(z)   = (1-sigma_X4(z))/sigma_X4(z);
1282   
1283   beta_X4(power,z)
1284                 = [PO2(power,'18_ELEC',z)*XSO(power,'18_ELEC',z)**(1+rho_X4(z))]/
1285                     SUM[powerr$XSO(powerr,'18_ELEC',z),PO2(powerr,'18_ELEC',z)*XSO(powerr,'18_ELEC',z)**(1+rho_X4(z))];
1286   
1287   B_X4(z)     = POWERQO(Z)
1288                    /SUM[powerr$XSO(powerr,'18_ELEC',z),beta_X4(powerr,z)*XSO(powerr,'18_ELEC',z)**(-rho_X4(z))
1289                    ]**(-1/rho_X4(z));
1290   
1291   TnDShare(z) = XSO('18_TnD','18_ELEC',z)/XSO_I('18_ELEC',z);
1292   
1293   PPOWERO(z) = 1;
1294   
1295  *==============================================================================
1296  *    Composite good
1297  *==============================================================================
1298   rho_M1(i,z)     = (1-sigma_m1(i,z))/sigma_m1(i,z);
1299   
1300   beta_M1(i,z)    = PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)/
1301                    {PDO(i,z)*DDO(i,z)**(rho_M1(i,z)+1)
1302                    +PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)};
1303   
1304   B_M1(i,z)       = QO(i,z)/{beta_M1(i,z)*IMTO(i,z)**(-rho_M1(i,z))
1305                    +(1-beta_M1(i,z))*DDO(i,z)**(-rho_M1(i,z))}**(-1/rho_M1(i,z));
1306   
1307  *==============================================================================
1308  *   CES between imports from different trading partners
1309  *==============================================================================
1310   rho_M2(i,z)     = (1-sigma_M2(i,z))/sigma_M2(i,z);
1311   
1312   beta_M2(i,zj,z)$IMO(i,zj,z)
1313                   = [PMO(i,zj,z)*IMO(i,zj,z)**(rho_M2(i,z)+1)]/
1314                     SUM[zjj$IMO(i,zjj,z),PMO(i,zjj,z)*IMO(i,zjj,z)
1315                      **(rho_M2(i,z)+1)];
1316   
1317   B_M2(i,z)       = IMTO(i,z)/{SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*IMO(i,zj,z)
1318                     **(-rho_M2(i,z))]**(-1/rho_M2(i,z))};
1319   
1320  *==============================================================================
1321  *    Composite capital
1322  *==============================================================================
1323   rho_KD(j,z)     = (1-sigma_KD(j,z))/sigma_KD(j,z);
1324   
1325   beta_KD(k,j,z)$KDO(k,j,z)
1326                   = [RTIO(k,j,z)*KDO(k,j,z)**(1+rho_KD(j,z))]/
1327                     SUM[kj$KDO(kj,j,z),RTIO(kj,j,z)*KDO(kj,j,z)**(1+rho_KD(j,z))];
1328   B_KD(j,z)$KDCO(j,z)
1329                   = KDCO(j,z)/{SUM[k$KDO(k,j,z),beta_KD(k,j,z)*KDO(k,j,z)
1330                     **(-rho_KD(j,z))]**(-1/rho_KD(j,z))};
1331   
1332  *===============================================================================
1333  *   Composite E
1334  *===============================================================================
1335  *Leontief
1336   Share_Elec(j2,z) = DEO('18_ELEC',j2,z)/sum(ene,DEO(ene,j2,z));
1337   Share_nElec(ene3,j2,z) = DEO(ene3,j2,z)/sum(enee3,DEO(enee3,j2,z));
1338   Share_coalgas2(j2,z) = sum(ene5,DEO(ene5,j2,z))/sum(enee3,DEO(enee3,j2,z));
1339   Share_Oilpetrol2(j2,z) = sum(ene6,DEO(ene6,j2,z))/sum(enee3,DEO(enee3,j2,z));
1340   Share_coalgas(ene5,j2,z) = DEO(ene5,j2,z)/sum(enee5,DEO(enee5,j2,z));
1341   Share_Oilpetrol(ene6,j2,z) = DEO(ene6,j2,z)/sum(enee6,DEO(enee6,j2,z));
1342   
1343  *CES No Level
1344   rho_ENER(j,z)   = (1-sigma_ENER(j,z))/sigma_ENER(j,z);
1345   
1346   beta_ENER(ene,j,z)$DEO(ene,j,z)
1347                   = [PO4(ene,j,z)*DEO(ene,j,z)**(1+rho_ENER(j,z))]/
1348                     SUM[enee,PO4(enee,j,z)*DEO(enee,j,z)
1349                     **(1+rho_ENER(j,z))];
1350   
1351   B_ENER(j,z)$CEO(j,z)
1352                   = CEO(j,z)/{SUM[ene,beta_ENER(ene,j,z)*DEO(ene,j,z)
1353                     **(-rho_ENER(j,z))]**(-1/rho_ENER(j,z))};
1354   
1355   B_ENER_t(j,z,time) = B_ENER(j,z)*(1/AEEI_low(z,'2019'));
1356   
1357  *Level 5_1 (Coal/Gas)
1358   rho_ENER5_1(j2,z)   = (1-sigma_ENER5_1(j2,z))/sigma_ENER5_1(j2,z);
1359   
1360   beta_ENER5_1(ene5,j2,z)
1361                   = [PO4(ene5,j2,z)*DEO(ene5,j2,z)**(1+rho_ENER5_1(j2,z))]/
1362                     SUM[enee5,PO4(enee5,j2,z)*DEO(enee5,j2,z)
1363                     **(1+rho_ENER5_1(j2,z))];
1364   B_ENER5_1(j2,z)
1365                   = DEcoalgasO(j2,z)/{SUM[ene5,beta_ENER5_1(ene5,j2,z)*DEO(ene5,j2,z)
1366                     **(-rho_ENER5_1(j2,z))]**(-1/rho_ENER5_1(j2,z))};
1367   
1368  *Level 5_2 (oil/petrol)
1369   rho_ENER5_2(j2,z)   = (1-sigma_ENER5_2(j2,z))/sigma_ENER5_2(j2,z);
1370   
1371   beta_ENER5_2(ene6,j2,z)
1372                   = [PO4(ene6,j2,z)*DEO(ene6,j2,z)**(1+rho_ENER5_2(j2,z))]/
1373                     SUM[enee6,PO4(enee6,j2,z)*DEO(enee6,j2,z)
1374                     **(1+rho_ENER5_2(j2,z))];
1375   B_ENER5_2(j2,z)
1376                   = DEoilpetrolO(j2,z)/{SUM[ene6,beta_ENER5_2(ene6,j2,z)*DEO(ene6,j2,z)
1377                     **(-rho_ENER5_2(j2,z))]**(-1/rho_ENER5_2(j2,z))};
1378   
1379  *Level 4 (Coal-Gas/Oil-Petrol)
1380   rho_ENER4(j2,z)   = (1-sigma_ENER4(j2,z))/sigma_ENER4(j2,z);
1381   
1382   beta_ENER4(j2,z)
1383                   = PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)**(rho_ENER4(j2,z)+1)/
1384                    {PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)**(rho_ENER4(j2,z)+1)+
1385                     PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)**(rho_ENER4(j2,z)+1)};
1386   B_ENER4(j2,z)
1387                   = DEnelecO(j2,z)
1388                     /{[beta_ENER4(j2,z)*DEcoalgasO(j2,z)**(-rho_ENER4(j2,z))+
1389                     (1-beta_ENER4(j2,z))*DEoilpetrolO(j2,z)**(-rho_ENER4(j2,z))
1390                     ]**(-1/rho_ENER4(j2,z))};
1391   
1392  *Level 3 (Coal/Gas/Oil/Petrol)
1393   rho_ENER3(j2,z)   = (1-sigma_ENER3(j2,z))/sigma_ENER3(j2,z);
1394   
1395   beta_ENER3(ene3,j2,z)
1396                   = [PO4(ene3,j2,z)*DEO(ene3,j2,z)**(1+rho_ENER3(j2,z))]/
1397                     SUM[enee3,PO4(enee3,j2,z)*DEO(enee3,j2,z)
1398                     **(1+rho_ENER3(j2,z))];
1399   
1400   B_ENER3(j2,z)
1401                   = DEnelecO(j2,z)/{SUM[ene3,beta_ENER3(ene3,j2,z)*DEO(ene3,j2,z)
1402                     **(-rho_ENER3(j2,z))]**(-1/rho_ENER3(j2,z))};
1403   
1404  *Level 2 (Elec/Non Elec)
1405   rho_ENER2(j2,z)   = (1-sigma_ENER2(j2,z))/sigma_ENER2(j2,z);
1406   
1407   beta_ENER2(j2,z)
1408                   = PCEelecO(j2,z)*DEelecO(j2,z)**(rho_ENER2(j2,z)+1)/
1409                    {PCEelecO(j2,z)*DEelecO(j2,z)**(rho_ENER2(j2,z)+1)+
1410                     PCEnelecO(j2,z)*DEnelecO(j2,z)**(rho_ENER2(j2,z)+1)};
1411   B_ENER2(j2,z)
1412                   = CEO(j2,z)
1413                     /{[beta_ENER2(j2,z)*DEelecO(j2,z)**(-rho_ENER2(j2,z))+
1414                     (1-beta_ENER2(j2,z))*DEnelecO(j2,z)**(-rho_ENER2(j2,z))
1415                     ]**(-1/rho_ENER2(j2,z))};
1416   
1417  *==============================================================================
1418  *    4.6.3.5 Value added
1419  *==============================================================================
1420   rho_VA(j,z)     = (1-sigma_VA(j,z))/sigma_VA(j,z);
1421   
1422   beta_VA(j,z)$KDCO(j,z)
1423                   = WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)/
1424                    {WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)+
1425                     RCO(j,z)*KDCO(j,z)**(rho_VA(j,z)+1)};
1426   B_VA(j,z)$KDCO(j,z)
1427                   = VAO(j,z)
1428                     /{[beta_VA(j,z)*LDCO(j,z)**(-rho_VA(j,z))+
1429                     (1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
1430                     ]**(-1/rho_VA(j,z))};
1431   
1432   B_VA_t(j,z,time) = B_VA(j,z);
1433  * B_VA_t(j,z,time) = B_VA(j,z)*(1/AEEI_low(z,'2019'));
1434   
1435  *==============================================================================
1436  *    Composite KLE
1437  *==============================================================================
1438   KLEO(j,z)       = CEO(j,z) + VAO(j,z) ;
1439   
1440   PKLEO(j,z)      = [PCEO(j,z)*CEO(j,z)+PVAO(j,z)*VAO(j,z)]/KLEO(j,z);
1441   
1442   rho_KLE(j,z)    = (1-sigma_KLE(j,z))/sigma_KLE(j,z);
1443   
1444   beta_KLE(j,z)$KLEO(j,z)
1445                   = PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)/
1446                    {PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)+
1447                     PCEO(j,z)*CEO(j,z)**(rho_KLE(j,z)+1)};
1448   
1449   beta_KLE2(j,z)$KLEO(j,z)
1450                   = 1-beta_KLE(j,z);
1451   
1452   B_KLE(j,z)$KLEO(j,z)
1453                   = KLEO(j,z)
1454                     /{[beta_KLE(j,z)*VAO(j,z)**(-rho_KLE(j,z))+
1455                     (beta_KLE2(j,z))*CEO(j,z)**(-rho_KLE(j,z))
1456                     ]**(-1/rho_KLE(j,z))};
1457   
1458   beta_KLE2_t(j,z,time) = beta_KLE2(j,z)*AEEI_low(z,'2019');
1459   
1460  *==============================================================================
1461  *  Calibration of LES parameters
1462  *==============================================================================
1463  *   As the assigned values of income elasticities may not result in
1464  *   consumption shares that add up to 1, this first step
1465  *   adjusts the elasticities proportionally
1466   sigma_Y(i,z)    = sigma_Y(i,z)/{SUM[ij,sigma_Y(ij,z)*PCO(ij,z)*CO(ij,z)]
1467                     /CTHO(z)};
1468   gamma_LES(i,z)  = PCO(i,z)*CO(i,z)*sigma_Y(i,z)/CTHO(z);
1469   CMINO(i,z)      = CO(i,z)+gamma_LES(i,z)*CTHO(z)/{PCO(i,z)*frisch(z)};
1470   
1471  *==============================================================================
1472  *  Calibration of gross domestic products
1473  *==============================================================================
1474   GDP_BPO(z)      = SUM[j,PVAO(j,z)*VAO(j,z)]+TIPTO(z);
1475   GDP_MPO(z)      = GDP_BPO(z)+TPRCTSO(z);
1476  * GDP_IBO(z)      = SUM[(l,j),WO(l,z)*LDO(l,j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1477   GDP_IBO(z)      = SUM[(j),WO(z)*LDO(j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1478                     +TPRODNO(z)+TPRCTSO(z);
1479   GDP_FDO(z)      = SUM[i,PCO(i,z)*(CO(i,z)+CGO(i,z)+INVO(i,z))]
1480                    +eO(z)*SUM[(i,zj),PWXO(i,z,zj)*EXO(i,z,zj)]
1481                    +eO(z)*SUM[i,PWMGO(i)*MRGNO(i,z)]
1482                    -eO(z)*SUM[(i,zj),IMO(i,zj,z)*(PWMO(i,zj,z)
1483                    +SUM{ij,PWMGO(ij)*tmrg(ij,i,zj,z)})];
1484   GDP_BP_WO       = SUM[z,GDP_BPO(z)/eO(z)];
1485   
1486  *==============================================================================
1487  *  4.8 Calibration of real (volume) variables computed from price indices
1488  *==============================================================================
1489   CABXO(z)        = CABO(z)/[PIXGDP_WO*eO(z)];
1490   
1491  *------------------------------------------------------------------------------
1492  * Calculation of CAB index
1493  * If every region's CABX grows exogenously according to exogro, then the
1494  * worldwide sum of CABX's will not be zero. If, due to redundancy, the reference
1495  * region's CABX is left implicit, then it will not grow according to that
1496  * region's exogro (it follows that the solution will depend on the choice of
1497  * reference region). CABix is formed from exogro by inflating or deflating the
1498  * updating factors of positive (SURplus) and negative (DEFicit) CABX's in such
1499  * a way that their sum remains zero.
1500   
      Parameter CABXsur(z,time), CABXdef(z,time), bal(time), mu(time), CABix(z,time);
       CABXsur(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) gt 0];
       CABXdef(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) lt 0];
       Bal(time)       = sum(zj,CABXsur(zj,time))+sum(zj,CABXdef(zj,time));
       mu(time)        = sum(zj,CABXsur(zj,time))/
                           {sum(zj,CABXsur(zj,time))+sum(zj,abs[CABXdef(zj,time)])};
       CABXsur(z,time) = CABXsur(z,time)*{1-mu(time)*Bal(time)/sum(zj,CABXsur(zj,time))};
       CABXdef(z,time) = CABXdef(z,time)*{1-[1-mu(time)]*Bal(time)/sum(zj,CABXdef(zj,time))};
       CABix(z,time)   = [CABXsur(z,time)+CABXdef(z,time)]/CABXO(z);
1512  *------------------------------------------------------------------------------
1513   
1514   CTH_REALO(z)    = CTHO(z)/PIXCONO(z);
1515   G_REALO(z)      = GO(z)/PIXGVTO(z);
1516   GDP_BP_REALO(z) = GDP_BPO(z)/PIXGDPO(z);
1517   GDP_BP_W_REALO  = GDP_BP_WO/PIXGDP_WO;
1518   GDP_MP_REALO(z) = GDP_MPO(z)/PIXCONO(z);
1519   IT_REALO(z)     = ITO(z)/PIXINVO(z);
1520   
1521  *==============================================================================
1522  *  Parameters of the household savings function
1523  *==============================================================================
1524   sh1O(z)         = [SHO(z)+SGO(z)]/GDP_IBO(z);
1525   sh0O(z)         = SHO(z)-sh1O(z)*YDHO(z);
1526   
1527  *==============================================================================
1528  *  Re-calibration of indexed transfers and parameters
1529  *==============================================================================
1530   sh0O(z)         = sh0O(z)/PIXCONO(z)**eta;
1531   ttdh0O(z)       = ttdh0O(z)/PIXCONO(z)**eta;
