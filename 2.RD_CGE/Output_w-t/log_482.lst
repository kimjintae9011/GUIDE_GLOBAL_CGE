2618   
2619  *Coal
2620   Coal_DIO(p_coal,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_coal, z));
2621   Coal_DIO(p_coal,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_coal, z));
2622   Coal_DIO(p_coal,'03_OIL',z) = -1*sum((f_oil), WEB(f_oil, p_coal, z));
2623   Coal_DIO(p_coal,'04_GAS',z) = -1*sum((f_gas), WEB(f_gas, p_coal, z));
2624   Coal_DIO(p_coal,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_coal, z));
2625   Coal_DIO(p_coal,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_coal, z));
2626   Coal_DIO(p_coal,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_coal, z));
2627   Coal_DIO(p_coal,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_coal, z));
2628   Coal_DIO(p_coal,'09_PAPERPRO',z) = sum((f_paperpro), WEB(f_paperpro, p_coal, z));
2629   Coal_DIO(p_coal5,'10_PETROLCOAL',z) = -1*sum((f_petrolcoal), WEB(f_petrolcoal, p_coal5, z));
2630   Coal_DIO(p_coal,'11_CHEMICAL',z) = sum((f_chemical), WEB(f_chemical, p_coal, z));
2631   Coal_DIO(p_coal,'12_NONMET',z) = sum((f_nonmet), WEB(f_nonmet, p_coal, z));
2632   Coal_DIO(p_coal,'13_IRONSTL',z) = sum((f_ironstl), WEB(f_ironstl, p_coal, z))
2633   + sum(f_cokeoven, -1*TCoke_Share(f_cokeoven,p_coal,z)*WEB(f_cokeoven, 'p66_TOTAL', z))
2634   + sum(f_balstfur, -1*TBlast_Share(f_balstfur,p_coal,z)*WEB(f_balstfur, 'p66_TOTAL', z))
2635   + sum((f_Eblastcoke), -1*WEB(f_Eblastcoke, p_coal, z))
2636  ;
2637   
2638   Coal_DIO(p_coal,'14_NONFERR',z) = sum((f_nonferr), WEB(f_nonferr, p_coal, z));
2639   Coal_DIO(p_coal,'15_MACHINE',z) = sum((f_machine), WEB(f_machine, p_coal, z));
2640   Coal_DIO(p_coal,'16_TRANSEQ',z) = sum((f_transeq), WEB(f_transeq, p_coal, z));
2641   Coal_DIO(p_coal,'17_OTHERIND',z) = sum((f_otherind), WEB(f_otherind, p_coal, z));
2642   Coal_DIO(p_coal,'18_TnD',z) = 0 ;
2643   Coal_DIO(p_coal,'19_eNuclear',z) = 0 ;
2644   Coal_DIO(p_coal,'20_eCoal',z) = -1*sum((f_elec), WEB(f_elec, p_coal, z));
2645   Coal_DIO(p_coal,'19_eNuclear',z) = 0 ;
2646   Coal_DIO(p_coal,'21_eGas',z) = 0 ;
2647   Coal_DIO(p_coal,'22_eOil',z) = 0 ;
2648   Coal_DIO(p_coal,'23_eWind',z) = 0 ;
2649   Coal_DIO(p_coal,'24_eSolar',z) = 0 ;
2650   Coal_DIO(p_coal,'25_eHydro',z) = 0 ;
2651   Coal_DIO(p_coal,'26_eOther',z) = 0 ;
2652   Coal_DIO(p_coal,'27_CONSTRUC',z) = sum((f_construc), WEB(f_construc, p_coal, z));
2653   Coal_DIO(p_coal,'28_LTRP',z) = sum((f_roadrail), WEB(f_roadrail, p_coal, z));
2654   Coal_DIO(p_coal,'29_WTRP',z) = sum((f_domewater), WEB(f_domewater, p_coal, z));
2655   Coal_DIO(p_coal,'30_ATRP',z) = sum((f_domeair), WEB(f_domeair, p_coal, z));
2656   Coal_DIO(p_coal,'31_SER',z) = sum((f_ser), WEB(f_ser, p_coal, z));
2657   Coal_CO(p_coal,z) = sum((f_household), WEB(f_household, p_coal, z));
2658   
2659   Coal_Marine(p_coal,z)   = -1*sum((f_marine_bunker), WEB(f_marine_bunker, p_coal, z));
2660   Coal_Aviation(p_coal,z) = -1*sum((f_aviation_bunker), WEB(f_aviation_bunker, p_coal, z));
