2689   Gas_DIO(p_gas,'17_OTHERIND',z) = sum((f_otherind), WEB(f_otherind, p_gas, z));
2690   Gas_DIO(p_gas,'18_TnD',z) = 0 ;
2691   Gas_DIO(p_gas,'19_eNuclear',z) = 0 ;
2692   Gas_DIO(p_gas,'20_eCoal',z) = 0;
2693   Gas_DIO(p_gas,'19_eNuclear',z) = 0 ;
2694   Gas_DIO(p_gas,'21_eGas',z) = -1*sum((f_elec), WEB(f_elec, p_gas, z)) ;
2695   Gas_DIO(p_gas,'22_eOil',z) = 0 ;
2696   Gas_DIO(p_gas,'23_eWind',z) = 0 ;
2697   Gas_DIO(p_gas,'24_eSolar',z) = 0 ;
2698   Gas_DIO(p_gas,'25_eHydro',z) = 0 ;
2699   Gas_DIO(p_gas,'26_eOther',z) = 0 ;
