3461   TCTAX0(z)         = 0;
3462   PERMITO(j,z)      = sum(ene, CO2FACTOR(ene,j,z)*DEO(ene,j,z)) ;
3463   PERMIT_TOTALO(z)  = sum(j,PERMITO(j,z));
