3187  *Ratio
3188  Loop(j,
3189      NOilpR_DIO(p_oilproduct,j,z)$(NOilp_DIO(p_oilproduct,j,z) gt 0)
3190           = NOilp_DIO(p_oilproduct,j,z)/sum(p_oilproduct2, NOilp_DIO(p_oilproduct2,j,z));
3191       );
