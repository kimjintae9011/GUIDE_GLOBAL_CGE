3487  *==============================================================================
3488  *   Carbon tax recycling
3489  *==============================================================================
3490   TIWO_Share(j,z)    =   LDO(j,z)/LSO(z);
3491  * TIWO_Share(j,z)    =   PERMITO(j,z)/ PERMIT_TOTALO(z);
3492   TIKO_Share(k,j,z)   =  KDO(k,j,z)/KSO(k,z);
3493   TIPO_Share(j,z)     =  XSTO(j,z)/sum(jj,XSTO(jj,z));
