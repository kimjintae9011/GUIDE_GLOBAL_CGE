3866  *  5.3 Equations
3867  *==============================================================================
3868  *   5.3.1 Production
3869  *==============================================================================
3870   EQ1(j3,z,t)..     VA(j3,z,t) =e= v(j3,z)*XST(j3,z,t);
3871   
3872   EQ1_1(j2,z,t)..   KLE(j2,z,t) =e= v2(j2,z)*XST(j2,z,t);
3873   
3874   EQ2(j,z,t)..      CI(j,z,t) =e= io(j,z)*XST(j,z,t);
3875   
3876   EQ2_1(j3,z,t)..   CE(j3,z,t) =e= io2(j3,z)*XST(j3,z,t);
3877   
3878  * EQ3(j,z,t)..      VA(j,z,t) =e= A_VA(z,t)*B_VA(j,z)*{
3879   EQ3(j,z,t)..      VA(j,z,t) =e= A_VA(z,t)*B_VA_t(j,z,t)*{
3880                      [beta_VA(j,z)*LDC(j,z,t)**(-rho_VA(j,z))]$LDCO(j,z)
3881                     +[(1-beta_VA(j,z))*KDC(j,z,t)**(-rho_VA(j,z))]$KDCO(j,z)
3882                                                     }**(-1/rho_VA(j,z));
3883   
3884   EQ3_1(j2,z,t)..   KLE(j2,z,t) =e= B_KLE(j2,z)*{
3885                      [beta_KLE(j2,z)*VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
3886                     +[(1-beta_KLE(j2,z))*CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
3887                                                     }**(-1/rho_KLE(j2,z));
3888   
3889   EQ4_1(j2,z,t)$[VAO(j2,z) and CEO(j2,z)]..
3890                   VA(j2,z,t) =e= {[(1-beta_KLE2(j2,z))/(beta_KLE2(j2,z))]
3891                                *[PCE(j2,z,t)/PVA(j2,z,t)]}**sigma_KLE(j2,z)*CE(j2,z,t);
3892   
3893   EQ4(j,z,t)$[LDCO(j,z) and KDCO(j,z)]..
3894                   LDC(j,z,t) =e= {[beta_VA(j,z)/(1-beta_VA(j,z))]
3895                                *[RC(j,z,t)/WC(j,z,t)]}**sigma_VA(j,z)*KDC(j,z,t);
3896   
3897  * EQ5(j,z,t)$LDCO(j,z)..
3898  *                 LDC(j,z,t) =e= B_LD(j,z)*SUM[l$LDO(l,j,z),beta_LD(l,j,z)
3899  *                                *LD(l,j,z,t)**(-rho_LD(j,z))]**(-1/rho_LD(j,z));
3900   
3901   EQ5(j,z,t)$LDCO(j,z)..
3902                   LDC(j,z,t) =e= LD(j,z,t);
3903   
3904  * EQ6(l,j,z,t)$LDO(l,j,z)..
3905  *                 LD(l,j,z,t) =e= [beta_LD(l,j,z)*WC(j,z,t)/WTI(l,j,z,t)]
3906  *                               **sigma_LD(j,z)*B_LD(j,z)**(sigma_LD(j,z)-1)
3907  *                               *LDC(j,z,t);
3908   
3909   EQ7(j,z,t)$KDCO(j,z)..
3910                   KDC(j,z,t) =e= B_KD(j,z)*SUM[k$KDO(k,j,z),beta_KD(k,j,z)
3911                                  *KD(k,j,z,t)**(-rho_KD(j,z))]**(-1/rho_KD(j,z));
3912   
3913   EQ8(k,j,z,t)$KDO(k,j,z)..
3914                   KD(k,j,z,t) =e= [beta_KD(k,j,z)*RC(j,z,t)/RTI(k,j,z,t)]
3915                                   **sigma_KD(j,z)*B_KD(j,z)**(sigma_KD(j,z)-1)
3916                                   *KDC(j,z,t);
3917   
3918   EQ9(nene,j,z,t)..   DI(nene,j,z,t) =e= aij(nene,j,z)*CI(j,z,t) ;
3919   
3920   EQ9_1(ene,j3,z,t)..  DE(ene,j3,z,t)   =e= aij2(ene,j3,z)*CE(j3,z,t) ;
3921   
3922  *=============================Simple Nesting=========================================
3923  * EQ9_2(ene,j2,z,t)..  DE(ene,j2,z,t) =e= [beta_ENER_t(ene,j2,z,t)*PCE(j2,z,t)/((P4(ene,j2,z,t)+P4(ene,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j2,z,t)))]
3924  *                                   **sigma_ENER(j2,z)*B_ENER_t(j2,z,t)**(sigma_ENER(j2,z)-1)
3925  *                                   *CE(j2,z,t);
3926   
3927  *=============================Leontief===========================================
3928  * EQ9_2(j2,z,t)..       DEelec(j2,z,t)  =e= Share_Elec(j2,z)*CE(j2,z,t);
3929   
3930  * EQ9_3(j2,z,t)..       DEnelec(j2,z,t) =e= (1-Share_Elec(j2,z))*CE(j2,z,t);
3931   
3932  * EQ9_4(ene3,j2,z,t)..  DE(ene3,j2,z,t) =e= Share_nElec(ene3,j2,z)*DEnelec(j2,z,t);
3933   
3934  * EQ9_5(ene2,j2,z,t)..  DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
3935   
3936  *=============================Level 1, 2=======================================
3937  * EQ9_2(j2,z,t)..       CE(j2,z,t)  =e= B_ENER2(j2,z)*{[(beta_ENER2(j2,z))*DEelec(j2,z,t)**(-rho_ENER2(j2,z))]
3938  *                                                     +[(1-beta_ENER2(j2,z))*DEnelec(j2,z,t)**(-rho_ENER2(j2,z))]
3939  *                                                   }**(-1/rho_ENER2(j2,z));
3940   
3941  * EQ9_3(j2,z,t)..       DEelec(j2,z,t) =e= {[(beta_ENER2(j2,z))/(1-beta_ENER2(j2,z))]
3942  *                                        *[PCEnelec(j2,z,t)/PCEelec(j2,z,t)]}**sigma_ENER2(j2,z)*DEnelec(j2,z,t);
3943   
3944  * EQ9_4(ene3,j2,z,t)..  DE(ene3,j2,z,t) =e= [beta_ENER3(ene3,j2,z)*PCEnelec(j2,z,t)/P4(ene3,j2,z,t)]
3945  *                                            **sigma_ENER3(j2,z)*B_ENER3(j2,z)**(sigma_ENER3(j2,z)-1)
3946  *                                            *DEnelec(j2,z,t);
3947   
3948  * EQ9_5(ene2,j2,z,t)..  DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
3949   
3950  *=============================Level 1, 2, 3 (Leonteif) =======================================
3951  * EQ9_2(j2,z,t)..        DEelec(j2,z,t)  =e= Share_Elec(j2,z)*CE(j2,z,t);
3952   
3953  * EQ9_3(j2,z,t)..        DEnelec(j2,z,t) =e= (1-Share_Elec(j2,z))*CE(j2,z,t);
3954   
3955  * EQ9_4(j2,z,t)..        DEcoalgas(j2,z,t) =e= Share_coalgas2(j2,z)*DEnelec(j2,z,t);
3956   
3957  * EQ9_5(j2,z,t)..        DEoilpetrol(j2,z,t) =e= (1-Share_coalgas2(j2,z))*DEnelec(j2,z,t);
3958   
3959  * EQ9_6(ene2,j2,z,t)..   DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
3960   
3961  * EQ9_7(ene5,j2,z,t)..   DE(ene5,j2,z,t) =e= Share_coalgas(ene5,j2,z)*DEcoalgas(j2,z,t);
3962   
3963  * EQ9_8(ene6,j2,z,t)..   DE(ene6,j2,z,t) =e= Share_oilpetrol(ene6,j2,z)*DEoilpetrol(j2,z,t);
3964   
3965  *=============================Level 1, 2, 3 (CES) =======================================
3966   EQ9_2(j2,z,t)..        CE(j2,z,t)  =e= B_ENER2(j2,z)*{[(beta_ENER2(j2,z))*DEelec(j2,z,t)**(-rho_ENER2(j2,z))]
3967                                             +[(1-beta_ENER2(j2,z))*DEnelec(j2,z,t)**(-rho_ENER2(j2,z))]
3968                                              }**(-1/rho_ENER2(j2,z));
3969   
3970   EQ9_3(j2,z,t)..        DEnelec(j2,z,t) =e= {[(1-beta_ENER2(j2,z))/(beta_ENER2(j2,z))]
3971                                          *[PCEelec(j2,z,t)/PCEnelec(j2,z,t)]}**sigma_ENER2(j2,z)*DEelec(j2,z,t);
3972   
3973   EQ9_4(j2,z,t)..        DEnelec(j2,z,t) =e= B_ENER4(j2,z)*{[(beta_ENER4(j2,z))*DEcoalgas(j2,z,t)**(-rho_ENER4(j2,z))]
3974                                             +[(1-beta_ENER4(j2,z))*DEoilpetrol(j2,z,t)**(-rho_ENER4(j2,z))]
3975                                              }**(-1/rho_ENER4(j2,z));
3976   
3977   EQ9_5(j2,z,t)..        DEoilpetrol(j2,z,t) =e= {[(1-beta_ENER4(j2,z))/(beta_ENER4(j2,z))]
3978                                         *[PCEcoalgas(j2,z,t)/PCEoilpetrol(j2,z,t)]}**sigma_ENER4(j2,z)*DEcoalgas(j2,z,t);
3979   
3980   EQ9_6(ene2,j2,z,t)..   DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
3981   
3982   EQ9_7(ene5,j2,z,t)..   DE(ene5,j2,z,t) =e= [beta_ENER5_1(ene5,j2,z)*PCEcoalgas(j2,z,t)/(P4(ene5,j2,z,t)+P4(ene5,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene5,j2,z,t))]
3983                                              **sigma_ENER5_1(j2,z)*B_ENER5_1(j2,z)**(sigma_ENER5_1(j2,z)-1)
3984                                              *DEcoalgas(j2,z,t);
3985   
3986   EQ9_8(ene6,j2,z,t)..   DE(ene6,j2,z,t) =e= [beta_ENER5_2(ene6,j2,z)*PCEoilpetrol(j2,z,t)/(P4(ene6,j2,z,t)+P4(ene6,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene6,j2,z,t))]
3987                                              **sigma_ENER5_2(j2,z)*B_ENER5_2(j2,z)**(sigma_ENER5_2(j2,z)-1)
3988                                              *DEoilpetrol(j2,z,t);
3989   
3990  *==============================================================================
3991  *   5.3.2 Income and savings
3992  *==============================================================================
3993  *    5.3.2.1 Households
3994  *==============================================================================
3995   EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t)+SUM(i3,MARKUP(i3,z,t));
3996  * EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t)+SUM(i3,MARKUP(i3,z,t))+TCTAX(z,t);
3997   
3998   EQ11(z,t)..       YHL(z,t) =e= SUM[(j)$LDO(j,z),W(z,t)*LD(j,z,t)];
3999   
4000   EQ12(z,t)..       YHK(z,t) =e= SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*KD(k,j,z,t)];
4001   
4002   EQ13(z,t)..       YDH(z,t) =e= YH(z,t)-TDH(z,t);
4003   
4004   EQ14(z,t)..       CTH(z,t) =e= YDH(z,t)-SH(z,t);
4005   
4006   EQ15(z,t)..       SH(z,t) =e= PIXCON(z,t)**eta*sh0(z,t)+sh1(z,t)*YDH(z,t);
4007   
4008  *==============================================================================
4009  *    5.3.2.2 Government
4010  *==============================================================================
4011  * EQ16(z,t)..       YG(z,t) =e= TDH(z,t)+TPRODN(z,t)+TPRCTS(z,t)+TCTAX(z,t);
4012   EQ16(z,t)..       YG(z,t) =e= TDH(z,t)+TPRODN(z,t)+TPRCTS(z,t);
4013   
4014   EQ16_1(z,t)..     TCTAX(z,t) =e= sum((ene,j), PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t));
4015   
4016   EQ17(z,t)..       TPRODN(z,t) =e= TIWT(z,t)+TIKT(z,t)+TIPT(z,t);
4017   
4018   EQ18(z,t)..       TIWT(z,t) =e= SUM[(j)$LDO(j,z),TIW(j,z,t)];
4019   
4020   EQ19(z,t)..       TIKT(z,t) =e= SUM[(k,j)$KDO(k,j,z),TIK(k,j,z,t)];
4021   
4022   EQ20(z,t)..       TIPT(z,t) =e= SUM[j,TIP(j,z,t)];
4023   
4024   EQ21(z,t)..       TPRCTS(z,t) =e= TICT(z,t)+TIMT(z,t)+TIXT(z,t);
4025   
4026   EQ22(z,t)..       TICT(z,t) =e= SUM[i,TIC(i,z,t)];
4027   
4028   EQ23(z,t)..       TIMT(z,t) =e= SUM[(i,zj)$IMO(i,zj,z),TIM(i,zj,z,t)];
4029   
4030   EQ24(z,t)..       TIXT(z,t) =e= SUM[(i,zj)$EXO(i,z,zj),TIX(i,z,zj,t)];
4031   
4032   EQ25(z,t)..       TDH(z,t) =e= PIXCON(z,t)**eta*ttdh0(z,t)+ttdh1(z,t)*YH(z,t);
4033   
4034   EQ26(j,z,t)$LDO(j,z)..
4035                   TIW(j,z,t) =e= ttiw(j,z,t)*W(z,t)*LD(j,z,t);
4036   
4037   EQ27(k,j,z,t)$KDO(k,j,z)..
4038                   TIK(k,j,z,t) =e= ttik(k,j,z,t)*R(k,j,z,t)*KD(k,j,z,t);
4039   
4040   EQ28(j,z,t)..     TIP(j,z,t) =e= ttip(j,z,t)*PP(j,z,t)*XST(j,z,t);
4041   
4042   EQ29(i,z,t)..     TIC(i,z,t) =e= ttic(i,z,t)*{[PL(i,z,t)*DD(i,z,t)]$DDO(i,z)
4043                   +[SUM[zj$IMO(i,zj,z),(1+ttim(i,zj,z,t))*IM(i,zj,z,t)*e(z,t)
4044                    *(PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z)))]]};
4045   
4046   EQ30(i,zj,z,t)$IMO(i,zj,z)..
4047                   TIM(i,zj,z,t) =e= ttim(i,zj,z,t)*IM(i,zj,z,t)*e(z,t)*
4048                                     (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
4049                                     *tmrg(ij,i,zj,z)]);
4050   
4051   EQ31(i,z,zj,t)$EXO(i,z,zj)..
4052                   TIX(i,z,zj,t) =e= ttix(i,z,zj,t)*PE(i,z,zj,t)*EX(i,z,zj,t);
4053   
4054   EQ32(z,t)..       SG(z,t) =e= YG(z,t)-G(z,t);
4055   
4056  *==============================================================================
4057  *    5.3.2.4 Rest of the world
4058  *==============================================================================
4059   EQ33(z,t)..       YROW(z,t) =e= e(z,t)*SUM{(i,zj)$IMO(i,zj,z),IM(i,zj,z,t)*
4060                             [PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z))]};
4061   
4062   EQ34(z,t)..       SROW(z,t) =e= YROW(z,t)-e(z,t)*SUM[(i,zj)$EXO(i,z,zj),
4063                                 EX(i,z,zj,t)*PWX(i,z,zj,t)]-e(z,t)
4064                                 *SUM[i$MRGNO(i,z),MRGN(i,z,t)*PWMG(i,t)];
4065   
4066   EQ35(z,t)..       SROW(z,t) =e= -CAB(z,t);
4067   
4068  *==============================================================================
4069  *   5.3.3 Demand
4070  *==============================================================================
4071   EQ36(i,z,t)..     PC(i,z,t)*C(i,z,t) =e= PC(i,z,t)*CMIN(i,z,t)+gamma_LES(i,z)
4072                                   *{CTH(z,t)-SUM[ij,PC(ij,z,t)*CMIN(ij,z,t)]};
4073   
4074   EQ37(i,z,t)..     PC(i,z,t)*INV(i,z,t) =e= gamma_INV(i,z)*IT(z,t);
4075   
4076   EQ38(i,z,t)..     PC(i,z,t)*CG(i,z,t) =e= gamma_GVT(i,z)*G(z,t);
4077   
4078   EQ39(nene,z,t)..    DIT(nene,z,t) =e= SUM[j,DI(nene,j,z,t)];
4079   
4080   EQ39_1(ene1,z,t)..  DIT(ene1,z,t) =e= SUM[j,DE(ene1,j,z,t)];
4081   
4082   EQ39_2(ene2,z,t)..  DIT(ene2,z,t) =e= SUM[j,DE(ene2,j,z,t)];
4083   
4084  *==============================================================================
4085  *   5.3.4 International trade
4086  *==============================================================================
       EQB_1(i,z)..    XS_I(i,z) =e= B_X3(i,z)*SUM[j$XSO(j,i,z),beta_X3(j,i,z)
                                      *XS(j,i,z)**(-rho_X3(i,z))]**(-1/rho_X3(i,z));
       
       EQB_2(j,i,z)${DSO(j,i,z) and [DSO(j,i,z) ne DSO_I(i,z)]}..
                       XS(j,i,z) =e= XS_I(i,z)/B_X3(i,z)**(1-sigma_X3(i,z))*
                                     [beta_X3(j,i,z)*PI(i,z)/P2(j,i,z)]
                                     **sigma_X3(i,z);
       
       EQB_3(j,i,z)${DSO(j,i,z)}..   P2(j,i,z) =e= PT(j,z);
       
       EQB_4(j,i,z)$DSO(j,i,z)..
                       P2(j,i,z)*XS(j,i,z) =e= [PET(i,z)*EXTT(j,i,z)]$EXTTO(j,i,z)
                                              +[e(z)*MRGN(i,z)*PWMG(i)]$MRGNO(i,z)
                                              +[PL(i,z)*DS(j,i,z)]$DSO(j,i,z);
       
       EQB_5(j,i,z)$DSO(j,i,z)..  EXTT(j,i,z)  =e= theta2(j,i,z)*EXT(i,z);
4105   
4106  *[Top Nest - Leontief function]
4107   EQA_1(z,t)..  XS('18_TnD','18_ELEC',z,t) =e= TnDShare(z)*XS_I('18_ELEC',z,t);
4108   EQA_2(z,t)..  XS_I('18_ELEC',z,t) =e= XS('18_TnD','18_ELEC',z,t) + POWERQ(z,t);
4109   
4110   
4111  *[Second Nest - CES function]
4112  * EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
4113  *                                *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
4114   EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
4115                                  *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
4116   
4117  * EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
4118  *                               [beta_X4(power,z)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
4119  *                               **sigma_X4(z);
4120   
4121   EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
4122                                 [beta_X4(power,z)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
4123                                 **sigma_X4(z);
4124   
4125  * exclude electiricity
4126   EQB_1(i2,z,t)..    XS_I(i2,z,t) =e= B_X3(i2,z)*SUM[j$XSO(j,i2,z),beta_X3(j,i2,z)
4127                                  *XS(j,i2,z,t)**(-rho_X3(i2,z))]**(-1/rho_X3(i2,z));
4128   
4129   
4130   EQB_3(j,i,z,t)${DSO(j,i,z)}..   P2(j,i,z,t) =e= PT(j,z,t);
4131   
4132   EQB_4(j,i,z,t)$DSO(j,i,z)..
4133                   P2(j,i,z,t)*XS(j,i,z,t) =e= [PET(i,z,t)*EXTT(j,i,z,t)]$EXTTO(j,i,z)
4134                                          +[e(z,t)*MRGN(i,z,t)*PWMG(i,t)]$MRGNO(i,z)
4135                                          +[PL(i,z,t)*DS(j,i,z,t)]$DSO(j,i,z);
4136   
4137   EQB_5(j,i,z,t)$DSO(j,i,z)..  EXTT(j,i,z,t)  =e= theta2(j,i,z)*EXT(i,z,t);
4138   
4139   EQ40_3(i,z,t)..   DS_I(i,z,t) =e= sum(j,DS(j,i,z,t)$DSO(j,i,z));
4140   
4141   EQ40_4(j,z,t)..   XST(j,z,t)  =e= sum(i,XS(j,i,z,t)$XSO(j,i,z));
4142   
4143   EQ40_5(i,z,t)..   XS_I(i,z,t) =e= B_X1(i,z)*{
4144                   [beta_EX_X1(i,z)*EXT(i,z,t)**rho_X1(i,z)]$EXTO(i,z)
4145                  +[beta_D_X1(i,z)*DS_I(i,z,t)**rho_X1(i,z)]$DSO_I(i,z)
4146                  +[(1-beta_EX_X1(i,z)-beta_D_X1(i,z))*MRGN(i,z,t)**rho_X1(i,z)]$MRGNO(i,z)
4147                                            }**(1/rho_X1(i,z));
4148   
4149   EQ41(i,z,t)$[EXTO(i,z) and DSO_I(i,z)]..
4150                   EXT(i,z,t) =e= {[beta_D_X1(i,z)/beta_EX_X1(i,z)]*[PET(i,z,t)/PL(i,z,t)]}
4151                                **sigma_X1(i,z)*DS_I(i,z,t);
4152   
4153   EQ42(i,z,t)$[MRGNO(i,z) and DSO_I(i,z)]..
4154                   MRGN(i,z,t) =e= {[beta_D_X1(i,z)/(1-beta_EX_X1(i,z)
4155                                   -beta_D_X1(i,z))]*[e(z,t)*PWMG(i,t)/PL(i,z,t)]}
4156                                   **sigma_X1(i,z)*DS_I(i,z,t);
4157   
4158   EQ43(i,z,t)$EXTO(i,z)..
4159                   EXT(i,z,t) =e= B_X2(i,z)*SUM[zj$EXO(i,z,zj),beta_X2(i,z,zj)
4160                                  *EX(i,z,zj,t)**rho_X2(i,z)]**(1/rho_X2(i,z));
4161   
4162   EQ44(i,z,zj,t)$EXO(i,z,zj)..
4163                   EX(i,z,zj,t) =e= EXT(i,z,t)/B_X2(i,z)**(1+sigma_X2(i,z))*
4164                                    [PE(i,z,zj,t)/(beta_X2(i,z,zj)*PET(i,z,t))]
4165                                    **sigma_X2(i,z);
4166   
4167   EQ45(i,z,t)..     Q(i,z,t) =e= B_M1(i,z)*{
4168                      [beta_M1(i,z)*IMT(i,z,t)**(-rho_M1(i,z))]$IMTO(i,z)
4169                     +[(1-beta_M1(i,z))*DD(i,z,t)**(-rho_M1(i,z))]$DDO(i,z)
4170                                          }**(-1/rho_M1(i,z));
4171   
4172   EQ46(i,z,t)$[IMTO(i,z) and DDO(i,z)]..
4173                   IMT(i,z,t) =e= {[beta_M1(i,z)/(1-beta_M1(i,z))]*[PD(i,z,t)
4174                                  /PMT(i,z,t)]}**sigma_m1(i,z)*DD(i,z,t);
4175   
4176   EQ47(i,z,t)$IMTO(i,z)..
4177                   IMT(i,z,t) =e= B_M2(i,z)*SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*
4178                                  IM(i,zj,z,t)**(-rho_M2(i,z))]**(-1/rho_M2(i,z));
4179   
4180   EQ48(i,zj,z,t)$IMO(i,zj,z)..
4181                   IM(i,zj,z,t) =e= IMT(i,z,t)/B_M2(i,z)**(1-sigma_M2(i,z))*
4182                                    [beta_M2(i,zj,z)*PMT(i,z,t)/PM(i,zj,z,t)]
4183                                    **sigma_M2(i,z);
4184   
4185  *==============================================================================
4186  *   5.3.5 Prices
4187  *==============================================================================
4188   EQ49(j2,z,t)..     PP(j2,z,t)*XST(j2,z,t) =e= PKLE(j2,z,t)*KLE(j2,z,t)+PCI(j2,z,t)*CI(j2,z,t);
4189   
4190   EQ49_1(j3,z,t)..   PP(j3,z,t)*XST(j3,z,t) =e= PVA(j3,z,t)*VA(j3,z,t)+PCI(j3,z,t)*CI(j3,z,t)+PCE(j3,z,t)*CE(j3,z,t);
4191   
4192   EQ50(j,z,t)..      PT(j,z,t) =e= (1+ttip(j,z,t))*PP(j,z,t);
4193   
4194   EQ51(j,z,t)..      PCI(j,z,t)*CI(j,z,t) =e= SUM[nene,PC(nene,z,t)*DI(nene,j,z,t)];
4195   
4196  *Simple Nesting
4197  * EQ51_1(j,z,t)..    PCE(j,z,t)*CE(j,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j,z,t) + PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t)];
4198   
4199  *============================== Level 1-3 ========================================
4200  * EQ51_1(j2,z,t)..   PCE(j2,z,t)*CE(j2,z,t) =e= [PCEelec(j2,z,t)*DEelec(j2,z,t)+PCEnelec(j2,z,t)*DEnelec(j2,z,t)];
4201   
4202  * EQ51_12(j3,z,t)..  PCE(j3,z,t)*CE(j3,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j3,z,t)+PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j3,z,t)*DE(ene,j3,z,t)];
4203   
4204  * EQ51_2(j2,z,t)..   PCEelec(j2,z,t)*DEelec(j2,z,t) =e= PC("18_ELEC",z,t)*DE("18_ELEC",j2,z,t);
4205   
4206  * EQ51_3(j2,z,t)..   PCEnelec(j2,z,t)*DEnelec(j2,z,t) =e= SUM[ene3,PC(ene3,z,t)*DE(ene3,j2,z,t)+PC(ene3,z,t)*CTAX(z,t)*CO2FACTOR2(ene3,j2,z,t)*DE(ene3,j2,z,t)];
4207  *================================= Level 1-5 ======================================
4208   EQ51_2(j3,z,t)..   PCE(j3,z,t)*CE(j3,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j3,z,t)+PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j3,z,t)*DE(ene,j3,z,t)];
4209   
4210   EQ51_1(j2,z,t)..   PCE(j2,z,t)*CE(j2,z,t) =e= [PCEelec(j2,z,t)*DEelec(j2,z,t)+PCEnelec(j2,z,t)*DEnelec(j2,z,t)];
4211   
4212   EQ51_3(j2,z,t)..   PCEelec(j2,z,t)*DEelec(j2,z,t) =e= PC("18_ELEC",z,t)*DE("18_ELEC",j2,z,t);
4213   
4214   EQ51_4(j2,z,t)..   PCEnelec(j2,z,t)*DEnelec(j2,z,t) =e= [PCEcoalgas(j2,z,t)*DEcoalgas(j2,z,t)+PCEoilpetrol(j2,z,t)*DEoilpetrol(j2,z,t)];
4215   
4216   EQ51_5(j2,z,t)..   PCEcoalgas(j2,z,t)*DEcoalgas(j2,z,t) =e= [PC("02_COAL",z,t)*DE("02_COAL",j2,z,t)+PC("02_COAL",z,t)*CTAX(z,t)*CO2FACTOR2("02_COAL",j2,z,t)*DE("02_COAL",j2,z,t)
4217                      +PC("04_GAS",z,t)*DE("04_GAS",j2,z,t)+PC("04_GAS",z,t)*CTAX(z,t)*CO2FACTOR2("04_GAS",j2,z,t)*DE("04_GAS",j2,z,t)];
4218   
4219   EQ51_6(j2,z,t)..   PCEoilpetrol(j2,z,t)*DEoilpetrol(j2,z,t) =e= [PC("03_OIL",z,t)*DE("03_OIL",j2,z,t)+PC("03_OIL",z,t)*CTAX(z,t)*CO2FACTOR2("03_OIL",j2,z,t)*DE("03_OIL",j2,z,t)
4220                      +PC("10_PETROLCOAL",z,t)*DE("10_PETROLCOAL",j2,z,t)+PC("10_PETROLCOAL",z,t)*CTAX(z,t)*CO2FACTOR2("10_PETROLCOAL",j2,z,t)*DE("10_PETROLCOAL",j2,z,t)];
4221  *==================================================================================
4222   
4223   EQ52(j,z,t)..      PVA(j,z,t)*VA(j,z,t) =e= [WC(j,z,t)*LDC(j,z,t)]$LDCO(j,z)
4224                                       +[RC(j,z,t)*KDC(j,z,t)]$KDCO(j,z);
4225   
4226   EQ52_1(j2,z,t)..   PKLE(j2,z,t)*KLE(j2,z,t) =e= [PVA(j2,z,t)*VA(j2,z,t)]$VAO(j2,z)
4227                                         +[PCE(j2,z,t)*CE(j2,z,t)]$CEO(j2,z);
4228   
4229  * Given equations 5 and 6, equation 53 is redundant
4230  * EQ53(j,z)..     WC(j,z)*LDC(j,z) =e= SUM[l$LDO(l,j,z),WTI(l,j,z)*LD(l,j,z)];
4231   EQ53(j,z,t)..     WC(j,z,t)*LDC(j,z,t) =e= WTI(j,z,t)*LD(j,z,t);
4232   
4233   EQ54(j,z,t)$LDO(j,z)..
4234                   WTI(j,z,t) =e= W(z,t)*(1+ttiw(j,z,t));
4235   
4236   EQ54_1(ene,j2,z,t)$DEO(ene,j2,z)..
4237                   P4(ene,j2,z,t) =e= PC(ene,z,t);
4238   
4239  * Given equations 7 and 8, equation 55 is redundant
4240  * EQ55(j,z)$(kmob and KDCO(j,z))..
4241  *                 RC(j,z)*KDC(j,z) =e= SUM[k$KDO(k,j,z),RTI(k,j,z)*KD(k,j,z)];
4242   
4243   EQ56(k,j,z,t)$KDO(k,j,z)..
4244                   RTI(k,j,z,t) =e= R(k,j,z,t)*(1+ttik(k,j,z,t));
4245   
4246  * EQ57(k,j,z,t)$(kmob and KDO(k,j,z))..
4247  *                 R(k,j,z,t) =e= RK(k,z,t);
4248   
4249   EQ58(i,z,t)..     P(i,z,t)*XS_I(i,z,t) =e= [PL(i,z,t)*DS_I(i,z,t)]$DSO_I(i,z)
4250                                       +[PET(i,z,t)*EXT(i,z,t)]$EXTO(i,z)
4251                                       +[e(z,t)*PWMG(i,t)*MRGN(i,z,t)]$MRGNO(i,z);
4252   
4253  * Given equations 43 and 44, equation 59 is redundant
4254  * EQ59(i,z)$EXTO(i,z)..
4255  *                 PET(i,z)*EXT(i,z) =e= SUM[zj$EXO(i,z,zj),
4256  *                                           PE(i,z,zj)*EX(i,z,zj);
4257   
4258   EQ60(i,z,zj,t)$EXO(i,z,zj)..
4259                   PE(i,z,zj,t)*(1+ttix(i,z,zj,t)) =e= e(z,t)*PWX(i,z,zj,t);
4260   
4261   EQ61(i,z,t)$DDO(i,z)..
4262                   PD(i,z,t) =e= (1+ttic(i,z,t))*PL(i,z,t);
4263   
4264   EQ62(i,zj,z,t)$IMO(i,zj,z)..
4265                   PM(i,zj,z,t) =e= (1+ttic(i,z,t))*(1+ttim(i,zj,z,t))*e(z,t)*
4266                                    (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
4267                                    *tmrg(ij,i,zj,z)]);
4268   
4269  * Given equations 47 and 48, equation 63 is redundant
4270  * EQ63(i,z)$IMTO(i,z)..
4271  *                 PMT(i,z)*IMT(i,z) =e= SUM[zj$IMO(i,zj,z),
4272  *                                           PM(i,zj,z)*IM(i,zj,z);
4273   
4274   EQ64(i,z,t)..     PC(i,z,t)*Q(i,z,t) =e= [PD(i,z,t)*DD(i,z,t)]$DDO(i,z)+
4275                                      [PMT(i,z,t)*IMT(i,z,t)]$IMTO(i,z);
4276   
4277  * EQ65(z,t)..       PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
4278  *                               /gamma_INV(i,z))**gamma_INV(i,z)];
4279   
4280   EQ66(z,t)..       PIXGDP(z,t) =e=
4281                   {SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)]
4282                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
4283                   *SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)]
4284                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)]}**0.5;
4285   
4286   EQ67(t)..         PIXGDP_W(t) =e=
4287                   {SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)/e(z,t)]
4288                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
4289                   *SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)/e(z,t)]
4290                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)/eO(z)]}**0.5;
4291   
4292   EQ68(z,t)..       PIXCON(z,t) =e= SUM[i,PC(i,z,t)*CO(i,z)]/SUM[i,PCO(i,z)*CO(i,z)];
4293   
4294   EQ69(z,t)..       PIXINV(z,t) =e= PROD[i$gamma_INV(i,z),(PC(i,z,t)/PCO(i,z))
4295                                   **gamma_INV(i,z)];
4296   
4297   EQ70(z,t)..       PIXGVT(z,t) =e= PROD[i$gamma_GVT(i,z),(PC(i,z,t)/PCO(i,z))
4298                                   **gamma_GVT(i,z)];
4299   
4300  *==============================================================================
4301  *   5.3.6 Equilibrium
4302  *==============================================================================
4303   EQ71(i1,z,t)..    Q(i1,z,t) =e= C(i1,z,t)+CG(i1,z,t)+INV(i1,z,t)+DIT(i1,z,t);
4304   
4305   EQ71_2(i3,z,t)..  Q(i3,z,t) =e= C_Conventional(i3,z,t);
4306   
4307   EQ72(z,t)..     LS(z,t) =e= SUM[j$LDO(j,z),LD(j,z,t)];
4308   
4309   EQ73(k,z,t)$KSO(k,z)..
4310                         KS(k,z,t) =e= SUM[j$KDO(k,j,z),KD(k,j,z,t)];
4311   
4312   EQ74(z,t)..       IT(z,t) =e= SH(z,t)+SG(z,t)-CAB(z,t);
4313   
4314   EQ75(z,t)..       DEP(z,t) =e= PK(z,t)*delta(z)*SUM[k$KSO(k,z),KS(k,z,t)];
4315   
4316   EQ76(i,z,t)$DDO(i,z)..
4317                     SUM[j$DSO(j,i,z),DS(j,i,z,t)] =e= DD(i,z,t);
4318   
4319   EQ77(i,z,zj,t)$EXO(i,z,zj)..
4320                     EX(i,z,zj,t) =e= IM(i,z,zj,t);
4321   
4322   EQ78(i,z,zj,t)$EXO(i,z,zj)..
4323                     PWX(i,z,zj,t) =e= PWM(i,z,zj,t);
4324   
4325   EQ79(i,t)..       SUM[z$MRGNO(i,z),MRGN(i,z,t)] =e= SUM[(z,zj,ij)$IMO(ij,zj,z),
4326                                                   tmrg(i,ij,zj,z)*IM(ij,zj,z,t)];
4327   
4328  * Given equations 33, 34 and 77, equation 80 is redundant
4329  * EQ80..          SUM[z,SROW(z)/e(z)] =e= 0;
4330   
4331  *==============================================================================
4332  *   5.3.7 Gross domestic product
4333  *==============================================================================
4334   EQ81(z,t)..       GDP_BP(z,t) =e= SUM[j,PVA(j,z,t)*VA(j,z,t)]+TIPT(z,t);
4335   
4336   EQ82(z,t)..       GDP_MP(z,t) =e= GDP_BP(z,t)+TPRCTS(z,t);
4337   
4338   EQ83(z,t)..       GDP_IB(z,t) =e= SUM[(j)$LDO(j,z),W(z,t)*LD(j,z,t)]
4339                                +SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*KD(k,j,z,t)]
4340                                +TPRCTS(z,t)+TPRODN(z,t);
4341   
4342   EQ84(z,t)..       GDP_FD(z,t) =e=
4343                   SUM[i,PC(i,z,t)*(C(i,z,t)+CG(i,z,t)+INV(i,z,t))]
4344                  +SUM[(i,zj)$EXO(i,z,zj),e(z,t)*PWX(i,z,zj,t)*EX(i,z,zj,t)]
4345                  +SUM[i$MRGNO(i,z),e(z,t)*PWMG(i,t)*MRGN(i,z,t)]
4346                  -SUM[(i,zj)$IMO(i,zj,z),e(z,t)*IM(i,zj,z,t)
4347                      *(PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)*tmrg(ij,i,zj,z)])]
4348                  -TCTAX(z,t) ;
4349   
4350   EQ85(t)..          GDP_BP_W(t) =e= SUM[z,GDP_BP(z,t)/e(z,t)];
4351   
4352  *==============================================================================
4353  *  5.3.8 Real (volume) variables computed from price indices
4354  *==============================================================================
4355   EQ86(z,t)..       CTH_REAL(z,t) =e= CTH(z,t)/PIXCON(z,t);
4356   
4357   EQ87(z,t)..       G_REAL(z,t) =e= G(z,t)/PIXGVT(z,t);
4358   
4359   EQ88(z,t)..       GDP_BP_REAL(z,t) =e= GDP_BP(z,t)/PIXGDP(z,t);
4360   
4361   EQ89(t)..         GDP_BP_W_REAL(t) =e= GDP_BP_W(t)/PIXGDP_W(t);
4362   
4363   EQ90(z,t)..       GDP_MP_REAL(z,t) =e= GDP_MP(z,t)/PIXCON(z,t);
4364   
4365   EQ91(z,t)..       IT_REAL(z,t) =e= IT(z,t)/PIXINV(z,t);
4366   
4367   EQ92(z,t)..       CABX(z,t) =e= CAB(z,t)/[PIXGDP_W(t)*e(z,t)];
4368   
4369  *==============================================================================
4370  *   5.3.8 Dynamic equations
4371  *==============================================================================
4372   EQ94(z,t)..     IT(z,t) =e= PK(z,t)*SUM[(k,j)$KDO(k,j,z),IND(k,j,z,t)];
4373   
4374   EQ95(z,t)..     PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
4375                                 /gamma_INV(i,z))**gamma_INV(i,z)];
4376   
4377   EQ96(k,bus,z,t)$KDO(k,bus,z)..
4378                   IND(k,bus,z,t) =e= phi(z,t)*[R(k,bus,z,t)/U(z,t)]
4379                                    **sigma_INV(k,bus,z)*KD(k,bus,z,t);
4380   
4381   EQ97a(z,t)..    IR(z,t) =e= {SUM[(k,j)$KDO(k,j,z),
4382                                R(k,j,z,t)*KD(k,j,z,t)]-DEP(z,t)}/
4383                               {PK(z,t)*SUM[(k,j)$KDO(k,j,z),KD(k,j,z,t)]};
4384   
4385   EQ97b(z,t)..    U(z,t) =e= PK(z,t)*(delta(z)+IR(z,t));
4386   
4387  *==============================================================================
4388  *   5.3.9 Other
4389  *==============================================================================
4390   WALRAS(z,t)..   LEON(z,t) =e= Q('01_AGRICULT',z,t)-C('01_AGRICULT',z,t)-CG('01_AGRICULT',z,t)-INV('01_AGRICULT',z,t)
4391                              -DIT('01_AGRICULT',z,t);
4392   
4393  *==============================================================================
4394  *   5.3.10 Backstop technology
4395  *==============================================================================
4396   EQ98(i3,z,t)..    C_Conventional(i3,z,t) =e= (1-penetration_rate(i3,z,t)*switch(i3,z,t))*[C(i3,z,t)+CG(i3,z,t)+INV(i3,z,t)+DIT(i3,z,t)];
4397   
4398   EQ99(i3,z,t)..    XDBS(i3,z,t) =e= penetration_rate(i3,z,t)*switch(i3,z,t)*[C(i3,z,t)+CG(i3,z,t)+INV(i3,z,t)+DIT(i3,z,t)];
4399   
4400   EQ100(j,z,t)..    XDBS2(j,z,t) =e= sum{i3$COMtoIND(j,i3),XDBS(i3,z,t)};
4401   
4402   EQ101(j,z,t)..    LBS(j,z,t) =e= 0.6*XDBS2(j,z,t);
4403   
4404   EQ102(k,j,z,t)..   KBS(k,j,z,t) =e= 0.3*XDBS2(j,z,t)*KDO(k,j,z)/sum(kj,KDO(kj,j,z));
4405   
4406   EQ103(i3,z,t)..   CLBS(i3,z,t)  =e= sum{j$INDtoCOM(i3,j),LBS(j,z,t)*WC(j,z,t)};
4407   
4408   EQ104(i3,z,t)..   CKBS(i3,z,t)  =e= sum{k,sum{j$INDtoCOM(i3,j),KBS(k,j,z,t)*RC(j,z,t)}};
4409   
4410   EQ105(i3,z,t)..   MARKUP(i3,z,t) =e= {PC(i3,z,t)*XDBS(i3,z,t)-CLBS(i3,z,t)-CKBS(i3,z,t)}*switch(i3,z,t) ;
4411   
4412  *================================================================================
4413  * 6 Labour Supply
4414  *================================================================================
4415   EQ106(z,t)..  LS(z,t) =e= LST(z,t) *((W(z,t)/PIXCON(z,t)) / (W_lag(z,t)/PIXCON_lag(z,t)))**elasLS(z);
4416   
4417  *==============================================================================
4418  * 7 PERMET
4419  *==============================================================================
4420   EQ107(j,z,t).. PERMIT(j,z,t) =e= sum(ene, CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t));
4421   
4422   EQ108(z,t)..  PERMIT_TOTAL(z,t) =E=  sum(j,PERMIT(j,z,t))  ;
4423   
4424  *==============================================================================
4425  *   8 Carbon Tax Revenue Recycling
4426  *==============================================================================
4427   
4428  EQ109(j,z,t)..   TIW_Share(j,z,t) =e= LD(j,z,t)/SUM(jj,LD(jj,z,t));
4429  *EQ109(j,z,t)..   TIW_Share(j,z,t) =e= 0;
4430   
4431  EQ110(j,z,t)..    ttiw(j,z,t) =e= ttiw_lag(j,z,t) + deltatiw(j,z,t);
4432   
4433  EQ111(j,z,t)..   deltatiw(j,z,t) =e= -TIW_Share(j,z,t) * REBATE(z,t) / (W(z,t)*LD(j,z,t));
4434   
4435  EQ112(z,t)..  REBATE(z,t) =e= TCTAX(z,t);
