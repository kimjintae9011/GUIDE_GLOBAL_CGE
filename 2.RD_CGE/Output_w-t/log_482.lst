3183  * NEP_DIO(p_oilproduct,'30_ATRP',z) = sum((f_domeair), domeair_fne_oilproduct(f_domeair, p_oilproductproduct, z));
3184   NOilp_DIO(p_oilproduct,'31_SER',z) = sum(f_neother, WEB(f_neother, p_oilproduct, z) );
3185  * NEP_CO(p_oilproductlz) = sum((f_household), household_fne_oilproduct(f_household, p_oilproductproduct, z));
