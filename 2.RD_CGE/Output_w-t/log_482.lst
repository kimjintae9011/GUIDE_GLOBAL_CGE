3465  *==============================================================================
3466  *   Marginal abatement curves for emissions
3467  *==============================================================================
3468  Parameters
3469   alpha_CO2(ene,j,z)   Emissions responsiveness parameter – higher values imply stronger reduction in emissions intensity in response to carbon price
3470   gamma_CO2(ene,j,z)   Adjustment speed parameter – governs how rapidly emissions intensity responds to changes in carbon price
3471   MINCO2FACTOR(ene,j,z) minimum CO2 emission factor
3472   CTAX_CO2(ene,j,z,time)
3473   CO2FACTOR2_Star(ene,j,z,time)
3474   AbateCostO(j,z)
3475   AbateCost(j,z,time)
3476   theta_CO2(j,z)
3477   delta_CO2(j,z)
3478  ;
3479   
3480   alpha_CO2(ene,j,z)     = 0.15 ;
3481   gamma_CO2(ene,j,z)     = 1.5 ;
3482   MINCO2FACTOR(ene,j,z)  = CO2FACTOR(ene,j,z)*0.1 ;
3483   AbateCostO(j,z)        = 0 ;
3484   theta_CO2(j,z)         = 0.2;
3485   delta_CO2(j,z)         = 1;
