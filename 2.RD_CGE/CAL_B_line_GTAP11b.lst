4104  *==============================================================================
4105  *   6.1.3 Closures
4106  *==============================================================================
4107  *$ontext
4108  * FP CLOSURE: fixed PIXGDPs; numeraire is exchange rate of reference region
4109  * The exchange rates are endogenous, except for the reference region.
4110   e.FX(zr,time)      = eO(zr);
4111   PIXGDP.FX(z,time)  = PIXGDPO(z)/sum[zr,eO(zr)];
4112  *$offtext
4113   
      * FE CLOSURE: fixed exchange rates; numeraire is PIXGDP of reference region
      * The exchange rates can be fixed at arbitrary values
       PIXGDP.FX(zr,time)  = PIXGDPO(zr);
       e.FX(z,time)        = eO(z);
4120   
4121   phi.fx(z,time)       = phio(z);
4122   ttdh0.fx(z,time)     = ttdh0O(z);
4123   ttdh1.fx(z,time)     = ttdh1O(z);
4124   ttic.fx(i,z,time)    = tticO(i,z);
4125   ttik.fx(k,j,z,time)  = ttikO(k,j,z);
4126   ttim.fx(i,zj,z,time) = ttimO(i,zj,z);
4127   ttip.fx(j,z,time)    = ttipO(j,z);
4128   ttiw.fx(l,j,z,time)  = ttiwO(l,j,z);
4129   ttix.fx(i,z,zj,time) = ttixO(i,z,zj);
4130   CTAX.fX(z,time)      = CTAX0(z);
4131   
4132  *==============================================================================
4133  *   6.1.2 Fixing GDP_BP_REAL and sh1, and initializing A_VA and sh0
4134  *==============================================================================
4135  * To compute the baseline, real GDP is set to grow at the projected growth rate
4136  * and multifactor productivity is endogenous.
4137   GDP_BP_REAL.fx(z,t1)  = GDP_BP_REALO(z);
4138   GDP_BP_REAL.fx(z,time)$[ord(time) gt 1]
4139                         = GDP_BP_REAL.l(z,time-1)*[1+g_GDP(z,time)];
4140   
4141   A_VA.L(z,t1)          = 1;
4142   A_VA.L(z,time)$[ord(time) gt 1]
4143                         = A_VA.L(z,time-1);
4144   
4145  * Domestic savings rates are made to follow the evolution anticipated by FBQF
4146  * and the intercept for the household savings function is endogenously
4147  * determined from the added constraint labeled CALEQ1:
4148   sh1.fx(z,t1)          = sh1O(z);
4149   sh1.fx(z,time)$[ord(time) gt 1]
4150                         = sh1.l(z,time-1)*[1+g_SDR(z,time-1)];
4151   
4152   sh1.fx('05_MNG',time)$[ord(time) gt 1]
4153                         = sh1.l('05_MNG',time-1)*[1+growthz('05_MNG')];
4154   
4155   sh0.l(z,t1)           = sh0O(z);
4156   sh0.l(z,time)$[ord(time) gt 1]
4157  *                      = sh0.l(z,time-1)*exogro(z,time)/exogro(z,time-1);
4158                         = sh0.l(z,time-1)*[1+growthz(z)];
4159   
4160  *==============================================================================
4161  *   6.1.4 Other exogenous variables
4162  *==============================================================================
4163  * CABX.FX(z1,time)    = CABXO(z1)*cabix(z1,time);
4164   CABX.FX(z1,time)     = CABXO(z1);
4165   CABX.FX(z1,time)$[ord(time) gt 1]
4166  *                      = CABX.l(z1,time-1)*[1+growthz(z1)];
4167                        = CABX.l(z1,time-1)*[1+g_GDP(z1,time)];
4168   
4169   CMIN.FX(i,z,t1)      = CMINO(i,z);
4170   CMIN.FX(i,z,time)$[ord(time) gt 1]
4171                        = CMIN.l(i,z,time-1)*[1+g_POP(z,time)];
4172   
4173   KD.fx(k,j,z,t1)$KDO(k,j,z)
4174                        = KDO(k,j,z);
4175   KD.fx(k,j,z,time)${[ord(time) gt 1] and KDO(k,j,z)}
4176                        = KD.l(k,j,z,time-1)*[1-delta(z)]+IND.l(k,j,z,time-1);
4177   
4178   KD.fx('natr',j,z,time)${[ord(time) gt 1] and KDO('natr',j,z)}
4179                       = KD.l('natr',j,z,time-1)*(1-0.01);
4180   
4181   KD.fx('land',j,z,time)${[ord(time) gt 1] and KDO('land',j,z)}
4182                       = KD.l('land',j,z,time-1);
4183   
4184   LS.FX(l,z,t1)        = LSO(l,z);
4185   LS.FX(l,z,time)$[ord(time) gt 1]
4186                        = LS.l(l,z,time-1)*[1+g_POP(z,time)];
4187   
4188  *==============================================================================
4189  *   CTAX
4190  *==============================================================================
4191   CTAX.fx(z,time)$[ord(time) gt 1]
4192                        = CTAX_Cal(z,time);
4193   
4194  *==============================================================================
4195  *   6.1.5 Resolution
4196  *==============================================================================
4197   
4198  SOLVE PEPWT USING CNS;
4199  *SOLVE PEPWT using NLP maximizing OBJ;
4200  *SOLVE PEPWT USING MCP;
4201   
4202  * The single element in subset T(time) is removed, and the subset is now empty.
4203  T(time)          = NO;
4204  * End of LOOP over time periods
4205  ];
4206   
4207  *==============================================================================
4208  * 7. Output
4209  *==============================================================================
4210  * Preparation of a GDX file that includes the baseline values for A_VA, sh0, G,
4211  * G_REAL and IND. This file will then be used in the main program.
4212   
4213  PARAMETER
4214   A_VA_RES(z,time) Value of A_VA to reproduce real GDP projections
4215   GX(z,time)       Current government expenditures on goods and services in region z
4216   G_REALX(z,time)  Current real government expenditures on goods and services in region z
4217   INDX(k,j,z,time) Volume of new type k capital investment to industry j in region z
4218   sh0X(z,time)     Intercept (household savings)
4219   sh1X(z,time)     Household savings rate
4220   phi_BAU(z,time)
4221   valCTAX(z,time)
4222  ;
4223   
4224   A_VA_RES(z,time)        = A_VA.l(z,time);
4225   GX(z,time)              = G.l(z,time);
4226   G_REALX(z,time)         = G_REAL.l(z,time);
4227   INDX(k,pub,z,time)      = IND.l(k,pub,z,time);
4228   sh1X(z,time)            = sh1.l(z,time);
4229   sh0X(z,time)            = sh0.l(z,time);
4230   phi_BAU(z,time)         = phi.l(z,time);
4231   valCTAX(z,time)         = CTAX.l(z,time);
4232   
4233  execute_unload 'Input_w-t/B_line_GTAP11b.gdx',
4234   A_VA_RES, GX, G_REALX, INDX, delta, XST, VA, LS, KS, LD, KD, IND, EX, g_GDP, g_POP, GDP_BP, RC, IT, SH, SG, CABX, R, PK, sigma_LD, sigma_INV,
4235   sh1X, sh0X, phi_BAU, valCTAX ;

