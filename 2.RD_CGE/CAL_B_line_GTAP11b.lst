 494   ttdh0O(z)       Intercept (household income tax)
 495   ttdh1O(z)       Slope (household income tax)
 496   tticO(i,z)      Tax rate on commodity i
 497   ttikO(k,j,z)    Tax rate on capital k used in industry j
 498   ttimO(i,zj,z)   Rate of taxes and duties on imports of commodity i from country zj
 499   ttipO(j,z)      Tax rate on the production of industry j
 500   ttiwO(l,j,z)    Tax rate on type l worker compensation in industry j
 501   ttixO(i,z,zj)   Export tax rate on exported commodity x
 502  ;
 503   
 504  Scalar
 505   Tiny small figure / 0.000000000001/ ;
 506   
 507  *==============================================================================
 508  * 3 Data
 509  *==============================================================================
 510  *  3.1 Data input from GTAP8.1
 511  *==============================================================================
 512  *   3.1.1 Reading data aggregated with DATA_AGG-2007.gms
 513  *==============================================================================
 514  *  The PEP w-t model uses aggregated data from GTAP8.1. The following file
 515  *  includes data for some variables and substitution elasticities.
 516   
--- LOAD  CO = 14:CO
--- LOAD  CGO = 15:CGO
--- LOAD  DDO = 16:DDO
--- LOAD  DEPO = 17:DEPO
--- LOAD  DIO = 18:DIO
--- LOAD  DSO = 19:DSO
--- LOAD  DSO_I = 20:DSO_I
--- LOAD  EXO = 21:EXO
--- LOAD  IMO = 22:IMO
--- LOAD  INVO = 23:INVO
--- LOAD  KSTO = 24:KSTO
--- LOAD  LDO = 25:LDO
--- LOAD  MRGNO = 26:MRGNO
--- LOAD  XSO = 40:XSO
--- LOAD  XSO_I = 41:XSO_I
--- LOAD  XSTO = 42:XSTO
--- LOAD  g_GDP = 63:g_GDP
--- LOAD  g_POP = 64:g_POP
--- LOAD  g_SDR = 65:g_SDR
--- LOAD  AEEI_low = 66:AEEI_low
--- LOAD  AEEI_high = 67:AEEI_high
--- LOAD  CTAX_Cal = 69:CTAX_Cal
--- LOAD  RKDO = 28:RKDO
--- LOAD  TDHO = 29:TDHO
--- LOAD  TICO = 31:TICO
--- LOAD  TIKO = 32:TIKO
--- LOAD  TIMO = 33:TIMO
--- LOAD  TIPO = 34:TIPO
--- LOAD  TIWO = 35:TIWO
--- LOAD  TIXO = 36:TIXO
--- LOAD  tmrg = 39:tmrg
--- LOAD  sigma_M1 = 44:sigma_M1
--- LOAD  sigma_M2 = 45:sigma_M2
--- LOAD  sigma_VA = 46:sigma_VA
--- LOAD  sigma_KLE = 47:sigma_KLE
--- LOAD  POPO = 27:POPO
 520   
 521  display sigma_M1, sigma_M2 ;
 522   
 523  sigma_M1('04_GAS',Z) = 6;
 524  sigma_M2('03_OIL',Z) = 6;
 525  sigma_M2('04_GAS',Z) = 6;
 526   
 527  display sigma_M1, sigma_M2 ;
 528   
 529  *==============================================================================
 530  *   3.1.2 Rescaling the variables
 531  *==============================================================================
 532  * GTAP 8.1 data are in millions of (2004 and 2007) US dollars
 533  * (see www.gtap.agecon.purdue.edu/resources/download/5679.pdf)
 534  * With RES = 10000, model results are in tens of billions (10G$)
 535  RES              = 10000;
 536  *RES              = 1;
 537   
 538  * NOTE: In GTAP parlance, "agents' prices" are prices paid by buyers, and
 539  *       "market prices" are prices received by sellers.
 540   
 541  * Household consumption = GTAP domestic purchases (VDPA) + import purchases (VIPA)
 542  * by households at agents' prices.
 543  CO(i,z)          = CO(i,z)/RES;
 544   
 545  * Public final consumption = domestic purchases (VDGA) + import purchases (VIGA)
 546  * by government at agents' prices.
 547  CGO(i,z)         = CGO(i,z)/RES;
 548   
 549  * Domestic purchases = domestic absorption:
 550  * (CO + CGO + INVO + DIO) - [ imports (IMO) + transport margins (tmrg)
 551  *                              + indirect taxes (TICO + TIMO) ]
 552  DDO(i,z)         = DDO(i,z)/RES;
 553   
 554  * Capital depreciation (DEP)
 555  DEPO(z)          = DEPO(z)/RES;
 556   
 557  * Intermediate consumption = domestic purchases (VDFA) + import purchases (VIFA)
 558  * by firms belonging to sectors other than CGDS, at agents' prices.
 559  DIO(i,j,z)       = DIO(i,j,z)/RES;
 560   
 561  * Domestic supply = domestic demand (DDO) in GTAP_AGG.gms
 562  DSO(j,i,z)        = DSO(j,i,z)/RES;
 563  DSO_I(i,z)        = DSO_I(i,z)/RES;
 564   
 565  * Exports = exports at world prices (VXWD) = imports at world prices
 566  * Note: the GTAP variable VXWD is NOT used in the DATA_AGG.gms program; the
 567  * value recorded in DATA_AGG.gdx is actually identical to IMO
 568  EXO(i,z,zj)      = EXO(i,z,zj)/RES;
 569   
 570  * Imports = imports at world prices (VIWS) - sum of transport margins on imports (VTWR)
 571  IMO(i,z,zj)      = IMO(i,z,zj)/RES;
 572   
 573  * Demand for investment purposes = domestic purchases (VDFA)+ import purchases (VIFA)
 574  * by firms of the CGDS sector at agents' prices.
 575  INVO(i,z)        = INVO(i,z)/RES;
 576   
 577  * Total capital stock at the beginning of the period (VKB)
 578  KSTO(z)          = KSTO(z)/RES;
 579   
 580  * Labor demand = Remuneration of labor at market prices, before taxes
 581  * (components of VFM, "primary factor purchases, by households, at market prices")
 582  LDO(l,j,z)       = LDO(l,j,z)/RES;
 583   
 584  * Supply of transport margins at market prices (VST), adjusted proportionately
 585  * so that MRGNO = sum of tmrg for every margin commodity
 586  MRGNO(i,z)       = MRGNO(i,z)/RES;
 587   
 588  * Remuneration of capital at market prices, before taxes
 589  * (components of VFM, "primary factor purchases, by households, at market prices")
 590  RKDO(k,j,z)      = RKDO(k,j,z)/RES;
 591   
 592  * Direct taxes = factor payment at market prices (VFM)
 593  *                - primary factor sales at agents' prices (EVOA)
 594  TDHO(z)          = TDHO(z)/RES;
 595   
 596  * Domestic taxes on commodities = demand at agents' prices - demand at market prices:
 597  * Include 6 pairs of GTAP components
 598  *       VDPA - VDPM
 599  *       VIPA - VIPM
 600  *       VDGA - VDGM
 601  *       VIGA - VIGM
 602  *       VDFA - VDFM
 603  *       VIFA - VIFM
 604  TICO(i,z)        = TICO(i,z)/RES;
 605   
 606  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 607  *                                     - factor-based subsidies (FBEP).
 608  TIKO(k,j,z)      = TIKO(k,j,z)/RES;
 609   
 610  * Import duties = "ordinary" import duties (TFRV)
 611  TIMO(i,z,zj)     = TIMO(i,z,zj)/RES;
 612   
 613  * Taxes on production = MINUS "ordinary output subsidies" (OSEP)
 614  TIPO(j,z)        = TIPO(j,z)/RES;
 615   
 616  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 617  *                                     - factor-based subsidies (FBEP).
 618  TIWO(l,j,z)      = TIWO(l,j,z)/RES;
 619   
 620  * Taxes on exports = export tax equivalent of the Multi-Fiber Agreement (MFA)
 621  * quota premium(MFRV) + "ordinary" export taxes (XTRV)
 622  TIXO(i,z,zj)     = TIXO(i,z,zj)/RES;
 623   
 624  * Transport margins at world prices = sum of margins on imports (VTWR)
 625  tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj)/RES;
 626   
 627  * Domestic output = domestic supply (DSO) + supply of transport margins (MRGNO)
 628  *                   + exports (EXO) - taxes on exports (TIXO)
 629   
 630  XSO_I(i,z)        = XSO_I(i,z)/RES;
 631  XSO(j,i,z)        = XSO(j,i,z)/RES;
 632  XSTO(j,z)         = XSTO(j,z)/RES;
 633   
 634  growthz(z)        = 0.02;
 635   
 636  *==============================================================================
 637  *  3.3 Exogenous prices and parameters
 638  *==============================================================================
 639   
 640  *  Price elasticity (should be equal to one to verify homogeneity)
 641  eta = 1;
 642   
 643  *==============================================================================
 644  * CES and CET elasticities
 645  *==============================================================================
 646  * CES elasticities are defined using GTAP8.1 data for imports
 647  * (sigma_M1 and sigma_M2) and value added (sigma_VA)
 648   
 649  * Other exogenous parameters can be defined if the Excel file VAL_PAR.XLS
 650  PARAMETER
 651  PARZ;
 652   
GDXIN   C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.RD_CGE\Input_w-t\PAR.gdx
--- LOAD  sigma_KD = 1:sigma_KD
--- LOAD  sigma_LD = 2:sigma_LD
--- LOAD  sigma_X1 = 4:sigma_X1
--- LOAD  sigma_X2 = 5:sigma_X2
--- LOAD  sigma_X3 = 6:sigma_X3
--- LOAD  sigma_X0 = 7:sigma_X0
--- LOAD  sigma_Y = 8:sigma_y
--- LOAD  sigma_INV = 10:sigma_inv
--- LOAD  PARZ = 9:PARZ
 656   
 657  * sigma_INV(k,j,z) = 2;
 658   sigma_INV(k,j,z) = 1;
 659   
 660  *------------------------------------------------------------------------------
 661  * CES - composite capital
 662  * We assume that the elasticity between the different type of capital
 663  * is twice that used for value added.
 664  * If the user wishes to assume otherwise, he can fill the appropriate area in
 665  * the Excel file VAL_PAR.xls and delete following line:
 666   sigma_KD(j,z)   = 2*sigma_VA(j,z);
 667   
 668  *------------------------------------------------------------------------------
 669  * CES - composite labor
 670  * We assume that the elasticity between the different type of labor
 671  * is twice that used for value added.
 672  * If the user wishes to assume otherwise, he can fill the appropriate area in
 673  * the Excel file VAL_PAR.xls and delete following line:
 674  * sigma_LD(j,z)   = 2*sigma_VA(j,z);
 675   sigma_LD(j,z)   = 0.5;
 676   
 677  *$exit
 678  *------------------------------------------------------------------------------
 679  * CES - composite KLE, KE, ENER
 680  * sigma_KLE(j,z)  = 0.5 ;
 681  * sigma_KLE(j,z)  = 1.1 ;
 682   sigma_ENER(j,z) = 1.1 ;
 683  *  sigma_ENER(j,z) = 2.0 ;
 684   
 685  *------------------------------------------------------------------------------
 686  * CET - total output
 687  * We arbitrarily assume that the transformation elasticity between total exports,
 688  * domestic supply and margins is equal to 2 for all sectors and all region.
 689  * If the user wishes to assume otherwise, he can fill the appropriate area in
 690  * the Excel file VAL_PAR.xls.
 691   
 692  *------------------------------------------------------------------------------
 693  * CET - exports
 694  * We arbitrarily assume that the transformation elasticity between exports
 695  * to the different partners is equal to 3 for all sectors and all region.
 696  * If the user wishes to assume otherwise, he can fill the appropriate area in
 697  * the Excel file VAL_PAR.xls.
 698   
 699  *------------------------------------------------------------------------------
 700  * LES parameters - Frisch
 701  * We assume that the Frisch parameter is -1.1 for rich regions/countries and
 702  * -1.5 for other regions/countries.
 703   frisch(zrich)   = -1.1;
 704   frisch(zother)  = -1.5;
 705   
 706  * If the user wishes to assume otherwise, he can fill the appropriate area in
 707  * the Excel file VAL_PAR.xls, delete the previous 2 lines and uncomment the
 708  * following line:
 709   frisch(z)      = PARZ(z,'frisch');
 710   
 711  *------------------------------------------------------------------------------
 712  * LES parameters - Income elasticity of consumption
 713  * We arbitrarily assume that the income elasticity of the consumption of
 714  * commodity i is the same for all region/country.
 715  * If the user wishes to assume otherwise, he can fill the appropriate area in
 716  * the Excel file VAL_PAR.xls.
 717   
 718  *------------------------------------------------------------------------------
 719  *  Slopes of taxation functions
 720  *   One can either choose to assign a value to the intercepts and calibrate
 721  *   the slopes accordingly, or the other way around. This type of modelling
 722  *   can be useful to take into account known marginal savings or taxation rates
 723  *   or to deal with negative average saving rates in cases where savings are
 724  *   negative for some household groups.
 725  *   When no further information is available, one can simply set the intercepts
 726  *   to zero and calibrate an average rate: this is what we do here for ttdh0O.
 727  *   If the user wishes to assume otherwise, he can fill the appropriate area in
 728  *   the Excel file VAL_PAR.xls.
 729  * ttdh0O(z)       = PARZ(z,'ttdh0O');
 730   
 731   ttdh0O(z)       = 0;
 732  *   The slope ttdh1O is calibrated below in the mane GAMS file
 733   
 734  *------------------------------------------------------------------------------
 735  *  Elasticity - Investment demand function
 736  * We arbitrarily assume that this elasticity is equal to 2 for all types of
 737  * capital, all sectors and all regions.
 738  * If the user wishes to assume otherwise, he can fill the appropriate area in
 739  * the Excel file VAL_PAR.xls.
 740   
 741  *------------------------------------------------------------------------------
 742  * Also we need to assign values to some prices
 743  * All of the prices below, EXCEPT eO, may be set at arbitrary values
 744  * without loss of generality.
 745  *
 746  * In the case of eO, although exchange rates may be given arbitrary values
 747  * in the model, they must all be equal for calibration at this stage. The reason
 748  * is that the supply of margin transport services MRGNO must equal global demand.
 749  * Since there is a single world price for international transport margins
 750  * (rather than bilateral world prices for other commodities) the unit of
 751  * measurement of the volume of margin services must be the same for all regions,
 752  * and in turn, that implies that the divisor that converts the nominal value to
 753  * volume be the same for all regions. Since that divisor involves the exchange
 754  * rate, all exchange rates must be equal.
 755   
 756  * Normally, prices that may be given arbitrary values are set at 1:
 757   eO(z)           = 1;
 758   PEO(i,z,zj)     = 1;
 759   PLO(i,z)        = 1;
 760   PWMGO(i)        = 1;
 761   WO(l,z)         = 1;
 762   
 763  *==============================================================================
 764  * 4 Calibration
 765  *==============================================================================
 766  *  4.1 Calculation of income and savings related variables and parameters
 767  *==============================================================================
 768   YHKO(z)         = SUM[(k,j),RKDO(k,j,z)];
 769   YHLO(z)         = SUM[(l,j),LDO(l,j,z)];
 770   YHO(z)          = YHLO(z)+YHKO(z);
 771   YDHO(z)         = YHO(z)-TDHO(z);
 772   CTHO(z)         = SUM[i,CO(i,z)];
 773   SHO(z)          = YDHO(z)-CTHO(z);
 774   
 775   TICTO(z)        = SUM[i,TICO(i,z)];
 776   TIMTO(z)        = SUM[(i,zj),TIMO(i,zj,z)];
 777   TIWTO(z)        = SUM[(l,j),TIWO(l,j,z)];
 778   TIKTO(z)        = SUM[(k,j),TIKO(k,j,z)];
 779   TIPTO(z)        = SUM[j,TIPO(j,z)];
 780   TIXTO(z)        = SUM[(i,zj),TIXO(i,z,zj)];
 781   TPRODNO(z)      = TIKTO(z)+TIWTO(z)+TIPTO(z);
 782   TPRCTSO(z)      = TICTO(z)+TIMTO(z)+TIXTO(z);
 783   YGO(z)          = TDHO(z)+TPRCTSO(z)+TPRODNO(z);
 784   GO(z)           = SUM[i,CGO(i,z)];
 785   SGO(z)          = YGO(z)-GO(z);
 786   
 787   YROWO(z)        = SUM[(i,zj),IMO(i,zj,z)]+SUM[(i,ij,zj),tmrg(i,ij,zj,z)];
 788   SROWO(z)        = YROWO(z)-SUM[(i,zj),EXO(i,z,zj)]-SUM[i,MRGNO(i,z)];
 789   CABO(z)         = -SROWO(z);
 790   
 791   ITO(z)          = SHO(z)+SGO(z)+SROWO(z);
 792   
 793  *==============================================================================
 794  *  4.2 Calibration of parameters and other variables
 795  *==============================================================================
 796  *  4.2.1 Calibration of investment and government spending shares
 797  *==============================================================================
 798   gamma_GVT(i,z)  = CGO(i,z)/SUM[ij,CGO(ij,z)];
 799   gamma_INV(i,z)  = INVO(i,z)/SUM[ij,INVO(ij,z)] ;
 800   
 801  *==============================================================================
 802  *  4.2.2 Calibration of other prices and revised volumes (part 1)
 803  *==============================================================================
 804   LDO(l,j,z)      = LDO(l,j,z)/WO(l,z);
 805   LDCO(j,z)       = SUM[l,LDO(l,j,z)];
 806   LSO(l,z)        = SUM[j,LDO(l,j,z)];
 807   EXO(i,z,zj)     = [EXO(i,z,zj)-TIXO(i,z,zj)]/PEO(i,z,zj);
 808   EXTO(i,z)       = SUM[zj,EXO(i,z,zj)];
 809   
 810   PWXO(i,z,zj)$EXO(i,z,zj)
 811                   = {[PEO(i,z,zj)*EXO(i,z,zj)+TIXO(i,z,zj)]/EXO(i,z,zj)}/eO(z);
 812   
 813   PETO(i,z)       = SUM[zj,PEO(i,z,zj)*EXO(i,z,zj)]/EXTO(i,z);
 814   PWMO(i,z,zj)    = PWXO(i,z,zj);
 815   IMO(i,zj,z)     = EXO(i,zj,z);
 816   IMTO(i,z)       = SUM[zj,IMO(i,zj,z)];
 817   
 818   DSO(j,i,z)       = DSO(j,i,z)/PLO(i,z);
 819   DSO_I(i,z)       = SUM(j,DSO(j,i,z));
 820   DSO_J(j,z)       = SUM(i,DSO(j,i,z));
 821   QO(i,z)         = IMTO(i,z)+DDO(i,z);
 822   
 823   MRGNO(i,z)$MRGNO(i,z)
 824                   = MRGNO(i,z)/[eO(z)*PWMGO(i)];
 825   
 826   XSO_I(i,z)      = EXTO(i,z)+DDO(i,z)+MRGNO(i,z);
 827   
 828   XSTO(j,z)       = sum(i, XSO(j,i,z));
 829   
 830   PO(i,z)        = [PETO(i,z)*EXTO(i,z)+PLO(i,z)*DSO_I(i,z)
 831                    +eO(z)*PWMGO(i)*MRGNO(i,z)]/XSO_I(i,z);
 832   
 833   PO2(j,i,z)$XSO(j,i,z) = 1;
 834   
 835   PO3(i,j,z)$XSO(j,i,z) = 1;
 836   
 837   PIO(i,z)       = SUM[j$XSO(j,i,z),PO2(J,I,z)*XSO(j,i,z)]/XSO_I(i,z);
 838   
 839   PTO(j,z)       = SUM[i$XSO(j,i,z),PO2(j,i,z)*XSO(j,i,z)]/XSTO(j,z);
 840   
 841   PPO(j,z)       = [SUM[l,TIWO(l,j,z)+WO(l,z)*LDO(l,j,z)]
 842                    +SUM[k,TIKO(k,j,z)+RKDO(k,j,z)]
 843                    +SUM[nene,DIO(nene,j,z)]+SUM[ene,DIO(ene,j,z)]]/XSTO(j,z);
 844   
 845   theta2(j,i,z) = DSO(j,i,z)/sum(jj, DSO(jj,i,z));
 846   
 847   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z)*EXTO(i,z);
 848   
 849  *==============================================================================
 850  *  4.3 Calibration of tax rates, margins, prices and volumes
 851  *==============================================================================
 852  *  4.3.1 Margin rates and tax rates
 853  *==============================================================================
 854   ttixO(i,z,zj)   = [eO(z)*PWXO(i,z,zj)/PEO(i,z,zj)]-1;
 855   tticO(i,z)      = TICO(i,z)/{PLO(i,z)*DDO(i,z)
 856                     +SUM[zj,IMO(i,zj,z)*eO(z)*PWMO(i,zj,z)
 857                     +TIMO(i,zj,z)+SUM[ij,tmrg(ij,i,zj,z)]]};
 858   
 859   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
 860                   = tmrg(i,ij,zj,z)/(PWMGO(i)*eO(z)*IMO(ij,zj,z));
 861   
 862   ttimO(i,zj,z)$IMO(i,zj,z)
 863                   = TIMO(i,zj,z)/{IMO(i,zj,z)*eO(z)*(PWMO(i,zj,z)
 864                    +SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])};
 865   
 866   ttiwO(l,j,z)$LDO(l,j,z)
 867                   = TIWO(l,j,z)/[WO(l,z)*LDO(l,j,z)];
 868   
 869   ttikO(k,j,z)$RKDO(k,j,z)
 870                   = TIKO(k,j,z)/RKDO(k,j,z);
 871   
 872   ttipO(j,z)      = [PTO(j,z)/PPO(j,z)]-1;
 873   
 874   ttdh1O(z)       = [TDHO(z)-ttdh0O(z)]/YHO(z);
 875   
 876  *==============================================================================
 877  *  4.3.2 Calibration of other prices and revised volumes (part 2)
 878  *==============================================================================
 879   PDO(i,z)        = PLO(i,z)*(1+tticO(i,z));
 880   PMO(i,zj,z)     = eO(z)*(PWMO(i,zj,z)+SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])
 881                   *(1+ttimO(i,zj,z))*(1+tticO(i,z));
 882   PMTO(i,z)       = SUM[zj,PMO(i,zj,z)*IMO(i,zj,z)]/IMTO(i,z);
 883   PCO(i,z)        = [PMTO(i,z)*IMTO(i,z)+PDO(i,z)*DDO(i,z)]/QO(i,z);
 884   
 885   CO(i,z)         = CO(i,z)/PCO(i,z);
 886   CGO(i,z)        = CGO(i,z)/PCO(i,z);
 887   DIO(nene,j,z)   = DIO(nene,j,z)/PCO(nene,z);
 888   DEO(ene,j,z)    = DIO(ene,j,z)/PCO(ene,z);
 889   INVO(i,z)       = INVO(i,z)/PCO(i,z);
 890   
 891   CIO(j,z)        = SUM[nene,DIO(nene,j,z)];
 892   CEO(j,z)        = SUM[ene,DEO(ene,j,z)];
 893   
 894   DITO(nene,z)     = SUM[j,DIO(nene,j,z)];
 895   DITO(ene,z)      = SUM[j,DEO(ene,j,z)];
 896   
 897   PO4(ene,j,z)    = PCO(ene,z);
 898   
 899   PCIO(j,z)       = SUM[nene,PCO(nene,z)*DIO(nene,j,z)]/CIO(j,z);
 900   PCEO(j,z)       = SUM[ene,PCO(ene,z)*DEO(ene,j,z)]/CEO(j,z) ;
 901   
 902   WTIO(l,j,z)     = WO(l,z)*(1+ttiwO(l,j,z));
 903   
 904   WCO(j,z)$LDCO(j,z)
 905                   = SUM[l,WTIO(l,j,z)*LDO(l,j,z)]/LDCO(j,z);
 906   
 907  *==============================================================================
 908  *  4.4 Calibration of dynamic parameters
 909  *==============================================================================
 910  * Calibration of dynamic parameters following new procedure.
 911  * The price of capital is arbitrary:
 912   PKO(z) = 1;
 913   
 914  * The calibration of depreciation rates is based on two hypotheses:
 915  * 1. The rate of depreciation is the same for all types of capital and all
 916  *    industries in each region (this hypothesis is made to accommodate the fact
 917  *    that, in the GTAP data base, capital consumption allowance is not detailed;
 918  *    as a matter of fact, the GTAP capital consumption allowance is set at
 919  *    4% of the value of the capital stock).
 920  * 2. The rental rate of capital is uniform across industries and types of
 921  *    capital in each region.
 922  * 3. The investment rate (IND/KD) is uniform across industries and types of
 923  *    capital in each region.
 924  * These hypotheses lead to the following formulae:
 925   
 926  * From GTAP, we know KSTO.
 927   KSTO(z)         = KSTO(z)/PKO(z);
 928   
 929  * Assuming a uniform depreciation rate for all types
 930  * of capital and all industries:
 931   delta(z)        = DEPO(z)/[PKO(z)*KSTO(z)];
 932   
 933  * From GTAP, we know KSTO. Assuming a uniform rental rate R for all types
 934  * of capital and all industries:
 935   RO(k,j,z)$RKDO(k,j,z)
 936                   = SUM[(kj,jj),RKDO(kj,jj,z)]/KSTO(z);
 937   
 938  * Then from the GTAP value of income paid to capital RKD we calibrate KDO:
 939   KDO(k,j,z)$RKDO(k,j,z)
 940                   = RKDO(k,j,z)/RO(k,j,z);
 941   
 942  * The supply of capital is equal to demand:
 943   KSO(k,z)        = SUM[j,KDO(k,j,z)];
 944   
 945  * The rate of return on capital, net of depreciation, is:
 946   IRO(z)         = {SUM[(k,j)$RKDO(k,j,z),RKDO(k,j,z)]-DEPO(z)}/[PKO(z)*KSTO(z)];
 947   
 948  * The user cost of capital follows
 949   UO(z)           = PKO(z)*(IRO(z)+delta(z));
 950   
 951  * Combining
 952  * - the hypothesis of uniform investment rates
 953  * - the hypothesis of uniform rental rates
 954  * - the hypothesis of uniform depreciation rates
 955  * leads to
 956   phiO(z)         = [ITO(z)/PKO(z)]/KSTO(z);
 957   
 958  * Investment by destination follows:
 959   INDO(k,j,z)$KDO(k,j,z)
 960                   = phiO(z)*KDO(k,j,z);
 961   
 962   A_K(z)          = 1/PKO(z)*{PROD[i$gamma_INV(i,z),(PCO(i,Z)/gamma_INV(i,z))
 963                     **gamma_INV(i,z)]};
 964   
 965  * INDO(k,j,z)$KDO(k,j,z) = KDO(k,j,z)/sum((kj,jj),KDO(kj,jj,z))*ITO(z);
 966   
 967   KDCO(j,z)       = SUM[k,KDO(k,j,z)];
 968   RTIO(k,j,z)     = RO(k,j,z)*(1+ttikO(k,j,z));
 969   RCO(j,z)$KDCO(j,z)
 970                   = SUM[k,RTIO(k,j,z)*KDO(k,j,z)]/KDCO(j,z);
 971   
 972  *==============================================================================
 973  *  4.5 Calibration of other prices and revised volumes (part 3)
 974  *==============================================================================
 975   VAO(j,z)        = LDCO(j,z)+KDCO(j,z);
 976   
 977   PVAO(j,z)       = [WCO(j,z)*LDCO(j,z)+RCO(j,z)*KDCO(j,z)]/VAO(j,z);
 978   
 979  * PIXGDPO is tautologically equal to 1, based on its formula
 980  * PIXGDPO(z)      = {SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
 981  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
 982  *                   *SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
 983  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]}**0.5;
 984   PIXGDPO(z)      = 1;
 985   
 986  * PIXGDP_WO is tautologically equal to 1, based on its formula
 987  * PIXGDP_WO       = {SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
 988  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
 989  *                   *SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
 990  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]/eO(z)}**0.5;
 991   PIXGDP_WO       = 1;
 992   
 993  * PIXCONO(z) is tautologically equal to 1, based on its formula
 994  * PIXCONO(z)      = SUM[i,PCO(i,z)*CO(i,z)]
 995  *                  /SUM[i,PCO(i,z)*CO(i,z)];
 996   PIXCONO(z)      = 1;
 997   
 998  * PIXINVO(z) is tautologically equal to 1, based on its formula
 999  * PIXINVO(z)      = PROD[i$gamma_INV(i,z),(PCO(i,z)/PCO(i,z))**gamma_INV(i,z)];
1000   PIXINVO(z)      = 1;
1001   
1002  * PIXGVTO(z) is tautologically equal to 1, based on its formula
1003  * PIXGVTO(z)      = PROD[i$gamma_GVT(i,z),(PCO(i,z)/PCO(i,z))**gamma_GVT(i,z)];
1004   PIXGVTO(z)      = 1;
1005   
1006  *==============================================================================
1007  *  4.6 Calibration of function parameters
1008  *==============================================================================
1009  *   4.6.1 Leontief functions
1010  *==============================================================================
1011   io(j,z)         = CIO(j,z)/XSTO(j,z) ;
1012   
1013   io2(j,z)        = CEO(j,z)/XSTO(j,z) ;
1014   
1015   v(j,z)          = VAO(j,z)/XSTO(j,z) ;
1016   
1017   v2(j,z)         = (CEO(j,z)+VAO(j,z))/XSTO(j,z) ;
1018   
1019   aij(nene,j,z)   = DIO(nene,j,z)/CIO(j,z);
1020   aij2(ene,j,z)   = DEO(ene,j,z)/CEO(j,z);
1021   
1022  *==============================================================================
1023  *   4.6.2 Calibration of CET parameters
1024  *==============================================================================
1025  *    4.6.2.1 CET between total exports, domestic supply and margins
1026  *==============================================================================
1027   rho_X1(i,z)     = (1+sigma_X1(i,z))/sigma_X1(i,z);
1028   
1029   beta_EX_X1(i,z)$MRGNO(i,z)
1030                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1031                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1032                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1033                     eO(z)*PWMGO(i)*MRGNO(i,z)$MRGNO(i,z)**(1-rho_X1(i,z))+Tiny];
1034   
1035   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1036                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1037                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1038                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+Tiny];
1039   
1040   beta_D_X1(i,z)$MRGNO(i,z)
1041                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1042                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1043                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1044                     eO(z)*PWMGO(i)*MRGNO(i,z)**(1-rho_X1(i,z))];
1045   
1046   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1047                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1048                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1049                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1050   
1051   B_X1(i,z)       = XSO_I(i,z)/[beta_EX_X1(i,z)*EXTO(i,z)**rho_X1(i,z)
1052                    +beta_D_X1(i,z)*DSO_I(i,z)**rho_X1(i,z)+(1-beta_EX_X1(i,z)
1053                    -beta_D_X1(i,z))*MRGNO(i,z)**rho_X1(i,z)]**(1/rho_X1(i,z));
1054   
1055  *==============================================================================
1056  *    4.6.2.2 CET between exports to different trading partners
1057  *==============================================================================
1058   rho_X2(i,z)     = (1+sigma_X2(i,z))/sigma_X2(i,z);
1059   beta_X2(i,z,zj)$EXO(i,z,zj)
1060                   = [PEO(i,z,zj)*EXO(i,z,zj)**(1-rho_X2(i,z))]/
1061                     SUM[zjj$EXO(i,z,zjj),PEO(i,z,zjj)*EXO(i,z,zjj)
1062                     **(1-rho_X2(i,z))];
1063   B_X2(i,z)       = EXTO(i,z)/{SUM[zj,beta_X2(i,z,zj)*EXO(i,z,zj)**rho_X2(i,z)]
1064                     **(1/rho_X2(i,z))};
1065   
1066  *==============================================================================
1067  *   4.6.3 Calibration of CES parameters
1068  *==============================================================================
1069  *    4.6.3.0 Composite output
1070  *==============================================================================
1071   rho_X3(i,z)   = (1-sigma_X3(i,z))/sigma_X3(i,z);
1072   
1073   beta_X3(j,i,z)$XSO(j,i,z)
1074                 = [PO2(j,i,z)*XSO(j,i,z)**(1+rho_X3(i,z))]/
1075                     SUM[jj$XSO(jj,i,z),PO2(jj,i,z)*XSO(jj,i,z)**(1+rho_X3(i,z))];
1076   
1077   B_X3(i,z)     = XSO_I(i,z)
1078                    /SUM[jj$XSO(jj,i,z),beta_X3(jj,i,z)*XSO(jj,i,z)**(-rho_X3(i,z))
1079                    ]**(-1/rho_X3(i,z));
1080   
1081   POWERQO(Z) = SUM(POWER, XSO(power,'18_ELEC',z));
1082   
1083   sigma_X4(z) =2;
1084   
1085   rho_X4(z)   = (1-sigma_X4(z))/sigma_X4(z);
1086   
1087   beta_X4(power,z)
1088                 = [PO2(power,'18_ELEC',z)*XSO(power,'18_ELEC',z)**(1+rho_X4(z))]/
1089                     SUM[power2$XSO(power2,'18_ELEC',z),PO2(power2,'18_ELEC',z)*XSO(power2,'18_ELEC',z)**(1+rho_X4(z))];
1090   
1091   B_X4(z)     = POWERQO(Z)
1092                    /SUM[power2$XSO(power2,'18_ELEC',z),beta_X4(power2,z)*XSO(power2,'18_ELEC',z)**(-rho_X4(z))
1093                    ]**(-1/rho_X4(z));
1094   
1095   TnDShare(z) = XSO('18_TnD','18_ELEC',z) / XSO_I('18_ELEC',z);
1096   
1097   PPOWERO(z) = 1;
1098   
1099  *==============================================================================
1100  *    4.6.3.1 Composite good
1101  *==============================================================================
1102   rho_M1(i,z)     = (1-sigma_m1(i,z))/sigma_m1(i,z);
1103   beta_M1(i,z)    = PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)/
1104                    {PDO(i,z)*DDO(i,z)**(rho_M1(i,z)+1)
1105                    +PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)};
1106   B_M1(i,z)       = QO(i,z)/{beta_M1(i,z)*IMTO(i,z)**(-rho_M1(i,z))
1107                    +(1-beta_M1(i,z))*DDO(i,z)**(-rho_M1(i,z))}**(-1/rho_M1(i,z));
1108   
1109  *==============================================================================
1110  *    4.6.3.2 CES between imports from different trading partners
1111  *==============================================================================
1112   rho_M2(i,z)     = (1-sigma_M2(i,z))/sigma_M2(i,z);
1113   beta_M2(i,zj,z)$IMO(i,zj,z)
1114                   = [PMO(i,zj,z)*IMO(i,zj,z)**(rho_M2(i,z)+1)]/
1115                     SUM[zjj$IMO(i,zjj,z),PMO(i,zjj,z)*IMO(i,zjj,z)
1116                      **(rho_M2(i,z)+1)];
1117   B_M2(i,z)       = IMTO(i,z)/{SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*IMO(i,zj,z)
1118                     **(-rho_M2(i,z))]**(-1/rho_M2(i,z))};
1119   
1120  *==============================================================================
1121  *    4.6.3.3 Composite capital
1122  *==============================================================================
1123   rho_KD(j,z)     = (1-sigma_KD(j,z))/sigma_KD(j,z);
1124   
1125   beta_KD(k,j,z)$KDO(k,j,z)
1126                   = [RTIO(k,j,z)*KDO(k,j,z)**(1+rho_KD(j,z))]/
1127                     SUM[kj$KDO(kj,j,z),RTIO(kj,j,z)*KDO(kj,j,z)**(1+rho_KD(j,z))];
1128   B_KD(j,z)$KDCO(j,z)
1129                   = KDCO(j,z)/{SUM[k$KDO(k,j,z),beta_KD(k,j,z)*KDO(k,j,z)
1130                     **(-rho_KD(j,z))]**(-1/rho_KD(j,z))};
1131   
1132  *==============================================================================
1133  *    4.6.3.4 Composite labor
1134  *==============================================================================
1135   rho_LD(j,z)     = (1-sigma_LD(j,z))/sigma_LD(j,z);
1136   beta_LD(l,j,z)$LDO(l,j,z)
1137                   = [WTIO(l,j,z)*LDO(l,j,z)**(1+rho_LD(j,z))]/
1138                     SUM[lj$LDO(lj,j,z),WTIO(lj,j,z)*LDO(lj,j,z)
1139                     **(1+rho_LD(j,z))];
1140   B_LD(j,z)$LDCO(j,z)
1141                   = LDCO(j,z)/{SUM[l$LDO(l,j,z),beta_LD(l,j,z)*LDO(l,j,z)
1142                     **(-rho_LD(j,z))]**(-1/rho_LD(j,z))};
1143   
1144  *===============================================================================
1145  *   Composite E
1146  *===============================================================================
1147   rho_ENER(j,z)   = (1-sigma_ENER(j,z))/sigma_ENER(j,z);
1148   
1149   beta_ENER(ene,j,z)$DEO(ene,j,z)
1150                   = [PO4(ene,j,z)*DEO(ene,j,z)**(1+rho_ENER(j,z))]/
1151                     SUM[ene2$DIO(ene,j,z),DEO(ene2,j,z)**(1+rho_ENER(j,z))];
1152   
1153   B_ENER(j,z)$CEO(j,z)
1154                   = CEO(j,z)/{SUM[ene$DEO(ene,j,z),beta_ENER(ene,j,z)*DEO(ene,j,z)
1155                     **(-rho_ENER(j,z))]**(-1/rho_ENER(j,z))};
1156   
1157   B_ENER_t(j,z,time) = B_ENER(j,z)*(1/AEEI_low(z,'2019'));
1158   
1159  *==============================================================================
1160  *    4.6.3.5 Value added
1161  *==============================================================================
1162   sigma_VA('10_PETROLCOAL',z) = 1.260;
1163   display sigma_VA ;
1164   
1165   rho_VA(j,z)     = (1-sigma_VA(j,z))/sigma_VA(j,z);
1166   
1167   beta_VA(j,z)$KDCO(j,z)
1168                   = WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)/
1169                    {WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)+
1170                     RCO(j,z)*KDCO(j,z)**(rho_VA(j,z)+1)};
1171   B_VA(j,z)$KDCO(j,z)
1172                   = VAO(j,z)
1173                     /{[beta_VA(j,z)*LDCO(j,z)**(-rho_VA(j,z))+
1174                     (1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
1175                     ]**(-1/rho_VA(j,z))};
1176   
1177  *==============================================================================
1178  *    Composite KLE
1179  *==============================================================================
1180   KLEO(j,z)       = CEO(j,z) + VAO(j,z) ;
1181   
1182   PKLEO(j,z)      = [PCEO(j,z)*CEO(j,z)+PVAO(j,z)*VAO(j,z)]/KLEO(j,z);
1183   
1184   rho_KLE(j,z)    = (1-sigma_KLE(j,z))/sigma_KLE(j,z);
1185   
1186   beta_KLE(j,z)$KLEO(j,z)
1187                   = PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)/
1188                    {PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)+
1189                     PCEO(j,z)*CEO(j,z)**(rho_KLE(j,z)+1)};
1190   
1191   B_KLE(j,z)$KLEO(j,z)
1192                   = KLEO(j,z)
1193                     /{[beta_KLE(j,z)*VAO(j,z)**(-rho_KLE(j,z))+
1194                     (1-beta_KLE(j,z))*CEO(j,z)**(-rho_KLE(j,z))
1195                     ]**(-1/rho_KLE(j,z))};
1196   
1197  *==============================================================================
1198  *   4.6.4 Calibration of LES parameters
1199  *==============================================================================
1200  *   As the assigned values of income elasticities may not result in
1201  *   consumption shares that add up to 1, this first step
1202  *   adjusts the elasticities proportionally
1203   sigma_Y(i,z)    = sigma_Y(i,z)/{SUM[ij,sigma_Y(ij,z)*PCO(ij,z)*CO(ij,z)]
1204                     /CTHO(z)};
1205   gamma_LES(i,z)  = PCO(i,z)*CO(i,z)*sigma_Y(i,z)/CTHO(z);
1206   CMINO(i,z)      = CO(i,z)+gamma_LES(i,z)*CTHO(z)/{PCO(i,z)*frisch(z)};
1207   
1208  *==============================================================================
1209  *  4.7 Calibration of gross domestic products
1210  *==============================================================================
1211   GDP_BPO(z)      = SUM[j,PVAO(j,z)*VAO(j,z)]+TIPTO(z);
1212   GDP_MPO(z)      = GDP_BPO(z)+TPRCTSO(z);
1213   GDP_IBO(z)      = SUM[(l,j),WO(l,z)*LDO(l,j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1214                     +TPRODNO(z)+TPRCTSO(z);
1215   GDP_FDO(z)      = SUM[i,PCO(i,z)*(CO(i,z)+CGO(i,z)+INVO(i,z))]
1216                    +eO(z)*SUM[(i,zj),PWXO(i,z,zj)*EXO(i,z,zj)]
1217                    +eO(z)*SUM[i,PWMGO(i)*MRGNO(i,z)]
1218                    -eO(z)*SUM[(i,zj),IMO(i,zj,z)*(PWMO(i,zj,z)
1219                    +SUM{ij,PWMGO(ij)*tmrg(ij,i,zj,z)})];
1220   GDP_BP_WO       = SUM[z,GDP_BPO(z)/eO(z)];
1221   
1222  *==============================================================================
1223  *  4.8 Calibration of real (volume) variables computed from price indices
1224  *==============================================================================
1225   CABXO(z)        = CABO(z)/[PIXGDP_WO*eO(z)];
1226   
1227  *------------------------------------------------------------------------------
1228  * Calculation of CAB index
1229  * If every region's CABX grows exogenously according to exogro, then the
1230  * worldwide sum of CABX's will not be zero. If, due to redundancy, the reference
1231  * region's CABX is left implicit, then it will not grow according to that
1232  * region's exogro (it follows that the solution will depend on the choice of
1233  * reference region). CABix is formed from exogro by inflating or deflating the
1234  * updating factors of positive (SURplus) and negative (DEFicit) CABX's in such
1235  * a way that their sum remains zero.
1236   
      Parameter CABXsur(z,time), CABXdef(z,time), bal(time), mu(time), CABix(z,time);
       CABXsur(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) gt 0];
       CABXdef(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) lt 0];
       Bal(time)       = sum(zj,CABXsur(zj,time))+sum(zj,CABXdef(zj,time));
       mu(time)        = sum(zj,CABXsur(zj,time))/
                           {sum(zj,CABXsur(zj,time))+sum(zj,abs[CABXdef(zj,time)])};
       CABXsur(z,time) = CABXsur(z,time)*{1-mu(time)*Bal(time)/sum(zj,CABXsur(zj,time))};
       CABXdef(z,time) = CABXdef(z,time)*{1-[1-mu(time)]*Bal(time)/sum(zj,CABXdef(zj,time))};
       CABix(z,time)   = [CABXsur(z,time)+CABXdef(z,time)]/CABXO(z);
1248  *------------------------------------------------------------------------------
1249   
1250   CTH_REALO(z)    = CTHO(z)/PIXCONO(z);
1251   G_REALO(z)      = GO(z)/PIXGVTO(z);
1252   GDP_BP_REALO(z) = GDP_BPO(z)/PIXGDPO(z);
1253   GDP_BP_W_REALO  = GDP_BP_WO/PIXGDP_WO;
1254   GDP_MP_REALO(z) = GDP_MPO(z)/PIXCONO(z);
1255   IT_REALO(z)     = ITO(z)/PIXINVO(z);
1256   
1257  *==============================================================================
1258  *  4.9 Parameters of the household savings function
1259  *==============================================================================
1260  sh1O(z)         = SHO(z)/YDHO(z);
1261   sh0O(z)         = 0 ;
1262   
1263  * sh1O(z)         = [SHO(z)+SGO(z)]/GDP_IBO(z);
1264  * sh0O(z)         = SHO(z)-sh1O(z)*YDHO(z);
1265   
1266  *==============================================================================
1267  *  4.10 Re-calibration of indexed transfers and parameters
1268  *==============================================================================
1269   sh0O(z)         = sh0O(z)/PIXCONO(z)**eta;
1270   ttdh0O(z)       = ttdh0O(z)/PIXCONO(z)**eta;
1271   
1272  *==============================================================================
1273  *  4.9 CO2 emission
1274  *==============================================================================
INCLUDE    C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.RD_CGE\DATA_WEB-2019.gms
1276  Set flow, commodity
1277   
1278  flow flow
1279  /
1280  f1_INDPROD      Production
1281  f2_IMPORTS      Imports
1282  f3_EXPORTS      Exports
1283  f5_MARBUNK      International marine bunkers
1284  f4_AVBUNK       International aviation bunkers
1285  f6_STOCKCHA     Stock changes
