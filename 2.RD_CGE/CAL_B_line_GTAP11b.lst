3431   
3432  *==============================================================================
3433  * A. Initialization
3434  *    Assignment of initial values to variables prior to resolution
3435  *==============================================================================
3436  *  A.1 Initialization for the first period
3437  *==============================================================================
3438  *   A.1.1 Volume variables
3439  *==============================================================================
3440   CABX.L(z,t1)      = CABXO(z);
3441   C.L(i,z,t1)       = CO(i,z);
3442   CG.L(i,z,t1)      = CGO(i,z);
3443   CI.L(j,z,t1)      = CIO(j,z);
3444   CE.L(j,z,t1)      = CEO(j,z);
3445   CMIN.L(i,z,t1)    = CMINO(i,z);
3446   CTH_REAL.L(z,t1)  = CTH_REALO(z);
