2586  *  4.12 CO2FACTOR and CTAX
2587  *==============================================================================
2588  Parameters
2589   CO2FACTOR(ene,j,z)       CO2 emissions factor (tCO2 per 100$)
2590   CO2FACTOR2(ene,j,z,time) Time series CO2 emissions factor (tCO2 per 100$)
2591   CTAX0(z)                 initial Carbon tax $ per ton CO2
2592   TCTAX0(z)                initial Government Revenue from Carbon tax
2593  ;
2594   
2595  * CO2FACTOR(ene,j,z) = 0 ;
2596   CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*(1000/(10**8));
2597   CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z) = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*(1000/(10**8));
2598   CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*(1000/(10**8));
2599   
2600  * CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*10/100;
2601  * CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z) = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*10/100;
2602  * CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*10/100;
2603   
2604  *PetrolCoal
2605   CO2FACTOR('10_PETROLCOAL','10_PETROLCOAL',z) = 0;
2606   
2607  *PRK
2608   CO2FACTOR('02_COAL','01_AGRICULT','06_PRK')        = CO2FACTOR('02_COAL','01_AGRICULT','05_MNG');
2609   CO2FACTOR('10_PETROLCOAL','01_AGRICULT','06_PRK')  = CO2FACTOR('10_PETROLCOAL','01_AGRICULT','05_MNG');
2610   CO2FACTOR('02_COAL','28_LTRP','06_PRK')            = CO2FACTOR('02_COAL','28_LTRP','05_MNG');
2611   CO2FACTOR('02_COAL','17_OTHERIND','06_PRK')        = CO2FACTOR('02_COAL','17_OTHERIND','05_MNG');
2612   
2613  *RUS
2614   CO2FACTOR('02_COAL','08_WOODPRO','04_RUS')         = CO2FACTOR('02_COAL','08_WOODPRO','10_EEU');
2615   
2616  *LAM
2617   CO2FACTOR('04_GAS','02_COAL','08_LAM')             = CO2FACTOR('04_GAS','02_COAL','07_NAM');
2618   
2619   CTAX0(z) = 0 ;
2620   
2621   TCTAX0(z) = 0;
2622   
