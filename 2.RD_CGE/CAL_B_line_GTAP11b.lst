2591   ElecbioGWh('26_eOther',z)    = sum((f_elecoutput, p_elecbio), WEB(f_elecoutput, p_elecbio,z));
2592   ElecgeoGWh('26_eOther',z)    = sum((f_elecoutput, p_elecgeo), WEB(f_elecoutput, p_elecgeo,z));
