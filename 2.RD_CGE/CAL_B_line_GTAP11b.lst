3968  *   6.1.3 Closures
3969  *==============================================================================
3970  *$ontext
3971  * FP CLOSURE: fixed PIXGDPs; numeraire is exchange rate of reference region
3972  * The exchange rates are endogenous, except for the reference region.
3973   e.FX(zr,time)      = eO(zr);
3974   PIXGDP.FX(z,time)  = PIXGDPO(z)/sum[zr,eO(zr)];
3975  *$offtext
3976   
      * FE CLOSURE: fixed exchange rates; numeraire is PIXGDP of reference region
      * The exchange rates can be fixed at arbitrary values
       PIXGDP.FX(zr,time)  = PIXGDPO(zr);
       e.FX(z,time)        = eO(z);
3983   
3984   phi.fx(z,time)       = phio(z);
3985   ttdh0.fx(z,time)     = ttdh0O(z);
3986   ttdh1.fx(z,time)     = ttdh1O(z);
3987   ttic.fx(i,z,time)    = tticO(i,z);
3988   ttik.fx(k,j,z,time)  = ttikO(k,j,z);
3989   ttim.fx(i,zj,z,time) = ttimO(i,zj,z);
3990   ttip.fx(j,z,time)    = ttipO(j,z);
3991   ttiw.fx(l,j,z,time)  = ttiwO(l,j,z);
3992   ttix.fx(i,z,zj,time) = ttixO(i,z,zj);
