2923  ;
2924   
2925  *==============================================================================
2926  *  5.3 Equations
2927  *==============================================================================
2928  *   5.3.1 Production
2929  *==============================================================================
2930   EQ1(j3,z,t)..     VA(j3,z,t) =e= v(j3,z)*XST(j3,z,t);
2931   
2932   EQ1_1(j2,z,t)..   KLE(j2,z,t) =e= v2(j2,z)*XST(j2,z,t);
2933   
2934   EQ2(j,z,t)..      CI(j,z,t) =e= io(j,z)*XST(j,z,t);
2935   
2936   EQ2_1(j3,z,t)..   CE(j3,z,t) =e= io2(j3,z)*XST(j3,z,t);
2937   
2938   EQ3(j,z,t)..      VA(j,z,t) =e= A_VA(z,t)*B_VA(j,z)*{
2939                      [beta_VA(j,z)*LDC(j,z,t)**(-rho_VA(j,z))]$LDCO(j,z)
2940                     +[(1-beta_VA(j,z))*KDC(j,z,t)**(-rho_VA(j,z))]$KDCO(j,z)
2941                                                     }**(-1/rho_VA(j,z));
2942   
2943   EQ3_1(j2,z,t)..   KLE(j2,z,t) =e= B_KLE(j2,z)*{
2944                      [beta_KLE(j2,z)*VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
2945                     +[(1-beta_KLE(j2,z))*CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
2946                                                     }**(-1/rho_KLE(j2,z));
2947   
2948   EQ4(j,z,t)$[LDCO(j,z) and KDCO(j,z)]..
2949                   LDC(j,z,t) =e= {[beta_VA(j,z)/(1-beta_VA(j,z))]
2950                                *[RC(j,z,t)/WC(j,z,t)]}**sigma_VA(j,z)*KDC(j,z,t);
2951   
2952   EQ4_1(j2,z,t)$[VAO(j2,z) and CEO(j2,z)]..
2953                   VA(j2,z,t) =e= {[beta_KLE(j2,z)/(1-beta_KLE(j2,z))]
2954                                *[PCE(j2,z,t)/PVA(j2,z,t)]}**sigma_KLE(j2,z)*CE(j2,z,t);
2955   
2956   EQ5(j,z,t)$LDCO(j,z)..
2957                   LDC(j,z,t) =e= B_LD(j,z)*SUM[l$LDO(l,j,z),beta_LD(l,j,z)
2958                                  *LD(l,j,z,t)**(-rho_LD(j,z))]**(-1/rho_LD(j,z));
2959   
2960   EQ6(l,j,z,t)$LDO(l,j,z)..
2961                   LD(l,j,z,t) =e= [beta_LD(l,j,z)*WC(j,z,t)/WTI(l,j,z,t)]
2962                                 **sigma_LD(j,z)*B_LD(j,z)**(sigma_LD(j,z)-1)
2963                                 *LDC(j,z,t);
2964   
2965   EQ7(j,z,t)$KDCO(j,z)..
2966                   KDC(j,z,t) =e= B_KD(j,z)*SUM[k$KDO(k,j,z),beta_KD(k,j,z)
2967                                  *KD(k,j,z,t)**(-rho_KD(j,z))]**(-1/rho_KD(j,z));
2968   
2969   EQ8(k,j,z,t)$KDO(k,j,z)..
2970                   KD(k,j,z,t) =e= [beta_KD(k,j,z)*RC(j,z,t)/RTI(k,j,z,t)]
2971                                   **sigma_KD(j,z)*B_KD(j,z)**(sigma_KD(j,z)-1)
2972                                   *KDC(j,z,t);
2973   
2974   EQ9(nene,j,z,t)..   DI(nene,j,z,t) =e= aij(nene,j,z)*CI(j,z,t) ;
2975   
2976   EQ9_1(ene,j3,z,t)..  DE(ene,j3,z,t)   =e= aij2(ene,j3,z)*CE(j3,z,t) ;
2977   
2978  * EQ9_2(ene,j2,z,t)..  DE(ene,j2,z,t) =e= [beta_ENER(ene,j2,z)*PCE(j2,z,t)/P4(ene,j2,z,t)]
2979  *                                   **sigma_ENER(j2,z)*B_ENER_t(j2,z,t)**(sigma_ENER(j2,z)-1)
2980  *                                   *CE(j2,z,t);
2981   
2982   EQ9_2(ene,j2,z,t)..  DE(ene,j2,z,t) =e= [beta_ENER(ene,j2,z)*PCE(j2,z,t)/((P4(ene,j2,z,t)+P4(ene,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j2,z,t)))]
2983                                     **sigma_ENER(j2,z)*B_ENER_t(j2,z,t)**(sigma_ENER(j2,z)-1)
2984                                     *CE(j2,z,t);
2985   
2986   
2987  *==============================================================================
2988  *   5.3.2 Income and savings
2989  *==============================================================================
2990  *    5.3.2.1 Households
2991  *==============================================================================
2992  * EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t);
2993   EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t)+TCTAX(z,t);
2994   
2995   EQ11(z,t)..       YHL(z,t) =e= SUM[(l,j)$LDO(l,j,z),W(l,z,t)*LD(l,j,z,t)];
2996   
2997   EQ12(z,t)..       YHK(z,t) =e= SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*KD(k,j,z,t)];
2998   
2999   EQ13(z,t)..       YDH(z,t) =e= YH(z,t)-TDH(z,t);
3000   
3001   EQ14(z,t)..       CTH(z,t) =e= YDH(z,t)-SH(z,t);
3002   
3003  * CALEQ1(z,t)..     SH(z,t)+SG(z,t) =e= sh1(z,t)*GDP_IB(z,t);
3004   
3005  * EQ15(z,t)..        SH(z,t)+SG(z,t) =e= sh1(z,t)*GDP_IB(z,t);
3006   EQ15(z,t)..       SH(z,t) =e= sh1(z,t)*YDH(z,t);
3007  * EQ15(z,t)..       SH(z,t) =e= PIXCON(z,t)**eta*sh0(z,t)+sh1(z,t)*YDH(z,t);
3008   
3009  *==============================================================================
3010  *    5.3.2.2 Government
3011  *==============================================================================
3012   EQ16(z,t)..       YG(z,t) =e= TDH(z,t)+TPRODN(z,t)+TPRCTS(z,t)+TCTAX(z,t);
3013   
3014   EQ16_1(z,t)..     TCTAX(z,t) =e= sum((ene,j), PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t));
3015   
3016   EQ17(z,t)..       TPRODN(z,t) =e= TIWT(z,t)+TIKT(z,t)+TIPT(z,t);
3017   
3018   EQ18(z,t)..       TIWT(z,t) =e= SUM[(l,j)$LDO(l,j,z),TIW(l,j,z,t)];
3019   
3020   EQ19(z,t)..       TIKT(z,t) =e= SUM[(k,j)$KDO(k,j,z),TIK(k,j,z,t)];
3021   
3022   EQ20(z,t)..       TIPT(z,t) =e= SUM[j,TIP(j,z,t)];
3023   
3024   EQ21(z,t)..       TPRCTS(z,t) =e= TICT(z,t)+TIMT(z,t)+TIXT(z,t);
3025   
3026   EQ22(z,t)..       TICT(z,t) =e= SUM[i,TIC(i,z,t)];
3027   
3028   EQ23(z,t)..       TIMT(z,t) =e= SUM[(i,zj)$IMO(i,zj,z),TIM(i,zj,z,t)];
3029   
3030   EQ24(z,t)..       TIXT(z,t) =e= SUM[(i,zj)$EXO(i,z,zj),TIX(i,z,zj,t)];
3031   
3032   EQ25(z,t)..       TDH(z,t) =e= PIXCON(z,t)**eta*ttdh0(z,t)+ttdh1(z,t)*YH(z,t);
3033   
3034   EQ26(l,j,z,t)$LDO(l,j,z)..
3035                   TIW(l,j,z,t) =e= ttiw(l,j,z,t)*W(l,z,t)*LD(l,j,z,t);
3036   
3037   EQ27(k,j,z,t)$KDO(k,j,z)..
3038                   TIK(k,j,z,t) =e= ttik(k,j,z,t)*R(k,j,z,t)*KD(k,j,z,t);
3039   
3040   EQ28(j,z,t)..     TIP(j,z,t) =e= ttip(j,z,t)*PP(j,z,t)*XST(j,z,t);
3041   
3042   EQ29(i,z,t)..     TIC(i,z,t) =e= ttic(i,z,t)*{[PL(i,z,t)*DD(i,z,t)]$DDO(i,z)
3043                   +[SUM[zj$IMO(i,zj,z),(1+ttim(i,zj,z,t))*IM(i,zj,z,t)*e(z,t)
3044                    *(PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z)))]]};
3045   
3046   EQ30(i,zj,z,t)$IMO(i,zj,z)..
3047                   TIM(i,zj,z,t) =e= ttim(i,zj,z,t)*IM(i,zj,z,t)*e(z,t)*
3048                                     (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
3049                                     *tmrg(ij,i,zj,z)]);
3050   
3051   EQ31(i,z,zj,t)$EXO(i,z,zj)..
3052                   TIX(i,z,zj,t) =e= ttix(i,z,zj,t)*PE(i,z,zj,t)*EX(i,z,zj,t);
3053   
3054   EQ32(z,t)..       SG(z,t) =e= YG(z,t)-G(z,t)-TCTAX(z,t);
3055   
3056  *==============================================================================
3057  *    5.3.2.4 Rest of the world
3058  *==============================================================================
3059   EQ33(z,t)..       YROW(z,t) =e= e(z,t)*SUM{(i,zj)$IMO(i,zj,z),IM(i,zj,z,t)*
3060                             [PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z))]};
3061   
3062   EQ34(z,t)..       SROW(z,t) =e= YROW(z,t)-e(z,t)*SUM[(i,zj)$EXO(i,z,zj),
3063                                 EX(i,z,zj,t)*PWX(i,z,zj,t)]-e(z,t)
3064                                 *SUM[i$MRGNO(i,z),MRGN(i,z,t)*PWMG(i,t)];
3065   
3066   EQ35(z,t)..       SROW(z,t) =e= -CAB(z,t);
3067   
3068  *==============================================================================
3069  *   5.3.3 Demand
3070  *==============================================================================
3071   EQ36(i,z,t)..     PC(i,z,t)*C(i,z,t) =e= PC(i,z,t)*CMIN(i,z,t)+gamma_LES(i,z)
3072                                   *{CTH(z,t)-SUM[ij,PC(ij,z,t)*CMIN(ij,z,t)]};
3073   
3074   EQ37(i,z,t)..     PC(i,z,t)*INV(i,z,t) =e= gamma_INV(i,z)*IT(z,t);
3075   
3076   EQ38(i,z,t)..     PC(i,z,t)*CG(i,z,t) =e= gamma_GVT(i,z)*G(z,t);
3077   
3078   CALEQ2(z,t)..     G(z,t) =e= GO(z)*GDP_BP(z,t)/GDP_BPO(z);
3079   
3080   EQ39(nene,z,t)..   DIT(nene,z,t) =e= SUM[j,DI(nene,j,z,t)];
3081   
3082   EQ39_1(ene,z,t)..  DIT(ene,z,t) =e= SUM[j,DE(ene,j,z,t)];
3083   
3084  *==============================================================================
3085  *   5.3.4 International trade
3086  *==============================================================================
       EQB_1(i,z)..    XS_I(i,z) =e= B_X3(i,z)*SUM[j$XSO(j,i,z),beta_X3(j,i,z)
                                      *XS(j,i,z)**(-rho_X3(i,z))]**(-1/rho_X3(i,z));
       
       EQB_2(j,i,z)${DSO(j,i,z) and [DSO(j,i,z) ne DSO_I(i,z)]}..
                       XS(j,i,z) =e= XS_I(i,z)/B_X3(i,z)**(1-sigma_X3(i,z))*
                                     [beta_X3(j,i,z)*PI(i,z)/P2(j,i,z)]
                                     **sigma_X3(i,z);
       
       EQB_3(j,i,z)${DSO(j,i,z)}..   P2(j,i,z) =e= PT(j,z);
       
       EQB_4(j,i,z)$DSO(j,i,z)..
                       P2(j,i,z)*XS(j,i,z) =e= [PET(i,z)*EXTT(j,i,z)]$EXTTO(j,i,z)
                                              +[e(z)*MRGN(i,z)*PWMG(i)]$MRGNO(i,z)
                                              +[PL(i,z)*DS(j,i,z)]$DSO(j,i,z);
       
       EQB_5(j,i,z)$DSO(j,i,z)..  EXTT(j,i,z)  =e= theta2(j,i,z)*EXT(i,z);
3105   
3106  *[Top Nest - Leontief function]
3107   EQA_1(z,t)..  XS('18_TnD','18_ELEC',z,t) =e= TnDShare(z)*XS_I('18_ELEC',z,t);
3108   EQA_2(z,t)..  XS_I('18_ELEC',z,t) =e= XS('18_TnD','18_ELEC',z,t) + POWERQ(z,t);
3109   
3110   
3111  *[Second Nest - CES function]
3112   EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
3113                                  *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
3114   
3115   EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
3116                                 [beta_X4(power,z)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
3117                                 **sigma_X4(z);
3118   
3119  * exclude electiricity
3120   EQB_1(i2,z,t)..    XS_I(i2,z,t) =e= B_X3(i2,z)*SUM[j$XSO(j,i2,z),beta_X3(j,i2,z)
3121                                  *XS(j,i2,z,t)**(-rho_X3(i2,z))]**(-1/rho_X3(i2,z));
3122   
3123   
3124   EQB_3(j,i,z,t)${DSO(j,i,z)}..   P2(j,i,z,t) =e= PT(j,z,t);
3125   
3126   EQB_4(j,i,z,t)$DSO(j,i,z)..
3127                   P2(j,i,z,t)*XS(j,i,z,t) =e= [PET(i,z,t)*EXTT(j,i,z,t)]$EXTTO(j,i,z)
3128                                          +[e(z,t)*MRGN(i,z,t)*PWMG(i,t)]$MRGNO(i,z)
3129                                          +[PL(i,z,t)*DS(j,i,z,t)]$DSO(j,i,z);
3130   
3131   EQB_5(j,i,z,t)$DSO(j,i,z)..  EXTT(j,i,z,t)  =e= theta2(j,i,z)*EXT(i,z,t);
3132   
3133   EQ40_3(i,z,t)..   DS_I(i,z,t) =e= sum(j,DS(j,i,z,t)$DSO(j,i,z));
3134   
3135   EQ40_4(j,z,t)..   XST(j,z,t)  =e= sum(i,XS(j,i,z,t)$XSO(j,i,z));
3136   
3137   EQ40_5(i,z,t)..   XS_I(i,z,t) =e= B_X1(i,z)*{
3138                   [beta_EX_X1(i,z)*EXT(i,z,t)**rho_X1(i,z)]$EXTO(i,z)
3139                  +[beta_D_X1(i,z)*DS_I(i,z,t)**rho_X1(i,z)]$DSO_I(i,z)
3140                  +[(1-beta_EX_X1(i,z)-beta_D_X1(i,z))*MRGN(i,z,t)**rho_X1(i,z)]$MRGNO(i,z)
3141                                            }**(1/rho_X1(i,z));
3142   
3143   EQ41(i,z,t)$[EXTO(i,z) and DSO_I(i,z)]..
3144                   EXT(i,z,t) =e= {[beta_D_X1(i,z)/beta_EX_X1(i,z)]*[PET(i,z,t)/PL(i,z,t)]}
3145                                **sigma_X1(i,z)*DS_I(i,z,t);
3146   
3147   EQ42(i,z,t)$[MRGNO(i,z) and DSO_I(i,z)]..
3148                   MRGN(i,z,t) =e= {[beta_D_X1(i,z)/(1-beta_EX_X1(i,z)
3149                                   -beta_D_X1(i,z))]*[e(z,t)*PWMG(i,t)/PL(i,z,t)]}
3150                                   **sigma_X1(i,z)*DS_I(i,z,t);
3151   
3152   EQ43(i,z,t)$EXTO(i,z)..
3153                   EXT(i,z,t) =e= B_X2(i,z)*SUM[zj$EXO(i,z,zj),beta_X2(i,z,zj)
3154                                  *EX(i,z,zj,t)**rho_X2(i,z)]**(1/rho_X2(i,z));
3155   
3156   EQ44(i,z,zj,t)$EXO(i,z,zj)..
3157                   EX(i,z,zj,t) =e= EXT(i,z,t)/B_X2(i,z)**(1+sigma_X2(i,z))*
3158                                    [PE(i,z,zj,t)/(beta_X2(i,z,zj)*PET(i,z,t))]
3159                                    **sigma_X2(i,z);
3160   
3161   EQ45(i,z,t)..     Q(i,z,t) =e= B_M1(i,z)*{
3162                      [beta_M1(i,z)*IMT(i,z,t)**(-rho_M1(i,z))]$IMTO(i,z)
3163                     +[(1-beta_M1(i,z))*DD(i,z,t)**(-rho_M1(i,z))]$DDO(i,z)
3164                                          }**(-1/rho_M1(i,z));
3165   
3166   EQ46(i,z,t)$[IMTO(i,z) and DDO(i,z)]..
3167                   IMT(i,z,t) =e= {[beta_M1(i,z)/(1-beta_M1(i,z))]*[PD(i,z,t)
3168                                  /PMT(i,z,t)]}**sigma_m1(i,z)*DD(i,z,t);
3169   
3170   EQ47(i,z,t)$IMTO(i,z)..
3171                   IMT(i,z,t) =e= B_M2(i,z)*SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*
3172                                  IM(i,zj,z,t)**(-rho_M2(i,z))]**(-1/rho_M2(i,z));
3173   
3174   EQ48(i,zj,z,t)$IMO(i,zj,z)..
3175                   IM(i,zj,z,t) =e= IMT(i,z,t)/B_M2(i,z)**(1-sigma_M2(i,z))*
3176                                    [beta_M2(i,zj,z)*PMT(i,z,t)/PM(i,zj,z,t)]
3177                                    **sigma_M2(i,z);
3178   
3179  *==============================================================================
3180  *   5.3.5 Prices
3181  *==============================================================================
3182   EQ49(j2,z,t)..     PP(j2,z,t)*XST(j2,z,t) =e= PKLE(j2,z,t)*KLE(j2,z,t)+PCI(j2,z,t)*CI(j2,z,t);
3183   
3184   EQ49_1(j3,z,t)..   PP(j3,z,t)*XST(j3,z,t) =e= PVA(j3,z,t)*VA(j3,z,t)+PCI(j3,z,t)*CI(j3,z,t)+PCE(j3,z,t)*CE(j3,z,t);
3185   
3186   EQ50(j,z,t)..     PT(j,z,t) =e= (1+ttip(j,z,t))*PP(j,z,t);
3187   
3188   EQ51(j,z,t)..     PCI(j,z,t)*CI(j,z,t) =e= SUM[nene,PC(nene,z,t)*DI(nene,j,z,t)];
3189   
3190   EQ51_1(j,z,t)..   PCE(j,z,t)*CE(j,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j,z,t) + PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t)];
3191   
3192   EQ52(j,z,t)..     PVA(j,z,t)*VA(j,z,t) =e= [WC(j,z,t)*LDC(j,z,t)]$LDCO(j,z)
3193                                       +[RC(j,z,t)*KDC(j,z,t)]$KDCO(j,z);
3194   
3195   EQ52_1(j2,z,t)..   PKLE(j2,z,t)*KLE(j2,z,t) =e= [PVA(j2,z,t)*VA(j2,z,t)]$VAO(j2,z)
3196                                         +[PCE(j2,z,t)*CE(j2,z,t)]$CEO(j2,z);
3197   
3198  * Given equations 5 and 6, equation 53 is redundant
3199  * EQ53(j,z)..     WC(j,z)*LDC(j,z) =e= SUM[l$LDO(l,j,z),WTI(l,j,z)*LD(l,j,z)];
3200   
3201   EQ54(l,j,z,t)$LDO(l,j,z)..
3202                   WTI(l,j,z,t) =e= W(l,z,t)*(1+ttiw(l,j,z,t));
3203   
3204   EQ54_1(ene,j2,z,t)$DEO(ene,j2,z)..
3205                   P4(ene,j2,z,t) =e= PC(ene,z,t);
3206   
3207  * Given equations 7 and 8, equation 55 is redundant
3208  * EQ55(j,z)$(kmob and KDCO(j,z))..
3209  *                 RC(j,z)*KDC(j,z) =e= SUM[k$KDO(k,j,z),RTI(k,j,z)*KD(k,j,z)];
3210   
3211   EQ56(k,j,z,t)$KDO(k,j,z)..
3212                   RTI(k,j,z,t) =e= R(k,j,z,t)*(1+ttik(k,j,z,t));
3213   
3214  * EQ57(k,j,z,t)$(kmob and KDO(k,j,z))..
3215  *                 R(k,j,z,t) =e= RK(k,z,t);
3216   
3217  * EQ58(j,z)..     P(j,z)*XST(j,z) =e= [PL(j,z)*DS(j,z)]$DSO(j,z)
3218  *                                   +[PET(j,z)*EXT(j,z)]$EXTO(j,z)
3219  *                                   +[e(z)*PWMG(j)*MRGN(j,z)]$MRGNO(j,z);
3220   
3221   EQ58(i,z,t)..     P(i,z,t)*XS_I(i,z,t) =e= [PL(i,z,t)*DS_I(i,z,t)]$DSO_I(i,z)
3222                                       +[PET(i,z,t)*EXT(i,z,t)]$EXTO(i,z)
3223                                       +[e(z,t)*PWMG(i,t)*MRGN(i,z,t)]$MRGNO(i,z);
3224   
3225  * Given equations 43 and 44, equation 59 is redundant
3226  * EQ59(i,z)$EXTO(i,z)..
3227  *                 PET(i,z)*EXT(i,z) =e= SUM[zj$EXO(i,z,zj),
3228  *                                           PE(i,z,zj)*EX(i,z,zj);
3229   
3230   EQ60(i,z,zj,t)$EXO(i,z,zj)..
3231                   PE(i,z,zj,t)*(1+ttix(i,z,zj,t)) =e= e(z,t)*PWX(i,z,zj,t);
3232   
3233   EQ61(i,z,t)$DDO(i,z)..
3234                   PD(i,z,t) =e= (1+ttic(i,z,t))*PL(i,z,t);
3235   
3236   EQ62(i,zj,z,t)$IMO(i,zj,z)..
3237                   PM(i,zj,z,t) =e= (1+ttic(i,z,t))*(1+ttim(i,zj,z,t))*e(z,t)*
3238                                    (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
3239                                    *tmrg(ij,i,zj,z)]);
3240   
3241  * Given equations 47 and 48, equation 63 is redundant
3242  * EQ63(i,z)$IMTO(i,z)..
3243  *                 PMT(i,z)*IMT(i,z) =e= SUM[zj$IMO(i,zj,z),
3244  *                                           PM(i,zj,z)*IM(i,zj,z);
3245   
3246   EQ64(i,z,t)..     PC(i,z,t)*Q(i,z,t) =e= [PD(i,z,t)*DD(i,z,t)]$DDO(i,z)+
3247                                      [PMT(i,z,t)*IMT(i,z,t)]$IMTO(i,z);
3248   
3249  * EQ65(z,t)..       PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
3250  *                               /gamma_INV(i,z))**gamma_INV(i,z)];
3251   
3252   EQ66(z,t)..       PIXGDP(z,t) =e=
3253                   {SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)]
3254                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
3255                   *SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)]
3256                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)]}**0.5;
3257   
3258   EQ67(t)..         PIXGDP_W(t) =e=
3259                   {SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)/e(z,t)]
3260                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
3261                   *SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)/e(z,t)]
3262                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)/eO(z)]}**0.5;
3263   
3264   EQ68(z,t)..       PIXCON(z,t) =e= SUM[i,PC(i,z,t)*CO(i,z)]/SUM[i,PCO(i,z)*CO(i,z)];
3265   
3266   EQ69(z,t)..       PIXINV(z,t) =e= PROD[i$gamma_INV(i,z),(PC(i,z,t)/PCO(i,z))
3267                                   **gamma_INV(i,z)];
3268   
3269   EQ70(z,t)..       PIXGVT(z,t) =e= PROD[i$gamma_GVT(i,z),(PC(i,z,t)/PCO(i,z))
3270                                   **gamma_GVT(i,z)];
3271   
3272  *==============================================================================
3273  *   5.3.6 Equilibrium
3274  *==============================================================================
3275   EQ71(i1,z,t)..    Q(i1,z,t) =e= C(i1,z,t)+CG(i1,z,t)+INV(i1,z,t)+DIT(i1,z,t);
3276   
3277   EQ72(l,z,t)..     LS(l,z,t) =e= SUM[j$LDO(l,j,z),LD(l,j,z,t)];
3278   
3279   EQ73(k,z,t)$KSO(k,z)..
3280                     KS(k,z,t) =e= SUM[j$KDO(k,j,z),KD(k,j,z,t)];
3281   
3282   EQ74(z,t)..       IT(z,t) =e= SH(z,t)+SG(z,t)-CAB(z,t);
3283   
3284   EQ75(z,t)..       DEP(z,t) =e= PK(z,t)*delta(z)*SUM[k$KSO(k,z),KS(k,z,t)];
3285   
3286   EQ76(i,z,t)$DDO(i,z)..
3287                     SUM[j$DSO(j,i,z),DS(j,i,z,t)] =e= DD(i,z,t);
3288   
3289   EQ77(i,z,zj,t)$EXO(i,z,zj)..
3290                     EX(i,z,zj,t) =e= IM(i,z,zj,t);
3291   
3292   EQ78(i,z,zj,t)$EXO(i,z,zj)..
3293                     PWX(i,z,zj,t) =e= PWM(i,z,zj,t);
3294   
3295   EQ79(i,t)..       SUM[z$MRGNO(i,z),MRGN(i,z,t)] =e= SUM[(z,zj,ij)$IMO(ij,zj,z),
3296                                                   tmrg(i,ij,zj,z)*IM(ij,zj,z,t)];
3297   
3298  * Given equations 33, 34 and 77, equation 80 is redundant
3299  * EQ80..          SUM[z,SROW(z)/e(z)] =e= 0;
3300   
3301  *==============================================================================
3302  *   5.3.7 Gross domestic product
3303  *==============================================================================
3304   EQ81(z,t)..       GDP_BP(z,t) =e= SUM[j,PVA(j,z,t)*VA(j,z,t)]+TIPT(z,t);
3305   
3306   EQ82(z,t)..       GDP_MP(z,t) =e= GDP_BP(z,t)+TPRCTS(z,t);
3307   
3308   EQ83(z,t)..       GDP_IB(z,t) =e= SUM[(l,j)$LDO(l,j,z),W(l,z,t)*LD(l,j,z,t)]
3309                                +SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*KD(k,j,z,t)]
3310                                +TPRCTS(z,t)+TPRODN(z,t);
3311   
3312   EQ84(z,t)..       GDP_FD(z,t) =e=
3313                   SUM[i,PC(i,z,t)*(C(i,z,t)+CG(i,z,t)+INV(i,z,t))]
3314                  +SUM[(i,zj)$EXO(i,z,zj),e(z,t)*PWX(i,z,zj,t)*EX(i,z,zj,t)]
3315                  +SUM[i$MRGNO(i,z),e(z,t)*PWMG(i,t)*MRGN(i,z,t)]
3316                  -SUM[(i,zj)$IMO(i,zj,z),e(z,t)*IM(i,zj,z,t)
3317                      *(PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)*tmrg(ij,i,zj,z)])]-TCTAX(z,t);
3318   
3319   EQ85(t)..          GDP_BP_W(t) =e= SUM[z,GDP_BP(z,t)/e(z,t)];
3320   
3321  *==============================================================================
3322  *  5.3.8 Real (volume) variables computed from price indices
3323  *==============================================================================
3324   EQ86(z,t)..       CTH_REAL(z,t) =e= CTH(z,t)/PIXCON(z,t);
3325   
3326   EQ87(z,t)..       G_REAL(z,t) =e= G(z,t)/PIXGVT(z,t);
3327   
3328   EQ88(z,t)..       GDP_BP_REAL(z,t) =e= GDP_BP(z,t)/PIXGDP(z,t);
3329   
3330   EQ89(t)..         GDP_BP_W_REAL(t) =e= GDP_BP_W(t)/PIXGDP_W(t);
3331   
3332   EQ90(z,t)..       GDP_MP_REAL(z,t) =e= GDP_MP(z,t)/PIXCON(z,t);
3333   
3334   EQ91(z,t)..       IT_REAL(z,t) =e= IT(z,t)/PIXINV(z,t);
3335   
3336   EQ92(z,t)..       CABX(z,t) =e= CAB(z,t)/[PIXGDP_W(t)*e(z,t)];
3337   
3338   EQ93..            OBJ =e= 1;
3339   
3340  *==============================================================================
3341  *   5.3.8 Dynamic equations
3342  *==============================================================================
3343   EQ94(z,t)..     IT(z,t) =e= PK(z,t)*SUM[(k,j)$KDO(k,j,z),IND(k,j,z,t)];
3344   
3345   EQ95(z,t)..     PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
3346                                 /gamma_INV(i,z))**gamma_INV(i,z)];
3347   
3348   EQ96(k,bus,z,t)$KDO(k,bus,z)..
3349                   IND(k,bus,z,t) =e= phi(z,t)*[R(k,bus,z,t)/U(z,t)]
3350                                    **sigma_INV(k,bus,z)*KD(k,bus,z,t);
3351   
3352   CALEQ3(k,pub,z,t)$KDO(k,pub,z)..
3353                   IND(k,pub,z,t)*PK(z,t) =e= INDO(k,pub,z)*PKO(z)*GDP_BP(z,t)
3354                                              /GDP_BPO(z);
3355   
3356  * EQ97a(z,t)..    IR(z,t) =e= {SUM[(k,j)$KDO(k,j,z),
3357  *                              R(k,j,z,t)*KD(k,j,z,t)]-DEP(z,t)}/
3358  *                             {PK(z,t)*SUM[(k,j)$KDO(k,j,z),KD(k,j,z,t)]};
3359   
3360   EQ97b(z,t)..    U(z,t) =e= PK(z,t)*(delta(z)+IR(z,t));
3361   
3362  * EQ98(k,j,z,t)$KDO(k,j,z).. PK(z,t)*IND(k,j,z,t) =e= [R(k,j,z,t)**1*KD(k,j,z,t)/sum((kj,jj)$KDO(kj,jj,z),R(k,j,z,t)**1*KD(kj,jj,z,t))]*IT(z,t);
3363   
3364  *==============================================================================
3365  *   5.3.10 Other
3366  *==============================================================================
3367   WALRAS(z,t)..   LEON(z,t) =e= Q('01_AGRICULT',z,t)-C('01_AGRICULT',z,t)-CG('01_AGRICULT',z,t)-INV('01_AGRICULT',z,t)
3368                              -DIT('01_AGRICULT',z,t);
3369   
3370  *==============================================================================
3371  * 6 Numerical resolution to compute A_VA, sh0, G, G_REAL and IND
3372  *==============================================================================
3373  *option cns = Snopt;
3374  *option cns = Ipopt;
3375  *option NLP = Ipopt;
3376   
3377  *option cns = path;
3378  *option cns = conopt4;
3379  *option NLP = conopt4;
3380  *option NLP = minos;
3381  *option NLP = pathnlp ;
3382   
3383  *option iterlim = 100;
3384  *option iterlim = 0;
3385   
3386  * Eliminating display of solution makes it easier to check whether model solves
3387  * and to identify year when it crashes.
3388  option limrow=0, limcol=0, solprint = off;
3389  *option limrow=0, limcol=0, iterlim= 100 ;
3390  *option limrow=100 ;
3391  *option reslim = 1000;
3392   
3393  MODEL PEPWT World wide dynamic model /all/ ;
3394  PEPWT.holdfixed=1;
3395   
3396  *==============================================================================
3397  *  6.1 Resolution
3398  *==============================================================================
3399   
3400  LOOP[time,
3401  T(time) = YES;
3402   
