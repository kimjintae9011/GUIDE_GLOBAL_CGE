3496  *==============================================================================
3497  *option cns = Snopt;
3498  *option cns = Ipopt;
3499  *option cns = path;
3500  *option cns = conopt4;
3501   
3502  *option NLP = Ipopt;
3503  *option NLP = conopt4;
3504  *option NLP = minos;
3505  *option NLP = pathnlp ;
3506   
3507  *option iterlim = 100;
3508  *option iterlim = 0;
3509   
3510  * Eliminating display of solution makes it easier to check whether model solves
3511  * and to identify year when it crashes.
3512  option limrow=0, limcol=0, solprint = off;
3513  *option limrow=0, limcol=0, iterlim= 100 ;
3514  *option limrow=100 ;
3515  *option reslim = 1000;
3516   
3517  MODEL PEPWT World wide dynamic model /all/ ;
3518  PEPWT.holdfixed=1;
