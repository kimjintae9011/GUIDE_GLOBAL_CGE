3995  *==============================================================================
3996  *   6.1.2 Fixing GDP_BP_REAL and sh1, and initializing A_VA and sh0
3997  *==============================================================================
3998  * To compute the baseline, real GDP is set to grow at the projected growth rate
3999  * and multifactor productivity is endogenous.
4000   GDP_BP_REAL.fx(z,t1)  = GDP_BP_REALO(z);
4001   GDP_BP_REAL.fx(z,time)$[ord(time) gt 1]
4002  *                       = GDP_BP_REAL.l(z,time-1)*[1+growthz(z)];
4003                         = GDP_BP_REAL.l(z,time-1)*[1+g_GDP(z,time)];
4004   
4005   A_VA.L(z,t1)          = 1;
4006   A_VA.L(z,time)$[ord(time) gt 1]
4007                         = A_VA.L(z,time-1);
4008   
4009  * Domestic savings rates are made to follow the evolution anticipated by FBQF
4010  * and the intercept for the household savings function is endogenously
4011  * determined from the added constraint labeled CALEQ1:
4012   sh1.fx(z,t1)        = sh1O(z);
4013   sh1.fx(z,time)$[ord(time) gt 1]
4014                       = sh1.l(z,time-1)*[1+g_SDR(z,time-1)];
4015  *                     = sh1.l(z,time-1)*[1+growthz(z)];
4016   
4017   sh0.l(z,t1)         = sh0O(z);
4018   sh0.l(z,time)$[ord(time) gt 1]
4019  *                     = sh0.l(z,time-1)*exogro(z,time)/exogro(z,time-1);
4020                       = sh0.l(z,time-1)*[1+growthz(z)];
4021   
4022  *==============================================================================
4023  *   6.1.4 Other exogenous variables
4024  *==============================================================================
4025  * CABX.FX(z1,time)    = CABXO(z1)*cabix(z1,time);
4026   
4027   CABX.FX(z1,time)     = CABXO(z1);
4028   CABX.FX(z1,time)$[ord(time) gt 1]
4029  *                      = CABX.l(z1,time-1)*[1+growthz(z1)];
4030                        = CABX.l(z1,time-1)*[1+g_GDP(z1,time)];
4031   
4032   CMIN.FX(i,z,t1)      = CMINO(i,z);
4033   CMIN.FX(i,z,time)$[ord(time) gt 1]
4034  *                      = CMIN.l(i,z,time-1)*[1+growthz(z)];
4035                        = CMIN.l(i,z,time-1)*[1+g_POP(z,time)];
4036   
4037   KD.fx(k,j,z,t1)$KDO(k,j,z)
4038                        = KDO(k,j,z);
4039   KD.fx(k,j,z,time)${[ord(time) gt 1] and KDO(k,j,z)}
4040  *                     = KD.l(k,j,z,time-1)*[1+growthz(z)];
4041                        = KD.l(k,j,z,time-1)*[1-delta(z)]+IND.l(k,j,z,time-1);
4042   
4043  * KD.fx('natr',j,z,time)${[ord(time) gt 1] and KDO('natr',j,z)}
4044  *                      = KD.l('natr',j,z,time-1);
4045   
4046  * KD.fx('land',j,z,time)${[ord(time) gt 1] and KDO('land',j,z)}
4047  *                      = KD.l('land',j,z,time-1);
4048   
4049   LS.FX(l,z,t1)        = LSO(l,z);
4050   LS.FX(l,z,time)$[ord(time) gt 1]
4051  *                    = LS.l(l,z,time-1)*[1+growthz(z)];
4052                        = LS.l(l,z,time-1)*[1+g_POP(z,time)];
4053   
4054  *==============================================================================
4055  *   CTAX
4056  *==============================================================================
4057   CTAX.fx(z,time)$[ord(time) gt 1]
4058                              = CTAX_Cal(z,time);
4059   
4060  *==============================================================================
4061  *   6.1.5 Resolution
4062  *==============================================================================
4063   
4064  SOLVE PEPWT USING CNS;
4065  *SOLVE PEPWT using NLP maximizing OBJ;
4066  *SOLVE PEPWT USING MCP;
4067   
4068  * The single element in subset T(time) is removed, and the subset is now empty.
4069  T(time)          = NO;
4070  * End of LOOP over time periods
4071  ];
4072   
4073  *$exit
4074   
4075  *==============================================================================
4076  * 7. Output
4077  *==============================================================================
4078  * Preparation of a GDX file that includes the baseline values for A_VA, sh0, G,
4079  * G_REAL and IND. This file will then be used in the main program.
4080   
4081  PARAMETER
4082   A_VA_RES(z,time) Value of A_VA to reproduce real GDP projections
4083   GX(z,time)       Current government expenditures on goods and services in region z
4084   G_REALX(z,time)  Current real government expenditures on goods and services in region z
4085   INDX(k,j,z,time) Volume of new type k capital investment to industry j in region z
4086   sh0X(z,time)     Intercept (household savings)
4087   sh1X(z,time)     Household savings rate
4088   phi_BAU(z,time)
4089   valCTAX(z,time)
4090  ;
4091   
4092   A_VA_RES(z,time)        = A_VA.l(z,time);
4093   GX(z,time)              = G.l(z,time);
4094   G_REALX(z,time)         = G_REAL.l(z,time);
4095   INDX(k,pub,z,time)      = IND.l(k,pub,z,time);
4096   sh1X(z,time)            = sh1.l(z,time);
4097   sh0X(z,time)            = sh0.l(z,time);
4098   phi_BAU(z,time)         = phi.l(z,time);
4099   valCTAX(z,time)         = CTAX.l(z,time);
4100   
4101  execute_unload 'Input_w-t/B_line_GTAP11b.gdx',
4102   A_VA_RES, GX, G_REALX, INDX, delta, XST, VA, LS, KS, LD, KD, IND, EX, g_GDP, g_POP, GDP_BP, RC, IT, SH, SG, CABX, R, PK, sigma_LD, sigma_INV,
4103   sh1X, sh0X, phi_BAU, valCTAX ;
4104   
4105  *execute_unload 'CalB_Check'  ;

