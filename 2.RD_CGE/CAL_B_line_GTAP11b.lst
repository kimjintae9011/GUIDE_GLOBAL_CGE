2209   
2210  *f_balstfur(flow)
2211  *f_cokeoven(flow)
2212  * WEB(f_balstfur, 'p4_COKCOAL', z) = WEB(f_cokeoven, 'p66_TOTAL', z) ;
2213  * WEB(f_cokeoven, 'p4_COKCOAL', z) = WEB(f_cokeoven, 'p66_TOTAL', z) ;
2214   
2215   TCoke_Share(f_cokeoven,p_coal,z)$(WEB(f_cokeoven, p_coal, z) lt 0)  = WEB(f_cokeoven, p_coal, z)$(WEB(f_cokeoven, p_coal, z) lt 0)/sum(p_coal2, WEB(f_cokeoven, p_coal2, z)$(WEB(f_cokeoven, p_coal2, z) lt 0)) ;
2216   TBlast_Share(f_balstfur,p_coal,z)$(WEB(f_balstfur, p_coal, z) lt 0) = WEB(f_balstfur, p_coal, z)$(WEB(f_balstfur, p_coal, z) lt 0)/sum(p_coal2, WEB(f_balstfur, p_coal2, z)$(WEB(f_balstfur, p_coal2, z) lt 0)) ;
2217   
2218  display TCoke_Share, TBlast_Share ;
2219   
2220  *Coal
2221   Coal_DIO(p_coal,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_coal, z));
2222   Coal_DIO(p_coal,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_coal, z));
2223   Coal_DIO(p_coal,'03_OIL',z) = -1*sum((f_oil), WEB(f_oil, p_coal, z));
2224   Coal_DIO(p_coal,'04_GAS',z) = -1*sum((f_gas), WEB(f_gas, p_coal, z));
2225   Coal_DIO(p_coal,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_coal, z));
2226   Coal_DIO(p_coal,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_coal, z));
2227   Coal_DIO(p_coal,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_coal, z));
2228   Coal_DIO(p_coal,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_coal, z));
2229   Coal_DIO(p_coal,'09_PAPERPRO',z) = sum((f_paperpro), WEB(f_paperpro, p_coal, z));
2230   Coal_DIO(p_coal,'10_PETROLCOAL',z) = -1*sum((f_petrolcoal), WEB(f_petrolcoal, p_coal, z));
2231   Coal_DIO(p_coal,'11_CHEMICAL',z) = sum((f_chemical), WEB(f_chemical, p_coal, z));
2232   Coal_DIO(p_coal,'12_NONMET',z) = sum((f_nonmet), WEB(f_nonmet, p_coal, z));
2233   Coal_DIO(p_coal,'13_IRONSTL',z) = sum((f_ironstl), WEB(f_ironstl, p_coal, z))
2234   + sum(f_cokeoven, -1*TCoke_Share(f_cokeoven,p_coal,z)*WEB(f_cokeoven, 'p66_TOTAL', z))
2235   + sum(f_balstfur, -1*TBlast_Share(f_balstfur,p_coal,z)*WEB(f_balstfur, 'p66_TOTAL', z))
2236   + sum((f_Eblastcoke), -1*WEB(f_Eblastcoke, p_coal, z))
2237  ;
2238   
2239   Coal_DIO(p_coal,'14_NONFERR',z) = sum((f_nonferr), WEB(f_nonferr, p_coal, z));
2240   Coal_DIO(p_coal,'15_MACHINE',z) = sum((f_machine), WEB(f_machine, p_coal, z));
2241   Coal_DIO(p_coal,'16_TRANSEQ',z) = sum((f_transeq), WEB(f_transeq, p_coal, z));
2242   Coal_DIO(p_coal,'17_OTHERIND',z) = sum((f_otherind), WEB(f_otherind, p_coal, z));
2243   Coal_DIO(p_coal,'18_TnD',z) = 0 ;
2244   Coal_DIO(p_coal,'19_eNuclear',z) = 0 ;
2245   Coal_DIO(p_coal,'20_eCoal',z) = -1*sum((f_elec), WEB(f_elec, p_coal, z));
2246   Coal_DIO(p_coal,'19_eNuclear',z) = 0 ;
2247   Coal_DIO(p_coal,'21_eGas',z) = 0 ;
2248   Coal_DIO(p_coal,'22_eOil',z) = 0 ;
2249   Coal_DIO(p_coal,'23_eWind',z) = 0 ;
2250   Coal_DIO(p_coal,'24_eSolar',z) = 0 ;
2251   Coal_DIO(p_coal,'25_eHydro',z) = 0 ;
2252   Coal_DIO(p_coal,'26_eOther',z) = 0 ;
2253   Coal_DIO(p_coal,'27_CONSTRUC',z) = sum((f_construc), WEB(f_construc, p_coal, z));
2254   Coal_DIO(p_coal,'28_LTRP',z) = sum((f_roadrail), WEB(f_roadrail, p_coal, z));
2255   Coal_DIO(p_coal,'29_WTRP',z) = sum((f_domewater), WEB(f_domewater, p_coal, z));
2256   Coal_DIO(p_coal,'30_ATRP',z) = sum((f_domeair), WEB(f_domeair, p_coal, z));
2257   Coal_DIO(p_coal,'31_SER',z) = sum((f_ser), WEB(f_ser, p_coal, z));
2258   Coal_CO(p_coal,z) = sum((f_household), WEB(f_household, p_coal, z));
2259   
2260  *Ratio
2261  Loop(j,
2262      CoalR_DIO(p_coal,j,z)$(Coal_DIO(p_coal,j,z) gt 0)
2263           = Coal_DIO(p_coal,j,z)/sum(p_coal2, Coal_DIO(p_coal2,j,z));
2264       );
2265   
2266   CoalR_CO(p_coal,z)$(Coal_CO(p_coal,z) gt 0)  = Coal_CO(p_coal,z)/ sum(p_coal2, Coal_CO(p_coal2,z));
2267   
2268  display Coal_DIO, CoalR_DIO, CoalR_CO ;
2269   
2270  *Gas
2271   Gas_DIO(p_gas,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_gas, z));
2272   Gas_DIO(p_gas,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_gas, z));
2273   Gas_DIO(p_gas,'03_OIL',z) = 0;
2274   Gas_DIO(p_gas,'04_GAS',z) = -1*sum((f_gas), WEB(f_gas, p_gas, z));
2275   Gas_DIO(p_gas,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_gas, z));
2276   Gas_DIO(p_gas,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_gas, z));
2277   Gas_DIO(p_gas,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_gas, z));
2278   Gas_DIO(p_gas,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_gas, z));
2279   Gas_DIO(p_gas,'09_PAPERPRO',z) = sum((f_paperpro), WEB(f_paperpro, p_gas, z));
2280   Gas_DIO(p_gas,'10_PETROLCOAL',z) = -1*sum((f_petrolcoal), WEB(f_petrolcoal, p_gas, z));
2281   Gas_DIO(p_gas,'11_CHEMICAL',z) = sum((f_chemical), WEB(f_chemical, p_gas, z));
2282   Gas_DIO(p_gas,'12_NONMET',z) = sum((f_nonmet), WEB(f_nonmet, p_gas, z));
2283   Gas_DIO(p_gas,'13_IRONSTL',z) = sum((f_ironstl), WEB(f_ironstl, p_gas, z));
2284   Gas_DIO(p_gas,'14_NONFERR',z) = sum((f_nonferr), WEB(f_nonferr, p_gas, z));
2285   Gas_DIO(p_gas,'15_MACHINE',z) = sum((f_machine), WEB(f_machine, p_gas, z));
2286   Gas_DIO(p_gas,'16_TRANSEQ',z) = sum((f_transeq), WEB(f_transeq, p_gas, z));
2287   Gas_DIO(p_gas,'17_OTHERIND',z) = sum((f_otherind), WEB(f_otherind, p_gas, z));
2288   Gas_DIO(p_gas,'18_TnD',z) = 0 ;
2289   Gas_DIO(p_gas,'19_eNuclear',z) = 0 ;
2290   Gas_DIO(p_gas,'20_eCoal',z) = 0;
2291   Gas_DIO(p_gas,'19_eNuclear',z) = 0 ;
2292   Gas_DIO(p_gas,'21_eGas',z) = -1*sum((f_elec), WEB(f_elec, p_gas, z)) ;
2293   Gas_DIO(p_gas,'22_eOil',z) = 0 ;
2294   Gas_DIO(p_gas,'23_eWind',z) = 0 ;
2295   Gas_DIO(p_gas,'24_eSolar',z) = 0 ;
2296   Gas_DIO(p_gas,'25_eHydro',z) = 0 ;
2297   Gas_DIO(p_gas,'26_eOther',z) = 0 ;
2298   Gas_DIO(p_gas,'27_CONSTRUC',z) = sum((f_construc), WEB(f_construc, p_gas, z));
2299   Gas_DIO(p_gas,'28_LTRP',z) = sum((f_roadrail), WEB(f_roadrail, p_gas, z));
2300   Gas_DIO(p_gas,'29_WTRP',z) = sum((f_domewater), WEB(f_domewater, p_gas, z));
2301   Gas_DIO(p_gas,'30_ATRP',z) = sum((f_domeair), WEB(f_domeair, p_gas, z));
2302   Gas_DIO(p_gas,'31_SER',z) = sum((f_ser), WEB(f_ser, p_gas, z));
2303   Gas_CO(p_gas,z) = sum((f_household), WEB(f_household, p_gas, z));
2304   
