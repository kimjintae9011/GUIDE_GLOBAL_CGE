3050   
3051  *==============================================================================
3052  *  5.3 Equations
3053  *==============================================================================
3054  *   5.3.1 Production
3055  *==============================================================================
3056   EQ1(j3,z,t)..     VA(j3,z,t) =e= v(j3,z)*XST(j3,z,t);
3057   
3058   EQ1_1(j2,z,t)..   KLE(j2,z,t) =e= v2(j2,z)*XST(j2,z,t);
3059   
3060   EQ2(j,z,t)..      CI(j,z,t) =e= io(j,z)*XST(j,z,t);
3061   
3062   EQ2_1(j3,z,t)..   CE(j3,z,t) =e= io2(j3,z)*XST(j3,z,t);
3063   
3064   EQ3(j,z,t)..      VA(j,z,t) =e= A_VA(z,t)*B_VA(j,z)*{
3065                      [beta_VA(j,z)*LDC(j,z,t)**(-rho_VA(j,z))]$LDCO(j,z)
3066                     +[(1-beta_VA(j,z))*KDC(j,z,t)**(-rho_VA(j,z))]$KDCO(j,z)
3067                                                     }**(-1/rho_VA(j,z));
3068   
3069   EQ3_1(j2,z,t)..   KLE(j2,z,t) =e= B_KLE(j2,z)*{
3070                      [beta_KLE(j2,z)*VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
3071                     +[(1-beta_KLE(j2,z))*CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
3072                                                     }**(-1/rho_KLE(j2,z));
3073   
3074   EQ4(j,z,t)$[LDCO(j,z) and KDCO(j,z)]..
3075                   LDC(j,z,t) =e= {[beta_VA(j,z)/(1-beta_VA(j,z))]
3076                                *[RC(j,z,t)/WC(j,z,t)]}**sigma_VA(j,z)*KDC(j,z,t);
3077   
3078   EQ4_1(j2,z,t)$[VAO(j2,z) and CEO(j2,z)]..
3079                   VA(j2,z,t) =e= {[beta_KLE(j2,z)/(1-beta_KLE(j2,z))]
3080                                *[PCE(j2,z,t)/PVA(j2,z,t)]}**sigma_KLE(j2,z)*CE(j2,z,t);
3081   
3082   EQ5(j,z,t)$LDCO(j,z)..
3083                   LDC(j,z,t) =e= B_LD(j,z)*SUM[l$LDO(l,j,z),beta_LD(l,j,z)
3084                                  *LD(l,j,z,t)**(-rho_LD(j,z))]**(-1/rho_LD(j,z));
3085   
3086   EQ6(l,j,z,t)$LDO(l,j,z)..
3087                   LD(l,j,z,t) =e= [beta_LD(l,j,z)*WC(j,z,t)/WTI(l,j,z,t)]
3088                                 **sigma_LD(j,z)*B_LD(j,z)**(sigma_LD(j,z)-1)
3089                                 *LDC(j,z,t);
3090   
3091   EQ7(j,z,t)$KDCO(j,z)..
3092                   KDC(j,z,t) =e= B_KD(j,z)*SUM[k$KDO(k,j,z),beta_KD(k,j,z)
3093                                  *KD(k,j,z,t)**(-rho_KD(j,z))]**(-1/rho_KD(j,z));
3094   
3095   EQ8(k,j,z,t)$KDO(k,j,z)..
3096                   KD(k,j,z,t) =e= [beta_KD(k,j,z)*RC(j,z,t)/RTI(k,j,z,t)]
3097                                   **sigma_KD(j,z)*B_KD(j,z)**(sigma_KD(j,z)-1)
3098                                   *KDC(j,z,t);
3099   
3100   EQ9(nene,j,z,t)..   DI(nene,j,z,t) =e= aij(nene,j,z)*CI(j,z,t) ;
3101   
3102   EQ9_1(ene,j3,z,t)..  DE(ene,j3,z,t)   =e= aij2(ene,j3,z)*CE(j3,z,t) ;
3103   
3104  * EQ9_2(ene,j2,z,t)..  DE(ene,j2,z,t) =e= [beta_ENER(ene,j2,z)*PCE(j2,z,t)/P4(ene,j2,z,t)]
3105  *                                   **sigma_ENER(j2,z)*B_ENER_t(j2,z,t)**(sigma_ENER(j2,z)-1)
3106  *                                   *CE(j2,z,t);
3107   
3108   EQ9_2(ene,j2,z,t)..  DE(ene,j2,z,t) =e= [beta_ENER(ene,j2,z)*PCE(j2,z,t)/((P4(ene,j2,z,t)+P4(ene,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j2,z,t)))]
3109                                     **sigma_ENER(j2,z)*B_ENER_t(j2,z,t)**(sigma_ENER(j2,z)-1)
3110                                     *CE(j2,z,t);
3111   
3112   
3113  *==============================================================================
3114  *   5.3.2 Income and savings
3115  *==============================================================================
3116  *    5.3.2.1 Households
3117  *==============================================================================
3118  * EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t);
3119   EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t)+TCTAX(z,t);
3120   
3121   EQ11(z,t)..       YHL(z,t) =e= SUM[(l,j)$LDO(l,j,z),W(l,z,t)*LD(l,j,z,t)];
3122   
3123   EQ12(z,t)..       YHK(z,t) =e= SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*KD(k,j,z,t)];
3124   
3125   EQ13(z,t)..       YDH(z,t) =e= YH(z,t)-TDH(z,t);
3126   
3127   EQ14(z,t)..       CTH(z,t) =e= YDH(z,t)-SH(z,t);
3128   
3129   CALEQ1(z,t)..     SH(z,t)+SG(z,t) =e= sh1(z,t)*GDP_IB(z,t);
3130   
3131  * EQ15(z,t)..      SH(z,t)+SG(z,t) =e= sh1(z,t)*GDP_IB(z,t);
3132  * EQ15(z,t)..      SH(z,t) =e= sh1(z,t)*YDH(z,t);
3133   EQ15(z,t)..       SH(z,t) =e= PIXCON(z,t)**eta*sh0(z,t)+sh1(z,t)*YDH(z,t);
3134   
3135  *==============================================================================
3136  *    5.3.2.2 Government
3137  *==============================================================================
3138   EQ16(z,t)..       YG(z,t) =e= TDH(z,t)+TPRODN(z,t)+TPRCTS(z,t)+TCTAX(z,t);
3139   
3140   EQ16_1(z,t)..     TCTAX(z,t) =e= sum((ene,j), PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t));
3141   
3142   EQ17(z,t)..       TPRODN(z,t) =e= TIWT(z,t)+TIKT(z,t)+TIPT(z,t);
3143   
3144   EQ18(z,t)..       TIWT(z,t) =e= SUM[(l,j)$LDO(l,j,z),TIW(l,j,z,t)];
3145   
3146   EQ19(z,t)..       TIKT(z,t) =e= SUM[(k,j)$KDO(k,j,z),TIK(k,j,z,t)];
3147   
3148   EQ20(z,t)..       TIPT(z,t) =e= SUM[j,TIP(j,z,t)];
3149   
3150   EQ21(z,t)..       TPRCTS(z,t) =e= TICT(z,t)+TIMT(z,t)+TIXT(z,t);
3151   
3152   EQ22(z,t)..       TICT(z,t) =e= SUM[i,TIC(i,z,t)];
3153   
3154   EQ23(z,t)..       TIMT(z,t) =e= SUM[(i,zj)$IMO(i,zj,z),TIM(i,zj,z,t)];
3155   
3156   EQ24(z,t)..       TIXT(z,t) =e= SUM[(i,zj)$EXO(i,z,zj),TIX(i,z,zj,t)];
3157   
3158   EQ25(z,t)..       TDH(z,t) =e= PIXCON(z,t)**eta*ttdh0(z,t)+ttdh1(z,t)*YH(z,t);
3159   
3160   EQ26(l,j,z,t)$LDO(l,j,z)..
3161                   TIW(l,j,z,t) =e= ttiw(l,j,z,t)*W(l,z,t)*LD(l,j,z,t);
3162   
3163   EQ27(k,j,z,t)$KDO(k,j,z)..
3164                   TIK(k,j,z,t) =e= ttik(k,j,z,t)*R(k,j,z,t)*KD(k,j,z,t);
3165   
3166   EQ28(j,z,t)..     TIP(j,z,t) =e= ttip(j,z,t)*PP(j,z,t)*XST(j,z,t);
3167   
3168   EQ29(i,z,t)..     TIC(i,z,t) =e= ttic(i,z,t)*{[PL(i,z,t)*DD(i,z,t)]$DDO(i,z)
3169                   +[SUM[zj$IMO(i,zj,z),(1+ttim(i,zj,z,t))*IM(i,zj,z,t)*e(z,t)
3170                    *(PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z)))]]};
3171   
3172   EQ30(i,zj,z,t)$IMO(i,zj,z)..
3173                   TIM(i,zj,z,t) =e= ttim(i,zj,z,t)*IM(i,zj,z,t)*e(z,t)*
3174                                     (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
3175                                     *tmrg(ij,i,zj,z)]);
3176   
3177   EQ31(i,z,zj,t)$EXO(i,z,zj)..
3178                   TIX(i,z,zj,t) =e= ttix(i,z,zj,t)*PE(i,z,zj,t)*EX(i,z,zj,t);
3179   
3180   EQ32(z,t)..       SG(z,t) =e= YG(z,t)-G(z,t)-TCTAX(z,t);
3181   
3182  *==============================================================================
3183  *    5.3.2.4 Rest of the world
3184  *==============================================================================
3185   EQ33(z,t)..       YROW(z,t) =e= e(z,t)*SUM{(i,zj)$IMO(i,zj,z),IM(i,zj,z,t)*
3186                             [PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z))]};
3187   
3188   EQ34(z,t)..       SROW(z,t) =e= YROW(z,t)-e(z,t)*SUM[(i,zj)$EXO(i,z,zj),
3189                                 EX(i,z,zj,t)*PWX(i,z,zj,t)]-e(z,t)
3190                                 *SUM[i$MRGNO(i,z),MRGN(i,z,t)*PWMG(i,t)];
3191   
3192   EQ35(z,t)..       SROW(z,t) =e= -CAB(z,t);
3193   
3194  *==============================================================================
3195  *   5.3.3 Demand
3196  *==============================================================================
3197   EQ36(i,z,t)..     PC(i,z,t)*C(i,z,t) =e= PC(i,z,t)*CMIN(i,z,t)+gamma_LES(i,z)
3198                                   *{CTH(z,t)-SUM[ij,PC(ij,z,t)*CMIN(ij,z,t)]};
3199   
3200   EQ37(i,z,t)..     PC(i,z,t)*INV(i,z,t) =e= gamma_INV(i,z)*IT(z,t);
3201   
3202   EQ38(i,z,t)..     PC(i,z,t)*CG(i,z,t) =e= gamma_GVT(i,z)*G(z,t);
3203   
3204   CALEQ2(z,t)..     G(z,t) =e= GO(z)*GDP_BP(z,t)/GDP_BPO(z);
3205   
3206   EQ39(nene,z,t)..   DIT(nene,z,t) =e= SUM[j,DI(nene,j,z,t)];
3207   
3208   EQ39_1(ene,z,t)..  DIT(ene,z,t) =e= SUM[j,DE(ene,j,z,t)];
3209   
3210  *==============================================================================
3211  *   5.3.4 International trade
3212  *==============================================================================
       EQB_1(i,z)..    XS_I(i,z) =e= B_X3(i,z)*SUM[j$XSO(j,i,z),beta_X3(j,i,z)
                                      *XS(j,i,z)**(-rho_X3(i,z))]**(-1/rho_X3(i,z));
       
       EQB_2(j,i,z)${DSO(j,i,z) and [DSO(j,i,z) ne DSO_I(i,z)]}..
                       XS(j,i,z) =e= XS_I(i,z)/B_X3(i,z)**(1-sigma_X3(i,z))*
                                     [beta_X3(j,i,z)*PI(i,z)/P2(j,i,z)]
                                     **sigma_X3(i,z);
       
       EQB_3(j,i,z)${DSO(j,i,z)}..   P2(j,i,z) =e= PT(j,z);
       
       EQB_4(j,i,z)$DSO(j,i,z)..
                       P2(j,i,z)*XS(j,i,z) =e= [PET(i,z)*EXTT(j,i,z)]$EXTTO(j,i,z)
                                              +[e(z)*MRGN(i,z)*PWMG(i)]$MRGNO(i,z)
                                              +[PL(i,z)*DS(j,i,z)]$DSO(j,i,z);
       
       EQB_5(j,i,z)$DSO(j,i,z)..  EXTT(j,i,z)  =e= theta2(j,i,z)*EXT(i,z);
3231   
3232  *[Top Nest - Leontief function]
3233   EQA_1(z,t)..  XS('18_TnD','18_ELEC',z,t) =e= TnDShare(z)*XS_I('18_ELEC',z,t);
3234   EQA_2(z,t)..  XS_I('18_ELEC',z,t) =e= XS('18_TnD','18_ELEC',z,t) + POWERQ(z,t);
3235   
3236   
3237  *[Second Nest - CES function]
3238   EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
3239                                  *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
3240   
3241   EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
3242                                 [beta_X4(power,z)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
3243                                 **sigma_X4(z);
3244   
3245  * exclude electiricity
3246   EQB_1(i2,z,t)..    XS_I(i2,z,t) =e= B_X3(i2,z)*SUM[j$XSO(j,i2,z),beta_X3(j,i2,z)
3247                                  *XS(j,i2,z,t)**(-rho_X3(i2,z))]**(-1/rho_X3(i2,z));
3248   
3249   
3250   EQB_3(j,i,z,t)${DSO(j,i,z)}..   P2(j,i,z,t) =e= PT(j,z,t);
3251   
3252   EQB_4(j,i,z,t)$DSO(j,i,z)..
3253                   P2(j,i,z,t)*XS(j,i,z,t) =e= [PET(i,z,t)*EXTT(j,i,z,t)]$EXTTO(j,i,z)
3254                                          +[e(z,t)*MRGN(i,z,t)*PWMG(i,t)]$MRGNO(i,z)
3255                                          +[PL(i,z,t)*DS(j,i,z,t)]$DSO(j,i,z);
3256   
3257   EQB_5(j,i,z,t)$DSO(j,i,z)..  EXTT(j,i,z,t)  =e= theta2(j,i,z)*EXT(i,z,t);
3258   
3259   EQ40_3(i,z,t)..   DS_I(i,z,t) =e= sum(j,DS(j,i,z,t)$DSO(j,i,z));
3260   
3261   EQ40_4(j,z,t)..   XST(j,z,t)  =e= sum(i,XS(j,i,z,t)$XSO(j,i,z));
3262   
3263   EQ40_5(i,z,t)..   XS_I(i,z,t) =e= B_X1(i,z)*{
3264                   [beta_EX_X1(i,z)*EXT(i,z,t)**rho_X1(i,z)]$EXTO(i,z)
3265                  +[beta_D_X1(i,z)*DS_I(i,z,t)**rho_X1(i,z)]$DSO_I(i,z)
3266                  +[(1-beta_EX_X1(i,z)-beta_D_X1(i,z))*MRGN(i,z,t)**rho_X1(i,z)]$MRGNO(i,z)
3267                                            }**(1/rho_X1(i,z));
3268   
3269   EQ41(i,z,t)$[EXTO(i,z) and DSO_I(i,z)]..
3270                   EXT(i,z,t) =e= {[beta_D_X1(i,z)/beta_EX_X1(i,z)]*[PET(i,z,t)/PL(i,z,t)]}
3271                                **sigma_X1(i,z)*DS_I(i,z,t);
3272   
3273   EQ42(i,z,t)$[MRGNO(i,z) and DSO_I(i,z)]..
3274                   MRGN(i,z,t) =e= {[beta_D_X1(i,z)/(1-beta_EX_X1(i,z)
3275                                   -beta_D_X1(i,z))]*[e(z,t)*PWMG(i,t)/PL(i,z,t)]}
3276                                   **sigma_X1(i,z)*DS_I(i,z,t);
3277   
3278   EQ43(i,z,t)$EXTO(i,z)..
3279                   EXT(i,z,t) =e= B_X2(i,z)*SUM[zj$EXO(i,z,zj),beta_X2(i,z,zj)
3280                                  *EX(i,z,zj,t)**rho_X2(i,z)]**(1/rho_X2(i,z));
3281   
3282   EQ44(i,z,zj,t)$EXO(i,z,zj)..
3283                   EX(i,z,zj,t) =e= EXT(i,z,t)/B_X2(i,z)**(1+sigma_X2(i,z))*
3284                                    [PE(i,z,zj,t)/(beta_X2(i,z,zj)*PET(i,z,t))]
3285                                    **sigma_X2(i,z);
3286   
3287   EQ45(i,z,t)..     Q(i,z,t) =e= B_M1(i,z)*{
3288                      [beta_M1(i,z)*IMT(i,z,t)**(-rho_M1(i,z))]$IMTO(i,z)
3289                     +[(1-beta_M1(i,z))*DD(i,z,t)**(-rho_M1(i,z))]$DDO(i,z)
3290                                          }**(-1/rho_M1(i,z));
3291   
3292   EQ46(i,z,t)$[IMTO(i,z) and DDO(i,z)]..
3293                   IMT(i,z,t) =e= {[beta_M1(i,z)/(1-beta_M1(i,z))]*[PD(i,z,t)
3294                                  /PMT(i,z,t)]}**sigma_m1(i,z)*DD(i,z,t);
3295   
3296   EQ47(i,z,t)$IMTO(i,z)..
3297                   IMT(i,z,t) =e= B_M2(i,z)*SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*
3298                                  IM(i,zj,z,t)**(-rho_M2(i,z))]**(-1/rho_M2(i,z));
3299   
3300   EQ48(i,zj,z,t)$IMO(i,zj,z)..
3301                   IM(i,zj,z,t) =e= IMT(i,z,t)/B_M2(i,z)**(1-sigma_M2(i,z))*
3302                                    [beta_M2(i,zj,z)*PMT(i,z,t)/PM(i,zj,z,t)]
3303                                    **sigma_M2(i,z);
3304   
3305  *==============================================================================
3306  *   5.3.5 Prices
3307  *==============================================================================
3308   EQ49(j2,z,t)..     PP(j2,z,t)*XST(j2,z,t) =e= PKLE(j2,z,t)*KLE(j2,z,t)+PCI(j2,z,t)*CI(j2,z,t);
3309   
3310   EQ49_1(j3,z,t)..   PP(j3,z,t)*XST(j3,z,t) =e= PVA(j3,z,t)*VA(j3,z,t)+PCI(j3,z,t)*CI(j3,z,t)+PCE(j3,z,t)*CE(j3,z,t);
3311   
3312   EQ50(j,z,t)..     PT(j,z,t) =e= (1+ttip(j,z,t))*PP(j,z,t);
3313   
3314   EQ51(j,z,t)..     PCI(j,z,t)*CI(j,z,t) =e= SUM[nene,PC(nene,z,t)*DI(nene,j,z,t)];
3315   
3316   EQ51_1(j,z,t)..   PCE(j,z,t)*CE(j,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j,z,t) + PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t)];
3317   
3318   EQ52(j,z,t)..     PVA(j,z,t)*VA(j,z,t) =e= [WC(j,z,t)*LDC(j,z,t)]$LDCO(j,z)
3319                                       +[RC(j,z,t)*KDC(j,z,t)]$KDCO(j,z);
3320   
3321   EQ52_1(j2,z,t)..   PKLE(j2,z,t)*KLE(j2,z,t) =e= [PVA(j2,z,t)*VA(j2,z,t)]$VAO(j2,z)
3322                                         +[PCE(j2,z,t)*CE(j2,z,t)]$CEO(j2,z);
3323   
3324  * Given equations 5 and 6, equation 53 is redundant
3325  * EQ53(j,z)..     WC(j,z)*LDC(j,z) =e= SUM[l$LDO(l,j,z),WTI(l,j,z)*LD(l,j,z)];
3326   
3327   EQ54(l,j,z,t)$LDO(l,j,z)..
3328                   WTI(l,j,z,t) =e= W(l,z,t)*(1+ttiw(l,j,z,t));
3329   
3330   EQ54_1(ene,j2,z,t)$DEO(ene,j2,z)..
3331                   P4(ene,j2,z,t) =e= PC(ene,z,t);
3332   
3333  * Given equations 7 and 8, equation 55 is redundant
3334  * EQ55(j,z)$(kmob and KDCO(j,z))..
3335  *                 RC(j,z)*KDC(j,z) =e= SUM[k$KDO(k,j,z),RTI(k,j,z)*KD(k,j,z)];
3336   
3337   EQ56(k,j,z,t)$KDO(k,j,z)..
3338                   RTI(k,j,z,t) =e= R(k,j,z,t)*(1+ttik(k,j,z,t));
3339   
3340  * EQ57(k,j,z,t)$(kmob and KDO(k,j,z))..
3341  *                 R(k,j,z,t) =e= RK(k,z,t);
3342   
3343  * EQ58(j,z)..     P(j,z)*XST(j,z) =e= [PL(j,z)*DS(j,z)]$DSO(j,z)
3344  *                                   +[PET(j,z)*EXT(j,z)]$EXTO(j,z)
3345  *                                   +[e(z)*PWMG(j)*MRGN(j,z)]$MRGNO(j,z);
3346   
3347   EQ58(i,z,t)..     P(i,z,t)*XS_I(i,z,t) =e= [PL(i,z,t)*DS_I(i,z,t)]$DSO_I(i,z)
3348                                       +[PET(i,z,t)*EXT(i,z,t)]$EXTO(i,z)
3349                                       +[e(z,t)*PWMG(i,t)*MRGN(i,z,t)]$MRGNO(i,z);
3350   
3351  * Given equations 43 and 44, equation 59 is redundant
3352  * EQ59(i,z)$EXTO(i,z)..
3353  *                 PET(i,z)*EXT(i,z) =e= SUM[zj$EXO(i,z,zj),
3354  *                                           PE(i,z,zj)*EX(i,z,zj);
3355   
3356   EQ60(i,z,zj,t)$EXO(i,z,zj)..
3357                   PE(i,z,zj,t)*(1+ttix(i,z,zj,t)) =e= e(z,t)*PWX(i,z,zj,t);
3358   
3359   EQ61(i,z,t)$DDO(i,z)..
3360                   PD(i,z,t) =e= (1+ttic(i,z,t))*PL(i,z,t);
3361   
3362   EQ62(i,zj,z,t)$IMO(i,zj,z)..
3363                   PM(i,zj,z,t) =e= (1+ttic(i,z,t))*(1+ttim(i,zj,z,t))*e(z,t)*
3364                                    (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
3365                                    *tmrg(ij,i,zj,z)]);
3366   
3367  * Given equations 47 and 48, equation 63 is redundant
3368  * EQ63(i,z)$IMTO(i,z)..
3369  *                 PMT(i,z)*IMT(i,z) =e= SUM[zj$IMO(i,zj,z),
3370  *                                           PM(i,zj,z)*IM(i,zj,z);
3371   
3372   EQ64(i,z,t)..     PC(i,z,t)*Q(i,z,t) =e= [PD(i,z,t)*DD(i,z,t)]$DDO(i,z)+
3373                                      [PMT(i,z,t)*IMT(i,z,t)]$IMTO(i,z);
3374   
3375  * EQ65(z,t)..       PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
3376  *                               /gamma_INV(i,z))**gamma_INV(i,z)];
3377   
3378   EQ66(z,t)..       PIXGDP(z,t) =e=
3379                   {SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)]
3380                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
3381                   *SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)]
3382                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)]}**0.5;
3383   
3384   EQ67(t)..         PIXGDP_W(t) =e=
3385                   {SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)/e(z,t)]
3386                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
3387                   *SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)/e(z,t)]
3388                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)/eO(z)]}**0.5;
3389   
3390   EQ68(z,t)..       PIXCON(z,t) =e= SUM[i,PC(i,z,t)*CO(i,z)]/SUM[i,PCO(i,z)*CO(i,z)];
3391   
3392   EQ69(z,t)..       PIXINV(z,t) =e= PROD[i$gamma_INV(i,z),(PC(i,z,t)/PCO(i,z))
3393                                   **gamma_INV(i,z)];
3394   
3395   EQ70(z,t)..       PIXGVT(z,t) =e= PROD[i$gamma_GVT(i,z),(PC(i,z,t)/PCO(i,z))
3396                                   **gamma_GVT(i,z)];
3397   
3398  *==============================================================================
3399  *   5.3.6 Equilibrium
3400  *==============================================================================
3401   EQ71(i1,z,t)..    Q(i1,z,t) =e= C(i1,z,t)+CG(i1,z,t)+INV(i1,z,t)+DIT(i1,z,t);
3402   
3403   EQ72(l,z,t)..     LS(l,z,t) =e= SUM[j$LDO(l,j,z),LD(l,j,z,t)];
3404   
3405   EQ73(k,z,t)$KSO(k,z)..
3406                     KS(k,z,t) =e= SUM[j$KDO(k,j,z),KD(k,j,z,t)];
3407   
3408   EQ74(z,t)..       IT(z,t) =e= SH(z,t)+SG(z,t)-CAB(z,t);
3409   
3410   EQ75(z,t)..       DEP(z,t) =e= PK(z,t)*delta(z)*SUM[k$KSO(k,z),KS(k,z,t)];
3411   
3412   EQ76(i,z,t)$DDO(i,z)..
3413                     SUM[j$DSO(j,i,z),DS(j,i,z,t)] =e= DD(i,z,t);
3414   
3415   EQ77(i,z,zj,t)$EXO(i,z,zj)..
3416                     EX(i,z,zj,t) =e= IM(i,z,zj,t);
3417   
3418   EQ78(i,z,zj,t)$EXO(i,z,zj)..
3419                     PWX(i,z,zj,t) =e= PWM(i,z,zj,t);
3420   
3421   EQ79(i,t)..       SUM[z$MRGNO(i,z),MRGN(i,z,t)] =e= SUM[(z,zj,ij)$IMO(ij,zj,z),
3422                                                   tmrg(i,ij,zj,z)*IM(ij,zj,z,t)];
3423   
3424  * Given equations 33, 34 and 77, equation 80 is redundant
3425  * EQ80..          SUM[z,SROW(z)/e(z)] =e= 0;
3426   
3427  *==============================================================================
3428  *   5.3.7 Gross domestic product
3429  *==============================================================================
3430   EQ81(z,t)..       GDP_BP(z,t) =e= SUM[j,PVA(j,z,t)*VA(j,z,t)]+TIPT(z,t);
3431   
3432   EQ82(z,t)..       GDP_MP(z,t) =e= GDP_BP(z,t)+TPRCTS(z,t);
3433   
3434   EQ83(z,t)..       GDP_IB(z,t) =e= SUM[(l,j)$LDO(l,j,z),W(l,z,t)*LD(l,j,z,t)]
3435                                +SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*KD(k,j,z,t)]
3436                                +TPRCTS(z,t)+TPRODN(z,t);
3437   
3438   EQ84(z,t)..       GDP_FD(z,t) =e=
3439                   SUM[i,PC(i,z,t)*(C(i,z,t)+CG(i,z,t)+INV(i,z,t))]
3440                  +SUM[(i,zj)$EXO(i,z,zj),e(z,t)*PWX(i,z,zj,t)*EX(i,z,zj,t)]
3441                  +SUM[i$MRGNO(i,z),e(z,t)*PWMG(i,t)*MRGN(i,z,t)]
3442                  -SUM[(i,zj)$IMO(i,zj,z),e(z,t)*IM(i,zj,z,t)
3443                      *(PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)*tmrg(ij,i,zj,z)])]-TCTAX(z,t);
3444   
3445   EQ85(t)..          GDP_BP_W(t) =e= SUM[z,GDP_BP(z,t)/e(z,t)];
3446   
3447  *==============================================================================
3448  *  5.3.8 Real (volume) variables computed from price indices
3449  *==============================================================================
3450   EQ86(z,t)..       CTH_REAL(z,t) =e= CTH(z,t)/PIXCON(z,t);
3451   
3452   EQ87(z,t)..       G_REAL(z,t) =e= G(z,t)/PIXGVT(z,t);
3453   
3454   EQ88(z,t)..       GDP_BP_REAL(z,t) =e= GDP_BP(z,t)/PIXGDP(z,t);
3455   
3456   EQ89(t)..         GDP_BP_W_REAL(t) =e= GDP_BP_W(t)/PIXGDP_W(t);
3457   
3458   EQ90(z,t)..       GDP_MP_REAL(z,t) =e= GDP_MP(z,t)/PIXCON(z,t);
3459   
3460   EQ91(z,t)..       IT_REAL(z,t) =e= IT(z,t)/PIXINV(z,t);
3461   
3462   EQ92(z,t)..       CABX(z,t) =e= CAB(z,t)/[PIXGDP_W(t)*e(z,t)];
3463   
3464   EQ93..            OBJ =e= 1;
3465   
3466  *==============================================================================
3467  *   5.3.8 Dynamic equations
3468  *==============================================================================
3469   EQ94(z,t)..     IT(z,t) =e= PK(z,t)*SUM[(k,j)$KDO(k,j,z),IND(k,j,z,t)];
3470   
3471   EQ95(z,t)..     PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
3472                                 /gamma_INV(i,z))**gamma_INV(i,z)];
3473   
3474   EQ96(k,bus,z,t)$KDO(k,bus,z)..
3475                   IND(k,bus,z,t) =e= phi(z,t)*[R(k,bus,z,t)/U(z,t)]
3476                                    **sigma_INV(k,bus,z)*KD(k,bus,z,t);
3477   
3478   CALEQ3(k,pub,z,t)$KDO(k,pub,z)..
3479                   IND(k,pub,z,t)*PK(z,t) =e= INDO(k,pub,z)*PKO(z)*GDP_BP(z,t)
3480                                              /GDP_BPO(z);
3481   
3482  * EQ97a(z,t)..    IR(z,t) =e= {SUM[(k,j)$KDO(k,j,z),
3483  *                              R(k,j,z,t)*KD(k,j,z,t)]-DEP(z,t)}/
3484  *                             {PK(z,t)*SUM[(k,j)$KDO(k,j,z),KD(k,j,z,t)]};
3485   
3486   EQ97b(z,t)..    U(z,t) =e= PK(z,t)*(delta(z)+IR(z,t));
3487   
3488  *==============================================================================
3489  *   5.3.10 Other
3490  *==============================================================================
3491   WALRAS(z,t)..   LEON(z,t) =e= Q('01_AGRICULT',z,t)-C('01_AGRICULT',z,t)-CG('01_AGRICULT',z,t)-INV('01_AGRICULT',z,t)
3492                              -DIT('01_AGRICULT',z,t);
