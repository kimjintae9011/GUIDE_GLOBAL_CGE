 476  *==============================================================================
 477  *   2.2.3 Nominal (value) variables
 478  *==============================================================================
 479   CABO(z)         Current account balance of region z
 480   CTHO(z)         Consumption budget of households in region z
 481   DEPO(z)         Amount of depreciation (capital consumption allowance) in region z
 482   GO(z)           Current government expenditures on goods and services in region z
 483   GDP_BPO(z)      Region z GDP at basic prices
 484   GDP_BP_WO       World GDP at basic prices
 485   GDP_FDO(z)      Region z GDP at purchasers prices from the perspective of final demand
 486   GDP_IBO(z)      Region z GDP at market prices (income-based)
 487   GDP_MPO(z)      Region z GDP at market prices
 488   ITO(z)          Total investment expenditures in region z
 489   RKDO(k,j,z)     Type k capital income in industry j in region z
 490   SGO(z)          Government savings in region z
 491   SHO(z)          Household savings in region z
 492   SROWO(z)        Rest-of-the-world savings with respect to region z
 493   TDHO(z)         Household income taxes in region z
 494   TICO(i,z)       Government revenue from indirect taxes on commodity i in region z
 495   TICTO(z)        Total government receipts of indirect taxes on commodities in region z
 496   TIKO(k,j,z)     Government revenue from taxes on type k capital used by industry j in region z
 497   TIKTO(z)        Total government revenue from from taxes on capital in region z
 498   TIMO(i,zj,z)    Government revenue from duties on commodity i imported from region zj by region z
 499   TIMTO(z)        Total government revenue from import duties in region z
 500   TIPO(j,z)       Government revenue from taxes on industry j production in region z (excluding taxes directly related to the use of capital and labor)
 501   TIPTO(z)        Total government revenue from production taxes in region z (excluding taxes directly related to the use of capital and labor)
 502   TIWO(l,j,z)     Government revenue from payroll taxes on type l labor in industry j of region z
 503   TIWTO(z)        Total government revenue from payroll taxes in region z
 504   TIXO(i,z,zj)    Government revenue from export taxes on commodity i exported by region z to region zj
 505   TIXTO(z)        Total government revenue from export taxes in region z
 506   TPRCTSO(z)      Total government revenue from taxes on products and imports in region z
 507   TPRODNO(z)      Total government revenue from other taxes on production in region z
 508   YDHO(z)         Household disposable income in region z
 509   YGO(z)          Total government income in region z
 510   YHO(z)          Household total income in region z
 511   YHKO(z)         Household capital income in region z
 512   YHLO(z)         Household labor income in region z
 513   YROWO(z)        Rest-of-the-world total income from region z
 514   
 515  *==============================================================================
 516  *   2.2.4 Rates and intercepts
 517  *==============================================================================
 518   phiO(z)         Scale variable (allocation of investment to industries)
 519   sh0O(z)         Intercept (household savings)
 520   sh1O(z)         Slope (household savings)
 521   ttdh0O(z)       Intercept (household income tax)
 522   ttdh1O(z)       Slope (household income tax)
 523   tticO(i,z)      Tax rate on commodity i
 524   ttikO(k,j,z)    Tax rate on capital k used in industry j
 525   ttimO(i,zj,z)   Rate of taxes and duties on imports of commodity i from country zj
 526   ttipO(j,z)      Tax rate on the production of industry j
 527   ttiwO(l,j,z)    Tax rate on type l worker compensation in industry j
 528   ttixO(i,z,zj)   Export tax rate on exported commodity x
 529  ;
 530   
 531  Scalar
 532   Tiny small figure / 0.000000000001/ ;
 533   
 534  *==============================================================================
 535  * 3 Data
 536  *==============================================================================
 537  *  3.1 Data input from GTAP8.1
 538  *==============================================================================
 539  *   3.1.1 Reading data aggregated with DATA_AGG-2007.gms
 540  *==============================================================================
 541  *  The PEP w-t model uses aggregated data from GTAP8.1. The following file
 542  *  includes data for some variables and substitution elasticities.
 543   
--- LOAD  CO = 13:CO
--- LOAD  CGO = 14:CGO
--- LOAD  DDO = 15:DDO
--- LOAD  DEPO = 16:DEPO
--- LOAD  DIO = 17:DIO
--- LOAD  DSO = 18:DSO
--- LOAD  DSO_I = 19:DSO_I
--- LOAD  EXO = 20:EXO
--- LOAD  IMO = 21:IMO
--- LOAD  INVO = 22:INVO
--- LOAD  KSTO = 23:KSTO
--- LOAD  LDO = 24:LDO
--- LOAD  MRGNO = 25:MRGNO
--- LOAD  XSO = 39:XSO
--- LOAD  XSO_I = 40:XSO_I
--- LOAD  XSTO = 41:XSTO
--- LOAD  g_GDP = 62:g_GDP
--- LOAD  g_POP = 63:g_POP
--- LOAD  g_SDR = 64:g_SDR
--- LOAD  AEEI_low = 65:AEEI_low
--- LOAD  AEEI_high = 66:AEEI_high
--- LOAD  CTAX_Cal = 68:CTAX_Cal
--- LOAD  RKDO = 27:RKDO
--- LOAD  TDHO = 28:TDHO
--- LOAD  TICO = 30:TICO
--- LOAD  TIKO = 31:TIKO
--- LOAD  TIMO = 32:TIMO
--- LOAD  TIPO = 33:TIPO
--- LOAD  TIWO = 34:TIWO
--- LOAD  TIXO = 35:TIXO
--- LOAD  tmrg = 38:tmrg
--- LOAD  sigma_M1 = 43:sigma_M1
--- LOAD  sigma_M2 = 44:sigma_M2
--- LOAD  sigma_VA = 45:sigma_VA
--- LOAD  sigma_KLE = 46:sigma_KLE
--- LOAD  POPO = 26:POPO
 547   
 548  display sigma_M1, sigma_M2 ;
 549   
 550  sigma_M1('04_GAS',Z) = 6;
 551  sigma_M2('03_OIL',Z) = 6;
 552  sigma_M2('04_GAS',Z) = 6;
 553   
 554  display sigma_M1, sigma_M2 ;
 555   
 556  *==============================================================================
 557  *   3.1.2 Rescaling the variables
 558  *==============================================================================
 559  * GTAP 8.1 data are in millions of (2004 and 2007) US dollars
 560  * (see www.gtap.agecon.purdue.edu/resources/download/5679.pdf)
 561  * With RES = 10000, model results are in tens of billions (10G$)
 562  RES              = 10000;
 563  *RES              = 1;
 564   
 565  * NOTE: In GTAP parlance, "agents' prices" are prices paid by buyers, and
 566  *       "market prices" are prices received by sellers.
 567   
 568  * Household consumption = GTAP domestic purchases (VDPA) + import purchases (VIPA)
 569  * by households at agents' prices.
 570  CO(i,z)          = CO(i,z)/RES;
 571   
 572  * Public final consumption = domestic purchases (VDGA) + import purchases (VIGA)
 573  * by government at agents' prices.
 574  CGO(i,z)         = CGO(i,z)/RES;
 575   
 576  * Domestic purchases = domestic absorption:
 577  * (CO + CGO + INVO + DIO) - [ imports (IMO) + transport margins (tmrg)
 578  *                              + indirect taxes (TICO + TIMO) ]
 579  DDO(i,z)         = DDO(i,z)/RES;
 580   
 581  * Capital depreciation (DEP)
 582  DEPO(z)          = DEPO(z)/RES;
 583   
 584  * Intermediate consumption = domestic purchases (VDFA) + import purchases (VIFA)
 585  * by firms belonging to sectors other than CGDS, at agents' prices.
 586  DIO(i,j,z)       = DIO(i,j,z)/RES;
 587   
 588  * Domestic supply = domestic demand (DDO) in GTAP_AGG.gms
 589  DSO(j,i,z)        = DSO(j,i,z)/RES;
 590  DSO_I(i,z)        = DSO_I(i,z)/RES;
 591   
 592  * Exports = exports at world prices (VXWD) = imports at world prices
 593  * Note: the GTAP variable VXWD is NOT used in the DATA_AGG.gms program; the
 594  * value recorded in DATA_AGG.gdx is actually identical to IMO
 595  EXO(i,z,zj)      = EXO(i,z,zj)/RES;
 596   
 597  * Imports = imports at world prices (VIWS) - sum of transport margins on imports (VTWR)
 598  IMO(i,z,zj)      = IMO(i,z,zj)/RES;
 599   
 600  * Demand for investment purposes = domestic purchases (VDFA)+ import purchases (VIFA)
 601  * by firms of the CGDS sector at agents' prices.
 602  INVO(i,z)        = INVO(i,z)/RES;
 603   
 604  * Total capital stock at the beginning of the period (VKB)
 605  KSTO(z)          = KSTO(z)/RES;
 606   
 607  * Labor demand = Remuneration of labor at market prices, before taxes
 608  * (components of VFM, "primary factor purchases, by households, at market prices")
 609  LDO(l,j,z)       = LDO(l,j,z)/RES;
 610   
 611  * Supply of transport margins at market prices (VST), adjusted proportionately
 612  * so that MRGNO = sum of tmrg for every margin commodity
 613  MRGNO(i,z)       = MRGNO(i,z)/RES;
 614   
 615  * Remuneration of capital at market prices, before taxes
 616  * (components of VFM, "primary factor purchases, by households, at market prices")
 617  RKDO(k,j,z)      = RKDO(k,j,z)/RES;
 618   
 619  * Direct taxes = factor payment at market prices (VFM)
 620  *                - primary factor sales at agents' prices (EVOA)
 621  TDHO(z)          = TDHO(z)/RES;
 622   
 623  * Domestic taxes on commodities = demand at agents' prices - demand at market prices:
 624  * Include 6 pairs of GTAP components
 625  *       VDPA - VDPM
 626  *       VIPA - VIPM
 627  *       VDGA - VDGM
 628  *       VIGA - VIGM
 629  *       VDFA - VDFM
 630  *       VIFA - VIFM
 631  TICO(i,z)        = TICO(i,z)/RES;
 632   
 633  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 634  *                                     - factor-based subsidies (FBEP).
 635  TIKO(k,j,z)      = TIKO(k,j,z)/RES;
 636   
 637  * Import duties = "ordinary" import duties (TFRV)
 638  TIMO(i,z,zj)     = TIMO(i,z,zj)/RES;
 639   
 640  * Taxes on production = MINUS "ordinary output subsidies" (OSEP)
 641  TIPO(j,z)        = TIPO(j,z)/RES;
 642   
 643  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 644  *                                     - factor-based subsidies (FBEP).
 645  TIWO(l,j,z)      = TIWO(l,j,z)/RES;
 646   
 647  * Taxes on exports = export tax equivalent of the Multi-Fiber Agreement (MFA)
 648  * quota premium(MFRV) + "ordinary" export taxes (XTRV)
 649  TIXO(i,z,zj)     = TIXO(i,z,zj)/RES;
 650   
 651  * Transport margins at world prices = sum of margins on imports (VTWR)
 652  tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj)/RES;
 653   
 654  * Domestic output = domestic supply (DSO) + supply of transport margins (MRGNO)
 655  *                   + exports (EXO) - taxes on exports (TIXO)
 656   
 657  XSO_I(i,z)        = XSO_I(i,z)/RES;
 658  XSO(j,i,z)        = XSO(j,i,z)/RES;
 659  XSTO(j,z)         = XSTO(j,z)/RES;
 660   
 661  growthz(z)        = 0.02;
 662   
 663  *==============================================================================
 664  *  3.3 Exogenous prices and parameters
 665  *==============================================================================
 666   
 667  *  Price elasticity (should be equal to one to verify homogeneity)
 668  eta = 1;
 669   
 670  *==============================================================================
 671  * CES and CET elasticities
 672  *==============================================================================
 673  * CES elasticities are defined using GTAP8.1 data for imports
 674  * (sigma_M1 and sigma_M2) and value added (sigma_VA)
 675   
 676  * Other exogenous parameters can be defined if the Excel file VAL_PAR.XLS
 677  PARAMETER
 678  PARZ;
 679   
GDXIN   C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.RD_CGE\Input_w-t\PAR.gdx
--- LOAD  sigma_KD = 1:sigma_KD
--- LOAD  sigma_LD = 2:sigma_LD
--- LOAD  sigma_X1 = 4:sigma_X1
--- LOAD  sigma_X2 = 5:sigma_X2
--- LOAD  sigma_X3 = 6:sigma_X3
--- LOAD  sigma_X0 = 7:sigma_X0
--- LOAD  sigma_Y = 8:sigma_y
--- LOAD  sigma_INV = 10:sigma_inv
--- LOAD  PARZ = 9:PARZ
 683   
 684  * sigma_INV(k,j,z) = 2;
 685   sigma_INV(k,j,z) = 1;
 686   
 687  *------------------------------------------------------------------------------
 688  * CES - composite capital
 689  * We assume that the elasticity between the different type of capital
 690  * is twice that used for value added.
 691  * If the user wishes to assume otherwise, he can fill the appropriate area in
 692  * the Excel file VAL_PAR.xls and delete following line:
 693   sigma_KD(j,z)   = 2*sigma_VA(j,z);
 694   
 695  *------------------------------------------------------------------------------
 696  * CES - composite labor
 697  * We assume that the elasticity between the different type of labor
 698  * is twice that used for value added.
 699  * If the user wishes to assume otherwise, he can fill the appropriate area in
 700  * the Excel file VAL_PAR.xls and delete following line:
 701  * sigma_LD(j,z)   = 2*sigma_VA(j,z);
 702   sigma_LD(j,z)   = 0.5;
 703   
 704  *$exit
 705  *------------------------------------------------------------------------------
 706  * CES - composite KLE, KE, ENER
 707  * sigma_KLE(j,z)  = 0.5 ;
 708  * sigma_KLE(j,z)  = 1.1 ;
 709   sigma_ENER(j,z) = 1.1 ;
 710  *  sigma_ENER(j,z) = 2.0 ;
 711   
 712  *------------------------------------------------------------------------------
 713  * CET - total output
 714  * We arbitrarily assume that the transformation elasticity between total exports,
 715  * domestic supply and margins is equal to 2 for all sectors and all region.
 716  * If the user wishes to assume otherwise, he can fill the appropriate area in
 717  * the Excel file VAL_PAR.xls.
 718   
 719  *------------------------------------------------------------------------------
 720  * CET - exports
 721  * We arbitrarily assume that the transformation elasticity between exports
 722  * to the different partners is equal to 3 for all sectors and all region.
 723  * If the user wishes to assume otherwise, he can fill the appropriate area in
 724  * the Excel file VAL_PAR.xls.
 725   
 726  *------------------------------------------------------------------------------
 727  * LES parameters - Frisch
 728  * We assume that the Frisch parameter is -1.1 for rich regions/countries and
 729  * -1.5 for other regions/countries.
 730   frisch(zrich)   = -1.1;
 731   frisch(zother)  = -1.5;
 732   
 733  * If the user wishes to assume otherwise, he can fill the appropriate area in
 734  * the Excel file VAL_PAR.xls, delete the previous 2 lines and uncomment the
 735  * following line:
 736   frisch(z)      = PARZ(z,'frisch');
 737   
 738  *------------------------------------------------------------------------------
 739  * LES parameters - Income elasticity of consumption
 740  * We arbitrarily assume that the income elasticity of the consumption of
 741  * commodity i is the same for all region/country.
 742  * If the user wishes to assume otherwise, he can fill the appropriate area in
 743  * the Excel file VAL_PAR.xls.
 744   
 745  *------------------------------------------------------------------------------
 746  *  Slopes of taxation functions
 747  *   One can either choose to assign a value to the intercepts and calibrate
 748  *   the slopes accordingly, or the other way around. This type of modelling
 749  *   can be useful to take into account known marginal savings or taxation rates
 750  *   or to deal with negative average saving rates in cases where savings are
 751  *   negative for some household groups.
 752  *   When no further information is available, one can simply set the intercepts
 753  *   to zero and calibrate an average rate: this is what we do here for ttdh0O.
 754  *   If the user wishes to assume otherwise, he can fill the appropriate area in
 755  *   the Excel file VAL_PAR.xls.
 756  * ttdh0O(z)       = PARZ(z,'ttdh0O');
 757   
 758   ttdh0O(z)       = 0;
 759  *   The slope ttdh1O is calibrated below in the mane GAMS file
 760   
 761  *------------------------------------------------------------------------------
 762  *  Elasticity - Investment demand function
 763  * We arbitrarily assume that this elasticity is equal to 2 for all types of
 764  * capital, all sectors and all regions.
 765  * If the user wishes to assume otherwise, he can fill the appropriate area in
 766  * the Excel file VAL_PAR.xls.
 767   
 768  *------------------------------------------------------------------------------
 769  * Also we need to assign values to some prices
 770  * All of the prices below, EXCEPT eO, may be set at arbitrary values
 771  * without loss of generality.
 772  *
 773  * In the case of eO, although exchange rates may be given arbitrary values
 774  * in the model, they must all be equal for calibration at this stage. The reason
 775  * is that the supply of margin transport services MRGNO must equal global demand.
 776  * Since there is a single world price for international transport margins
 777  * (rather than bilateral world prices for other commodities) the unit of
 778  * measurement of the volume of margin services must be the same for all regions,
 779  * and in turn, that implies that the divisor that converts the nominal value to
 780  * volume be the same for all regions. Since that divisor involves the exchange
 781  * rate, all exchange rates must be equal.
 782   
 783  * Normally, prices that may be given arbitrary values are set at 1:
 784   eO(z)           = 1;
 785   PEO(i,z,zj)     = 1;
 786   PLO(i,z)        = 1;
 787   PWMGO(i)        = 1;
 788   WO(l,z)         = 1;
 789   
 790  *==============================================================================
 791  * 4 Calibration
 792  *==============================================================================
 793  *  4.1 Calculation of income and savings related variables and parameters
 794  *==============================================================================
 795   YHKO(z)         = SUM[(k,j),RKDO(k,j,z)];
 796   YHLO(z)         = SUM[(l,j),LDO(l,j,z)];
 797   YHO(z)          = YHLO(z)+YHKO(z);
 798   YDHO(z)         = YHO(z)-TDHO(z);
 799   CTHO(z)         = SUM[i,CO(i,z)];
 800   SHO(z)          = YDHO(z)-CTHO(z);
 801   
 802   TICTO(z)        = SUM[i,TICO(i,z)];
 803   TIMTO(z)        = SUM[(i,zj),TIMO(i,zj,z)];
 804   TIWTO(z)        = SUM[(l,j),TIWO(l,j,z)];
 805   TIKTO(z)        = SUM[(k,j),TIKO(k,j,z)];
 806   TIPTO(z)        = SUM[j,TIPO(j,z)];
 807   TIXTO(z)        = SUM[(i,zj),TIXO(i,z,zj)];
 808   TPRODNO(z)      = TIKTO(z)+TIWTO(z)+TIPTO(z);
 809   TPRCTSO(z)      = TICTO(z)+TIMTO(z)+TIXTO(z);
 810   YGO(z)          = TDHO(z)+TPRCTSO(z)+TPRODNO(z);
 811   GO(z)           = SUM[i,CGO(i,z)];
 812   SGO(z)          = YGO(z)-GO(z);
 813   
 814   YROWO(z)        = SUM[(i,zj),IMO(i,zj,z)]+SUM[(i,ij,zj),tmrg(i,ij,zj,z)];
 815   SROWO(z)        = YROWO(z)-SUM[(i,zj),EXO(i,z,zj)]-SUM[i,MRGNO(i,z)];
 816   CABO(z)         = -SROWO(z);
 817   
 818   ITO(z)          = SHO(z)+SGO(z)+SROWO(z);
 819   
 820  *==============================================================================
 821  *  4.2 Calibration of parameters and other variables
 822  *==============================================================================
 823  *  4.2.1 Calibration of investment and government spending shares
 824  *==============================================================================
 825   gamma_GVT(i,z)  = CGO(i,z)/SUM[ij,CGO(ij,z)];
 826   gamma_INV(i,z)  = INVO(i,z)/SUM[ij,INVO(ij,z)] ;
 827   
 828  *==============================================================================
 829  *  4.2.2 Calibration of other prices and revised volumes (part 1)
 830  *==============================================================================
 831   LDO(l,j,z)      = LDO(l,j,z)/WO(l,z);
 832   LDCO(j,z)       = SUM[l,LDO(l,j,z)];
 833   LSO(l,z)        = SUM[j,LDO(l,j,z)];
 834   EXO(i,z,zj)     = [EXO(i,z,zj)-TIXO(i,z,zj)]/PEO(i,z,zj);
 835   EXTO(i,z)       = SUM[zj,EXO(i,z,zj)];
 836   
 837   PWXO(i,z,zj)$EXO(i,z,zj)
 838                   = {[PEO(i,z,zj)*EXO(i,z,zj)+TIXO(i,z,zj)]/EXO(i,z,zj)}/eO(z);
 839   
 840   PETO(i,z)       = SUM[zj,PEO(i,z,zj)*EXO(i,z,zj)]/EXTO(i,z);
 841   PWMO(i,z,zj)    = PWXO(i,z,zj);
 842   IMO(i,zj,z)     = EXO(i,zj,z);
 843   IMTO(i,z)       = SUM[zj,IMO(i,zj,z)];
 844   
 845   DSO(j,i,z)       = DSO(j,i,z)/PLO(i,z);
 846   DSO_I(i,z)       = SUM(j,DSO(j,i,z));
 847   DSO_J(j,z)       = SUM(i,DSO(j,i,z));
 848   QO(i,z)         = IMTO(i,z)+DDO(i,z);
 849   
 850   MRGNO(i,z)$MRGNO(i,z)
 851                   = MRGNO(i,z)/[eO(z)*PWMGO(i)];
 852   
 853   XSO_I(i,z)      = EXTO(i,z)+DDO(i,z)+MRGNO(i,z);
 854   
 855   XSTO(j,z)       = sum(i, XSO(j,i,z));
 856   
 857   PO(i,z)        = [PETO(i,z)*EXTO(i,z)+PLO(i,z)*DSO_I(i,z)
 858                    +eO(z)*PWMGO(i)*MRGNO(i,z)]/XSO_I(i,z);
 859   
 860   PO2(j,i,z)$XSO(j,i,z) = 1;
 861   
 862   PO3(i,j,z)$XSO(j,i,z) = 1;
 863   
 864   PIO(i,z)       = SUM[j$XSO(j,i,z),PO2(J,I,z)*XSO(j,i,z)]/XSO_I(i,z);
 865   
 866   PTO(j,z)       = SUM[i$XSO(j,i,z),PO2(j,i,z)*XSO(j,i,z)]/XSTO(j,z);
 867   
 868   PPO(j,z)       = [SUM[l,TIWO(l,j,z)+WO(l,z)*LDO(l,j,z)]
 869                    +SUM[k,TIKO(k,j,z)+RKDO(k,j,z)]
 870                    +SUM[nene,DIO(nene,j,z)]+SUM[ene,DIO(ene,j,z)]]/XSTO(j,z);
 871   
 872   theta2(j,i,z) = DSO(j,i,z)/sum(jj, DSO(jj,i,z));
 873   
 874   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z)*EXTO(i,z);
 875   
 876  *==============================================================================
 877  *  4.3 Calibration of tax rates, margins, prices and volumes
 878  *==============================================================================
 879  *  4.3.1 Margin rates and tax rates
 880  *==============================================================================
 881   ttixO(i,z,zj)   = [eO(z)*PWXO(i,z,zj)/PEO(i,z,zj)]-1;
 882   tticO(i,z)      = TICO(i,z)/{PLO(i,z)*DDO(i,z)
 883                     +SUM[zj,IMO(i,zj,z)*eO(z)*PWMO(i,zj,z)
 884                     +TIMO(i,zj,z)+SUM[ij,tmrg(ij,i,zj,z)]]};
 885   
 886   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
 887                   = tmrg(i,ij,zj,z)/(PWMGO(i)*eO(z)*IMO(ij,zj,z));
 888   
 889   ttimO(i,zj,z)$IMO(i,zj,z)
 890                   = TIMO(i,zj,z)/{IMO(i,zj,z)*eO(z)*(PWMO(i,zj,z)
 891                    +SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])};
 892   
 893   ttiwO(l,j,z)$LDO(l,j,z)
 894                   = TIWO(l,j,z)/[WO(l,z)*LDO(l,j,z)];
 895   
 896   ttikO(k,j,z)$RKDO(k,j,z)
 897                   = TIKO(k,j,z)/RKDO(k,j,z);
 898   
 899   ttipO(j,z)      = [PTO(j,z)/PPO(j,z)]-1;
 900   
 901   ttdh1O(z)       = [TDHO(z)-ttdh0O(z)]/YHO(z);
 902   
 903  *==============================================================================
 904  *  4.3.2 Calibration of other prices and revised volumes (part 2)
 905  *==============================================================================
 906   PDO(i,z)        = PLO(i,z)*(1+tticO(i,z));
 907   PMO(i,zj,z)     = eO(z)*(PWMO(i,zj,z)+SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])
 908                   *(1+ttimO(i,zj,z))*(1+tticO(i,z));
 909   PMTO(i,z)       = SUM[zj,PMO(i,zj,z)*IMO(i,zj,z)]/IMTO(i,z);
 910   PCO(i,z)        = [PMTO(i,z)*IMTO(i,z)+PDO(i,z)*DDO(i,z)]/QO(i,z);
 911   
 912   CO(i,z)         = CO(i,z)/PCO(i,z);
 913   CGO(i,z)        = CGO(i,z)/PCO(i,z);
 914   DIO(nene,j,z)   = DIO(nene,j,z)/PCO(nene,z);
 915   DEO(ene,j,z)    = DIO(ene,j,z)/PCO(ene,z);
 916   INVO(i,z)       = INVO(i,z)/PCO(i,z);
 917   
 918   CIO(j,z)        = SUM[nene,DIO(nene,j,z)];
 919   CEO(j,z)        = SUM[ene,DEO(ene,j,z)];
 920   
 921   DITO(nene,z)     = SUM[j,DIO(nene,j,z)];
 922   DITO(ene,z)      = SUM[j,DEO(ene,j,z)];
 923   
 924   PO4(ene,j,z)    = PCO(ene,z);
 925   
 926   PCIO(j,z)       = SUM[nene,PCO(nene,z)*DIO(nene,j,z)]/CIO(j,z);
 927   PCEO(j,z)       = SUM[ene,PCO(ene,z)*DEO(ene,j,z)]/CEO(j,z) ;
 928   
 929   WTIO(l,j,z)     = WO(l,z)*(1+ttiwO(l,j,z));
 930   
 931   WCO(j,z)$LDCO(j,z)
 932                   = SUM[l,WTIO(l,j,z)*LDO(l,j,z)]/LDCO(j,z);
 933   
 934  *==============================================================================
 935  *  4.4 Calibration of dynamic parameters
 936  *==============================================================================
 937  * Calibration of dynamic parameters following new procedure.
 938  * The price of capital is arbitrary:
 939   PKO(z) = 1;
 940   
 941  * The calibration of depreciation rates is based on two hypotheses:
 942  * 1. The rate of depreciation is the same for all types of capital and all
 943  *    industries in each region (this hypothesis is made to accommodate the fact
 944  *    that, in the GTAP data base, capital consumption allowance is not detailed;
 945  *    as a matter of fact, the GTAP capital consumption allowance is set at
 946  *    4% of the value of the capital stock).
 947  * 2. The rental rate of capital is uniform across industries and types of
 948  *    capital in each region.
 949  * 3. The investment rate (IND/KD) is uniform across industries and types of
 950  *    capital in each region.
 951  * These hypotheses lead to the following formulae:
 952   
 953  * From GTAP, we know KSTO.
 954   KSTO(z)         = KSTO(z)/PKO(z);
 955   
 956  * Assuming a uniform depreciation rate for all types
 957  * of capital and all industries:
 958   delta(z)        = DEPO(z)/[PKO(z)*KSTO(z)];
 959   
 960  * From GTAP, we know KSTO. Assuming a uniform rental rate R for all types
 961  * of capital and all industries:
 962   RO(k,j,z)$RKDO(k,j,z)
 963                   = SUM[(kj,jj),RKDO(kj,jj,z)]/KSTO(z);
 964   
 965  * Then from the GTAP value of income paid to capital RKD we calibrate KDO:
 966   KDO(k,j,z)$RKDO(k,j,z)
 967                   = RKDO(k,j,z)/RO(k,j,z);
 968   
 969  * The supply of capital is equal to demand:
 970   KSO(k,z)        = SUM[j,KDO(k,j,z)];
 971   
 972  * The rate of return on capital, net of depreciation, is:
 973   IRO(z)         = {SUM[(k,j)$RKDO(k,j,z),RKDO(k,j,z)]-DEPO(z)}/[PKO(z)*KSTO(z)];
 974   
 975  * The user cost of capital follows
 976   UO(z)           = PKO(z)*(IRO(z)+delta(z));
 977   
 978  * Combining
 979  * - the hypothesis of uniform investment rates
 980  * - the hypothesis of uniform rental rates
 981  * - the hypothesis of uniform depreciation rates
 982  * leads to
 983   phiO(z)         = [ITO(z)/PKO(z)]/KSTO(z);
 984   
 985  * Investment by destination follows:
 986   INDO(k,j,z)$KDO(k,j,z)
 987                   = phiO(z)*KDO(k,j,z);
 988   
 989   A_K(z)          = 1/PKO(z)*{PROD[i$gamma_INV(i,z),(PCO(i,Z)/gamma_INV(i,z))
 990                     **gamma_INV(i,z)]};
 991   
 992  * INDO(k,j,z)$KDO(k,j,z) = KDO(k,j,z)/sum((kj,jj),KDO(kj,jj,z))*ITO(z);
 993   
 994   KDCO(j,z)       = SUM[k,KDO(k,j,z)];
 995   RTIO(k,j,z)     = RO(k,j,z)*(1+ttikO(k,j,z));
 996   RCO(j,z)$KDCO(j,z)
 997                   = SUM[k,RTIO(k,j,z)*KDO(k,j,z)]/KDCO(j,z);
 998   
 999  *==============================================================================
1000  *  4.5 Calibration of other prices and revised volumes (part 3)
1001  *==============================================================================
1002   VAO(j,z)        = LDCO(j,z)+KDCO(j,z);
1003   
1004   PVAO(j,z)       = [WCO(j,z)*LDCO(j,z)+RCO(j,z)*KDCO(j,z)]/VAO(j,z);
1005   
1006  * PIXGDPO is tautologically equal to 1, based on its formula
1007  * PIXGDPO(z)      = {SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1008  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1009  *                   *SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1010  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]}**0.5;
1011   PIXGDPO(z)      = 1;
1012   
1013  * PIXGDP_WO is tautologically equal to 1, based on its formula
1014  * PIXGDP_WO       = {SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1015  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1016  *                   *SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1017  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]/eO(z)}**0.5;
1018   PIXGDP_WO       = 1;
1019   
1020  * PIXCONO(z) is tautologically equal to 1, based on its formula
1021  * PIXCONO(z)      = SUM[i,PCO(i,z)*CO(i,z)]
1022  *                  /SUM[i,PCO(i,z)*CO(i,z)];
1023   PIXCONO(z)      = 1;
1024   
1025  * PIXINVO(z) is tautologically equal to 1, based on its formula
1026  * PIXINVO(z)      = PROD[i$gamma_INV(i,z),(PCO(i,z)/PCO(i,z))**gamma_INV(i,z)];
1027   PIXINVO(z)      = 1;
1028   
1029  * PIXGVTO(z) is tautologically equal to 1, based on its formula
1030  * PIXGVTO(z)      = PROD[i$gamma_GVT(i,z),(PCO(i,z)/PCO(i,z))**gamma_GVT(i,z)];
1031   PIXGVTO(z)      = 1;
1032   
1033  *==============================================================================
1034  *  4.6 Calibration of function parameters
1035  *==============================================================================
1036  *   4.6.1 Leontief functions
1037  *==============================================================================
1038   io(j,z)         = CIO(j,z)/XSTO(j,z) ;
1039   
1040   io2(j,z)        = CEO(j,z)/XSTO(j,z) ;
1041   
1042   v(j,z)          = VAO(j,z)/XSTO(j,z) ;
1043   
1044   v2(j,z)         = (CEO(j,z)+VAO(j,z))/XSTO(j,z) ;
1045   
1046   aij(nene,j,z)   = DIO(nene,j,z)/CIO(j,z);
1047   aij2(ene,j,z)   = DEO(ene,j,z)/CEO(j,z);
1048   
1049  *==============================================================================
1050  *   4.6.2 Calibration of CET parameters
1051  *==============================================================================
1052  *    4.6.2.1 CET between total exports, domestic supply and margins
1053  *==============================================================================
1054   rho_X1(i,z)     = (1+sigma_X1(i,z))/sigma_X1(i,z);
1055   
1056   beta_EX_X1(i,z)$MRGNO(i,z)
1057                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1058                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1059                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1060                     eO(z)*PWMGO(i)*MRGNO(i,z)$MRGNO(i,z)**(1-rho_X1(i,z))+Tiny];
1061   
1062   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1063                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1064                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1065                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+Tiny];
1066   
1067   beta_D_X1(i,z)$MRGNO(i,z)
1068                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1069                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1070                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1071                     eO(z)*PWMGO(i)*MRGNO(i,z)**(1-rho_X1(i,z))];
1072   
1073   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1074                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1075                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1076                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1077   
1078   B_X1(i,z)       = XSO_I(i,z)/[beta_EX_X1(i,z)*EXTO(i,z)**rho_X1(i,z)
1079                    +beta_D_X1(i,z)*DSO_I(i,z)**rho_X1(i,z)+(1-beta_EX_X1(i,z)
1080                    -beta_D_X1(i,z))*MRGNO(i,z)**rho_X1(i,z)]**(1/rho_X1(i,z));
1081   
1082  *==============================================================================
1083  *    4.6.2.2 CET between exports to different trading partners
1084  *==============================================================================
1085   rho_X2(i,z)     = (1+sigma_X2(i,z))/sigma_X2(i,z);
1086   beta_X2(i,z,zj)$EXO(i,z,zj)
1087                   = [PEO(i,z,zj)*EXO(i,z,zj)**(1-rho_X2(i,z))]/
1088                     SUM[zjj$EXO(i,z,zjj),PEO(i,z,zjj)*EXO(i,z,zjj)
1089                     **(1-rho_X2(i,z))];
1090   B_X2(i,z)       = EXTO(i,z)/{SUM[zj,beta_X2(i,z,zj)*EXO(i,z,zj)**rho_X2(i,z)]
1091                     **(1/rho_X2(i,z))};
1092   
1093  *==============================================================================
1094  *   4.6.3 Calibration of CES parameters
1095  *==============================================================================
1096  *    4.6.3.0 Composite output
1097  *==============================================================================
1098   rho_X3(i,z)   = (1-sigma_X3(i,z))/sigma_X3(i,z);
1099   
1100   beta_X3(j,i,z)$XSO(j,i,z)
1101                 = [PO2(j,i,z)*XSO(j,i,z)**(1+rho_X3(i,z))]/
1102                     SUM[jj$XSO(jj,i,z),PO2(jj,i,z)*XSO(jj,i,z)**(1+rho_X3(i,z))];
1103   
1104   B_X3(i,z)     = XSO_I(i,z)
1105                    /SUM[jj$XSO(jj,i,z),beta_X3(jj,i,z)*XSO(jj,i,z)**(-rho_X3(i,z))
1106                    ]**(-1/rho_X3(i,z));
1107   
1108   POWERQO(Z) = SUM(POWER, XSO(power,'18_ELEC',z));
1109   
1110   sigma_X4(z) =2;
1111   
1112   rho_X4(z)   = (1-sigma_X4(z))/sigma_X4(z);
1113   
1114   beta_X4(power,z)
1115                 = [PO2(power,'18_ELEC',z)*XSO(power,'18_ELEC',z)**(1+rho_X4(z))]/
1116                     SUM[power2$XSO(power2,'18_ELEC',z),PO2(power2,'18_ELEC',z)*XSO(power2,'18_ELEC',z)**(1+rho_X4(z))];
1117   
1118   B_X4(z)     = POWERQO(Z)
1119                    /SUM[power2$XSO(power2,'18_ELEC',z),beta_X4(power2,z)*XSO(power2,'18_ELEC',z)**(-rho_X4(z))
1120                    ]**(-1/rho_X4(z));
1121   
1122   TnDShare(z) = XSO('18_TnD','18_ELEC',z) / XSO_I('18_ELEC',z);
1123   
1124   PPOWERO(z) = 1;
1125   
1126  *==============================================================================
1127  *    4.6.3.1 Composite good
1128  *==============================================================================
1129   rho_M1(i,z)     = (1-sigma_m1(i,z))/sigma_m1(i,z);
1130   beta_M1(i,z)    = PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)/
1131                    {PDO(i,z)*DDO(i,z)**(rho_M1(i,z)+1)
1132                    +PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)};
1133   B_M1(i,z)       = QO(i,z)/{beta_M1(i,z)*IMTO(i,z)**(-rho_M1(i,z))
1134                    +(1-beta_M1(i,z))*DDO(i,z)**(-rho_M1(i,z))}**(-1/rho_M1(i,z));
1135   
1136  *==============================================================================
1137  *    4.6.3.2 CES between imports from different trading partners
1138  *==============================================================================
1139   rho_M2(i,z)     = (1-sigma_M2(i,z))/sigma_M2(i,z);
1140   beta_M2(i,zj,z)$IMO(i,zj,z)
1141                   = [PMO(i,zj,z)*IMO(i,zj,z)**(rho_M2(i,z)+1)]/
1142                     SUM[zjj$IMO(i,zjj,z),PMO(i,zjj,z)*IMO(i,zjj,z)
1143                      **(rho_M2(i,z)+1)];
1144   B_M2(i,z)       = IMTO(i,z)/{SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*IMO(i,zj,z)
1145                     **(-rho_M2(i,z))]**(-1/rho_M2(i,z))};
1146   
1147  *==============================================================================
1148  *    4.6.3.3 Composite capital
1149  *==============================================================================
1150   rho_KD(j,z)     = (1-sigma_KD(j,z))/sigma_KD(j,z);
1151   
1152   beta_KD(k,j,z)$KDO(k,j,z)
1153                   = [RTIO(k,j,z)*KDO(k,j,z)**(1+rho_KD(j,z))]/
1154                     SUM[kj$KDO(kj,j,z),RTIO(kj,j,z)*KDO(kj,j,z)**(1+rho_KD(j,z))];
1155   B_KD(j,z)$KDCO(j,z)
1156                   = KDCO(j,z)/{SUM[k$KDO(k,j,z),beta_KD(k,j,z)*KDO(k,j,z)
1157                     **(-rho_KD(j,z))]**(-1/rho_KD(j,z))};
1158   
1159  *==============================================================================
1160  *    4.6.3.4 Composite labor
1161  *==============================================================================
1162   rho_LD(j,z)     = (1-sigma_LD(j,z))/sigma_LD(j,z);
1163   beta_LD(l,j,z)$LDO(l,j,z)
1164                   = [WTIO(l,j,z)*LDO(l,j,z)**(1+rho_LD(j,z))]/
1165                     SUM[lj$LDO(lj,j,z),WTIO(lj,j,z)*LDO(lj,j,z)
1166                     **(1+rho_LD(j,z))];
1167   B_LD(j,z)$LDCO(j,z)
1168                   = LDCO(j,z)/{SUM[l$LDO(l,j,z),beta_LD(l,j,z)*LDO(l,j,z)
1169                     **(-rho_LD(j,z))]**(-1/rho_LD(j,z))};
1170   
1171  *===============================================================================
1172  *   Composite E
1173  *===============================================================================
1174   rho_ENER(j,z)   = (1-sigma_ENER(j,z))/sigma_ENER(j,z);
1175   
1176   beta_ENER(ene,j,z)$DEO(ene,j,z)
1177                   = [PO4(ene,j,z)*DEO(ene,j,z)**(1+rho_ENER(j,z))]/
1178                     SUM[ene2$DIO(ene,j,z),DEO(ene2,j,z)**(1+rho_ENER(j,z))];
1179   
1180   B_ENER(j,z)$CEO(j,z)
1181                   = CEO(j,z)/{SUM[ene$DEO(ene,j,z),beta_ENER(ene,j,z)*DEO(ene,j,z)
1182                     **(-rho_ENER(j,z))]**(-1/rho_ENER(j,z))};
1183   
1184   B_ENER_t(j,z,time) = B_ENER(j,z)*(1/AEEI_low(z,'2019'));
1185   
1186  *==============================================================================
1187  *    4.6.3.5 Value added
1188  *==============================================================================
1189   sigma_VA('10_PETROLCOAL',z) = 1.260;
1190   display sigma_VA ;
1191   
1192   rho_VA(j,z)     = (1-sigma_VA(j,z))/sigma_VA(j,z);
1193   
1194   beta_VA(j,z)$KDCO(j,z)
1195                   = WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)/
1196                    {WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)+
1197                     RCO(j,z)*KDCO(j,z)**(rho_VA(j,z)+1)};
1198   B_VA(j,z)$KDCO(j,z)
1199                   = VAO(j,z)
1200                     /{[beta_VA(j,z)*LDCO(j,z)**(-rho_VA(j,z))+
1201                     (1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
1202                     ]**(-1/rho_VA(j,z))};
1203   
1204  *==============================================================================
1205  *    Composite KLE
1206  *==============================================================================
1207   KLEO(j,z)       = CEO(j,z) + VAO(j,z) ;
1208   
1209   PKLEO(j,z)      = [PCEO(j,z)*CEO(j,z)+PVAO(j,z)*VAO(j,z)]/KLEO(j,z);
1210   
1211   rho_KLE(j,z)    = (1-sigma_KLE(j,z))/sigma_KLE(j,z);
1212   
1213   beta_KLE(j,z)$KLEO(j,z)
1214                   = PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)/
1215                    {PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)+
1216                     PCEO(j,z)*CEO(j,z)**(rho_KLE(j,z)+1)};
1217   
1218   B_KLE(j,z)$KLEO(j,z)
1219                   = KLEO(j,z)
1220                     /{[beta_KLE(j,z)*VAO(j,z)**(-rho_KLE(j,z))+
1221                     (1-beta_KLE(j,z))*CEO(j,z)**(-rho_KLE(j,z))
1222                     ]**(-1/rho_KLE(j,z))};
1223   
1224  *==============================================================================
1225  *   4.6.4 Calibration of LES parameters
1226  *==============================================================================
1227  *   As the assigned values of income elasticities may not result in
1228  *   consumption shares that add up to 1, this first step
1229  *   adjusts the elasticities proportionally
1230   sigma_Y(i,z)    = sigma_Y(i,z)/{SUM[ij,sigma_Y(ij,z)*PCO(ij,z)*CO(ij,z)]
1231                     /CTHO(z)};
1232   gamma_LES(i,z)  = PCO(i,z)*CO(i,z)*sigma_Y(i,z)/CTHO(z);
1233   CMINO(i,z)      = CO(i,z)+gamma_LES(i,z)*CTHO(z)/{PCO(i,z)*frisch(z)};
1234   
1235  *==============================================================================
1236  *  4.7 Calibration of gross domestic products
1237  *==============================================================================
1238   GDP_BPO(z)      = SUM[j,PVAO(j,z)*VAO(j,z)]+TIPTO(z);
1239   GDP_MPO(z)      = GDP_BPO(z)+TPRCTSO(z);
1240   GDP_IBO(z)      = SUM[(l,j),WO(l,z)*LDO(l,j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1241                     +TPRODNO(z)+TPRCTSO(z);
1242   GDP_FDO(z)      = SUM[i,PCO(i,z)*(CO(i,z)+CGO(i,z)+INVO(i,z))]
1243                    +eO(z)*SUM[(i,zj),PWXO(i,z,zj)*EXO(i,z,zj)]
1244                    +eO(z)*SUM[i,PWMGO(i)*MRGNO(i,z)]
1245                    -eO(z)*SUM[(i,zj),IMO(i,zj,z)*(PWMO(i,zj,z)
1246                    +SUM{ij,PWMGO(ij)*tmrg(ij,i,zj,z)})];
1247   GDP_BP_WO       = SUM[z,GDP_BPO(z)/eO(z)];
1248   
1249  *==============================================================================
1250  *  4.8 Calibration of real (volume) variables computed from price indices
1251  *==============================================================================
1252   CABXO(z)        = CABO(z)/[PIXGDP_WO*eO(z)];
1253   
1254  *------------------------------------------------------------------------------
1255  * Calculation of CAB index
1256  * If every region's CABX grows exogenously according to exogro, then the
1257  * worldwide sum of CABX's will not be zero. If, due to redundancy, the reference
1258  * region's CABX is left implicit, then it will not grow according to that
1259  * region's exogro (it follows that the solution will depend on the choice of
1260  * reference region). CABix is formed from exogro by inflating or deflating the
1261  * updating factors of positive (SURplus) and negative (DEFicit) CABX's in such
1262  * a way that their sum remains zero.
1263   
      Parameter CABXsur(z,time), CABXdef(z,time), bal(time), mu(time), CABix(z,time);
       CABXsur(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) gt 0];
       CABXdef(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) lt 0];
       Bal(time)       = sum(zj,CABXsur(zj,time))+sum(zj,CABXdef(zj,time));
       mu(time)        = sum(zj,CABXsur(zj,time))/
                           {sum(zj,CABXsur(zj,time))+sum(zj,abs[CABXdef(zj,time)])};
       CABXsur(z,time) = CABXsur(z,time)*{1-mu(time)*Bal(time)/sum(zj,CABXsur(zj,time))};
       CABXdef(z,time) = CABXdef(z,time)*{1-[1-mu(time)]*Bal(time)/sum(zj,CABXdef(zj,time))};
       CABix(z,time)   = [CABXsur(z,time)+CABXdef(z,time)]/CABXO(z);
1275  *------------------------------------------------------------------------------
1276   
1277   CTH_REALO(z)    = CTHO(z)/PIXCONO(z);
1278   G_REALO(z)      = GO(z)/PIXGVTO(z);
1279   GDP_BP_REALO(z) = GDP_BPO(z)/PIXGDPO(z);
1280   GDP_BP_W_REALO  = GDP_BP_WO/PIXGDP_WO;
1281   GDP_MP_REALO(z) = GDP_MPO(z)/PIXCONO(z);
1282   IT_REALO(z)     = ITO(z)/PIXINVO(z);
1283   
1284  *==============================================================================
1285  *  4.9 Parameters of the household savings function
1286  *==============================================================================
1287  * sh1O(z)         = SHO(z)/YDHO(z);
1288  * sh0O(z)         = 0 ;
1289   
1290   sh1O(z)         = [SHO(z)+SGO(z)]/GDP_IBO(z);
1291   sh0O(z)         = SHO(z)-sh1O(z)*YDHO(z);
1292   
1293  *==============================================================================
1294  *  4.10 Re-calibration of indexed transfers and parameters
1295  *==============================================================================
1296   sh0O(z)         = sh0O(z)/PIXCONO(z)**eta;
1297   ttdh0O(z)       = ttdh0O(z)/PIXCONO(z)**eta;
1298   
