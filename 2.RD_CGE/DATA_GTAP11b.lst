 466  *==============================================================================
 467  * 2. Calibration of variables
 468  *==============================================================================
 469   
 470  Parameter
 471  *==============================================================================
 472  *  2.1 Variables in GTAP8.1
 473  *==============================================================================
 474  * These are the variables from GTAP8.1 used in the calibration process.
 475  * Population data is in million while all other data are expressed in millions
 476  * of USD
 477   
 478   EVOS(endw,acts,reg)            Endowments at agents prices
 479   FBEP(endw,acts,reg)            Factor-based subsidies
 480   FTRV(endw,acts,reg)            Taxes - Factor Employment Tax Revenue
 481   MFRV(comm,reg,reg)             Protection MFA export subsidy equivalent
 482   OSEP(comm,reg)                 Ordinary output subsidies
 483   POP(reg)                       Population
 484   TFRV(comm,reg,reg)             Protection Ordinary Import Duty
 485   VDEP(reg)                      Capital Stock Value of Depreciation
 486   VDFP(comm,acts,reg)            Intermed Firms Dom Purchases at Agent Prices
 487   VDFB(comm,acts,reg)            Intermed Firms Dom Purchases at Mkt Prices
 488   VMFP(comm,acts,reg)            Intermed Firms Imp Purchases at Agent Prices
 489   VMFB(comm,acts,reg)            Intermed Firms Imp Purchases at Mkt Prices
 490   VDGP(comm,reg)                 Government Dom Purchases at Agents Prices
 491   VDGB(comm,reg)                 Government Dom Purchases at Market Prices
 492   VDPP(comm,reg)                 Private Hhold Dom Purchases at Agents Prices
 493   VDPB(comm,reg)                 Private Hhold Dom Purchases at Market Prices
 494   EVFB(endw,acts,reg)            Endowments Firms Purchases at Market Prices
 495   VIFA(comm,acts,reg)            Intermed Firms Imports at Agents Prices
 496   VIFM(comm,acts,reg)            Intermed Firms Imports at Market Prices
 497   VMGP(comm,reg)                 Government Imports at Agents Prices
 498   VMGB(comm,reg)                 Government Imports at Market Prices
 499   VMSB(comm,reg,reg)             Trade Bilateral Imports at Market Prices
 500   VMPP(comm,reg)                 Private Households Imports at Agents Prices
 501   VMPB(comm,reg)                 Private Households Imports at Market Prices
 502   VCIF(comm,reg,reg)             Trade Bilateral Imports at World Prices
 503   VKB(reg)                       Capital Stock Value at Beginning-of-Period
 504   VST(marg,reg)                  Trade Exports Internatl Trans Mkt Prices
 505   VTMFSD(marg,comm,reg,reg)      Trade Margins Internatl Trans World Prices
 506   VXSB(comm,reg,reg)             Trade Bilateral Exports at Market Prices
 507   VFOB(comm,reg,reg)             Trade Bilateral Exports at World Prices
 508   XTRV(comm,reg,reg)             Protection Ordinary Export Subsidy
 509   VDIP(comm,reg)                 Investment expenditure on dom. c in r at producer prices
 510   VMIP(comm,reg)                 Investment expenditure on imp. c in r at producer prices
 511   VDIB(comm,reg)                 Investment expenditure on dom. c in r at basic prices
 512   VMIB(comm,reg)                 Investment expenditure on imp. c in r at basic prices
 513   MAKES(comm,acts,reg)           Make matrix valued at suppliers prices
 514   MAKEB(comm,acts,reg)           Make matrix valued at basic prices
 515   
 516  *==============================================================================
 517  *  2.2 Variables in the aggregated model
 518  *==============================================================================
 519   CO(i,z)         Household consumption of commodity I
 520   CGO(i,z)        Public final consumption of commodity i
 521   INVO(i,z)       Final demand of commodity i for investment purposes
 522   DDO(i,z)        Demand for domestic production of commodity i
 523   DEPO(z)         Depreciation
 524   DIO(i,j,z)      Intermediate consumption of commodity i by industry j
 525   DSO(j,i,z)      Supply of commodity i by sector j to the domestic market
 526   EXO(i,z,zj)     Exports supply of commodity i from country z to country zj
 527   EXTO(i,z)       Total Export
 528   IMO(i,zj,z)     Imports of commodity m by country z from country zj
 529   RKDO(k,j,z)     Type k capital income in industry j
 530   RKDO_J(k,z)     Type k capital income
 531   KSTO(z)         Total capital stock in region z
 532   LDO(l,j,z)      Industry j demand for labour l
 533   LDO_J(l,z)      Demand for labour l
 534   MRGNO(i,z)      Demand for commodity i as a margin
 535   POPO(z)         Population
 536   TDHO(z)         Household income taxes
 537   DTAX(f,z)       Direct taxes
 538   TICO(i,z)       Government receipts of indirect taxes on commodity i
 539   TIKO(k,j,z)     Government receipts of indirect taxes on capital k of industry j
 540   TIKO_J(k,z)     Government receipts of indirect taxes on capital k
 541   TIMO(i,zj,z)    Government receipts of indirect taxes on imports of commodity i
 542   TIPO(j,z)       Government receipts of indirect taxes on production of industry j
 543   TIWO(l,j,z)     Government receipts of indirect taxes on wages and salaries of industry j
 544   TIWO_J(l,z)     Government receipts of indirect taxes on wages and salaries
 545   TIXO(i,z,zj)    Government receipts of indirect taxes on exports of commodity i
 546   tmrg(i,ij,zj,z) Rate of commodity i margin applied to import m from country zj
 547   XSO_I(i,z)      total production by commodity
 548   XSO(j,i,z)      Industry j production of commodity i
 549   XSTO(j,z)       Total aggregate output of industry j
 550   tssm(i,j,z)     Intermediate tax by source import
 551   tssd(i,j,z)     Intermediate tax by source domestic
 552   MAKE(j,i,z)     Make matrix valued at basic prices
 553   DSO_I(i,z)      Supplys of domestic production of commodity i
 554   XSO_I(i,z)      Total aggregate output of commoity i
 555   
 556   DIO2(i,z)
 557   TIMO2(i,z)
 558   IMO2(i,z)
 559   tmrg2(i,z)
 560   tmrg3(ij,zj)
 561   tmrg4(zj)
 562   DIO3(j,z)
 563   LDO2(j,z)
 564   TIWO2(j,z)
 565   TIKO2(j,z)
 566   RKDO2(k,j,z)
 567   RKDO2(k,j,z)
 568   DDO_Matrix(i,ij,z)
 569   XSO_Matrix(i,ij,z)
 570  ;
 571   
 572  *==============================================================================
 573  *  2.3 Loading parameters from GTAP database
 574  *==============================================================================
--- LOAD  EVOS = 13:EVOS
--- LOAD  FBEP = 40:FBEP
--- LOAD  FTRV = 41:FTRV
--- LOAD  MFRV = 46:MFRV
--- LOAD  OSEP = 43:OSEP
--- LOAD  POP = 42:POP
--- LOAD  TFRV = 45:TFRV
--- LOAD  VDEP = 31:VDEP
--- LOAD  VDFP = 11:VDFP
--- LOAD  VDFB = 9:VDFB
--- LOAD  VDGP = 20:VDGP
--- LOAD  VDGB = 18:VDGB
--- LOAD  VMFP = 12:VMFP
--- LOAD  VMFB = 10:VMFB
--- LOAD  MAKES = 16:MAKES
--- LOAD  MAKEB = 17:MAKEB
--- LOAD  VDPP = 24:VDPP
--- LOAD  VDPB = 22:VDPB
--- LOAD  EVFB = 14:EVFB
--- LOAD  VDIP = 28:VDIP
--- LOAD  VDIB = 26:VDIB
--- LOAD  VMIP = 29:VMIP
--- LOAD  VMIB = 27:VMIB
--- LOAD  VMGP = 21:VMGP
--- LOAD  VMGB = 19:VMGB
--- LOAD  VMPP = 25:VMPP
--- LOAD  VMPB = 23:VMPB
--- LOAD  VMSB = 35:VMSB
--- LOAD  VCIF = 34:VCIF
--- LOAD  VKB = 39:VKB
--- LOAD  VST = 36:VST
--- LOAD  VTMFSD = 38:VTMFSD
--- LOAD  VXSB = 32:VXSB
--- LOAD  VFOB = 33:VFOB
--- LOAD  XTRV = 44:XTRV
 578   
 579  *==============================================================================
 580  * 2.4 Mapping between variables in the model and GTAP
 581  *==============================================================================
 582  * NOTE: In GTAP parlance, "agents' prices" are prices paid by buyers, and
 583  *       "market prices" are prices received by sellers.
 584  * A - Agent Price
 585  * P - Producer Price
 586  * B - Basic Price
 587   
 588  *==============================================================================
 589  * 2.4.1 Households consumption
 590  *==============================================================================
 591  * Households consumption is given by the sum of domestic purchases at
 592  * agents prices (VDPP) and private household imports at agents prices (VMPP).
 593   
 594   CO(i,z)         = SUM{(comm,reg)$[i2comm(i,comm)$z2reg(z,reg)],
 595                         VDPP(comm,reg)+VMPP(comm,reg)};
 596   
 597  *==============================================================================
 598  * 2.4.2 Public final consumption
 599  *==============================================================================
 600  * Public final consumption is given by the sum of domestic purchases at
 601  * agents prices (VDGP) and public final imports at agents prices (VMGP).
 602   
 603   CGO(i,z)        = SUM{(comm,reg)$[i2comm(i,comm)$z2reg(z,reg)],
 604                         VDGP(comm,reg)+VMGP(comm,reg)};
 605   
 606  *==============================================================================
 607  * 2.4.3 Demand for investment purposes
 608  *=============================================================================
 609  *  In the GTAP data, the accumulation account is presented in the
 610  *  production sector CGDS (Capital goods). Demand for investment purposes
 611  *  is thus given by the sum of domestic purchases at agents prices (VDFP)
 612  *  and public final imports at agents prices (VIFA) for this sector.
 613   
 614   INVO(i,z)       = SUM{(comm,reg)$[i2comm(i,comm)$z2reg(z,reg)],
 615  *                      VDFP(comm,'CGDS',reg)+VIFA(comm,'CGDS',reg)};
 616                        VDIP(comm,reg)+VMIP(comm,reg)};
 617   
 618  *==============================================================================
 619  * 2.4.4 Intermediate demand
 620  *==============================================================================
 621  * Intermediate consumption is given by the sum of domestic purchases at
 622  * agents prices (VDFP) and public final imports at agents prices (VIFA).
 623   
 624   DIO(i,j,z)      = SUM[(comm,acts,reg)$[i2comm(i,comm)
 625                        $j2acts(j,acts)$z2reg(z,reg)],
 626                        VDFP(comm,acts,reg)
 627                       +VMFP(comm,acts,reg)];
 628   
 629   DIO(i,'09_PAPERPRO','05_MNG')$(DIO(i,'09_PAPERPRO','05_MNG') lt 0.0000068505) = 0.000001 ;
 630   
 631   
 632   tssm(i,j,z)    = SUM[(comm,acts,reg)$[i2comm(i,comm)
 633                        $j2acts(j,acts)$z2reg(z,reg)],
 634                        VMFP(comm,acts,reg)-VMFB(comm,acts,reg)];
 635   
 636   tssd(i,j,z)    = SUM[(comm,acts,reg)$[i2comm(i,comm)
 637                        $j2acts(j,acts)$z2reg(z,reg)],
 638                        VDFP(comm,acts,reg)-VDFB(comm,acts,reg)];
 639   
 640  *==============================================================================
 641  * 2.4.5 Imports
 642  *==============================================================================
 643  * Imports are defined in GTAP at world prices (VCIF) and at market prices
 644  * (VMSB). Data on bilateral flows also include margins on imports (VTMFSD) and
 645  * import duties (TFRV). On the export side, the database includes exports at
 646  * market prices (VXSB), at world prices (VFOB) and subsidies on exports (MFRV
 647  * and XTRV).
 648  * The relationships between those variables is the following:
 649  *       VMSB = VCIF + TFRV
 650  *       VCIF = VFOB + VTMFSD
 651  *       VXSB = VFOB - MFRV - XTRV
 652  *
 653  * Imports are evaluated at world prices (VCIF) less transport margins (VTMFSD).
 654   
 655  ** Elimination of trade within a country:
 656  ** Trade within any entity that is a GTAP single-country region (or equivalent)
 657  ** is removed.
 658   VCIF(comm,z1c,z1c)        = 0;
 659   VTMFSD(marg,comm,z1c,z1c) = 0;
 660   
 661   IMO(i,zj,z)     = SUM{(comm,regj,reg)$[i2comm(i,comm)
 662                         $z2reg(zj,regj)$z2reg(z,reg)],
 663                         VCIF(comm,regj,reg)-
 664                         SUM[marg,VTMFSD(marg,comm,regj,reg)]};
 665  *lt Strictly less than
 666   IMO(i,zj, z)$(IMO(i, zj, z) lt  0.0001) = 0.00001 ;
 667   IMO(i,zj,z)$sameas(zj,z) = 0 ;
 668  *==============================================================================
 669  * 2.4.6 Exports
 670  *==============================================================================
 671  *  To limit the sources of potential desequilibrium, exports are simply set
 672  *  equal to imports.
 673   
 674   EXO(i,zj,z)     = IMO(i,zj,z);
 675   EXTO(i,z)       = sum(zj, EXO(i,z,zj));
 676  * EXO(i,zj,z)     = SUM{(comm,regj,reg)$[j2comm(i,comm)
 677  *                       $z2reg(zj,regj)$z2reg(z,reg)],
 678  *                       VXSB(comm,regj,reg)};
 679   
 680  *==============================================================================
 681  * 2.4.7 Margins
 682  *==============================================================================
 683  *  Transport margins are given by the variable VTMFSD
 684  * tmrg(TRP,ij,zj,z)$IMO(ij,zj,z)
 685  *                 = SUM{(comm,regj,reg)$[j2comm(ij,comm)
 686  *                       $z2reg(zj,regj)$z2reg(z,reg)],
 687  *                       SUM[marg,VTMFSD(marg,comm,regj,reg)]};
 688   
 689    tmrg('20_LTRP',ij,zj,z)$IMO(ij,zj,z)
 690                   = SUM{(comm,regj,reg)$[i2comm(ij,comm)
 691                         $z2reg(zj,regj)$z2reg(z,reg)],
 692                         VTMFSD('otp',comm,regj,reg)};
 693   
 694    tmrg('21_WTRP',ij,zj,z)$IMO(ij,zj,z)
 695                   = SUM{(comm,regj,reg)$[i2comm(ij,comm)
 696                         $z2reg(zj,regj)$z2reg(z,reg)],
 697                         VTMFSD('wtp',comm,regj,reg)};
 698   
 699   tmrg('22_ATRP',ij,zj,z)$IMO(ij,zj,z)
 700                   = SUM{(comm,regj,reg)$[i2comm(ij,comm)
 701                         $z2reg(zj,regj)$z2reg(z,reg)],
 702                         VTMFSD('atp',comm,regj,reg)};
 703   
 704   tmrg3(ij,zj) = tmrg('20_LTRP',ij,zj,'01_KOR') ;
 705   
 706   tmrg4(zj) = sum(ij,tmrg('20_LTRP',ij,zj,'01_KOR')) ;
 707   
 708  * Supply of transport margin are given by the variable VST
 709   MRGNO(i,z)      = SUM{(marg,reg)$[i2comm(i,marg)$z2reg(z,reg)],
 710                         VST(marg,reg)};
 711   
 712  *==============================================================================
 713  * 2.4.8 Import duties
 714  *==============================================================================
 715  *  Import duties are given by the variable TFRV
 716   
 717   TIMO(i,zj,z)$IMO(i,zj,z)
 718                   = SUM{(comm,regj,reg)$[i2comm(i,comm)
 719                         $z2reg(zj,regj)$z2reg(z,reg)],
 720                         TFRV(comm,regj,reg)};
 721   
 722  *==============================================================================
 723  * 2.4.9 Taxes on exports
 724  *==============================================================================
 725  *  Taxes on exports are given by the sum of MRRV and XTRV
 726   
 727  * TIXO(i,z,zj)$IMO(i,z,zj)
 728   TIXO(i,z,zj)$IMO(i,z,zj)
 729                   = SUM{(comm,reg,regj)$[i2comm(i,comm)
 730                         $z2reg(z,reg)$z2reg(zj,regj)],
 731                         MFRV(comm,reg,regj)+XTRV(comm,reg,regj)};
 732   
 733  *==============================================================================
 734  * 2.4.10 Taxes on factors of production
 735  *==============================================================================
 736  * Net taxes on factor of production are calculated as taxes (FTRV)
 737  * less subsidies (FBEP).
 738   
 739   TIWO(l,j,z)      = SUM{(endw,acts,reg)$[f2endw(l,endw)
 740                         $j2acts(j,acts)$z2reg(z,reg)],
 741                         FTRV(endw,acts,reg)+
 742                         FBEP(endw,acts,reg)};
 743   
 744   TIWO_J(l,z) = SUM(j, TIWO(l,j,z));
 745   
 746   TIKO(k,j,z)     = SUM{(endw,acts,reg)$[f2endw(k,endw)
 747                         $j2acts(j,acts)$z2reg(z,reg)],
 748                         FTRV(endw,acts,reg)+
 749                         FBEP(endw,acts,reg)};
 750   
 751   TIKO_J(k,z) = SUM(j, TIKO(k,j,z));
 752  *==============================================================================
 753  * 2.4.11 Taxes on production
 754  *==============================================================================
 755  * Taxes on production are set equal to the negative value of production
 756  * subsidies (OSEP).
 757   
 758   TIPO(j,z)       = SUM{(comm,reg)$[j2comm(j,comm)$z2reg(z,reg)],
 759                         OSEP(comm,reg)};
 760   
 761  *==============================================================================
 762  * 2.4.12 Domestic taxes on commodities
 763  *==============================================================================
 764  * Domestic taxes on commodities are evaluated as the difference between
 765  * demand at agent prices and demand at market prices.
 766   
 767   TICO(i,z)       = SUM{(comm,reg)$[i2comm(i,comm)$z2reg(z,reg)],
 768                        VDPP(comm,reg)-VDPB(comm,reg)
 769                       +VMPP(comm,reg)-VMPB(comm,reg)
 770                       +VDGP(comm,reg)-VDGB(comm,reg)
 771                       +VMGP(comm,reg)-VMGB(comm,reg)
 772                       +SUM[acts,VDFP(comm,acts,reg)
 773  *                          +VIFA(comm,acts,reg)]
 774                            +VMFP(comm,acts,reg)]
 775   
 776                       -SUM[acts,VDFB(comm,acts,reg)
 777  *                          +VIFM(comm,acts,reg)]};
 778                             +VMFB(comm,acts,reg)]};
 779   
 780  *==============================================================================
 781  * 2.4.13 Direct taxes
 782  *==============================================================================
 783  * Direct taxes is given by the difference between factor payment at
 784  * market prices (EVFB) and endowment at agent prices (EVOS)
 785   
 786   TDHO(z)            = SUM{reg$z2reg(z,reg),
 787                         SUM[endw,SUM(acts,EVFB(endw,acts,reg))
 788                         -SUM(acts,EVOS(endw, acts, reg))]};
 789   
 790   DTAX(f,z)          = SUM{(endw,reg)$[f2endw(f,endw)$z2reg(z,reg)],
 791                         SUM[acts,EVFB(endw,acts,reg)] -
 792                         SUM[acts,EVOS(endw,acts, reg)]} ;
 793   
 794  *==============================================================================
 795  * 2.4.14 Factors of production
 796  *==============================================================================
 797  * Remuneration of the production factors is evaluated at market prices,
 798  * that is before taxes (EVFB).
 799   
 800   LDO(l,j,z)      = SUM{(endw,acts,reg)$[f2endw(l,endw)
 801                         $j2acts(j,acts)$z2reg(z,reg)],
 802                         EVFB(endw,acts,reg)};
 803   
 804   LDO_J(l,z)       = SUM(j,LDO(l,j,z)) - DTAX(l,z);
 805   
 806   RKDO(k,j,z)      = SUM{(endw,acts,reg)$[f2endw(k,endw)
 807                         $j2acts(j,acts)$z2reg(z,reg)],
 808                         EVFB(endw,acts,reg)};
 809   
 810  * Total capital stock at the beginning of the period
 811   KSTO(z)         = SUM{reg$z2reg(z,reg),VKB(reg)};
 812   
 813  *==============================================================================
 814  * 2.4.15 Depreciation
 815  *==============================================================================
 816  * Depreciation is given by the variable VDEP
 817   
 818   DEPO(z)         = SUM{reg$z2reg(z,reg),VDEP(reg)};
 819   
 820  *==============================================================================
 821  * 2.4.16 Population
 822  *==============================================================================
 823  *  Population by region
 824   POPO(z)         = SUM{reg$z2reg(z,reg),POP(reg)};
 825   
 826  *==============================================================================
 827  * 2.4.17 Domestic demand
 828  *==============================================================================
 829  * Once again, to avoid descrepencies, domestic purchases are calculated
 830  * by substracting imports, transport margins and indirect taxes from total
 831  * domestic absorption.
 832   
 833   DDO(i,z)        = CO(i,z)+CGO(i,z)+INVO(i,z)+SUM[j,DIO(i,j,z)]-TICO(i,z)
 834                     -SUM[zj,TIMO(i,zj,z)]-SUM[zj,IMO(i,zj,z)]
 835                     -SUM[(ij,zj),tmrg(ij,i,zj,z)];
 836   
 837   DIO2(i,z)  = SUM[j,DIO(i,j,z)];
 838   TIMO2(i,z) = SUM[zj,TIMO(i,zj,z)];
 839   IMO2(i,z)  = SUM[zj,IMO(i,zj,z)];
 840   tmrg2(i,z) = SUM[(ij,zj),tmrg(ij,i,zj,z)] ;
 841   
 842   
 843  *==============================================================================
 844  * 2.4.18 MAKE Matrix
 845  *==============================================================================
 846   
 847   MAKE(j,i,z) = SUM[(acts,comm,reg)$[i2comm(i,comm)
 848                        $j2acts(j,acts)$z2reg(z,reg)],
 849                        MAKEB(comm,acts,reg)];
 850   
 851  *==============================================================================
 852  * 2.5 Equilibrate data
 853  *==============================================================================
 854  *  2.5.1 Equilibrium on the world margin market
 855  *==============================================================================
 856  *  The first step would be to equilibrate international markets. As there is a
 857  *  small difference between supply of margins and demand, we chose to adjust
 858  *  the supply side by increasing or reducing each region's production
 859  *  proportionately.
 860   
 861   MRGNO(i,z)$MRGNO(i,z)
 862                   = MRGNO(i,z)*SUM[(ij,zj,zjj),tmrg(i,ij,zj,zjj)]
 863                    /SUM[zjj,MRGNO(i,zjj)];
 864   
 865  **==============================================================================
 866  * 2.5.2 Equilibrium in each region
 867  *==============================================================================
 868  *  As exports have already been set equal to imports, the remaining differences
 869  *  would appear in the national data. Total production is first set equal to
 870  *  the sum of production for the domestic market (DSO), adjusted production
 871  *  of margins (MRGNO) and exports.
 872   
 873  * DSO(i,z)        = DDO(i,z);
 874  * XSO(j,z)        = DSO(j,z)+MRGNO(j,z)+SUM[zj,EXO(j,z,zj)-TIXO(j,z,zj)];
 875   
 876  *Table XSO_Matrix(i,j,z) ;
 877  * XSO_Matrix(i,j,z) =   XSO(j,z)$sameas(i,j);
 878   
 879   DSO_I(i,z)        = DDO(i,z) ;
 880   XSO_I(i,z)        = DDO(i,z)+MRGNO(i,z)+SUM[zj,EXO(i,z,zj)-TIXO(i,z,zj)];
 881   XSO(j,i,z)        = XSO_I(i,z)*[MAKE(j,i,z)/sum(jj,MAKE(jj,i,z))];
 882   XSTO(j,z)         = SUM(i, XSO(j,i,z));
 883   
 884   EXTO(i,z)         = SUM[zj,EXO(i,z,zj)];
 885   DSO(j,i,z)        = DDO(i,z)*[MAKE(j,i,z)/sum(jj,MAKE(jj,i,z))];
 886   
 887  *  The operating surplus is the variable that was used to equilibrate the
 888  *  regional data. As all other variables (income, savings and so on) will
 889  *  be calculated based on the variables described in these steps, there
 890  *  should not be any other descrepency.
 891   
 892  * Balancing in 2019 Database
 893  TIPO('09_PAPERPRO','05_MNG') = 0.0001  ;
 894  TIXO('10_PETROLCOAL','05_MNG','06_PRK') = 0 ;
 895  RKDO('cap',j,z)  = XSTO(j,z)-SUM[i,DIO(i,j,z)]-SUM[l,LDO(l,j,z)+TIWO(l,j,z)]
 896                    -TIPO(j,z)-SUM[k,TIKO(k,j,z)]-RKDO('land',j,z) -RKDO('natr',j,z);
 897   
 898  RKDO_J(k,z) = sum(j,RKDO(k,j,z)) - DTAX(k,z);
 899   
 900  DIO3(j,z) = SUM[i,DIO(i,j,z)];
 901  LDO2(j,z) = SUM[l,LDO(l,j,z)];
 902  TIWO2(j,z) = SUM[l,TIWO(l,j,z)];
 903  TIKO2(j,z) = SUM[k,TIKO(k,j,z)];
 904  RKDO2('land',j,z) =RKDO('land',j,z);
 905  RKDO2('natr',j,z) =RKDO('natr',j,z);
 906   
 907  *Recalibrating
 908  *KSTO(z)  = sum((k,j),RKDO(k,j,z));
 909   
 910  Display RKDO ;
 911  *$EXIT
 912  *==============================================================================
 913  * 3. CES elasticities
 914  *==============================================================================
 915  * 3.1 Definition of GTAP parameters
 916  *==============================================================================
 917  PARAMETER
 918   ESUBD(comm, reg)   Elasticity of substitution between domestic product and imports
 919   ESUBM(comm, reg)   Elasticity of substitution between imports from different regions
 920   ESUBVA(acts, reg)  Elasticity of substitution between primary factors in the production of value added
 921   ELFKLE(acts, reg)  Elasticity of substitution between VA-energy sub-production
 922   
 923  *==============================================================================
 924  * 3.2 Definition in PEP w
 925  *==============================================================================
 926   sigma_M1(i,z)   Elasticity (CES - composite commodity)
 927   sigma_M2(i,z)   Elasticity (CES - composite import)
 928   sigma_VA(j,z)   Elasticity (CES - value added)
 929   sigma_KLE(j,z)  Elastcitiy (CES - KL-E)
 930   
 931  *==============================================================================
 932  * 3.3 Temporary variables
 933  *==============================================================================
 934   IM_GTAP(comm,z)  Total imports using the GTAP commodity sets
 935   Q_GTAP(comm,z)   Composite commodity using the GTAP commodity sets
 936   VA_GTAP(acts,z)  Value added using the GTAP sectors
 937   KLE_GTAP(acts,z) KLE using the GTAP sectors
 938   E_GTAP(acts,z)   E using ther GTAP sectors
 939   SH_IM(comm,i,z)  Share of each import TRAD_COM in aggregation i for region z
 940   SH_Q(comm,i,z)   Share of each composite commodity TRAD_COM in aggregation i for region z
 941   SH_VA(acts,j,z)  Share of each sector TRAD_COM in aggregation j for region z
 942   SH_KLE(acts,j,z)   Share of each sector KLE in aggregation j for region z
 943  ;
 944   
 945  *==============================================================================
 946  * 3.4 Load the GTAP file which includes the parameters
 947  *==============================================================================
GDXIN   C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.RD_CGE\Input_w-t\GTAP11_Parameters2019.gdx
--- LOAD  ESUBD = 21:ESUBD
--- LOAD  ESUBM = 22:ESUBM
--- LOAD  ESUBVA = 18:ESUBVA
--- LOAD  ELFKLE = 63:ELFKLE
 950   
 951  Display ESUBD, ESUBM, ESUBVA, ELFKLE ;
 952  *==============================================================================
 953  *  3.5 sigma_M1
 954  *==============================================================================
 955  * Elasticities of substitution between domestic product and imports are
 956  * aggregated acording to the share of each commodity (QO) TRAD_COMM in total I
 957   
 958   Q_GTAP(comm,z)
 959                   = SUM{reg$z2reg(z,reg),
 960                     VDPP(comm,reg)+VMPP(comm,reg)+
 961                     VDGP(comm,reg)+VMGP(comm,reg)+
 962                     VDIP(comm,reg)+VMIP(comm,reg)+
 963                     SUM[acts,VDFP(comm,acts,reg)+
 964                         VMFP(comm,acts,reg)]};
 965   
 966   
 967   SH_Q(comm,i,z)$i2comm(i,comm)
 968                   = Q_GTAP(comm,z)/
 969                     SUM{commi$i2comm(i,commi),
 970                         Q_GTAP(commi,z)};
 971   
 972   sigma_M1(i,z)   = SUM{(comm,reg)$[i2comm(i,comm)$z2reg(z,reg)],
 973                     ESUBD(comm,reg)*SH_Q(comm,i,z)};
 974   
 975  *==============================================================================
 976  *  3.6 sigma_M2
 977  *==============================================================================
 978  * Elasticities of substitution between imports from different partners are
 979  * aggregated acording to the share of total import (IMTO) TRAD_COMM in total I
 980   
 981   IM_GTAP(comm,z)
 982                   = SUM[regj,SUM{reg$z2reg(z,reg),VCIF(comm,regj,reg)}];
 983   
 984   SH_IM(comm,i,z)$i2comm(i,comm)
 985                   = IM_GTAP(comm,z)/
 986                     SUM{commi$i2comm(i,commi),
 987                         IM_GTAP(commi,z)};
 988   
 989   sigma_M2(i,z)   = SUM{(comm,reg)$[i2comm(i,comm)$z2reg(z,reg)],
 990                     ESUBM(comm,reg)*SH_IM(comm,i,z)};
 991   
 992  *==============================================================================
 993  *  3.7 sigma_VA
 994  *==============================================================================
 995  * Elasticities of substitution between factors of production are aggregated
 996  * acording to the share of each sector (VA) TRAD_COMM in total I
 997   
 998   VA_GTAP(acts,z)
 999                   = SUM{endw,
1000                         SUM[reg$z2reg(z,reg),EVFB(endw,acts,reg)]};
1001   
1002   SH_VA(acts,j,z)$j2acts(j,acts)
1003                   = VA_GTAP(acts,z)/
1004                     SUM{actsj$j2acts(j,actsj),
1005                         VA_GTAP(actsj,z)};
1006   
1007   sigma_VA(j,z)   = SUM{(acts,reg)$[j2acts(j,acts)$z2reg(z,reg)],
1008                     ESUBVA(acts,reg)*SH_VA(acts,j,z)};
1009   
1010  *==============================================================================
1011  *  3.8 sigma_KLE
1012  *==============================================================================
1013   
1014   KLE_GTAP(acts,z)
1015                   = SUM{endw,
1016                         SUM[reg$z2reg(z,reg),EVFB(endw,acts,reg)]} +
1017                       SUM[i,
1018                          SUM[(comm,reg)$[i2comm2(i,comm)$z2reg(z,reg)],
1019                               VDFP(comm,acts,reg)+VMFP(comm,acts,reg)]];
1020   
1021   E_GTAP(acts,z)
1022                   = SUM[i,
1023                          SUM[(comm,reg)$[i2comm2(i,comm)$z2reg(z,reg)],
1024                               VDFP(comm,acts,reg)+VMFP(comm,acts,reg)]];
1025   
1026   SH_KLE(acts,j,z)$j2acts(j,acts)
1027                   = KLE_GTAP(acts,z)/
1028                     SUM{actsj$j2acts(j,actsj),
1029                         KLE_GTAP(actsj,z)};
1030   
1031   sigma_KLE(j,z)   = SUM{(acts,reg)$[j2acts(j,acts)$z2reg(z,reg)],
1032                      ELFKLE(acts, reg)*SH_KLE(acts,j,z)};
1033   
1034  *==============================================================================
1035  * 4. Own price elasticities (Conditional)
1036  *==============================================================================
1037  PARAMETER
1038   E_Composite(j,z)
1039   KLE_Composite(j,z)
1040   elas_E(j,z)         Composite Energy commodity own price elasticities
1041   elas_elec(j,z)
1042   elas_gas(j,z)
1043   elas_oil(j,z)
1044   elas_coal(j,z)
1045   elas_petrolcoal(j,z)
1046  ;
1047   
1048   
1049  * 02_COAL        Coal
1050  * 03_OIL         Crude petroleum
1051  * 04_GAS         Natural gas Gas distribution
1052  * 10_PETROLCOAL  Petroleum and coal products
1053  * 18_ELEC        Electricity
1054   
1055   E_Composite(j,z)   = SUM{(acts)$[j2acts(j,acts)], E_GTAP(acts,z)};
1056   KLE_Composite(j,z) = SUM{(acts)$[j2acts(j,acts)], KLE_GTAP(acts,z)};
1057   
1058   elas_E(j,z) = sigma_KLE(j,z)*(1- E_Composite(j,z)/KLE_Composite(j,z));
1059   elas_elec(j,z) = 1.1*(1- DIO('18_ELEC',j,z)/E_Composite(j,z));
1060   elas_gas(j,z) = 1.1*(1- DIO('04_GAS',j,z)/E_Composite(j,z));
1061   elas_oil(j,z) = 1.1*(1- DIO('03_OIL',j,z)/E_Composite(j,z));
1062   elas_coal(j,z) = 1.1*(1- DIO('02_COAL',j,z)/E_Composite(j,z));
1063   elas_petrolcoal(j,z) = 1.1*(1- DIO('10_PETROLCOAL',j,z)/E_Composite(j,z));
1064   
1065   
1066  * LDO(l,j,z)      = SUM{(endw,acts,reg)$[f2endw(l,endw)
1067  *                       $j2acts(j,acts)$z2reg(z,reg)],
1068  *                       EVFB(endw,acts,reg)};
1069   
1070  * elas_E(j,z) = sigma_KLE(j,z)*(1- SUM{ (acts)$[, E_GTAP(acts,z)/KLE_GTAP(acts,z)} ) ;
1071   
1072   
1073  * CGO(i,z)        = SUM{(comm,reg)$[i2comm(i,comm)$z2reg(z,reg)],
1074  *                       VDGP(comm,reg)+VMGP(comm,reg)};
1075   
