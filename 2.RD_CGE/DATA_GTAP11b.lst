1149  *$CALL gdxxrw Input_w-t\JointB_VAL_230411_PAR.xls @Input_w-t\JointB_POWER_PAR.txt Rdim=2 Cdim=1 output = Input_w-t\JointB_VAL_230411_PAR.gdx
1150  *$GDXIN Input_w-t\JointB_VAL_230411_PAR.gdx
1151  *$LOAD sigma_KD, sigma_LD, sigma_KLE, sigma_X1, sigma_X2, sigma_X3, sigma_X0, sigma_y, sigma_inv, PARZ
1152   
1153  *==============================================================================
1154  * 4.1 Real GDP projections
1155  *==============================================================================
1156  * GDP_GTAP8(reg,time)     = Projection('GDP_K',reg,time);
1157  * GDP(z,time)             = SUM{reg$z2reg(z,reg),GDP_GTAP8(reg,time)};
1158   
1159  loop{time$[time.val lt 2100],
1160   g_GDP(z,time+1)           = [GDP(z,time+1)/GDP(z,time)]-1;
1161  };
1162   g_GDP(z,time)$[time.val ge 2100]
1163                           = g_GDP(z,time+2);
1164   
1165  display g_GDP ;
1166   
1167  *==============================================================================
1168  * 4.2 Total population projections
1169  *==============================================================================
1170  * TOT_POP_GTAP8(reg,time) = Projection ('Pop',reg,time);
1171  * TOT_POP(z,time)         = SUM{reg$z2reg(z,reg),TOT_POP_GTAP8(reg,time)};
1172   
1173  *TOT_POP(z,time) = ACT_POP(z,time);
1174   
1175  loop{time$[time.val lt 2100],
1176   g_POP(z,time+1)           = [TOT_POP(z,time+1)/TOT_POP(z,time)]-1;
1177  };
1178   g_POP(z,time)$[time.val ge 2100]
1179                           = g_POP(z,time+1);
1180   
1181  display g_POP ;
1182   
1183  *==============================================================================
1184  * 5. Endogenous definition of set for rich regions/countries
1185  *==============================================================================
1186  * In the World Bank's 2007 World Development Indicators, "High-income" countries
1187  * are defined as those with a per capita Gross National Income of 10726USD
1188  * or above. Since there is no income from abroad in PEP-w-t, GDP is equal to
1189  * GNI, and we define high-income economies according to GDP per capita.
1190   
1191  * gdp_per_cap(z)  = [GDP(z,'2019')*10000000000]/[ACT_POP(z,'2019')*1000000];
1192  * Zrich(Z)        = yes$[gdp_per_cap(z) ge 10726];
1193  * Zother(Z)       = yes$[not Zrich(Z)];
1194   
1195   Zrich('01_KOR')        = yes;
1196   Zrich('03_JPN')        = yes;
1197   Zrich('07_NAM')        = yes;
1198   Zrich('09_WEU')        = yes;
1199   Zrich('10_EEU')        = yes;
1200   Zrich('17_PAO')        = yes;
1201   Zother(Z)              = yes$[not Zrich(Z)];
