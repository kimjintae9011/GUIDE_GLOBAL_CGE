3214      NOilR_DIO(p_oil,j,z)$(NOil_DIO(p_oil,j,z) gt 0)
3215           = NOil_DIO(p_oil,j,z)/sum(p_oil2, NOil_DIO(p_oil2,j,z));
3216       );
