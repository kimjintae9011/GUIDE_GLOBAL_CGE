 546  PARAMETER
 547   A_K(z)                       Scale parameter (investment function)
 548   aij(i,j,z)                   Input output coefficient
 549   aij2(i,j,z)                  Input output coefficient (intermediate energy)
 550   B_KD(j,z)                    Scale parameter (CES - composite capital)
 551   B_LD(j,z)                    Scale parameter (CES - composite labor)
 552   B_M1(i,z)                    Scale parameter (CES - composite commodity)
 553   B_M2(i,z)                    Scale parameter (CES - composite import)
 554   B_VA(j,z)                    Scale parameter (CES - value added)
 555   B_VA_t(j,z,time)             Scale parameter (CES - value added)
 556   B_KLE(j,z)                   Scale parameter (CES - composite KLE)
 557  * B_ENER(j,z)                 Scale parameter (CES - composite ENER)
 558  * B_ENER3(j,z)                Scale parameter (CES - composite ENER)
 559   B_ENER_t(j,z,time)           Scale parameter (CES - composite ENER)
 560   B_ENER_elec(j,z)             Scale parameter (CES - composite ENER)
 561   B_ENER_fossil(j,z)           Scale parameter (CES - composite ENER)
 562   B_ENER_coalgas(j,z)          Scale parameter (CES - composite ENER)
 563   B_ENER_oilprod(j,z)          Scale parameter (CES - composite ENER)
 564   B_X1(i,z)                    Scale parameter (CET - total output)
 565   B_X2(i,z)                    Scale parameter (CET - composite export)
 566   B_X3(i,z)                    Scale parameter (CES - top level)
 567   B_X4(z)                      Scale parameter (CES - Aggregated Electricity)
 568   beta_D_X1(i,z)               Share parameter (CET - total output - local sales)
 569   beta_EX_X1(i,z)              Share parameter (CET - total output - export)
 570   beta_X2(i,z,zj)              Share parameter (CET - composite export)
 571   beta_X3(j,i,z)               Share parameter (CES - top level)
 572   beta_X4(power, z)            Share parameter (CES - Aggregated Electricity)
 573   beta_KD(k,j,z)               Share parameter (CES - composite capital)
 574  * beta_LD(l,j,z)              Share parameter (CES - composite labor)
 575   beta_M1(i,z)                 Share parameter (CES - composite commodity)
 576   beta_M2(i,zj,z)              Share parameter (CES - composite import)
 577   beta_VA(j,z)                 Share parameter (CES - value added)
 578   beta_KLE(j,z)                Share parameter (CES - KLE composite)
 579   beta_KLE2(j,z)               Share parameter (CES - KLE composite)
 580   beta_KLE2_t(j,z,time)        Share parameter (CES - KLE composite)
 581  * beta_ENER(ene,j,z)          Share parameter (CES - ENER composite)
 582  * beta_ENER3(ene3,j,z)        Share parameter (CES - ENER composite)
 583   beta_ENER_elec(j,z)          Share parameter (CES - ENER composite)
 584   beta_ENER_fossil(j,z)        Share parameter (CES - ENER composite)
 585   beta_ENER_coalgas(ene5,j,z)  Share parameter (CES - ENER composite)
 586   beta_ENER_oilprod(ene6,j,z)  Share parameter (CES - ENER composite)
 587   delta(z)                     Depreciation rate of capital in country z
 588   eta                          Price elasticity of indexed transfers and parameters
 589   frisch(z)                    Frisch parameter (LES function)
 590   gamma_GVT(i,z)               Share of commodity i in total current public expenditures on goods and services
 591   gamma_INV(i,z)               Share of commodity i in total investment expenditures
 592   gamma_LES(i,z)               Marginal share of commodity i in household consumption budget
 593   io(j,z)                      Coefficient (Leontief - intermediate consumption)
 594   io2(j,z)                     Coefficient (Leontief - intermediate energy consumption)
 595   v(j,z)                       value added Coefficient (Leontief)
 596   v2(j,z)                      KLE Share parameter (Leontief)
 597   kmob                         Flag parameter (1 if capital is mobile)
 598   RES                          Rescaling factor
 599   rho_KD(j,z)                  Elasticity paameter (CES - composite capital)
 600   rho_LD(j,z)                  Elasticity parameter (CES - composite labor)
 601   rho_M1(i,z)                  Elasticity parameter (CES - composite commodity)
 602   rho_M2(i,z)                  Elasticity parameter (CES - composite import)
 603   rho_VA(j,z)                  Elasticity parameter (CES - value added)
 604   rho_KLE(j,z)                 Elasticity parameter (CES - KLE)
 605  * rho_ENER(j,z)               Elasticity parameter (CES - ENER)
 606  * rho_ENER3(j,z)              Elasticity parameter (CES - ENER)
 607   rho_ENER_elec(j,z)           Elasticity parameter (CES - ENER)
 608   rho_ENER_fossil(j,z)         Elasticity parameter (CES - ENER)
 609   rho_ENER_coalgas(j,z)        Elasticity parameter (CES - ENER)
 610   rho_ENER_oilprod(j,z)        Elasticity parameter (CES - ENER)
