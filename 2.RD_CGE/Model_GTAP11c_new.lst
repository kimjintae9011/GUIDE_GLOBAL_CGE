3528  *==============================================================================
3529  *  Backstop technology
3530  *==============================================================================
3531   switch(i3,z,time)  = 0 ;
3532   penetration_rate(i3,z,time) = eps ;
3533   
3534  Parameters
3535   Max_Pen(i3,z)           Maximum Penetration Rate
3536   Growth_Coeff(i3,z)    Growth Rate Coefficient
3537   Start_Year(i3, z)       First Year
3538   Inflection_Lapse(i3, z) Inflection Point Time
3539  ;
3540   
3541   
3542   
3543  Parameters
3544   CTAX0(z)           Initial Carbon tax $ per ton CO2
3545   TCTAX0(z)          Initial Government Revenue from Carbon tax
3546   PERMITO(j,z)       CO2 emissions
3547   PERMIT_TOTALO(z)   Total CO2 emissions (billion ton)
3548   PERMIT_NEA_TOTALO
3549  ;
3550   
3551   CTAX0(z)          = 0;
3552   TCTAX0(z)         = 0;
3553   PERMITO(j,z)      = sum(ene, CO2FACTOR(ene,j,z)*DEO(ene,j,z)) ;
3554   PERMIT_TOTALO(z)  = sum(j,PERMITO(j,z));
3555   PERMIT_NEA_TOTALO = sum(NEA, PERMIT_TOTALO(NEA));
3556   
3557  *==============================================================================
3558  *   Marginal abatement curves for emissions
3559  *==============================================================================
3560  Parameters
3561   alpha_CO2(ene,j,z)   Emissions responsiveness parameter – higher values imply stronger reduction in emissions intensity in response to carbon price
3562   gamma_CO2(ene,j,z)   Adjustment speed parameter – governs how rapidly emissions intensity responds to changes in carbon price
3563   MINCO2FACTOR(ene,j,z) minimum CO2 emission factor
3564   CTAX_CO2(ene,j,z,time)
3565   CO2FACTOR2_Star(ene,j,z,time)
3566  ;
3567   
3568   alpha_CO2(ene,j,z)     = 0.15 ;
3569   gamma_CO2(ene,j,z)     = 1.5 ;
3570  * alpha_CO2(ene,j,z)    = 0.15 ;
3571  * gamma_CO2(ene,j,z)    = 1.70 ;
3572   MINCO2FACTOR(ene,j,z)  = CO2FACTOR(ene,j,z)*0.1 ;
3573   
3574  Scalar
3575  adjustment_factor
3576  trigger_price
3577  SolarWind_TFP_BAU
3578  SolarWind_TFP_NDC
3579  SolarWind_TFP_NZ
3580  ;
3581   
3582  adjustment_factor = 0.3 ;
3583  trigger_price  = 1.0 ;
3584  SolarWind_TFP_BAU =0.02;
3585  SolarWind_TFP_NDC=0.02;
3586  SolarWind_TFP_NZ =0.04;
3587   
3588  *==============================================================================
3589  *   Carbon tax recycling
3590  *==============================================================================
3591   TIWO_Share(j,z)    =   LDO(j,z)/LSO(z);
3592   TIKO_Share(k,j,z)   =  KDO(k,j,z)/KSO(k,z);
3593   TIPO_Share(j,z)     =  XSTO(j,z)/sum(jj,XSTO(jj,z));
3594   
3595  *==============================================================================
3596  *   Labour Supply
3597  *==============================================================================
3598  Parameters
3599   W_lag(z,time)         Wage rate of type l labor in region z
3600   PIXCON_lag(z,time)    Consumer price index in region z
3601   LS_lag(z,time)        Supply of type l labor in region z (T-1)
3602   LST_lag(z,time)       Supply of type l labor in region z (Trend T-1)
3603  ;
3604   
3605  *==============================================================================
3606  *  Own-price elasticities
3607  *==============================================================================
3608  PARAMETER
3609   elas_elec(j,z)               Own price elasticities(electricity)
3610   elas_gas(j,z)               Own price elasticities(gas)
3611   elas_oil(j,z)                 Own price elasticities(oil)
3612   elas_coal(j,z)               Own price elasticities(coal)
3613   elas_petrolcoal(j,z)       Own price elasticities(petrolcoal)
3614   elas_Hou_ENER(ene,z)  Own price elasticities Household
3615  ;
3616   
3617   elas_elec(j2,z)       = -1*(1- DEO('18_ELEC',j2,z)/sum(ene,DEO(ene,j2,z)))*sigma_ENER_elec(j2,z) ;
3618   elas_elec(j3,z)       = eps ;
3619   
3620   elas_gas(j2,z)        = -1*(1- DEO('04_GAS',j2,z)/(DEO('02_COAL',j2,z)+DEO('04_GAS',j2,z)))*sigma_ENER_coalgas(j2,z) ;
3621   elas_gas(j3,z)        = eps ;
3622   
3623   elas_coal(j2,z)       = -1*(1- DEO('02_COAL',j2,z)/(DEO('02_COAL',j2,z)+DEO('04_GAS',j2,z)))*sigma_ENER_coalgas(j2,z) ;
3624   elas_coal(j3,z)       = eps ;
3625   
3626   elas_oil(j2,z)          = -1*(1- DEO('03_OIL',j2,z)/(DEO('03_OIL',j2,z)+DEO('10_PETROLCOAL',j2,z)))*sigma_ENER_oilprod(j2,z) ;
3627   elas_oil(j3,z)          = eps ;
3628   
3629   elas_petrolcoal(j2,z)  = -1*(1- DEO('10_PETROLCOAL',j2,z)/(DEO('03_OIL',j2,z)+DEO('10_PETROLCOAL',j2,z)))*sigma_ENER_oilprod(j2,z) ;
3630   elas_petrolcoal(j3,z)  = eps ;
3631   
3632   elas_Hou_ENER(ene,z)   = CMINO(ene,z)/CO(ene,z)*(1-gamma_LES(ene,z)) -1 ;
3633   
3634  execute_unload 'Calibration_Check_GTAP11c';
