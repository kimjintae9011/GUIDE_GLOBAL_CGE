3209   NOil_DIO(p_oil,'31_SER',z) = sum(f_neother, WEB(f_neother, p_oil, z) );
3210  * NEP_CO(p_oillz) = sum((f_household), household_fne_oilproduct(f_household, p_oilproduct, z));
