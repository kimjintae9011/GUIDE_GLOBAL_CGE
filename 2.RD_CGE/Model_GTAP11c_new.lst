2659  ;
2660  *
2661   
2662  *f_balstfur(flow)
2663  *f_cokeoven(flow)
2664  * WEB(f_balstfur, 'p4_COKCOAL', z) = WEB(f_cokeoven, 'p66_TOTAL', z) ;
2665  * WEB(f_cokeoven, 'p4_COKCOAL', z) = WEB(f_cokeoven, 'p66_TOTAL', z) ;
2666   
2667   TCoke_Share(f_cokeoven,p_coal,z)$(WEB(f_cokeoven, p_coal, z) lt 0)  = WEB(f_cokeoven, p_coal, z)$(WEB(f_cokeoven, p_coal, z) lt 0)/sum(p_coal2, WEB(f_cokeoven, p_coal2, z)$(WEB(f_cokeoven, p_coal2, z) lt 0)) ;
2668   TBlast_Share(f_balstfur,p_coal,z)$(WEB(f_balstfur, p_coal, z) lt 0) = WEB(f_balstfur, p_coal, z)$(WEB(f_balstfur, p_coal, z) lt 0)/sum(p_coal2, WEB(f_balstfur, p_coal2, z)$(WEB(f_balstfur, p_coal2, z) lt 0)) ;
2669   
2670  display TCoke_Share, TBlast_Share ;
2671   
2672  *Coal
2673   Coal_DIO(p_coal,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_coal, z));
2674   Coal_DIO(p_coal,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_coal, z));
2675   Coal_DIO(p_coal,'03_OIL',z) = -1*sum((f_oil), WEB(f_oil, p_coal, z));
2676   Coal_DIO(p_coal,'04_GAS',z) = -1*sum((f_gas), WEB(f_gas, p_coal, z));
2677   Coal_DIO(p_coal,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_coal, z));
2678   Coal_DIO(p_coal,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_coal, z));
2679   Coal_DIO(p_coal,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_coal, z));
2680   Coal_DIO(p_coal,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_coal, z));
2681   Coal_DIO(p_coal,'09_PAPERPRO',z) = sum((f_paperpro), WEB(f_paperpro, p_coal, z));
2682   Coal_DIO(p_coal5,'10_PETROLCOAL',z) = -1*sum((f_petrolcoal), WEB(f_petrolcoal, p_coal5, z));
2683   Coal_DIO(p_coal,'11_CHEMICAL',z) = sum((f_chemical), WEB(f_chemical, p_coal, z));
2684   Coal_DIO(p_coal,'12_NONMET',z) = sum((f_nonmet), WEB(f_nonmet, p_coal, z));
2685   Coal_DIO(p_coal,'13_IRONSTL',z) = sum((f_ironstl), WEB(f_ironstl, p_coal, z))
2686   + sum(f_cokeoven, -1*TCoke_Share(f_cokeoven,p_coal,z)*WEB(f_cokeoven, 'p66_TOTAL', z))
2687   + sum(f_balstfur, -1*TBlast_Share(f_balstfur,p_coal,z)*WEB(f_balstfur, 'p66_TOTAL', z))
2688   + sum((f_Eblastcoke), -1*WEB(f_Eblastcoke, p_coal, z))
2689  ;
2690   
2691   Coal_DIO(p_coal,'14_NONFERR',z) = sum((f_nonferr), WEB(f_nonferr, p_coal, z));
2692   Coal_DIO(p_coal,'15_MACHINE',z) = sum((f_machine), WEB(f_machine, p_coal, z));
2693   Coal_DIO(p_coal,'16_TRANSEQ',z) = sum((f_transeq), WEB(f_transeq, p_coal, z));
2694   Coal_DIO(p_coal,'17_OTHERIND',z) = sum((f_otherind), WEB(f_otherind, p_coal, z));
2695   Coal_DIO(p_coal,'18_TnD',z) = 0 ;
2696   Coal_DIO(p_coal,'19_eNuclear',z) = 0 ;
2697   Coal_DIO(p_coal,'20_eCoal',z) = -1*sum((f_elec), WEB(f_elec, p_coal, z));
2698   Coal_DIO(p_coal,'19_eNuclear',z) = 0 ;
2699   Coal_DIO(p_coal,'21_eGas',z) = 0 ;
2700   Coal_DIO(p_coal,'22_eOil',z) = 0 ;
2701   Coal_DIO(p_coal,'23_eWind',z) = 0 ;
2702   Coal_DIO(p_coal,'24_eSolar',z) = 0 ;
2703   Coal_DIO(p_coal,'25_eHydro',z) = 0 ;
2704   Coal_DIO(p_coal,'26_eOther',z) = 0 ;
2705   Coal_DIO(p_coal,'27_CONSTRUC',z) = sum((f_construc), WEB(f_construc, p_coal, z));
2706   Coal_DIO(p_coal,'28_LTRP',z) = sum((f_roadrail), WEB(f_roadrail, p_coal, z));
2707   Coal_DIO(p_coal,'29_WTRP',z) = sum((f_domewater), WEB(f_domewater, p_coal, z));
2708   Coal_DIO(p_coal,'30_ATRP',z) = sum((f_domeair), WEB(f_domeair, p_coal, z));
2709   Coal_DIO(p_coal,'31_SER',z) = sum((f_ser), WEB(f_ser, p_coal, z));
2710   Coal_CO(p_coal,z) = sum((f_household), WEB(f_household, p_coal, z));
2711   
2712   Coal_Marine(p_coal,z)   = -1*sum((f_marine_bunker), WEB(f_marine_bunker, p_coal, z));
2713   Coal_Aviation(p_coal,z) = -1*sum((f_aviation_bunker), WEB(f_aviation_bunker, p_coal, z));
2714   
2715  *Ratio
2716  Loop(j,
2717      CoalR_DIO(p_coal,j,z)$(Coal_DIO(p_coal,j,z) gt 0)
2718           = Coal_DIO(p_coal,j,z)/sum(p_coal2, Coal_DIO(p_coal2,j,z));
2719       );
2720   
2721   CoalR_CO(p_coal,z)$(Coal_CO(p_coal,z) gt 0)  = Coal_CO(p_coal,z)/ sum(p_coal2, Coal_CO(p_coal2,z));
2722   
2723  display Coal_DIO, CoalR_DIO, CoalR_CO ;
2724   
2725  *Gas
2726   Gas_DIO(p_gas,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_gas, z));
2727   Gas_DIO(p_gas,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_gas, z));
2728   Gas_DIO(p_gas,'03_OIL',z) = 0;
2729   Gas_DIO(p_gas,'04_GAS',z) = -1*sum((f_gas), WEB(f_gas, p_gas, z));
2730   Gas_DIO(p_gas,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_gas, z));
2731   Gas_DIO(p_gas,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_gas, z));
2732   Gas_DIO(p_gas,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_gas, z));
2733   Gas_DIO(p_gas,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_gas, z));
2734   Gas_DIO(p_gas,'09_PAPERPRO',z) = sum((f_paperpro), WEB(f_paperpro, p_gas, z));
2735   Gas_DIO(p_gas,'10_PETROLCOAL',z) = -1*sum((f_petrolcoal), WEB(f_petrolcoal, p_gas, z));
2736   Gas_DIO(p_gas,'11_CHEMICAL',z) = sum((f_chemical), WEB(f_chemical, p_gas, z));
2737   Gas_DIO(p_gas,'12_NONMET',z) = sum((f_nonmet), WEB(f_nonmet, p_gas, z));
2738   Gas_DIO(p_gas,'13_IRONSTL',z) = sum((f_ironstl), WEB(f_ironstl, p_gas, z));
2739   Gas_DIO(p_gas,'14_NONFERR',z) = sum((f_nonferr), WEB(f_nonferr, p_gas, z));
2740   Gas_DIO(p_gas,'15_MACHINE',z) = sum((f_machine), WEB(f_machine, p_gas, z));
2741   Gas_DIO(p_gas,'16_TRANSEQ',z) = sum((f_transeq), WEB(f_transeq, p_gas, z));
2742   Gas_DIO(p_gas,'17_OTHERIND',z) = sum((f_otherind), WEB(f_otherind, p_gas, z));
2743   Gas_DIO(p_gas,'18_TnD',z) = 0 ;
