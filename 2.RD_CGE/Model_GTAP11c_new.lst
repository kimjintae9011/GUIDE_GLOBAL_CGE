 917  DIO(i,j,z)       = DIO(i,j,z)/RES;
 918  DSO(j,i,z)       = DSO(j,i,z)/RES;
 919  DSO_I(i,z)       = DSO_I(i,z)/RES;
 920  EXO(i,z,zj)      = EXO(i,z,zj)/RES;
 921  IMO(i,z,zj)      = IMO(i,z,zj)/RES;
 922  INVO(i,z)        = INVO(i,z)/RES;
 923  KSTO(z)          = KSTO(z)/RES;
 924  LDO(j,z)         = LDO(j,z)/RES;
 925  MRGNO(i,z)       = MRGNO(i,z)/RES;
 926  RKDO(k,j,z)      = RKDO(k,j,z)/RES;
 927  TDHO(z)          = TDHO(z)/RES;
 928  TICO(i,z)        = TICO(i,z)/RES;
 929  TIKO(k,j,z)      = TIKO(k,j,z)/RES;
 930  TIMO(i,z,zj)     = TIMO(i,z,zj)/RES;
 931  TIPO(j,z)        = TIPO(j,z)/RES;
 932  TIWO(j,z)        = TIWO(j,z)/RES;
 933  TIXO(i,z,zj)     = TIXO(i,z,zj)/RES;
 934  tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj)/RES;
 935  XSO_I(i,z)       = XSO_I(i,z)/RES;
