3420  *==============================================================================
3421  *  4.12 CO2FACTOR and CTAX
3422  *==============================================================================
3423  Parameters
3424   CO2_Energy(ene,j,z)        CO2 emissions from Energy
3425  ;
3426   
3427   CO2_Energy('02_COAL',j,z) = sum(p_coal,CO2IO(p_coal,j,z));
3428   CO2_Energy('03_OIL',j,z)  = sum(p_oil,CO2IO(p_oil,j,z));
3429   CO2_Energy('04_GAS',j,z)  = sum(p_gas,CO2IO(p_gas,j,z));
3430   CO2_Energy('10_PETROLCOAL',j,z)  = sum(p_oilproduct,CO2IO(p_oilproduct,j,z));
3431   
3432  Parameters
3433   CO2FACTOR(ene,j,z)       CO2 emissions factor (tCO2 per 100$)
3434   CO2FACTOR2(ene,j,z,time) Time series CO2 emissions factor (tCO2 per 100$)
3435  ;
3436   
3437   CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*(1000/(10**8));
3438   CO2FACTOR('03_OIL',j,z)$DEO('03_OIL',j,z)   = [sum(p_oil,CO2IO(p_oil,j,z))/DEO('03_OIL',j,z)]*(1000/(10**8));
3439   CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z)   = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*(1000/(10**8));
3440   CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*(1000/(10**8));
3441   
3442  Parameters
3443  Global_CO2FACTOR(ene,j)       Global Average CO2 emissions factor (tCO2 per 100$)
3444  ;
3445   
3446   Global_CO2FACTOR('02_COAL',j)            = [sum((p_coal,z),CO2IO(p_coal,j,z))/sum(z,DEO('02_COAL',j,z))]*(1000/(10**8));
3447   Global_CO2FACTOR('03_OIL',j)               = [sum((p_oil,z),CO2IO(p_oil,j,z))/sum(z,DEO('03_OIL',j,z))]*(1000/(10**8));
3448   Global_CO2FACTOR('04_GAS',j)              = [sum((p_gas,z),CO2IO(p_gas,j,z))/sum(z,DEO('04_GAS',j,z))]*(1000/(10**8));
3449   Global_CO2FACTOR('10_PETROLCOAL',j) = [sum((p_oilproduct,z),CO2IO(p_oilproduct,j,z))/sum(z,DEO('10_PETROLCOAL',j,z))]*(1000/(10**8));
3450   
      *MNG
      CO2FACTOR('02_COAL','31_SER','05_MNG')        = 2;
       
      *PRK
       CO2FACTOR('02_COAL','01_AGRICULT','06_PRK')        = CO2FACTOR('02_COAL','01_AGRICULT','05_MNG');
       CO2FACTOR('10_PETROLCOAL','01_AGRICULT','06_PRK')  = CO2FACTOR('10_PETROLCOAL','01_AGRICULT','05_MNG');
       CO2FACTOR('02_COAL','28_LTRP','06_PRK')            = CO2FACTOR('02_COAL','28_LTRP','05_MNG');
       CO2FACTOR('02_COAL','17_OTHERIND','06_PRK')        = CO2FACTOR('02_COAL','17_OTHERIND','05_MNG');
       
      *RUS
       CO2FACTOR('02_COAL','08_WOODPRO','04_RUS')    = CO2FACTOR('02_COAL','08_WOODPRO','10_EEU');
       CO2FACTOR('04_GAS','17_OTHERIND','04_RUS')      = SMAX(j$(not sameas(j, '17_OTHERIND')), CO2FACTOR('04_GAS', j, '04_RUS'));
       
      *LAM
       CO2FACTOR('04_GAS','02_COAL','08_LAM')             = CO2FACTOR('04_GAS','02_COAL','07_NAM');
       
      * CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) gt 10) = 10 ;
3470   
3471  CO2FACTOR(ene, j, z)$(
3472      not sameas(j, '13_IRONSTL') and
3473      not sameas(j, '20_eCoal') and
3474      not sameas(j, '21_eGas') and
3475      not sameas(j, '22_eOil')
3476  ) = MIN(CO2FACTOR(ene, j, z), Global_CO2FACTOR(ene, j));
3477   
3478  *Otherind Sector
3479   CO2FACTOR('02_COAL','17_OTHERIND',Z)$DEO('02_COAL','17_OTHERIND',z) = Global_CO2FACTOR('02_COAL','20_eCoal');
3480   CO2FACTOR('03_OIL','17_OTHERIND',Z)$DEO('03_OIL','17_OTHERIND',z) = Global_CO2FACTOR('03_OIL','03_OIL');
3481   CO2FACTOR('04_GAS','17_OTHERIND',Z)$DEO('04_GAS','17_OTHERIND',z) = Global_CO2FACTOR('04_Gas','21_eGas');
3482   CO2FACTOR('10_PETROLCOAL','17_OTHERIND',Z)$DEO('10_PETROLCOAL','17_OTHERIND',z) = Global_CO2FACTOR('10_PETROLCOAL','22_eOil');
3483   
3484   CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) lt 0) = 0.1 ;
3485   
3486   
3487   CO2FACTOR2(ene,j,z,time) = CO2FACTOR(ene,j,z);
3488   
3489  *===========
3490  * Coal 2.7tCO2 per 100$
3491  * CO2FACTOR2('02_COAL',j,z,time)$CO2FACTOR('02_COAL',j,z)           = 2.7 ;
3492  * Gas 1.8tCO2 per 100$
3493  * CO2FACTOR2('04_GAS',j,z,time)$CO2FACTOR('04_GAS',j,z)             = 0.67;
3494  * Oilrproduct  0.6tCO2 per 100$
3495  * CO2FACTOR2('10_PETROLCOAL',j,z,time)$CO2FACTOR('10_PETROLCOAL',j,z) = 0.67;
