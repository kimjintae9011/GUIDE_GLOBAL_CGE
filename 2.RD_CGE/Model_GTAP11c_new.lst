 939  *==============================================================================
 940  *  3.3 Exogenous prices and parameters
 941  *==============================================================================
 942  *  Price elasticity (should be equal to one to verify homogeneity)
 943  eta = 1;
 944   
 945  *------------------------------------------------------------------------------
 946  *  Slopes of taxation functions
 947  *   One can either choose to assign a value to the intercepts and calibrate
 948  *   the slopes accordingly, or the other way around. This type of modelling
 949  *   can be useful to take into account known marginal savings or taxation rates
 950  *   or to deal with negative average saving rates in cases where savings are
 951  *   negative for some household groups.
 952  *   When no further information is available, one can simply set the intercepts
 953  *   to zero and calibrate an average rate: this is what we do here for ttdh0O.
 954  *   If the user wishes to assume otherwise, he can fill the appropriate area in
 955  *   the Excel file VAL_PAR.xls.
 956  * ttdh0O(z)       = PARZ(z,'ttdh0O');
 957   ttdh0O(z)       = 0;
 958  *   The slope ttdh1O is calibrated below in the mane GAMS file
 959   
 960  *------------------------------------------------------------------------------
 961  * Also we need to assign values to some prices
 962  * All of the prices below, EXCEPT eO, may be set at arbitrary values
 963  * without loss of generality.
 964  *
 965  * In the case of eO, although exchange rates may be given arbitrary values
 966  * in the model, they must all be equal for calibration at this stage. The reason
 967  * is that the supply of margin transport services MRGNO must equal global demand.
 968  * Since there is a single world price for international transport margins
 969  * (rather than bilateral world prices for other commodities) the unit of
 970  * measurement of the volume of margin services must be the same for all regions,
 971  * and in turn, that implies that the divisor that converts the nominal value to
 972  * volume be the same for all regions. Since that divisor involves the exchange
 973  * rate, all exchange rates must be equal.
 974   
 975  * Normally, prices that may be given arbitrary values are set at 1:
 976   eO(z)            = 1;
 977   PEO(i,z,zj)      = 1;
 978   PLO(i,z)         = 1;
 979   PWMGO(i)         = 1;
 980   WO(z)            = 1;
 981   WO_lag(z)        = WO(z) ;
 982   
 983  *==============================================================================
 984  * Calibration
 985  *==============================================================================
 986   YHKO(z)         = SUM[(k,j),RKDO(k,j,z)];
 987   YHLO(z)         = SUM[(j),LDO(j,z)];
 988   YHO(z)          = YHLO(z)+YHKO(z);
 989   YDHO(z)         = YHO(z)-TDHO(z);
 990   CTHO(z)         = SUM[i,CO(i,z)];
 991   SHO(z)          = YDHO(z)-CTHO(z);
 992   TICTO(z)        = SUM[i,TICO(i,z)];
 993   TIMTO(z)        = SUM[(i,zj),TIMO(i,zj,z)];
 994   TIWTO(z)        = SUM[(j),TIWO(j,z)];
 995   TIKTO(z)        = SUM[(k,j),TIKO(k,j,z)];
 996   TIPTO(z)        = SUM[j,TIPO(j,z)];
 997   TIXTO(z)        = SUM[(i,zj),TIXO(i,z,zj)];
 998   TPRODNO(z)      = TIKTO(z)+TIWTO(z)+TIPTO(z);
 999   TPRCTSO(z)      = TICTO(z)+TIMTO(z)+TIXTO(z);
1000   YGO(z)          = TDHO(z)+TPRCTSO(z)+TPRODNO(z);
1001   GO(z)           = SUM[i,CGO(i,z)];
1002   SGO(z)          = YGO(z)-GO(z);
1003   YROWO(z)        = SUM[(i,zj),IMO(i,zj,z)]+SUM[(i,ij,zj),tmrg(i,ij,zj,z)];
1004   SROWO(z)        = YROWO(z)-SUM[(i,zj),EXO(i,z,zj)]-SUM[i,MRGNO(i,z)];
1005   CABO(z)         = -SROWO(z);
1006   ITO(z)          = SHO(z)+SGO(z)+SROWO(z);
1007   
1008  *==============================================================================
1009  *  Calibration of parameters and other variables
1010  *==============================================================================
1011  *  Calibration of investment and government spending shares
1012  *==============================================================================
1013   gamma_GVT(i,z)  = CGO(i,z)/SUM[ij,CGO(ij,z)];
1014   gamma_INV(i,z)  = INVO(i,z)/SUM[ij,INVO(ij,z)] ;
1015   
1016  *==============================================================================
1017  *  Calibration of other prices and revised volumes (part 1)
1018  *==============================================================================
1019   LDO(j,z)      = LDO(j,z)/WO(z);
1020   LDCO(j,z)     = LDO(j,z);
1021   LSO(z)        = SUM[j,LDO(j,z)];
1022   LSTO(z)       = LSO(z) ;
1023   LSO_lag(z)    = LSO(z) ;
1024   LSTO_lag(z)   = LSO(z) ;
1025   EXO(i,z,zj)  = [EXO(i,z,zj)-TIXO(i,z,zj)]/PEO(i,z,zj);
1026   EXTO(i,z)    = SUM[zj,EXO(i,z,zj)];
1027   PWXO(i,z,zj)$EXO(i,z,zj)
1028                   = {[PEO(i,z,zj)*EXO(i,z,zj)+TIXO(i,z,zj)]/EXO(i,z,zj)}/eO(z);
1029   
1030   PETO(i,z)       = SUM[zj,PEO(i,z,zj)*EXO(i,z,zj)]/EXTO(i,z);
1031  * PETO(i,z)$(EXTO(i,z) > 0) = SUM[zj, PEO(i,z,zj) * EXO(i,z,zj)] / EXTO(i,z);
1032  * PETO(i,z)$(EXTO(i,z) = 0) = 0;
1033   PWMO(i,z,zj)    = PWXO(i,z,zj);
1034   IMO(i,zj,z)     = EXO(i,zj,z);
1035   IMTO(i,z)       = SUM[zj,IMO(i,zj,z)];
1036   
1037   DSO(j,i,z)      = DSO(j,i,z)/PLO(i,z);
1038   DSO_I(i,z)      = SUM(j,DSO(j,i,z));
1039   DSO_J(j,z)      = SUM(i,DSO(j,i,z));
1040   QO(i,z)         = IMTO(i,z)+DDO(i,z);
1041   
1042   MRGNO(i,z)$MRGNO(i,z)
1043                   = MRGNO(i,z)/[eO(z)*PWMGO(i)];
1044   
1045   XSO_I(i,z)      = EXTO(i,z)+DDO(i,z)+MRGNO(i,z);
1046   
1047   XSTO(j,z)       = sum(i, XSO(j,i,z));
1048   
1049   PO(i,z)         = [PETO(i,z)*EXTO(i,z)+PLO(i,z)*DSO_I(i,z)
1050                    +eO(z)*PWMGO(i)*MRGNO(i,z)]/XSO_I(i,z);
1051   
1052   PO2(j,i,z)$XSO(j,i,z) = 1;
1053   
1054   PO3(i,j,z)$XSO(j,i,z) = 1;
1055   
1056   PIO(i,z)       = SUM[j$XSO(j,i,z),PO2(J,I,z)*XSO(j,i,z)]/XSO_I(i,z);
1057   
1058   PTO(j,z)       = SUM[i$XSO(j,i,z),PO2(j,i,z)*XSO(j,i,z)]/XSTO(j,z);
1059   
1060   PPO(j,z)       = (TIWO(j,z)+WO(z)*LDO(j,z)
1061                    +SUM[k,TIKO(k,j,z)+RKDO(k,j,z)]
1062                    +SUM[nene,DIO(nene,j,z)]+SUM[ene,DIO(ene,j,z)])/XSTO(j,z);
1063   
1064   theta2(j,i,z)  = DSO(j,i,z)/sum(jj, DSO(jj,i,z));
1065   
1066   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z)*EXTO(i,z);
1067   
1068  *==============================================================================
1069  *  Calibration of tax rates, margins, prices and volumes
1070  *==============================================================================
1071  *  Margin rates and tax rates
1072  *==============================================================================
1073   ttixO(i,z,zj)   = [eO(z)*PWXO(i,z,zj)/PEO(i,z,zj)]-1;
1074   tticO(i,z)      = TICO(i,z)/{PLO(i,z)*DDO(i,z)
1075                     +SUM[zj,IMO(i,zj,z)*eO(z)*PWMO(i,zj,z)
1076                     +TIMO(i,zj,z)+SUM[ij,tmrg(ij,i,zj,z)]]};
1077   
1078   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
1079                   = tmrg(i,ij,zj,z)/(PWMGO(i)*eO(z)*IMO(ij,zj,z));
1080   
1081   ttimO(i,zj,z)$IMO(i,zj,z)
1082                   = TIMO(i,zj,z)/{IMO(i,zj,z)*eO(z)*(PWMO(i,zj,z)
1083                    +SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])};
1084   
1085   ttiwO(j,z)$LDO(j,z)
1086                   = TIWO(j,z)/[WO(z)*LDO(j,z)];
1087   
1088   ttikO(k,j,z)$RKDO(k,j,z)
1089                   = TIKO(k,j,z)/RKDO(k,j,z);
1090   
1091   ttipO(j,z)      = [PTO(j,z)/PPO(j,z)]-1;
1092   
1093   ttdh1O(z)       = [TDHO(z)-ttdh0O(z)]/YHO(z);
1094   
1095  *==============================================================================
1096  *  Calibration of other prices and revised volumes (part 2)
1097  *==============================================================================
1098   PDO(i,z)        = PLO(i,z)*(1+tticO(i,z));
1099   PMO(i,zj,z)     = eO(z)*(PWMO(i,zj,z)+SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])
1100                   *(1+ttimO(i,zj,z))*(1+tticO(i,z));
1101   PMTO(i,z)       = SUM[zj,PMO(i,zj,z)*IMO(i,zj,z)]/IMTO(i,z);
1102   PCO(i,z)        = [PMTO(i,z)*IMTO(i,z)+PDO(i,z)*DDO(i,z)]/QO(i,z);
1103   
1104   CO(i,z)         = CO(i,z)/PCO(i,z);
1105   CGO(i,z)        = CGO(i,z)/PCO(i,z);
1106   DIO(nene,j,z)   = DIO(nene,j,z)/PCO(nene,z);
1107   DEO(ene,j,z)    = DIO(ene,j,z)/PCO(ene,z);
1108   
1109   DEelecO(j,z)    = DIO("18_ELEC",j,z)/PCO("18_ELEC",z);
1110   DEnelecO(j,z)   = sum(ene3,DEO(ene3,j,z));
1111   
1112   DEcoalgasO(j,z) = sum(ene5,DEO(ene5,j,z));
1113   DEcoalO(j,z)    = DEO("02_COAL ",j,z);
1114   DEgasO(j,z)     = DEO("04_GAS",j,z);
1115   
1116   DEoilpetrolO(j,z) = sum(ene6,DEO(ene6,j,z));
1117   DEoilO(j,z)       = DEO("03_OIL",j,z);
1118   DEpetrolO(j,z)    = DEO("10_PETROLCOAL",j,z);
1119   
1120   INVO(i,z)       = INVO(i,z)/PCO(i,z);
1121   
1122   CIO(j,z)        = SUM[nene,DIO(nene,j,z)];
1123   CEO(j3,z)        = SUM[ene,DEO(ene,j3,z)];
1124   CEO(j2,z)        = DEelecO(j2,z)+DEnelecO(j2,z);
1125   
1126   DITO(nene,z)    = SUM[j,DIO(nene,j,z)];
1127   DITO(ene,z)     = SUM[j,DEO(ene,j,z)];
1128   
1129   PO4(ene,j,z)    = PCO(ene,z);
1130   
1131   PCIO(j,z)       = SUM[nene,PCO(nene,z)*DIO(nene,j,z)]/CIO(j,z);
1132   
1133   PCEcoalO(j,z)   = PO4("02_COAL",j,z) ;
1134   PCEgasO(j,z)    = PO4("04_GAS",j,z) ;
1135   PCEoilO(j,z)    = PO4("03_OIL",j,z) ;
1136   PCEpetrolO(j,z) = PO4("10_PETROLCOAL",j,z) ;
1137   
1138   PCEoilpetrolO(j,z)  = [PCEoilO(j,z)*DEoilO(j,z)+PCEpetrolO(j,z)*DEpetrolO(j,z)]
1139                     /DEoilpetrolO(j,z) ;
1140   
1141   PCEcoalgasO(j,z)  = [PCEcoalO(j,z)*DEcoalO(j,z)+PCEgasO(j,z)*DEgasO(j,z)]
1142                     /DEcoalgasO(j,z) ;
1143   
1144   PCEnelecO(j,z)  = [PCEcoalgasO(j,z)*DEcoalgasO(j,z)+PCEoilpetrolO(j,z)*DEoilpetrolO(j,z)]
1145                     /DEnelecO(j,z) ;
1146   
1147   PCEelecO(j,z)   = SUM[ene4,PCO(ene4,z)*DEO(ene4,j,z)]/DEelecO(j,z) ;
1148   PCEO(j,z)       = [PCEelecO(j,z)*DEelecO(j,z)+PCEnelecO(j,z)*DEnelecO(j,z)]/CEO(j,z) ;
1149   PCEO(j3,z)       = SUM[ene,PCO(ene,z)*DEO(ene,j3,z)]/CEO(j3,z) ;
1150   WTIO(j,z)     = WO(z)*(1+ttiwO(j,z));
1151   WCO(j,z)$LDCO(j,z)
1152                   = (WTIO(j,z)*LDO(j,z))/LDCO(j,z);
1153   
1154  *==============================================================================
1155  *  Calibration of dynamic parameters
1156  *==============================================================================
1157  * Calibration of dynamic parameters following new procedure.
1158  * The price of capital is arbitrary:
1159   PKO(z) = 1;
1160   
1161  * The calibration of depreciation rates is based on two hypotheses:
1162  * 1. The rate of depreciation is the same for all types of capital and all
1163  *    industries in each region (this hypothesis is made to accommodate the fact
1164  *    that, in the GTAP data base, capital consumption allowance is not detailed;
1165  *    as a matter of fact, the GTAP capital consumption allowance is set at
1166  *    4% of the value of the capital stock).
1167  * 2. The rental rate of capital is uniform across industries and types of
1168  *    capital in each region.
1169  * 3. The investment rate (IND/KD) is uniform across industries and types of
1170  *    capital in each region.
1171  * These hypotheses lead to the following formulae:
1172   
1173  * From GTAP, we know KSTO.
1174   KSTO(z)         = KSTO(z)/PKO(z);
1175   
1176  * Assuming a uniform depreciation rate for all types
1177  * of capital and all industries:
1178   delta(z)        = DEPO(z)/[PKO(z)*KSTO(z)];
1179   
1180  * From GTAP, we know KSTO. Assuming a uniform rental rate R for all types
1181  * of capital and all industries:
1182   RO(k,j,z)$RKDO(k,j,z)
1183                   = SUM[(kj,jj),RKDO(kj,jj,z)]/KSTO(z);
1184   
1185  * Then from the GTAP value of income paid to capital RKD we calibrate KDO:
1186   KDO(k,j,z)$RKDO(k,j,z)
1187                   = RKDO(k,j,z)/RO(k,j,z);
1188   
1189  * The supply of capital is equal to demand:
1190   KSO(k,z)        = SUM[j,KDO(k,j,z)];
1191   
1192  * The rate of return on capital, net of depreciation, is:
1193   IRO(z)         = {SUM[(k,j)$RKDO(k,j,z),RKDO(k,j,z)]-DEPO(z)}/[PKO(z)*KSTO(z)];
1194   
1195  * The user cost of capital follows
1196   UO(z)           = PKO(z)*(IRO(z)+delta(z));
1197   
1198  * Combining
1199  * - the hypothesis of uniform investment rates
1200  * - the hypothesis of uniform rental rates
1201  * - the hypothesis of uniform depreciation rates
1202  * leads to
1203   phiO(z)         = [ITO(z)/PKO(z)]/KSTO(z);
1204   
1205  * Investment by destination follows:
1206   INDO(k,j,z)$KDO(k,j,z)
1207                   = phiO(z)*KDO(k,j,z);
1208   
1209   A_K(z)          = 1/PKO(z)*{PROD[i$gamma_INV(i,z),(PCO(i,Z)/gamma_INV(i,z))
1210                     **gamma_INV(i,z)]};
1211   
1212   KDCO(j,z)       = SUM[k,KDO(k,j,z)];
1213   RTIO(k,j,z)     = RO(k,j,z)*(1+ttikO(k,j,z));
1214   RCO(j,z)$KDCO(j,z)
1215                   = SUM[k,RTIO(k,j,z)*KDO(k,j,z)]/KDCO(j,z);
1216   
1217  *==============================================================================
1218  *  Calibration of other prices and revised volumes (part 3)
1219  *==============================================================================
1220   VAO(j,z)        = LDCO(j,z)+KDCO(j,z);
1221   
1222   PVAO(j,z)       = [WCO(j,z)*LDCO(j,z)+RCO(j,z)*KDCO(j,z)]/VAO(j,z);
1223   
1224  * PIXGDPO is tautologically equal to 1, based on its formula
1225  * PIXGDPO(z)      = {SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1226  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1227  *                   *SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1228  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]}**0.5;
1229   PIXGDPO(z)      = 1;
1230   
1231  * PIXGDP_WO is tautologically equal to 1, based on its formula
1232  * PIXGDP_WO       = {SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1233  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1234  *                   *SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1235  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]/eO(z)}**0.5;
1236   PIXGDP_WO       = 1;
1237   
1238  * PIXCONO(z) is tautologically equal to 1, based on its formula
1239  * PIXCONO(z)      = SUM[i,PCO(i,z)*CO(i,z)]
1240  *                  /SUM[i,PCO(i,z)*CO(i,z)];
1241   PIXCONO(z)      = 1;
1242   PIXCONO_lag(z)  = PIXCONO(z);
1243   
1244  * PIXINVO(z) is tautologically equal to 1, based on its formula
1245  * PIXINVO(z)      = PROD[i$gamma_INV(i,z),(PCO(i,z)/PCO(i,z))**gamma_INV(i,z)];
1246   PIXINVO(z)      = 1;
1247   
1248  * PIXGVTO(z) is tautologically equal to 1, based on its formula
1249  * PIXGVTO(z)      = PROD[i$gamma_GVT(i,z),(PCO(i,z)/PCO(i,z))**gamma_GVT(i,z)];
1250   PIXGVTO(z)      = 1;
1251   
1252  *==============================================================================
1253  *  Calibration of function parameters
1254  *==============================================================================
1255  *   Leontief functions
1256  *==============================================================================
1257   io(j,z)         = CIO(j,z)/XSTO(j,z) ;
1258   
1259   io2(j,z)        = CEO(j,z)/XSTO(j,z) ;
1260   
1261   v(j,z)          = VAO(j,z)/XSTO(j,z) ;
1262   
1263   v2(j,z)         = (CEO(j,z)+VAO(j,z))/XSTO(j,z) ;
1264   
1265   aij(nene,j,z)   = DIO(nene,j,z)/CIO(j,z);
1266   
1267   aij2(ene,j,z)   = DEO(ene,j,z)/CEO(j,z);
1268   
1269  *==============================================================================
1270  *   Calibration of CET parameters
1271  *==============================================================================
1272  *    CET between total exports, domestic supply and margins
1273  *==============================================================================
1274   rho_X1(i,z)     = (1+sigma_X1(i,z))/sigma_X1(i,z);
1275   
1276   beta_EX_X1(i,z)$MRGNO(i,z)
1277                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1278                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1279                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1280                     eO(z)*PWMGO(i)*MRGNO(i,z)$MRGNO(i,z)**(1-rho_X1(i,z))];
1281   
1282   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1283                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1284                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1285                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1286   
1287   beta_D_X1(i,z)$MRGNO(i,z)
1288                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1289                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1290                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1291                     eO(z)*PWMGO(i)*MRGNO(i,z)**(1-rho_X1(i,z))];
1292   
1293   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1294                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1295                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1296                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1297   
1298   B_X1(i,z)       = XSO_I(i,z)/[beta_EX_X1(i,z)*EXTO(i,z)**rho_X1(i,z)
1299                    +beta_D_X1(i,z)*DSO_I(i,z)**rho_X1(i,z)+(1-beta_EX_X1(i,z)
1300                    -beta_D_X1(i,z))*MRGNO(i,z)**rho_X1(i,z)]**(1/rho_X1(i,z));
1301   
1302  *==============================================================================
1303  *    CET between exports to different trading partners
1304  *==============================================================================
1305   rho_X2(i,z)     = (1+sigma_X2(i,z))/sigma_X2(i,z);
1306   
1307   beta_X2(i,z,zj)$EXO(i,z,zj)
1308                   = [PEO(i,z,zj)*EXO(i,z,zj)**(1-rho_X2(i,z))]/
1309                     SUM[zjj$EXO(i,z,zjj),PEO(i,z,zjj)*EXO(i,z,zjj)
1310                     **(1-rho_X2(i,z))];
1311   
1312   B_X2(i,z)       = EXTO(i,z)/{SUM[zj,beta_X2(i,z,zj)*EXO(i,z,zj)**rho_X2(i,z)]
1313                     **(1/rho_X2(i,z))};
1314   
1315  *==============================================================================
1316  *   Calibration of CES parameters
1317  *==============================================================================
1318  *    Composite output
1319  *==============================================================================
1320   rho_X3(i,z)   = (1-sigma_X3(i,z))/sigma_X3(i,z);
1321   
1322   beta_X3(j,i,z)$XSO(j,i,z)
1323                 = [PO2(j,i,z)*XSO(j,i,z)**(1+rho_X3(i,z))]/
1324                     SUM[jj$XSO(jj,i,z),PO2(jj,i,z)*XSO(jj,i,z)**(1+rho_X3(i,z))];
1325   
1326   B_X3(i,z)     = XSO_I(i,z)
1327                    /SUM[jj$XSO(jj,i,z),beta_X3(jj,i,z)*XSO(jj,i,z)**(-rho_X3(i,z))
1328                    ]**(-1/rho_X3(i,z));
1329   
1330   POWERQO(Z) = SUM(POWER, XSO(power,'18_ELEC',z));
1331   
1332   rho_X4(z)   = (1-sigma_X4(z))/sigma_X4(z);
1333   
1334   beta_X4(power,z)
1335                 = [PO2(power,'18_ELEC',z)*XSO(power,'18_ELEC',z)**(1+rho_X4(z))]/
1336                     SUM[powerr$XSO(powerr,'18_ELEC',z),PO2(powerr,'18_ELEC',z)*XSO(powerr,'18_ELEC',z)**(1+rho_X4(z))];
1337   
1338   B_X4(z)     = POWERQO(Z)
1339                    /SUM[powerr$XSO(powerr,'18_ELEC',z),beta_X4(powerr,z)*XSO(powerr,'18_ELEC',z)**(-rho_X4(z))
1340                    ]**(-1/rho_X4(z));
1341   
1342   TnDShare(z) = XSO('18_TnD','18_ELEC',z)/XSO_I('18_ELEC',z);
1343   
1344   PPOWERO(z) = 1;
1345   
1346  *==============================================================================
1347  *    Composite good
1348  *==============================================================================
1349   rho_M1(i,z)     = (1-sigma_m1(i,z))/sigma_m1(i,z);
1350   
1351   beta_M1(i,z)    = PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)/
1352                    {PDO(i,z)*DDO(i,z)**(rho_M1(i,z)+1)
1353                    +PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)};
1354   
1355   B_M1(i,z)       = QO(i,z)/{beta_M1(i,z)*IMTO(i,z)**(-rho_M1(i,z))
1356                    +(1-beta_M1(i,z))*DDO(i,z)**(-rho_M1(i,z))}**(-1/rho_M1(i,z));
1357   
1358  *==============================================================================
1359  *   CES between imports from different trading partners
1360  *==============================================================================
1361   rho_M2(i,z)     = (1-sigma_M2(i,z))/sigma_M2(i,z);
1362   
1363   beta_M2(i,zj,z)$IMO(i,zj,z)
1364                   = [PMO(i,zj,z)*IMO(i,zj,z)**(rho_M2(i,z)+1)]/
1365                     SUM[zjj$IMO(i,zjj,z),PMO(i,zjj,z)*IMO(i,zjj,z)
1366                      **(rho_M2(i,z)+1)];
1367   
1368   B_M2(i,z)       = IMTO(i,z)/{SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*IMO(i,zj,z)
1369                     **(-rho_M2(i,z))]**(-1/rho_M2(i,z))};
1370   
1371  *==============================================================================
1372  *    Composite capital
1373  *==============================================================================
1374   rho_KD(j,z)     = (1-sigma_KD(j,z))/sigma_KD(j,z);
1375   
1376   beta_KD(k,j,z)$KDO(k,j,z)
1377                   = [RTIO(k,j,z)*KDO(k,j,z)**(1+rho_KD(j,z))]/
1378                     SUM[kj$KDO(kj,j,z),RTIO(kj,j,z)*KDO(kj,j,z)**(1+rho_KD(j,z))];
1379   B_KD(j,z)$KDCO(j,z)
1380                   = KDCO(j,z)/{SUM[k$KDO(k,j,z),beta_KD(k,j,z)*KDO(k,j,z)
1381                     **(-rho_KD(j,z))]**(-1/rho_KD(j,z))};
1382   
1383  *===============================================================================
1384  *   Composite E
1385  *===============================================================================
1386  *Leontief
1387   Share_Elec(j2,z) = DEO('18_ELEC',j2,z)/sum(ene,DEO(ene,j2,z));
1388   Share_nElec(ene3,j2,z) = DEO(ene3,j2,z)/sum(enee3,DEO(enee3,j2,z));
1389   Share_coalgas2(j2,z) = sum(ene5,DEO(ene5,j2,z))/sum(enee3,DEO(enee3,j2,z));
1390   Share_Oilpetrol2(j2,z) = sum(ene6,DEO(ene6,j2,z))/sum(enee3,DEO(enee3,j2,z));
1391   Share_coalgas(ene5,j2,z) = DEO(ene5,j2,z)/sum(enee5,DEO(enee5,j2,z));
1392   Share_Oilpetrol(ene6,j2,z) = DEO(ene6,j2,z)/sum(enee6,DEO(enee6,j2,z));
1393   
1394  *CES No Level
1395  * rho_ENER(j,z)   = (1-sigma_ENER(j,z))/sigma_ENER(j,z);
1396   
1397  * beta_ENER(ene,j,z)$DEO(ene,j,z)
1398  *                 = [PO4(ene,j,z)*DEO(ene,j,z)**(1+rho_ENER(j,z))]/
1399  *                   SUM[enee,PO4(enee,j,z)*DEO(enee,j,z)
1400  *                   **(1+rho_ENER(j,z))];
1401   
1402  * B_ENER(j,z)$CEO(j,z)
1403  *                 = CEO(j,z)/{SUM[ene,beta_ENER(ene,j,z)*DEO(ene,j,z)
1404  *                   **(-rho_ENER(j,z))]**(-1/rho_ENER(j,z))};
1405   
1406  *Level 5_1 (Coal/Gas)
1407   rho_ENER_coalgas(j2,z)   = (1-sigma_ENER_coalgas(j2,z))/sigma_ENER_coalgas(j2,z);
1408   
1409   beta_ENER_coalgas(ene5,j2,z)
1410                   = [PO4(ene5,j2,z)*DEO(ene5,j2,z)**(1+rho_ENER_coalgas(j2,z))]/
1411                     SUM[enee5,PO4(enee5,j2,z)*DEO(enee5,j2,z)
1412                     **(1+rho_ENER_coalgas(j2,z))];
1413   B_ENER_coalgas(j2,z)
1414                   = DEcoalgasO(j2,z)/{SUM[ene5,beta_ENER_coalgas(ene5,j2,z)*DEO(ene5,j2,z)
1415                     **(-rho_ENER_coalgas(j2,z))]**(-1/rho_ENER_coalgas(j2,z))};
1416   
1417  *Level 5_2 (oil/petrol)
1418   rho_ENER_oilprod(j2,z)   = (1-sigma_ENER_oilprod(j2,z))/sigma_ENER_oilprod(j2,z);
1419   
1420   beta_ENER_oilprod(ene6,j2,z)
1421                   = [PO4(ene6,j2,z)*DEO(ene6,j2,z)**(1+rho_ENER_oilprod(j2,z))]/
1422                     SUM[enee6,PO4(enee6,j2,z)*DEO(enee6,j2,z)
1423                     **(1+rho_ENER_oilprod(j2,z))];
1424   B_ENER_oilprod(j2,z)
1425                   = DEoilpetrolO(j2,z)/{SUM[ene6,beta_ENER_oilprod(ene6,j2,z)*DEO(ene6,j2,z)
1426                     **(-rho_ENER_oilprod(j2,z))]**(-1/rho_ENER_oilprod(j2,z))};
1427   
1428  *Level 4 (Coal-Gas/Oil-Petrol)
1429   rho_ENER_fossil(j2,z)   = (1-sigma_ENER_fossil(j2,z))/sigma_ENER_fossil(j2,z);
1430   
1431   beta_ENER_fossil(j2,z)
1432                   = PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)**(rho_ENER_fossil(j2,z)+1)/
1433                    {PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)**(rho_ENER_fossil(j2,z)+1)+
1434                     PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)**(rho_ENER_fossil(j2,z)+1)};
1435   B_ENER_fossil(j2,z)
1436                   = DEnelecO(j2,z)
1437                     /{[beta_ENER_fossil(j2,z)*DEcoalgasO(j2,z)**(-rho_ENER_fossil(j2,z))+
1438                     (1-beta_ENER_fossil(j2,z))*DEoilpetrolO(j2,z)**(-rho_ENER_fossil(j2,z))
1439                     ]**(-1/rho_ENER_fossil(j2,z))};
1440   
1441  *Level 3 (Coal/Gas/Oil/Petrol)
1442  * rho_ENER3(j2,z)   = (1-sigma_ENER3(j2,z))/sigma_ENER3(j2,z);
1443   
1444  * beta_ENER3(ene3,j2,z)
1445  *                 = [PO4(ene3,j2,z)*DEO(ene3,j2,z)**(1+rho_ENER3(j2,z))]/
1446  *                   SUM[enee3,PO4(enee3,j2,z)*DEO(enee3,j2,z)
1447  *                   **(1+rho_ENER3(j2,z))];
1448   
1449  * B_ENER3(j2,z)
1450  *                 = DEnelecO(j2,z)/{SUM[ene3,beta_ENER3(ene3,j2,z)*DEO(ene3,j2,z)
1451  *                   **(-rho_ENER3(j2,z))]**(-1/rho_ENER3(j2,z))};
1452   
1453  *Level 2 (Elec/Non Elec)
1454   rho_ENER_elec(j2,z)   = (1-sigma_ENER_elec(j2,z))/sigma_ENER_elec(j2,z);
1455   
1456   beta_ENER_elec(j2,z)
1457                   = PCEelecO(j2,z)*DEelecO(j2,z)**(rho_ENER_elec(j2,z)+1)/
1458                    {PCEelecO(j2,z)*DEelecO(j2,z)**(rho_ENER_elec(j2,z)+1)+
1459                     PCEnelecO(j2,z)*DEnelecO(j2,z)**(rho_ENER_elec(j2,z)+1)};
1460   B_ENER_elec(j2,z)
1461                   = CEO(j2,z)
1462                     /{[beta_ENER_elec(j2,z)*DEelecO(j2,z)**(-rho_ENER_elec(j2,z))+
1463                     (1-beta_ENER_elec(j2,z))*DEnelecO(j2,z)**(-rho_ENER_elec(j2,z))
1464                     ]**(-1/rho_ENER_elec(j2,z))};
1465   
1466  *==============================================================================
1467  *    4.6.3.5 Value added
1468  *==============================================================================
1469   rho_VA(j,z)     = (1-sigma_VA(j,z))/sigma_VA(j,z);
1470   
1471   beta_VA(j,z)$KDCO(j,z)
1472                   = WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)/
1473                    {WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)+
1474                     RCO(j,z)*KDCO(j,z)**(rho_VA(j,z)+1)};
1475   B_VA(j,z)$KDCO(j,z)
1476                   = VAO(j,z)
1477                     /{[beta_VA(j,z)*LDCO(j,z)**(-rho_VA(j,z))+
1478                     (1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
1479                     ]**(-1/rho_VA(j,z))};
1480   
1481   B_VA_t(j,z,time) = B_VA(j,z);
1482   
1483  *==============================================================================
1484  *    Composite KLE
1485  *==============================================================================
1486   KLEO(j,z)       = CEO(j,z) + VAO(j,z) ;
1487   
1488   PKLEO(j,z)      = [PCEO(j,z)*CEO(j,z)+PVAO(j,z)*VAO(j,z)]/KLEO(j,z);
1489   
1490   rho_KLE(j,z)    = (1-sigma_KLE(j,z))/sigma_KLE(j,z);
1491   
1492   beta_KLE(j,z)$KLEO(j,z)
1493                   = PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)/
1494                    {PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)+
1495                     PCEO(j,z)*CEO(j,z)**(rho_KLE(j,z)+1)};
1496   
1497   beta_KLE2(j,z)$KLEO(j,z)
1498                   = 1-beta_KLE(j,z);
1499   
1500   B_KLE(j,z)$KLEO(j,z)
1501                   = KLEO(j,z)
1502                     /{[beta_KLE(j,z)*VAO(j,z)**(-rho_KLE(j,z))+
1503                     (beta_KLE2(j,z))*CEO(j,z)**(-rho_KLE(j,z))
1504                     ]**(-1/rho_KLE(j,z))};
1505   
1506  *==============================================================================
1507  *  Calibration of LES parameters
1508  *==============================================================================
1509  *   As the assigned values of income elasticities may not result in
1510  *   consumption shares that add up to 1, this first step
1511  *   adjusts the elasticities proportionally
1512   sigma_Y(i,z)    = sigma_Y(i,z)/{SUM[ij,sigma_Y(ij,z)*PCO(ij,z)*CO(ij,z)]
1513                     /CTHO(z)};
1514   gamma_LES(i,z)  = PCO(i,z)*CO(i,z)*sigma_Y(i,z)/CTHO(z);
1515   CMINO(i,z)      = CO(i,z)+gamma_LES(i,z)*CTHO(z)/{PCO(i,z)*frisch(z)};
1516   
1517  *==============================================================================
1518  *  Calibration of gross domestic products
1519  *==============================================================================
1520   GDP_BPO(z)      = SUM[j,PVAO(j,z)*VAO(j,z)]+TIPTO(z);
1521   GDP_MPO(z)      = GDP_BPO(z)+TPRCTSO(z);
1522  * GDP_IBO(z)      = SUM[(l,j),WO(l,z)*LDO(l,j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1523   GDP_IBO(z)      = SUM[(j),WO(z)*LDO(j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1524                     +TPRODNO(z)+TPRCTSO(z);
1525   GDP_FDO(z)      = SUM[i,PCO(i,z)*(CO(i,z)+CGO(i,z)+INVO(i,z))]
1526                    +eO(z)*SUM[(i,zj),PWXO(i,z,zj)*EXO(i,z,zj)]
1527                    +eO(z)*SUM[i,PWMGO(i)*MRGNO(i,z)]
1528                    -eO(z)*SUM[(i,zj),IMO(i,zj,z)*(PWMO(i,zj,z)
1529                    +SUM{ij,PWMGO(ij)*tmrg(ij,i,zj,z)})];
1530   GDP_BP_WO       = SUM[z,GDP_BPO(z)/eO(z)];
1531   
1532  *==============================================================================
1533  *  4.8 Calibration of real (volume) variables computed from price indices
1534  *==============================================================================
1535   CABXO(z)        = CABO(z)/[PIXGDP_WO*eO(z)];
1536   
1537  *------------------------------------------------------------------------------
1538  * Calculation of CAB index
1539  * If every region's CABX grows exogenously according to exogro, then the
1540  * worldwide sum of CABX's will not be zero. If, due to redundancy, the reference
1541  * region's CABX is left implicit, then it will not grow according to that
1542  * region's exogro (it follows that the solution will depend on the choice of
1543  * reference region). CABix is formed from exogro by inflating or deflating the
1544  * updating factors of positive (SURplus) and negative (DEFicit) CABX's in such
1545  * a way that their sum remains zero.
1546   
1547  *$ontext
1548  Parameter CABXsur(z,time), CABXdef(z,time), bal(time), mu(time), CABix(z,time);
1549  * CABXsur(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) gt 0];
1550  * CABXdef(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) lt 0];
1551   
1552   CABXsur(z,t1) = CABXO(z)$[CABXO(z) gt 0];
1553   CABXdef(z,t1) = CABXO(z)$[CABXO(z) lt 0];
1554   
1555   CABXsur(z,time)$[ord(time) gt 1] = CABXO(z)*(1+g_GDP(z,time))$[CABXO(z) gt 0];
1556   CABXdef(z,time)$[ord(time) gt 1] = CABXO(z)*(1+g_GDP(z,time))$[CABXO(z) lt 0];
1557   
1558   Bal(time)           = sum(zj,CABXsur(zj,time))+sum(zj,CABXdef(zj,time));
1559   mu(time)           = sum(zj,CABXsur(zj,time))/
1560                          {sum(zj,CABXsur(zj,time))+sum(zj,abs[CABXdef(zj,time)])};
1561   CABXsur(z,time) = CABXsur(z,time)*{1-mu(time)*Bal(time)/sum(zj,CABXsur(zj,time))};
1562   CABXdef(z,time) = CABXdef(z,time)*{1-[1-mu(time)]*Bal(time)/sum(zj,CABXdef(zj,time))};
1563   CABix(z,time)     = [CABXsur(z,time)+CABXdef(z,time)]/CABXO(z);
1564  *$offtext
1565  *------------------------------------------------------------------------------
1566   
1567   CTH_REALO(z)    = CTHO(z)/PIXCONO(z);
1568   G_REALO(z)      = GO(z)/PIXGVTO(z);
1569   GDP_BP_REALO(z) = GDP_BPO(z)/PIXGDPO(z);
1570   GDP_BP_W_REALO  = GDP_BP_WO/PIXGDP_WO;
1571   GDP_MP_REALO(z) = GDP_MPO(z)/PIXCONO(z);
1572   IT_REALO(z)     = ITO(z)/PIXINVO(z);
1573   
1574  *==============================================================================
1575  *  Parameters of the household savings function
1576  *==============================================================================
1577   sh1O(z)         = [SHO(z)+SGO(z)]/GDP_IBO(z);
1578   sh0O(z)         = SHO(z)-sh1O(z)*YDHO(z);
1579   
1580  *==============================================================================
1581  *  Re-calibration of indexed transfers and parameters
1582  *==============================================================================
1583   sh0O(z)         = sh0O(z)/PIXCONO(z)**eta;
1584   ttdh0O(z)       = ttdh0O(z)/PIXCONO(z)**eta;
1585   
