 851  *===============================================================================
 852  * CES - composite capital
 853    sigma_KD(j,z)   = 2*sigma_VA(j,z);
 854  * sigma_KD(j,z)                  = 0.5;
 855  * sigma_KD('02_COAL',z)     = 0.2;
 856  * sigma_KD('03_OIL',z)        = 0.2;
 857  * sigma_KD('04_GAS',z)       = 0.2;
 858  * sigma_KD('05_MINING',z)  = 0.2;
 859   
 860  * CES - composite labor
 861   sigma_LD(j,z)   = 2*sigma_VA(j,z);
 862   
 863  * CES - composite K-L
 864  * sigma_VA('10_PETROLCOAL',z)  = 1.26;
 865   sigma_VA('18_TnD',z)         = 0.2;
 866   sigma_VA('19_eNuclear',z)   = 0.2;
 867   sigma_VA('20_eCoal',z)       = 0.2;
 868   sigma_VA('21_eGas',z)        = 0.2;
 869   sigma_VA('22_eOil',z)         = 0.2;
 870   sigma_VA('23_eWind',z)      = 0.2;
 871   sigma_VA('24_eSolar',z)      = 0.2;
 872   sigma_VA('25_eHydro',z)     = 0.2;
 873   sigma_VA('26_eOther',z)     = 0.2;
 874   
 875  * CES - composite ENER
 876  * sigma_ENER(j,z)              = 1.1 ;
 877  * sigma_ENER3(j2,z)           = 1.1 ;
 878   sigma_ENER_elec(j2,z)        = 2.0 ;
 879   sigma_ENER_fossil(j2,z)      = 2.0 ;
 880   sigma_ENER_coalgas(j2,z)   = 1.5;
 881   sigma_ENER_oilprod(j2,z)    = 0.5 ;
 882   
 883  * CES - DOM vs.IMP
 884   sigma_M1('03_OIL','06_PRK') = 0.5;
 885   sigma_M1('04_GAS',Z) = 6;
 886   
 887  * CES - IMP sourcing
 888   sigma_M2('03_OIL',Z) = 2;
 889   sigma_M2('04_GAS',Z) = 2;
 890   
 891   sigma_X0(j,z)  = 1.5;
 892  * CET - total output
 893   sigma_X2(i,Z)  = 2;
 894   
 895  * CES - composite Power sector
 896   sigma_X4(z)    = 4;
 897   
 898  * Investment demand elasticity
 899   sigma_INV(k,j,z) = 2;
 900   
 901  * LES parameters - Frisch all (1.1)
 902   frisch(z)      = PARZ(z,'frisch');
