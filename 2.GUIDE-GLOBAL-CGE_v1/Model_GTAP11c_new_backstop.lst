1018  * Calibration of Own-price elasticities for KOR
1019  *==============================================================================
1020  *$ontext
1021  *Elec
1022   sigma_KLE('01_AGRICULT','01_KOR')        = 0.5 ;
1023   sigma_KLE('05_MINING  ','01_KOR')        = 0.5 ;
1024   sigma_KLE('06_FOODPRO ','01_KOR')        = 0.5 ;
1025   sigma_KLE('07_TEXTILES','01_KOR')        = 0.5 ;
1026   sigma_KLE('08_WOODPRO','01_KOR')        = 0.5 ;
1027   sigma_KLE('09_PAPERPRO','01_KOR')        = 0.5 ;
1028   sigma_KLE('11_CHEMICAL','01_KOR')        = 0.5 ;
1029   sigma_KLE('12_NONMET','01_KOR')         = 0.5 ;
1030   sigma_KLE('13_IRONSTL','01_KOR')         = 0.5 ;
1031   sigma_KLE('14_NONFERR','01_KOR')         = 0.5 ;
1032   sigma_KLE('15_MACHINE','01_KOR')         = 0.5 ;
1033   sigma_KLE('16_TRANSEQ','01_KOR')         = 0.5 ;
1034   sigma_KLE('17_OTHERIND','01_KOR')        = 0.5 ;
1035   sigma_KLE('31_SER ','01_KOR')                 = 0.5 ;
1036   
1037   sigma_ENER_elec(j,'01_KOR') = 0.1 ;
1038   
1039   sigma_Y('18_ELEC','01_KOR') = 0.1* sigma_Y('18_ELEC','01_KOR');
1040   
1041   
1042  *Coal
1043   sigma_KLE('20_eCoal','01_KOR')                 = 1.2;
1044   sigma_ENER_elec('20_eCoal','01_KOR')       = 0.4;
1045   sigma_ENER_nelec('20_eCoal','01_KOR')      = 0.4 ;
1046   sigma_ENER_coalgas('20_eCoal','01_KOR')  = 0.4;
1047   sigma_ENER_oilprod('20_eCoal','01_KOR')   = 0.4 ;
1048   
1049  *Gas
1050   sigma_ENER_coalgas(j,'01_KOR')  = 0.2;
1051   sigma_ENER_nelec(j,'01_KOR') = 0.5 ;
1052   
1053   sigma_Y('04_GAS','01_KOR') = 0.1* sigma_Y('04_GAS','01_KOR');
1054   
1055  *PetrolCoal
1056   sigma_KLE('10_PETROLCOAL','01_KOR')     = 0.5 ;
1057   sigma_KLE('11_CHEMICAL','01_KOR')         = 0.5 ;
1058   sigma_KLE('22_eOil','01_KOR')         = 0.5 ;
1059   sigma_KLE('28_LTRP','01_KOR')                 = 0.5 ;
1060   
1061   sigma_ENER_nelec(j,'01_KOR') = 0.5 ;
1062   sigma_ENER_oilprod(j,'01_KOR')   = 0.1 ;
1063   
1064   sigma_Y('10_PETROLCOAL','01_KOR') = 0.1* sigma_Y('10_PETROLCOAL','01_KOR');
1065  *$offtext
1066  *==============================================================================
1067  *   Rescaling
1068  *==============================================================================
1069  * GTAP data are in millions of US dollars With RES = 10000, model results are in tens of billions (10G$)
1070  RES              = 10000;
1071  CO(i,z)          = CO(i,z)/RES;
1072  CGO(i,z)         = CGO(i,z)/RES;
1073  DDO(i,z)         = DDO(i,z)/RES;
1074  DEPO(z)          = DEPO(z)/RES;
1075  DIO(i,j,z)       = DIO(i,j,z)/RES;
1076  DSO(j,i,z)       = DSO(j,i,z)/RES;
1077  DSO_I(i,z)       = DSO_I(i,z)/RES;
1078  EXO(i,z,zj)      = EXO(i,z,zj)/RES;
1079  IMO(i,z,zj)      = IMO(i,z,zj)/RES;
1080  INVO(i,z)        = INVO(i,z)/RES;
1081  KSTO(z)          = KSTO(z)/RES;
1082  LDO(j,z)         = LDO(j,z)/RES;
1083  MRGNO(i,z)       = MRGNO(i,z)/RES;
1084  RKDO(k,j,z)      = RKDO(k,j,z)/RES;
1085  TDHO(z)          = TDHO(z)/RES;
1086  TICO(i,z)        = TICO(i,z)/RES;
1087  TIKO(k,j,z)      = TIKO(k,j,z)/RES;
1088  TIMO(i,z,zj)     = TIMO(i,z,zj)/RES;
1089  TIPO(j,z)        = TIPO(j,z)/RES;
1090  TIWO(j,z)        = TIWO(j,z)/RES;
1091  TIXO(i,z,zj)     = TIXO(i,z,zj)/RES;
1092  tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj)/RES;
1093  XSO_I(i,z)       = XSO_I(i,z)/RES;
1094  XSO(j,i,z)       = XSO(j,i,z)/RES;
1095  XSTO(j,z)        = XSTO(j,z)/RES;
1096   
1097  *==============================================================================
1098  *  3.3 Exogenous prices and parameters
1099  *==============================================================================
1100  *  Price elasticity (should be equal to one to verify homogeneity)
1101  eta = 1;
1102   
1103  *------------------------------------------------------------------------------
1104  *  Slopes of taxation functions
1105  *   One can either choose to assign a value to the intercepts and calibrate
1106  *   the slopes accordingly, or the other way around. This type of modelling
1107  *   can be useful to take into account known marginal savings or taxation rates
1108  *   or to deal with negative average saving rates in cases where savings are
1109  *   negative for some household groups.
1110  *   When no further information is available, one can simply set the intercepts
1111  *   to zero and calibrate an average rate: this is what we do here for ttdh0O.
1112  *   If the user wishes to assume otherwise, he can fill the appropriate area in
1113  *   the Excel file VAL_PAR.xls.
1114  * ttdh0O(z)       = PARZ(z,'ttdh0O');
1115   ttdh0O(z)       = 0;
1116  *   The slope ttdh1O is calibrated below in the mane GAMS file
1117   
1118  *------------------------------------------------------------------------------
1119  * Also we need to assign values to some prices
1120  * All of the prices below, EXCEPT eO, may be set at arbitrary values
1121  * without loss of generality.
1122  *
1123  * In the case of eO, although exchange rates may be given arbitrary values
1124  * in the model, they must all be equal for calibration at this stage. The reason
1125  * is that the supply of margin transport services MRGNO must equal global demand.
1126  * Since there is a single world price for international transport margins
1127  * (rather than bilateral world prices for other commodities) the unit of
1128  * measurement of the volume of margin services must be the same for all regions,
1129  * and in turn, that implies that the divisor that converts the nominal value to
1130  * volume be the same for all regions. Since that divisor involves the exchange
1131  * rate, all exchange rates must be equal.
1132   
1133  * Normally, prices that may be given arbitrary values are set at 1:
1134   eO(z)            = 1;
1135   PEO(i,z,zj)      = 1;
1136   PLO(i,z)         = 1;
1137   PWMGO(i)         = 1;
1138   WO(z)            = 1;
1139   WO_lag(z)        = WO(z) ;
1140   
1141  *==============================================================================
1142  * Calibration
1143  *==============================================================================
1144   YHKO(z)         = SUM[(k,j),RKDO(k,j,z)];
1145   YHLO(z)         = SUM[(j),LDO(j,z)];
1146   YHO(z)          = YHLO(z)+YHKO(z);
1147   YDHO(z)         = YHO(z)-TDHO(z);
1148   CTHO(z)         = SUM[i,CO(i,z)];
1149   SHO(z)          = YDHO(z)-CTHO(z);
1150   TICTO(z)        = SUM[i,TICO(i,z)];
1151   TIMTO(z)        = SUM[(i,zj),TIMO(i,zj,z)];
1152   TIWTO(z)        = SUM[(j),TIWO(j,z)];
1153   TIKTO(z)        = SUM[(k,j),TIKO(k,j,z)];
1154   TIPTO(z)        = SUM[j,TIPO(j,z)];
1155   TIXTO(z)        = SUM[(i,zj),TIXO(i,z,zj)];
1156   TPRODNO(z)      = TIKTO(z)+TIWTO(z)+TIPTO(z);
1157   TPRCTSO(z)      = TICTO(z)+TIMTO(z)+TIXTO(z);
1158   YGO(z)          = TDHO(z)+TPRCTSO(z)+TPRODNO(z);
1159   GO(z)           = SUM[i,CGO(i,z)];
1160   SGO(z)          = YGO(z)-GO(z);
1161   YROWO(z)        = SUM[(i,zj),IMO(i,zj,z)]+SUM[(i,ij,zj),tmrg(i,ij,zj,z)];
1162   SROWO(z)        = YROWO(z)-SUM[(i,zj),EXO(i,z,zj)]-SUM[i,MRGNO(i,z)];
1163   CABO(z)         = -SROWO(z);
1164   ITO(z)          = SHO(z)+SGO(z)+SROWO(z);
1165   
1166  *==============================================================================
1167  *  Calibration of parameters and other variables
1168  *==============================================================================
1169  *  Calibration of investment and government spending shares
1170  *==============================================================================
1171   gamma_GVT(i,z)  = CGO(i,z)/SUM[ij,CGO(ij,z)];
1172   gamma_INV(i,z)  = INVO(i,z)/SUM[ij,INVO(ij,z)] ;
1173   
1174  *==============================================================================
1175  *  Calibration of other prices and revised volumes (part 1)
1176  *==============================================================================
1177   LDO(j,z)      = LDO(j,z)/WO(z);
1178   LDCO(j,z)     = LDO(j,z);
1179   LSO(z)        = SUM[j,LDO(j,z)];
1180   LSTO(z)       = LSO(z) ;
1181   LSO_lag(z)    = LSO(z) ;
1182   LSTO_lag(z)   = LSO(z) ;
1183   EXO(i,z,zj)  = [EXO(i,z,zj)-TIXO(i,z,zj)]/PEO(i,z,zj);
1184   EXTO(i,z)    = SUM[zj,EXO(i,z,zj)];
1185   PWXO(i,z,zj)$EXO(i,z,zj)
1186                   = {[PEO(i,z,zj)*EXO(i,z,zj)+TIXO(i,z,zj)]/EXO(i,z,zj)}/eO(z);
1187   
1188   PETO(i,z)       = SUM[zj,PEO(i,z,zj)*EXO(i,z,zj)]/EXTO(i,z);
1189  * PETO(i,z)$(EXTO(i,z) > 0) = SUM[zj, PEO(i,z,zj) * EXO(i,z,zj)] / EXTO(i,z);
1190  * PETO(i,z)$(EXTO(i,z) = 0) = 0;
1191   PWMO(i,z,zj)    = PWXO(i,z,zj);
1192   IMO(i,zj,z)     = EXO(i,zj,z);
1193   IMTO(i,z)       = SUM[zj,IMO(i,zj,z)];
1194   
1195   DSO(j,i,z)      = DSO(j,i,z)/PLO(i,z);
1196   DSO_I(i,z)      = SUM(j,DSO(j,i,z));
1197   DSO_J(j,z)      = SUM(i,DSO(j,i,z));
1198   QO(i,z)         = IMTO(i,z)+DDO(i,z);
1199   
1200   MRGNO(i,z)$MRGNO(i,z)
1201                   = MRGNO(i,z)/[eO(z)*PWMGO(i)];
1202   
1203   XSO_I(i,z)      = EXTO(i,z)+DDO(i,z)+MRGNO(i,z);
1204   
1205   XSTO(j,z)       = sum(i, XSO(j,i,z));
1206   
1207   PO(i,z)         = [PETO(i,z)*EXTO(i,z)+PLO(i,z)*DSO_I(i,z)
1208                    +eO(z)*PWMGO(i)*MRGNO(i,z)]/XSO_I(i,z);
1209   
1210   PO2(j,i,z)$XSO(j,i,z) = 1;
1211   
1212   PO3(i,j,z)$XSO(j,i,z) = 1;
1213   
1214   PIO(i,z)       = SUM[j$XSO(j,i,z),PO2(J,I,z)*XSO(j,i,z)]/XSO_I(i,z);
1215   
1216   PTO(j,z)       = SUM[i$XSO(j,i,z),PO2(j,i,z)*XSO(j,i,z)]/XSTO(j,z);
1217   
1218   PPO(j,z)       = (TIWO(j,z)+WO(z)*LDO(j,z)
1219                    +SUM[k,TIKO(k,j,z)+RKDO(k,j,z)]
1220                    +SUM[nene,DIO(nene,j,z)]+SUM[ene,DIO(ene,j,z)])/XSTO(j,z);
1221   
1222   theta2(j,i,z)  = DSO(j,i,z)/sum(jj, DSO(jj,i,z));
1223   
1224   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z)*EXTO(i,z);
1225   
1226  *==============================================================================
1227  *  Calibration of tax rates, margins, prices and volumes
1228  *==============================================================================
1229  *  Margin rates and tax rates
1230  *==============================================================================
1231   ttixO(i,z,zj)   = [eO(z)*PWXO(i,z,zj)/PEO(i,z,zj)]-1;
1232   tticO(i,z)      = TICO(i,z)/{PLO(i,z)*DDO(i,z)
1233                     +SUM[zj,IMO(i,zj,z)*eO(z)*PWMO(i,zj,z)
1234                     +TIMO(i,zj,z)+SUM[ij,tmrg(ij,i,zj,z)]]};
1235   
1236   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
1237                   = tmrg(i,ij,zj,z)/(PWMGO(i)*eO(z)*IMO(ij,zj,z));
1238   
1239   ttimO(i,zj,z)$IMO(i,zj,z)
1240                   = TIMO(i,zj,z)/{IMO(i,zj,z)*eO(z)*(PWMO(i,zj,z)
1241                    +SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])};
1242   
1243   ttiwO(j,z)$LDO(j,z)
1244                   = TIWO(j,z)/[WO(z)*LDO(j,z)];
1245   
1246   ttikO(k,j,z)$RKDO(k,j,z)
1247                   = TIKO(k,j,z)/RKDO(k,j,z);
1248   
1249   ttipO(j,z)      = [PTO(j,z)/PPO(j,z)]-1;
1250   
1251   ttdh1O(z)       = [TDHO(z)-ttdh0O(z)]/YHO(z);
1252   
1253  *==============================================================================
1254  *  Calibration of other prices and revised volumes (part 2)
1255  *==============================================================================
1256   PDO(i,z)        = PLO(i,z)*(1+tticO(i,z));
1257   PMO(i,zj,z)     = eO(z)*(PWMO(i,zj,z)+SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])
1258                   *(1+ttimO(i,zj,z))*(1+tticO(i,z));
1259   PMTO(i,z)       = SUM[zj,PMO(i,zj,z)*IMO(i,zj,z)]/IMTO(i,z);
1260   PCO(i,z)        = [PMTO(i,z)*IMTO(i,z)+PDO(i,z)*DDO(i,z)]/QO(i,z);
1261   
1262   CO(i,z)         = CO(i,z)/PCO(i,z);
1263   CGO(i,z)        = CGO(i,z)/PCO(i,z);
1264   DIO(nene,j,z)   = DIO(nene,j,z)/PCO(nene,z);
1265   DEO(ene,j,z)    = DIO(ene,j,z)/PCO(ene,z);
1266   
1267   DEelecO(j,z)    = DIO("18_ELEC",j,z)/PCO("18_ELEC",z);
1268   DEnelecO(j,z)   = sum(ene3,DEO(ene3,j,z));
1269   
1270   DEcoalgasO(j,z) = sum(ene5,DEO(ene5,j,z));
1271   DEcoalO(j,z)    = DEO("02_COAL ",j,z);
1272   DEgasO(j,z)     = DEO("04_GAS",j,z);
1273   
1274   DEoilpetrolO(j,z) = sum(ene6,DEO(ene6,j,z));
1275   DEoilO(j,z)       = DEO("03_OIL",j,z);
1276   DEpetrolO(j,z)    = DEO("10_PETROLCOAL",j,z);
1277   
1278   INVO(i,z)       = INVO(i,z)/PCO(i,z);
1279   
1280   CIO(j,z)        = SUM[nene,DIO(nene,j,z)];
1281   CEO(j3,z)        = SUM[ene,DEO(ene,j3,z)];
1282   CEO(j2,z)        = DEelecO(j2,z)+DEnelecO(j2,z);
1283   
1284   DITO(nene,z)    = SUM[j,DIO(nene,j,z)];
1285   DITO(ene,z)     = SUM[j,DEO(ene,j,z)];
1286   
1287   PO4(ene,j,z)    = PCO(ene,z);
1288   
1289   PCIO(j,z)       = SUM[nene,PCO(nene,z)*DIO(nene,j,z)]/CIO(j,z);
1290   
1291   PCEcoalO(j,z)   = PO4("02_COAL",j,z) ;
1292   PCEgasO(j,z)    = PO4("04_GAS",j,z) ;
1293   PCEoilO(j,z)    = PO4("03_OIL",j,z) ;
1294   PCEpetrolO(j,z) = PO4("10_PETROLCOAL",j,z) ;
1295   
1296   PCEoilpetrolO(j,z)  = [PCEoilO(j,z)*DEoilO(j,z)+PCEpetrolO(j,z)*DEpetrolO(j,z)]
1297                     /DEoilpetrolO(j,z) ;
1298   
1299   PCEcoalgasO(j,z)  = [PCEcoalO(j,z)*DEcoalO(j,z)+PCEgasO(j,z)*DEgasO(j,z)]
1300                     /DEcoalgasO(j,z) ;
1301   
1302   PCEnelecO(j,z)  = [PCEcoalgasO(j,z)*DEcoalgasO(j,z)+PCEoilpetrolO(j,z)*DEoilpetrolO(j,z)]
1303                     /DEnelecO(j,z) ;
1304   
1305   PCEelecO(j,z)   = SUM[ene4,PCO(ene4,z)*DEO(ene4,j,z)]/DEelecO(j,z) ;
1306   PCEO(j,z)       = [PCEelecO(j,z)*DEelecO(j,z)+PCEnelecO(j,z)*DEnelecO(j,z)]/CEO(j,z) ;
1307   PCEO(j3,z)       = SUM[ene,PCO(ene,z)*DEO(ene,j3,z)]/CEO(j3,z) ;
1308   WTIO(j,z)     = WO(z)*(1+ttiwO(j,z));
1309   WCO(j,z)$LDCO(j,z)
1310                   = (WTIO(j,z)*LDO(j,z))/LDCO(j,z);
1311   
1312  *==============================================================================
1313  *  Calibration of dynamic parameters
1314  *==============================================================================
1315  * Calibration of dynamic parameters following new procedure.
1316  * The price of capital is arbitrary:
1317   PKO(z) = 1;
1318   
1319  * The calibration of depreciation rates is based on two hypotheses:
1320  * 1. The rate of depreciation is the same for all types of capital and all
1321  *    industries in each region (this hypothesis is made to accommodate the fact
1322  *    that, in the GTAP data base, capital consumption allowance is not detailed;
1323  *    as a matter of fact, the GTAP capital consumption allowance is set at
1324  *    4% of the value of the capital stock).
1325  * 2. The rental rate of capital is uniform across industries and types of
1326  *    capital in each region.
1327  * 3. The investment rate (IND/KD) is uniform across industries and types of
1328  *    capital in each region.
1329  * These hypotheses lead to the following formulae:
1330   
1331  * From GTAP, we know KSTO.
1332   KSTO(z)         = KSTO(z)/PKO(z);
1333   
1334  * Assuming a uniform depreciation rate for all types
1335  * of capital and all industries:
1336   delta(z)        = DEPO(z)/[PKO(z)*KSTO(z)];
1337   
1338  * From GTAP, we know KSTO. Assuming a uniform rental rate R for all types
1339  * of capital and all industries:
1340   RO(k,j,z)$RKDO(k,j,z)
1341                   = SUM[(kj,jj),RKDO(kj,jj,z)]/KSTO(z);
1342   
1343  * Then from the GTAP value of income paid to capital RKD we calibrate KDO:
1344   KDO(k,j,z)$RKDO(k,j,z)
1345                   = RKDO(k,j,z)/RO(k,j,z);
1346   
1347  * The supply of capital is equal to demand:
1348   KSO(k,z)        = SUM[j,KDO(k,j,z)];
1349   
1350  * The rate of return on capital, net of depreciation, is:
1351   IRO(z)         = {SUM[(k,j)$RKDO(k,j,z),RKDO(k,j,z)]-DEPO(z)}/[PKO(z)*KSTO(z)];
1352   
1353  * The user cost of capital follows
1354   UO(z)           = PKO(z)*(IRO(z)+delta(z));
1355   
1356  * Combining
1357  * - the hypothesis of uniform investment rates
1358  * - the hypothesis of uniform rental rates
1359  * - the hypothesis of uniform depreciation rates
1360  * leads to
1361   phiO(z)         = [ITO(z)/PKO(z)]/KSTO(z);
1362   
1363  * Investment by destination follows:
1364   INDO(k,j,z)$KDO(k,j,z)
1365                   = phiO(z)*KDO(k,j,z);
1366   
1367   A_K(z)          = 1/PKO(z)*{PROD[i$gamma_INV(i,z),(PCO(i,Z)/gamma_INV(i,z))
1368                     **gamma_INV(i,z)]};
1369   
1370   KDCO(j,z)       = SUM[k,KDO(k,j,z)];
1371   RTIO(k,j,z)     = RO(k,j,z)*(1+ttikO(k,j,z));
1372   RCO(j,z)$KDCO(j,z)
1373                   = SUM[k,RTIO(k,j,z)*KDO(k,j,z)]/KDCO(j,z);
1374   
1375  *==============================================================================
1376  *  Calibration of other prices and revised volumes (part 3)
1377  *==============================================================================
1378   VAO(j,z)        = LDCO(j,z)+KDCO(j,z);
1379   
1380   PVAO(j,z)       = [WCO(j,z)*LDCO(j,z)+RCO(j,z)*KDCO(j,z)]/VAO(j,z);
1381   
1382  * PIXGDPO is tautologically equal to 1, based on its formula
1383  * PIXGDPO(z)      = {SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1384  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1385  *                   *SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1386  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]}**0.5;
1387   PIXGDPO(z)      = 1;
1388   
1389  * PIXGDP_WO is tautologically equal to 1, based on its formula
1390  * PIXGDP_WO       = {SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1391  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1392  *                   *SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1393  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]/eO(z)}**0.5;
1394   PIXGDP_WO       = 1;
1395   
1396  * PIXCONO(z) is tautologically equal to 1, based on its formula
1397  * PIXCONO(z)      = SUM[i,PCO(i,z)*CO(i,z)]
1398  *                  /SUM[i,PCO(i,z)*CO(i,z)];
1399   PIXCONO(z)      = 1;
1400   PIXCONO_lag(z)  = PIXCONO(z);
1401   
1402  * PIXINVO(z) is tautologically equal to 1, based on its formula
1403  * PIXINVO(z)      = PROD[i$gamma_INV(i,z),(PCO(i,z)/PCO(i,z))**gamma_INV(i,z)];
1404   PIXINVO(z)      = 1;
1405   
1406  * PIXGVTO(z) is tautologically equal to 1, based on its formula
1407  * PIXGVTO(z)      = PROD[i$gamma_GVT(i,z),(PCO(i,z)/PCO(i,z))**gamma_GVT(i,z)];
1408   PIXGVTO(z)      = 1;
1409   
1410  *==============================================================================
1411  *  Calibration of function parameters
1412  *==============================================================================
1413  *   Leontief functions
1414  *==============================================================================
1415   io(j,z)         = CIO(j,z)/XSTO(j,z) ;
1416   
1417   io2(j,z)        = CEO(j,z)/XSTO(j,z) ;
1418   
1419   v(j,z)          = VAO(j,z)/XSTO(j,z) ;
1420   
1421   v2(j,z)         = (CEO(j,z)+VAO(j,z))/XSTO(j,z) ;
1422   
1423   aij(nene,j,z)   = DIO(nene,j,z)/CIO(j,z);
1424   
1425   aij2(ene,j,z)   = DEO(ene,j,z)/CEO(j,z);
1426   
1427   aij2_t(ene,j,z,time) =  aij2(ene,j,z);
1428   
1429  *==============================================================================
1430  *   Calibration of CET parameters
1431  *==============================================================================
1432  *    CET between total exports, domestic supply and margins
1433  *==============================================================================
1434   rho_X1(i,z)     = (1+sigma_X1(i,z))/sigma_X1(i,z);
1435   
1436   beta_EX_X1(i,z)$MRGNO(i,z)
1437                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1438                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1439                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1440                     eO(z)*PWMGO(i)*MRGNO(i,z)$MRGNO(i,z)**(1-rho_X1(i,z))];
1441   
1442   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1443                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1444                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1445                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1446   
1447   beta_D_X1(i,z)$MRGNO(i,z)
1448                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1449                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1450                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1451                     eO(z)*PWMGO(i)*MRGNO(i,z)**(1-rho_X1(i,z))];
1452   
1453   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1454                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1455                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1456                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1457   
1458   B_X1(i,z)       = XSO_I(i,z)/[beta_EX_X1(i,z)*EXTO(i,z)**rho_X1(i,z)
1459                    +beta_D_X1(i,z)*DSO_I(i,z)**rho_X1(i,z)+(1-beta_EX_X1(i,z)
1460                    -beta_D_X1(i,z))*MRGNO(i,z)**rho_X1(i,z)]**(1/rho_X1(i,z));
1461   
1462  *==============================================================================
1463  *    CET between exports to different trading partners
1464  *==============================================================================
1465   rho_X2(i,z)     = (1+sigma_X2(i,z))/sigma_X2(i,z);
1466   
1467   beta_X2(i,z,zj)$EXO(i,z,zj)
1468                   = [PEO(i,z,zj)*EXO(i,z,zj)**(1-rho_X2(i,z))]/
1469                     SUM[zjj$EXO(i,z,zjj),PEO(i,z,zjj)*EXO(i,z,zjj)
1470                     **(1-rho_X2(i,z))];
1471   
1472   B_X2(i,z)       = EXTO(i,z)/{SUM[zj,beta_X2(i,z,zj)*EXO(i,z,zj)**rho_X2(i,z)]
1473                     **(1/rho_X2(i,z))};
1474   
1475  *==============================================================================
1476  *   Calibration of CES parameters
1477  *==============================================================================
1478  *    Composite output
1479  *==============================================================================
1480   rho_X3(i,z)   = (1-sigma_X3(i,z))/sigma_X3(i,z);
1481   
1482   beta_X3(j,i,z)$XSO(j,i,z)
1483                 = [PO2(j,i,z)*XSO(j,i,z)**(1+rho_X3(i,z))]/
1484                     SUM[jj$XSO(jj,i,z),PO2(jj,i,z)*XSO(jj,i,z)**(1+rho_X3(i,z))];
1485   
1486   B_X3(i,z)     = XSO_I(i,z)
1487                    /SUM[jj$XSO(jj,i,z),beta_X3(jj,i,z)*XSO(jj,i,z)**(-rho_X3(i,z))
1488                    ]**(-1/rho_X3(i,z));
1489   
1490   POWERQO(Z) = SUM(POWER, XSO(power,'18_ELEC',z));
1491   
1492   rho_X4(z)   = (1-sigma_X4(z))/sigma_X4(z);
1493   
1494   beta_X4(power,z)
1495                 = [PO2(power,'18_ELEC',z)*XSO(power,'18_ELEC',z)**(1+rho_X4(z))]/
1496                     SUM[powerr$XSO(powerr,'18_ELEC',z),PO2(powerr,'18_ELEC',z)*XSO(powerr,'18_ELEC',z)**(1+rho_X4(z))];
1497   
1498   B_X4(z)     = POWERQO(Z)
1499                    /SUM[powerr$XSO(powerr,'18_ELEC',z),beta_X4(powerr,z)*XSO(powerr,'18_ELEC',z)**(-rho_X4(z))
1500                    ]**(-1/rho_X4(z));
1501   
1502   TnDShare(z) = XSO('18_TnD','18_ELEC',z)/XSO_I('18_ELEC',z);
1503   
1504   PPOWERO(z) = 1;
1505   
1506  *==============================================================================
1507  *    Composite good
1508  *==============================================================================
1509   rho_M1(i,z)     = (1-sigma_m1(i,z))/sigma_m1(i,z);
1510   
1511   beta_M1(i,z)    = PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)/
1512                    {PDO(i,z)*DDO(i,z)**(rho_M1(i,z)+1)
1513                    +PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)};
1514   
1515   B_M1(i,z)       = QO(i,z)/{beta_M1(i,z)*IMTO(i,z)**(-rho_M1(i,z))
1516                    +(1-beta_M1(i,z))*DDO(i,z)**(-rho_M1(i,z))}**(-1/rho_M1(i,z));
1517   
1518  *==============================================================================
1519  *   CES between imports from different trading partners
1520  *==============================================================================
1521   rho_M2(i,z)     = (1-sigma_M2(i,z))/sigma_M2(i,z);
1522   
1523   beta_M2(i,zj,z)$IMO(i,zj,z)
1524                   = [PMO(i,zj,z)*IMO(i,zj,z)**(rho_M2(i,z)+1)]/
1525                     SUM[zjj$IMO(i,zjj,z),PMO(i,zjj,z)*IMO(i,zjj,z)
1526                      **(rho_M2(i,z)+1)];
1527   
1528   B_M2(i,z)       = IMTO(i,z)/{SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*IMO(i,zj,z)
1529                     **(-rho_M2(i,z))]**(-1/rho_M2(i,z))};
1530   
1531  *==============================================================================
1532  *    Composite capital
1533  *==============================================================================
1534   rho_KD(j,z)     = (1-sigma_KD(j,z))/sigma_KD(j,z);
1535   
1536   beta_KD(k,j,z)$KDO(k,j,z)
1537                   = [RTIO(k,j,z)*KDO(k,j,z)**(1+rho_KD(j,z))]/
1538                     SUM[kj$KDO(kj,j,z),RTIO(kj,j,z)*KDO(kj,j,z)**(1+rho_KD(j,z))];
1539   B_KD(j,z)$KDCO(j,z)
1540                   = KDCO(j,z)/{SUM[k$KDO(k,j,z),beta_KD(k,j,z)*KDO(k,j,z)
1541                     **(-rho_KD(j,z))]**(-1/rho_KD(j,z))};
1542   
1543  *===============================================================================
1544  *   Composite E
1545  *===============================================================================
1546  *Leontief
1547   Share_Elec(j2,z) = DEO('18_ELEC',j2,z)/sum(ene,DEO(ene,j2,z));
1548   Share_nElec(ene3,j2,z) = DEO(ene3,j2,z)/sum(enee3,DEO(enee3,j2,z));
1549   Share_coalgas2(j2,z) = sum(ene5,DEO(ene5,j2,z))/sum(enee3,DEO(enee3,j2,z));
1550   Share_Oilpetrol2(j2,z) = sum(ene6,DEO(ene6,j2,z))/sum(enee3,DEO(enee3,j2,z));
1551   Share_coalgas(ene5,j2,z) = DEO(ene5,j2,z)/sum(enee5,DEO(enee5,j2,z));
1552   Share_Oilpetrol(ene6,j2,z) = DEO(ene6,j2,z)/sum(enee6,DEO(enee6,j2,z));
1553   
1554  *CES No Level
1555  * rho_ENER(j,z)   = (1-sigma_ENER(j,z))/sigma_ENER(j,z);
1556   
1557  * beta_ENER(ene,j,z)$DEO(ene,j,z)
1558  *                 = [PO4(ene,j,z)*DEO(ene,j,z)**(1+rho_ENER(j,z))]/
1559  *                   SUM[enee,PO4(enee,j,z)*DEO(enee,j,z)
1560  *                   **(1+rho_ENER(j,z))];
1561   
1562  * B_ENER(j,z)$CEO(j,z)
1563  *                 = CEO(j,z)/{SUM[ene,beta_ENER(ene,j,z)*DEO(ene,j,z)
1564  *                   **(-rho_ENER(j,z))]**(-1/rho_ENER(j,z))};
1565   
1566  *Level 5_1 (Coal/Gas)
1567   rho_ENER_coalgas(j2,z)   = (1-sigma_ENER_coalgas(j2,z))/sigma_ENER_coalgas(j2,z);
1568   
1569   beta_ENER_coalgas(ene5,j2,z)
1570                   = [PO4(ene5,j2,z)*DEO(ene5,j2,z)**(1+rho_ENER_coalgas(j2,z))]/
1571                     SUM[enee5,PO4(enee5,j2,z)*DEO(enee5,j2,z)
1572                     **(1+rho_ENER_coalgas(j2,z))];
1573   B_ENER_coalgas(j2,z)
1574                   = DEcoalgasO(j2,z)/{SUM[ene5,beta_ENER_coalgas(ene5,j2,z)*DEO(ene5,j2,z)
1575                     **(-rho_ENER_coalgas(j2,z))]**(-1/rho_ENER_coalgas(j2,z))};
1576   
1577  *Level 5_2 (oil/petrol)
1578   rho_ENER_oilprod(j2,z)   = (1-sigma_ENER_oilprod(j2,z))/sigma_ENER_oilprod(j2,z);
1579   
1580   beta_ENER_oilprod(ene6,j2,z)
1581                   = [PO4(ene6,j2,z)*DEO(ene6,j2,z)**(1+rho_ENER_oilprod(j2,z))]/
1582                     SUM[enee6,PO4(enee6,j2,z)*DEO(enee6,j2,z)
1583                     **(1+rho_ENER_oilprod(j2,z))];
1584   B_ENER_oilprod(j2,z)
1585                   = DEoilpetrolO(j2,z)/{SUM[ene6,beta_ENER_oilprod(ene6,j2,z)*DEO(ene6,j2,z)
1586                     **(-rho_ENER_oilprod(j2,z))]**(-1/rho_ENER_oilprod(j2,z))};
1587   
1588  *Level 4 (Coal-Gas/Oil-Petrol)
1589   rho_ENER_nelec(j2,z)   = (1-sigma_ENER_nelec(j2,z))/sigma_ENER_nelec(j2,z);
1590   
1591   beta_ENER_nelec(j2,z)
1592                   = PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)**(rho_ENER_nelec(j2,z)+1)/
1593                    {PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)**(rho_ENER_nelec(j2,z)+1)+
1594                     PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)**(rho_ENER_nelec(j2,z)+1)};
1595   B_ENER_nelec(j2,z)
1596                   = DEnelecO(j2,z)
1597                     /{[beta_ENER_nelec(j2,z)*DEcoalgasO(j2,z)**(-rho_ENER_nelec(j2,z))+
1598                     (1-beta_ENER_nelec(j2,z))*DEoilpetrolO(j2,z)**(-rho_ENER_nelec(j2,z))
1599                     ]**(-1/rho_ENER_nelec(j2,z))};
1600   
1601  *Level 3 (Coal/Gas/Oil/Petrol)
1602  * rho_ENER3(j2,z)   = (1-sigma_ENER3(j2,z))/sigma_ENER3(j2,z);
1603   
1604  * beta_ENER3(ene3,j2,z)
1605  *                 = [PO4(ene3,j2,z)*DEO(ene3,j2,z)**(1+rho_ENER3(j2,z))]/
1606  *                   SUM[enee3,PO4(enee3,j2,z)*DEO(enee3,j2,z)
1607  *                   **(1+rho_ENER3(j2,z))];
1608   
1609  * B_ENER3(j2,z)
1610  *                 = DEnelecO(j2,z)/{SUM[ene3,beta_ENER3(ene3,j2,z)*DEO(ene3,j2,z)
1611  *                   **(-rho_ENER3(j2,z))]**(-1/rho_ENER3(j2,z))};
1612   
1613  *Level 2 (Elec/Non Elec)
1614   rho_ENER_elec(j2,z)   = (1-sigma_ENER_elec(j2,z))/sigma_ENER_elec(j2,z);
1615   
1616   beta_ENER_elec(j2,z)
1617                   = PCEelecO(j2,z)*DEelecO(j2,z)**(rho_ENER_elec(j2,z)+1)/
1618                    {PCEelecO(j2,z)*DEelecO(j2,z)**(rho_ENER_elec(j2,z)+1)+
1619                     PCEnelecO(j2,z)*DEnelecO(j2,z)**(rho_ENER_elec(j2,z)+1)};
1620   B_ENER_elec(j2,z)
1621                   = CEO(j2,z)
1622                     /{[beta_ENER_elec(j2,z)*DEelecO(j2,z)**(-rho_ENER_elec(j2,z))+
1623                     (1-beta_ENER_elec(j2,z))*DEnelecO(j2,z)**(-rho_ENER_elec(j2,z))
1624                     ]**(-1/rho_ENER_elec(j2,z))};
1625   
1626  *==============================================================================
1627  *    4.6.3.5 Value added
1628  *==============================================================================
1629   rho_VA(j,z)     = (1-sigma_VA(j,z))/sigma_VA(j,z);
1630   
1631   beta_VA(j,z)$KDCO(j,z)
1632                   = WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)/
1633                    {WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)+
1634                     RCO(j,z)*KDCO(j,z)**(rho_VA(j,z)+1)};
1635   B_VA(j,z)$KDCO(j,z)
1636                   = VAO(j,z)
1637                     /{[beta_VA(j,z)*LDCO(j,z)**(-rho_VA(j,z))+
1638                     (1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
1639                     ]**(-1/rho_VA(j,z))};
1640   
1641   B_VA_t(j,z,time) = B_VA(j,z);
1642   
1643  *==============================================================================
1644  *    Composite KLE
1645  *==============================================================================
1646    KLEO(j,z)       = CEO(j,z) + VAO(j,z) ;
1647   
1648   PKLEO(j,z)      = [PCEO(j,z)*CEO(j,z)+PVAO(j,z)*VAO(j,z)]/KLEO(j,z);
1649   
1650   rho_KLE(j,z)    = (1-sigma_KLE(j,z))/sigma_KLE(j,z);
1651   
1652   beta_KLE(j,z)$KLEO(j,z)
1653                   = PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)/
1654                    {PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)+
1655                     PCEO(j,z)*CEO(j,z)**(rho_KLE(j,z)+1)};
1656   
1657   beta_KLE2(j,z)$KLEO(j,z)
1658                   = 1-beta_KLE(j,z);
1659   
1660   B_KLE(j,z)$KLEO(j,z)
1661                   = KLEO(j,z)
1662                     /{[beta_KLE(j,z)*VAO(j,z)**(-rho_KLE(j,z))+
1663                     (beta_KLE2(j,z))*CEO(j,z)**(-rho_KLE(j,z))
1664                     ]**(-1/rho_KLE(j,z))};
1665   
1666  *B_KLE(j,z)$KLEO(j,z)
1667  *                 = KLEO(j,z)
1668  *                   /{[beta_KLE(j,z)*(VAO(j,z)+EPS)**(-rho_KLE(j,z))+
1669  *                   (beta_KLE2(j,z))*(CEO(j,z)+EPS)**(-rho_KLE(j,z))
1670  *                   ]**(-1/rho_KLE(j,z))};
1671   
1672  *==============================================================================
1673  *  Calibration of LES parameters
1674  *==============================================================================
1675  *   As the assigned values of income elasticities may not result in
1676  *   consumption shares that add up to 1, this first step
1677  *   adjusts the elasticities proportionally
1678   sigma_Y(i,z)    = sigma_Y(i,z)/{SUM[ij,sigma_Y(ij,z)*PCO(ij,z)*CO(ij,z)]
1679                     /CTHO(z)};
1680   gamma_LES(i,z)  = PCO(i,z)*CO(i,z)*sigma_Y(i,z)/CTHO(z);
1681   CMINO(i,z)      = CO(i,z)+gamma_LES(i,z)*CTHO(z)/{PCO(i,z)*frisch(z)};
1682   
1683  *==============================================================================
1684  *  Calibration of gross domestic products
1685  *==============================================================================
1686   GDP_BPO(z)      = SUM[j,PVAO(j,z)*VAO(j,z)]+TIPTO(z);
1687   GDP_MPO(z)      = GDP_BPO(z)+TPRCTSO(z);
1688  * GDP_IBO(z)      = SUM[(l,j),WO(l,z)*LDO(l,j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1689   GDP_IBO(z)      = SUM[(j),WO(z)*LDO(j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1690                     +TPRODNO(z)+TPRCTSO(z);
1691   GDP_FDO(z)      = SUM[i,PCO(i,z)*(CO(i,z)+CGO(i,z)+INVO(i,z))]
1692                    +eO(z)*SUM[(i,zj),PWXO(i,z,zj)*EXO(i,z,zj)]
1693                    +eO(z)*SUM[i,PWMGO(i)*MRGNO(i,z)]
1694                    -eO(z)*SUM[(i,zj),IMO(i,zj,z)*(PWMO(i,zj,z)
1695                    +SUM{ij,PWMGO(ij)*tmrg(ij,i,zj,z)})];
1696   GDP_BP_WO       = SUM[z,GDP_BPO(z)/eO(z)];
1697   
1698  *==============================================================================
1699  *  4.8 Calibration of real (volume) variables computed from price indices
1700  *==============================================================================
1701   CABXO(z)        = CABO(z)/[PIXGDP_WO*eO(z)];
1702   
1703  *------------------------------------------------------------------------------
1704  * Calculation of CAB index
1705  * If every region's CABX grows exogenously according to exogro, then the
1706  * worldwide sum of CABX's will not be zero. If, due to redundancy, the reference
1707  * region's CABX is left implicit, then it will not grow according to that
1708  * region's exogro (it follows that the solution will depend on the choice of
1709  * reference region). CABix is formed from exogro by inflating or deflating the
1710  * updating factors of positive (SURplus) and negative (DEFicit) CABX's in such
1711  * a way that their sum remains zero.
1712   
1713  *$ontext
1714  Parameter CABXsur(z,time), CABXdef(z,time), bal(time), mu(time), CABix(z,time);
1715  * CABXsur(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) gt 0];
1716  * CABXdef(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) lt 0];
1717   
1718   CABXsur(z,t1) = CABXO(z)$[CABXO(z) gt 0];
1719   CABXdef(z,t1) = CABXO(z)$[CABXO(z) lt 0];
1720   
1721   CABXsur(z,time)$[ord(time) gt 1] = CABXO(z)*(1+g_GDP(z,time))$[CABXO(z) gt 0];
1722   CABXdef(z,time)$[ord(time) gt 1] = CABXO(z)*(1+g_GDP(z,time))$[CABXO(z) lt 0];
1723   
1724   Bal(time)           = sum(zj,CABXsur(zj,time))+sum(zj,CABXdef(zj,time));
1725   mu(time)           = sum(zj,CABXsur(zj,time))/
1726                          {sum(zj,CABXsur(zj,time))+sum(zj,abs[CABXdef(zj,time)])};
1727   CABXsur(z,time) = CABXsur(z,time)*{1-mu(time)*Bal(time)/sum(zj,CABXsur(zj,time))};
1728   CABXdef(z,time) = CABXdef(z,time)*{1-[1-mu(time)]*Bal(time)/sum(zj,CABXdef(zj,time))};
1729   CABix(z,time)     = [CABXsur(z,time)+CABXdef(z,time)]/CABXO(z);
1730  *$offtext
1731  *------------------------------------------------------------------------------
1732   
1733   CTH_REALO(z)    = CTHO(z)/PIXCONO(z);
1734   G_REALO(z)      = GO(z)/PIXGVTO(z);
1735   GDP_BP_REALO(z) = GDP_BPO(z)/PIXGDPO(z);
1736   GDP_BP_W_REALO  = GDP_BP_WO/PIXGDP_WO;
1737   GDP_MP_REALO(z) = GDP_MPO(z)/PIXCONO(z);
1738   IT_REALO(z)     = ITO(z)/PIXINVO(z);
1739   
1740  *==============================================================================
1741  *  Parameters of the household savings function
1742  *==============================================================================
1743   sh1O(z)         = [SHO(z)+SGO(z)]/GDP_IBO(z);
1744   sh0O(z)         = SHO(z)-sh1O(z)*YDHO(z);
1745   
1746  *==============================================================================
1747  *  Re-calibration of indexed transfers and parameters
1748  *==============================================================================
1749   sh0O(z)         = sh0O(z)/PIXCONO(z)**eta;
1750   ttdh0O(z)       = ttdh0O(z)/PIXCONO(z)**eta;
