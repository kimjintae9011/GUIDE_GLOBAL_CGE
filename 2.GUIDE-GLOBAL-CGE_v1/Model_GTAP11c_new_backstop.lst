 950  *===============================================================================
 951  * CES - composite capital
 952    sigma_KD(j,z)   = 2*sigma_VA(j,z);
 953  * sigma_KD(j,z)                  = 0.5;
 954  * sigma_KD('02_COAL',z)     = 0.2;
 955  * sigma_KD('03_OIL',z)        = 0.2;
 956  * sigma_KD('04_GAS',z)       = 0.2;
 957  * sigma_KD('05_MINING',z)  = 0.2;
 958   
 959  * CES - composite labor
 960   sigma_LD(j,z)   = 2*sigma_VA(j,z);
 961   
 962  * sigma_KLE(j,z) =0.5* sigma_KLE(j,z);
 963  *sigma_KLE(j,z)$(sigma_KLE(j,z) >= 0.5) = 0.8*sigma_KLE(j,z);
 964   
 965  * CES - composite K-L
 966  * sigma_VA('10_PETROLCOAL',z)  = 1.26;
 967   sigma_VA('18_TnD',z)         = 0.2;
 968   sigma_VA('19_eNuclear',z)   = 0.2;
 969   sigma_VA('20_eCoal',z)       = 0.2;
 970   sigma_VA('21_eGas',z)        = 0.2;
 971   sigma_VA('22_eOil',z)         = 0.2;
 972   sigma_VA('23_eWind',z)      = 0.2;
 973   sigma_VA('24_eSolar',z)      = 0.2;
 974   sigma_VA('25_eHydro',z)     = 0.2;
 975   sigma_VA('26_eOther',z)     = 0.2;
 976   
 977  * CES - composite ENER
 978  * sigma_ENER(j,z)              = 1.1 ;
 979  * sigma_ENER3(j2,z)           = 1.1 ;
 980   
 981   sigma_ENER_elec(j2,z)        = 2.0 ;
 982   sigma_ENER_nelec(j2,z)      = 2.0 ;
 983   sigma_ENER_coalgas(j2,z)   = 1.5 ;
 984   sigma_ENER_oilprod(j2,z)    = 0.5 ;
 985   
 986  *sigma_Y('18_ELEC',z) = 0.1*sigma_Y('18_ELEC',z);
 987   
 988  * CES - DOM vs.IMP
 989   sigma_M1('03_OIL','06_PRK') = 0.5;
 990   sigma_M1('04_GAS',Z) = 6;
 991   
 992  * CES - IMP sourcing
 993   sigma_M2('03_OIL',Z) = 2;
 994   sigma_M2('04_GAS',Z) = 2;
 995   
 996   sigma_X0(j,z)  = 1.5;
 997  * CET - total output
 998   sigma_X2(i,Z)  = 2;
 999   
1000  * CES - composite Power sector
1001  * sigma_X4(z)    = 4;
1002   sigma_X4(z)    = 2;
1003   
1004  * Investment demand elasticity
1005   sigma_INV(k,j,z) = 2;
1006  * sigma_INV(k,j,z) = 1.5;
1007   
1008  * LES parameters - Frisch all (1.1)
1009   frisch(z)  = PARZ(z,'frisch');
1010   
1011  * Labour supply
1012   elasLS(z) = 0.5 ;
1013   
