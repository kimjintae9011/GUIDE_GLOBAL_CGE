3766   DAC_TRIGGER   DAC trigger Price (100$ per tCO2)
3767   DAC_MAX Maximum DAC yearly
3768   DAC_growth_rate(z,time)
3769   DAC_Max_Pen(z)   Maximum Penetration
3770   DAC_Logistic_Coeff(z)  Logistic Growth Rate
3771   DAC_Inflection(z)  Inflection Lapse
3772   DAC_Start_Year(z)  First Triggered Year
3773   DAC_Tech_Coeff(i)
3774   switchDAC(z,time)  binary parameter
3775   ;
3776   
3777  Scalar DAC_Unit_Scale 100MilliontCO2 to tCO2 / 100000000 /;
3778  Scalar DAC_Elec_Intensity MWh needed per ton CO2 / 2.5 /;
3779  Scalar Price_USD_MWh USD per MWh / 107.14 /;
3780   
3781   DAC_TRIGGER = 5.0;
3782   DAC_MAX = 2.0;
3783   DAC_growth_rate(z,time) = 0 ;
3784   DAC_Max_Pen(z)         = 1.0 ;
3785   DAC_Logistic_Coeff(z)  = 0.3 ;
3786   DAC_Inflection(z) = 15 ;
3787   DAC_Start_Year(z) = 0 ;
3788   DAC_Tech_Coeff('18_ELEC') = (DAC_Unit_Scale * DAC_Elec_Intensity * Price_USD_MWh)/10**10 ;
3789   switchDAC(z,time)  = 0 ;
