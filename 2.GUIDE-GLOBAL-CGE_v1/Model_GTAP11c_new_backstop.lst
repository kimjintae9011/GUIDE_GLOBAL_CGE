3758   TIWO_Share(j,z)    =   LDO(j,z)/LSO(z);
3759   TIKO_Share(k,j,z)   =  KDO(k,j,z)/KSO(k,z);
3760   TIPO_Share(j,z)     =  XSTO(j,z)/sum(jj,XSTO(jj,z));
