4238  *==============================================================================
4239  *  5.3 Equations
4240  *==============================================================================
4241  *   5.3.1 Production
4242  *==============================================================================
4243   EQ1(j3,z,t)..     VA(j3,z,t) =e= v(j3,z)*XST(j3,z,t);
4244   
4245   EQ1_1(j2,z,t)..   KLE(j2,z,t) =e= v2(j2,z)*XST(j2,z,t);
4246   
4247   EQ2(j,z,t)..      CI(j,z,t) =e= io(j,z)*XST(j,z,t);
4248   
4249   EQ2_1(j3,z,t)..   CE(j3,z,t) =e= io2(j3,z)*XST(j3,z,t);
4250   
4251   EQ3(j,z,t)..      VA(j,z,t) =e= A_VA(z,t)*B_VA_t(j,z,t)*{
4252                      [beta_VA(j,z)*LDC(j,z,t)**(-rho_VA(j,z))]$LDCO(j,z)
4253                     +[(1-beta_VA(j,z))*KDC(j,z,t)**(-rho_VA(j,z))]$KDCO(j,z)
4254                                                     }**(-1/rho_VA(j,z));
4255   
4256   EQ3_1(j2,z,t)..   KLE(j2,z,t) =e= B_KLE(j2,z)*{
4257                      [beta_KLE(j2,z)*VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
4258                     +[(1-beta_KLE(j2,z))*CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
4259                                                     }**(-1/rho_KLE(j2,z));
4260   
4261   EQ4_1(j2,z,t)$[VAO(j2,z) and CEO(j2,z)]..
4262                   VA(j2,z,t) =e= {[(1-beta_KLE2(j2,z))/(beta_KLE2(j2,z))]
4263                                *[PCE(j2,z,t)/PVA(j2,z,t)]}**sigma_KLE(j2,z)*CE(j2,z,t);
4264   
4265   EQ4(j,z,t)$[LDCO(j,z) and KDCO(j,z)]..
4266                   LDC(j,z,t) =e= {[beta_VA(j,z)/(1-beta_VA(j,z))]
4267                                *[RC(j,z,t)/WC(j,z,t)]}**sigma_VA(j,z)*KDC(j,z,t);
4268   
4269   EQ5(j,z,t)$LDCO(j,z)..
4270                   LDC(j,z,t) =e= LD(j,z,t);
4271   
4272   EQ7(j,z,t)$KDCO(j,z)..
4273                   KDC(j,z,t) =e= B_KD(j,z)*SUM[k$KDO(k,j,z),beta_KD(k,j,z)
4274                                  *KD(k,j,z,t)**(-rho_KD(j,z))]**(-1/rho_KD(j,z));
4275   
4276   EQ8(k,j,z,t)$KDO(k,j,z)..
4277                    KD(k,j,z,t) =e= [beta_KD(k,j,z)*RC(j,z,t)/RTI(k,j,z,t)]**sigma_KD(j,z)*B_KD(j,z)**(sigma_KD(j,z)-1)
4278                      * (KDC(j,z,t) );
4279   
4280   EQ9(nene,j,z,t)..   DI(nene,j,z,t) =e= aij(nene,j,z)*CI(j,z,t) ;
4281   
4282  * EQ9_1(ene,j3,z,t)..  DE(ene,j3,z,t)   =e= aij2(ene,j3,z)*CE(j3,z,t)*AEEI(z,t) ;
4283   EQ9_1(ene,j3,z,t)..  DE(ene,j3,z,t)   =e= aij2_t(ene,j3,z,t)*CE(j3,z,t)*AEEI(z,t) ;
4284   
4285  *=============================Simple Nesting=========================================
4286  * EQ9_2(ene,j2,z,t)..  DE(ene,j2,z,t) =e= [beta_ENER_t(ene,j2,z,t)*PCE(j2,z,t)/((P4(ene,j2,z,t)+P4(ene,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j2,z,t)))]
4287  *                                   **sigma_ENER(j2,z)*B_ENER_t(j2,z,t)**(sigma_ENER(j2,z)-1)
4288  *                                   *CE(j2,z,t);
4289   
4290  *=============================Leontief===========================================
4291  * EQ9_2(j2,z,t)..       DEelec(j2,z,t)  =e= Share_Elec(j2,z)*CE(j2,z,t);
4292   
4293  * EQ9_3(j2,z,t)..       DEnelec(j2,z,t) =e= (1-Share_Elec(j2,z))*CE(j2,z,t);
4294   
4295  * EQ9_4(ene3,j2,z,t)..  DE(ene3,j2,z,t) =e= Share_nElec(ene3,j2,z)*DEnelec(j2,z,t);
4296   
4297  * EQ9_5(ene2,j2,z,t)..  DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
4298   
4299  *=============================Level 1, 2=======================================
4300  * EQ9_2(j2,z,t)..       CE(j2,z,t)  =e= B_ENER2(j2,z)*{[(beta_ENER2(j2,z))*DEelec(j2,z,t)**(-rho_ENER2(j2,z))]
4301  *                                                     +[(1-beta_ENER2(j2,z))*DEnelec(j2,z,t)**(-rho_ENER2(j2,z))]
4302  *                                                   }**(-1/rho_ENER2(j2,z));
4303   
4304  * EQ9_3(j2,z,t)..       DEelec(j2,z,t) =e= {[(beta_ENER2(j2,z))/(1-beta_ENER2(j2,z))]
4305  *                                        *[PCEnelec(j2,z,t)/PCEelec(j2,z,t)]}**sigma_ENER2(j2,z)*DEnelec(j2,z,t);
4306   
4307  * EQ9_4(ene3,j2,z,t)..  DE(ene3,j2,z,t) =e= [beta_ENER3(ene3,j2,z)*PCEnelec(j2,z,t)/P4(ene3,j2,z,t)]
4308  *                                            **sigma_ENER3(j2,z)*B_ENER3(j2,z)**(sigma_ENER3(j2,z)-1)
4309  *                                            *DEnelec(j2,z,t);
4310   
4311  * EQ9_5(ene2,j2,z,t)..  DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
4312   
4313  *=============================Level 1, 2, 3 (Leonteif) =======================================
4314  * EQ9_2(j2,z,t)..        DEelec(j2,z,t)  =e= Share_Elec(j2,z)*CE(j2,z,t);
4315   
4316  * EQ9_3(j2,z,t)..        DEnelec(j2,z,t) =e= (1-Share_Elec(j2,z))*CE(j2,z,t);
4317   
4318  * EQ9_4(j2,z,t)..        DEcoalgas(j2,z,t) =e= Share_coalgas2(j2,z)*DEnelec(j2,z,t);
4319   
4320  * EQ9_5(j2,z,t)..        DEoilpetrol(j2,z,t) =e= (1-Share_coalgas2(j2,z))*DEnelec(j2,z,t);
4321   
4322  * EQ9_6(ene2,j2,z,t)..   DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
4323   
4324  * EQ9_7(ene5,j2,z,t)..   DE(ene5,j2,z,t) =e= Share_coalgas(ene5,j2,z)*DEcoalgas(j2,z,t);
4325   
4326  * EQ9_8(ene6,j2,z,t)..   DE(ene6,j2,z,t) =e= Share_oilpetrol(ene6,j2,z)*DEoilpetrol(j2,z,t);
4327   
4328  *=============================Level 1, 2, 3 (CES) =======================================
4329   EQ9_2(j2,z,t)..        CE(j2,z,t)  =e= B_ENER_elec(j2,z)*{[(beta_ENER_elec(j2,z))*DEelec(j2,z,t)**(-rho_ENER_elec(j2,z))]
4330                                             +[(1-beta_ENER_elec(j2,z))*DEnelec(j2,z,t)**(-rho_ENER_elec(j2,z))]
4331                                              }**(-1/rho_ENER_elec(j2,z));
4332   
4333   EQ9_3(j2,z,t)..        DEnelec(j2,z,t) =e= {[(1-beta_ENER_elec(j2,z))/(beta_ENER_elec(j2,z))]
4334                                          *[PCEelec(j2,z,t)/PCEnelec(j2,z,t)]}**sigma_ENER_elec(j2,z)*DEelec(j2,z,t);
4335   
4336   EQ9_4(j2,z,t)..        DEnelec(j2,z,t) =e= B_ENER_nelec(j2,z)*{[(beta_ENER_nelec(j2,z))*DEcoalgas(j2,z,t)**(-rho_ENER_nelec(j2,z))]
4337                                             +[(1-beta_ENER_nelec(j2,z))*DEoilpetrol(j2,z,t)**(-rho_ENER_nelec(j2,z))]
4338                                              }**(-1/rho_ENER_nelec(j2,z));
4339   
4340   EQ9_5(j2,z,t)..        DEoilpetrol(j2,z,t) =e= {[(1-beta_ENER_nelec(j2,z))/(beta_ENER_nelec(j2,z))]
4341                                         *[PCEcoalgas(j2,z,t)/PCEoilpetrol(j2,z,t)]}**sigma_ENER_nelec(j2,z)*DEcoalgas(j2,z,t);
4342   
4343   EQ9_6(ene2,j2,z,t)..   DE(ene2,j2,z,t) =e= DEelec(j2,z,t)*AEEI(z,t) ;
4344   
4345   EQ9_7(ene5,j2,z,t)..   DE(ene5,j2,z,t) =e= [beta_ENER_coalgas(ene5,j2,z)*PCEcoalgas(j2,z,t)/(P4(ene5,j2,z,t)+P4(ene5,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene5,j2,z,t))]
4346                                              **sigma_ENER_coalgas(j2,z)*B_ENER_coalgas(j2,z)**(sigma_ENER_coalgas(j2,z)-1)
4347                                              *DEcoalgas(j2,z,t)*AEEI(z,t);
4348   
4349   EQ9_8(ene6,j2,z,t)..   DE(ene6,j2,z,t) =e= [beta_ENER_oilprod(ene6,j2,z)*PCEoilpetrol(j2,z,t)/(P4(ene6,j2,z,t)+P4(ene6,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene6,j2,z,t))]
4350                                              **sigma_ENER_oilprod(j2,z)*B_ENER_oilprod(j2,z)**(sigma_ENER_oilprod(j2,z)-1)
4351                                              *DEoilpetrol(j2,z,t)*AEEI(z,t);
4352   
4353  *==============================================================================
4354  *   5.3.2 Income and savings
4355  *==============================================================================
4356  *    5.3.2.1 Households
4357  *==============================================================================
4358   EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t)+sum(i3,MARKUP(i3,z,t))+REBATE(z,t)*recycle_hou(z,t) ;
4359   
4360   EQ11(z,t)..       YHL(z,t) =e= SUM[(j)$LDO(j,z),W(z,t)*(LD(j,z,t)+LBS(j,z,t))];
4361   
4362   EQ12(z,t)..       YHK(z,t) =e= SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*(KD(k,j,z,t)+KBS(k,j,z,t))];
4363   
4364   EQ13(z,t)..       YDH(z,t) =e= YH(z,t)-TDH(z,t);
4365   
4366   EQ14(z,t)..       CTH(z,t) =e= YDH(z,t)-SH(z,t);
4367   
4368   EQ15(z,t)..       SH(z,t) =e= PIXCON(z,t)**eta*sh0(z,t)+sh1(z,t)*YDH(z,t);
4369   
4370  *==============================================================================
4371  *    5.3.2.2 Government
4372  *==============================================================================
4373   EQ16(z,t)..       YG(z,t) =e= TDH(z,t)+TPRODN(z,t)+TPRCTS(z,t)+REBATE(z,t)*recycle_gov(z,t)-sum(i1,PC(i1,z,t)*Q_DAC(z,t)*DAC_Tech_Coeff(i1));
4374   
4375   EQ16_1(z,t)..    TCTAX(z,t) =e= sum((ene,j), PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t));
4376   
4377   EQ17(z,t)..       TPRODN(z,t) =e= TIWT(z,t)+TIKT(z,t)+TIPT(z,t);
4378   
4379   EQ18(z,t)..       TIWT(z,t) =e= SUM[(j)$LDO(j,z),TIW(j,z,t)];
4380   
4381   EQ19(z,t)..       TIKT(z,t) =e= SUM[(k,j)$KDO(k,j,z),TIK(k,j,z,t)];
4382   
4383   EQ20(z,t)..       TIPT(z,t) =e= SUM[j,TIP(j,z,t)];
4384   
4385   EQ21(z,t)..       TPRCTS(z,t) =e= TICT(z,t)+TIMT(z,t)+TIXT(z,t);
4386   
4387   EQ22(z,t)..       TICT(z,t) =e= SUM[i,TIC(i,z,t)];
4388   
4389   EQ23(z,t)..       TIMT(z,t) =e= SUM[(i,zj)$IMO(i,zj,z),TIM(i,zj,z,t)];
4390   
4391   EQ24(z,t)..       TIXT(z,t) =e= SUM[(i,zj)$EXO(i,z,zj),TIX(i,z,zj,t)];
4392   
4393   EQ25(z,t)..       TDH(z,t) =e= PIXCON(z,t)**eta*ttdh0(z,t)+ttdh1(z,t)*YH(z,t);
4394   
4395   EQ26(j,z,t)$LDO(j,z)..
4396                          TIW(j,z,t) =e= ttiw(j,z,t)*W(z,t)*(LD(j,z,t)) -LaborRebate(j,z,t);
4397   
4398   EQ27(k,j,z,t)$KDO(k,j,z)..
4399                          TIK(k,j,z,t) =e= ttik(k,j,z,t)*R(k,j,z,t)*(KD(k,j,z,t));
4400   
4401   EQ28(j,z,t)..     TIP(j,z,t) =e= ttip(j,z,t)*PP(j,z,t)*XST(j,z,t);
4402   
4403   EQ29(i,z,t)..     TIC(i,z,t) =e= ttic(i,z,t)*{[PL(i,z,t)*DD(i,z,t)]$DDO(i,z)
4404                   +[SUM[zj$IMO(i,zj,z),(1+ttim(i,zj,z,t))*IM(i,zj,z,t)*e(z,t)
4405                    *(PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z)))]]};
4406   
4407   EQ30(i,zj,z,t)$IMO(i,zj,z)..
4408                   TIM(i,zj,z,t) =e= ttim(i,zj,z,t)*IM(i,zj,z,t)*e(z,t)*
4409                                     (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
4410                                     *tmrg(ij,i,zj,z)]);
4411   
4412   EQ31(i,z,zj,t)$EXO(i,z,zj)..
4413                   TIX(i,z,zj,t) =e= ttix(i,z,zj,t)*PE(i,z,zj,t)*EX(i,z,zj,t);
4414   
4415   EQ32(z,t)..       SG(z,t) =e= YG(z,t)-G(z,t);
4416   
4417  *==============================================================================
4418  *    5.3.2.4 Rest of the world
4419  *==============================================================================
4420   EQ33(z,t)..       YROW(z,t) =e= e(z,t)*SUM{(i,zj)$IMO(i,zj,z),IM(i,zj,z,t)*
4421                             [PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z))]};
4422   
4423   EQ34(z,t)..       SROW(z,t) =e= YROW(z,t)-e(z,t)*SUM[(i,zj)$EXO(i,z,zj),
4424                                 EX(i,z,zj,t)*PWX(i,z,zj,t)]-e(z,t)
4425                                 *SUM[i$MRGNO(i,z),MRGN(i,z,t)*PWMG(i,t)];
4426   
4427   EQ35(z,t)..       SROW(z,t) =e= -CAB(z,t);
4428   
4429  *==============================================================================
4430  *   5.3.3 Demand
4431  *==============================================================================
4432   EQ36(i,z,t)..  PC(i,z,t)*C(i,z,t) =e= PC(i,z,t) * (CMIN(i,z,t))
4433                         + gamma_LES(i,z) * {CTH(z,t) - SUM[ij, PC(ij,z,t) * (CMIN(ij,z,t) )]};
4434   
4435   EQ37(i,z,t)..     PC(i,z,t)*INV(i,z,t) =e= gamma_INV(i,z)*IT(z,t);
4436   
4437   EQ38(i,z,t)..     PC(i,z,t)*CG(i,z,t) =e= gamma_GVT(i,z)*G(z,t);
4438   
4439   EQ39(nene,z,t)..    DIT(nene,z,t) =e= SUM[j,DI(nene,j,z,t)];
4440   
4441   EQ39_1(ene1,z,t)..  DIT(ene1,z,t) =e= SUM[j,DE(ene1,j,z,t)];
4442   
4443  * EQ39_2(ene2,z,t)..  DIT(ene2,z,t) =e= SUM[j,DE(ene2,j,z,t)]+SUM[j, EBS(j,z,t)];
4444   EQ39_2(ene2,z,t)..  DIT(ene2,z,t) =e= SUM[j,DE(ene2,j,z,t)];
4445   
4446  *==============================================================================
4447  *   5.3.4 International trade
4448  *==============================================================================
       EQB_1(i,z)..    XS_I(i,z) =e= B_X3(i,z)*SUM[j$XSO(j,i,z),beta_X3(j,i,z)
                                      *XS(j,i,z)**(-rho_X3(i,z))]**(-1/rho_X3(i,z));
       
       EQB_2(j,i,z)${DSO(j,i,z) and [DSO(j,i,z) ne DSO_I(i,z)]}..
                       XS(j,i,z) =e= XS_I(i,z)/B_X3(i,z)**(1-sigma_X3(i,z))*
                                     [beta_X3(j,i,z)*PI(i,z)/P2(j,i,z)]
                                     **sigma_X3(i,z);
       
       EQB_3(j,i,z)${DSO(j,i,z)}..   P2(j,i,z) =e= PT(j,z);
       
       EQB_4(j,i,z)$DSO(j,i,z)..
                       P2(j,i,z)*XS(j,i,z) =e= [PET(i,z)*EXTT(j,i,z)]$EXTTO(j,i,z)
                                              +[e(z)*MRGN(i,z)*PWMG(i)]$MRGNO(i,z)
                                              +[PL(i,z)*DS(j,i,z)]$DSO(j,i,z);
       
       EQB_5(j,i,z)$DSO(j,i,z)..  EXTT(j,i,z)  =e= theta2(j,i,z)*EXT(i,z);
4467   
4468  *[Top Nest - Leontief function]
4469   EQA_1(z,t)..  XS('18_TnD','18_ELEC',z,t) =e= TnDShare(z)*XS_I('18_ELEC',z,t);
4470   EQA_2(z,t)..  XS_I('18_ELEC',z,t) =e= XS('18_TnD','18_ELEC',z,t) + POWERQ(z,t);
4471   
4472  *[Second Nest - CES function]
4473  * EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
4474  *                                *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
4475   EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
4476                                  *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
4477   
4478  * EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
4479  *                               [beta_X4(power,z)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
4480  *                               **sigma_X4(z);
4481   
4482   EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
4483                                 [beta_X4(power,z)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
4484                                 **sigma_X4(z);
4485   
4486  * exclude electiricity
4487   EQB_1(i2,z,t)..    XS_I(i2,z,t) =e= B_X3(i2,z)*SUM[j$XSO(j,i2,z),beta_X3(j,i2,z)
4488                                  *XS(j,i2,z,t)**(-rho_X3(i2,z))]**(-1/rho_X3(i2,z));
4489   
4490   EQB_3(j,i,z,t)${DSO(j,i,z)}..   P2(j,i,z,t) =e= PT(j,z,t);
4491   
4492   EQB_4(j,i,z,t)$DSO(j,i,z)..
4493                   P2(j,i,z,t)*XS(j,i,z,t) =e= [PET(i,z,t)*EXTT(j,i,z,t)]$EXTTO(j,i,z)
4494                                          +[e(z,t)*MRGN(i,z,t)*PWMG(i,t)]$MRGNO(i,z)
4495                                          +[PL(i,z,t)*DS(j,i,z,t)]$DSO(j,i,z);
4496   
4497   EQB_5(j,i,z,t)$DSO(j,i,z)..  EXTT(j,i,z,t)  =e= theta2(j,i,z)*EXT(i,z,t);
4498   
4499   EQ40_3(i,z,t)..   DS_I(i,z,t) =e= sum(j,DS(j,i,z,t)$DSO(j,i,z));
4500   
4501   EQ40_4(j,z,t)..   XST(j,z,t)  =e= sum(i,XS(j,i,z,t)$XSO(j,i,z)) ;
4502   
4503   EQ40_5(i,z,t)..   XS_I(i,z,t) =e= B_X1(i,z)*{
4504  * EQ40_5(i,z,t)..   XS_I2(i,z,t) =e= B_X1(i,z)*{
4505                   [beta_EX_X1(i,z)*EXT(i,z,t)**rho_X1(i,z)]$EXTO(i,z)
4506                  +[beta_D_X1(i,z)*DS_I(i,z,t)**rho_X1(i,z)]$DSO_I(i,z)
4507                  +[(1-beta_EX_X1(i,z)-beta_D_X1(i,z))*MRGN(i,z,t)**rho_X1(i,z)]$MRGNO(i,z)
4508                                            }**(1/rho_X1(i,z));
4509   
4510   EQ41(i,z,t)$[EXTO(i,z) and DSO_I(i,z)]..
4511                   EXT(i,z,t) =e= {[beta_D_X1(i,z)/beta_EX_X1(i,z)]*[PET(i,z,t)/PL(i,z,t)]}
4512                                **sigma_X1(i,z)*DS_I(i,z,t);
4513   
4514   EQ42(i,z,t)$[MRGNO(i,z) and DSO_I(i,z)]..
4515                   MRGN(i,z,t) =e= {[beta_D_X1(i,z)/(1-beta_EX_X1(i,z)
4516                                   -beta_D_X1(i,z))]*[e(z,t)*PWMG(i,t)/PL(i,z,t)]}
4517                                   **sigma_X1(i,z)*DS_I(i,z,t);
4518   
4519   EQ43(i,z,t)$EXTO(i,z)..
4520                   EXT(i,z,t) =e= B_X2(i,z)*SUM[zj$EXO(i,z,zj),beta_X2(i,z,zj)
4521                                  *EX(i,z,zj,t)**rho_X2(i,z)]**(1/rho_X2(i,z));
4522   
4523   EQ44(i,z,zj,t)$EXO(i,z,zj)..
4524                   EX(i,z,zj,t) =e= EXT(i,z,t)/B_X2(i,z)**(1+sigma_X2(i,z))*
4525                                    [PE(i,z,zj,t)/(beta_X2(i,z,zj)*PET(i,z,t))]
4526                                    **sigma_X2(i,z);
4527   
4528   EQ45(i,z,t)..     Q(i,z,t) =e= B_M1(i,z)*{
4529                      [beta_M1(i,z)*IMT(i,z,t)**(-rho_M1(i,z))]$IMTO(i,z)
4530                     +[(1-beta_M1(i,z))*DD(i,z,t)**(-rho_M1(i,z))]$DDO(i,z)
4531                                          }**(-1/rho_M1(i,z));
4532   
4533   EQ46(i,z,t)$[IMTO(i,z) and DDO(i,z)]..
4534                   IMT(i,z,t) =e= {[beta_M1(i,z)/(1-beta_M1(i,z))]*[PD(i,z,t)
4535                                  /PMT(i,z,t)]}**sigma_m1(i,z)*DD(i,z,t);
4536   
4537   EQ47(i,z,t)$IMTO(i,z)..
4538                   IMT(i,z,t) =e= B_M2(i,z)*SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*
4539                                  IM(i,zj,z,t)**(-rho_M2(i,z))]**(-1/rho_M2(i,z));
4540   
4541   EQ48(i,zj,z,t)$IMO(i,zj,z)..
4542                   IM(i,zj,z,t) =e= IMT(i,z,t)/B_M2(i,z)**(1-sigma_M2(i,z))*
4543                                    [beta_M2(i,zj,z)*PMT(i,z,t)/PM(i,zj,z,t)]
4544                                    **sigma_M2(i,z);
4545   
4546  *==============================================================================
4547  *   5.3.5 Prices
4548  *==============================================================================
4549   EQ49(j2,z,t)..       PP(j2,z,t)*XST(j2,z,t) =e= PKLE(j2,z,t)*KLE(j2,z,t)+PCI(j2,z,t)*CI(j2,z,t);
4550   
4551   EQ49_1(j3,z,t)..    PP(j3,z,t)*XST(j3,z,t) =e= PVA(j3,z,t)*VA(j3,z,t)+PCI(j3,z,t)*CI(j3,z,t)+PCE(j3,z,t)*CE(j3,z,t);
4552   
4553   EQ50(j,z,t)..        PT(j,z,t) =e= (1+ttip(j,z,t))*PP(j,z,t);
4554   
4555   EQ51(j,z,t)..        PCI(j,z,t)*CI(j,z,t) =e= SUM[nene,PC(nene,z,t)*DI(nene,j,z,t)];
4556   
4557  *Simple Nesting
4558  * EQ51_1(j,z,t)..    PCE(j,z,t)*CE(j,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j,z,t) + PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t)];
4559   
4560  *============================== Level 1-3 ========================================
4561  * EQ51_1(j2,z,t)..   PCE(j2,z,t)*CE(j2,z,t) =e= [PCEelec(j2,z,t)*DEelec(j2,z,t)+PCEnelec(j2,z,t)*DEnelec(j2,z,t)];
4562   
4563  * EQ51_12(j3,z,t)..  PCE(j3,z,t)*CE(j3,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j3,z,t)+PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j3,z,t)*DE(ene,j3,z,t)];
4564   
4565  * EQ51_2(j2,z,t)..   PCEelec(j2,z,t)*DEelec(j2,z,t) =e= PC("18_ELEC",z,t)*DE("18_ELEC",j2,z,t);
4566   
4567  * EQ51_3(j2,z,t)..   PCEnelec(j2,z,t)*DEnelec(j2,z,t) =e= SUM[ene3,PC(ene3,z,t)*DE(ene3,j2,z,t)+PC(ene3,z,t)*CTAX(z,t)*CO2FACTOR2(ene3,j2,z,t)*DE(ene3,j2,z,t)];
4568   
4569  *================================= Level 1-5 ======================================
4570   EQ51_2(j3,z,t)..   PCE(j3,z,t)*CE(j3,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j3,z,t)+PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j3,z,t)*DE(ene,j3,z,t)];
4571   
4572   EQ51_1(j2,z,t)..   PCE(j2,z,t)*CE(j2,z,t) =e= [PCEelec(j2,z,t)*DEelec(j2,z,t)+PCEnelec(j2,z,t)*DEnelec(j2,z,t)];
4573   
4574   EQ51_3(j2,z,t)..   PCEelec(j2,z,t)*DEelec(j2,z,t) =e= PC("18_ELEC",z,t)*{DE("18_ELEC",j2,z,t)};
4575   
4576   EQ51_4(j2,z,t)..   PCEnelec(j2,z,t)*DEnelec(j2,z,t) =e= [PCEcoalgas(j2,z,t)*DEcoalgas(j2,z,t)+PCEoilpetrol(j2,z,t)*DEoilpetrol(j2,z,t)];
4577   
4578   EQ51_5(j2,z,t)..   PCEcoalgas(j2,z,t)*DEcoalgas(j2,z,t) =e= [PC("02_COAL",z,t)*DE("02_COAL",j2,z,t)+PC("02_COAL",z,t)*CTAX(z,t)*CO2FACTOR2("02_COAL",j2,z,t)*DE("02_COAL",j2,z,t)
4579                      +PC("04_GAS",z,t)*DE("04_GAS",j2,z,t)+PC("04_GAS",z,t)*CTAX(z,t)*CO2FACTOR2("04_GAS",j2,z,t)*DE("04_GAS",j2,z,t)];
4580   
4581   EQ51_6(j2,z,t)..   PCEoilpetrol(j2,z,t)*DEoilpetrol(j2,z,t) =e= [PC("03_OIL",z,t)*DE("03_OIL",j2,z,t)+PC("03_OIL",z,t)*CTAX(z,t)*CO2FACTOR2("03_OIL",j2,z,t)*DE("03_OIL",j2,z,t)
4582                      +PC("10_PETROLCOAL",z,t)*DE("10_PETROLCOAL",j2,z,t)+PC("10_PETROLCOAL",z,t)*CTAX(z,t)*CO2FACTOR2("10_PETROLCOAL",j2,z,t)*DE("10_PETROLCOAL",j2,z,t)];
4583   
4584  *==================================================================================
4585   EQ52(j,z,t)..      PVA(j,z,t)*VA(j,z,t) =e= [WC(j,z,t)*LDC(j,z,t)]$LDCO(j,z)
4586                                       +[RC(j,z,t)*KDC(j,z,t)]$KDCO(j,z);
4587   
4588   EQ52_1(j2,z,t)..   PKLE(j2,z,t)*KLE(j2,z,t) =e= [PVA(j2,z,t)*VA(j2,z,t)]$VAO(j2,z)
4589                                         +[PCE(j2,z,t)*CE(j2,z,t)]$CEO(j2,z);
4590   
4591  * Given equations 5 and 6, equation 53 is redundant
4592  * EQ53(j,z)..     WC(j,z)*LDC(j,z) =e= SUM[l$LDO(l,j,z),WTI(l,j,z)*LD(l,j,z)];
4593   EQ53(j,z,t)..     WC(j,z,t)*LDC(j,z,t) =e= WTI(j,z,t)*(LD(j,z,t));
4594   
4595   EQ54(j,z,t)$LDO(j,z)..
4596                   WTI(j,z,t)*LD(j,z,t) =e= W(z,t)*(1+ttiw(j,z,t))*LD(j,z,t) -LaborRebate(j,z,t);
4597   
4598   EQ54_1(ene,j2,z,t)$DEO(ene,j2,z)..
4599                   P4(ene,j2,z,t) =e= PC(ene,z,t);
4600   
4601  * Given equations 7 and 8, equation 55 is redundant
4602  * EQ55(j,z)$(kmob and KDCO(j,z))..
4603  *                 RC(j,z)*KDC(j,z) =e= SUM[k$KDO(k,j,z),RTI(k,j,z)*KD(k,j,z)];
4604   
4605  * EQ55(j,z,t)$KDCO(j,z)..
4606  *                RC(j,z,t)*KDC(j,z,t) =e= SUM[k$KDO(k,j,z),RTI(k,j,z,t)*(KD(k,j,z,t)+KBS(k,j,z,t))];
4607   
4608   EQ56(k,j,z,t)$KDO(k,j,z)..
4609                   RTI(k,j,z,t) =e= R(k,j,z,t)*(1+ttik(k,j,z,t));
4610   
4611  * EQ57(k,j,z,t)$(kmob and KDO(k,j,z))..
4612  *                 R(k,j,z,t) =e= RK(k,z,t);
4613   
4614   EQ58(i,z,t)..     P(i,z,t)*XS_I(i,z,t)=e= [PL(i,z,t)*DS_I(i,z,t)]$DSO_I(i,z)
4615                                       +[PET(i,z,t)*EXT(i,z,t)]$EXTO(i,z)
4616                                       +[e(z,t)*PWMG(i,t)*MRGN(i,z,t)]$MRGNO(i,z);
4617   
4618  * Given equations 43 and 44, equation 59 is redundant
4619  * EQ59(i,z)$EXTO(i,z)..
4620  *                 PET(i,z)*EXT(i,z) =e= SUM[zj$EXO(i,z,zj),
4621  *                                           PE(i,z,zj)*EX(i,z,zj);
4622   
4623   EQ60(i,z,zj,t)$EXO(i,z,zj)..
4624                   PE(i,z,zj,t)*(1+ttix(i,z,zj,t)) =e= e(z,t)*PWX(i,z,zj,t);
4625   
4626   EQ61(i,z,t)$DDO(i,z)..
4627                   PD(i,z,t) =e= (1+ttic(i,z,t))*PL(i,z,t);
4628   
4629   EQ62(i,zj,z,t)$IMO(i,zj,z)..
4630                   PM(i,zj,z,t) =e= (1+ttic(i,z,t))*(1+ttim(i,zj,z,t))*e(z,t)*
4631                                    (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
4632                                    *tmrg(ij,i,zj,z)]);
4633   
4634  * Given equations 47 and 48, equation 63 is redundant
4635  * EQ63(i,z)$IMTO(i,z)..
4636  *                 PMT(i,z)*IMT(i,z) =e= SUM[zj$IMO(i,zj,z),
4637  *                                           PM(i,zj,z)*IM(i,zj,z);
4638   
4639   EQ64(i,z,t)..     PC(i,z,t)*Q(i,z,t) =e= [PD(i,z,t)*DD(i,z,t)]$DDO(i,z)+
4640                                      [PMT(i,z,t)*IMT(i,z,t)]$IMTO(i,z);
4641   
4642  * EQ65(z,t)..       PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
4643  *                               /gamma_INV(i,z))**gamma_INV(i,z)];
4644   
4645   EQ66(z,t)..       PIXGDP(z,t) =e=
4646                   {SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)]
4647                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
4648                   *SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)]
4649                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)]}**0.5;
4650   
4651   EQ67(t)..         PIXGDP_W(t) =e=
4652                   {SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)/e(z,t)]
4653                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
4654                   *SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)/e(z,t)]
4655                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)/eO(z)]}**0.5;
4656   
4657   EQ68(z,t)..       PIXCON(z,t) =e= SUM[i,PC(i,z,t)*CO(i,z)]/SUM[i,PCO(i,z)*CO(i,z)];
4658   
4659   EQ69(z,t)..       PIXINV(z,t) =e= PROD[i$gamma_INV(i,z),(PC(i,z,t)/PCO(i,z))
4660                                   **gamma_INV(i,z)];
4661   
4662   EQ70(z,t)..       PIXGVT(z,t) =e= PROD[i$gamma_GVT(i,z),(PC(i,z,t)/PCO(i,z))
4663                                   **gamma_GVT(i,z)];
4664   
4665  *==============================================================================
4666  *   5.3.6 Equilibrium
4667  *==============================================================================
4668   EQ71(i1,z,t)..    Q(i1,z,t) =e= C(i1,z,t)+CG(i1,z,t)+INV(i1,z,t)+DIT(i1,z,t)+(Q_DAC(z,t)*DAC_Tech_Coeff(i1));
4669   
4670   EQ71_2(i3,z,t)..  Q(i3,z,t) =e=  C_Conventional(i3,z,t);
4671   
4672   EQ72(z,t)..       LS(z,t) =e= SUM[j$LDO(j,z),LD(j,z,t)+LBS(j,z,t)];
4673   
4674   EQ73(k,z,t)$KSO(k,z)..
4675                         KS(k,z,t) =e= SUM[j$KDO(k,j,z),KD(k,j,z,t)+KBS(k,j,z,t)];
4676   
4677   EQ74(z,t)..       IT(z,t) =e= SH(z,t)+SG(z,t)-CAB(z,t);
4678   
4679   EQ75(z,t)..       DEP(z,t) =e= PK(z,t)*delta(z)*SUM[k$KSO(k,z),KS(k,z,t)];
4680   
4681   EQ76(i,z,t)$DDO(i,z)..
4682                     SUM[j$DSO(j,i,z),DS(j,i,z,t)] =e= DD(i,z,t);
4683   
4684   EQ77(i,z,zj,t)$EXO(i,z,zj)..
4685                     EX(i,z,zj,t) =e= IM(i,z,zj,t);
4686   
4687   EQ78(i,z,zj,t)$EXO(i,z,zj)..
4688                     PWX(i,z,zj,t) =e= PWM(i,z,zj,t);
4689   
4690   EQ79(i,t)..       SUM[z$MRGNO(i,z),MRGN(i,z,t)] =e= SUM[(z,zj,ij)$IMO(ij,zj,z),
4691                                                   tmrg(i,ij,zj,z)*IM(ij,zj,z,t)];
4692   
4693  * Given equations 33, 34 and 77, equation 80 is redundant
4694  *EQ80..          SUM[z,SROW(z,t)/e(z,t)] =e= 0;
4695   
4696  *==============================================================================
4697  *   5.3.7 Gross domestic product
4698  *==============================================================================
4699   EQ81(z,t)..       GDP_BP(z,t) =e= SUM[j,PVA(j,z,t)*VA(j,z,t)]+TIPT(z,t)+sum(i3, CLBS(i3,z,t)+CKBS(i3,z,t)) ;
4700   
4701   EQ82(z,t)..       GDP_MP(z,t) =e= GDP_BP(z,t)+TPRCTS(z,t)+TCTAX(z,t)+SUM(i3,MARKUP(i3,z,t));
4702   
4703   EQ83(z,t)..       GDP_IB(z,t) =e= SUM[(j)$LDO(j,z),W(z,t)*(LD(j,z,t)+LBS(j,z,t))]
4704                                +SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*(KD(k,j,z,t)+KBS(k,j,z,t))]
4705                                +TPRCTS(z,t)+TPRODN(z,t)+TCTAX(z,t)+SUM(i3,MARKUP(i3,z,t));
4706   
4707   EQ84(z,t)..       GDP_FD(z,t) =e=
4708                                   SUM[i,PC(i,z,t)*(C(i,z,t)+CG(i,z,t)+INV(i,z,t))]
4709                                  +SUM[(i,zj)$EXO(i,z,zj),e(z,t)*PWX(i,z,zj,t)*EX(i,z,zj,t)]
4710                                  +SUM[i$MRGNO(i,z),e(z,t)*PWMG(i,t)*MRGN(i,z,t)]
4711                                  -SUM[(i,zj)$IMO(i,zj,z),e(z,t)*IM(i,zj,z,t)
4712                                      *(PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)*tmrg(ij,i,zj,z)])]
4713                                  +SUM(i1,PC(i1,z,t)*Q_DAC(z,t)*DAC_Tech_Coeff(i1));
4714   
4715   EQ85(t)..          GDP_BP_W(t) =e= SUM[z,GDP_BP(z,t)/e(z,t)];
4716   
4717  *==============================================================================
4718  *  5.3.8 Real (volume) variables computed from price indices
4719  *==============================================================================
4720   EQ86(z,t)..       CTH_REAL(z,t) =e= CTH(z,t)/PIXCON(z,t);
4721   
4722   EQ87(z,t)..       G_REAL(z,t) =e= G(z,t)/PIXGVT(z,t);
4723   
4724   EQ88(z,t)..       GDP_BP_REAL(z,t) =e= GDP_BP(z,t)/PIXGDP(z,t);
4725   
4726   EQ89(t)..         GDP_BP_W_REAL(t) =e= GDP_BP_W(t)/PIXGDP_W(t);
4727   
4728   EQ90(z,t)..       GDP_MP_REAL(z,t) =e= GDP_MP(z,t)/PIXCON(z,t);
4729   
4730   EQ91(z,t)..       IT_REAL(z,t) =e= IT(z,t)/PIXINV(z,t);
4731   
4732   EQ92(z,t)..       CABX(z,t) =e= CAB(z,t)/[PIXGDP_W(t)*e(z,t)];
4733   
4734  *==============================================================================
4735  *   5.3.8 Dynamic equations
4736  *==============================================================================
4737   EQ94(z,t)..     IT(z,t) =e= PK(z,t)*SUM[(k,j)$KDO(k,j,z),IND(k,j,z,t)];
4738   
4739   EQ95(z,t)..     PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
4740                                 /gamma_INV(i,z))**gamma_INV(i,z)];
4741   
4742   EQ96(k,bus,z,t)$KDO(k,bus,z)..
4743                       IND(k,bus,z,t) =e= phi(z,t)*[R(k,bus,z,t)/U(z,t)]
4744                                    **sigma_INV(k,bus,z)*(KD(k,bus,z,t));
4745   
4746   EQ97a(z,t)..    IR(z,t) =e= {SUM[(k,j)$KDO(k,j,z),
4747                                R(k,j,z,t)*(KD(k,j,z,t))]-DEP(z,t)}/
4748                               {PK(z,t)*SUM[(k,j)$KDO(k,j,z),(KD(k,j,z,t))]};
4749   
4750   EQ97b(z,t)..    U(z,t) =e= PK(z,t)*(delta(z)+IR(z,t));
4751   
4752  *==============================================================================
4753  *   5.3.9 Other
4754  *==============================================================================
4755   WALRAS(z,t)..   LEON(z,t) =e= Q('01_AGRICULT',z,t)-C('01_AGRICULT',z,t)-CG('01_AGRICULT',z,t)-INV('01_AGRICULT',z,t)
4756                              -DIT('01_AGRICULT',z,t);
4757   
4758  * WALRAS(z,t)..   LEON(z,t) =e= LS(z,t) -SUM[j$LDO(j,z),LD(j,z,t)];
4759   
4760  *==============================================================================
4761  *   5.3.10 Backstop technology
4762  *==============================================================================
4763   EQ98(i3,z,t)..    C_Conventional(i3,z,t) =e= (1-penetration_rate(i3,z,t))*[C(i3,z,t)+CG(i3,z,t)+INV(i3,z,t)+DIT(i3,z,t)];
4764   
4765   EQ99(i3,z,t)..    XDBS(i3,z,t) =e= penetration_rate(i3,z,t)*[C(i3,z,t)+CG(i3,z,t)+INV(i3,z,t)+DIT(i3,z,t)];
4766   
4767   EQ100(j,z,t)..    XDBS2(j,z,t) =e= sum{i3$COMtoIND(j,i3),XDBS(i3,z,t)};
4768   
4769   EQ101(j,z,t)..    LBS(j,z,t) =e= Lab_Share(j,z)*XDBS2(j,z,t);
4770   
4771   EQ102(k,j,z,t)..  KBS(k,j,z,t) =e= Cap_Share(j,z)*XDBS2(j,z,t)*KDO(k,j,z)/sum(kj,KDO(kj,j,z));
4772   
4773   EQ103(i3,z,t)..   CLBS(i3,z,t)  =e= sum{j$INDtoCOM(i3,j),LBS(j,z,t)*W(z,t)};
4774   
4775   EQ104(i3,z,t)..   CKBS(i3,z,t) =e= sum{ j$INDtoCOM(i3,j), sum(k$KDO(k,j,z), KBS(k,j,z,t)*R(k,j,z,t))};
4776   
4777   EQ105(i3,z,t)..   MARKUP(i3,z,t) =e= {PC(i3,z,t)*XDBS(i3,z,t)-CLBS(i3,z,t)-CKBS(i3,z,t)};
4778   
4779  *================================================================================
4780  * 6 Labour Supply
4781  *================================================================================
4782   EQ106(z,t)..  LS(z,t) =e= LST(z,t) *((W(z,t)/PIXCON(z,t)) / (W_lag(z,t)/PIXCON_lag(z,t)))**elasLS(z);
4783   
4784  *==============================================================================
4785  * 7 PERMET
4786  *==============================================================================
4787   EQ107(j,z,t).. PERMIT(j,z,t) =e= sum(ene, CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t));
4788   
4789   EQ108(z,t)..  PERMIT_TOTAL(z,t) =e=  sum(j,PERMIT(j,z,t))-Q_DAC(z,t)*switchDAC(z,t);
4790   
4791   EQ108_1(t).. PERMIT_NEA_TOTAL(t) =e= sum(NEA, PERMIT_TOTAL(NEA,t));
4792   
4793  *==============================================================================
4794  * 8 Carbon Tax Revenue Recycling
4795  *==============================================================================
4796  EQ109(z,t)..     REBATE(z,t) =e= TCTAX(z,t);
4797   
4798  EQ110(j,z,t)..   TIW_Share(j,z,t) =e= LD(j,z,t)/SUM(jj,LD(jj,z,t));
4799   
4800  EQ111(j,z,t)..   LaborRebate(j,z,t) =e= TIW_Share(j,z,t) * TCTAX(z,t) * recycle_labor(z,t);
4801   
4802  *EQ112(j,z,t)..   TIK_Share(j,z,t) =e= KD('cap',j,z,t)/SUM(jj,KD('cap',jj,z,t));
4803   
4804  *EQ113(j,z,t)..   ttik('cap',j,z,t) =e= ttik_lag(j,z,t) + deltatik(j,z,t);
4805   
4806  *EQ114(j,z,t)..   deltatik(j,z,t) =e= -TIK_Share(j,z,t)*REBATE(z,t)/(R('cap',j,z,t)*KD('cap',j,z,t))*recycle_capital(z,t);
4807   
4808  *EQ115(j,z,t)..   TIP_Share(j,z,t) =e= XST(j,z,t)/SUM(jj,XST(jj,z,t));
4809   
4810  *EQ116(j,z,t)..   ttip(j,z,t) =e= ttip_lag(j,z,t) + deltatip(j,z,t);
4811   
4812  *EQ117(j,z,t)..   deltatip(j,z,t) =e= -TIP_Share(j,z,t) * REBATE(z,t) / (PP(j,z,t)*XST(j,z,t))*recycle_ptax(z,t);
4813   
4814  *==============================================================================
4815  * 9 DAC
4816  *==============================================================================
4817  EQ118(z,t)..    Q_DAC(z,t) =e= DAC_MAX*DAC_growth_rate(z,t)*switchDAC(z,t);
4818   
4819  *==============================================================================
4820  * 6 Numerical resolution to compute A_VA, sh0, G, G_REAL and IND
4821  *==============================================================================
4822  option cns = conopt4;
