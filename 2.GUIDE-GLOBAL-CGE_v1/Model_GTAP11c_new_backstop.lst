3791  *==============================================================================
3792  *   Labour Supply
3793  *==============================================================================
3794  Parameters
3795   W_lag(z,time)         Wage rate of type l labor in region z
3796   PIXCON_lag(z,time)    Consumer price index in region z
3797   LS_lag(z,time)        Supply of type l labor in region z (T-1)
3798   LST_lag(z,time)       Supply of type l labor in region z (Trend T-1)
3799  ;
3800   
3801  *==============================================================================
3802  *  Own-price elasticities
3803  *==============================================================================
3804  PARAMETER
3805   elas_elec(j,z)               Own price elasticities(electricity)
3806   elas_gas(j,z)               Own price elasticities(gas)
3807   elas_oil(j,z)                 Own price elasticities(oil)
3808   elas_coal(j,z)               Own price elasticities(coal)
3809   elas_petrolcoal(j,z)       Own price elasticities(petrolcoal)
3810   elas_Hou_ENER(ene,z)  Own price elasticities Household
3811  ;
3812   
3813   elas_elec(j2,z)       = -1*(1- DEO('18_ELEC',j2,z)/sum(ene,DEO(ene,j2,z)))*sigma_ENER_elec(j2,z) ;
3814   elas_elec(j3,z)       = eps ;
3815   
3816   elas_gas(j2,z)        = -1*(1- DEO('04_GAS',j2,z)/(DEO('02_COAL',j2,z)+DEO('04_GAS',j2,z)))*sigma_ENER_coalgas(j2,z) ;
3817   elas_gas(j3,z)        = eps ;
3818   
3819   elas_coal(j2,z)       = -1*(1- DEO('02_COAL',j2,z)/(DEO('02_COAL',j2,z)+DEO('04_GAS',j2,z)))*sigma_ENER_coalgas(j2,z) ;
3820   elas_coal(j3,z)       = eps ;
3821   
3822   elas_oil(j2,z)          = -1*(1- DEO('03_OIL',j2,z)/(DEO('03_OIL',j2,z)+DEO('10_PETROLCOAL',j2,z)))*sigma_ENER_oilprod(j2,z) ;
3823   elas_oil(j3,z)          = eps ;
3824   
3825   elas_petrolcoal(j2,z)  = -1*(1- DEO('10_PETROLCOAL',j2,z)/(DEO('03_OIL',j2,z)+DEO('10_PETROLCOAL',j2,z)))*sigma_ENER_oilprod(j2,z) ;
3826   elas_petrolcoal(j3,z)  = eps ;
3827   
3828   elas_Hou_ENER(ene,z)   = CMINO(ene,z)/CO(ene,z)*(1-gamma_LES(ene,z)) -1 ;
3829   
3830  *==============================================================================
3831  *   Sigma_ENE_elec
3832  *==============================================================================
3833  PARAMETER W_Origin(ene,j,z) "Original Weights";
3834  W_Origin(ene,j,z)$(sum(jj,DIO(ene,jj,z))) = DIO(ene,j,z) / sum(jj,DIO(ene,jj,z));
3835  W_Origin(ene,j,z)$(not sum(jj,DIO(ene,jj,z))) = 0;
3836   
3837  PARAMETER V_log(ene,j2,z) "Log transformed weights (ln(W_orig))";
3838  PARAMETER V_min(ene), V_max(ene);
3839  PARAMETER N_norm(ene,j2,z) "Normalized values (0 to 1)";
3840  PARAMETER W_final(ene,j2,z) "Final Scaled Weights (0.1 to 2.0)";
3841  SCALAR A /0.1/, B /1.0/;
3842   
3843  * 1. 로그 변환 (기존과 동일, 0 값 방지 위해 EPS 사용)
3844  V_log(ene,j2,z) = LOG(W_Origin(ene,j2,z) + 1E-8);
3845   
3846  * 2. V_min 및 V_max 계산 (***수정: ene 인덱스 명시***)
3847  * 'ene' 상품 내에서 j2와 z에 대한 최소값/최대값을 찾음
3848  V_min(ene) = Smin((j2,z), V_log(ene,j2,z));
3849  V_max(ene) = Smax((j2,z), V_log(ene,j2,z));
3850   
3851  * 3. 0-1 정규화 (***수정: 모든 인덱스 명시 및 분모 0 조건 처리***)
3852  * 먼저, V_max = V_min인 경우를 위해 모든 N_norm을 0.5로 초기화합니다.
3853  N_norm(ene,j2,z) = 0.5;
3854   
3855  * V_max(ene) - V_min(ene)가 0이 아닐 때만 정규화 계산 수행
3856  N_norm(ene,j2,z)$(V_max(ene) - V_min(ene)) =
3857      (V_log(ene,j2,z) - V_min(ene)) / (V_max(ene) - V_min(ene));
3858   
3859  * 4. 최종 목표 범위 (0.1 ~ 2.0)로 스케일링 (***수정: 모든 인덱스 명시***)
3860  W_final(ene,j2,z) = A + (B - A) * N_norm(ene,j2,z);
3861   
3862  execute_unload 'Calibration_Check_GTAP11c';
3863  *$exit
