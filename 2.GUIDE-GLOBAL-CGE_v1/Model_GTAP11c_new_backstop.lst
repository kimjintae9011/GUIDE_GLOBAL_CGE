3587  *  4.12 CO2FACTOR and CTAX
3588  *==============================================================================
3589  Parameters
3590   CO2_Energy(ene,j,z)        CO2 emissions from Energy
3591  ;
3592   
3593   CO2_Energy('02_COAL',j,z) = sum(p_coal,CO2IO(p_coal,j,z));
3594   CO2_Energy('03_OIL',j,z)  = sum(p_oil,CO2IO(p_oil,j,z));
3595   CO2_Energy('04_GAS',j,z)  = sum(p_gas,CO2IO(p_gas,j,z));
