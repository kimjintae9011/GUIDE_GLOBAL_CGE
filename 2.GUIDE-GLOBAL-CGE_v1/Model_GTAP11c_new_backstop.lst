3721   TCTAX0(z)         = 0;
3722   PERMITO(j,z)      = sum(ene, CO2FACTOR(ene,j,z)*DEO(ene,j,z)) ;
3723   PERMIT_TOTALO(z)  = sum(j,PERMITO(j,z));
3724   PERMIT_NEA_TOTALO = sum(NEA, PERMIT_TOTALO(NEA));
