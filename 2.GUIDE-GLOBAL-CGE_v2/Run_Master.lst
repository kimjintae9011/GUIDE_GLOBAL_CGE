2369   Elec_DIO(p_elecheat,'11_CHEMICAL',z)
2370      = sum((f_chemical), WEB(f_chemical, p_elecheat, z)$(WEB(f_chemical, p_elecheat, z) > 0))
2371      - 1 * sum((f_chemical), WEB(f_chemical, p_elecheat, z)$(WEB(f_chemical, p_elecheat, z) < 0));
2372   Elec_DIO(p_elecheat,'12_NONMET',z)   = sum((f_nonmet), WEB(f_nonmet, p_elecheat, z));
2373   Elec_DIO(p_elecheat,'13_IRONSTL',z)
2374      = sum((f_ironstl), WEB(f_ironstl, p_elecheat, z)$(WEB(f_ironstl, p_elecheat, z) > 0))
2375      - 1 * sum(f_cokeoven, WEB(f_cokeoven, p_elecheat, z)$(WEB(f_cokeoven, p_elecheat, z) < 0))
2376      - 1 * sum(f_blastfur, WEB(f_blastfur, p_elecheat, z)$(WEB(f_blastfur, p_elecheat, z) < 0))
2377      - 1 * sum(f_Eblastcoke, WEB(f_Eblastcoke, p_elecheat, z)$(WEB(f_Eblastcoke, p_elecheat, z) < 0));
2378   Elec_DIO(p_elecheat,'14_NONFERR',z)  = sum((f_nonferr), WEB(f_nonferr, p_elecheat, z));
2379   Elec_DIO(p_elecheat,'15_MACHINE',z)  = sum((f_machine), WEB(f_machine, p_elecheat, z));
2380   Elec_DIO(p_elecheat,'16_TRANSEQ',z)  = sum((f_transeq), WEB(f_transeq, p_elecheat, z));
2381   Elec_DIO(p_elecheat,'17_OTHERIND',z)
2382      = sum((f_otherind), WEB(f_otherind, p_elecheat, z)$(WEB(f_otherind, p_elecheat, z) > 0))
2383      - 1 * sum((f_otherind), WEB(f_otherind, p_elecheat, z)$(WEB(f_otherind, p_elecheat, z) < 0));
2384   Elec_DIO(p_elecheat,'18_TnD',z)
2385      = -1 * sum((f_tnd), WEB(f_tnd, p_elecheat, z)$(WEB(f_tnd, p_elecheat, z) < 0))
