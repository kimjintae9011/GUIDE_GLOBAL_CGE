2167  Parameter Gas_Prod_Iron(product, z) "By-product gas production in the iron and steel sector (ktoe)";
2168  Parameter Coke_Prod_Iron(product, z) "Coke production in the iron and steel sector (ktoe)";
2169   
2170  Gas_Prod_Iron(p_irongas, z) =
2171        sum(f_cokeoven, WEB(f_cokeoven, p_irongas, z)$(WEB(f_cokeoven, p_irongas, z) > 0))
2172      + sum(f_blastfur, WEB(f_blastfur, p_irongas, z)$(WEB(f_blastfur, p_irongas, z) > 0)) ;
2173   
2174  Coke_Prod_Iron(p_oilproduct, z) =
2175        sum(f_cokeoven, WEB(f_cokeoven, p_oilproduct, z)$(WEB(f_cokeoven, p_oilproduct, z) > 0));
