--- LOAD  XSO_I = 37:XSO_I
--- LOAD  XSTO = 38:XSTO
--- LOAD  TOT_POP = 53:TOT_POP
--- LOAD  g_GDP = 54:g_GDP
--- LOAD  g_POP = 55:g_POP
--- LOAD  g_SDR = 56:g_SDR
--- LOAD  CTAX_BAU = 57:CTAX_BAU
--- LOAD  PERMIT_NDC = 58:PERMIT_NDC
--- LOAD  PERMIT_NZ = 59:PERMIT_NZ
--- LOAD  AEEI_BAU = 60:AEEI_BAU
--- LOAD  AEEI_NDC = 61:AEEI_NDC
--- LOAD  AEEI_NZ = 62:AEEI_NZ
--- LOAD  RKDO = 24:RKDO
--- LOAD  TDHO = 25:TDHO
--- LOAD  TICO = 27:TICO
--- LOAD  TIKO = 28:TIKO
--- LOAD  TIMO = 29:TIMO
--- LOAD  TIPO = 30:TIPO
--- LOAD  TIWO = 31:TIWO
--- LOAD  TIXO = 32:TIXO
--- LOAD  tmrg = 35:tmrg
--- LOAD  sigma_M1 = 41:sigma_M1
--- LOAD  sigma_M2 = 42:sigma_M2
--- LOAD  sigma_Y = 43:sigma_Y
--- LOAD  sigma_VA = 44:sigma_VA
--- LOAD  sigma_KLE = 45:sigma_KLE
--- LOAD  POPO = 23:POPO
 905   
 906  *===============================================================================
 907  * Initial Elasticity Parameter Assignments
 908  *===============================================================================
 909  *CES - KLE(backstop)
 910   sigma_KLE(BS,z)          = 0.5;
 911   sigma_KLE('16_TRANSEQ','07_NAM') = 0.5 ;
 912   
 913  * CES - composite K-L
 914   sigma_VA('10_PETROLCOAL',z)   = 0.2;
 915   sigma_VA('11_CHEMICAL',z)   = 0.2;
 916   sigma_VA('18_TnD',z)          = 0.2;
 917   sigma_VA('19_eNuclear',z)     = 0.2;
 918   sigma_VA('20_eCoal',z)        = 0.2;
 919   sigma_VA('21_eGas',z)         = 0.2;
 920   sigma_VA('22_eOil',z)         = 0.2;
 921   sigma_VA('23_eWind',z)        = 0.2;
 922   sigma_VA('24_eSolar',z)       = 0.2;
 923   sigma_VA('25_eHydro',z)       = 0.2;
 924   sigma_VA('26_eOther',z)      = 0.2;
 925   sigma_VA(BS,z)                = 0.5;
 926   
 927  * CES - composite capital
 928   sigma_KD(j,z)        = 2*sigma_VA(j,z);
 929   sigma_KD(BS,Z)       = 0.5;
 930   
 931  * CES - composite labor
 932   sigma_LD(j,z)        = 2*sigma_VA(j,z);
 933   sigma_LD(BS,Z)      = 0.5;
 934   
 935  * CES - composite ENER
 936   sigma_ENER_elec(j2,z)         = 1.5;
 937   sigma_ENER_nelec(j2,z)        = 0.5;
 938   sigma_ENER_coalgas(j2,z)      = 2.0;
 939   sigma_ENER_oilprod(j2,z)      = 0.5;
 940   
 941  * CES - Substitution between different industries producing the same commodity (Dummy)
 942   sigma_MultiOut(i,z)                 = 2;
 943   
 944  * CES - composite Power sector
 945   sigma_POWER(z)                   = 3;
 946  * sigma_POWER('07_NAM')            = 1.5;
 947   sigma_POWER('09_WEU')            = 2.0;
 948  * sigma_POWER('16_APC')            = 1.5;
 949   sigma_POWER('06_PRK')            = 0.5;
 950   
 951  * CES - composite BS sector
 952   sigma_BS(BS, Z_GRN)       = 5;
 953   sigma_BS(BS, '07_NAM')    = 5;
 954   sigma_BS(BS, '09_WEU')    = 5;
 955   
 956  * CES - BS sector VAT
 957   sigma_VAT('32_BSCHEMICAL',Z_GRN)   = 0.5;
 958   sigma_VAT('33_BSNONMET',Z_GRN)     = 0.5;
 959   sigma_VAT('34_BSIRONSTL',Z_GRN)    = 0.5;
 960   sigma_VAT('35_BS_LTRP',Z_GRN)      = 0.5;
 961   sigma_VAT('36_BS_WTRP',Z_GRN)      = 0.5;
 962   sigma_VAT('37_BS_ATRP',Z_GRN)      = 0.5;
 963   
 964  * CES - DOM vs.IMP
 965   sigma_M1('03_OIL','06_PRK') = 0.5;
 966   sigma_M1('04_GAS',Z) = 6;
 967   sigma_M1('11_CHEMICAL','05_MNG') = 1.5;
 968   sigma_M1('13_IRONSTL','05_MNG') = 1.1;
 969   
 970  * CES - IMP sourcing
 971   sigma_M2('03_OIL',Z) = 2;
 972   sigma_M2('04_GAS',Z) = 2;
 973   
 974  * CET - Transformation between domestic sales and total exports.
 975   sigma_X1(i,z)                 = 2;
 976   
 977  * CET - Transformation across different export destinations
 978   sigma_X2(i,z)                 = 2;
 979   
 980  * Investment demand elasticity
 981   sigma_INV(k,j,z)              = 0.5;
 982   
 983  * LES parameters - Frisch
 984   frisch('01_KOR') = -1.30;
 985   frisch('02_CHN') = -1.45;
 986   frisch('03_JPN') = -1.25;
 987   frisch('04_RUS') = -1.45;
 988   frisch('05_MNG') = -1.70;
 989   frisch('06_PRK') = -2.00;
 990   frisch('07_NAM') = -1.20;
 991   frisch('08_LAM') = -1.50;
 992   frisch('09_WEU') = -1.20;
 993   frisch('10_EEU') = -1.40;
 994   frisch('11_CAS') = -1.60;
 995   frisch('12_MEA') = -1.60;
 996   frisch('13_AFR') = -1.90;
 997   frisch('14_CLV') = -1.70;
 998   frisch('15_SAS') = -1.80;
 999   frisch('16_APC') = -1.50;
1000   frisch('17_ANZ') = -1.20;
1001   
1002  * Labour supply
1003   elasLS(z)                     = 0.1;
1004   
1005  *==============================================================================
1006  * Rescaling
1007  *==============================================================================
1008  * GTAP data are in millions of US dollars (10^6 USD)
1009  * With RES = 1000, model results are in Billions of US dollars (1 Billion USD = 10^9 USD)
1010   RES = 1000;
1011   CO(i,z)          = CO(i,z) / RES;
1012   CGO(i,z)         = CGO(i,z) / RES;
1013   DDO(i,z)         = DDO(i,z) / RES;
1014   DEPO(z)          = DEPO(z) / RES;
1015   DIO(i,j,z)       = DIO(i,j,z) / RES;
1016   DSO(j,i,z)       = DSO(j,i,z) / RES;
1017   DSO_I(i,z)       = DSO_I(i,z) / RES;
1018   EXO(i,z,zj)      = EXO(i,z,zj) / RES;
1019   IMO(i,z,zj)      = IMO(i,z,zj) / RES;
1020   INVO(i,z)        = INVO(i,z) / RES;
1021   KSTO(z)          = KSTO(z) / RES;
1022   LDO(j,z)         = LDO(j,z) / RES;
1023   MRGNO(i,z)       = MRGNO(i,z) / RES;
1024   RKDO(k,j,z)      = RKDO(k,j,z) / RES;
1025   TDHO(z)          = TDHO(z) / RES;
1026   TICO(i,z)        = TICO(i,z) / RES;
1027   TIKO(k,j,z)      = TIKO(k,j,z) / RES;
1028   TIMO(i,z,zj)     = TIMO(i,z,zj) / RES;
1029   TIPO(j,z)        = TIPO(j,z) / RES;
1030   TIWO(j,z)        = TIWO(j,z) / RES;
1031   TIXO(i,z,zj)     = TIXO(i,z,zj) / RES;
1032   tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj) / RES;
1033   XSO_I(i,z)       = XSO_I(i,z) / RES;
1034   XSO(j,i,z)       = XSO(j,i,z) / RES;
1035   XSTO(j,z)        = XSTO(j,z) / RES;
1036   
1037  *==============================================================================
1038  * Backstop Technology Split & TSF Initialization (Upstream Injection)
1039  *==============================================================================
1040  PARAMETER
1041   seed(j)                Initial share of the new technology
1042   TSFO(j, z)             Initial year TSF input for backstop (Value)
1043   PTSFO(j, z)            Initial year TSF price for backstop
1044   Green_Markup(j, z)     Initial efficiency penalty for backstop
1045   SHR_MRGN(j, i, z)      Share of international transport margin for sector j
1046  ;
1047   
1048  seed(BS) = 0.01;
1049  PTSFO(BS, Z_GRN) = 1.0;
1050  Green_Markup(BS, Z_GRN) = 1.0;
1051   
1052  * Initialize default margin share to 1.0 (100%) for all industries before splitting
1053  SHR_MRGN(j, i, z)$XSO(j, i, z) = 1.0;
1054   
1055  LOOP(Z_GRN,
1056  *--------------------------------------------------------------------------
1057  * [1] Split raw data by seed share and preserve identities
1058  *--------------------------------------------------------------------------
1059    LOOP(MAP_BS(j, jj, i),
1060  * Allocate to backstop industry
1061      LDO(j, Z_GRN)       = LDO(jj, Z_GRN) * seed(j);
1062      RKDO(k, j, Z_GRN)   = RKDO(k, jj, Z_GRN) * seed(j);
1063      TIPO(j, Z_GRN)      = TIPO(jj, Z_GRN) * seed(j);
1064      TIWO(j, Z_GRN)      = TIWO(jj, Z_GRN) * seed(j);
1065      TIKO(k, j, Z_GRN)   = TIKO(k, jj, Z_GRN) * seed(j);
1066      DIO(ii, j, Z_GRN)   = DIO(ii, jj, Z_GRN) * seed(j);
1067   
1068      XSO(j, i, Z_GRN)    = (XSO(jj, i, Z_GRN) * seed(j)) / Green_Markup(j, Z_GRN);
1069      XSTO(j, Z_GRN)      = (XSTO(jj, Z_GRN) * seed(j)) / Green_Markup(j, Z_GRN);
1070      DSO(j, i, Z_GRN)    = (DSO(jj, i, Z_GRN) * seed(j)) / Green_Markup(j, Z_GRN);
1071   
1072  * Allocate international margin share to backstop industry by seed share
1073      SHR_MRGN(j, i, Z_GRN) = seed(j);
1074   
1075  * Deduct exact share from conventional industry
1076      LDO(jj, Z_GRN)      = LDO(jj, Z_GRN) * (1 - seed(j));
1077      RKDO(k, jj, Z_GRN)  = RKDO(k, jj, Z_GRN) * (1 - seed(j));
1078      TIPO(jj, Z_GRN)     = TIPO(jj, Z_GRN) * (1 - seed(j));
1079      TIWO(jj, Z_GRN)     = TIWO(jj, Z_GRN) * (1 - seed(j));
1080      TIKO(k, jj, Z_GRN)  = TIKO(k, jj, Z_GRN) * (1 - seed(j));
1081      DIO(ii, jj, Z_GRN)  = DIO(ii, jj, Z_GRN) * (1 - seed(j));
1082      XSO(jj, i, Z_GRN)   = XSO(jj, i, Z_GRN) * (1 - seed(j));
1083      XSTO(jj, Z_GRN)     = XSTO(jj, Z_GRN) * (1 - seed(j));
1084      DSO(jj, i, Z_GRN)   = DSO(jj, i, Z_GRN) * (1 - seed(j));
1085   
1086  * Deduct international margin share from conventional industry (remaining share)
1087      SHR_MRGN(jj, i, Z_GRN) = 1.0 - seed(j);
1088    );
1089   
1090  *--------------------------------------------------------------------------
1091  * [2] Technology Specific Factor (TSF) Allocation
1092  *--------------------------------------------------------------------------
1093    LOOP(BS,
1094      TSFO(BS, Z_GRN) = (RKDO('cap', BS, Z_GRN) * 0.9) / PTSFO(BS, Z_GRN);
1095      RKDO('cap', BS, Z_GRN) = RKDO('cap', BS, Z_GRN) - (PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN));
1096    );
1097  );
1098   
1099  * Calculate initial values for TSF intensity and time series
1100  LOOP(BS,
1101    v_tsf(BS, Z_GRN)      = TSFO(BS, Z_GRN) / XSTO(BS, Z_GRN);
1102    TSFS(BS, Z_GRN, time) = TSFO(BS, Z_GRN);
1103  );
1104   
1105  *==============================================================================
1106  * 3.3 Exogenous prices and parameters
1107  *==============================================================================
1108   eta                = 1;
1109   ttdh0O(z)          = 0;
1110   eO(z)              = 1;
1111   PEO(i,z,zj)        = 1;
1112   PLO(i,z)           = 1;
1113   PWMGO(i)           = 1;
1114   WO(z)              = 1;
1115   WO_lag(z)          = WO(z);
1116   
1117  * -------------------------------------------------------------------
1118  * [Dynamic Enhancement] Injecting micro-seeds into zero-output (dormant) sectors
1119  * -------------------------------------------------------------------
1120  SCALAR micro_tol / 0.01 /;
1121   
1122  * 1. Calculate temporary PPO (price distortion) for filtering
1123  PARAMETER PPO_TEMP(j,z) "Temporary producer price index for data filtering";
1124  PPO_TEMP(j,z)$XSTO(j,z) = ( TIWO(j,z) + WO(z)*LDO(j,z)
1125                            + SUM(k, TIKO(k,j,z) + RKDO(k,j,z))
1126                            + SUM(i, DIO(i,j,z)) ) / XSTO(j,z);
1127   
1128  * 2. [Modified] Include cases where output is low (XSTO < 0.01) OR price distortion is extreme (PPO > 2.0)
1129  LOOP((j,z)$( ( (XSTO(j,z) < micro_tol) or (PPO_TEMP(j,z) > 2.0) )
1130               and (PPO_TEMP(j,z) > 1.2 or PPO_TEMP(j,z) < 0.8)
1131               and not (BS(j) and Z_OTH(z)) ),
1132   
1133  * 3. Override with minimum seed if XSTO is near zero; otherwise, maintain scale
1134      XSTO(j,z) = MAX(XSTO(j,z), 1E-5);
1135   
1136  * 4. Transplant input structure ratios from identical industries in China (02_CHN)
1137      LDO(j,z)    = XSTO(j,z) * (LDO(j,'02_CHN') / XSTO(j,'02_CHN'));
1138      TIWO(j,z)   = XSTO(j,z) * (TIWO(j,'02_CHN') / XSTO(j,'02_CHN'));
1139      TIPO(j,z)   = XSTO(j,z) * (TIPO(j,'02_CHN') / XSTO(j,'02_CHN'));
1140   
1141      LOOP(k,
1142          RKDO(k,j,z) = XSTO(j,z) * (RKDO(k,j,'02_CHN') / XSTO(j,'02_CHN'));
1143          TIKO(k,j,z) = XSTO(j,z) * (TIKO(k,j,'02_CHN') / XSTO(j,'02_CHN'));
1144      );
1145   
1146      LOOP(i,
1147          DIO(i,j,z)  = XSTO(j,z) * (DIO(i,j,'02_CHN') / XSTO(j,'02_CHN'));
1148      );
1149  );
1150   
1151  *==============================================================================
1152  * Calibration
1153  *==============================================================================
1154   YHKO(z)          = SUM[(k,j), RKDO(k,j,z)];
1155   YHLO(z)          = SUM[(j), LDO(j,z)];
1156   YHO(z)           = YHLO(z) + YHKO(z) + SUM[BS, PTSFO(BS,z) * TSFO(BS,z)];
1157   YDHO(z)          = YHO(z) - TDHO(z);
1158   CTHO(z)          = SUM[i, CO(i,z)];
1159   SHO(z)           = YDHO(z) - CTHO(z);
1160   TICTO(z)         = SUM[i, TICO(i,z)];
1161   TIMTO(z)         = SUM[(i,zj), TIMO(i,zj,z)];
1162   TIWTO(z)         = SUM[(j), TIWO(j,z)];
1163   TIKTO(z)         = SUM[(k,j), TIKO(k,j,z)];
1164   TIPTO(z)         = SUM[j, TIPO(j,z)];
1165   TIXTO(z)         = SUM[(i,zj), TIXO(i,z,zj)];
1166   TPRODNO(z)       = TIKTO(z) + TIWTO(z) + TIPTO(z);
1167   TPRCTSO(z)       = TICTO(z) + TIMTO(z) + TIXTO(z);
1168   YGO(z)           = TDHO(z) + TPRCTSO(z) + TPRODNO(z);
1169   GO(z)            = SUM[i, CGO(i,z)];
1170   SGO(z)           = YGO(z) - GO(z);
1171   YROWO(z)         = SUM[(i,zj), IMO(i,zj,z)] + SUM[(i,ij,zj), tmrg(i,ij,zj,z)];
1172   SROWO(z)         = YROWO(z) - SUM[(i,zj), EXO(i,z,zj)] - SUM[i, MRGNO(i,z)];
1173   CABO(z)          = -SROWO(z);
1174   ITO(z)           = SHO(z) + SGO(z) + SROWO(z);
1175   
1176  *==============================================================================
1177  * Calibration of parameters and other variables
1178  *==============================================================================
1179   gamma_GVT(i,z)   = CGO(i,z) / SUM[ij, CGO(ij,z)];
1180   gamma_INV(i,z)   = INVO(i,z) / SUM[ij, INVO(ij,z)];
1181   
1182  *==============================================================================
1183  * Calibration of other prices and revised volumes (part 1)
1184  *==============================================================================
1185   LDO(j,z)         = LDO(j,z) / WO(z);
1186   LDCO(j,z)        = LDO(j,z);
1187   LSO(z)           = SUM[j, LDO(j,z)];
1188   LSTO(z)          = LSO(z);
1189   LSO_lag(z)       = LSO(z);
1190   LSTO_lag(z)      = LSO(z);
1191   EXO(i,z,zj)      = [EXO(i,z,zj) - TIXO(i,z,zj)] / PEO(i,z,zj);
1192   EXTO(i,z)        = SUM[zj, EXO(i,z,zj)];
1193   PWXO(i,z,zj)$EXO(i,z,zj)
1194                    = { [PEO(i,z,zj) * EXO(i,z,zj) + TIXO(i,z,zj)] / EXO(i,z,zj) } / eO(z);
1195   PETO(i,z)        = SUM[zj, PEO(i,z,zj) * EXO(i,z,zj)] / EXTO(i,z);
1196   PWMO(i,z,zj)     = PWXO(i,z,zj);
1197   IMO(i,zj,z)      = EXO(i,zj,z);
1198   IMTO(i,z)        = SUM[zj, IMO(i,zj,z)];
1199   DSO(j,i,z)       = DSO(j,i,z) / PLO(i,z);
1200   DSO_I(i,z)       = SUM(j, DSO(j,i,z));
1201   DSO_J(j,z)       = SUM(i, DSO(j,i,z));
1202   QO(i,z)          = IMTO(i,z) + DDO(i,z);
1203   MRGNO(i,z)$MRGNO(i,z)
1204                    = MRGNO(i,z) / [eO(z) * PWMGO(i)];
1205   XSO_I(i,z)       = EXTO(i,z) + DDO(i,z) + MRGNO(i,z);
1206   XSTO(j,z)        = SUM(i, XSO(j,i,z));
1207   PO(i,z)          = [ PETO(i,z) * EXTO(i,z) + PLO(i,z) * DSO_I(i,z)
1208                      + eO(z) * PWMGO(i) * MRGNO(i,z) ] / XSO_I(i,z);
1209   PO2(j,i,z)$XSO(j,i,z)                  = 1;
1210   PO2(BS,I_BS,Z_GRN) = Green_Markup(BS,Z_GRN);
1211   
1212   PO3(i,j,z)$XSO(j,i,z)                  = 1;
1213   PIO(i,z)         = SUM[j$XSO(j,i,z), PO2(J,I,z) * XSO(j,i,z)] / XSO_I(i,z);
1214   PTO(j,z)$XSTO(j,z) = SUM[i$XSO(j,i,z), PO2(j,i,z) * XSO(j,i,z)] / XSTO(j,z);
1215   
1216   PPO(j,z)$XSTO(j,z)
1217      = ( TIWO(j,z) + WO(z) * LDO(j,z)
1218        + SUM[k, TIKO(k,j,z) + RKDO(k,j,z)]
1219        + (PTSFO(j,z) * TSFO(j,z))$BS(j)
1220        + SUM[nene, DIO(nene,j,z)]
1221        + SUM[ene, DIO(ene,j,z)] ) / XSTO(j,z);
1222   theta2(j,i,z)    = DSO(j,i,z) / SUM(jj, DSO(jj,i,z));
1223   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z) * EXTO(i,z);
1224   
1225  *==============================================================================
1226  * Calibration of tax rates, margins, prices and volumes
1227  *==============================================================================
1228   ttixO(i,z,zj)    = [eO(z) * PWXO(i,z,zj) / PEO(i,z,zj)] - 1;
1229   tticO(i,z)       = TICO(i,z) /
1230                      { PLO(i,z) * DDO(i,z)
1231                      + SUM[zj, IMO(i,zj,z) * eO(z) * PWMO(i,zj,z)
1232                      + TIMO(i,zj,z) + SUM[ij, tmrg(ij,i,zj,z)]] };
1233   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
1234                    = tmrg(i,ij,zj,z) / (PWMGO(i) * eO(z) * IMO(ij,zj,z));
1235   ttimO(i,zj,z)$IMO(i,zj,z)
1236                    = TIMO(i,zj,z) /
1237                      { IMO(i,zj,z) * eO(z) * (PWMO(i,zj,z)
1238                      + SUM[ij, PWMGO(ij) * tmrg(ij,i,zj,z)]) };
1239   ttiwO(j,z)$LDO(j,z)
1240                    = TIWO(j,z) / [WO(z) * LDO(j,z)];
1241   ttikO(k,j,z)$RKDO(k,j,z)
1242                    = TIKO(k,j,z) / RKDO(k,j,z);
1243   ttipO(j,z)$XSTO(j,z) = [PTO(j,z) / PPO(j,z)] - 1;
1244   
1245   ttdh1O(z)        = [TDHO(z) - ttdh0O(z)] / YHO(z);
1246   
1247  *==============================================================================
1248  * Calibration of other prices and revised volumes (part 2)
1249  *==============================================================================
1250   PDO(i,z)         = PLO(i,z) * (1 + tticO(i,z));
1251   PMO(i,zj,z)      = eO(z) * (PWMO(i,zj,z) + SUM[ij, PWMGO(ij) * tmrg(ij,i,zj,z)])
1252                    * (1 + ttimO(i,zj,z)) * (1 + tticO(i,z));
1253   PMTO(i,z)        = SUM[zj, PMO(i,zj,z) * IMO(i,zj,z)] / IMTO(i,z);
1254   PCO(i,z)         = [PMTO(i,z) * IMTO(i,z) + PDO(i,z) * DDO(i,z)] / QO(i,z);
1255   CO(i,z)          = CO(i,z) / PCO(i,z);
1256   CGO(i,z)         = CGO(i,z) / PCO(i,z);
1257   DIO(nene,j,z)    = DIO(nene,j,z) / PCO(nene,z);
1258   DEO(ene,j,z)     = DIO(ene,j,z) / PCO(ene,z);
1259   DEelecO(j,z)     = DIO('18_ELEC',j,z) / PCO('18_ELEC',z);
1260   DEnelecO(j,z)    = SUM(ene3, DEO(ene3,j,z));
1261   DEcoalgasO(j,z)  = SUM(ene5, DEO(ene5,j,z));
1262   DEcoalO(j,z)     = DEO('02_COAL',j,z);
1263   DEgasO(j,z)      = DEO('04_GAS',j,z);
1264   DEoilpetrolO(j,z)= SUM(ene6, DEO(ene6,j,z));
1265   DEoilO(j,z)      = DEO('03_OIL',j,z);
1266   DEpetrolO(j,z)   = DEO('10_PETROLCOAL',j,z);
1267   INVO(i,z)        = INVO(i,z) / PCO(i,z);
1268   CIO(j,z)         = SUM[nene, DIO(nene,j,z)];
1269   CEO(j3,z)        = SUM[ene, DEO(ene,j3,z)];
1270   CEO(j2,z)        = DEelecO(j2,z) + DEnelecO(j2,z);
1271   DITO(nene,z)     = SUM[j, DIO(nene,j,z)];
1272   DITO(ene,z)      = SUM[j, DEO(ene,j,z)];
1273   
1274   PO4(ene,j,z)     = PCO(ene,z);
1275   PCIO(j,z)$XSTO(j,z)
1276                    = SUM[nene, PCO(nene,z) * DIO(nene,j,z)] / CIO(j,z);
1277   PCEcoalO(j,z)$XSTO(j,z)   = PO4('02_COAL',j,z);
1278   PCEgasO(j,z)$XSTO(j,z)    = PO4('04_GAS',j,z);
1279   PCEoilO(j,z)$XSTO(j,z)    = PO4('03_OIL',j,z);
1280   PCEpetrolO(j,z)$XSTO(j,z) = PO4('10_PETROLCOAL',j,z);
1281   PCEoilpetrolO(j,z)$XSTO(j,z)
1282      = [ PCEoilO(j,z) * DEoilO(j,z) + PCEpetrolO(j,z) * DEpetrolO(j,z) ] / DEoilpetrolO(j,z);
1283   PCEcoalgasO(j,z)$XSTO(j,z)
1284      = [ PCEcoalO(j,z) * DEcoalO(j,z) + PCEgasO(j,z) * DEgasO(j,z) ] / DEcoalgasO(j,z);
1285   PCEnelecO(j,z)$XSTO(j,z)
1286      = [ PCEcoalgasO(j,z) * DEcoalgasO(j,z) + PCEoilpetrolO(j,z) * DEoilpetrolO(j,z) ] / DEnelecO(j,z);
1287   PCEelecO(j,z)$XSTO(j,z)
1288      = SUM[ene4, PCO(ene4,z) * DEO(ene4,j,z)] / DEelecO(j,z);
1289   PCEO(j,z)$XSTO(j,z)
1290      = [ PCEelecO(j,z) * DEelecO(j,z) + PCEnelecO(j,z) * DEnelecO(j,z) ] / CEO(j,z);
1291   PCEO(j3,z)$XSTO(j3,z)
1292      = SUM[ene, PCO(ene,z) * DEO(ene,j3,z)] / CEO(j3,z);
1293   WTIO(j,z)$XSTO(j,z)       = WO(z) * (1 + ttiwO(j,z));
1294   WCO(j,z)$LDCO(j,z)        = (WTIO(j,z) * LDO(j,z)) / LDCO(j,z);
1295   
1296  *==============================================================================
1297  * Calibration of dynamic parameters
1298  *==============================================================================
1299   PKO(z)           = 1;
1300   KSTO(z)          = KSTO(z) / PKO(z);
1301   KSTO(z)          = KSTO(z) - SUM((BS,Z_GRN)$sameas(z, Z_GRN), PTSFO(BS,Z_GRN) * TSFO(BS,Z_GRN));
1302   delta(z)         = DEPO(z) / [PKO(z) * KSTO(z)];
1303   RO(k,j,z)$RKDO(k,j,z)
1304                    = SUM[(kj,jj), RKDO(kj,jj,z)] / KSTO(z);
1305   KDO(k,j,z)$RKDO(k,j,z)
1306                    = RKDO(k,j,z) / RO(k,j,z);
1307   KSO(k,z)         = SUM[j, KDO(k,j,z)];
1308   IRO(z)           = { SUM[(k,j)$RKDO(k,j,z), RKDO(k,j,z)] - DEPO(z) } / [PKO(z) * KSTO(z)];
1309   UO(z)            = PKO(z) * (IRO(z) + delta(z));
1310   phiO(z)          = [ITO(z) / PKO(z)] / KSTO(z);
1311   INDO(k,j,z)$KDO(k,j,z)
1312                    = phiO(z) * KDO(k,j,z);
1313   A_K(z)           = 1 / PKO(z) * { PROD[i$gamma_INV(i,z), (PCO(i,z) / gamma_INV(i,z))**gamma_INV(i,z)] };
1314   KDCO(j,z)        = SUM[k, KDO(k,j,z)];
1315   RTIO(k,j,z)      = RO(k,j,z) * (1 + ttikO(k,j,z));
1316   RCO(j,z)$KDCO(j,z)
1317                    = SUM[k, RTIO(k,j,z) * KDO(k,j,z)] / KDCO(j,z);
1318   
1319  *==============================================================================
1320  * Calibration of other prices and revised volumes
1321  *==============================================================================
1322   VAO(j,z)       = LDCO(j,z) + KDCO(j,z);
1323   PVAO(j,z)$XSTO(j,z)
1324                     = [ WCO(j,z) * LDCO(j,z) + RCO(j,z) * KDCO(j,z) ] / VAO(j,z);
1325   KLEO(j,z)$XSTO(j,z)  = CEO(j,z) + VAO(j,z);
1326   
1327   PKLEO(j,z)$XSTO(j,z)
1328                      = [PCEO(j,z) * CEO(j,z) + PVAO(j,z) * VAO(j,z)] / KLEO(j,z);
1329   VATO(BS, Z_GRN)      = VAO(BS, Z_GRN) + TSFO(BS, Z_GRN);
1330   PVATO(BS, Z_GRN)
1331                      = [PVAO(BS, Z_GRN) * VAO(BS, Z_GRN) + PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN)] / VATO(BS, Z_GRN);
1332   PIXGDPO(z)           = 1;
1333   PIXGDP_WO          = 1;
1334   PIXCONO(z)           = 1;
1335   PIXCONO_lag(z)     = PIXCONO(z);
1336   PIXINVO(z)            = 1;
1337   PIXGVTO(z)           = 1;
1338   PPOWERO(z)         = 1;
1339   PBSO(BS, Z_GRN)  = 1.0;
1340   
1341  *==============================================================================
1342  * Calibration of LES parameters
1343  *==============================================================================
1344   sigma_Y(i,z)   = sigma_Y(i,z) / { SUM[ij, sigma_Y(ij,z) * PCO(ij,z) * CO(ij,z)] / CTHO(z) };
1345   gamma_LES(i,z) = PCO(i,z) * CO(i,z) * sigma_Y(i,z) / CTHO(z);
1346   CMINO(i,z)     = CO(i,z) + gamma_LES(i,z) * CTHO(z) / {PCO(i,z) * frisch(z)};
1347   
1348  * ==============================================================================
1349  * Calculation of Economy-Wide Ex-ante Own-Price Elasticities for Energy
1350  * (Industries + Households + Government + Investment + Exports)
1351  * ==============================================================================
      PARAMETERS
      * 1. Industry Nest Shares
          S_E_KLE(j,z), S_NE_E(j,z), S_Elec_E(j,z)
          S_CG_NE(j,z), S_OP_NE(j,z)
          S_Coal_CG(j,z), S_Gas_CG(j,z), S_Oil_OP(j,z), S_Petrol_OP(j,z)
          
      * 2. Armington & Demand Shares
          S_DOM(i,z)           Share of Domestic product in composite demand
          W_IND(i,j,z)         Share of Industry j in Total Composite Demand QO
          W_HH(i,z)            Share of Household in Total Composite Demand QO
          W_INV(i,z)           Share of Investment in Total Composite Demand QO
          W_GOV(i,z)           Share of Government in Total Composite Demand QO
          W_DDO(i,z)           Share of Domestic Sales in Total Output
          W_EXTO(i,z)          Share of Export Sales in Total Output
          Val_Total(i,z)       Total Value of Domestic and Export Sales
          
      * 3. Composite Price Elasticities by Agent (Imported + Domestic)
          Elas_Comp_IND(ene,j,z) Composite elasticity for Industry
          Elas_Comp_HH(ene,z)    Composite elasticity for Household (LES)
          Elas_Comp_INV(ene,z)   Composite elasticity for Investment (Cobb-Douglas = -1)
          Elas_Comp_GOV(ene,z)   Composite elasticity for Government (Cobb-Douglas = -1)
          
      * 4. Domestic Price Elasticities by Agent
          Elas_Dom_IND(ene,j,z)  Domestic elasticity for Industry
          Elas_Dom_HH(ene,z)     Domestic elasticity for Household
          Elas_Dom_INV(ene,z)    Domestic elasticity for Investment
          Elas_Dom_GOV(ene,z)    Domestic elasticity for Government
          Elas_EXP(ene,z)        Export elasticity (based on importer's sigma_M2)
          
      * 5. Economy-Wide Price Elasticities
          Elas_Total_DDO(ene,z)  Weighted elasticity of Total Domestic Demand (DDO)
          Elas_Total_ECON(ene,z) Economy-wide Ex-ante Price Elasticity of Energy Commodity
      ;
       
      * ------------------------------------------------------------------------------
      * Step 1. Calculate Shares
      * ------------------------------------------------------------------------------
      * Industry nest shares
      S_E_KLE(j2,z)$(PKLEO(j2,z)*KLEO(j2,z)) = (PCEO(j2,z)*CEO(j2,z)) / (PKLEO(j2,z)*KLEO(j2,z));
      S_NE_E(j2,z)$(PCEO(j2,z)*CEO(j2,z))    = (PCEnelecO(j2,z)*DEnelecO(j2,z)) / (PCEO(j2,z)*CEO(j2,z));
      S_Elec_E(j2,z)$(PCEO(j2,z)*CEO(j2,z))  = (PCEelecO(j2,z)*DEelecO(j2,z)) / (PCEO(j2,z)*CEO(j2,z));
      S_CG_NE(j2,z)$(PCEnelecO(j2,z)*DEnelecO(j2,z)) = (PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)) / (PCEnelecO(j2,z)*DEnelecO(j2,z));
      S_OP_NE(j2,z)$(PCEnelecO(j2,z)*DEnelecO(j2,z)) = (PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)) / (PCEnelecO(j2,z)*DEnelecO(j2,z));
      S_Coal_CG(j2,z)$(PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)) = (PCO('02_COAL',z)*DEO('02_COAL',j2,z)) / (PCEcoalgasO(j2,z)*DEcoalgasO(j2,z));
      S_Gas_CG(j2,z)$(PCEcoalgasO(j2,z)*DEcoalgasO(j2,z))  = (PCO('04_GAS',z)*DEO('04_GAS',j2,z)) / (PCEcoalgasO(j2,z)*DEcoalgasO(j2,z));
      S_Oil_OP(j2,z)$(PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)) = (PCO('03_OIL',z)*DEO('03_OIL',j2,z)) / (PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z));
      S_Petrol_OP(j2,z)$(PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)) = (PCO('10_PETROLCOAL',z)*DEO('10_PETROLCOAL',j2,z)) / (PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z));
       
      * Armington domestic shares (DDO relative to QO)
      S_DOM(ene,z)$(PCO(ene,z)*QO(ene,z)) = (PDO(ene,z)*DDO(ene,z)) / (PCO(ene,z)*QO(ene,z));
       
      * Consumption share of each agent in total domestic composite (QO)
      W_IND(ene,j,z)$QO(ene,z) = DEO(ene,j,z) / QO(ene,z);
      W_HH(ene,z)$QO(ene,z)    = CO(ene,z) / QO(ene,z);
      W_INV(ene,z)$QO(ene,z)   = INVO(ene,z) / QO(ene,z);
      W_GOV(ene,z)$QO(ene,z)   = CGO(ene,z) / QO(ene,z);
       
      * Share of domestic sales (DDO) and exports (EXTO) in total national output
      Val_Total(ene,z) = PDO(ene,z)*DDO(ene,z) + PETO(ene,z)*EXTO(ene,z);
      W_DDO(ene,z)$Val_Total(ene,z)  = (PDO(ene,z)*DDO(ene,z)) / Val_Total(ene,z);
      W_EXTO(ene,z)$Val_Total(ene,z) = (PETO(ene,z)*EXTO(ene,z)) / Val_Total(ene,z);
       
      * ------------------------------------------------------------------------------
      * Step 2. Calculate Composite Price Elasticities by Agent
      * ------------------------------------------------------------------------------
      * 1. Industry (Only KLE industries have elasticity, Non-KLE is Leontief so 0)
      Elas_Comp_IND('02_COAL',j2,z)$DEO('02_COAL',j2,z) = 
          - (1 - S_Coal_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Coal_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
          - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
      Elas_Comp_IND('04_GAS',j2,z)$DEO('04_GAS',j2,z) = 
          - (1 - S_Gas_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Gas_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
          - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
      Elas_Comp_IND('03_OIL',j2,z)$DEO('03_OIL',j2,z) = 
          - (1 - S_Oil_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Oil_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
          - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
      Elas_Comp_IND('10_PETROLCOAL',j2,z)$DEO('10_PETROLCOAL',j2,z) = 
          - (1 - S_Petrol_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Petrol_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
          - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
      Elas_Comp_IND('18_ELEC',j2,z)$DEO('18_ELEC',j2,z) = 
          - (1 - S_Elec_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Elec_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
      Elas_Comp_IND(ene,j3,z)$DEO(ene,j3,z) = 0;
       
      * 2. Household (LES Function)
      Elas_Comp_HH(ene,z)$CO(ene,z) = CMINO(ene,z) / CO(ene,z) * (1 - gamma_LES(ene,z)) - 1;
       
      * 3. Investment & Government (Cobb-Douglas Expenditure)
      Elas_Comp_INV(ene,z)$INVO(ene,z) = -1.0;
      Elas_Comp_GOV(ene,z)$CGO(ene,z)  = -1.0;
       
      * ------------------------------------------------------------------------------
      * Step 3. Derive Domestic Energy Price Elasticities by Agent (incorporating Armington effect)
      * ------------------------------------------------------------------------------
      Elas_Dom_IND(ene,j,z)$DEO(ene,j,z) = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_IND(ene,j,z);
      Elas_Dom_HH(ene,z)$CO(ene,z)       = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_HH(ene,z);
      Elas_Dom_INV(ene,z)$INVO(ene,z)    = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_INV(ene,z);
      Elas_Dom_GOV(ene,z)$CGO(ene,z)     = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_GOV(ene,z);
       
      * Exports (Weighted average of trading partners' import substitution elasticity sigma_M2)
      Elas_EXP(ene,z)$EXTO(ene,z) = SUM(zj$EXO(ene,z,zj), (EXO(ene,z,zj)/EXTO(ene,z)) * (-sigma_M2(ene,zj)));
       
      * ------------------------------------------------------------------------------
      * Step 4. Derive Economy-Wide Energy Price Elasticity (Aggregation)
      * ------------------------------------------------------------------------------
      * Domestic demand aggregation (Weighted Average of Domestic Agents)
      Elas_Total_DDO(ene,z) = 
          SUM(j, W_IND(ene,j,z) * Elas_Dom_IND(ene,j,z)) 
          + W_HH(ene,z)  * Elas_Dom_HH(ene,z) 
          + W_INV(ene,z) * Elas_Dom_INV(ene,z) 
          + W_GOV(ene,z) * Elas_Dom_GOV(ene,z);
       
      * Domestic + Export aggregation (Final Economy-Wide Elasticity)
      Elas_Total_ECON(ene,z) = 
          W_DDO(ene,z) * Elas_Total_DDO(ene,z) + W_EXTO(ene,z) * Elas_EXP(ene,z);
       
      DISPLAY Elas_Total_ECON, Elas_Total_DDO, Elas_Dom_HH, Elas_EXP;
       
      * ==============================================================================
      * Step 0. Set Target Elasticities and Iterative Algorithm Parameters
      * ==============================================================================
      TABLE Target_Elas(ene,z) Target economy-wide elasticities by region and energy commodity
                     01_KOR  02_CHN  03_JPN  04_RUS  05_MNG  06_PRK  07_NAM  08_LAM  09_WEU  10_EEU  11_CAS  12_MEA  13_AFR  14_CLV  15_SAS  16_APC  17_ANZ
      02_COAL         -0.88   -0.46   -0.74   -0.30   -0.58   -0.30   -0.97   -0.50   -1.03   -0.85   -0.67   -0.76   -0.82   -0.46   -0.71   -1.12   -0.80
      03_OIL          -0.52   -0.34   -0.54   -0.15   -0.66   -0.15   -0.92   -0.58   -0.74   -0.45   -0.15   -0.39   -0.95   -0.34   -0.98   -0.52   -0.99
      04_GAS          -0.74   -1.16   -0.52   -0.30   -0.67   -0.15   -0.73   -0.69   -0.85   -0.71   -0.57   -0.62   -0.69   -1.16   -0.18   -0.15   -1.25
      10_PETROLCOAL   -0.52   -0.34   -0.54   -0.15   -0.66   -0.15   -0.92   -0.58   -0.74   -0.45   -0.15   -0.39   -0.95   -0.34   -0.98   -0.52   -0.99
      18_ELEC         -0.48   -0.42   -0.45   -0.21   -0.35   -0.21   -0.49   -0.47   -0.30   -0.26   -0.21   -0.37   -0.57   -0.42   -0.29   -0.30   -0.29
      ;
       
      * Set targets based on DDO
      Parameter Target_ECON(ene,z);
      Target_ECON('02_COAL',z) = Target_Elas('02_COAL',z);
      Target_ECON('03_OIL',z) = Target_Elas('03_OIL',z);
      Target_ECON('04_GAS',z) = Target_Elas('04_GAS',z);
      Target_ECON('10_PETROLCOAL',z) = Target_Elas('10_PETROLCOAL',z);
      Target_ECON('18_ELEC',z) = Target_Elas('18_ELEC',z);
       
      SET iter Maximum number of iterations / 1*1000 /;
      SCALAR step Update speed (Damping factor) / 0.15 /;
      PARAMETER Adj_Ratio(ene,z) Ratio to target;
      PARAMETER Ind_Total_Weight(ene,z) Total industry weight;
      Ind_Total_Weight(ene,z) = SUM(j, W_IND(ene,j,z));
       
      * ==============================================================================
      * Declare temporary parameters before entering the loop (for calculating error weights by industry)
      * ==============================================================================
      PARAMETER Ind_Err_CG(j,z) Weighted average error of Coal-Gas nest by industry;
      PARAMETER Ind_Err_OP(j,z) Weighted average error of Oil products nest by industry;
      PARAMETER Ind_Err_NE(j,z) Weighted average error of Non-Elec nest by industry;
      PARAMETER Ind_Err_Tot(j,z) Weighted average error of total energy by industry;
       
      * ==============================================================================
      * Algorithm Start
      * ==============================================================================
      LOOP(iter,
      * --------------------------------------------------------------------------
      * 1. Recalculate elasticity based on currently updated sigma values
      * --------------------------------------------------------------------------
          Elas_Comp_IND('02_COAL',j2,z)$DEO('02_COAL',j2,z) = 
              - (1 - S_Coal_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Coal_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
              - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
       
          Elas_Comp_IND('04_GAS',j2,z)$DEO('04_GAS',j2,z) = 
              - (1 - S_Gas_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Gas_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
              - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
       
          Elas_Comp_IND('03_OIL',j2,z)$DEO('03_OIL',j2,z) = 
              - (1 - S_Oil_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Oil_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
              - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
       
          Elas_Comp_IND('10_PETROLCOAL',j2,z)$DEO('10_PETROLCOAL',j2,z) = 
              - (1 - S_Petrol_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Petrol_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
              - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
       
          Elas_Comp_IND('18_ELEC',j2,z)$DEO('18_ELEC',j2,z) = 
              - (1 - S_Elec_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Elec_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
       
          Elas_Dom_IND(ene,j,z)$DEO(ene,j,z) = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_IND(ene,j,z);
          Elas_Dom_HH(ene,z)$CO(ene,z)       = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_HH(ene,z);
          Elas_Dom_INV(ene,z)$INVO(ene,z)    = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_INV(ene,z);
          Elas_Dom_GOV(ene,z)$CGO(ene,z)     = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_GOV(ene,z);
       
          Elas_Total_DDO(ene,z) = 
              SUM(j, W_IND(ene,j,z) * Elas_Dom_IND(ene,j,z)) 
              + W_HH(ene,z)  * Elas_Dom_HH(ene,z) 
              + W_INV(ene,z) * Elas_Dom_INV(ene,z) 
              + W_GOV(ene,z) * Elas_Dom_GOV(ene,z);
       
          Elas_EXP(ene,z)$EXTO(ene,z) = SUM(zj$EXO(ene,z,zj), (EXO(ene,z,zj)/EXTO(ene,z)) * (-sigma_M2(ene,zj)));
          Elas_Total_ECON(ene,z) = W_DDO(ene,z) * Elas_Total_DDO(ene,z) + W_EXTO(ene,z) * Elas_EXP(ene,z);
       
      * --------------------------------------------------------------------------
      * 2. Calculate error ratio at the national level (Initialize first, keep 1.0 for fuels without target)
      * --------------------------------------------------------------------------
          Adj_Ratio(ene,z) = 1.0;
          Adj_Ratio(ene,z)$(Elas_Total_ECON(ene,z) ne 0 and Target_ECON(ene,z) ne 0) = Target_ECON(ene,z) / Elas_Total_ECON(ene,z);
          Adj_Ratio(ene,z) = max(0.2, min(5.0, Adj_Ratio(ene,z)));
       
      * --------------------------------------------------------------------------
      * 3. Parameter Update (Reflecting high-precision industry-specific nest weights)
      * --------------------------------------------------------------------------
          sigma_M1(ene,z)$(1 - S_DOM(ene,z) > 0.05) = sigma_M1(ene,z) * (1 + step * (Adj_Ratio(ene,z) - 1));
       
          LOOP(j2,
      * A. Derive weighted average error by nest within each industry (j2) (Follow the error of the fuel heavily consumed by the industry)
              Ind_Err_CG(j2,z)  = S_Coal_CG(j2,z)*Adj_Ratio('02_COAL',z) + S_Gas_CG(j2,z)*Adj_Ratio('04_GAS',z);
              Ind_Err_OP(j2,z)  = S_Oil_OP(j2,z)*Adj_Ratio('03_OIL',z)   + S_Petrol_OP(j2,z)*Adj_Ratio('10_PETROLCOAL',z);
              Ind_Err_NE(j2,z)  = S_CG_NE(j2,z)*Ind_Err_CG(j2,z)         + S_OP_NE(j2,z)*Ind_Err_OP(j2,z);
              Ind_Err_Tot(j2,z) = S_Elec_E(j2,z)*Adj_Ratio('18_ELEC',z)  + S_NE_E(j2,z)*Ind_Err_NE(j2,z);
       
      * B. Parameter modification (Cross-application according to mathematical partial derivative structure)
      * Lower nests dominate the elasticity of minority fuels, so track errors inversely (Cross)
              sigma_ENER_coalgas(j2,z) = sigma_ENER_coalgas(j2,z) * (1 + step * ( S_Coal_CG(j2,z)*Adj_Ratio('04_GAS',z) + S_Gas_CG(j2,z)*Adj_Ratio('02_COAL',z) - 1 ));
              sigma_ENER_oilprod(j2,z) = sigma_ENER_oilprod(j2,z) * (1 + step * ( S_Oil_OP(j2,z)*Adj_Ratio('10_PETROLCOAL',z) + S_Petrol_OP(j2,z)*Adj_Ratio('03_OIL',z) - 1 ));
       
      * Upper nests dominate the elasticity of majority fuels, so track the weighted average of the nest
              sigma_ENER_nelec(j2,z) = sigma_ENER_nelec(j2,z) * (1 + step * (Ind_Err_NE(j2,z) - 1));
       
      * Cross nest (Cross-application of errors between electricity and non-electricity)
              sigma_ENER_elec(j2,z) = sigma_ENER_elec(j2,z) * (1 + step * ( S_NE_E(j2,z)*Adj_Ratio('18_ELEC',z) + S_Elec_E(j2,z)*Ind_Err_NE(j2,z) - 1 ));
       
      * Top KLE elasticity tracks the integrated energy error of the entire industry
              sigma_KLE(j2,z) = sigma_KLE(j2,z) * (1 + (step/2) * (Ind_Err_Tot(j2,z) - 1));
          );
       
      * --------------------------------------------------------------------------
      * 4. Logical Constraints for Parameters
      * --------------------------------------------------------------------------
          sigma_M1(ene,z) = max(0.5, min(15.0, sigma_M1(ene,z)));
          sigma_M2(ene,z) = max(0.5, min(30.0, sigma_M2(ene,z)));    
          sigma_ENER_coalgas(j,z) = max(0.5, min(3.0, sigma_ENER_coalgas(j,z)));
          sigma_ENER_oilprod(j,z) = max(0.5, min(3.0, sigma_ENER_oilprod(j,z)));
          sigma_ENER_nelec(j,z)   = max(0.5, min(3.0, sigma_ENER_nelec(j,z)));  
          sigma_ENER_elec(j,z)    = max(0.5, min(3.0, sigma_ENER_elec(j,z)));
          sigma_KLE(j,z)          = max(0.5, min(3.0, sigma_KLE(j,z)));
       
      * [Step 2] Add deadzone constraints to avoid elasticities near 1.0 (0.9 ~ 1.1)
      * Fix to 0.9 if value is > 0.9 and <= 1.0
      * Fix to 1.1 if value is > 1.0 and < 1.1
       
          sigma_M1(ene,z)$(sigma_M1(ene,z) > 0.9 and sigma_M1(ene,z) <= 1.0) = 0.9;
          sigma_M1(ene,z)$(sigma_M1(ene,z) > 1.0 and sigma_M1(ene,z) <  1.1) = 1.1;
       
          sigma_M2(ene,z)$(sigma_M2(ene,z) > 0.9 and sigma_M2(ene,z) <= 1.0) = 0.9;
          sigma_M2(ene,z)$(sigma_M2(ene,z) > 1.0 and sigma_M2(ene,z) <  1.1) = 1.1;
       
          sigma_ENER_coalgas(j,z)$(sigma_ENER_coalgas(j,z) > 0.9 and sigma_ENER_coalgas(j,z) <= 1.0) = 0.9;
          sigma_ENER_coalgas(j,z)$(sigma_ENER_coalgas(j,z) > 1.0 and sigma_ENER_coalgas(j,z) <  1.1) = 1.1;
       
          sigma_ENER_oilprod(j,z)$(sigma_ENER_oilprod(j,z) > 0.9 and sigma_ENER_oilprod(j,z) <= 1.0) = 0.9;
          sigma_ENER_oilprod(j,z)$(sigma_ENER_oilprod(j,z) > 1.0 and sigma_ENER_oilprod(j,z) <  1.1) = 1.1;
       
          sigma_ENER_nelec(j,z)$(sigma_ENER_nelec(j,z) > 0.9 and sigma_ENER_nelec(j,z) <= 1.0) = 0.9;
          sigma_ENER_nelec(j,z)$(sigma_ENER_nelec(j,z) > 1.0 and sigma_ENER_nelec(j,z) <  1.1) = 1.1;
       
          sigma_ENER_elec(j,z)$(sigma_ENER_elec(j,z) > 0.9 and sigma_ENER_elec(j,z) <= 1.0) = 0.9;
          sigma_ENER_elec(j,z)$(sigma_ENER_elec(j,z) > 1.0 and sigma_ENER_elec(j,z) <  1.1) = 1.1;
       
          sigma_KLE(j,z)$(sigma_KLE(j,z) > 0.9 and sigma_KLE(j,z) <= 1.0) = 0.9;
          sigma_KLE(j,z)$(sigma_KLE(j,z) > 1.0 and sigma_KLE(j,z) <  1.1) = 1.1;
       
      );
1615  *==============================================================================
1616  * Calibration of function parameters
1617  *==============================================================================
1618   io(j,z)$XSTO(j,z)         = CIO(j,z) / XSTO(j,z);
1619   io2(j,z)$XSTO(j,z)        = CEO(j,z) / XSTO(j,z);
1620   v(j,z)$XSTO(j,z)          = VAO(j,z) / XSTO(j,z);
1621   v2(j,z)$XSTO(j,z)         = (CEO(j,z) + VAO(j,z)) / XSTO(j,z);
1622   aij(nene,j,z)$XSTO(j,z)   = DIO(nene,j,z) / CIO(j,z);
1623   aij2(ene,j,z)$XSTO(j,z)   = DEO(ene,j,z) / CEO(j,z);
1624   aij_t(nene,j,z,time)      = aij(nene,j,z);
1625   aij2_t(ene,j,z,time)      = aij2(ene,j,z);
1626   
1627  *==============================================================================
1628  * Calibration of CET parameters
1629  *==============================================================================
1630   rho_X1(i,z) = (1 + sigma_X1(i,z)) / sigma_X1(i,z);
1631   beta_EX_X1(i,z)$MRGNO(i,z)
1632      = [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z)) ] /
1633        [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z))
1634        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z))
1635        + eO(z)     * PWMGO(i) * MRGNO(i,z)$MRGNO(i,z)**(1 - rho_X1(i,z)) ];
1636   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1637      = [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z)) ] /
1638        [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z))
1639        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z)) ];
1640   beta_D_X1(i,z)$MRGNO(i,z)
1641      = [ PLO(i,z) * DSO_I(i,z)**(1 - rho_X1(i,z)) ] /
1642        [ PETO(i,z) * EXTO(i,z)**(1 - rho_X1(i,z))
1643        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z))
1644        + eO(z)     * PWMGO(i) * MRGNO(i,z)**(1 - rho_X1(i,z)) ];
1645   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1646      = [ PLO(i,z) * DSO_I(i,z)**(1 - rho_X1(i,z)) ] /
1647        [ PETO(i,z) * EXTO(i,z)**(1 - rho_X1(i,z))
1648        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z)) ];
1649   B_X1(i,z)
1650      = XSO_I(i,z) /
1651        [ beta_EX_X1(i,z) * EXTO(i,z)**rho_X1(i,z)
1652        + beta_D_X1(i,z)  * DSO_I(i,z)**rho_X1(i,z)
1653        + (1 - beta_EX_X1(i,z) - beta_D_X1(i,z)) * MRGNO(i,z)**rho_X1(i,z)
1654        ]**(1 / rho_X1(i,z));
1655   
1656  *==============================================================================
1657  * CET between exports to different trading partners
1658  *==============================================================================
1659   rho_X2(i,z) = (1 + sigma_X2(i,z)) / sigma_X2(i,z);
1660   beta_X2(i,z,zj)$EXO(i,z,zj)
1661      = [ PEO(i,z,zj) * EXO(i,z,zj)**(1 - rho_X2(i,z)) ] /
1662        SUM[zjj$EXO(i,z,zjj), PEO(i,z,zjj) * EXO(i,z,zjj)**(1 - rho_X2(i,z)) ];
1663   B_X2(i,z)
1664      = EXTO(i,z) /
1665        { SUM[zj, beta_X2(i,z,zj) * EXO(i,z,zj)**rho_X2(i,z)]**(1 / rho_X2(i,z)) };
1666   
1667  *==============================================================================
1668  * Calibration of CES parameters
1669  *==============================================================================
1670  *Multi Output
1671   rho_MultiOut(i,z) = (1 - sigma_MultiOut(i,z)) / sigma_MultiOut(i,z);
1672   beta_MultiOut(j,i,z)$XSO(j,i,z)
1673      = [ PO2(j,i,z) * XSO(j,i,z)**(1 + rho_MultiOut(i,z)) ] /
1674        SUM[jj$XSO(jj,i,z), PO2(jj,i,z) * XSO(jj,i,z)**(1 + rho_MultiOut(i,z)) ];
1675   B_MultiOut(i,z)
1676      = XSO_I(i,z) /
1677        SUM[jj$XSO(jj,i,z), beta_MultiOut(jj,i,z) * XSO(jj,i,z)**(-rho_MultiOut(i,z))]**(-1 / rho_MultiOut(i,z));
1678   
1679  *Aggregated Electricity
1680   QPOWERO(z) = SUM(POWER, XSO(power,'18_ELEC',z));
1681   rho_POWER(z)  = (1 - sigma_POWER(z)) / sigma_POWER(z);
1682   beta_POWER(power,z)
1683      = [ PO2(power,'18_ELEC',z) * XSO(power,'18_ELEC',z)**(1 + rho_POWER(z)) ] /
1684        SUM[powerr$XSO(powerr,'18_ELEC',z), PO2(powerr,'18_ELEC',z) * XSO(powerr,'18_ELEC',z)**(1 + rho_POWER(z)) ];
1685   B_POWER(z)
1686      = QPOWERO(z) /
1687        SUM[powerr$XSO(powerr,'18_ELEC',z), beta_POWER(powerr,z) * XSO(powerr,'18_ELEC',z)**(-rho_POWER(z))]**(-1 / rho_POWER(z));
1688   TnDShare(z) = XSO('18_TnD','18_ELEC',z) / XSO_I('18_ELEC',z);
1689   
1690  *Backstop
1691  LOOP(MAP_BS(bs, conv, I_BS),
1692   
1693      QBSO(bs, Z_GRN) = XSO(conv, I_BS, Z_GRN) + XSO(bs, I_BS, Z_GRN);
1694   
1695      rho_BS(bs, Z_GRN) = (1 - sigma_BS(bs, Z_GRN)) / sigma_BS(bs, Z_GRN);
1696   
1697      beta_BS(conv, I_BS, Z_GRN)
1698          = [ PO2(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] /
1699            ( [ PO2(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] +
1700              [ PO2(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] );
1701   
1702      beta_BS(bs, I_BS, Z_GRN)
1703          = [ PO2(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] /
1704            ( [ PO2(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] +
1705              [ PO2(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] );
1706   
1707      B_BS(bs, Z_GRN)
1708          = QBSO(bs, Z_GRN) /
1709            ( beta_BS(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(-rho_BS(bs, Z_GRN)) +
1710              beta_BS(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(-rho_BS(bs, Z_GRN)) )**(-1 / rho_BS(bs, Z_GRN));
1711   
1712      beta_BS_t(conv, I_BS, Z_GRN, time) = beta_BS(conv, I_BS, Z_GRN);
1713      beta_BS_t(bs, I_BS, Z_GRN, time)   = beta_BS(bs, I_BS, Z_GRN);
1714  );
1715   
1716  *==============================================================================
1717  * Composite good
1718  *==============================================================================
1719   rho_M1(i,z) = (1 - sigma_M1(i,z)) / sigma_M1(i,z);
1720   beta_M1(i,z)
1721      = PMTO(i,z) * IMTO(i,z)**(rho_M1(i,z) + 1) /
1722        { PDO(i,z)  * DDO(i,z)**(rho_M1(i,z) + 1)
1723        + PMTO(i,z) * IMTO(i,z)**(rho_M1(i,z) + 1) };
1724   B_M1(i,z)
1725      = QO(i,z) /
1726        { beta_M1(i,z) * IMTO(i,z)**(-rho_M1(i,z))
1727        + (1 - beta_M1(i,z)) * DDO(i,z)**(-rho_M1(i,z)) }**(-1 / rho_M1(i,z));
1728   
1729  *==============================================================================
1730  * CES between imports from different trading partners
1731  *==============================================================================
1732   rho_M2(i,z) = (1 - sigma_M2(i,z)) / sigma_M2(i,z);
1733   beta_M2(i,zj,z)$IMO(i,zj,z)
1734      = [ PMO(i,zj,z) * IMO(i,zj,z)**(rho_M2(i,z) + 1) ] /
1735        SUM[zjj$IMO(i,zjj,z), PMO(i,zjj,z) * IMO(i,zjj,z)**(rho_M2(i,z) + 1) ];
1736   B_M2(i,z)
1737      = IMTO(i,z) /
1738        { SUM[zj$IMO(i,zj,z), beta_M2(i,zj,z) * IMO(i,zj,z)**(-rho_M2(i,z))]**(-1 / rho_M2(i,z)) };
1739   
1740  *==============================================================================
1741  * Composite capital
1742  *==============================================================================
1743   rho_KD(j,z) = (1 - sigma_KD(j,z)) / sigma_KD(j,z);
1744   beta_KD(k,j,z)$KDO(k,j,z)
1745      = [ RTIO(k,j,z) * KDO(k,j,z)**(1 + rho_KD(j,z)) ] /
1746        SUM[kj$KDO(kj,j,z), RTIO(kj,j,z) * KDO(kj,j,z)**(1 + rho_KD(j,z)) ];
1747   B_KD(j,z)$KDCO(j,z)
1748      = KDCO(j,z) /
1749        { SUM[k$KDO(k,j,z), beta_KD(k,j,z) * KDO(k,j,z)**(-rho_KD(j,z))]**(-1 / rho_KD(j,z)) };
1750   
1751  *===============================================================================
1752  * Composite E
1753  *===============================================================================
1754  * Level 5_1 (Coal/Gas)
1755   rho_ENER_coalgas(j2,z) = (1 - sigma_ENER_coalgas(j2,z)) / sigma_ENER_coalgas(j2,z);
1756   beta_ENER_coalgas(ene5,j2,z)
1757      = [ PO4(ene5,j2,z) * DEO(ene5,j2,z)**(1 + rho_ENER_coalgas(j2,z)) ] /
1758        SUM[enee5, PO4(enee5,j2,z) * DEO(enee5,j2,z)**(1 + rho_ENER_coalgas(j2,z)) ];
1759   B_ENER_coalgas(j2,z)
1760      = DEcoalgasO(j2,z) /
1761        { SUM[ene5, beta_ENER_coalgas(ene5,j2,z) * DEO(ene5,j2,z)**(-rho_ENER_coalgas(j2,z))] }**(-1 / rho_ENER_coalgas(j2,z));
1762   
1763  * Level 5_2 (Oil/Petrol)
1764   rho_ENER_oilprod(j2,z) = (1 - sigma_ENER_oilprod(j2,z)) / sigma_ENER_oilprod(j2,z);
1765   beta_ENER_oilprod(ene6,j2,z)
1766      = [ PO4(ene6,j2,z) * DEO(ene6,j2,z)**(1 + rho_ENER_oilprod(j2,z)) ] /
1767        SUM[enee6, PO4(enee6,j2,z) * DEO(enee6,j2,z)**(1 + rho_ENER_oilprod(j2,z)) ];
1768   B_ENER_oilprod(j2,z)
1769      = DEoilpetrolO(j2,z) /
1770        { SUM[ene6, beta_ENER_oilprod(ene6,j2,z) * DEO(ene6,j2,z)**(-rho_ENER_oilprod(j2,z))] }**(-1 / rho_ENER_oilprod(j2,z));
1771   
1772  * Level 4 (Coal-Gas / Oil-Petrol)
1773   rho_ENER_nelec(j2,z) = (1 - sigma_ENER_nelec(j2,z)) / sigma_ENER_nelec(j2,z);
1774   beta_ENER_nelec(j2,z)
1775      = PCEcoalgasO(j2,z) * DEcoalgasO(j2,z)**(rho_ENER_nelec(j2,z) + 1) /
1776        { PCEcoalgasO(j2,z) * DEcoalgasO(j2,z)**(rho_ENER_nelec(j2,z) + 1)
1777        + PCEoilpetrolO(j2,z) * DEoilpetrolO(j2,z)**(rho_ENER_nelec(j2,z) + 1) };
1778   B_ENER_nelec(j2,z)
1779      = DEnelecO(j2,z) /
1780        { [ beta_ENER_nelec(j2,z) * DEcoalgasO(j2,z)**(-rho_ENER_nelec(j2,z))
1781          + (1 - beta_ENER_nelec(j2,z)) * DEoilpetrolO(j2,z)**(-rho_ENER_nelec(j2,z)) ] }**(-1 / rho_ENER_nelec(j2,z));
1782   
1783  * Level 2 (Elec / Non-Elec)
1784   rho_ENER_elec(j2,z) = (1 - sigma_ENER_elec(j2,z)) / sigma_ENER_elec(j2,z);
1785   beta_ENER_elec(j2,z)
1786      = PCEelecO(j2,z) * DEelecO(j2,z)**(rho_ENER_elec(j2,z) + 1) /
1787        { PCEelecO(j2,z) * DEelecO(j2,z)**(rho_ENER_elec(j2,z) + 1)
1788        + PCEnelecO(j2,z) * DEnelecO(j2,z)**(rho_ENER_elec(j2,z) + 1) };
1789   B_ENER_elec(j2,z)
1790      = CEO(j2,z) /
1791        { [ beta_ENER_elec(j2,z) * DEelecO(j2,z)**(-rho_ENER_elec(j2,z))
1792          + (1 - beta_ENER_elec(j2,z)) * DEnelecO(j2,z)**(-rho_ENER_elec(j2,z)) ] }**(-1 / rho_ENER_elec(j2,z));
1793   
1794  *==============================================================================
1795  * Value added
1796  *==============================================================================
1797   rho_VA(j,z) = (1 - sigma_VA(j,z)) / sigma_VA(j,z);
1798   beta_VA(j,z)$KDCO(j,z)
1799      = WCO(j,z) * LDCO(j,z)**(rho_VA(j,z) + 1) /
1800        { WCO(j,z) * LDCO(j,z)**(rho_VA(j,z) + 1)
1801        + RCO(j,z) * KDCO(j,z)**(rho_VA(j,z) + 1) };
1802   B_VA(j,z)$KDCO(j,z)
1803      = VAO(j,z) /
1804        { [ beta_VA(j,z) * LDCO(j,z)**(-rho_VA(j,z))
1805          + (1 - beta_VA(j,z)) * KDCO(j,z)**(-rho_VA(j,z)) ] }**(-1 / rho_VA(j,z));
1806   B_VA_t(j,z,time) = B_VA(j,z);
1807   
1808  *==============================================================================
1809  * Calibration of VAT nest for ALL Backstop Sectors (BS)
1810  *==============================================================================
1811  rho_VAT(BS, Z_GRN)   = (1 - sigma_VAT(BS, Z_GRN)) / sigma_VAT(BS, Z_GRN);
1812   beta_VAT(BS, Z_GRN)
1813      = ( PVAO(BS, Z_GRN) * VAO(BS, Z_GRN)**(1 + rho_VAT(BS, Z_GRN)) ) /
1814        ( PVAO(BS, Z_GRN) * VAO(BS, Z_GRN)**(1 + rho_VAT(BS, Z_GRN))
1815        + PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN)**(1 + rho_VAT(BS, Z_GRN)) );
1816   B_VAT(BS, Z_GRN)
1817      = VATO(BS, Z_GRN) /
1818        ( beta_VAT(BS, Z_GRN) * VAO(BS, Z_GRN)**(-rho_VAT(BS, Z_GRN))
1819        + (1 - beta_VAT(BS, Z_GRN)) * TSFO(BS, Z_GRN)**(-rho_VAT(BS, Z_GRN)) )**(-1 / rho_VAT(BS, Z_GRN));
1820   v_vat(BS, Z_GRN)     = VATO(BS, Z_GRN) / XSTO(BS, Z_GRN);
1821   
1822   B_VAT_t(BS, Z_GRN, time) = B_VAT(BS, Z_GRN);
1823   
1824  *==============================================================================
1825  * Composite KLE
1826  *==============================================================================
1827   rho_KLE(j,z) = (1 - sigma_KLE(j,z)) / sigma_KLE(j,z);
1828   beta_KLE(j,z)$KLEO(j,z)
1829      = PVAO(j,z) * VAO(j,z)**(rho_KLE(j,z) + 1) /
1830        { PVAO(j,z) * VAO(j,z)**(rho_KLE(j,z) + 1)
1831        + PCEO(j,z) * CEO(j,z)**(rho_KLE(j,z) + 1) };
1832   beta_KLE2(j,z)$KLEO(j,z)
1833      = 1 - beta_KLE(j,z);
1834   
1835   B_KLE(j,z)$KLEO(j,z)
1836      = KLEO(j,z) /
1837        { [ beta_KLE(j,z) * VAO(j,z)**(-rho_KLE(j,z))
1838          + beta_KLE2(j,z) * CEO(j,z)**(-rho_KLE(j,z)) ] }**(-1 / rho_KLE(j,z));
1839   
1840  *==============================================================================
1841  * Calibration of gross domestic products
1842  *==============================================================================
1843   GDP_BPO(z)     = SUM[j, PVAO(j,z) * VAO(j,z)] + SUM[BS, PTSFO(BS,z) * TSFO(BS,z)] + TIPTO(z);
1844   GDP_MPO(z)     = GDP_BPO(z) + TPRCTSO(z);
1845   
1846   GDP_IBO(z)
1847      = SUM[(j), WO(z) * LDO(j,z)]
1848      + SUM[(k,j), RO(k,j,z) * KDO(k,j,z)]
1849      + SUM[BS, PTSFO(BS,z) * TSFO(BS,z)]
1850      + TPRODNO(z)
1851      + TPRCTSO(z);
1852   GDP_FDO(z)
1853      = SUM[i, PCO(i,z) * (CO(i,z) + CGO(i,z) + INVO(i,z))]
1854      + eO(z) * SUM[(i,zj), PWXO(i,z,zj) * EXO(i,z,zj)]
1855      + eO(z) * SUM[i, PWMGO(i) * MRGNO(i,z)]
1856      - eO(z) * SUM[(i,zj), IMO(i,zj,z) * (PWMO(i,zj,z) + SUM{ij, PWMGO(ij) * tmrg(ij,i,zj,z)})];
1857   GDP_BP_WO      = SUM[z, GDP_BPO(z) / eO(z)];
1858   
1859  *==============================================================================
1860  * Calibration of real (volume) variables computed from price indices
1861  *==============================================================================
1862   CABXO(z)       = CABO(z) / [PIXGDP_WO * eO(z)];
1863   CABXsur(z,T1)  = CABXO(z)$[CABXO(z) gt 0];
1864   CABXdef(z,T1)  = CABXO(z)$[CABXO(z) lt 0];
1865   CABXsur(z,time)$[ord(time) gt 1] = CABXO(z) * (1 + g_GDP(z,time))$[CABXO(z) gt 0];
1866   CABXdef(z,time)$[ord(time) gt 1] = CABXO(z) * (1 + g_GDP(z,time))$[CABXO(z) lt 0];
1867   Bal(time)      = SUM(zj, CABXsur(zj,time)) + SUM(zj, CABXdef(zj,time));
1868   mu(time)       = SUM(zj, CABXsur(zj,time)) /
1869                    { SUM(zj, CABXsur(zj,time)) + SUM(zj, ABS(CABXdef(zj,time))) };
1870   CABXsur(z,time) = CABXsur(z,time) * { 1 - mu(time) * Bal(time) / SUM(zj, CABXsur(zj,time)) };
1871   CABXdef(z,time) = CABXdef(z,time) * { 1 - [1 - mu(time)] * Bal(time) / SUM(zj, CABXdef(zj,time)) };
1872   CABix(z,time)   = [ CABXsur(z,time) + CABXdef(z,time) ] / CABXO(z);
1873   
1874   CTH_REALO(z)   = CTHO(z) / PIXCONO(z);
1875   G_REALO(z)     = GO(z) / PIXGVTO(z);
1876   GDP_BP_REALO(z)= GDP_BPO(z) / PIXGDPO(z);
1877   GDP_BP_W_REALO = GDP_BP_WO / PIXGDP_WO;
1878   GDP_MP_REALO(z)= GDP_MPO(z) / PIXCONO(z);
1879   IT_REALO(z)    = ITO(z) / PIXINVO(z);
1880   sh1O(z)        = [SHO(z) + SGO(z)] / GDP_IBO(z);
1881   sh0O(z)        = SHO(z) - sh1O(z) * YDHO(z);
1882   sh0O(z)        = sh0O(z) / PIXCONO(z)**eta;
1883   ttdh0O(z)      = ttdh0O(z) / PIXCONO(z)**eta;
1884   OBJO           = 1;
1885   growthz(z)    = 0.02;
1886   
