3469  *==============================================================================
3470  * Equation Definitions
3471  *==============================================================================
3472   
3473  *==============================================================================
3474  * Production
3475  *==============================================================================
3476  EQ_PRD_VA(j3,z,t)$[not BS(j3)]..
3477      VA(j3,z,t) =e= v(j3,z) * XST(j3,z,t);
3478   
3479  EQ_PRD_KLE(j2,z,t)..
3480      KLE(j2,z,t) =e= v2(j2,z) * XST(j2,z,t);
3481   
3482  EQ_PRD_INT(j,z,t)..
3483      CI(j,z,t) =e= io(j,z) * XST(j,z,t);
3484   
3485  EQ_PRD_INT_ENE(j3,z,t)..
3486      CE(j3,z,t) =e= io2(j3,z) * XST(j3,z,t);
3487   
3488  EQ_PRD_CES_VA(j,z,t)$[XSTO(j,z)]..
3489      VA(j,z,t) =e= A_VA(z,t) * B_VA_t(j,z,t) * {
3490                    [beta_VA(j,z) * LDC(j,z,t)**(-rho_VA(j,z))]$LDCO(j,z)
3491                  + [(1 - beta_VA(j,z)) * KDC(j,z,t)**(-rho_VA(j,z))]$KDCO(j,z)
3492                  }**(-1 / rho_VA(j,z));
3493   
3494  EQ_PRD_CES_KLE(j2,z,t)..
3495      KLE(j2,z,t) =e= B_KLE(j2,z) * {
3496                      [beta_KLE(j2,z) * VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
3497                    + [(1 - beta_KLE(j2,z)) * CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
3498                    }**(-1 / rho_KLE(j2,z));
3499   
3500  EQ_PRD_CES_VA_ENE(j2,z,t)$[VAO(j2,z) and CEO(j2,z)]..
3501      VA(j2,z,t) * (beta_KLE2(j2,z)**sigma_KLE(j2,z)) * (PVA(j2,z,t)**sigma_KLE(j2,z))
3502      =e= ((1 - beta_KLE2(j2,z))**sigma_KLE(j2,z)) * (PCE(j2,z,t)**sigma_KLE(j2,z)) * CE(j2,z,t);
3503   
3504  EQ_PRD_CES_LDC(j,z,t)$[LDCO(j,z) and KDCO(j,z)]..
3505      LDC(j,z,t) =e= {[beta_VA(j,z) / (1 - beta_VA(j,z))]
3506                     *[RC(j,z,t) / WC(j,z,t)]}**sigma_VA(j,z) * KDC(j,z,t);
3507   
3508  EQ_PRD_CES_LD(j,z,t)$LDCO(j,z)..
3509      LDC(j,z,t) =e= LD(j,z,t);
3510   
3511  EQ_PRD_CES_KDC(j,z,t)$KDCO(j,z)..
3512      KDC(j,z,t) =e= B_KD(j,z) * SUM[k$KDO(k,j,z), beta_KD(k,j,z)
3513                     * KD(k,j,z,t)**(-rho_KD(j,z))]**(-1 / rho_KD(j,z));
3514   
3515  EQ_PRD_CES_KD(k,j,z,t)$KDO(k,j,z)..
3516      KD(k,j,z,t) =e= [beta_KD(k,j,z) * RC(j,z,t) / RTI(k,j,z,t)]**sigma_KD(j,z)
3517                    * B_KD(j,z)**(sigma_KD(j,z) - 1) * KDC(j,z,t);
3518   
3519  EQ_PRD_LEO_DI(nene,j,z,t)..
3520      DI(nene,j,z,t) =e= aij_t(nene,j,z,t) * CI(j,z,t);
3521   
3522  EQ_PRD_LEO_DE(ene,j3,z,t)..
3523      DE(ene,j3,z,t) =e= aij2_t(ene,j3,z,t) * CE(j3,z,t) ;
3524   
3525  *============================= Level 1, 2, 3 (CES Energy Nesting) =====================
3526  EQ_PRD_CES_ENE_LVL1(j2,z,t)..
3527      CE(j2,z,t) =e= B_ENER_elec(j2,z) * {
3528                     [(beta_ENER_elec(j2,z)) * DEelec(j2,z,t)**(-rho_ENER_elec(j2,z))]
3529                   + [(1 - beta_ENER_elec(j2,z)) * DEnelec(j2,z,t)**(-rho_ENER_elec(j2,z))]
3530                   }**(-1 / rho_ENER_elec(j2,z));
3531   
3532  EQ_PRD_CES_ENE_LVL2(j2,z,t)..
3533      DEnelec(j2,z,t) =e= {[(1 - beta_ENER_elec(j2,z)) / (beta_ENER_elec(j2,z))]
3534                          *[PCEelec(j2,z,t) / PCEnelec(j2,z,t)]}**sigma_ENER_elec(j2,z) * DEelec(j2,z,t);
3535   
3536  EQ_PRD_CES_ENE_LVL3(j2,z,t)..
3537      DEnelec(j2,z,t) =e= B_ENER_nelec(j2,z) * {
3538                          [(beta_ENER_nelec(j2,z)) * DEcoalgas(j2,z,t)**(-rho_ENER_nelec(j2,z))]
3539                        + [(1 - beta_ENER_nelec(j2,z)) * DEoilpetrol(j2,z,t)**(-rho_ENER_nelec(j2,z))]
3540                        }**(-1 / rho_ENER_nelec(j2,z));
3541   
3542  EQ_PRD_CES_ENE_LVL4(j2,z,t)..
3543      DEoilpetrol(j2,z,t) =e= {[(1 - beta_ENER_nelec(j2,z)) / (beta_ENER_nelec(j2,z))]
3544                              *[PCEcoalgas(j2,z,t) / PCEoilpetrol(j2,z,t)]}**sigma_ENER_nelec(j2,z) * DEcoalgas(j2,z,t);
3545   
3546  EQ_PRD_CES_ENE_LVL5(ene2,j2,z,t)..
3547      DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
3548   
3549  EQ_PRD_CES_ENE_LVL6(ene5,j2,z,t)..
3550      DE(ene5,j2,z,t) =e= [beta_ENER_coalgas(ene5,j2,z) * PCEcoalgas(j2,z,t) / (P4(ene5,j2,z,t) + P4(ene5,j2,z,t) * CTAX(z,t) * CO2FACTOR2(ene5,j2,z,t))]
3551                          **sigma_ENER_coalgas(j2,z) * B_ENER_coalgas(j2,z)**(sigma_ENER_coalgas(j2,z) - 1)
3552                          * DEcoalgas(j2,z,t);
3553   
3554  EQ_PRD_CES_ENE_LVL7(ene6,j2,z,t)..
3555      DE(ene6,j2,z,t) =e= [beta_ENER_oilprod(ene6,j2,z) * PCEoilpetrol(j2,z,t) / (P4(ene6,j2,z,t) + P4(ene6,j2,z,t) * CTAX(z,t) * CO2FACTOR2(ene6,j2,z,t))]
3556                          **sigma_ENER_oilprod(j2,z) * B_ENER_oilprod(j2,z)**(sigma_ENER_oilprod(j2,z) - 1)
3557                          * DEoilpetrol(j2,z,t);
3558   
3559  *==============================================================================
3560  * Income and savings
3561  *==============================================================================
3562  EQ_INC_YH(z,t)..
3563      YH(z,t) =e= YHL(z,t) + YHK(z,t) + REBATE(z,t) * recycle_hou(z,t)
3564                + SUM((BS, Z_GRN)$sameas(z, Z_GRN), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t));
3565   
3566  EQ_INC_YHL(z,t)..
3567      YHL(z,t) =e= SUM[(j)$LDO(j,z), W(z,t) * (LD(j,z,t))];
3568   
3569  EQ_INC_YHK(z,t)..
3570      YHK(z,t) =e= SUM[(k,j)$KDO(k,j,z), R(k,j,z,t) * (KD(k,j,z,t))];
3571   
3572  EQ_INC_YDH(z,t)..
3573      YDH(z,t) =e= YH(z,t) - TDH(z,t);
3574   
3575  EQ_SAV_CTH(z,t)..
3576      CTH(z,t) =e= YDH(z,t) - SH(z,t);
3577   
3578  EQ_SAV_SH(z,t)..
3579      SH(z,t) =e= PIXCON(z,t)**eta * sh0(z,t) + sh1(z,t) * YDH(z,t);
3580   
3581  *==============================================================================
3582  * Government
3583  *==============================================================================
3584  EQ_INC_YG(z,t)..
3585      YG(z,t) =e= TDH(z,t) + TPRODN(z,t) + TPRCTS(z,t) + REBATE(z,t) * recycle_gov(z,t) - SUM(i1, PC(i1,z,t) * QDAC(z,t) * DAC_Tech_Coeff(i1));
3586   
3587  EQ_TAX_TCTAX(z,t)..
3588      TCTAX(z,t) =e= SUM((ene,j), PC(ene,z,t) * CTAX(z,t) * CO2FACTOR2(ene,j,z,t) * DE(ene,j,z,t));
3589   
3590  EQ_TAX_TPRODN(z,t)..
3591      TPRODN(z,t) =e= TIWT(z,t) + TIKT(z,t) + TIPT(z,t);
3592   
3593  EQ_TAX_TIWT(z,t)..
3594      TIWT(z,t) =e= SUM[(j)$LDO(j,z), TIW(j,z,t)] ;
3595   
3596  EQ_TAX_TIKT(z,t)..
3597      TIKT(z,t) =e= SUM[(k,j)$KDO(k,j,z), TIK(k,j,z,t)] ;
3598   
3599  EQ_TAX_TIPT(z,t)..
3600      TIPT(z,t) =e= SUM[j, TIP(j,z,t)] ;
3601   
3602  EQ_TAX_TPRCTS(z,t)..
3603      TPRCTS(z,t) =e= TICT(z,t) + TIMT(z,t) + TIXT(z,t);
3604   
3605  EQ_TAX_TICT(z,t)..
3606      TICT(z,t) =e= SUM[i, TIC(i,z,t)];
3607   
3608  EQ_TAX_TIMT(z,t)..
3609      TIMT(z,t) =e= SUM[(i,zj)$IMO(i,zj,z), TIM(i,zj,z,t)];
3610   
3611  EQ_TAX_TIXT(z,t)..
3612      TIXT(z,t) =e= SUM[(i,zj)$EXO(i,z,zj), TIX(i,z,zj,t)];
3613   
3614  EQ_TAX_TDH(z,t)..
3615      TDH(z,t) =e= PIXCON(z,t)**eta * ttdh0(z,t) + ttdh1(z,t) * YH(z,t);
3616   
3617  EQ_TAX_TIW(j,z,t)$LDO(j,z)..
3618      TIW(j,z,t) =e= ttiw(j,z,t) * W(z,t) * (LD(j,z,t)) ;
3619   
3620  EQ_TAX_TIK(k,j,z,t)$KDO(k,j,z)..
3621      TIK(k,j,z,t) =e= ttik(k,j,z,t) * R(k,j,z,t) * (KD(k,j,z,t));
3622   
3623  EQ_TAX_TIP(j,z,t)..
3624      TIP(j,z,t) =e= ttip(j,z,t) * PP(j,z,t) * XST(j,z,t);
3625   
3626  EQ_TAX_TIC(i,z,t)..
3627      TIC(i,z,t) =e= ttic(i,z,t) * {
3628                     [PL(i,z,t) * DD(i,z,t)]$DDO(i,z)
3629                   + [SUM[zj$IMO(i,zj,z), (1 + ttim(i,zj,z,t)) * IM(i,zj,z,t) * e(z,t)
3630                     *(PWM(i,zj,z,t) + SUM(ij, PWMG(ij,t) * tmrg(ij,i,zj,z)))]]
3631                   };
3632   
3633  EQ_TAX_TIM(i,zj,z,t)$IMO(i,zj,z)..
3634      TIM(i,zj,z,t) =e= ttim(i,zj,z,t) * IM(i,zj,z,t) * e(z,t) * (PWM(i,zj,z,t) + SUM[ij, PWMG(ij,t) * tmrg(ij,i,zj,z)]);
3635   
3636  EQ_TAX_TIX(i,z,zj,t)$EXO(i,z,zj)..
3637      TIX(i,z,zj,t) =e= ttix(i,z,zj,t) * PE(i,z,zj,t) * EX(i,z,zj,t);
3638   
3639  EQ_SAV_SG(z,t)..
3640      SG(z,t) =e= YG(z,t) - G(z,t);
3641   
3642  *==============================================================================
3643  * Rest of the world
3644  *==============================================================================
3645  EQ_INC_YROW(z,t)..
3646      YROW(z,t) =e= e(z,t) * SUM{(i,zj)$IMO(i,zj,z), IM(i,zj,z,t) * [PWM(i,zj,z,t) + SUM(ij, PWMG(ij,t) * tmrg(ij,i,zj,z))]}+YROW_RES(z);
3647   
3648  EQ_SAV_SROW(z,t)..
3649      SROW(z,t) =e= YROW(z,t) - e(z,t) * SUM[(i,zj)$EXO(i,z,zj), EX(i,z,zj,t) * PWX(i,z,zj,t)]
3650                    - e(z,t) * SUM[i$MRGNO(i,z), MRGN(i,z,t) * PWMG(i,t)];
3651   
3652  EQ_SAV_CAB(z,t)..
3653      SROW(z,t) =e= -CAB(z,t);
3654   
3655  *==============================================================================
3656  * Demand
3657  *==============================================================================
3658  EQ_DMD_C(i,z,t)..
3659      PC(i,z,t) * C(i,z,t) =e= PC(i,z,t) * (CMIN(i,z,t))
3660                             + gamma_LES(i,z) * {CTH(z,t) - SUM[ij, PC(ij,z,t) * (CMIN(ij,z,t))]};
3661   
3662  EQ_DMD_INV(i,z,t)..
3663      PC(i,z,t) * INV(i,z,t) =e= gamma_INV(i,z) * IT(z,t);
3664   
3665  EQ_DMD_CG(i,z,t)..
3666      PC(i,z,t) * CG(i,z,t) =e= gamma_GVT(i,z) * G(z,t);
3667   
3668  EQ_DMD_DIT_NENE(nene,z,t)..
3669      DIT(nene,z,t) =e= SUM[j, DI(nene,j,z,t)];
3670   
3671  EQ_DMD_DIT_ENE1(ene1,z,t)..
3672      DIT(ene1,z,t) =e= SUM[j, DE(ene1,j,z,t)];
3673   
3674  EQ_DMD_DIT_ENE2(ene2,z,t)..
3675      DIT(ene2,z,t) =e= SUM[j, DE(ene2,j,z,t)];
3676   
3677  *==============================================================================
3678  * International trade
3679  *==============================================================================
3680  EQ_TRD_TnD(z,t)..
3681      XS('18_TnD','18_ELEC',z,t) =e= TnDShare(z) * XS_I('18_ELEC',z,t);
3682   
3683  EQ_TRD_ELEC(z,t)..
3684      XS_I('18_ELEC',z,t) =e= XS('18_TnD','18_ELEC',z,t) + QPOWER(z,t);
3685   
3686  EQ_TRD_BS_GRN(BS, Conv, I_BS, Z_GRN, t)$MAP_BS(BS, Conv, I_BS)..
3687      XS_I(I_BS, Z_GRN, t) =e= QBS(BS, Z_GRN, t);
3688   
3689  EQ_TRD_BS_OTH(BS, Conv, I_BS, Z_OTH, t)$MAP_BS(BS, Conv, I_BS)..
3690      XS_I(I_BS, Z_OTH, t) =e= XS(Conv, I_BS, Z_OTH, t);
3691   
3692  EQ_TRD_QPOWER(z,t)..
3693      QPOWER(z,t) =e= B_POWER(z) * SUM[POWER, beta_POWER(power,z) * XS(POWER,'18_ELEC',z,t)**(-rho_POWER(z))]**(-1 / rho_POWER(z));
3694   
3695  EQ_TRD_POWER(power,'18_ELEC',z,t)..
3696      XS(POWER,'18_ELEC',z,t) =e= QPOWER(z,t) / B_POWER(z)**(1 - sigma_POWER(z)) *
3697                                  [beta_POWER(power,z) * PPOWER(z,t) / P2(POWER,'18_ELEC',z,t)]**sigma_POWER(z);
3698   
3699  EQ_TRD_QBS(BS, Conv, I_BS, Z_GRN, t)$MAP_BS(BS, Conv, I_BS)..
3700      QBS(BS, Z_GRN, t) =e= B_BS(BS, Z_GRN) * (
3701            beta_BS_t(Conv, I_BS, Z_GRN, t) * XS(Conv, I_BS, Z_GRN, t)**(-rho_BS(BS, Z_GRN))
3702          + beta_BS_t(BS, I_BS, Z_GRN, t) * XS(BS, I_BS, Z_GRN, t)**(-rho_BS(BS, Z_GRN))
3703      )**(-1 / rho_BS(BS, Z_GRN));
3704   
3705  EQ_TRD_CONV(BS, Conv, I_BS, Z_GRN, t)$MAP_BS(BS, Conv, I_BS)..
3706      XS(Conv, I_BS, Z_GRN, t) =e= QBS(BS, Z_GRN, t) / B_BS(BS, Z_GRN)**(1 - sigma_BS(BS, Z_GRN)) *
3707          [beta_BS_t(Conv, I_BS, Z_GRN, t) * PBS(BS, Z_GRN, t) / P2(Conv, I_BS, Z_GRN, t)]**sigma_BS(BS, Z_GRN);
3708   
3709  EQ_TRD_BS(BS, Conv, I_BS, Z_GRN, t)$MAP_BS(BS, Conv, I_BS)..
3710      XS(BS, I_BS, Z_GRN, t) =e= QBS(BS, Z_GRN, t) / B_BS(BS, Z_GRN)**(1 - sigma_BS(BS, Z_GRN)) *
3711          [beta_BS_t(BS, I_BS, Z_GRN, t) * PBS(BS, Z_GRN, t) / P2(BS, I_BS, Z_GRN, t)]**sigma_BS(BS, Z_GRN);
3712   
3713  EQ_TRD_XS_I(i2,z,t)..
3714      XS_I(i2,z,t) =e= B_MultiOut(i2,z) * SUM[j$XSO(j,i2,z), beta_MultiOut(j,i2,z) * XS(j,i2,z,t)**(-rho_MultiOut(i2,z))]**(-1 / rho_MultiOut(i2,z));
3715   
3716  EQ_TRD_XS(j,i2,z,t)${DSO(j,i2,z) and [DSO(j,i2,z) ne DSO_I(i2,z)]}..
3717      XS(j,i2,z,t) =e= XS_I(i2,z,t) / B_MultiOut(i2,z)**(1 - sigma_MultiOut(i2,z)) *[beta_MultiOut(j,i2,z) * P(i2,z,t) / P2(j,i2,z,t)]**sigma_MultiOut(i2,z);
3718   
3719  EQ_TRD_P2_PT(j,i,z,t)${DSO(j,i,z)}..
3720      P2(j,i,z,t) =e= PT(j,z,t);
3721   
3722  EQ_TRD_P2_VAL(j,i,z,t)$DSO(j,i,z)..
3723      P2(j,i,z,t) * XS(j,i,z,t) =e= [PET(i,z,t) * EXTT(j,i,z,t)]$EXTTO(j,i,z)
3724                                  + [e(z,t) * MRGN(i,z,t) * PWMG(i,t)*SHR_MRGN(j,i,z)]$MRGNO(i,z)
3725                                  + [PL(i,z,t) * DS(j,i,z,t)]$DSO(j,i,z);
3726   
3727  EQ_TRD_EXTT(j,i,z,t)$DSO(j,i,z)..
3728      EXTT(j,i,z,t) =e= theta2(j,i,z) * EXT(i,z,t);
3729   
3730  EQ_TRD_DS_I(i,z,t)..
3731      DS_I(i,z,t) =e= SUM(j, DS(j,i,z,t)$DSO(j,i,z));
3732   
3733  EQ_TRD_XST(j,z,t)..
3734      XST(j,z,t)  =e= SUM(i, XS(j,i,z,t)$XSO(j,i,z));
3735   
3736  EQ_TRD_CET_DOM(i,z,t)..
3737      XS_I(i,z,t) =e= B_X1(i,z) * {
3738                      [beta_EX_X1(i,z) * EXT(i,z,t)**rho_X1(i,z)]$EXTO(i,z)
3739                    + [beta_D_X1(i,z) * DS_I(i,z,t)**rho_X1(i,z)]$DSO_I(i,z)
3740                    + [(1 - beta_EX_X1(i,z) - beta_D_X1(i,z)) * MRGN(i,z,t)**rho_X1(i,z)]$MRGNO(i,z)
3741                    }**(1 / rho_X1(i,z));
3742   
3743  EQ_TRD_EXT(i,z,t)$[EXTO(i,z) and DSO_I(i,z)]..
3744      EXT(i,z,t) =e= {[beta_D_X1(i,z) / beta_EX_X1(i,z)] * [PET(i,z,t) / PL(i,z,t)]}**sigma_X1(i,z) * DS_I(i,z,t);
3745   
3746  EQ_TRD_MRGN(i,z,t)$[MRGNO(i,z) and DSO_I(i,z)]..
3747      MRGN(i,z,t) =e= {[beta_D_X1(i,z) / (1 - beta_EX_X1(i,z) - beta_D_X1(i,z))] * [e(z,t) * PWMG(i,t) / PL(i,z,t)]}**sigma_X1(i,z) * DS_I(i,z,t);
3748   
3749  EQ_TRD_CET_EXP(i,z,t)$EXTO(i,z)..
3750      EXT(i,z,t) =e= B_X2(i,z) * SUM[zj$EXO(i,z,zj), beta_X2(i,z,zj) * EX(i,z,zj,t)**rho_X2(i,z)]**(1 / rho_X2(i,z));
3751   
3752  EQ_TRD_EX(i,z,zj,t)$EXO(i,z,zj)..
3753      EX(i,z,zj,t) =e= EXT(i,z,t) / B_X2(i,z)**(1 + sigma_X2(i,z)) *
3754                       [PE(i,z,zj,t) / (beta_X2(i,z,zj) * PET(i,z,t))]**sigma_X2(i,z);
3755   
3756  EQ_TRD_CES_IMP(i,z,t)..
3757      Q(i,z,t) =e= B_M1(i,z) * {
3758                   [beta_M1(i,z) * IMT(i,z,t)**(-rho_M1(i,z))]$IMTO(i,z)
3759                 + [(1 - beta_M1(i,z)) * DD(i,z,t)**(-rho_M1(i,z))]$DDO(i,z)
3760                   }**(-1 / rho_M1(i,z));
3761   
3762  EQ_TRD_IMT(i,z,t)$[IMTO(i,z) and DDO(i,z)]..
3763      IMT(i,z,t) =e= {[beta_M1(i,z) / (1 - beta_M1(i,z))] * [PD(i,z,t) / PMT(i,z,t)]}**sigma_M1(i,z) * DD(i,z,t);
3764   
3765  EQ_TRD_CES_ORG(i,z,t)$IMTO(i,z)..
3766      IMT(i,z,t) =e= B_M2(i,z) * SUM[zj$IMO(i,zj,z), beta_M2(i,zj,z) * IM(i,zj,z,t)**(-rho_M2(i,z))]**(-1 / rho_M2(i,z));
3767   
3768  EQ_TRD_IM(i,zj,z,t)$IMO(i,zj,z)..
3769      IM(i,zj,z,t) =e= IMT(i,z,t) / B_M2(i,z)**(1 - sigma_M2(i,z)) *
3770                       [beta_M2(i,zj,z) * PMT(i,z,t) / PM(i,zj,z,t)]**sigma_M2(i,z);
3771   
3772  *==============================================================================
3773  * Prices
3774  *==============================================================================
3775  EQ_PRC_PP_ENE(j2,z,t)..
3776      PP(j2,z,t) * XST(j2,z,t) =e= PKLE(j2,z,t) * KLE(j2,z,t) + PCI(j2,z,t) * CI(j2,z,t);
3777   
3778  EQ_PRC_PP_IND(j3,z,t)$[not BS(j3)]..
3779      PP(j3,z,t) * XST(j3,z,t) =e= PVA(j3,z,t) * VA(j3,z,t) + PCI(j3,z,t) * CI(j3,z,t) + PCE(j3,z,t) * CE(j3,z,t);
3780   
3781  EQ_PRC_PT(j,z,t)..
3782      PT(j,z,t) =e= (1 + ttip(j,z,t)) * PP(j,z,t);
3783   
3784  EQ_PRC_PCI(j,z,t)..
3785      PCI(j,z,t) * CI(j,z,t) =e= SUM[nene, PC(nene,z,t) * DI(nene,j,z,t)];
3786   
3787  EQ_PRC_PCE_ENE(j3,z,t)..
3788      PCE(j3,z,t) * CE(j3,z,t) =e= SUM[ene, PC(ene,z,t) * DE(ene,j3,z,t) + PC(ene,z,t) * CTAX(z,t) * CO2FACTOR2(ene,j3,z,t) * DE(ene,j3,z,t)];
3789   
3790  EQ_PRC_PCE(j2,z,t)..
3791      PCE(j2,z,t) * CE(j2,z,t) =e= [PCEelec(j2,z,t) * DEelec(j2,z,t) + PCEnelec(j2,z,t) * DEnelec(j2,z,t)];
3792   
3793  EQ_PRC_PCE_ELEC(j2,z,t)..
3794      PCEelec(j2,z,t) * DEelec(j2,z,t) =e= PC("18_ELEC",z,t) * DE("18_ELEC",j2,z,t);
3795   
3796  EQ_PRC_PCE_NELEC(j2,z,t)..
3797      PCEnelec(j2,z,t) * DEnelec(j2,z,t) =e= [PCEcoalgas(j2,z,t) * DEcoalgas(j2,z,t) + PCEoilpetrol(j2,z,t) * DEoilpetrol(j2,z,t)];
3798   
3799  EQ_PRC_PCE_COALGAS(j2,z,t)..
3800      PCEcoalgas(j2,z,t) * DEcoalgas(j2,z,t) =e= [PC("02_COAL",z,t) * DE("02_COAL",j2,z,t) + PC("02_COAL",z,t) * CTAX(z,t) * CO2FACTOR2("02_COAL",j2,z,t) * DE("02_COAL",j2,z,t)
3801                                               + PC("04_GAS",z,t) * DE("04_GAS",j2,z,t) + PC("04_GAS",z,t) * CTAX(z,t) * CO2FACTOR2("04_GAS",j2,z,t) * DE("04_GAS",j2,z,t)];
3802   
3803  EQ_PRC_PCE_OILPETROL(j2,z,t)..
3804      PCEoilpetrol(j2,z,t) * DEoilpetrol(j2,z,t) =e= [PC("03_OIL",z,t) * DE("03_OIL",j2,z,t) + PC("03_OIL",z,t) * CTAX(z,t) * CO2FACTOR2("03_OIL",j2,z,t) * DE("03_OIL",j2,z,t)
3805                                                   + PC("10_PETROLCOAL",z,t) * DE("10_PETROLCOAL",j2,z,t) + PC("10_PETROLCOAL",z,t) * CTAX(z,t) * CO2FACTOR2("10_PETROLCOAL",j2,z,t) * DE("10_PETROLCOAL",j2,z,t)];
3806   
3807  EQ_PRC_PVA(j,z,t)..
3808      PVA(j,z,t) * VA(j,z,t) =e= [WC(j,z,t) * LDC(j,z,t)]$LDCO(j,z)
3809                               + [RC(j,z,t) * KDC(j,z,t)]$KDCO(j,z);
3810   
3811  EQ_PRC_PKLE(j2,z,t)..
3812      PKLE(j2,z,t) * KLE(j2,z,t) =e= [PVA(j2,z,t) * VA(j2,z,t)]$VAO(j2,z)
3813                                   + [PCE(j2,z,t) * CE(j2,z,t)]$CEO(j2,z);
3814   
3815  EQ_PRC_WC(j,z,t)..
3816      WC(j,z,t) * LDC(j,z,t) =e= WTI(j,z,t) * (LD(j,z,t));
3817   
3818  EQ_PRC_WTI(j,z,t)$LDO(j,z)..
3819      WTI(j,z,t) * LD(j,z,t) =e= W(z,t) * (1 + ttiw(j,z,t)) * LD(j,z,t) ;
3820   
3821  EQ_PRC_P4(ene,j2,z,t)$DEO(ene,j2,z)..
3822      P4(ene,j2,z,t) =e= PC(ene,z,t);
3823   
3824  EQ_PRC_RTI(k,j,z,t)$KDO(k,j,z)..
3825      RTI(k,j,z,t) =e= R(k,j,z,t) * (1 + ttik(k,j,z,t));
3826   
3827  EQ_PRC_P(i,z,t)..
3828      P(i,z,t) * XS_I(i,z,t) =e= [PL(i,z,t) * DS_I(i,z,t)]$DSO_I(i,z)
3829                               + [PET(i,z,t) * EXT(i,z,t)]$EXTO(i,z)
3830                               + [e(z,t) * PWMG(i,t) * MRGN(i,z,t)]$MRGNO(i,z);
3831   
3832  EQ_PRC_PE(i,z,zj,t)$EXO(i,z,zj)..
3833      PE(i,z,zj,t) * (1 + ttix(i,z,zj,t)) =e= e(z,t) * PWX(i,z,zj,t);
3834   
3835  EQ_PRC_PD(i,z,t)$DDO(i,z)..
3836      PD(i,z,t) =e= (1 + ttic(i,z,t)) * PL(i,z,t);
3837   
3838  EQ_PRC_PM(i,zj,z,t)$IMO(i,zj,z)..
3839      PM(i,zj,z,t) =e= (1 + ttic(i,z,t)) * (1 + ttim(i,zj,z,t)) * e(z,t) * (PWM(i,zj,z,t) + SUM[ij, PWMG(ij,t) * tmrg(ij,i,zj,z)]);
3840   
3841  EQ_PRC_PC(i,z,t)..
3842      PC(i,z,t) * Q(i,z,t) =e= [PD(i,z,t) * DD(i,z,t)]$DDO(i,z) + [PMT(i,z,t) * IMT(i,z,t)]$IMTO(i,z);
3843   
3844  EQ_MAC_PIXGDP(z,t)..
3845      PIXGDP(z,t) =e= {
3846        ( SUM[j$XSTO(j,z), {(PVA(j,z,t) * VA(j,z,t) + TIP(j,z,t)) / VA(j,z,t)} * VAO(j,z)]
3847          + SUM[(BS, Z_GRN)$(sameas(z, Z_GRN) and XSTO(BS, Z_GRN)), PTSF(BS, Z_GRN, t) * TSFO(BS, Z_GRN)] )
3848        /
3849        ( SUM[j$XSTO(j,z), {(PVAO(j,z) * VAO(j,z) + TIPO(j,z)) / VAO(j,z)} * VAO(j,z)]
3850          + SUM[(BS, Z_GRN)$(sameas(z, Z_GRN) and XSTO(BS, Z_GRN)), PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN)] )
3851        * ( SUM[j$XSTO(j,z), {(PVA(j,z,t) * VA(j,z,t) + TIP(j,z,t)) / VA(j,z,t)} * VA(j,z,t)]
3852          + SUM[(BS, Z_GRN)$(sameas(z, Z_GRN) and XSTO(BS, Z_GRN)), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t)] )
3853        /
3854        ( SUM[j$XSTO(j,z), {(PVAO(j,z) * VAO(j,z) + TIPO(j,z)) / VAO(j,z)} * VA(j,z,t)]
3855          + SUM[(BS, Z_GRN)$(sameas(z, Z_GRN) and XSTO(BS, Z_GRN)), PTSFO(BS, Z_GRN) * TSFD(BS, Z_GRN, t)] )
3856      }**0.5;
3857   
3858  EQ_MAC_PIXGDP_W(t)..
3859      PIXGDP_W(t) =e= {
3860        ( SUM[(j,z)$XSTO(j,z), {(PVA(j,z,t) * VA(j,z,t) + TIP(j,z,t)) / VA(j,z,t)} * VAO(j,z) / e(z,t)]
3861          + SUM[(BS, Z_GRN)$XSTO(BS, Z_GRN), PTSF(BS, Z_GRN, t) * TSFO(BS, Z_GRN) / e(Z_GRN, t)] )
3862        /
3863        ( SUM[(j,z)$XSTO(j,z), {(PVAO(j,z) * VAO(j,z) + TIPO(j,z)) / VAO(j,z)} * VAO(j,z) / eO(z)]
3864          + SUM[(BS, Z_GRN)$XSTO(BS, Z_GRN), PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN) / eO(Z_GRN)] )
3865        * ( SUM[(j,z)$XSTO(j,z), {(PVA(j,z,t) * VA(j,z,t) + TIP(j,z,t)) / VA(j,z,t)} * VA(j,z,t) / e(z,t)]
3866          + SUM[(BS, Z_GRN)$XSTO(BS, Z_GRN), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t) / e(Z_GRN, t)] )
3867        /
3868        ( SUM[(j,z)$XSTO(j,z), {(PVAO(j,z) * VAO(j,z) + TIPO(j,z)) / VAO(j,z)} * VA(j,z,t) / eO(z)]
3869          + SUM[(BS, Z_GRN)$XSTO(BS, Z_GRN), PTSFO(BS, Z_GRN) * TSFD(BS, Z_GRN, t) / eO(Z_GRN)] )
3870      }**0.5;
3871   
3872  EQ_MAC_PIXCON(z,t)..
3873      PIXCON(z,t) =e= SUM[i, PC(i,z,t) * CO(i,z)] / SUM[i, PCO(i,z) * CO(i,z)];
3874   
3875  EQ_MAC_PIXINV(z,t)..
3876      PIXINV(z,t) =e= PROD[i$gamma_INV(i,z), (PC(i,z,t) / PCO(i,z))**gamma_INV(i,z)];
3877   
3878  EQ_MAC_PIXGVT(z,t)..
3879      PIXGVT(z,t) =e= PROD[i$gamma_GVT(i,z), (PC(i,z,t) / PCO(i,z))**gamma_GVT(i,z)];
3880   
3881  *==============================================================================
3882  * Equilibrium Market Clearing Condtion
3883  *==============================================================================
3884  EQ_MKT_Q(i1,z,t)..
3885      Q(i1,z,t) =e= C(i1,z,t) + CG(i1,z,t) + INV(i1,z,t) + DIT(i1,z,t) + (QDAC(z,t) * DAC_Tech_Coeff(i1)) ;
3886   
3887  EQ_MKT_LS(z,t)..
3888      LS(z,t) =e= SUM[j$LDO(j,z), LD(j,z,t)] ;
3889   
3890  EQ_MKT_KS(k,z,t)$KSO(k,z)..
3891      KS(k,z,t) =e= SUM[j$KDO(k,j,z), KD(k,j,z,t)] ;
3892   
3893  EQ_MKT_IT(z,t)..
3894      IT(z,t) =e= SH(z,t) + SG(z,t) - CAB(z,t);
3895   
3896  EQ_MAC_DEP(z,t)..
3897      DEP(z,t) =e= PK(z,t) * delta(z) * SUM[k$KSO(k,z), KS(k,z,t)];
3898   
3899  EQ_MKT_DS(i,z,t)$DDO(i,z)..
3900      SUM[j$DSO(j,i,z), DS(j,i,z,t)] =e= DD(i,z,t);
3901   
3902  EQ_MKT_EX(i,z,zj,t)$EXO(i,z,zj)..
3903      EX(i,z,zj,t) =e= IM(i,z,zj,t);
3904   
3905  EQ_MKT_PWX(i,z,zj,t)$EXO(i,z,zj)..
3906      PWX(i,z,zj,t) =e= PWM(i,z,zj,t);
3907   
3908  EQ_MKT_MRGN(i,t)..
3909      SUM[z$MRGNO(i,z), MRGN(i,z,t)] =e= SUM[(z,zj,ij)$IMO(ij,zj,z), tmrg(i,ij,zj,z) * IM(ij,zj,z,t)]+MRGN_RES(i) ;
3910   
3911  *==============================================================================
3912  * Gross domestic product
3913  *==============================================================================
3914  EQ_MAC_GDP_BP(z,t)..
3915      GDP_BP(z,t) =e= SUM[j, PVA(j,z,t) * VA(j,z,t)] + TIPT(z,t)
3916                    + SUM((BS, Z_GRN)$sameas(z, Z_GRN), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t));
3917   
3918  EQ_MAC_GDP_MP(z,t)..
3919      GDP_MP(z,t) =e= GDP_BP(z,t) + TPRCTS(z,t) + TCTAX(z,t);
3920   
3921  EQ_MAC_GDP_IB(z,t)..
3922      GDP_IB(z,t) =e= SUM[(j)$LDO(j,z), W(z,t) * (LD(j,z,t))]
3923                    + SUM[(k,j)$KDO(k,j,z), R(k,j,z,t) * (KD(k,j,z,t))]
3924                    + SUM((BS, Z_GRN)$sameas(z, Z_GRN), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t))
3925                    + TPRCTS(z,t) + TPRODN(z,t) + TCTAX(z,t);
3926   
3927  EQ_MAC_GDP_FD(z,t)..
3928      GDP_FD(z,t) =e= SUM[i, PC(i,z,t) * (C(i,z,t) + CG(i,z,t) + INV(i,z,t))]
3929                    + SUM[(i,zj)$EXO(i,z,zj), e(z,t) * PWX(i,z,zj,t) * EX(i,z,zj,t)]
3930                    + SUM[i$MRGNO(i,z), e(z,t) * PWMG(i,t) * MRGN(i,z,t)]
3931                    - SUM[(i,zj)$IMO(i,zj,z), e(z,t) * IM(i,zj,z,t) * (PWM(i,zj,z,t) + SUM[ij, PWMG(ij,t) * tmrg(ij,i,zj,z)])]
3932                    + SUM(i1, PC(i1,z,t) * QDAC(z,t) * DAC_Tech_Coeff(i1));
3933   
3934  EQ_MAC_GDP_BP_W(t)..
3935      GDP_BP_W(t) =e= SUM[z, GDP_BP(z,t) / e(z,t)];
3936   
3937  *==============================================================================
3938  * Real (volume) variables computed from price indices
3939  *==============================================================================
3940  EQ_MAC_CTH_REAL(z,t)..
3941      CTH_REAL(z,t) =e= CTH(z,t) / PIXCON(z,t);
3942   
3943  EQ_MAC_G_REAL(z,t)..
3944      G_REAL(z,t) =e= G(z,t) / PIXGVT(z,t);
3945   
3946  EQ_MAC_GDP_BP_REAL(z,t)..
3947      GDP_BP_REAL(z,t) =e= GDP_BP(z,t) / PIXGDP(z,t);
3948   
3949  EQ_MAC_GDP_BP_W_REAL(t)..
3950      GDP_BP_W_REAL(t) =e= GDP_BP_W(t) / PIXGDP_W(t);
3951   
3952  EQ_MAC_GDP_MP_REAL(z,t)..
3953      GDP_MP_REAL(z,t) =e= GDP_MP(z,t) / PIXCON(z,t);
3954   
3955  EQ_MAC_IT_REAL(z,t)..
3956      IT_REAL(z,t) =e= IT(z,t) / PIXINV(z,t);
3957   
3958  EQ_MAC_CABX(z,t)..
3959      CABX(z,t) =e= CAB(z,t) / [PIXGDP_W(t) * e(z,t)];
3960   
3961  *==============================================================================
3962  * Dynamic equations
3963  *==============================================================================
3964  EQ_DYN_IT(z,t)..
3965      IT(z,t) =e= PK(z,t) * SUM[(k,j)$KDO(k,j,z), IND(k,j,z,t)];
3966   
3967  EQ_DYN_PK(z,t)..
3968      PK(z,t) =e= 1 / A_K(z) * PROD[i$gamma_INV(i,z), (PC(i,z,t) / gamma_INV(i,z))**gamma_INV(i,z)];
3969   
3970  EQ_DYN_IND(k,bus,z,t)$KDO(k,bus,z)..
3971      IND(k,bus,z,t) =e= phi(z,t) * [R(k,bus,z,t) / U(z,t)]**sigma_INV(k,bus,z) * (KD(k,bus,z,t));
3972   
3973  EQ_DYN_IR(z,t)..
3974      IR(z,t) =e= {SUM[(k,j)$KDO(k,j,z), R(k,j,z,t) * (KD(k,j,z,t))] - DEP(z,t)} /
3975                  {PK(z,t) * SUM[(k,j)$KDO(k,j,z), (KD(k,j,z,t))]};
3976   
3977  EQ_DYN_U(z,t)..
3978      U(z,t) =e= PK(z,t) * (delta(z) + IR(z,t));
3979   
3980  *==============================================================================
3981  * LEON
3982  *==============================================================================
3983  EQ_MKT_WALRAS(z,t)..
3984      LEON(z,t) =e= Q('01_AGRICULT',z,t) - C('01_AGRICULT',z,t) - CG('01_AGRICULT',z,t) - INV('01_AGRICULT',z,t) - DIT('01_AGRICULT',z,t);
3985   
3986  *================================================================================
3987  * Labour Supply
3988  *================================================================================
3989  EQ_DYN_LS(z,t)..
3990      LS(z,t) =e= LST(z,t) * ((W(z,t) / PIXCON(z,t)) / (W_lag(z,t) / PIXCON_lag(z,t)))**elasLS(z);
3991   
3992  *==============================================================================
3993  * PERMIT
3994  *==============================================================================
3995  EQ_POL_PERMIT(j,z,t)..
3996      PERMIT(j,z,t) =e= SUM(ene, CO2FACTOR2(ene,j,z,t) * DE(ene,j,z,t));
3997   
3998  EQ_POL_PERMIT_TOT(z,t)..
3999      PERMIT_TOTAL(z,t) =e= SUM(j, PERMIT(j,z,t)) - QDAC(z,t) * switchDAC(z,t);
4000   
4001  *==============================================================================
4002  * Carbon Tax Revenue Recycling
4003  *==============================================================================
4004  EQ_POL_REBATE(z,t)..
4005      REBATE(z,t) =e= TCTAX(z,t);
4006   
4007  *==============================================================================
4008  * DAC
4009  *==============================================================================
4010  EQ_POL_QDAC(z,t)..
4011      QDAC(z,t) =e= DAC_MAX(z) * DAC_growth_rate(z,t) * switchDAC(z,t);
4012   
4013  EQ_OBJ..
4014      OBJ =e= 1.0;
4015   
4016  *==============================================================================
4017  * TSF Equations - CES
4018  *==============================================================================
4019  EQ_PP_GRN(BS, Z_GRN, t)..
4020      PP(BS, Z_GRN, t) * XST(BS, Z_GRN, t) =e= PVAT(BS, Z_GRN, t) * VAT(BS, Z_GRN, t)
4021                                             + PCI(BS, Z_GRN, t) * CI(BS, Z_GRN, t)
4022                                             + PCE(BS, Z_GRN, t) * CE(BS, Z_GRN, t);
4023   
4024  EQ_VA_GRN(BS, Z_GRN, t)..
4025      VA(BS, Z_GRN, t) =e= VAT(BS, Z_GRN, t)
4026                         * (beta_VAT(BS, Z_GRN) * PVAT(BS, Z_GRN, t) / PVA(BS, Z_GRN, t))**sigma_VAT(BS, Z_GRN)
4027                         * (B_VAT_t(BS, Z_GRN, t))**(sigma_VAT(BS, Z_GRN) - 1);
4028   
4029  EQ_VAT_REQ(BS, Z_GRN, t)..
4030      VAT(BS, Z_GRN, t) =e= v_vat(BS, Z_GRN) * XST(BS, Z_GRN, t);
4031   
4032  EQ_PVAT(BS, Z_GRN, t)..
4033      PVAT(BS, Z_GRN, t) * VAT(BS, Z_GRN, t) =e= PVA(BS, Z_GRN, t) * VA(BS, Z_GRN, t)
4034                                               + PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t);
4035   
4036  EQ_TSFD(BS, Z_GRN, t)..
4037      TSFD(BS, Z_GRN, t) =e= VAT(BS, Z_GRN, t)
4038                           * ((1 - beta_VAT(BS, Z_GRN)) * PVAT(BS, Z_GRN, t) / PTSF(BS, Z_GRN, t))**sigma_VAT(BS, Z_GRN)
4039                           * (B_VAT_t(BS, Z_GRN, t))**(sigma_VAT(BS, Z_GRN) - 1);
4040   
4041  EQ_TSFMKT(BS, Z_GRN, t)..
4042      TSFS(BS, Z_GRN, t) =e= TSFD(BS, Z_GRN, t);
4043   
4044  * ===================================================================
4045  * Terms of Trade (ToT) Equations (Bilateral World Prices)
4046  * ===================================================================
4047  EQ_PX_INDEX(z,t)..
4048      PX_INDEX(z,t) =e= SUM((i,zj)$VFOB0(i,z,zj), W_EXP(i,z,zj) * (PWX(i,z,zj,t) / PWX0(i,z,zj)));
4049   
4050  EQ_PM_INDEX(z,t)..
4051      PM_INDEX(z,t) =e= SUM((i,zj)$VCIF0(i,zj,z), W_IMP(i,zj,z) * ( (PWM(i,zj,z,t) + SUM(ij, PWMG(ij,t) * tmrg(ij,i,zj,z))) / PCIF0(i,zj,z) ));
4052   
4053  EQ_TOT(z,t)..
4054      TOT(z,t) * PM_INDEX(z,t) =e= PX_INDEX(z,t);
4055   
4056  * 결과 추출용 변수(valGDP 등) 사전 선언 (루프 밖에서 단 한 번만 선언)
INCLUDE    C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.GUIDE-GLOBAL-CGE_v2\Results_format\Declare_Results.gms
4058  *==============================================================================
4059  * Results Parameter Declarations (Categorized & Aligned)
4060  *==============================================================================
4061  PARAMETER
4062   
4063  * --- 1. Macroeconomics & National Accounts ---
4064   valGDP_BP(z,time,scen)              Region z GDP at basic prices
4065   valGDP_BP_REAL(z,time,scen)         Region z real GDP at basic prices
4066   valGDP_BP_W(time,scen)              World GDP at basic prices
4067   valGDP_BP_W_REAL(time,scen)         World real GDP at basic prices
4068   valGDP_FD(z,time,scen)              Region z GDP at purchasers prices from the perspective of final demand
4069   valGDP_IB(z,time,scen)              Region z GDP at market prices (income-based)
4070   valGDP_MP(z,time,scen)              Region z GDP at market prices
4071   valGDP_MP_REAL(z,time,scen)         Real GDP at market prices
4072   valC(i,z,time,scen)                 Consumption of commodity i by households in region z
4073   valCG(i,z,time,scen)                Public consumption of commodity i in region z
4074   valCTH(z,time,scen)                 Consumption budget of households in region z
