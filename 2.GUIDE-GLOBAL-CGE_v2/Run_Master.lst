2359   Elec_DIO(p_elecheat,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_elecheat, z));
2360   Elec_DIO(p_elecheat,'02_COAL',z)     = -1 * sum((f_coa), WEB(f_coa, p_elecheat, z)$(WEB(f_coa, p_elecheat, z) < 0));
2361   Elec_DIO(p_elecheat,'03_OIL',z)      = -1 * sum((f_oil), WEB(f_oil, p_elecheat, z)$(WEB(f_oil, p_elecheat, z) < 0));
2362   Elec_DIO(p_elecheat,'04_GAS',z)      = -1 * sum((f_gas), WEB(f_gas, p_elecheat, z)$(WEB(f_gas, p_elecheat, z) < 0));
2363   Elec_DIO(p_elecheat,'05_MINING',z)   = sum((f_mining), WEB(f_mining, p_elecheat, z));
2364   Elec_DIO(p_elecheat,'06_FOODPRO',z)  = sum((f_foodpro), WEB(f_foodpro, p_elecheat, z));
2365   Elec_DIO(p_elecheat,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_elecheat, z));
2366   Elec_DIO(p_elecheat,'08_WOODPRO',z)  = sum((f_woodpro), WEB(f_woodpro, p_elecheat, z));
