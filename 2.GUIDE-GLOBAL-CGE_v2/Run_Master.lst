2484   Ren_DIO(p_ren,'10_PETROLCOAL',z) = sum((f_petrolcoal), WEB(f_petrolcoal, p_ren, z));
2485   Ren_DIO(p_ren,'11_CHEMICAL',z)   = sum((f_chemical), WEB(f_chemical, p_ren, z));
2486   Ren_DIO(p_ren,'12_NONMET',z)     = sum((f_nonmet), WEB(f_nonmet, p_ren, z));
2487   Ren_DIO(p_ren,'13_IRONSTL',z)    = sum((f_ironstl), WEB(f_ironstl, p_ren, z));
2488   Ren_DIO(p_ren,'14_NONFERR',z)    = sum((f_nonferr), WEB(f_nonferr, p_ren, z));
2489   Ren_DIO(p_ren,'15_MACHINE',z)    = sum((f_machine), WEB(f_machine, p_ren, z));
2490   Ren_DIO(p_ren,'16_TRANSEQ',z)    = sum((f_transeq), WEB(f_transeq, p_ren, z));
2491   Ren_DIO(p_ren,'17_OTHERIND',z)   = sum((f_otherind), WEB(f_otherind, p_ren, z));
2492   Ren_DIO(p_ren,'27_CONSTRUC',z)   = sum((f_construc), WEB(f_construc, p_ren, z));
2493   Ren_DIO(p_ren,'28_LTRP',z)       = sum((f_roadrail), WEB(f_roadrail, p_ren, z));
2494   Ren_DIO(p_ren,'29_WTRP',z)       = sum((f_domewater), WEB(f_domewater, p_ren, z));
2495   Ren_DIO(p_ren,'30_ATRP',z)       = sum((f_domeair), WEB(f_domeair, p_ren, z));
2496   Ren_DIO(p_ren,'31_SER',z)        = sum((f_ser), WEB(f_ser, p_ren, z));
2497   Ren_CO(p_ren,z)                  = sum((f_household), WEB(f_household, p_ren, z));
2498   
2499  *==============================================================================
2500  * Calculated Totals
2501  *==============================================================================
2502   NCoal_Total(p_coal,z)       = sum(j, NCoal_DIO(p_coal,j,z));
2503   NGas_Total(p_gas,z)         = sum(j, NGas_DIO(p_gas,j,z));
2504   NOilp_Total(p_oilproduct,z) = sum(j, NOilp_DIO(p_oilproduct,j,z));
2505   
2506   Coal_Total(p_coal,z)        = sum(j, Coal_DIO(p_coal,j,z)) + Coal_CO(p_coal,z);
2507   Gas_Total(p_gas,z)          = sum(j, Gas_DIO(p_gas,j,z)) + Gas_CO(p_gas,z);
2508   Oilp_Total(p_oilproduct,z)  = sum(j, Oilp_DIO(p_oilproduct,j,z)) + Oilp_CO(p_oilproduct,z);
2509   ELec_Total(p_elecheat,z)    = sum(j, ELec_DIO(p_elecheat,j,z)) + ELec_CO(p_elecheat,z);
2510   
2511   TES_Coal(p_coal,z)               = sum(f_TES, WEB(f_TES, p_coal, z));
2512   TES_Gas(p_gas,z)                 = sum(f_TES, WEB(f_TES, p_gas, z));
2513   TES_Oil(p_oil,z)                 = sum(f_TES, WEB(f_TES, p_oil, z));
2514   TES_Oilproduct(p_oilproduct,z)   = sum(f_TES, WEB(f_TES, p_oilproduct, z));
2515   
2516  *==============================================================================
2517  * Ratio Calculations (Consolidated Block)
2518  *==============================================================================
2519  Loop(j,
2520  * Intermediate consumption ratios
2521    CoalR_DIO(p_coal,j,z)$(Coal_DIO(p_coal,j,z) > 0)             = Coal_DIO(p_coal,j,z)/sum(p_coal2, Coal_DIO(p_coal2,j,z));
2522    GasR_DIO(p_gas,j,z)$(Gas_DIO(p_gas,j,z) > 0)                 = Gas_DIO(p_gas,j,z)/sum(p_gas2, Gas_DIO(p_gas2,j,z));
2523    OilR_DIO(p_oil,j,z)$(Oil_DIO(p_oil,j,z) > 0)                 = Oil_DIO(p_oil,j,z)/sum(p_oil2, Oil_DIO(p_oil2,j,z));
2524    OilpR_DIO(p_oilproduct,j,z)$(Oilp_DIO(p_oilproduct,j,z) > 0) = Oilp_DIO(p_oilproduct,j,z)/sum(p_oilproduct2, Oilp_DIO(p_oilproduct2,j,z));
2525   
2526    ElecR_DIO(p_elecheat,j,z)$(Elec_DIO(p_elecheat,j,z) > 0)     = Elec_DIO(p_elecheat,j,z)/sum(p_elecheat2, Elec_DIO(p_elecheat2,j,z));
2527    WasteR_DIO(p_waste,j,z)$(Waste_DIO(p_waste,j,z) > 0)         = Waste_DIO(p_waste,j,z)/sum(p_waste2, Waste_DIO(p_waste2,j,z));
2528    BioR_DIO(p_bio,j,z)$(Bio_DIO(p_bio,j,z) > 0)                 = Bio_DIO(p_bio,j,z)/sum(p_bio2, Bio_DIO(p_bio2,j,z));
2529    CharcoalR_DIO(p_charcoal,j,z)$(Charcoal_DIO(p_charcoal,j,z) > 0) = Charcoal_DIO(p_charcoal,j,z)/sum(p_charcoal2, Charcoal_DIO(p_charcoal2,j,z));
2530    RenR_DIO(p_ren,j,z)$(Ren_DIO(p_ren,j,z) > 0)                 = Ren_DIO(p_ren,j,z)/sum(p_ren2, Ren_DIO(p_ren2,j,z));
2531   
2532  * Non-energy intermediate consumption ratios
2533    NCoalR_DIO(p_coal,j,z)$(NCoal_DIO(p_coal,j,z) > 0)           = NCoal_DIO(p_coal,j,z)/sum(p_coal2, NCoal_DIO(p_coal2,j,z));
2534    NGasR_DIO(p_gas,j,z)$(NGas_DIO(p_gas,j,z) > 0)               = NGas_DIO(p_gas,j,z)/sum(p_gas2, NGas_DIO(p_gas2,j,z));
2535    NOilp_DIO(p_oilproduct,j,z)$(NOilp_DIO(p_oilproduct,j,z) > 0)= NOilp_DIO(p_oilproduct,j,z)/sum(p_oilproduct2, NOilp_DIO(p_oilproduct2,j,z));
2536  );
2537   
2538  * Household consumption ratios
2539  CoalR_CO(p_coal,z)$(Coal_CO(p_coal,z) > 0)                     = Coal_CO(p_coal,z)/ sum(p_coal2, Coal_CO(p_coal2,z));
2540  GasR_CO(p_gas,z)$(Gas_CO(p_gas,z) > 0)                         = Gas_CO(p_gas,z)/ sum(p_gas2, Gas_CO(p_gas2,z));
2541  OilpR_CO(p_oilproduct,z)$(Oilp_CO(p_oilproduct,z) > 0)         = Oilp_CO(p_oilproduct,z)/ sum(p_oilproduct2, Oilp_CO(p_oilproduct2,z));
2542   
2543  ElecR_CO(p_elecheat,z)$(Elec_CO(p_elecheat,z) > 0)             = Elec_CO(p_elecheat,z)/ sum(p_elecheat2, Elec_CO(p_elecheat2,z));
2544  WasteR_CO(p_waste,z)$(Waste_CO(p_waste,z) > 0)                 = Waste_CO(p_waste,z)/ sum(p_waste2, Waste_CO(p_waste2,z));
2545  BioR_CO(p_bio,z)$(Bio_CO(p_bio,z) > 0)                         = Bio_CO(p_bio,z)/ sum(p_bio2, Bio_CO(p_bio2,z));
2546  CharcoalR_CO(p_charcoal,z)$(Charcoal_CO(p_charcoal,z) > 0)     = Charcoal_CO(p_charcoal,z)/ sum(p_charcoal2, Charcoal_CO(p_charcoal2,z));
2547  RenR_CO(p_ren,z)$(Ren_CO(p_ren,z) > 0)                         = Ren_CO(p_ren,z)/ sum(p_ren2, Ren_CO(p_ren2,z));
2548   
2549  *==============================================================================
2550  * Export to GDX
2551  *==============================================================================
2552  execute_unload 'Input_CGE/DATA_WEB-2019_260425.gdx',
2553  * Sets
2554  product, p_coal, p_oil, p_oilproduct, p_gas, p_elecheat,
2555  flow, f_elec, f_agri, f_mining, f_foodpro, f_textiles, f_woodpro, f_paperpro,
2556  f_chemical, f_nonmet, f_ironstl, f_nonferr, f_machine, f_transeq, f_otherind,
2557  f_construc, f_ser, f_household, f_roadrail, f_domeair, f_domewater,
2558  f_nemining, f_nefoodpro, f_netextiles, f_newoodpro, f_nepaperpro,
2559  f_nechemical, f_nenonmet, f_neironstl, f_nenonferr, f_nemachine,
2560  f_netranseq, f_neotherind, f_neconstruc, f_netransport, f_neother,
2561   
2562  * Parameters
2563  WEB,
2564  Coal_DIO, Coal_CO, CoalR_DIO, CoalR_CO,
2565  Gas_DIO, Gas_CO, GasR_DIO, GasR_CO,
2566  Oil_DIO, Oil_CO, OilR_DIO,
2567  Oilp_DIO, Oilp_CO, OilpR_DIO, OilpR_CO,
2568  Elec_DIO, Elec_CO, ElecR_DIO, ElecR_CO,
2569  Waste_DIO, Waste_CO, WasteR_DIO, WasteR_CO,
2570  Bio_DIO, Bio_CO, BioR_DIO, BioR_CO,
2571  Charcoal_DIO, Charcoal_CO, CharcoalR_DIO, CharcoalR_CO,
2572  Ren_DIO, Ren_CO, RenR_DIO, RenR_CO,
2573  NCoal_DIO, NCoalR_DIO, NGas_DIO, NGasR_DIO,
2574  NOil_DIO, NOilR_DIO, NOilp_DIO, NOilpR_DIO,
2575  Coal_Total, Gas_Total, Oilp_Total, Elec_Total, NCoal_Total, NGas_Total, NOilp_Total,
2576  Coal_Marine, Coal_Aviation, Gas_Marine, Gas_Aviation, Oilp_Marine, Oilp_Aviation, Bio_Marine, Bio_Aviation,
2577  TES_Coal, TES_Gas, TES_Oil, TES_Oilproduct
2578  ;
INCLUDE    C:\Users\kimc0\GUIDE_GLOBAL_CGE\2.GUIDE-GLOBAL-CGE_v2\Input_CGE\DATA_CO2coef.gms
2580  *==============================================================================
2581  * [1] ENERGY CONSUMPTION & INTENSITY (VOLUME BASE)
2582  *==============================================================================
2583  Parameters
2584      EEI(product,j,z)  "Energy intensity by industry sector (ktoe per billion $)"
2585      NEI(product,j,z)  "Non-Energy intensity by production sector (ktoe per billion $)"
2586      EHI(product,z)    "Energy intensity by household (ktoe per billion $)"
2587   
2588      EEO(product,j,z)  "Initial Industry energy consumption in region z (ktoe)"
2589      NEO(product,j,z)  "Initial Industry non-energy consumption in region z (ktoe)"
2590      EHO(product,z)    "Initial Household energy consumption in region z (ktoe)"
2591   
2592      Marinebunker(product,z)
2593      Aviationbunker(product,z)
2594  ;
2595   
2596  * -------------------------------------------------------------------
2597  * 1.1 Energy Intensity (Pure combustion: Total demand - Non-energy)
2598  * -------------------------------------------------------------------
2599  EEI(p_coal,j,z)$(DEO('02_COAL',j,z) > 0)
2600      = (Coal_DIO(p_coal,j,z) - NCoal_DIO(p_coal,j,z)) / DEO('02_COAL',j,z);
2601   
2602  EEI(p_oil,j,z)$(DEO('03_OIL',j,z) > 0)
2603      = Oil_DIO(p_oil,j,z)  / DEO('03_OIL',j,z);
2604   
2605  EEI(p_gas,j,z)$(DEO('04_GAS',j,z) > 0)
2606      = (Gas_DIO(p_gas,j,z) - NGas_DIO(p_gas,j,z)) / DEO('04_GAS',j,z);
2607   
2608  EEI(p_oilproduct,j,z)$(DEO('10_PETROLCOAL',j,z) > 0)
2609      = (Oilp_DIO(p_oilproduct,j,z) - NOilp_DIO(p_oilproduct,j,z)) / DEO('10_PETROLCOAL',j,z);
2610   
2611  EEI(p_elecheat,j,z)$(DEO('18_ELEC',j,z) > 0)
2612      = Elec_DIO(p_elecheat,j,z) / DEO('18_ELEC',j,z);
2613   
2614  EEI(p_waste,j,z)$(XSTO(j,z) > 0)    = Waste_DIO(p_waste,j,z) / XSTO(j,z);
2615  EEI(p_bio,j,z)$(XSTO(j,z) > 0)      = Bio_DIO(p_bio,j,z) / XSTO(j,z);
2616  EEI(p_charcoal,j,z)$(XSTO(j,z) > 0) = Charcoal_DIO(p_charcoal,j,z) / XSTO(j,z);
2617  EEI(p_ren,j,z)$(XSTO(j,z) > 0)      = Ren_DIO(p_ren,j,z) / XSTO(j,z);
2618   
2619  * -------------------------------------------------------------------
2620  * 1.2 Non-Energy Intensity
2621  * -------------------------------------------------------------------
2622  NEI(p_coal,j,z)$(DEO('02_COAL',j,z) > 0)             = NCoal_DIO(p_coal,j,z) / DEO('02_COAL',j,z);
2623  NEI(p_gas,j,z)$(DEO('04_GAS',j,z) > 0)               = NGas_DIO(p_gas,j,z) / DEO('04_GAS',j,z);
2624  NEI(p_oilproduct,j,z)$(DEO('10_PETROLCOAL',j,z) > 0) = NOilp_DIO(p_oilproduct,j,z) / DEO('10_PETROLCOAL',j,z);
2625   
2626  * -------------------------------------------------------------------
2627  * 1.3 Household Intensity
2628  * -------------------------------------------------------------------
2629  EHI(p_coal,z)$(CO('02_COAL',z) > 0)             = Coal_CO(p_coal,z) / CO('02_COAL',z);
2630  EHI(p_oil,z)$(CO('03_OIL',z) > 0)               = Oil_CO(p_oil,z) / CO('03_OIL',z);
2631  EHI(p_gas,z)$(CO('04_GAS',z) > 0)               = Gas_CO(p_gas,z) / CO('04_GAS',z);
2632  EHI(p_oilproduct,z)$(CO('10_PETROLCOAL',z) > 0) = Oilp_CO(p_oilproduct,z) / CO('10_PETROLCOAL',z);
2633  EHI(p_elecheat,z)$(CO('18_ELEC',z) > 0)         = Elec_CO(p_elecheat,z) / CO('18_ELEC',z);
2634   
2635  EHI(p_waste,z)    = Waste_CO(p_waste,z) / TOT_POP(z,'2019');
2636  EHI(p_bio,z)      = Bio_CO(p_bio,z) / TOT_POP(z,'2019');
2637  EHI(p_charcoal,z) = Charcoal_CO(p_charcoal,z) / TOT_POP(z,'2019');
2638  EHI(p_ren,z)      = Ren_CO(p_ren,z) / TOT_POP(z,'2019');
2639   
2640  * -------------------------------------------------------------------
2641  * 1.4 Initial Energy Consumption Assignments
2642  * -------------------------------------------------------------------
2643  EEO(p_coal,j,z)       = Coal_DIO(p_coal,j,z) ;
2644  EEO(p_gas,j,z)        = Gas_DIO(p_gas,j,z) ;
2645  EEO(p_oil,j,z)        = Oil_DIO(p_oil,j,z) ;
2646  EEO(p_oilproduct,j,z) = Oilp_DIO(p_oilproduct,j,z) ;
2647  EEO(p_elecheat,j,z)   = Elec_DIO(p_elecheat,j,z) ;
2648  EEO(p_waste,j,z)      = Waste_DIO(p_waste,j,z) ;
2649  EEO(p_bio,j,z)        = Bio_DIO(p_bio,j,z) ;
2650  EEO(p_charcoal,j,z)   = Charcoal_DIO(p_charcoal,j,z) ;
2651  EEO(p_ren,j,z)        = Ren_DIO(p_ren,j,z) ;
2652   
2653  NEO(p_coal,j,z)       = NCoal_DIO(p_coal,j,z) ;
2654  NEO(p_gas,j,z)        = NGas_DIO(p_gas,j,z) ;
2655  NEO(p_oilproduct,j,z) = NOilp_DIO(p_oilproduct,j,z) ;
2656   
2657  EHO(p_coal,z)         = Coal_CO(p_coal,z) ;
2658  EHO(p_gas,z)          = Gas_CO(p_gas,z) ;
2659  EHO(p_oil,z)          = Oil_CO(p_oil,z) ;
2660  EHO(p_oilproduct,z)   = Oilp_CO(p_oilproduct,z) ;
2661  EHO(p_elecheat,z)     = Elec_CO(p_elecheat,z) ;
2662  EHO(p_waste,z)        = Waste_CO(p_waste,z);
2663  EHO(p_bio,z)          = Bio_CO(p_bio,z);
2664  EHO(p_charcoal,z)     = Charcoal_CO(p_charcoal,z);
2665  EHO(p_ren,z)          = Ren_CO(p_ren,z);
2666   
2667  Marinebunker(p_gas,z)          = gas_Marine(p_gas,z);
2668  Marinebunker(p_oilproduct,z)   = Oilp_Marine(p_oilproduct,z);
2669  Marinebunker(p_Bio,z)          = Bio_Marine(p_Bio,z);
2670  Aviationbunker(p_oilproduct,z) = Oilp_Aviation(p_oilproduct,z);
2671   
2672   
2673  *==============================================================================
2674  * [2] GREENHOUSE GAS (GHG) EMISSIONS SETS & PARAMETERS
2675  *==============================================================================
2676  Sets
2677      emis_type / Energy, Industry, LTRP, ATRP, WTRP, Other /
2678   
2679      map_sec_emis(j, emis_type)
2680      /
2681        02_COAL.Energy, 03_OIL.Energy, 04_GAS.Energy, 10_PETROLCOAL.Energy,
2682        18_TnD.Energy, 19_eNuclear.Energy, 20_eCoal.Energy, 21_eGas.Energy,
2683        22_eOil.Energy, 23_eWind.Energy, 24_eSolar.Energy, 25_eHydro.Energy, 26_eOther.Energy
2684   
2685        05_MINING.Industry, 06_FOODPRO.Industry, 07_TEXTILES.Industry, 08_WOODPRO.Industry,
2686        09_PAPERPRO.Industry, 11_CHEMICAL.Industry, 12_NONMET.Industry, 13_IRONSTL.Industry,
2687        14_NONFERR.Industry, 15_MACHINE.Industry, 16_TRANSEQ.Industry, 17_OTHERIND.Industry,
2688        27_CONSTRUC.Industry
2689   
2690        28_LTRP.LTRP
2691        29_WTRP.WTRP
2692        30_ATRP.ATRP
2693   
2694        01_AGRICULT.Other, 31_SER.Other
2695      /
2696   
2697      map_CH4_type(emis_type, type)
2698      / Energy.CH4EF_Energy, Industry.CH4EF_Industry, LTRP.CH4EF_LTRP, ATRP.CH4EF_ATRP, WTRP.CH4EF_WTRP, Other.CH4EF_Other /
2699   
2700      map_N2O_type(emis_type, type)
2701      / Energy.N2OEF_Energy, Industry.N2OEF_Industry, LTRP.N2OEF_LTRP, ATRP.N2OEF_ATRP, WTRP.N2OEF_WTRP, Other.N2OEF_Other /
2702  ;
2703   
2704  Parameters
2705      Emiss_CO2(j,z)       "CO2 emissions by industry sector (tCO2)"
2706      Emiss_CH4(j,z)       "CH4 emissions by industry sector (tCH4)"
2707      Emiss_N2O(j,z)       "N2O emissions by industry sector (tN2O)"
2708      Emiss_GHG(j,z)       "Total GHG emissions by industry sector (tCO2eq)"
2709   
2710      Emiss_CO2_HH(z)      "Household CO2 emissions (tCO2)"
2711      Emiss_CH4_HH(z)      "Household CH4 emissions (tCH4)"
2712      Emiss_N2O_HH(z)      "Household N2O emissions (tN2O)"
2713      Emiss_GHG_HH(z)      "Total Household GHG emissions (tCO2eq)"
2714   
2715      GWP_CH4 / 28 /
2716      GWP_N2O / 265 /
2717  ;
2718   
2719   
2720  *==============================================================================
2721  * [3] GHG EMISSIONS CALCULATIONS (PHYSICAL VOLUME BASE)
2722  *==============================================================================
2723  * -------------------------------------------------------------------
2724  * 3.1 Industry CO2 Emissions
2725  * Formula: ktoe * 41.868 (TJ conversion) * CO2EF (tC/TJ) * (44/12)
2726  * -------------------------------------------------------------------
2727  Emiss_CO2(j,z) =
2728    sum(p_coal,
2729        max(0, Coal_DIO(p_coal,j,z) - (NCoal_DIO(p_coal,j,z) * GHGsEF(p_coal,'Stored_rate')))
2730        * 41.868 * GHGsEF(p_coal,'CO2EF') * (44/12)
2731    )
2732  + sum(p_oilproduct,
2733        max(0, Oilp_DIO(p_oilproduct,j,z) - (NOilp_DIO(p_oilproduct,j,z) * GHGsEF(p_oilproduct,'Stored_rate')))
2734        * 41.868 * GHGsEF(p_oilproduct,'CO2EF') * (44/12)
2735    )
2736  + sum(p_gas,
2737        max(0, Gas_DIO(p_gas,j,z) - (NGas_DIO(p_gas,j,z) * GHGsEF(p_gas,'Stored_rate')))
2738        * 41.868 * GHGsEF(p_gas,'CO2EF') * (44/12)
2739    )
2740  * Direct combustion of crude oil (excluding refinery inputs to prevent double counting)
2741  + sum(p_oil,
2742        max(0, Oil_DIO(p_oil,j,z))
2743        * 41.868 * GHGsEF(p_oil,'CO2EF') * (44/12)
2744    )$(not sameas(j, '10_PETROLCOAL'))
2745  * Deduct carbon from steel by-product gas (prevent double counting & adjust process emissions)
2746  - sum(p_irongas,
2747        Gas_Prod_Iron(p_irongas, z)$sameas(j,'13_IRONSTL')
2748        * 41.868 * GHGsEF(p_irongas,'CO2EF') * (44/12)
2749    )
2750  ;
2751   
2752  * -------------------------------------------------------------------
2753  * 3.2 Industry CH4 & N2O Emissions
2754  * Note: Non-energy use does not combust, hence (DIO - N_DIO) is used.
2755  * -------------------------------------------------------------------
2756  Emiss_CH4(j,z) =
2757    sum(emis_type$map_sec_emis(j, emis_type),
2758      sum(type$map_CH4_type(emis_type, type),
2759          sum(p_coal,       max(0, Coal_DIO(p_coal,j,z)       - NCoal_DIO(p_coal,j,z))       * 41.868 * GHGsEF(p_coal, type) / 1000)
2760        + sum(p_oilproduct, max(0, Oilp_DIO(p_oilproduct,j,z) - NOilp_DIO(p_oilproduct,j,z)) * 41.868 * GHGsEF(p_oilproduct, type) / 1000)
2761        + sum(p_gas,        max(0, Gas_DIO(p_gas,j,z)         - NGas_DIO(p_gas,j,z))         * 41.868 * GHGsEF(p_gas, type) / 1000)
2762      )
2763    );
2764   
2765  Emiss_N2O(j,z) =
2766    sum(emis_type$map_sec_emis(j, emis_type),
2767      sum(type$map_N2O_type(emis_type, type),
2768          sum(p_coal,       max(0, Coal_DIO(p_coal,j,z)       - NCoal_DIO(p_coal,j,z))       * 41.868 * GHGsEF(p_coal, type) / 1000)
2769        + sum(p_oilproduct, max(0, Oilp_DIO(p_oilproduct,j,z) - NOilp_DIO(p_oilproduct,j,z)) * 41.868 * GHGsEF(p_oilproduct, type) / 1000)
2770        + sum(p_gas,        max(0, Gas_DIO(p_gas,j,z)         - NGas_DIO(p_gas,j,z))         * 41.868 * GHGsEF(p_gas, type) / 1000)
2771      )
2772    );
2773   
2774  Emiss_GHG(j,z) = Emiss_CO2(j,z) + (Emiss_CH4(j,z) * GWP_CH4) + (Emiss_N2O(j,z) * GWP_N2O);
2775   
2776  * -------------------------------------------------------------------
2777  * 3.3 Household Emissions
2778  * -------------------------------------------------------------------
2779  Emiss_CO2_HH(z) =
2780      sum(p_coal, Coal_CO(p_coal,z) * 41.868 * GHGsEF(p_coal,'CO2EF') * (44/12))
2781    + sum(p_oilproduct, Oilp_CO(p_oilproduct,z) * 41.868 * GHGsEF(p_oilproduct,'CO2EF') * (44/12))
2782    + sum(p_gas, Gas_CO(p_gas,z) * 41.868 * GHGsEF(p_gas,'CO2EF') * (44/12));
2783   
2784  Emiss_CH4_HH(z) =
2785      sum(p_coal, Coal_CO(p_coal,z) * 41.868 * GHGsEF(p_coal,'CH4EF_Other') / 1000)
2786    + sum(p_oilproduct, Oilp_CO(p_oilproduct,z) * 41.868 * GHGsEF(p_oilproduct,'CH4EF_Other') / 1000)
2787    + sum(p_gas, Gas_CO(p_gas,z) * 41.868 * GHGsEF(p_gas,'CH4EF_Other') / 1000);
2788   
2789  Emiss_N2O_HH(z) =
2790      sum(p_coal, Coal_CO(p_coal,z) * 41.868 * GHGsEF(p_coal,'N2OEF_Other') / 1000)
2791    + sum(p_oilproduct, Oilp_CO(p_oilproduct,z) * 41.868 * GHGsEF(p_oilproduct,'N2OEF_Other') / 1000)
2792    + sum(p_gas, Gas_CO(p_gas,z) * 41.868 * GHGsEF(p_gas,'N2OEF_Other') / 1000);
2793   
2794  Emiss_GHG_HH(z) = Emiss_CO2_HH(z) + (Emiss_CH4_HH(z) * GWP_CH4) + (Emiss_N2O_HH(z) * GWP_N2O);
2795   
2796   
2797  *==============================================================================
2798  * [4] CARBON INTENSITY FACTORS (CO2FACTOR) CALCULATION
2799  *==============================================================================
2800  Parameters
2801      GHG_Energy(ene,j,z)         "CO2 emissions from Energy Sector 1.A. by IO sector (tCO2)"
2802      GHG_Energy_HH(ene,z)        "Household CO2 emissions by energy source (tCO2)"
2803   
2804      CO2FACTOR(ene,j,z)          "CO2 emissions factor for industry (tCO2 per 100$)"
2805      CO2FACTORHH(ene,z,time)     "Time series CO2 emissions factor for household (tCO2 per 100$)"
2806      Global_CO2FACTOR(ene,j)     "Global average CO2 emissions factor (tCO2 per 100$)"
2807      CO2FACTOR2(ene,j,z,time)    "Time series CO2 emissions factor for industry (tCO2 per 100$)"
2808  ;
2809   
2810  * -------------------------------------------------------------------
2811  * 4.1 GHG Allocation by IO Energy Sectors
2812  * -------------------------------------------------------------------
2813  GHG_Energy('02_COAL',j,z) =
2814      sum(p_coal,
2815          max(0, Coal_DIO(p_coal,j,z) - (NCoal_DIO(p_coal,j,z) * GHGsEF(p_coal,'Stored_rate')))
2816          * 41.868 * GHGsEF(p_coal,'CO2EF') * (44/12)
2817      )
2818  - sum(p_irongas, Gas_Prod_Iron(p_irongas, z)$sameas(j,'13_IRONSTL') * 41.868 * GHGsEF(p_irongas,'CO2EF') * (44/12));
2819   
2820  GHG_Energy('03_OIL',j,z) =
2821      sum(p_oil,
2822          max(0, Oil_DIO(p_oil,j,z)* GHGsEF(p_oil,'Stored_rate'))
2823          * 41.868 * GHGsEF(p_oil,'CO2EF') * (44/12)
2824      )$(not sameas(j, '10_PETROLCOAL'));
2825   
2826  GHG_Energy('04_GAS',j,z) =
2827      sum(p_gas,
2828          max(0, Gas_DIO(p_gas,j,z) - (NGas_DIO(p_gas,j,z) * GHGsEF(p_gas,'Stored_rate')))
2829          * 41.868 * GHGsEF(p_gas,'CO2EF') * (44/12)
2830      );
2831   
2832  GHG_Energy('10_PETROLCOAL',j,z) =
2833      sum(p_oilproduct,
2834          max(0, Oilp_DIO(p_oilproduct,j,z) - (NOilp_DIO(p_oilproduct,j,z) * GHGsEF(p_oilproduct,'Stored_rate')))
2835          * 41.868 * GHGsEF(p_oilproduct,'CO2EF') * (44/12)
2836      )
2837      - sum(p_oilproduct, Coke_Prod_Iron(p_oilproduct, z)$sameas(j,'13_IRONSTL') * 41.868 * GHGsEF(p_oilproduct,'CO2EF') * (44/12));
2838   
2839  * Household allocation
2840  GHG_Energy_HH('02_COAL',z)       = sum(p_coal, Coal_CO(p_coal,z) * 41.868 * GHGsEF(p_coal,'CO2EF') * (44/12));
2841  GHG_Energy_HH('03_OIL',z)        = sum(p_oil, Oil_CO(p_oil,z) * 41.868 * GHGsEF(p_oil,'CO2EF') * (44/12));
2842  GHG_Energy_HH('04_GAS',z)        = sum(p_gas, Gas_CO(p_gas,z) * 41.868 * GHGsEF(p_gas,'CO2EF') * (44/12));
2843  GHG_Energy_HH('10_PETROLCOAL',z) = sum(p_oilproduct, Oilp_CO(p_oilproduct,z) * 41.868 * GHGsEF(p_oilproduct,'CO2EF') * (44/12));
2844   
2845   
2846  * -------------------------------------------------------------------
2847  * 4.2 Base CO2FACTOR Calculations (1 Billion $ = 10,000,000 * 100$)
2848  * -------------------------------------------------------------------
2849  CO2FACTOR('02_COAL',j,z)$(DEO('02_COAL',j,z) > 0)
2850      = GHG_Energy('02_COAL',j,z) / (DEO('02_COAL',j,z) * 10000000);
2851   
2852  CO2FACTOR('03_OIL',j,z)$(DEO('03_OIL',j,z) > 0)
2853      = GHG_Energy('03_OIL',j,z) / (DEO('03_OIL',j,z) * 10000000);
2854   
2855  CO2FACTOR('04_GAS',j,z)$(DEO('04_GAS',j,z) > 0)
2856      = GHG_Energy('04_GAS',j,z) / (DEO('04_GAS',j,z) * 10000000);
2857   
2858  CO2FACTOR('10_PETROLCOAL',j,z)$(DEO('10_PETROLCOAL',j,z) > 0)
2859      = GHG_Energy('10_PETROLCOAL',j,z) / (DEO('10_PETROLCOAL',j,z) * 10000000);
2860   
2861  * Household Intensity (Denominator: Final Consumption CO)
2862  CO2FACTORHH('02_COAL',z,time)$(CO('02_COAL',z) > 0)
2863      = GHG_Energy_HH('02_COAL',z) / (CO('02_COAL',z) * 10000000);
2864   
2865  CO2FACTORHH('03_OIL',z,time)$(CO('03_OIL',z) > 0)
2866      = GHG_Energy_HH('03_OIL',z) / (CO('03_OIL',z) * 10000000);
2867   
2868  CO2FACTORHH('04_GAS',z,time)$(CO('04_GAS',z) > 0)
2869      = GHG_Energy_HH('04_GAS',z) / (CO('04_GAS',z) * 10000000);
2870   
2871  CO2FACTORHH('10_PETROLCOAL',z,time)$(CO('10_PETROLCOAL',z) > 0)
2872      = GHG_Energy_HH('10_PETROLCOAL',z) / (CO('10_PETROLCOAL',z) * 10000000);
2873   
2874  *==============================================================================
2875  * [5] SMOOTHING, CALIBRATION & REGIONAL SCALING
2876  *==============================================================================
2877  * -------------------------------------------------------------------
2878  * 5.1 Global Average Calculations
2879  * -------------------------------------------------------------------
2880  Global_CO2FACTOR('02_COAL',j)$(sum(z, DEO('02_COAL',j,z)) > 0)
2881      = sum(z, GHG_Energy('02_COAL',j,z)) / (sum(z, DEO('02_COAL',j,z)) * 10000000);
2882   
2883  Global_CO2FACTOR('03_OIL',j)$(sum(z, DEO('03_OIL',j,z)) > 0)
2884      = sum(z, GHG_Energy('03_OIL',j,z)) / (sum(z, DEO('03_OIL',j,z)) * 10000000);
2885   
2886  Global_CO2FACTOR('04_GAS',j)$(sum(z, DEO('04_GAS',j,z)) > 0)
2887      = sum(z, GHG_Energy('04_GAS',j,z)) / (sum(z, DEO('04_GAS',j,z)) * 10000000);
2888   
2889  Global_CO2FACTOR('10_PETROLCOAL',j)$(sum(z, DEO('10_PETROLCOAL',j,z)) > 0)
2890      = sum(z, GHG_Energy('10_PETROLCOAL',j,z)) / (sum(z, DEO('10_PETROLCOAL',j,z)) * 10000000);
2891   
2892  * -------------------------------------------------------------------
2893  * 5.2 Outlier Smoothing & Net Zero Feasibility Capping
2894  * -------------------------------------------------------------------
2895  Parameter
2896      Threshold_Multiplier / 2 /
2897      NZ_Safety_Cap        / 2.5 /
2898      Total_Emiss_Ref(z)   "Store total emissions BEFORE calibration"
2899      Scale_Factor(z)      "Regional scale factor to preserve total volume"
2900      Final_Emiss_Check(z) "Validation check for final volume"
2901      Emiss_Diff(z)        "Difference between original and calibrated volumes"
2902  ;
2903   
2904  * [CRITICAL] Save baseline reference volume BEFORE any modifications
2905  Total_Emiss_Ref(z) = sum((ene,j), GHG_Energy(ene,j,z));
2906   
2907  * Step 1: Generic outlier smoothing (Cutoff based on global average)
2908  CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) > Global_CO2FACTOR(ene,j) * Threshold_Multiplier)
2909      = Global_CO2FACTOR(ene,j);
2910   
2911  * Step 2: Targeted Hard Cap for '17_OTHERIND' (Net Zero Feasibility)
2912  * Suppress extreme noise in the "Other Industry" sector to prevent solver failure.
2913  CO2FACTOR(ene,'17_OTHERIND',z)$(CO2FACTOR(ene,'17_OTHERIND',z) > NZ_Safety_Cap)
2914      = NZ_Safety_Cap;
2915   
2916   
2917  * -------------------------------------------------------------------
2918  * 5.3 Volume Redistribution & Scaling
2919  * -------------------------------------------------------------------
2920  * Calculate scaling factor to redistribute smoothed intensity evenly
2921  Scale_Factor(z)$(sum((ene,j), CO2FACTOR(ene,j,z) * DEO(ene,j,z)) > 0)
2922      = Total_Emiss_Ref(z) / sum((ene,j), CO2FACTOR(ene,j,z) * DEO(ene,j,z) * 10000000);
2923   
2924  * Manual override for PRK (North Korea) due to severe data mismatch
2925  Scale_Factor('06_PRK') = 1.05;
2926   
2927  * Apply regional scale factor to finalize calibrated CO2FACTOR
2928  CO2FACTOR(ene,j,z) = CO2FACTOR(ene,j,z) * Scale_Factor(z);
2929   
2930   
2931  * -------------------------------------------------------------------
2932  * 5.4 Data Integrity Verification & Time Series Assignment
2933  * -------------------------------------------------------------------
2934  Final_Emiss_Check(z) = sum((ene,j), CO2FACTOR(ene,j,z) * DEO(ene,j,z) * 10000000);
2935  Emiss_Diff(z)        = Total_Emiss_Ref(z) - Final_Emiss_Check(z);
2936   
2937  * Prevent zeros or negative values for solver stability (CES function requirement)
2938  CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) < 0) = 0.1 ;
2939   
2940  * Assign to Time Series Parameter for model baseline
2941  CO2FACTOR2(ene,j,z,time) = CO2FACTOR(ene,j,z);
2942   
2943   
2944   
2945   
2946  *==============================================================================
2947  * Carbon tax & Permit
2948  *==============================================================================
2949  PARAMETER
2950   CTAXO(z)           Initial Carbon tax 100$ per ton CO2
2951   TCTAXO(z)          Initial Government Revenue from Carbon tax
2952   PERMITO(j,z)       ton CO2 emissions
2953   PERMIT_TOTALO(z)   Total CO2 emissions (billion ton)
2954  ;
2955   CTAXO(z)           = 0;
2956   TCTAXO(z)          = 0;
2957   PERMITO(j,z)       = SUM(ene, CO2FACTOR(ene,j,z) * DEO(ene,j,z));
2958   PERMIT_TOTALO(z)   = SUM(j, PERMITO(j,z));
2959   
2960  *==============================================================================
2961  * Marginal Abatement Curves(MAC) for emissions
2962  *==============================================================================
2963  PARAMETER
2964   alpha_CO2(ene,j,z)             Emissions responsiveness parameter
2965   gamma_CO2(ene,j,z)             Adjustment speed parameter
2966   MINCO2FACTOR(ene,j,z)          Minimum CO2 emission factor
2967   CTAX_CO2(ene,j,z,time)
2968   CO2FACTOR2_Star(ene,j,z,time)
2969  ;
2970   alpha_CO2(ene,j,z)     = 0.15;
2971   gamma_CO2(ene,j,z)     = 1.5;
2972   MINCO2FACTOR(ene,j,z)  = CO2FACTOR(ene,j,z) * 0.01;
2973   
2974  SCALAR
2975   adjustment_factor
2976   trigger_price
2977   SolarWind_TFP_BAU
2978   SolarWind_TFP_NDC
2979   SolarWind_TFP_NZ
2980   residual_ratio
2981  ;
2982   
2983   adjustment_factor = 0.5;
2984   trigger_price     = 1.0;
2985   SolarWind_TFP_BAU = 0.02;
2986   SolarWind_TFP_NDC = 0.02;
2987   SolarWind_TFP_NZ  = 0.04;
2988   residual_ratio    = 0.05;
2989   
2990   TIWO_Share(j,z)   = LDO(j,z) / LSO(z);
2991   TIKO_Share(k,j,z) = KDO(k,j,z) / KSO(k,z);
2992   TIPO_Share(j,z)   = XSTO(j,z) / SUM(jj, XSTO(jj,z));
2993   
2994  *==============================================================================
2995  * Direct Air Capture (DAC)
2996  *==============================================================================
2997  PARAMETER
2998   DAC_TRIGGER            DAC trigger Price (100$ per tCO2)
2999   DAC_MAX(z)             Maximum DAC yearly
3000   DAC_growth_rate(z,time)
3001   DAC_Max_Pen(z)         Maximum Penetration
3002   DAC_Logistic_Coeff(z)  Logistic Growth Rate
3003   DAC_Inflection(z)      Inflection Lapse
3004   DAC_Start_Year(z)      First Triggered Year
3005   DAC_Tech_Coeff(i)
3006   switchDAC(z,time)      Binary parameter
3007   ;
3008   SCALAR DAC_Unit_Scale       100MilliontCO2 to tCO2 / 100000000 /;
3009   SCALAR DAC_Elec_Intensity   MWh needed per ton CO2 / 2.5 /;
3010   SCALAR Price_USD_MWh        USD per MWh / 107.14 /;
3011   
3012   DAC_TRIGGER                 = 5.0;
3013   DAC_MAX(z)                  = sum(j,PERMITO(j,z))*0.2;
3014   DAC_MAX('17_ANZ')           = sum(j,PERMITO(j,'17_ANZ'))*0.6;
3015   DAC_growth_rate(z,time)     = 0;
3016   DAC_Max_Pen(z)              = 1.0;
3017   DAC_Logistic_Coeff(z)       = 0.2;
3018   DAC_Inflection(z)           = 15;
3019   DAC_Start_Year(z)           = 0;
3020   DAC_Tech_Coeff('18_ELEC')   = (DAC_Unit_Scale * DAC_Elec_Intensity * Price_USD_MWh) / 10**10;
3021   switchDAC(z,time)           = 0;
3022   
3023  *==============================================================================
3024  * Labour Supply
3025  *==============================================================================
3026  PARAMETER
3027   W_lag(z,time)         Wage rate of type l labor in region z
3028   PIXCON_lag(z,time)    Consumer price index in region z
3029   LS_lag(z,time)        Supply of type l labor in region z (T-1)
3030   LST_lag(z,time)       Supply of type l labor in region z (Trend T-1)
3031  ;
3032   
3033  *==============================================================================
3034  * Residual
3035  *==============================================================================
3036  Parameter MRGN_RES(i) "Residual to absorb initial data discrepancies in global margin supply/demand";
3037  * Calculate difference between initial total supply and total demand as a fixed value
3038  MRGN_RES(i) = SUM(z$MRGNO(i,z), MRGNO(i,z))
3039              - SUM((z,zj,ij)$IMO(ij,zj,z), tmrg(i,ij,zj,z) * IMO(ij,zj,z));
3040   
3041  Parameter YROW_RES(z) "Residual for decimal error in initial data of YROW total revenue";
3042  * Calculate minor difference between book total revenue (YROWO) and sum of individual trade values as a fixed value
3043  YROW_RES(z) = YROWO(z)
3044              - { 1.0 * SUM((i,zj)$IMO(i,zj,z), IMO(i,zj,z) * [PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z))]) };
3045   
3046  *==============================================================================
3047  * [Terms of Trade Calibration] Base Year FOB / CIF Values and Weights
3048  *==============================================================================
3049  PARAMETER
3050    VFOB0(i,z,zj)   "Base year FOB value of exports"
3051    VCIF0(i,zj,z)   "Base year CIF value of imports"
3052    W_EXP(i,z,zj)   "Bilateral export weight (Laspeyres)"
3053    W_IMP(i,zj,z)   "Bilateral import weight (Laspeyres)"
3054    PWX0(i,z,zj)    "Base year World FOB price"
3055    PCIF0(i,zj,z)   "Base year World CIF price"
3056    PX_INDEXO(z)    "Base year export price index"
3057    PM_INDEXO(z)    "Base year import price index"
3058    TOTO(z)         "Base year terms of trade"
3059  ;
3060   
3061  * FOB value = export volume * international export price * exchange rate
3062   VFOB0(i,z,zj) = eO(z) * PWXO(i,z,zj) * EXO(i,z,zj);
3063  * CIF value = import volume * (international import price + international transport margin) * exchange rate
3064   VCIF0(i,zj,z) = eO(z) * IMO(i,zj,z) * (PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z)));
3065   
3066  * 2. Derive weights (share of each route to total export/import of country z)
3067   W_EXP(i,z,zj)$SUM((ii,zjj), VFOB0(ii,z,zjj)) = VFOB0(i,z,zj) / SUM((ii,zjj), VFOB0(ii,z,zjj));
3068   W_IMP(i,zj,z)$SUM((ii,zjj), VCIF0(ii,zjj,z)) = VCIF0(i,zj,z) / SUM((ii,zjj), VCIF0(ii,zjj,z));
3069   
3070  * 3. Store base year prices (for index denominator)
3071   PWX0(i,z,zj) = PWXO(i,z,zj);
3072   PCIF0(i,zj,z) = PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z));
3073   
3074   PX_INDEXO(z) = SUM((i,zj)$VFOB0(i,z,zj), W_EXP(i,z,zj) * (PWXO(i,z,zj) / PWX0(i,z,zj)));
3075   PM_INDEXO(z) = SUM((i,zj)$VCIF0(i,zj,z), W_IMP(i,zj,z) * ( (PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z))) / PCIF0(i,zj,z) ));
3076   
3077   TOTO(z)$PM_INDEXO(z) = PX_INDEXO(z) / PM_INDEXO(z);
3078   
3079  *==============================================================================
3080  * Scenario Parameter
3081  *==============================================================================
3082  PARAMETER
3083      A_VA_RES(z,time)                        "Value of A_VA to reproduce real GDP projections"
3084      GX(z,time)                              "Current government expenditures on goods and services in region z"
3085      G_REALX(z,time)                         "Current real government expenditures on goods and services in region z"
3086      INDX(k,j,z,time)                        "Volume of new type k capital investment to industry j in region z"
3087      sh0X(z,time)                            "Intercept (household savings)"
3088      sh1X(z,time)                            "Household savings rate"
3089      phi_trans(time)                         "Transition scalar for structural change"
3090   
3091      delta_t(j, z, time)                     "Annual depreciation rate by industry and region"
3092      delta_base(z)                           "Base macro depreciation rate"
3093      penalty_rate(j)                         "Early retirement (stranded asset) penalty rate"
3094   
3095      Signal(BS, Z_GRN, time)                 "Price signal for backstop technology adoption"
3096      alpha_val(BS)                           "Alpha parameter for TSF multiplier"
3097      Shift_Factor(time)                      "Exogenous shift factor over time"
3098   
3099      Transfer_Amount(BS, Conv, I_BS, Z_GRN)  "Total Beta share transferred from Conventional to Backstop"
3100      gr_BVAT(time)                           "Annual growth rate of new technology productivity"
3101      Temp_Cap(BS, Z_GRN, time)               "Temporary capacity limit for backstop adoption"
3102  ;
3103   
3104  SCALAR Target_Conv_Beta / 0.10 /;
3105   
3106  *==============================================================================
3107  * IAMC Reporting Parameter
3108  *==============================================================================
3109  Scalar
3110  GWhtoEJ GWh to EJ
3111  ktoetoEJ ktoe to EJ
3112  USD2019toUSD2010
3113  ;
3114   
3115  GWhtoEJ  = 3.6/(10**6);
3116  ktoetoEJ = 4.1868/(10**5) ;
3117  USD2019toUSD2010 = 86.5/100 ;
3118  *https://stats.oecd.org/index.aspx?DataSetCode=DACDEFL
3119   
3120  *Scalar CF ktoe to Exajoule ;
3121  *CF = 0.000041868 ;
3122   
3123  execute_unload 'Output_CGE\Baseyear_Calibration.gdx' ;
