3829  * NEP_CO(p_oillz) = sum((f_household), household_fne_oilproduct(f_household, p_oilproduct, z));
3830   
3831  *Ratio
3832  Loop(j,
3833      NOilR_DIO(p_oil,j,z)$(NOil_DIO(p_oil,j,z) gt 0)
3834           = NOil_DIO(p_oil,j,z)/sum(p_oil2, NOil_DIO(p_oil2,j,z));
3835       );
3836   
3837  *Oilproducts non-energy
3838   NOilp_DIO(p_oilproduct,'05_MINING',z) = sum(f_nemining, WEB(f_nemining, p_oilproduct, z));
3839   NOilp_DIO(p_oilproduct,'06_FOODPRO',z) = sum(f_nefoodpro, WEB(f_nefoodpro, p_oilproduct, z));
3840   NOilp_DIO(p_oilproduct,'07_TEXTILES',z) = sum(f_netextiles, WEB(f_netextiles, p_oilproduct, z));
3841   NOilp_DIO(p_oilproduct,'08_WOODPRO',z) = sum(f_newoodpro, WEB(f_newoodpro, p_oilproduct, z));
3842   NOilp_DIO(p_oilproduct,'09_PAPERPRO',z) = sum(f_nepaperpro, WEB(f_nepaperpro, p_oilproduct, z));
3843   NOilp_DIO(p_oilproduct,'11_CHEMICAL',z) = sum(f_nechemical, WEB(f_nechemical, p_oilproduct, z));
3844   NOilp_DIO(p_oilproduct,'12_NONMET',z) = sum(f_nenonmet, WEB(f_nenonmet, p_oilproduct, z));
3845   NOilp_DIO(p_oilproduct,'13_IRONSTL',z) = sum(f_neironstl, WEB(f_neironstl, p_oilproduct, z));
3846   NOilp_DIO(p_oilproduct,'14_NONFERR',z) = sum(f_nenonferr, WEB(f_nenonferr, p_oilproduct, z));
3847   NOilp_DIO(p_oilproduct,'15_MACHINE',z) = sum(f_nemachine, WEB(f_nemachine, p_oilproduct, z));
3848   NOilp_DIO(p_oilproduct,'16_TRANSEQ',z) = sum(f_netranseq, WEB(f_netranseq, p_oilproduct, z));
3849   NOilp_DIO(p_oilproduct,'17_OTHERIND',z) = sum(f_neotherind, WEB(f_neotherind, p_oilproduct, z));
3850   NOilp_DIO(p_oilproduct,'27_CONSTRUC',z) = sum(f_neconstruc, WEB(f_neconstruc, p_oilproduct, z));
3851   NOilp_DIO(p_oilproduct,'28_LTRP',z) = sum(f_netransport, WEB(f_netransport, p_oilproduct, z));
3852  * NEP_DIO(p_oilproduct,'29_WTRP',z) = sum((f_domewater), domewater_fne_oilproduct(f_domewater, p_oilproductproduct, z));
3853  * NEP_DIO(p_oilproduct,'30_ATRP',z) = sum((f_domeair), domeair_fne_oilproduct(f_domeair, p_oilproductproduct, z));
3854   NOilp_DIO(p_oilproduct,'31_SER',z) = sum(f_neother, WEB(f_neother, p_oilproduct, z) );
3855  * NEP_CO(p_oilproductlz) = sum((f_household), household_fne_oilproduct(f_household, p_oilproductproduct, z));
3856   
3857  *Ratio
3858  Loop(j,
3859      NOilpR_DIO(p_oilproduct,j,z)$(NOilp_DIO(p_oilproduct,j,z) gt 0)
3860           = NOilp_DIO(p_oilproduct,j,z)/sum(p_oilproduct2, NOilp_DIO(p_oilproduct2,j,z));
3861       );
