4034  *==============================================================================
4035  *  4.12 CO2FACTOR and CTAX
4036  *==============================================================================
4037  Parameters
4038   CO2_Energy(ene,j,z)        CO2 emissions from Energy
4039  ;
4040   
4041   CO2_Energy('02_COAL',j,z) = sum(p_coal,CO2IO(p_coal,j,z));
4042   CO2_Energy('03_OIL',j,z)  = sum(p_oil,CO2IO(p_oil,j,z));
4043   CO2_Energy('04_GAS',j,z)  = sum(p_gas,CO2IO(p_gas,j,z));
4044   CO2_Energy('10_PETROLCOAL',j,z)  = sum(p_oilproduct,CO2IO(p_oilproduct,j,z));
4045   
4046  Parameters
4047   CO2FACTOR(ene,j,z)       CO2 emissions factor (tCO2 per 100$)
4048   CO2FACTOR2(ene,j,z,time) Time series CO2 emissions factor (tCO2 per 100$)
4049  ;
4050   
4051   CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*(1000/(10**8));
4052   CO2FACTOR('03_OIL',j,z)$DEO('03_OIL',j,z)   = [sum(p_oil,CO2IO(p_oil,j,z))/DEO('03_OIL',j,z)]*(1000/(10**8));
4053   CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z)   = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*(1000/(10**8));
4054   CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*(1000/(10**8));
4055   
4056  Parameters
4057  Global_CO2FACTOR(ene,j)       Global Average CO2 emissions factor (tCO2 per 100$)
4058  ;
4059   
4060   Global_CO2FACTOR('02_COAL',j)            = [sum((p_coal,z),CO2IO(p_coal,j,z))/sum(z,DEO('02_COAL',j,z))]*(1000/(10**8));
4061   Global_CO2FACTOR('03_OIL',j)               = [sum((p_oil,z),CO2IO(p_oil,j,z))/sum(z,DEO('03_OIL',j,z))]*(1000/(10**8));
4062   Global_CO2FACTOR('04_GAS',j)              = [sum((p_gas,z),CO2IO(p_gas,j,z))/sum(z,DEO('04_GAS',j,z))]*(1000/(10**8));
4063   Global_CO2FACTOR('10_PETROLCOAL',j) = [sum((p_oilproduct,z),CO2IO(p_oilproduct,j,z))/sum(z,DEO('10_PETROLCOAL',j,z))]*(1000/(10**8));
4064   
      *MNG
      CO2FACTOR('02_COAL','31_SER','05_MNG')        = 2;
       
      *PRK
       CO2FACTOR('02_COAL','01_AGRICULT','06_PRK')        = CO2FACTOR('02_COAL','01_AGRICULT','05_MNG');
       CO2FACTOR('10_PETROLCOAL','01_AGRICULT','06_PRK')  = CO2FACTOR('10_PETROLCOAL','01_AGRICULT','05_MNG');
       CO2FACTOR('02_COAL','28_LTRP','06_PRK')            = CO2FACTOR('02_COAL','28_LTRP','05_MNG');
       CO2FACTOR('02_COAL','17_OTHERIND','06_PRK')        = CO2FACTOR('02_COAL','17_OTHERIND','05_MNG');
       
      *RUS
       CO2FACTOR('02_COAL','08_WOODPRO','04_RUS')    = CO2FACTOR('02_COAL','08_WOODPRO','10_EEU');
       CO2FACTOR('04_GAS','17_OTHERIND','04_RUS')      = SMAX(j$(not sameas(j, '17_OTHERIND')), CO2FACTOR('04_GAS', j, '04_RUS'));
       
      *LAM
       CO2FACTOR('04_GAS','02_COAL','08_LAM')             = CO2FACTOR('04_GAS','02_COAL','07_NAM');
       
      * CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) gt 10) = 10 ;
4084   
4085  CO2FACTOR(ene, j, z)$(
4086      not sameas(j, '13_IRONSTL') and
4087      not sameas(j, '20_eCoal') and
4088      not sameas(j, '21_eGas') and
4089      not sameas(j, '22_eOil')
4090  ) = MIN(CO2FACTOR(ene, j, z), Global_CO2FACTOR(ene, j));
4091   
4092  *Otherind Sector
4093   CO2FACTOR('02_COAL','17_OTHERIND',Z)$DEO('02_COAL','17_OTHERIND',z) = Global_CO2FACTOR('02_COAL','20_eCoal');
4094   CO2FACTOR('03_OIL','17_OTHERIND',Z)$DEO('03_OIL','17_OTHERIND',z) = Global_CO2FACTOR('03_OIL','03_OIL');
4095   CO2FACTOR('04_GAS','17_OTHERIND',Z)$DEO('04_GAS','17_OTHERIND',z) = Global_CO2FACTOR('04_Gas','21_eGas');
4096   CO2FACTOR('10_PETROLCOAL','17_OTHERIND',Z)$DEO('10_PETROLCOAL','17_OTHERIND',z) = Global_CO2FACTOR('10_PETROLCOAL','22_eOil');
4097   
4098   CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) lt 0) = 0.1 ;
4099   
4100   CO2FACTOR('02_COAL','20_eCoal','06_PRK') = CO2FACTOR('02_COAL','20_eCoal','05_MNG') ;
4101   
4102   CO2FACTOR('10_PETROLCOAL','22_eOil','06_PRK') = CO2FACTOR('10_PETROLCOAL','22_eOil','05_MNG') ;
4103   
4104   CO2FACTOR2(ene,j,z,time) = CO2FACTOR(ene,j,z);
4105   
4106  *===========
4107  * Coal 2.7tCO2 per 100$
4108  * CO2FACTOR2('02_COAL',j,z,time)$CO2FACTOR('02_COAL',j,z)           = 2.7 ;
4109  * Gas 1.8tCO2 per 100$
4110  * CO2FACTOR2('04_GAS',j,z,time)$CO2FACTOR('04_GAS',j,z)             = 0.67;
4111  * Oilrproduct  0.6tCO2 per 100$
4112  * CO2FACTOR2('10_PETROLCOAL',j,z,time)$CO2FACTOR('10_PETROLCOAL',j,z) = 0.67;
