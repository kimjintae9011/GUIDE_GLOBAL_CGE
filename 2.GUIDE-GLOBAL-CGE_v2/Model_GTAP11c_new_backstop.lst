4142  PARAMETER
4143   CTAXO(z)           Initial Carbon tax $ per ton CO2
4144   TCTAXO(z)          Initial Government Revenue from Carbon tax
4145   PERMITO(j,z)       CO2 emissions
4146   PERMIT_TOTALO(z)   Total CO2 emissions (billion ton)
4147   PERMIT_NEA_TOTALO
4148  ;
4149   CTAXO(z)           = 0;
4150   TCTAXO(z)          = 0;
4151   PERMITO(j,z)       = SUM(ene, CO2FACTOR(ene,j,z) * DEO(ene,j,z));
4152   PERMIT_TOTALO(z)   = SUM(j, PERMITO(j,z));
4153   PERMIT_NEA_TOTALO  = SUM(NEA, PERMIT_TOTALO(NEA));
4154   
4155  *==============================================================================
4156  * Marginal abatement curves for emissions
4157  *==============================================================================
4158  PARAMETER
4159   alpha_CO2(ene,j,z)             Emissions responsiveness parameter
4160   gamma_CO2(ene,j,z)             Adjustment speed parameter
4161   MINCO2FACTOR(ene,j,z)          Minimum CO2 emission factor
4162   CTAX_CO2(ene,j,z,time)
4163   CO2FACTOR2_Star(ene,j,z,time)
4164  ;
4165   alpha_CO2(ene,j,z)     = 0.15;
4166   gamma_CO2(ene,j,z)     = 1.5;
4167   MINCO2FACTOR(ene,j,z)  = CO2FACTOR(ene,j,z) * 0.01;
4168   
4169  SCALAR
4170   adjustment_factor
4171   trigger_price
4172   SolarWind_TFP_BAU
4173   SolarWind_TFP_NDC
4174   SolarWind_TFP_NZ
4175   residual_ratio
4176  ;
4177   
4178   adjustment_factor = 0.5;
4179   trigger_price     = 1.0;
4180   SolarWind_TFP_BAU = 0.02;
4181   SolarWind_TFP_NDC = 0.02;
4182   SolarWind_TFP_NZ  = 0.04;
4183   residual_ratio  = 0.05;
4184   
4185   TIWO_Share(j,z)   = LDO(j,z) / LSO(z);
4186   TIKO_Share(k,j,z) = KDO(k,j,z) / KSO(k,z);
4187   TIPO_Share(j,z)   = XSTO(j,z) / SUM(jj, XSTO(jj,z));
4188   
4189  *==============================================================================
4190  * Direct Air Capture
4191  *==============================================================================
4192  PARAMETER
4193   DAC_TRIGGER            DAC trigger Price (100$ per tCO2)
4194   DAC_MAX(z)                Maximum DAC yearly
4195   DAC_growth_rate(z,time)
4196   DAC_Max_Pen(z)         Maximum Penetration
4197   DAC_Logistic_Coeff(z)  Logistic Growth Rate
4198   DAC_Inflection(z)      Inflection Lapse
4199   DAC_Start_Year(z)      First Triggered Year
4200   DAC_Tech_Coeff(i)
4201   switchDAC(z,time)      Binary parameter
4202   ;
4203   
4204  SCALAR DAC_Unit_Scale       100MilliontCO2 to tCO2 / 100000000 /;
4205  SCALAR DAC_Elec_Intensity   MWh needed per ton CO2 / 2.5 /;
4206  SCALAR Price_USD_MWh        USD per MWh / 107.14 /;
4207   
4208   DAC_TRIGGER               = 5.0;
4209   DAC_MAX(z)                   = sum(j,PERMITO(j,z))*0.3;
4210   DAC_MAX('09_WEU')         = sum(j,PERMITO(j,'09_WEU'))*0.5;
4211   DAC_MAX('03_JPN')          = sum(j,PERMITO(j,'03_JPN'))*0.5;
4212   DAC_growth_rate(z,time)   = 0;
4213   DAC_Max_Pen(z)            = 1.0;
4214   DAC_Logistic_Coeff(z)     = 0.3;
4215   DAC_Inflection(z)         = 15;
4216   DAC_Start_Year(z)         = 0;
4217   DAC_Tech_Coeff('18_ELEC') = (DAC_Unit_Scale * DAC_Elec_Intensity * Price_USD_MWh) / 10**10;
4218   switchDAC(z,time)         = 0;
4219   
4220  *==============================================================================
4221  * Labour Supply
4222  *==============================================================================
4223  PARAMETER
4224   W_lag(z,time)         Wage rate of type l labor in region z
4225   PIXCON_lag(z,time)    Consumer price index in region z
4226   LS_lag(z,time)        Supply of type l labor in region z (T-1)
4227   LST_lag(z,time)       Supply of type l labor in region z (Trend T-1)
4228  ;
4229   
4230  *==============================================================================
4231  * Residual
4232  *==============================================================================
4233  Parameter MRGN_RES(i) "글로벌 마진 수급의 초기 데이터 불일치 흡수 잔차";
4234  * 초기 총공급량 - 초기 총수요량의 차이를 고정값으로 계산
4235  MRGN_RES(i) = SUM(z$MRGNO(i,z), MRGNO(i,z))
4236              - SUM((z,zj,ij)$IMO(ij,zj,z), tmrg(i,ij,zj,z) * IMO(ij,zj,z));
4237   
4238  Parameter YROW_RES(z) "YROW 총수입액 계산의 초기 데이터 소수점 오차 잔차";
4239  * 초기 장부상 총수입액(YROWO)과 개별 무역액 총합의 미세한 차이를 고정값으로 계산
4240  YROW_RES(z) = YROWO(z)
4241              - { 1.0 * SUM((i,zj)$IMO(i,zj,z), IMO(i,zj,z) * [PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z))]) };
4242   
4243  execute_unload 'Calibration_Check_GTAP11c';
4244  *$exit
