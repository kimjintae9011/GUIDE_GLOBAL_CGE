3304  ;
3305  *
3306   
3307  *f_balstfur(flow)
3308  *f_cokeoven(flow)
3309  * WEB(f_balstfur, 'p4_COKCOAL', z) = WEB(f_cokeoven, 'p66_TOTAL', z) ;
3310  * WEB(f_cokeoven, 'p4_COKCOAL', z) = WEB(f_cokeoven, 'p66_TOTAL', z) ;
3311   
3312   TCoke_Share(f_cokeoven,p_coal,z)$(WEB(f_cokeoven, p_coal, z) lt 0)  = WEB(f_cokeoven, p_coal, z)$(WEB(f_cokeoven, p_coal, z) lt 0)/sum(p_coal2, WEB(f_cokeoven, p_coal2, z)$(WEB(f_cokeoven, p_coal2, z) lt 0)) ;
3313   TBlast_Share(f_balstfur,p_coal,z)$(WEB(f_balstfur, p_coal, z) lt 0) = WEB(f_balstfur, p_coal, z)$(WEB(f_balstfur, p_coal, z) lt 0)/sum(p_coal2, WEB(f_balstfur, p_coal2, z)$(WEB(f_balstfur, p_coal2, z) lt 0)) ;
3314   
3315  *Coal
3316   Coal_DIO(p_coal,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_coal, z));
3317   Coal_DIO(p_coal,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_coal, z));
3318   Coal_DIO(p_coal,'03_OIL',z) = -1*sum((f_oil), WEB(f_oil, p_coal, z));
3319   Coal_DIO(p_coal,'04_GAS',z) = -1*sum((f_gas), WEB(f_gas, p_coal, z));
3320   Coal_DIO(p_coal,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_coal, z));
3321   Coal_DIO(p_coal,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_coal, z));
3322   Coal_DIO(p_coal,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_coal, z));
3323   Coal_DIO(p_coal,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_coal, z));
3324   Coal_DIO(p_coal,'09_PAPERPRO',z) = sum((f_paperpro), WEB(f_paperpro, p_coal, z));
3325   Coal_DIO(p_coal5,'10_PETROLCOAL',z) = -1*sum((f_petrolcoal), WEB(f_petrolcoal, p_coal5, z));
3326   Coal_DIO(p_coal,'11_CHEMICAL',z) = sum((f_chemical), WEB(f_chemical, p_coal, z));
3327   Coal_DIO(p_coal,'12_NONMET',z) = sum((f_nonmet), WEB(f_nonmet, p_coal, z));
3328   Coal_DIO(p_coal,'13_IRONSTL',z) = sum((f_ironstl), WEB(f_ironstl, p_coal, z))
3329   + sum(f_cokeoven, -1*TCoke_Share(f_cokeoven,p_coal,z)*WEB(f_cokeoven, 'p66_TOTAL', z))
3330   + sum(f_balstfur, -1*TBlast_Share(f_balstfur,p_coal,z)*WEB(f_balstfur, 'p66_TOTAL', z))
3331   + sum((f_Eblastcoke), -1*WEB(f_Eblastcoke, p_coal, z))
3332  ;
3333   
3334   Coal_DIO(p_coal,'14_NONFERR',z) = sum((f_nonferr), WEB(f_nonferr, p_coal, z));
3335   Coal_DIO(p_coal,'15_MACHINE',z) = sum((f_machine), WEB(f_machine, p_coal, z));
3336   Coal_DIO(p_coal,'16_TRANSEQ',z) = sum((f_transeq), WEB(f_transeq, p_coal, z));
3337   Coal_DIO(p_coal,'17_OTHERIND',z) = sum((f_otherind), WEB(f_otherind, p_coal, z));
3338   Coal_DIO(p_coal,'18_TnD',z) = 0 ;
3339   Coal_DIO(p_coal,'19_eNuclear',z) = 0 ;
3340   Coal_DIO(p_coal,'20_eCoal',z) = -1*sum((f_elec), WEB(f_elec, p_coal, z));
3341   Coal_DIO(p_coal,'19_eNuclear',z) = 0 ;
3342   Coal_DIO(p_coal,'21_eGas',z) = 0 ;
3343   Coal_DIO(p_coal,'22_eOil',z) = 0 ;
3344   Coal_DIO(p_coal,'23_eWind',z) = 0 ;
3345   Coal_DIO(p_coal,'24_eSolar',z) = 0 ;
3346   Coal_DIO(p_coal,'25_eHydro',z) = 0 ;
3347   Coal_DIO(p_coal,'26_eOther',z) = 0 ;
3348   Coal_DIO(p_coal,'27_CONSTRUC',z) = sum((f_construc), WEB(f_construc, p_coal, z));
3349   Coal_DIO(p_coal,'28_LTRP',z) = sum((f_roadrail), WEB(f_roadrail, p_coal, z));
3350   Coal_DIO(p_coal,'29_WTRP',z) = sum((f_domewater), WEB(f_domewater, p_coal, z));
3351   Coal_DIO(p_coal,'30_ATRP',z) = sum((f_domeair), WEB(f_domeair, p_coal, z));
3352   Coal_DIO(p_coal,'31_SER',z) = sum((f_ser), WEB(f_ser, p_coal, z));
3353   Coal_CO(p_coal,z) = sum((f_household), WEB(f_household, p_coal, z));
3354   
3355   Coal_Marine(p_coal,z)   = -1*sum((f_marine_bunker), WEB(f_marine_bunker, p_coal, z));
3356   Coal_Aviation(p_coal,z) = -1*sum((f_aviation_bunker), WEB(f_aviation_bunker, p_coal, z));
3357   
3358  *Ratio
3359  Loop(j,
3360      CoalR_DIO(p_coal,j,z)$(Coal_DIO(p_coal,j,z) gt 0)
3361           = Coal_DIO(p_coal,j,z)/sum(p_coal2, Coal_DIO(p_coal2,j,z));
3362       );
3363   
3364   CoalR_CO(p_coal,z)$(Coal_CO(p_coal,z) gt 0)  = Coal_CO(p_coal,z)/ sum(p_coal2, Coal_CO(p_coal2,z));
3365   
3366  *Gas
3367   Gas_DIO(p_gas,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_gas, z));
3368   Gas_DIO(p_gas,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_gas, z));
3369   Gas_DIO(p_gas,'03_OIL',z) = 0;
3370   Gas_DIO(p_gas,'04_GAS',z) = -1*sum((f_gas), WEB(f_gas, p_gas, z));
3371   Gas_DIO(p_gas,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_gas, z));
3372   Gas_DIO(p_gas,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_gas, z));
3373   Gas_DIO(p_gas,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_gas, z));
3374   Gas_DIO(p_gas,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_gas, z));
3375   Gas_DIO(p_gas,'09_PAPERPRO',z) = sum((f_paperpro), WEB(f_paperpro, p_gas, z));
3376   Gas_DIO(p_gas,'10_PETROLCOAL',z) = -1*sum((f_petrolcoal), WEB(f_petrolcoal, p_gas, z));
3377   Gas_DIO(p_gas,'11_CHEMICAL',z) = sum((f_chemical), WEB(f_chemical, p_gas, z));
3378   Gas_DIO(p_gas,'12_NONMET',z) = sum((f_nonmet), WEB(f_nonmet, p_gas, z));
