4116  PARAMETER
4117   EGINucGWh(j,z)    Nuclear GWh per 10 billion $
4118   EGICoalGWh(j,z)   Coal GWh per 10 billion $
4119   EGIGasGWh(j,z)    Gas GWh per 10 billion $
4120   EGIOilGWh(j,z)    Oil GWh per 10 billion $
4121   EGIWindGWh(j,z)   Wind GWh per 10 billion $
4122   EGISolarGWh(j,z)  Solar GWh per 10 billion $
4123   EGIHydroGWh(j,z)  Hydro GWh per 10 billion $
4124   EGIWasteGWh(j,z)  Waste GWh per 10 billion $
4125   EGIBioGWh(j,z)    Bio GWh per 10 billion $
4126   EGIGeoGWh(j,z)    Geothermal GWh per 10 billion $
4127   EGIOtherGWh(j,z)  Other GWh per 10 billion $
4128  ;
4129   
4130   EGINucGWh('19_eNuclear',z) = ElecNucGWh('19_eNuclear',z) / DSO_J('19_eNuclear',z);
4131   EGICoalGWh('20_eCoal',z)   = ElecCoalGWh('20_eCoal',z) / DSO_J('20_eCoal',z);
4132   EGIGasGWh('21_eGas',z)     = ElecGasGWh('21_eGas',z) / DSO_J('21_eGas',z);
4133   EGIOilGWh('22_eOil',z)     = ElecOilGWh('22_eOil',z) / DSO_J('22_eOil',z);
4134   EGIWindGWh('23_eWind',z)   = ElecWindGWh('23_eWind',z) / DSO_J('23_eWind',z);
4135   EGISolarGWh('24_eSolar',z) = ElecSolarGWh('24_eSolar',z) / DSO_J('24_eSolar',z);
4136   EGIHydroGWh('25_eHydro',z) = ElecHydroGWh('25_eHydro',z) / DSO_J('25_eHydro',z);
4137   EGIWasteGWh('26_eOther',z) = ElecWasteGWh('26_eOther',z) / DSO_J('26_eOther',z);
4138   EGIBioGWh('26_eOther',z)   = ElecBioGWh('26_eOther',z) / DSO_J('26_eOther',z);
4139   EGIGeoGWh('26_eOther',z)   = ElecGeoGWh('26_eOther',z) / DSO_J('26_eOther',z);
4140   EGIOtherGWh('26_eOther',z) = ElecOtherGWh('26_eOther',z) / DSO_J('26_eOther',z);
