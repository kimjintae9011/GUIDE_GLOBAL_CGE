1080   
1081  *===============================================================================
1082  * Elasticity Parameter Assignments
1083  *===============================================================================
1084  *CES - KLE(backstop)
1085   sigma_KLE(BS,z)          = 0.5;
1086   
1087  * CES - composite K-L
1088   sigma_VA('10_PETROLCOAL',z) =0.2;
1089  * sigma_VA('12_NONMET ',z)     = 0.8;
1090  * sigma_VA('13_IRONSTL',z)     = 0.2;
1091   sigma_VA('18_TnD',z)           = 0.2;
1092   sigma_VA('19_eNuclear',z)     = 0.2;
1093   sigma_VA('20_eCoal',z)          = 0.2;
1094   sigma_VA('21_eGas',z)           = 0.2;
1095   sigma_VA('22_eOil',z)            = 0.2;
1096   sigma_VA('23_eWind',z)        = 0.2;
1097   sigma_VA('24_eSolar',z)        = 0.2;
1098   sigma_VA('25_eHydro',z)       = 0.2;
1099   sigma_VA('26_eOther',z)        = 0.2;
1100   sigma_VA(BS,z)      = 0.5;
1101   
1102  * CES - composite capital
1103    sigma_KD(j,z)        = 2 * sigma_VA(j,z);
1104    sigma_KD(BS,Z)     = 0.5;
1105   
1106  * CES - composite labor
1107    sigma_LD(j,z)        = 2 * sigma_VA(j,z);
1108    sigma_LD(BS,Z)     = 0.5;
1109   
1110  * CES - composite ENER
1111   sigma_ENER_elec(j2,z)         = 1.5;
1112   sigma_ENER_nelec(j2,z)       = 0.5;
1113   sigma_ENER_coalgas(j2,z)    = 2.0;
1114   sigma_ENER_oilprod(j2,z)     = 0.5;
1115   
1116  * CES - DOM vs.IMP
1117   sigma_M1('03_OIL','06_PRK') = 0.5;
1118   sigma_M1('04_GAS',Z) = 6;
1119   sigma_M1('11_CHEMICAL','05_MNG') = 1.5;
1120   sigma_M1('13_IRONSTL','05_MNG') = 1.5;
1121   
1122  * CES - IMP sourcing
1123   sigma_M2('03_OIL',Z) = 2;
1124   sigma_M2('04_GAS',Z) = 2;
1125   
1126  *CET - exports and local sales
1127   sigma_X0(j,z)                 = 1.5;
1128   
1129  * CET - total output
1130   sigma_X2(i,z)                 = 2;
1131   
1132  * CES - composite Power sector
1133   sigma_X4(z)                   = 2.5;
1134   sigma_X4('07_NAM')       = 1.5;
1135   sigma_X4('09_WEU')       = 1.5;
1136   sigma_X4('16_PAS')        = 1.5;
1137   
1138  * CES - composite BS sector
1139   sigma_BS(BS, Z_GRN)    = 20;
1140   sigma_BS(BS, '07_NAM')    = 5;
1141   sigma_BS(BS, '09_WEU')    = 5;
1142   
1143  * sigma_VAT(BS,Z_GRN)   = 1.5;
1144   
1145  sigma_VAT('32_BSCHEMICAL',Z_GRN)   = 0.5;
1146  sigma_VAT('33_BSNONMET',Z_GRN)     = 0.5;
1147  sigma_VAT('34_BSIRONSTL',Z_GRN)     = 0.5;
1148  sigma_VAT('35_BS_LTRP',Z_GRN)         = 0.5;
1149  sigma_VAT('36_BS_WTRP',Z_GRN)        = 0.5;
1150  sigma_VAT('37_BS_ATRP',Z_GRN)         = 0.5;
1151   
1152  * Investment demand elasticity
1153   sigma_INV(k,j,z)              = 1.5;
1154   
1155  * LES parameters - Frisch all (1.1)
1156  * frisch(z)                     = PARZ(z,'frisch');
1157  frisch('01_KOR') = -1.30;
1158  frisch('02_CHN') = -1.45;
1159  frisch('03_JPN') = -1.25;
1160  frisch('04_RUS') = -1.45;
1161  frisch('05_MNG') = -1.70;
1162  frisch('06_PRK') = -2.00;
1163  frisch('07_NAM') = -1.20;
1164  frisch('08_LAM') = -1.50;
1165  frisch('09_WEU') = -1.20;
1166  frisch('10_EEU') = -1.40;
1167  frisch('11_FSU') = -1.60;
1168  frisch('12_MEA') = -1.60;
1169  frisch('13_AFR') = -1.90;
1170  frisch('14_CPA') = -1.70;
1171  frisch('15_SAS') = -1.80;
1172  frisch('16_PAS') = -1.50;
1173  frisch('17_PAO') = -1.20;
1174   
1175  * Labour supply
1176   elasLS(z)                     = 0.5;
1177   
1178  *==============================================================================
1179  * Rescaling
1180  *==============================================================================
1181  * GTAP data are in millions of US dollars With RES = 10000, model results are in tens of billions (10G$)
1182   RES = 10000;
1183   CO(i,z)          = CO(i,z) / RES;
1184   CGO(i,z)         = CGO(i,z) / RES;
1185   DDO(i,z)         = DDO(i,z) / RES;
1186   DEPO(z)          = DEPO(z) / RES;
1187   DIO(i,j,z)       = DIO(i,j,z) / RES;
1188   DSO(j,i,z)       = DSO(j,i,z) / RES;
1189   DSO_I(i,z)       = DSO_I(i,z) / RES;
1190   EXO(i,z,zj)      = EXO(i,z,zj) / RES;
1191   IMO(i,z,zj)      = IMO(i,z,zj) / RES;
1192   INVO(i,z)        = INVO(i,z) / RES;
1193   KSTO(z)          = KSTO(z) / RES;
1194   LDO(j,z)         = LDO(j,z) / RES;
1195   MRGNO(i,z)       = MRGNO(i,z) / RES;
1196   RKDO(k,j,z)      = RKDO(k,j,z) / RES;
1197   TDHO(z)          = TDHO(z) / RES;
1198   TICO(i,z)        = TICO(i,z) / RES;
1199   TIKO(k,j,z)      = TIKO(k,j,z) / RES;
1200   TIMO(i,z,zj)     = TIMO(i,z,zj) / RES;
1201   TIPO(j,z)        = TIPO(j,z) / RES;
1202   TIWO(j,z)        = TIWO(j,z) / RES;
1203   TIXO(i,z,zj)     = TIXO(i,z,zj) / RES;
1204   tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj) / RES;
1205   XSO_I(i,z)       = XSO_I(i,z) / RES;
1206   XSO(j,i,z)       = XSO(j,i,z) / RES;
1207   XSTO(j,z)        = XSTO(j,z) / RES;
1208   
1209  *==============================================================================
1210  * [NEW] Backstop Technology Split & TSF Initialization (Upstream Injection)
1211  *==============================================================================
1212  PARAMETER
1213   seed(j)                Initial share of the new technology
1214   TSFO(j, z)             Initial year TSF input for backstop (Value)
1215   PTSFO(j, z)            Initial year TSF price for backstop
1216   Green_Markup(j, z)     Initial efficiency penalty for backstop
1217   SHR_MRGN(j, i, z)      Share of international transport margin for sector j !! [Added] Margin distribution share
1218  ;
1219   
1220  seed(BS) = 0.01;
1221  PTSFO(BS, Z_GRN) = 1.0;
1222  Green_Markup(BS, Z_GRN) = 1.0;
1223   
1224  * [Added] Initialize default margin share to 1.0 (100%) for all industries before splitting
1225  SHR_MRGN(j, i, z)$XSO(j, i, z) = 1.0;
1226   
1227  LOOP(Z_GRN,
1228  *--------------------------------------------------------------------------
1229  * [1] Split raw data by seed share and preserve identities
1230  *--------------------------------------------------------------------------
1231    LOOP(MAP_BS(j, jj, i),
1232  * Allocate to backstop industry
1233      LDO(j, Z_GRN)       = LDO(jj, Z_GRN) * seed(j);
1234      RKDO(k, j, Z_GRN)   = RKDO(k, jj, Z_GRN) * seed(j);
1235      TIPO(j, Z_GRN)      = TIPO(jj, Z_GRN) * seed(j);
1236      TIWO(j, Z_GRN)      = TIWO(jj, Z_GRN) * seed(j);
1237      TIKO(k, j, Z_GRN)   = TIKO(k, jj, Z_GRN) * seed(j);
1238      DIO(ii, j, Z_GRN)   = DIO(ii, jj, Z_GRN) * seed(j);
1239      EMPLOY(j, Z_GRN)    = EMPLOY(jj, Z_GRN) * seed(j);
1240   
1241      XSO(j, i, Z_GRN)    = (XSO(jj, i, Z_GRN) * seed(j)) / Green_Markup(j, Z_GRN);
1242      XSTO(j, Z_GRN)      = (XSTO(jj, Z_GRN) * seed(j)) / Green_Markup(j, Z_GRN);
1243      DSO(j, i, Z_GRN)    = (DSO(jj, i, Z_GRN) * seed(j)) / Green_Markup(j, Z_GRN);
1244   
1245  * [Added] Allocate international margin share to backstop industry by seed share
1246      SHR_MRGN(j, i, Z_GRN) = seed(j);
1247   
1248  * Deduct exact share from conventional industry
1249      LDO(jj, Z_GRN)      = LDO(jj, Z_GRN) * (1 - seed(j));
1250      RKDO(k, jj, Z_GRN)  = RKDO(k, jj, Z_GRN) * (1 - seed(j));
1251      TIPO(jj, Z_GRN)     = TIPO(jj, Z_GRN) * (1 - seed(j));
1252      TIWO(jj, Z_GRN)     = TIWO(jj, Z_GRN) * (1 - seed(j));
1253      TIKO(k, jj, Z_GRN)  = TIKO(k, jj, Z_GRN) * (1 - seed(j));
1254      DIO(ii, jj, Z_GRN)  = DIO(ii, jj, Z_GRN) * (1 - seed(j));
1255      EMPLOY(jj, Z_GRN)   = EMPLOY(jj, Z_GRN) * (1 - seed(j));
1256   
1257      XSO(jj, i, Z_GRN)   = XSO(jj, i, Z_GRN) * (1 - seed(j));
1258      XSTO(jj, Z_GRN)     = XSTO(jj, Z_GRN) * (1 - seed(j));
1259      DSO(jj, i, Z_GRN)   = DSO(jj, i, Z_GRN) * (1 - seed(j));
1260   
1261  * [Added] Deduct international margin share from conventional industry (remaining share)
1262      SHR_MRGN(jj, i, Z_GRN) = 1.0 - seed(j);
1263    );
1264   
1265  *--------------------------------------------------------------------------
1266  * [2] Technology Specific Factor (TSF) Allocation
1267  *--------------------------------------------------------------------------
1268    LOOP(BS,
1269      TSFO(BS, Z_GRN) = (RKDO('cap', BS, Z_GRN) * 0.9) / PTSFO(BS, Z_GRN);
1270      RKDO('cap', BS, Z_GRN) = RKDO('cap', BS, Z_GRN) - (PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN));
1271    );
1272  );
1273   
1274  * Calculate initial values for TSF intensity and time series
1275  LOOP(BS,
1276    v_tsf(BS, Z_GRN)      = TSFO(BS, Z_GRN) / XSTO(BS, Z_GRN);
1277    TSFS(BS, Z_GRN, time) = TSFO(BS, Z_GRN);
1278  );
1279   
1280  * -------------------------------------------------------------------
1281  * [동태 모형 고도화] 유령 산업에 초소형 정상 구조(Micro-Seed) 주입
1282  * -------------------------------------------------------------------
1283  SCALAR seed_val / 1E-5 /;
1284   
1285  LOOP((j,z)$(XSTO(j,z) <= 1E-6 and not (BS(j) and Z_OTH(z))),
1286  * 1. 생산량(XSTO)에 아주 작은 Seed 값 부여
1287      XSTO(j,z) = seed_val;
1288   
1289  * 2. 중국(02_CHN)의 동일 산업(j) 투입 구조 비율을 계산하여 Seed 값에 분배
1290  * (중국의 해당 산업 총비용 대비 각 요소의 비중을 차용)
1291      LDO(j,z)    = seed_val * (LDO(j,'02_CHN') / XSTO(j,'02_CHN'));
1292      TIWO(j,z)   = seed_val * (TIWO(j,'02_CHN') / XSTO(j,'02_CHN'));
1293      TIPO(j,z)   = seed_val * (TIPO(j,'02_CHN') / XSTO(j,'02_CHN'));
1294   
1295      LOOP(k,
1296          RKDO(k,j,z) = seed_val * (RKDO(k,j,'02_CHN') / XSTO(j,'02_CHN'));
1297          TIKO(k,j,z) = seed_val * (TIKO(k,j,'02_CHN') / XSTO(j,'02_CHN'));
1298      );
1299   
1300      LOOP(i,
1301          DIO(i,j,z)  = seed_val * (DIO(i,j,'02_CHN') / XSTO(j,'02_CHN'));
1302      );
1303   
1304  * 3. 이제 투입 비용의 합이 XSTO와 완벽히 일치하므로 가격(PPO)은 1.0이 됨
1305      PPO(j,z) = 1.0;
1306      PVAO(j,z) = 1.0;
1307      VAO(j,z) = LDO(j,z) + SUM(k, RKDO(k,j,z));
1308  );
1309   
1310  *==============================================================================
1311  * 3.3 Exogenous prices and parameters
1312  *==============================================================================
1313   eta                = 1;
1314   ttdh0O(z)       = 0;
1315   eO(z)             = 1;
1316   PEO(i,z,zj)      = 1;
1317   PLO(i,z)          = 1;
1318   PWMGO(i)      = 1;
1319   WO(z)            = 1;
1320   WO_lag(z)      = WO(z);
1321   
1322  *==============================================================================
1323  * Calibration
1324  *==============================================================================
1325   YHKO(z)          = SUM[(k,j), RKDO(k,j,z)];
1326   YHLO(z)          = SUM[(j), LDO(j,z)];
1327   YHO(z)           = YHLO(z) + YHKO(z) + SUM[BS, PTSFO(BS,z) * TSFO(BS,z)];
1328   YDHO(z)          = YHO(z) - TDHO(z);
1329   CTHO(z)          = SUM[i, CO(i,z)];
1330   SHO(z)           = YDHO(z) - CTHO(z);
1331   TICTO(z)         = SUM[i, TICO(i,z)];
1332   TIMTO(z)         = SUM[(i,zj), TIMO(i,zj,z)];
1333   TIWTO(z)         = SUM[(j), TIWO(j,z)];
1334   TIKTO(z)         = SUM[(k,j), TIKO(k,j,z)];
1335   TIPTO(z)         = SUM[j, TIPO(j,z)];
1336   TIXTO(z)         = SUM[(i,zj), TIXO(i,z,zj)];
1337   TPRODNO(z)       = TIKTO(z) + TIWTO(z) + TIPTO(z);
1338   TPRCTSO(z)       = TICTO(z) + TIMTO(z) + TIXTO(z);
1339   YGO(z)           = TDHO(z) + TPRCTSO(z) + TPRODNO(z);
1340   GO(z)            = SUM[i, CGO(i,z)];
1341   SGO(z)           = YGO(z) - GO(z);
1342   YROWO(z)         = SUM[(i,zj), IMO(i,zj,z)] + SUM[(i,ij,zj), tmrg(i,ij,zj,z)];
1343   SROWO(z)         = YROWO(z) - SUM[(i,zj), EXO(i,z,zj)] - SUM[i, MRGNO(i,z)];
1344   CABO(z)          = -SROWO(z);
1345   ITO(z)           = SHO(z) + SGO(z) + SROWO(z);
1346   
1347  *==============================================================================
1348  * Calibration of parameters and other variables
1349  *==============================================================================
1350   gamma_GVT(i,z)   = CGO(i,z) / SUM[ij, CGO(ij,z)];
1351   gamma_INV(i,z)   = INVO(i,z) / SUM[ij, INVO(ij,z)];
1352   
1353  *==============================================================================
1354  * Calibration of other prices and revised volumes (part 1)
1355  *==============================================================================
1356   LDO(j,z)         = LDO(j,z) / WO(z);
1357   LDCO(j,z)        = LDO(j,z);
1358   LSO(z)           = SUM[j, LDO(j,z)];
1359   LSTO(z)          = LSO(z);
1360   LSO_lag(z)       = LSO(z);
1361   LSTO_lag(z)      = LSO(z);
1362   EXO(i,z,zj)      = [EXO(i,z,zj) - TIXO(i,z,zj)] / PEO(i,z,zj);
1363   EXTO(i,z)        = SUM[zj, EXO(i,z,zj)];
1364   PWXO(i,z,zj)$EXO(i,z,zj)
1365                    = { [PEO(i,z,zj) * EXO(i,z,zj) + TIXO(i,z,zj)] / EXO(i,z,zj) } / eO(z);
1366   PETO(i,z)        = SUM[zj, PEO(i,z,zj) * EXO(i,z,zj)] / EXTO(i,z);
1367   PWMO(i,z,zj)     = PWXO(i,z,zj);
1368   IMO(i,zj,z)      = EXO(i,zj,z);
1369   IMTO(i,z)        = SUM[zj, IMO(i,zj,z)];
1370   
1371   DSO(j,i,z)       = DSO(j,i,z) / PLO(i,z);
1372   DSO_I(i,z)       = SUM(j, DSO(j,i,z));
1373   DSO_J(j,z)       = SUM(i, DSO(j,i,z));
1374   QO(i,z)          = IMTO(i,z) + DDO(i,z);
1375   MRGNO(i,z)$MRGNO(i,z)
1376                    = MRGNO(i,z) / [eO(z) * PWMGO(i)];
1377   XSO_I(i,z)       = EXTO(i,z) + DDO(i,z) + MRGNO(i,z);
1378   
1379   XSTO(j,z)        = SUM(i, XSO(j,i,z));
1380   PO(i,z)          = [ PETO(i,z) * EXTO(i,z) + PLO(i,z) * DSO_I(i,z)
1381                      + eO(z) * PWMGO(i) * MRGNO(i,z) ] / XSO_I(i,z);
1382   PO2(j,i,z)$XSO(j,i,z)                  = 1;
1383   PO2(BS,I_BS,Z_GRN) = Green_Markup(BS,Z_GRN);
1384   
1385   PO3(i,j,z)$XSO(j,i,z)                  = 1;
1386   
1387   PIO(i,z)         = SUM[j$XSO(j,i,z), PO2(J,I,z) * XSO(j,i,z)] / XSO_I(i,z);
1388   
1389   PTO(j,z)$XSTO(j,z) = SUM[i$XSO(j,i,z), PO2(j,i,z) * XSO(j,i,z)] / XSTO(j,z);
1390   
1391   PPO(j,z)$XSTO(j,z)
1392      = ( TIWO(j,z) + WO(z) * LDO(j,z)
1393        + SUM[k, TIKO(k,j,z) + RKDO(k,j,z)]
1394        + (PTSFO(j,z) * TSFO(j,z))$BS(j)
1395        + SUM[nene, DIO(nene,j,z)]
1396        + SUM[ene, DIO(ene,j,z)] ) / XSTO(j,z);
1397   
1398  * ==============================================================================
1399   
1400   theta2(j,i,z)    = DSO(j,i,z) / SUM(jj, DSO(jj,i,z));
1401   
1402   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z) * EXTO(i,z);
1403   
1404  *==============================================================================
1405  * Calibration of tax rates, margins, prices and volumes
1406  *==============================================================================
1407   ttixO(i,z,zj)    = [eO(z) * PWXO(i,z,zj) / PEO(i,z,zj)] - 1;
1408   tticO(i,z)       = TICO(i,z) /
1409                      { PLO(i,z) * DDO(i,z)
1410                      + SUM[zj, IMO(i,zj,z) * eO(z) * PWMO(i,zj,z)
1411                      + TIMO(i,zj,z) + SUM[ij, tmrg(ij,i,zj,z)]] };
1412   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
1413                    = tmrg(i,ij,zj,z) / (PWMGO(i) * eO(z) * IMO(ij,zj,z));
1414   ttimO(i,zj,z)$IMO(i,zj,z)
1415                    = TIMO(i,zj,z) /
1416                      { IMO(i,zj,z) * eO(z) * (PWMO(i,zj,z)
1417                      + SUM[ij, PWMGO(ij) * tmrg(ij,i,zj,z)]) };
1418   ttiwO(j,z)$LDO(j,z)
1419                    = TIWO(j,z) / [WO(z) * LDO(j,z)];
1420   ttikO(k,j,z)$RKDO(k,j,z)
1421                    = TIKO(k,j,z) / RKDO(k,j,z);
1422   ttipO(j,z)$XSTO(j,z) = [PTO(j,z) / PPO(j,z)] - 1;
1423   
1424   ttdh1O(z)        = [TDHO(z) - ttdh0O(z)] / YHO(z);
1425   
1426  *==============================================================================
1427  * Calibration of other prices and revised volumes (part 2)
1428  *==============================================================================
1429   PDO(i,z)         = PLO(i,z) * (1 + tticO(i,z));
1430   PMO(i,zj,z)      = eO(z) * (PWMO(i,zj,z) + SUM[ij, PWMGO(ij) * tmrg(ij,i,zj,z)])
1431                    * (1 + ttimO(i,zj,z)) * (1 + tticO(i,z));
1432   PMTO(i,z)        = SUM[zj, PMO(i,zj,z) * IMO(i,zj,z)] / IMTO(i,z);
1433   PCO(i,z)         = [PMTO(i,z) * IMTO(i,z) + PDO(i,z) * DDO(i,z)] / QO(i,z);
1434   CO(i,z)          = CO(i,z) / PCO(i,z);
1435   CGO(i,z)         = CGO(i,z) / PCO(i,z);
1436   DIO(nene,j,z)    = DIO(nene,j,z) / PCO(nene,z);
1437   DEO(ene,j,z)     = DIO(ene,j,z) / PCO(ene,z);
1438   
1439   DEelecO(j,z)     = DIO("18_ELEC",j,z) / PCO("18_ELEC",z);
1440   DEnelecO(j,z)    = SUM(ene3, DEO(ene3,j,z));
1441   
1442   DEcoalgasO(j,z)  = SUM(ene5, DEO(ene5,j,z));
1443   DEcoalO(j,z)     = DEO("02_COAL ",j,z);
1444   DEgasO(j,z)      = DEO("04_GAS",j,z);
1445   
1446   DEoilpetrolO(j,z)= SUM(ene6, DEO(ene6,j,z));
1447   DEoilO(j,z)      = DEO("03_OIL",j,z);
1448   DEpetrolO(j,z)   = DEO("10_PETROLCOAL",j,z);
1449   INVO(i,z)        = INVO(i,z) / PCO(i,z);
1450   
1451   CIO(j,z)         = SUM[nene, DIO(nene,j,z)];
1452   CEO(j3,z)        = SUM[ene, DEO(ene,j3,z)];
1453   CEO(j2,z)        = DEelecO(j2,z) + DEnelecO(j2,z);
1454   DITO(nene,z)     = SUM[j, DIO(nene,j,z)];
1455   DITO(ene,z)      = SUM[j, DEO(ene,j,z)];
1456   
1457   PO4(ene,j,z)     = PCO(ene,z);
1458   PCIO(j,z)$XSTO(j,z)
1459                    = SUM[nene, PCO(nene,z) * DIO(nene,j,z)] / CIO(j,z);
1460   
1461   PCEcoalO(j,z)$XSTO(j,z)   = PO4("02_COAL",j,z);
1462   PCEgasO(j,z)$XSTO(j,z)    = PO4("04_GAS",j,z);
1463   PCEoilO(j,z)$XSTO(j,z)    = PO4("03_OIL",j,z);
1464   PCEpetrolO(j,z)$XSTO(j,z) = PO4("10_PETROLCOAL",j,z);
1465   
1466   PCEoilpetrolO(j,z)$XSTO(j,z)
1467      = [ PCEoilO(j,z) * DEoilO(j,z) + PCEpetrolO(j,z) * DEpetrolO(j,z) ] / DEoilpetrolO(j,z);
1468   
1469   PCEcoalgasO(j,z)$XSTO(j,z)
1470      = [ PCEcoalO(j,z) * DEcoalO(j,z) + PCEgasO(j,z) * DEgasO(j,z) ] / DEcoalgasO(j,z);
1471   
1472   PCEnelecO(j,z)$XSTO(j,z)
1473      = [ PCEcoalgasO(j,z) * DEcoalgasO(j,z) + PCEoilpetrolO(j,z) * DEoilpetrolO(j,z) ] / DEnelecO(j,z);
1474   
1475   PCEelecO(j,z)$XSTO(j,z)
1476      = SUM[ene4, PCO(ene4,z) * DEO(ene4,j,z)] / DEelecO(j,z);
1477   
1478   PCEO(j,z)$XSTO(j,z)
1479      = [ PCEelecO(j,z) * DEelecO(j,z) + PCEnelecO(j,z) * DEnelecO(j,z) ] / CEO(j,z);
1480   
1481   PCEO(j3,z)$XSTO(j3,z)
1482      = SUM[ene, PCO(ene,z) * DEO(ene,j3,z)] / CEO(j3,z);
1483   
1484   WTIO(j,z)$XSTO(j,z)       = WO(z) * (1 + ttiwO(j,z));
1485   WCO(j,z)$LDCO(j,z)        = (WTIO(j,z) * LDO(j,z)) / LDCO(j,z);
1486   
1487  *==============================================================================
1488  * Calibration of dynamic parameters
1489  *==============================================================================
1490   PKO(z)           = 1;
1491   KSTO(z)          = KSTO(z) / PKO(z);
1492   KSTO(z)          = KSTO(z) - SUM((BS,Z_GRN)$sameas(z, Z_GRN), PTSFO(BS,Z_GRN) * TSFO(BS,Z_GRN));
1493   
1494   delta(z)         = DEPO(z) / [PKO(z) * KSTO(z)];
1495   
1496   RO(k,j,z)$RKDO(k,j,z)
1497                    = SUM[(kj,jj), RKDO(kj,jj,z)] / KSTO(z);
1498   
1499   KDO(k,j,z)$RKDO(k,j,z)
1500                    = RKDO(k,j,z) / RO(k,j,z);
1501   
1502   KSO(k,z)         = SUM[j, KDO(k,j,z)];
1503   IRO(z)           = { SUM[(k,j)$RKDO(k,j,z), RKDO(k,j,z)] - DEPO(z) } / [PKO(z) * KSTO(z)];
1504   UO(z)            = PKO(z) * (IRO(z) + delta(z));
1505   phiO(z)          = [ITO(z) / PKO(z)] / KSTO(z);
1506   
1507   INDO(k,j,z)$KDO(k,j,z)
1508                    = phiO(z) * KDO(k,j,z);
1509   
1510   A_K(z)           = 1 / PKO(z) * { PROD[i$gamma_INV(i,z), (PCO(i,z) / gamma_INV(i,z))**gamma_INV(i,z)] };
1511   KDCO(j,z)        = SUM[k, KDO(k,j,z)];
1512   RTIO(k,j,z)      = RO(k,j,z) * (1 + ttikO(k,j,z));
1513   
1514   RCO(j,z)$KDCO(j,z)
1515                    = SUM[k, RTIO(k,j,z) * KDO(k,j,z)] / KDCO(j,z);
1516   
1517  *==============================================================================
1518  * Calibration of other prices and revised volumes
1519  *==============================================================================
1520   VAO(j,z)       = LDCO(j,z) + KDCO(j,z);
1521   
1522   PVAO(j,z)$XSTO(j,z)
1523                     = [ WCO(j,z) * LDCO(j,z) + RCO(j,z) * KDCO(j,z) ] / VAO(j,z);
1524   
1525   KLEO(j,z)$XSTO(j,z)  = CEO(j,z) + VAO(j,z);
1526   
1527   PKLEO(j,z)$XSTO(j,z)
1528                      = [PCEO(j,z) * CEO(j,z) + PVAO(j,z) * VAO(j,z)] / KLEO(j,z);
1529   
1530   VATO(BS, Z_GRN)      = VAO(BS, Z_GRN) + TSFO(BS, Z_GRN);
1531   
1532   PVATO(BS, Z_GRN)
1533                      = [PVAO(BS, Z_GRN) * VAO(BS, Z_GRN) + PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN)] / VATO(BS, Z_GRN);
1534   
1535   PIXGDPO(z)           = 1;
1536   PIXGDP_WO          = 1;
1537   PIXCONO(z)           = 1;
1538   PIXCONO_lag(z)     = PIXCONO(z);
1539   PIXINVO(z)            = 1;
1540   PIXGVTO(z)           = 1;
1541   PPOWERO(z)         = 1;
1542   PBSO(BS, Z_GRN)  = 1.0;
1543   
1544  *==============================================================================
1545  * Calibration of LES parameters
1546  *==============================================================================
1547   sigma_Y(i,z)   = sigma_Y(i,z) / { SUM[ij, sigma_Y(ij,z) * PCO(ij,z) * CO(ij,z)] / CTHO(z) };
1548   gamma_LES(i,z) = PCO(i,z) * CO(i,z) * sigma_Y(i,z) / CTHO(z);
1549   CMINO(i,z)     = CO(i,z) + gamma_LES(i,z) * CTHO(z) / {PCO(i,z) * frisch(z)};
1550   
1551  *$Ontext
1552  * ==============================================================================
1553  * [ADDITION] Backup setup of initial values for tracking parameter changes
1554  * ==============================================================================
1555  SET eval_sig "Evaluation items for sigmas" / Initial "Initial value", Final "Final value", Diff "Difference (Change)" /;
1556  SET sig_type "Types of Industry Elasticities" /
1557      s_coalgas "sigma_ENER_coalgas",
1558      s_oilprod "sigma_ENER_oilprod",
1559      s_nelec   "sigma_ENER_nelec",
1560      s_elec    "sigma_ENER_elec",
1561      s_kle     "sigma_KLE"
1562  /;
1563   
1564  PARAMETER Init_sigma_M1(ene,z) "Backup for initial sigma_M1";
1565  PARAMETER Init_sigma_M2(ene,z) "Backup for initial sigma_M2";
1566  PARAMETER Init_sigma_IND(j,z,sig_type) "Backup for initial industry nest sigmas";
1567   
1568  * Store the current (initial) parameter values before entering the loop
1569  Init_sigma_M1(ene,z) = sigma_M1(ene,z);
1570  Init_sigma_M2(ene,z) = sigma_M2(ene,z);
1571  Init_sigma_IND(j,z,'s_coalgas') = sigma_ENER_coalgas(j,z);
1572  Init_sigma_IND(j,z,'s_oilprod') = sigma_ENER_oilprod(j,z);
1573  Init_sigma_IND(j,z,'s_nelec')   = sigma_ENER_nelec(j,z);
1574  Init_sigma_IND(j,z,'s_elec')    = sigma_ENER_elec(j,z);
1575  Init_sigma_IND(j,z,'s_kle')     = sigma_KLE(j,z);
1576   
1577  * ==============================================================================
1578  * Calculation of Economy-Wide Ex-ante Own-Price Elasticities for Energy
1579  * (Industries + Households + Government + Investment + Exports)
1580  * ==============================================================================
1581   
1582  PARAMETERS
1583  * 1. Industry Nest Shares
1584      S_E_KLE(j,z), S_NE_E(j,z), S_Elec_E(j,z)
1585      S_CG_NE(j,z), S_OP_NE(j,z)
1586      S_Coal_CG(j,z), S_Gas_CG(j,z), S_Oil_OP(j,z), S_Petrol_OP(j,z)
1587   
1588  * 2. Armington & Demand Shares
1589      S_DOM(i,z)           "Share of Domestic product in composite demand"
1590      W_IND(i,j,z)         "Share of Industry j in Total Composite Demand QO"
1591      W_HH(i,z)            "Share of Household in Total Composite Demand QO"
1592      W_INV(i,z)           "Share of Investment in Total Composite Demand QO"
1593      W_GOV(i,z)           "Share of Government in Total Composite Demand QO"
1594      W_DDO(i,z)           "Share of Domestic Sales in Total Output"
1595      W_EXTO(i,z)          "Share of Export Sales in Total Output"
1596      Val_Total(i,z)       "Total Value of Domestic and Export Sales"
1597   
1598  * 3. Composite Price Elasticities by Agent (Imported + Domestic)
1599      Elas_Comp_IND(ene,j,z) "Composite elasticity for Industry"
1600      Elas_Comp_HH(ene,z)    "Composite elasticity for Household (LES)"
1601      Elas_Comp_INV(ene,z)   "Composite elasticity for Investment (Cobb-Douglas = -1)"
1602      Elas_Comp_GOV(ene,z)   "Composite elasticity for Government (Cobb-Douglas = -1)"
1603   
1604  * 4. Domestic Price Elasticities by Agent
1605      Elas_Dom_IND(ene,j,z)  "Domestic elasticity for Industry"
1606      Elas_Dom_HH(ene,z)     "Domestic elasticity for Household"
1607      Elas_Dom_INV(ene,z)    "Domestic elasticity for Investment"
1608      Elas_Dom_GOV(ene,z)    "Domestic elasticity for Government"
1609      Elas_EXP(ene,z)        "Export elasticity (based on importer's sigma_M2)"
1610   
1611  * 5. Economy-Wide Price Elasticities
1612      Elas_Total_DDO(ene,z)  "Weighted elasticity of Total Domestic Demand (DDO)"
1613      Elas_Total_ECON(ene,z) "Economy-wide Ex-ante Price Elasticity of Energy Commodity"
1614  ;
1615   
1616  * ------------------------------------------------------------------------------
1617  * Step 1. Calculate Shares
1618  * ------------------------------------------------------------------------------
1619  * Industry nest shares
1620  S_E_KLE(j2,z)$(PKLEO(j2,z)*KLEO(j2,z)) = (PCEO(j2,z)*CEO(j2,z)) / (PKLEO(j2,z)*KLEO(j2,z));
1621  S_NE_E(j2,z)$(PCEO(j2,z)*CEO(j2,z))    = (PCEnelecO(j2,z)*DEnelecO(j2,z)) / (PCEO(j2,z)*CEO(j2,z));
1622  S_Elec_E(j2,z)$(PCEO(j2,z)*CEO(j2,z))  = (PCEelecO(j2,z)*DEelecO(j2,z)) / (PCEO(j2,z)*CEO(j2,z));
1623  S_CG_NE(j2,z)$(PCEnelecO(j2,z)*DEnelecO(j2,z)) = (PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)) / (PCEnelecO(j2,z)*DEnelecO(j2,z));
1624  S_OP_NE(j2,z)$(PCEnelecO(j2,z)*DEnelecO(j2,z)) = (PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)) / (PCEnelecO(j2,z)*DEnelecO(j2,z));
1625  S_Coal_CG(j2,z)$(PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)) = (PCO('02_COAL',z)*DEO('02_COAL',j2,z)) / (PCEcoalgasO(j2,z)*DEcoalgasO(j2,z));
1626  S_Gas_CG(j2,z)$(PCEcoalgasO(j2,z)*DEcoalgasO(j2,z))  = (PCO('04_GAS',z)*DEO('04_GAS',j2,z)) / (PCEcoalgasO(j2,z)*DEcoalgasO(j2,z));
1627  S_Oil_OP(j2,z)$(PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)) = (PCO('03_OIL',z)*DEO('03_OIL',j2,z)) / (PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z));
1628  S_Petrol_OP(j2,z)$(PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)) = (PCO('10_PETROLCOAL',z)*DEO('10_PETROLCOAL',j2,z)) / (PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z));
1629   
1630  * Armington domestic shares (DDO relative to QO)
1631  S_DOM(ene,z)$(PCO(ene,z)*QO(ene,z)) = (PDO(ene,z)*DDO(ene,z)) / (PCO(ene,z)*QO(ene,z));
1632   
1633  * Consumption share of each agent in total domestic composite (QO)
1634  W_IND(ene,j,z)$QO(ene,z) = DEO(ene,j,z) / QO(ene,z);
1635  W_HH(ene,z)$QO(ene,z)    = CO(ene,z) / QO(ene,z);
1636  W_INV(ene,z)$QO(ene,z)   = INVO(ene,z) / QO(ene,z);
1637  W_GOV(ene,z)$QO(ene,z)   = CGO(ene,z) / QO(ene,z);
1638   
1639  * Share of domestic sales (DDO) and exports (EXTO) in total national output
1640  Val_Total(ene,z) = PDO(ene,z)*DDO(ene,z) + PETO(ene,z)*EXTO(ene,z);
1641  W_DDO(ene,z)$Val_Total(ene,z)  = (PDO(ene,z)*DDO(ene,z)) / Val_Total(ene,z);
1642  W_EXTO(ene,z)$Val_Total(ene,z) = (PETO(ene,z)*EXTO(ene,z)) / Val_Total(ene,z);
1643   
1644  * ------------------------------------------------------------------------------
1645  * Step 2. Calculate Composite Price Elasticities by Agent
1646  * ------------------------------------------------------------------------------
1647  * 1. Industry (Only KLE industries have elasticity, Non-KLE is Leontief so 0)
1648  Elas_Comp_IND('02_COAL',j2,z)$DEO('02_COAL',j2,z) =
1649      - (1 - S_Coal_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Coal_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1650      - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1651   
1652  Elas_Comp_IND('04_GAS',j2,z)$DEO('04_GAS',j2,z) =
1653      - (1 - S_Gas_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Gas_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1654      - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1655   
1656  Elas_Comp_IND('03_OIL',j2,z)$DEO('03_OIL',j2,z) =
1657      - (1 - S_Oil_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Oil_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1658      - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1659   
1660  Elas_Comp_IND('10_PETROLCOAL',j2,z)$DEO('10_PETROLCOAL',j2,z) =
1661      - (1 - S_Petrol_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Petrol_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1662      - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1663   
1664  Elas_Comp_IND('18_ELEC',j2,z)$DEO('18_ELEC',j2,z) =
1665      - (1 - S_Elec_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Elec_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1666   
1667  Elas_Comp_IND(ene,j3,z)$DEO(ene,j3,z) = 0;
1668   
1669  * 2. Household (LES Function)
1670  Elas_Comp_HH(ene,z)$CO(ene,z) = CMINO(ene,z) / CO(ene,z) * (1 - gamma_LES(ene,z)) - 1;
1671   
1672  * 3. Investment & Government (Cobb-Douglas Expenditure)
1673  Elas_Comp_INV(ene,z)$INVO(ene,z) = -1.0;
1674  Elas_Comp_GOV(ene,z)$CGO(ene,z)  = -1.0;
1675   
1676  * ------------------------------------------------------------------------------
1677  * Step 3. Derive Domestic Energy Price Elasticities by Agent (incorporating Armington effect)
1678  * ------------------------------------------------------------------------------
1679  Elas_Dom_IND(ene,j,z)$DEO(ene,j,z) = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_IND(ene,j,z);
1680  Elas_Dom_HH(ene,z)$CO(ene,z)       = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_HH(ene,z);
1681  Elas_Dom_INV(ene,z)$INVO(ene,z)    = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_INV(ene,z);
1682  Elas_Dom_GOV(ene,z)$CGO(ene,z)     = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_GOV(ene,z);
1683   
1684  * Exports (Weighted average of trading partners' import substitution elasticity sigma_M2)
1685  Elas_EXP(ene,z)$EXTO(ene,z) = SUM(zj$EXO(ene,z,zj), (EXO(ene,z,zj)/EXTO(ene,z)) * (-sigma_M2(ene,zj)));
1686   
1687  * ------------------------------------------------------------------------------
1688  * Step 4. Derive Economy-Wide Energy Price Elasticity (Aggregation)
1689  * ------------------------------------------------------------------------------
1690  * Domestic demand aggregation (Weighted Average of Domestic Agents)
1691  Elas_Total_DDO(ene,z) =
1692      SUM(j, W_IND(ene,j,z) * Elas_Dom_IND(ene,j,z))
1693      + W_HH(ene,z)  * Elas_Dom_HH(ene,z)
1694      + W_INV(ene,z) * Elas_Dom_INV(ene,z)
1695      + W_GOV(ene,z) * Elas_Dom_GOV(ene,z);
1696   
1697  * Domestic + Export aggregation (Final Economy-Wide Elasticity)
1698  Elas_Total_ECON(ene,z) =
1699      W_DDO(ene,z) * Elas_Total_DDO(ene,z) + W_EXTO(ene,z) * Elas_EXP(ene,z);
1700   
1701  DISPLAY Elas_Total_ECON, Elas_Total_DDO, Elas_Dom_HH, Elas_EXP;
1702   
1703  * ==============================================================================
1704  * Set and Parameter Declaration for Comparison Report
1705  * ==============================================================================
1706  SET eval "Comparison Items" / Initial "Initial Value", Final "Final Value", Target "Target Value" /;
1707  PARAMETER Report_Elas(ene,z,eval) "Elasticity Comparison Report (Based on DDO)";
1708  PARAMETER Initial_Elas_ECON(ene,z) "Backup of initial elasticity";
1709   
1710  * Backup initially calculated DDO elasticity before entering the loop
1711  Initial_Elas_ECON(ene,z) = Elas_Total_ECON(ene,z);
1712   
1713  * ==============================================================================
1714  * Step 0. Set Target Elasticities and Iterative Algorithm Parameters
1715  * ==============================================================================
1716  TABLE Target_Elas(ene,z) "Target economy-wide elasticities by region and energy commodity"
1717                 01_KOR  02_CHN  03_JPN  04_RUS  05_MNG  06_PRK  07_NAM  08_LAM  09_WEU  10_EEU  11_FSU  12_MEA  13_AFR  14_CPA  15_SAS  16_PAS  17_PAO
1718  02_COAL         -0.88   -0.46   -0.74   -0.30   -0.58   -0.30   -0.97   -0.50   -1.03   -0.85   -0.67   -0.76   -0.82   -0.46   -0.71   -1.12   -0.80
1719  03_OIL          -0.52   -0.34   -0.54   -0.15   -0.66   -0.15   -0.92   -0.58   -0.74   -0.45   -0.15   -0.39   -0.95   -0.34   -0.98   -0.52   -0.99
1720  04_GAS          -0.74   -1.16   -0.52   -0.30   -0.67   -0.15   -0.73   -0.69   -0.85   -0.71   -0.57   -0.62   -0.69   -1.16   -0.18   -0.15   -1.25
1721  10_PETROLCOAL   -0.52   -0.34   -0.54   -0.15   -0.66   -0.15   -0.92   -0.58   -0.74   -0.45   -0.15   -0.39   -0.95   -0.34   -0.98   -0.52   -0.99
1722  18_ELEC         -0.48   -0.42   -0.45   -0.21   -0.35   -0.21   -0.49   -0.47   -0.30   -0.26   -0.21   -0.37   -0.57   -0.42   -0.29   -0.30   -0.29
1723  ;
1724   
1725  * Set targets based on DDO
1726  Parameter Target_ECON(ene,z);
1727  Target_ECON('02_COAL',z) = Target_Elas('02_COAL',z);
1728  Target_ECON('03_OIL',z) = Target_Elas('03_OIL',z);
1729  Target_ECON('04_GAS',z) = Target_Elas('04_GAS',z);
1730  Target_ECON('10_PETROLCOAL',z) = Target_Elas('10_PETROLCOAL',z);
1731  Target_ECON('18_ELEC',z) = Target_Elas('18_ELEC',z);
1732   
1733  SET iter "Maximum number of iterations" / 1*1000 /;
1734  SCALAR step "Update speed (Damping factor)" / 0.15 /;
1735  PARAMETER Adj_Ratio(ene,z) "Ratio to target";
1736  PARAMETER Ind_Total_Weight(ene,z) "Total industry weight";
1737   
1738  Ind_Total_Weight(ene,z) = SUM(j, W_IND(ene,j,z));
1739   
1740  * ==============================================================================
1741  * Declare temporary parameters before entering the loop (for calculating error weights by industry)
1742  * ==============================================================================
1743  PARAMETER Ind_Err_CG(j,z) "Weighted average error of Coal-Gas nest by industry";
1744  PARAMETER Ind_Err_OP(j,z) "Weighted average error of Oil products nest by industry";
1745  PARAMETER Ind_Err_NE(j,z) "Weighted average error of Non-Elec nest by industry";
1746  PARAMETER Ind_Err_Tot(j,z) "Weighted average error of total energy by industry";
1747   
1748  * ==============================================================================
1749  * Algorithm Start
1750  * ==============================================================================
1751  LOOP(iter,
1752  * --------------------------------------------------------------------------
1753  * 1. Recalculate elasticity based on currently updated sigma values
1754  * --------------------------------------------------------------------------
1755      Elas_Comp_IND('02_COAL',j2,z)$DEO('02_COAL',j2,z) =
1756          - (1 - S_Coal_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Coal_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1757          - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1758   
1759      Elas_Comp_IND('04_GAS',j2,z)$DEO('04_GAS',j2,z) =
1760          - (1 - S_Gas_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Gas_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1761          - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1762   
1763      Elas_Comp_IND('03_OIL',j2,z)$DEO('03_OIL',j2,z) =
1764          - (1 - S_Oil_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Oil_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1765          - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1766   
1767      Elas_Comp_IND('10_PETROLCOAL',j2,z)$DEO('10_PETROLCOAL',j2,z) =
1768          - (1 - S_Petrol_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Petrol_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1769          - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1770   
1771      Elas_Comp_IND('18_ELEC',j2,z)$DEO('18_ELEC',j2,z) =
1772          - (1 - S_Elec_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Elec_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1773   
1774      Elas_Dom_IND(ene,j,z)$DEO(ene,j,z) = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_IND(ene,j,z);
1775      Elas_Dom_HH(ene,z)$CO(ene,z)       = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_HH(ene,z);
1776      Elas_Dom_INV(ene,z)$INVO(ene,z)    = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_INV(ene,z);
1777      Elas_Dom_GOV(ene,z)$CGO(ene,z)     = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_GOV(ene,z);
1778   
1779      Elas_Total_DDO(ene,z) =
1780          SUM(j, W_IND(ene,j,z) * Elas_Dom_IND(ene,j,z))
1781          + W_HH(ene,z)  * Elas_Dom_HH(ene,z)
1782          + W_INV(ene,z) * Elas_Dom_INV(ene,z)
1783          + W_GOV(ene,z) * Elas_Dom_GOV(ene,z);
1784   
1785      Elas_EXP(ene,z)$EXTO(ene,z) = SUM(zj$EXO(ene,z,zj), (EXO(ene,z,zj)/EXTO(ene,z)) * (-sigma_M2(ene,zj)));
1786      Elas_Total_ECON(ene,z) = W_DDO(ene,z) * Elas_Total_DDO(ene,z) + W_EXTO(ene,z) * Elas_EXP(ene,z);
1787   
1788  * --------------------------------------------------------------------------
1789  * 2. Calculate error ratio at the national level (Initialize first, keep 1.0 for fuels without target)
1790  * --------------------------------------------------------------------------
1791      Adj_Ratio(ene,z) = 1.0;
1792      Adj_Ratio(ene,z)$(Elas_Total_ECON(ene,z) ne 0 and Target_ECON(ene,z) ne 0) = Target_ECON(ene,z) / Elas_Total_ECON(ene,z);
1793      Adj_Ratio(ene,z) = max(0.2, min(5.0, Adj_Ratio(ene,z)));
1794   
1795  * --------------------------------------------------------------------------
1796  * 3. Parameter Update (Reflecting high-precision industry-specific nest weights)
1797  * --------------------------------------------------------------------------
1798      sigma_M1(ene,z)$(1 - S_DOM(ene,z) > 0.05) = sigma_M1(ene,z) * (1 + step * (Adj_Ratio(ene,z) - 1));
1799  *    sigma_M2(ene,z) = sigma_M2(ene,z) * (1 + step * (Adj_Ratio(ene,z) - 1));
1800      sigma_M2(ene,z) = sigma_M1(ene,z) * (Init_sigma_M2(ene,z) / Init_sigma_M1(ene,z));
1801   
1802      LOOP(j2,
1803  * A. Derive weighted average error by nest within each industry (j2) (Follow the error of the fuel heavily consumed by the industry)
1804          Ind_Err_CG(j2,z)  = S_Coal_CG(j2,z)*Adj_Ratio('02_COAL',z) + S_Gas_CG(j2,z)*Adj_Ratio('04_GAS',z);
1805          Ind_Err_OP(j2,z)  = S_Oil_OP(j2,z)*Adj_Ratio('03_OIL',z)   + S_Petrol_OP(j2,z)*Adj_Ratio('10_PETROLCOAL',z);
1806          Ind_Err_NE(j2,z)  = S_CG_NE(j2,z)*Ind_Err_CG(j2,z)         + S_OP_NE(j2,z)*Ind_Err_OP(j2,z);
1807          Ind_Err_Tot(j2,z) = S_Elec_E(j2,z)*Adj_Ratio('18_ELEC',z)  + S_NE_E(j2,z)*Ind_Err_NE(j2,z);
1808   
1809  * B. Parameter modification (Cross-application according to mathematical partial derivative structure)
1810  * Lower nests dominate the elasticity of "minority" fuels, so track errors inversely (Cross)
1811          sigma_ENER_coalgas(j2,z) = sigma_ENER_coalgas(j2,z) * (1 + step * ( S_Coal_CG(j2,z)*Adj_Ratio('04_GAS',z) + S_Gas_CG(j2,z)*Adj_Ratio('02_COAL',z) - 1 ));
1812          sigma_ENER_oilprod(j2,z) = sigma_ENER_oilprod(j2,z) * (1 + step * ( S_Oil_OP(j2,z)*Adj_Ratio('10_PETROLCOAL',z) + S_Petrol_OP(j2,z)*Adj_Ratio('03_OIL',z) - 1 ));
1813   
1814  * Upper nests dominate the elasticity of "majority" fuels, so track the weighted average of the nest
1815          sigma_ENER_nelec(j2,z) = sigma_ENER_nelec(j2,z) * (1 + step * (Ind_Err_NE(j2,z) - 1));
1816   
1817  * Cross nest (Cross-application of errors between electricity and non-electricity)
1818          sigma_ENER_elec(j2,z) = sigma_ENER_elec(j2,z) * (1 + step * ( S_NE_E(j2,z)*Adj_Ratio('18_ELEC',z) + S_Elec_E(j2,z)*Ind_Err_NE(j2,z) - 1 ));
1819   
1820  * Top KLE elasticity tracks the integrated energy error of the entire industry
1821          sigma_KLE(j2,z) = sigma_KLE(j2,z) * (1 + (step/2) * (Ind_Err_Tot(j2,z) - 1));
1822      );
1823   
1824  * --------------------------------------------------------------------------
1825  * 4. Logical Constraints for Parameters
1826  * --------------------------------------------------------------------------
1827  *    sigma_M1(ene,z) = max(0.5, min(15.0, sigma_M1(ene,z)));
1828  *    sigma_M2(ene,z) = max(0.5, min(30.0, sigma_M2(ene,z)));
1829   
1830  *    sigma_ENER_coalgas(j,z) = max(0.5, min(3.0, sigma_ENER_coalgas(j,z)));
1831  *    sigma_ENER_oilprod(j,z) = max(0.5, min(3.0, sigma_ENER_oilprod(j,z)));
1832  *    sigma_ENER_nelec(j,z)   = max(0.5, min(3.0, sigma_ENER_nelec(j,z)));
1833  *    sigma_ENER_elec(j,z)    = max(0.5, min(3.0, sigma_ENER_elec(j,z)));
1834  *    sigma_KLE(j,z)          = max(0.5, min(3.0, sigma_KLE(j,z)));
1835   
1836      sigma_M1(ene,z) = max(0.5, min(15.0, sigma_M1(ene,z)));
1837      sigma_M2(ene,z) = max(0.5, min(30.0, sigma_M2(ene,z)));
1838      sigma_ENER_coalgas(j,z) = max(0.5, min(3.0, sigma_ENER_coalgas(j,z)));
1839      sigma_ENER_oilprod(j,z) = max(0.5, min(3.0, sigma_ENER_oilprod(j,z)));
1840      sigma_ENER_nelec(j,z)   = max(0.5, min(3.0, sigma_ENER_nelec(j,z)));
1841      sigma_ENER_elec(j,z)    = max(0.5, min(3.0, sigma_ENER_elec(j,z)));
1842      sigma_KLE(j,z)          = max(0.5, min(3.0, sigma_KLE(j,z)));
1843   
1844  * [2단계] 대체탄력성 1.0 부근(0.9 ~ 1.1) 회피 조건 추가 (Deadzone 설정)
1845  * 값이 0.9 초과 1.0 이하인 경우 0.9로 고정
1846  * 값이 1.0 초과 1.1 미만인 경우 1.1로 고정
1847   
1848      sigma_M1(ene,z)$(sigma_M1(ene,z) > 0.9 and sigma_M1(ene,z) <= 1.0) = 0.9;
1849      sigma_M1(ene,z)$(sigma_M1(ene,z) > 1.0 and sigma_M1(ene,z) <  1.1) = 1.1;
1850   
1851      sigma_M2(ene,z)$(sigma_M2(ene,z) > 0.9 and sigma_M2(ene,z) <= 1.0) = 0.9;
1852      sigma_M2(ene,z)$(sigma_M2(ene,z) > 1.0 and sigma_M2(ene,z) <  1.1) = 1.1;
1853   
1854      sigma_ENER_coalgas(j,z)$(sigma_ENER_coalgas(j,z) > 0.9 and sigma_ENER_coalgas(j,z) <= 1.0) = 0.9;
1855      sigma_ENER_coalgas(j,z)$(sigma_ENER_coalgas(j,z) > 1.0 and sigma_ENER_coalgas(j,z) <  1.1) = 1.1;
1856   
1857      sigma_ENER_oilprod(j,z)$(sigma_ENER_oilprod(j,z) > 0.9 and sigma_ENER_oilprod(j,z) <= 1.0) = 0.9;
1858      sigma_ENER_oilprod(j,z)$(sigma_ENER_oilprod(j,z) > 1.0 and sigma_ENER_oilprod(j,z) <  1.1) = 1.1;
1859   
1860      sigma_ENER_nelec(j,z)$(sigma_ENER_nelec(j,z) > 0.9 and sigma_ENER_nelec(j,z) <= 1.0) = 0.9;
1861      sigma_ENER_nelec(j,z)$(sigma_ENER_nelec(j,z) > 1.0 and sigma_ENER_nelec(j,z) <  1.1) = 1.1;
1862   
1863      sigma_ENER_elec(j,z)$(sigma_ENER_elec(j,z) > 0.9 and sigma_ENER_elec(j,z) <= 1.0) = 0.9;
1864      sigma_ENER_elec(j,z)$(sigma_ENER_elec(j,z) > 1.0 and sigma_ENER_elec(j,z) <  1.1) = 1.1;
1865   
1866      sigma_KLE(j,z)$(sigma_KLE(j,z) > 0.9 and sigma_KLE(j,z) <= 1.0) = 0.9;
1867      sigma_KLE(j,z)$(sigma_KLE(j,z) > 1.0 and sigma_KLE(j,z) <  1.1) = 1.1;
1868   
1869  );
1870   
1871  * ==============================================================================
1872  * [ADDITION] Generate consolidated report for elasticity parameter changes
1873  * ==============================================================================
1874  PARAMETER Report_sigma_M1(ene,z,eval_sig) "Report for Armington sigma_M1 changes";
1875  PARAMETER Report_sigma_M2(ene,z,eval_sig) "Report for Armington sigma_M2 changes";
1876  PARAMETER Report_sigma_IND(j,z,sig_type,eval_sig) "Report for Industry nest sigma changes";
1877   
1878  * 1. Generate report for sigma_M1
1879  Report_sigma_M1(ene,z,'Initial') = Init_sigma_M1(ene,z);
1880  Report_sigma_M1(ene,z,'Final')   = sigma_M1(ene,z);
1881  Report_sigma_M1(ene,z,'Diff')    = sigma_M1(ene,z) - Init_sigma_M1(ene,z);
1882   
1883  Report_sigma_M2(ene,z,'Initial') = Init_sigma_M2(ene,z);
1884  Report_sigma_M2(ene,z,'Final')   = sigma_M2(ene,z);
1885  Report_sigma_M2(ene,z,'Diff')    = sigma_M2(ene,z) - Init_sigma_M2(ene,z);
1886   
1887  * 2. Generate consolidated report for industry-specific elasticities
1888  Report_sigma_IND(j,z,'s_coalgas','Initial') = Init_sigma_IND(j,z,'s_coalgas');
1889  Report_sigma_IND(j,z,'s_coalgas','Final')   = sigma_ENER_coalgas(j,z);
1890  Report_sigma_IND(j,z,'s_coalgas','Diff')    = sigma_ENER_coalgas(j,z) - Init_sigma_IND(j,z,'s_coalgas');
1891   
1892  Report_sigma_IND(j,z,'s_oilprod','Initial') = Init_sigma_IND(j,z,'s_oilprod');
1893  Report_sigma_IND(j,z,'s_oilprod','Final')   = sigma_ENER_oilprod(j,z);
1894  Report_sigma_IND(j,z,'s_oilprod','Diff')    = sigma_ENER_oilprod(j,z) - Init_sigma_IND(j,z,'s_oilprod');
1895   
1896  Report_sigma_IND(j,z,'s_nelec','Initial') = Init_sigma_IND(j,z,'s_nelec');
1897  Report_sigma_IND(j,z,'s_nelec','Final')   = sigma_ENER_nelec(j,z);
1898  Report_sigma_IND(j,z,'s_nelec','Diff')    = sigma_ENER_nelec(j,z) - Init_sigma_IND(j,z,'s_nelec');
1899   
1900  Report_sigma_IND(j,z,'s_elec','Initial') = Init_sigma_IND(j,z,'s_elec');
1901  Report_sigma_IND(j,z,'s_elec','Final')   = sigma_ENER_elec(j,z);
1902  Report_sigma_IND(j,z,'s_elec','Diff')    = sigma_ENER_elec(j,z) - Init_sigma_IND(j,z,'s_elec');
1903   
1904  Report_sigma_IND(j,z,'s_kle','Initial') = Init_sigma_IND(j,z,'s_kle');
1905  Report_sigma_IND(j,z,'s_kle','Final')   = sigma_KLE(j,z);
1906  Report_sigma_IND(j,z,'s_kle','Diff')    = sigma_KLE(j,z) - Init_sigma_IND(j,z,'s_kle');
1907   
1908  Report_Elas(ene,z,'Initial') = Initial_Elas_ECON(ene,z);
1909  Report_Elas(ene,z,'Final')   = Elas_Total_ECON(ene,z);
1910  Report_Elas(ene,z,'Target')  = Target_ECON(ene,z);
1911   
1912  * Display results in the .lst file
1913  DISPLAY Report_sigma_M1, Report_sigma_IND;
1914  *$Offtext
1915  *==============================================================================
1916  * Calibration of function parameters
1917  *==============================================================================
1918   io(j,z)$XSTO(j,z)         = CIO(j,z) / XSTO(j,z);
1919   io2(j,z)$XSTO(j,z)        = CEO(j,z) / XSTO(j,z);
1920   v(j,z)$XSTO(j,z)          = VAO(j,z) / XSTO(j,z);
1921   v2(j,z)$XSTO(j,z)         = (CEO(j,z) + VAO(j,z)) / XSTO(j,z);
1922   
1923   aij(nene,j,z)$XSTO(j,z)   = DIO(nene,j,z) / CIO(j,z);
1924   aij2(ene,j,z)$XSTO(j,z)   = DEO(ene,j,z) / CEO(j,z);
1925   aij_t(nene,j,z,time)        = aij(nene,j,z);
1926   aij2_t(ene,j,z,time)        = aij2(ene,j,z);
1927   
1928  *==============================================================================
1929  * Calibration of CET parameters
1930  *==============================================================================
1931   rho_X1(i,z) = (1 + sigma_X1(i,z)) / sigma_X1(i,z);
1932   
1933   beta_EX_X1(i,z)$MRGNO(i,z)
1934      = [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z)) ] /
1935        [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z))
1936        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z))
1937        + eO(z)     * PWMGO(i) * MRGNO(i,z)$MRGNO(i,z)**(1 - rho_X1(i,z)) ];
1938   
1939   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1940      = [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z)) ] /
1941        [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z))
1942        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z)) ];
1943   
1944   beta_D_X1(i,z)$MRGNO(i,z)
1945      = [ PLO(i,z) * DSO_I(i,z)**(1 - rho_X1(i,z)) ] /
1946        [ PETO(i,z) * EXTO(i,z)**(1 - rho_X1(i,z))
1947        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z))
1948        + eO(z)     * PWMGO(i) * MRGNO(i,z)**(1 - rho_X1(i,z)) ];
1949   
1950   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1951      = [ PLO(i,z) * DSO_I(i,z)**(1 - rho_X1(i,z)) ] /
1952        [ PETO(i,z) * EXTO(i,z)**(1 - rho_X1(i,z))
1953        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z)) ];
1954   
1955   B_X1(i,z)
1956      = XSO_I(i,z) /
1957        [ beta_EX_X1(i,z) * EXTO(i,z)**rho_X1(i,z)
1958        + beta_D_X1(i,z)  * DSO_I(i,z)**rho_X1(i,z)
1959        + (1 - beta_EX_X1(i,z) - beta_D_X1(i,z)) * MRGNO(i,z)**rho_X1(i,z)
1960        ]**(1 / rho_X1(i,z));
1961   
1962  *==============================================================================
1963  * CET between exports to different trading partners
1964  *==============================================================================
1965   rho_X2(i,z) = (1 + sigma_X2(i,z)) / sigma_X2(i,z);
1966   
1967   beta_X2(i,z,zj)$EXO(i,z,zj)
1968      = [ PEO(i,z,zj) * EXO(i,z,zj)**(1 - rho_X2(i,z)) ] /
1969        SUM[zjj$EXO(i,z,zjj), PEO(i,z,zjj) * EXO(i,z,zjj)**(1 - rho_X2(i,z)) ];
1970   
1971   B_X2(i,z)
1972      = EXTO(i,z) /
1973        { SUM[zj, beta_X2(i,z,zj) * EXO(i,z,zj)**rho_X2(i,z)]**(1 / rho_X2(i,z)) };
1974   
1975  *==============================================================================
1976  * Calibration of CES parameters
1977  *==============================================================================
1978   rho_X3(i,z) = (1 - sigma_X3(i,z)) / sigma_X3(i,z);
1979   
1980   beta_X3(j,i,z)$XSO(j,i,z)
1981      = [ PO2(j,i,z) * XSO(j,i,z)**(1 + rho_X3(i,z)) ] /
1982        SUM[jj$XSO(jj,i,z), PO2(jj,i,z) * XSO(jj,i,z)**(1 + rho_X3(i,z)) ];
1983   
1984   B_X3(i,z)
1985      = XSO_I(i,z) /
1986        SUM[jj$XSO(jj,i,z), beta_X3(jj,i,z) * XSO(jj,i,z)**(-rho_X3(i,z))]**(-1 / rho_X3(i,z));
1987   
1988  * Electricity
1989   QPOWERO(z) = SUM(POWER, XSO(power,'18_ELEC',z));
1990   rho_X4(z)  = (1 - sigma_X4(z)) / sigma_X4(z);
1991   
1992   beta_X4(power,z)
1993      = [ PO2(power,'18_ELEC',z) * XSO(power,'18_ELEC',z)**(1 + rho_X4(z)) ] /
1994        SUM[powerr$XSO(powerr,'18_ELEC',z), PO2(powerr,'18_ELEC',z) * XSO(powerr,'18_ELEC',z)**(1 + rho_X4(z)) ];
1995   
1996   B_X4(z)
1997      = QPOWERO(z) /
1998        SUM[powerr$XSO(powerr,'18_ELEC',z), beta_X4(powerr,z) * XSO(powerr,'18_ELEC',z)**(-rho_X4(z))]**(-1 / rho_X4(z));
1999   
2000   TnDShare(z) = XSO('18_TnD','18_ELEC',z) / XSO_I('18_ELEC',z);
2001   
2002  *Backstop
2003  LOOP(MAP_BS(bs, conv, I_BS),
2004   
2005      QBSO(bs, Z_GRN) = XSO(conv, I_BS, Z_GRN) + XSO(bs, I_BS, Z_GRN);
2006   
2007      rho_BS(bs, Z_GRN) = (1 - sigma_BS(bs, Z_GRN)) / sigma_BS(bs, Z_GRN);
2008   
2009      beta_BS(conv, I_BS, Z_GRN)
2010          = [ PO2(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] /
2011            ( [ PO2(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] +
2012              [ PO2(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] );
2013   
2014      beta_BS(bs, I_BS, Z_GRN)
2015          = [ PO2(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] /
2016            ( [ PO2(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] +
2017              [ PO2(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] );
2018   
2019      B_BS(bs, Z_GRN)
2020          = QBSO(bs, Z_GRN) /
2021            ( beta_BS(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(-rho_BS(bs, Z_GRN)) +
2022              beta_BS(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(-rho_BS(bs, Z_GRN)) )**(-1 / rho_BS(bs, Z_GRN));
2023   
2024      beta_BS_t(conv, I_BS, Z_GRN, time) = beta_BS(conv, I_BS, Z_GRN);
2025      beta_BS_t(bs, I_BS, Z_GRN, time)   = beta_BS(bs, I_BS, Z_GRN);
2026  );
2027   
2028  *==============================================================================
2029  * Composite good
2030  *==============================================================================
2031   rho_M1(i,z) = (1 - sigma_M1(i,z)) / sigma_M1(i,z);
2032   
2033   beta_M1(i,z)
2034      = PMTO(i,z) * IMTO(i,z)**(rho_M1(i,z) + 1) /
2035        { PDO(i,z)  * DDO(i,z)**(rho_M1(i,z) + 1)
2036        + PMTO(i,z) * IMTO(i,z)**(rho_M1(i,z) + 1) };
2037   
2038   B_M1(i,z)
2039      = QO(i,z) /
2040        { beta_M1(i,z) * IMTO(i,z)**(-rho_M1(i,z))
2041        + (1 - beta_M1(i,z)) * DDO(i,z)**(-rho_M1(i,z)) }**(-1 / rho_M1(i,z));
2042   
2043  *==============================================================================
2044  * CES between imports from different trading partners
2045  *==============================================================================
2046   rho_M2(i,z) = (1 - sigma_M2(i,z)) / sigma_M2(i,z);
2047   
2048   beta_M2(i,zj,z)$IMO(i,zj,z)
2049      = [ PMO(i,zj,z) * IMO(i,zj,z)**(rho_M2(i,z) + 1) ] /
2050        SUM[zjj$IMO(i,zjj,z), PMO(i,zjj,z) * IMO(i,zjj,z)**(rho_M2(i,z) + 1) ];
2051   
2052   B_M2(i,z)
2053      = IMTO(i,z) /
2054        { SUM[zj$IMO(i,zj,z), beta_M2(i,zj,z) * IMO(i,zj,z)**(-rho_M2(i,z))]**(-1 / rho_M2(i,z)) };
2055   
2056  *==============================================================================
2057  * Composite capital
2058  *==============================================================================
2059   rho_KD(j,z) = (1 - sigma_KD(j,z)) / sigma_KD(j,z);
2060   
2061   beta_KD(k,j,z)$KDO(k,j,z)
2062      = [ RTIO(k,j,z) * KDO(k,j,z)**(1 + rho_KD(j,z)) ] /
2063        SUM[kj$KDO(kj,j,z), RTIO(kj,j,z) * KDO(kj,j,z)**(1 + rho_KD(j,z)) ];
2064   
2065   B_KD(j,z)$KDCO(j,z)
2066      = KDCO(j,z) /
2067        { SUM[k$KDO(k,j,z), beta_KD(k,j,z) * KDO(k,j,z)**(-rho_KD(j,z))]**(-1 / rho_KD(j,z)) };
2068   
2069  *===============================================================================
2070  * Composite E
2071  *===============================================================================
2072  * Level 5_1 (Coal/Gas)
2073   rho_ENER_coalgas(j2,z) = (1 - sigma_ENER_coalgas(j2,z)) / sigma_ENER_coalgas(j2,z);
2074   
2075   beta_ENER_coalgas(ene5,j2,z)
2076      = [ PO4(ene5,j2,z) * DEO(ene5,j2,z)**(1 + rho_ENER_coalgas(j2,z)) ] /
2077        SUM[enee5, PO4(enee5,j2,z) * DEO(enee5,j2,z)**(1 + rho_ENER_coalgas(j2,z)) ];
2078   
2079   B_ENER_coalgas(j2,z)
2080      = DEcoalgasO(j2,z) /
2081        { SUM[ene5, beta_ENER_coalgas(ene5,j2,z) * DEO(ene5,j2,z)**(-rho_ENER_coalgas(j2,z))] }**(-1 / rho_ENER_coalgas(j2,z));
2082   
2083  * Level 5_2 (Oil/Petrol)
2084   rho_ENER_oilprod(j2,z) = (1 - sigma_ENER_oilprod(j2,z)) / sigma_ENER_oilprod(j2,z);
2085   
2086   beta_ENER_oilprod(ene6,j2,z)
2087      = [ PO4(ene6,j2,z) * DEO(ene6,j2,z)**(1 + rho_ENER_oilprod(j2,z)) ] /
2088        SUM[enee6, PO4(enee6,j2,z) * DEO(enee6,j2,z)**(1 + rho_ENER_oilprod(j2,z)) ];
2089   
2090   B_ENER_oilprod(j2,z)
2091      = DEoilpetrolO(j2,z) /
2092        { SUM[ene6, beta_ENER_oilprod(ene6,j2,z) * DEO(ene6,j2,z)**(-rho_ENER_oilprod(j2,z))] }**(-1 / rho_ENER_oilprod(j2,z));
2093   
2094  * Level 4 (Coal-Gas / Oil-Petrol)
2095   rho_ENER_nelec(j2,z) = (1 - sigma_ENER_nelec(j2,z)) / sigma_ENER_nelec(j2,z);
2096   
2097   beta_ENER_nelec(j2,z)
2098      = PCEcoalgasO(j2,z) * DEcoalgasO(j2,z)**(rho_ENER_nelec(j2,z) + 1) /
2099        { PCEcoalgasO(j2,z) * DEcoalgasO(j2,z)**(rho_ENER_nelec(j2,z) + 1)
2100        + PCEoilpetrolO(j2,z) * DEoilpetrolO(j2,z)**(rho_ENER_nelec(j2,z) + 1) };
2101   
2102   B_ENER_nelec(j2,z)
2103      = DEnelecO(j2,z) /
2104        { [ beta_ENER_nelec(j2,z) * DEcoalgasO(j2,z)**(-rho_ENER_nelec(j2,z))
2105          + (1 - beta_ENER_nelec(j2,z)) * DEoilpetrolO(j2,z)**(-rho_ENER_nelec(j2,z)) ] }**(-1 / rho_ENER_nelec(j2,z));
2106   
2107  * Level 2 (Elec / Non-Elec)
2108   rho_ENER_elec(j2,z) = (1 - sigma_ENER_elec(j2,z)) / sigma_ENER_elec(j2,z);
2109   
2110   beta_ENER_elec(j2,z)
2111      = PCEelecO(j2,z) * DEelecO(j2,z)**(rho_ENER_elec(j2,z) + 1) /
2112        { PCEelecO(j2,z) * DEelecO(j2,z)**(rho_ENER_elec(j2,z) + 1)
2113        + PCEnelecO(j2,z) * DEnelecO(j2,z)**(rho_ENER_elec(j2,z) + 1) };
2114   
2115   B_ENER_elec(j2,z)
2116      = CEO(j2,z) /
2117        { [ beta_ENER_elec(j2,z) * DEelecO(j2,z)**(-rho_ENER_elec(j2,z))
2118          + (1 - beta_ENER_elec(j2,z)) * DEnelecO(j2,z)**(-rho_ENER_elec(j2,z)) ] }**(-1 / rho_ENER_elec(j2,z));
2119   
2120  *==============================================================================
2121  * Value added
2122  *==============================================================================
2123   rho_VA(j,z) = (1 - sigma_VA(j,z)) / sigma_VA(j,z);
2124   
2125   beta_VA(j,z)$KDCO(j,z)
2126      = WCO(j,z) * LDCO(j,z)**(rho_VA(j,z) + 1) /
2127        { WCO(j,z) * LDCO(j,z)**(rho_VA(j,z) + 1)
2128        + RCO(j,z) * KDCO(j,z)**(rho_VA(j,z) + 1) };
2129   
2130   B_VA(j,z)$KDCO(j,z)
2131      = VAO(j,z) /
2132        { [ beta_VA(j,z) * LDCO(j,z)**(-rho_VA(j,z))
2133          + (1 - beta_VA(j,z)) * KDCO(j,z)**(-rho_VA(j,z)) ] }**(-1 / rho_VA(j,z));
2134   
2135   B_VA_t(j,z,time) = B_VA(j,z);
2136   
2137  *==============================================================================
2138  * Calibration of VAT nest for ALL Backstop Sectors (BS)
2139  *==============================================================================
2140  rho_VAT(BS, Z_GRN)   = (1 - sigma_VAT(BS, Z_GRN)) / sigma_VAT(BS, Z_GRN);
2141   
2142   beta_VAT(BS, Z_GRN)
2143      = ( PVAO(BS, Z_GRN) * VAO(BS, Z_GRN)**(1 + rho_VAT(BS, Z_GRN)) ) /
2144        ( PVAO(BS, Z_GRN) * VAO(BS, Z_GRN)**(1 + rho_VAT(BS, Z_GRN))
2145        + PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN)**(1 + rho_VAT(BS, Z_GRN)) );
2146   
2147   B_VAT(BS, Z_GRN)
2148      = VATO(BS, Z_GRN) /
2149        ( beta_VAT(BS, Z_GRN) * VAO(BS, Z_GRN)**(-rho_VAT(BS, Z_GRN))
2150        + (1 - beta_VAT(BS, Z_GRN)) * TSFO(BS, Z_GRN)**(-rho_VAT(BS, Z_GRN)) )**(-1 / rho_VAT(BS, Z_GRN));
2151   
2152   v_vat(BS, Z_GRN)     = VATO(BS, Z_GRN) / XSTO(BS, Z_GRN);
2153   
2154   B_VAT_t(BS, Z_GRN, time) = B_VAT(BS, Z_GRN);
2155   
2156  *==============================================================================
2157  * Composite KLE
2158  *==============================================================================
2159   rho_KLE(j,z) = (1 - sigma_KLE(j,z)) / sigma_KLE(j,z);
2160   
2161   beta_KLE(j,z)$KLEO(j,z)
2162      = PVAO(j,z) * VAO(j,z)**(rho_KLE(j,z) + 1) /
2163        { PVAO(j,z) * VAO(j,z)**(rho_KLE(j,z) + 1)
2164        + PCEO(j,z) * CEO(j,z)**(rho_KLE(j,z) + 1) };
2165   
2166   beta_KLE2(j,z)$KLEO(j,z)
2167      = 1 - beta_KLE(j,z);
2168   
2169   B_KLE(j,z)$KLEO(j,z)
2170      = KLEO(j,z) /
2171        { [ beta_KLE(j,z) * VAO(j,z)**(-rho_KLE(j,z))
2172          + beta_KLE2(j,z) * CEO(j,z)**(-rho_KLE(j,z)) ] }**(-1 / rho_KLE(j,z));
2173   
2174  *==============================================================================
2175  * Calibration of gross domestic products
2176  *==============================================================================
2177  GDP_BPO(z)     = SUM[j, PVAO(j,z) * VAO(j,z)] + SUM[BS, PTSFO(BS,z) * TSFO(BS,z)] + TIPTO(z);
2178   GDP_MPO(z)     = GDP_BPO(z) + TPRCTSO(z);
2179   
2180  GDP_IBO(z)
2181      = SUM[(j), WO(z) * LDO(j,z)]
2182      + SUM[(k,j), RO(k,j,z) * KDO(k,j,z)]
2183      + SUM[BS, PTSFO(BS,z) * TSFO(BS,z)]
2184      + TPRODNO(z)
2185      + TPRCTSO(z);
2186   
2187   GDP_FDO(z)
2188      = SUM[i, PCO(i,z) * (CO(i,z) + CGO(i,z) + INVO(i,z))]
2189      + eO(z) * SUM[(i,zj), PWXO(i,z,zj) * EXO(i,z,zj)]
2190      + eO(z) * SUM[i, PWMGO(i) * MRGNO(i,z)]
2191      - eO(z) * SUM[(i,zj), IMO(i,zj,z) * (PWMO(i,zj,z) + SUM{ij, PWMGO(ij) * tmrg(ij,i,zj,z)})];
2192   
2193   GDP_BP_WO      = SUM[z, GDP_BPO(z) / eO(z)];
2194   
2195  *==============================================================================
2196  * Calibration of real (volume) variables computed from price indices
2197  *==============================================================================
2198   CABXO(z)       = CABO(z) / [PIXGDP_WO * eO(z)];
2199   
2200   CABXsur(z,T1)  = CABXO(z)$[CABXO(z) gt 0];
2201   CABXdef(z,T1)  = CABXO(z)$[CABXO(z) lt 0];
2202   
2203   CABXsur(z,time)$[ord(time) gt 1] = CABXO(z) * (1 + g_GDP(z,time))$[CABXO(z) gt 0];
2204   CABXdef(z,time)$[ord(time) gt 1] = CABXO(z) * (1 + g_GDP(z,time))$[CABXO(z) lt 0];
2205   
2206   Bal(time)      = SUM(zj, CABXsur(zj,time)) + SUM(zj, CABXdef(zj,time));
2207   
2208   mu(time)       = SUM(zj, CABXsur(zj,time)) /
2209                    { SUM(zj, CABXsur(zj,time)) + SUM(zj, ABS(CABXdef(zj,time))) };
2210   
2211   CABXsur(z,time) = CABXsur(z,time) * { 1 - mu(time) * Bal(time) / SUM(zj, CABXsur(zj,time)) };
2212   CABXdef(z,time) = CABXdef(z,time) * { 1 - [1 - mu(time)] * Bal(time) / SUM(zj, CABXdef(zj,time)) };
2213   CABix(z,time)   = [ CABXsur(z,time) + CABXdef(z,time) ] / CABXO(z);
2214   
2215   CTH_REALO(z)   = CTHO(z) / PIXCONO(z);
2216   G_REALO(z)     = GO(z) / PIXGVTO(z);
2217   GDP_BP_REALO(z)= GDP_BPO(z) / PIXGDPO(z);
2218   GDP_BP_W_REALO = GDP_BP_WO / PIXGDP_WO;
2219   GDP_MP_REALO(z)= GDP_MPO(z) / PIXCONO(z);
2220   IT_REALO(z)    = ITO(z) / PIXINVO(z);
2221   
2222   sh1O(z)        = [SHO(z) + SGO(z)] / GDP_IBO(z);
2223   sh0O(z)        = SHO(z) - sh1O(z) * YDHO(z);
2224   
2225   sh0O(z)        = sh0O(z) / PIXCONO(z)**eta;
2226   ttdh0O(z)      = ttdh0O(z) / PIXCONO(z)**eta;
2227   
2228   OBJO           = 1;
2229   growthz(z)    = 0.02;
2230   
