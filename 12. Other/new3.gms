107_M3c22__R3r. 03_JPN
110_M3c22__R4r. 04_RUS
113_M3c22__R5r. 05_MNG
116_M3c22__R6r. 06_PRK
119_M3c22__R7r. 07_NAM
122_M3c22__R8r. 08_LAM
125_M3c22__R9r. 09_WEU
128_M3c22__R10r. 10_EEU
131_M3c22__R11r. 11_FSU
134_M3c22__R12r. 12_MEA
137_M3c22__R13r. 13_AFR
140_M3c22__R14r. 14_CPA
143_M3c22__R15r. 15_SAS
146_M3c22__R16r. 16_PAS
149_M3c22__R17r. 17_PAO
/

sam_sce12(WORLD1, z) Mapping of sectors
/
153_ww_r_01KOR. 01_KOR
154_ww_r_02CHN. 02_CHN
155_ww_r_03JPN. 03_JPN
156_ww_r_04RUS. 04_RUS
157_ww_r_05MNG. 05_MNG
158_ww_r_06PRK. 06_PRK
159_ww_r_07NAM. 07_NAM
160_ww_r_08LAM. 08_LAM
161_ww_r_09WEU. 09_WEU
162_ww_r_10EEU. 10_EEU
163_ww_r_11FSU. 11_FSU
164_ww_r_12MEA. 12_MEA
165_ww_r_13AFR. 13_AFR
166_ww_r_14CPA. 14_CPA
167_ww_r_15SAS. 15_SAS
168_ww_r_16PAS. 16_PAS
169_ww_r_17PAO. 17_PAO
/

   macro 'macro controls' / gdpfc2, gdp2 /
;

ALIAS(A,B);
ALIAS(A1,A11);
ALIAS(C1,C11);
ALIAS(INT,JNT);

*INT(A) = YES;
*INT('175_TOT') = NO;

*============ 2.Initial matrix ===========================================
Table SAM_Initial(A,B,z) initial matrix ;

*SAM_Initial(INT,JNT,z) = EPS;

*Acitivities
SAM_Initial(C1,A1,Z)    = SUM[(i,j)$[sam_sce2(C1,i)$sam_sce1(A1,j)], DIO(i,j,Z)];
SAM_Initial(L1,A1,Z)    = SUM[(l,j)$[sam_sce3(L1,l)$sam_sce1(A1,j)], LDO2(l,j,Z)];
SAM_Initial(K1,A1,Z)    = SUM[(k,j)$[sam_sce4(K1,k)$sam_sce1(A1,j)], RKDO(k,j,Z)];
SAM_Initial(tf1,A1,Z)    = SUM[(l,j)$[sam_sce7(tf1,l)$sam_sce1(A1,j)], TIWO2(l,j,Z)];
SAM_Initial(tf2,A1,Z)    = SUM[(k,j)$[sam_sce8(tf2,k)$sam_sce1(A1,j)], TIKO(k,j,Z)];
SAM_Initial(PTX1,A1,Z) = SUM[(j)$[sam_sce1(A1,j)], TIPO(j,Z)];

 
*Commodities
SAM_Initial(A1,C1,Z)          = SUM[(i,j)$[sam_sce1(A1,j)$sam_sce2(C1,i)],  XSO(j,i,z)];
SAM_Initial(ITAX1,C1,Z)     = SUM[(i,zj)$[sam_sce5(ITAX1,zj)$sam_sce2(C1,i)], TIMO(i,zj,Z)];
SAM_Initial(ETAX1,C1,Z)    = SUM[(i,zj)$[sam_sce6(ETAX1,zj)$sam_sce2(C1,i)], TIXO(i,Z,zj)];
SAM_Initial(MAR1,C1,Z)     = SUM[(ij,zj)$[sam_sce9(MAR1,zj)$sam_sce2(C1,ij)],tmrg('20_LTRP',ij,zj,Z)];
SAM_Initial(MAR2,C1,Z)     = SUM[(ij,zj)$[sam_sce10(MAR2,zj)$sam_sce2(C1,ij)],tmrg('21_WTRP',ij,zj,Z)];
SAM_Initial(MAR3,C1,Z)     = SUM[(ij,zj)$[sam_sce11(MAR3,zj)$sam_sce2(C1,ij)],tmrg('22_ATRP',ij,zj,Z)];
SAM_Initial(WORLD1,C1,Z) = SUM[(i,zj)$[sam_sce12(WORLD1,zj)$sam_sce2(C1,i)], IMO(i,zj,Z)];
SAM_Initial(PTX1,C1,Z)      = SUM[(i)$[sam_sce2(C1,i)], TICO(i,Z)];

*Factors
SAM_Initial(PRI1,L1,Z)  = sum{(l)$[sam_sce3(L1,l)],LDO2_J(l,Z)};
SAM_Initial(PRI1,K1,Z)  = sum{(k)$[sam_sce4(K1,k)],RKDO_J(k,Z)};
SAM_Initial(DTX1,L1,Z)  = sum{(l)$[sam_sce3(L1,l)],DTAX(l,Z)};
SAM_Initial(DTX1,K1,Z)  = sum{(k)$[sam_sce4(K1,k)],DTAX(k,Z)};

*Import tariffs
SAM_Initial(PTX1,ITAX1,Z) = SUM[(zj)$[sam_sce5(ITAX1,zj)], sum(i,TIMO(i,zj,Z))];

*Export taxes
SAM_Initial(PTX1,ETAX1,Z) = SUM[(zj)$[sam_sce6(ETAX1,zj)], sum(i,TIXO(i,Z,zj))];

*Factor taxes
SAM_Initial(PTX1,tf1,Z)  = sum{(l)$[sam_sce7(tf1,l)],sum(j,TIWO2(l,j,Z))};
SAM_Initial(PTX1,tf2,Z)  = sum{(k)$[sam_sce8(tf2,k)],sum(j,TIKO(k,j,Z))};

*Transaction cost
SAM_Initial('150_M1c20_L_pvst',MAR1,Z) = SUM[(zj)$[sam_sce9(MAR1,zj)],sum(ij,tmrg('20_LTRP',ij,zj,Z))];
SAM_Initial('151_M2c21_W_pvst',MAR2,Z) = SUM[(zj)$[sam_sce10(MAR2,zj)],sum(ij,tmrg('21_WTRP',ij,zj,Z))];
SAM_Initial('152_M3c22_A_pvst',MAR3,Z) = SUM[(zj)$[sam_sce11(MAR3,zj)],sum(ij,tmrg('22_ATRP',ij,zj,Z))];

SAM_Initial('51_c_LTRP','150_M1c20_L_pvst',Z)= MRGNO('20_LTRP',Z);
SAM_Initial('52_c_WTRP','151_M2c21_W_pvst',Z)= MRGNO('21_WTRP',Z);
SAM_Initial('53_c_ATRP','152_M3c22_A_pvst',Z)= MRGNO('22_ATRP',Z);

SAM_Initial(INV1,'150_M1c20_L_pvst',Z)  = sum(B,SAM_Initial('150_M1c20_L_pvst',B,Z))-SAM_Initial('51_c_LTRP','150_M1c20_L_pvst',Z);
SAM_Initial(INV1,'151_M2c21_W_pvst',Z) = sum(B,SAM_Initial('151_M2c21_W_pvst',B,Z))-SAM_Initial('52_c_WTRP','151_M2c21_W_pvst',Z);
SAM_Initial(INV1,'152_M3c22_A_pvst',Z)  = sum(B,SAM_Initial('152_M3c22_A_pvst',B,Z))-SAM_Initial('53_c_ATRP','152_M3c22_A_pvst',Z);

*Import&Export
SAM_Initial(C1,WORLD1,Z)= SUM[(i,zj)$[sam_sce12(WORLD1,zj)$sam_sce2(C1,i)],EXO(i,Z,zj)];

*Balance of Trade
SAM_Initial(INV1,WORLD1,Z)= SUM(B,SAM_Initial(WORLD1,B,Z))-SUM(C1,SAM_Initial(C1,WORLD1,Z));

*Household
SAM_Initial(C1,PRI1,Z)= SUM[(i)$[sam_sce2(C1,I)], CO(i,Z)];
SAM_Initial(INV1,PRI1,Z)= SUM(B,SAM_Initial(PRI1,B,Z))- SUM(C1,SAM_Initial(C1,PRI1,Z));

*Indirect tax
SAM_Initial(GOV1,PTX1,Z)= SUM(B,SAM_Initial(PTX1,B,Z));

*Direct tax
SAM_Initial(GOV1,DTX1,Z)= SUM(B,SAM_Initial(DTX1,B,Z));

*Government
SAM_Initial(C1,GOV1,Z)= SUM[(i)$[sam_sce2(C1,I)], CGO(i,Z)];

*Saving-Investment
SAM_Initial(C1,INV1,Z)= SUM[(i)$[sam_sce2(C1,I)], INVO(i,Z)];
SAM_Initial(INV1,GOV1,Z)= SUM(C1, SAM_Initial(C1,INV1,Z))-SUM(B,SAM_Initial(INV1,B,Z));

*Total
SAM_Initial('175_TOT',B,Z)= SUM(A,SAM_Initial(A,B,Z));
SAM_Initial(A,'175_TOT',Z)= SUM(B,SAM_Initial(A,B,Z));


Parameter
   SAM0(A,B)        'base SAM transactions matrix'
   T0(A,B)            'matrix of SAM transactions (flow matrix)'
   T1(A,B)            'SAM transactions adjusted to eliminate negative entries'
   Abar0(A,B)       'prior SAM coefficient matrix'
   Abar1(A,B)       'prior SAM adjusted to eliminate negative coefficients'
   Target0(A)       'targets for macro SAM column totals'
   epsilon           'tolerance to allow zero entries in SAM'
   ;
* Initializing Parameters
SAM0("175_TOT",JNT) = sum(INT, SAM_Initial(INT,JNT,'06_PRK'));
SAM0(INT,"175_TOT") = sum(JNT, SAM_Initial(INT,JNT,'06_PRK'));
SAM0(A,B)  = SAM_Initial(A,B,'06_PRK');


Scalar scalesam 'scaling value' / 1000 /;
*sam(A,B)                = sam(A,B)/scalesam ;
SAM_Initial(A,B,'06_PRK') = SAM_Initial(A,B,'06_PRK')/scalesam ;

Abar0(INT,JNT)$SAM_Initial(INT,JNT,'06_PRK')= SAM_Initial(INT,JNT,'06_PRK')/SAM_Initial("175_TOT",JNT,'06_PRK');

T0(INT,JNT)             = SAM_Initial(INT,JNT,'06_PRK');
T0("175_TOT",JNT)  = sum(INT, SAM_Initial(INT,JNT,'06_PRK'));
T0(INT,"175_TOT")   = sum(JNT, SAM_Initial(INT,JNT,'06_PRK'));

epsilon = .00001;

display T0, Abar0;


Set red(A,B) 'set of negative SAM flows';

Parameter
   redsam(A,B) 'negative SAM values only'
   rtot(A)     'row total'
   ctot(A)     'column total';

rtot(INT) = sum(JNT, T0(INT,JNT));
ctot(JNT) = sum(INT, T0(INT,JNT));

red(INT,JNT)$(T0(INT,JNT) < 0) = yes;
redsam(INT,JNT)              = 0;
redsam(INT,JNT)$red(INT,JNT)   = T0(INT,JNT);
redsam(JNT,INT)$red(INT,JNT)   = T0(INT,JNT);

*Note that redsam includes each entry twice, in corresponding row
*and column. So, redsam need only be subtracted from T0.
T1(INT,JNT)      = T0(INT,JNT) - redsam(INT,JNT);
T1("175_TOT",JNT) = sum(INT, T1(INT,JNT));
T1(INT,"175_TOT") = sum(JNT, T1(INT,JNT));

redsam("175_TOT",JNT) = sum(INT, redsam(INT,JNT));
redsam(INT,"175_TOT") = sum(JNT, redsam(INT,JNT));

SAM_Initial(INT,"175_TOT",'06_PRK') = sum(JNT, T1(INT,JNT));
SAM_Initial("175_TOT",JNT,'06_PRK')= sum(INT, T1(INT,JNT));

rtot(INT) = sum(JNT, T1(INT,JNT));
ctot(JNT) = sum(INT, T1(INT,JNT));

Abar1(INT,JNT)$SAM_Initial(INT,JNT,'06_PRK') = T1(INT,JNT)/SAM_Initial("175_TOT",JNT,'06_PRK');
*Abar1(INT,JNT) = T1(INT,JNT)/(SAM_Initial("175_TOT",JNT,'06_PRK')+0.000000000000001);

display "NON-NEGATIVE SAM", redsam, T1, Abar0, Abar1, rtot, ctot;

* Define set of elements of SAM that can be nonzero. In this case, only
* elements which are nonzero in initial SAM.
Set NONZERO(A,B) 'SAM elements that can be nonzero';
NONZERO(INT,JNT)$(Abar1(INT,JNT)) = yes;

* Initializing Parameters after accounting for negative values
*   Note that target column sums are being set to average of initial
*   row and column sums. Initial column sums or other values
*   could have been used instead, depending on knowledge of data quality
*   and any other prior information.
target0(INT) = (SAM_Initial(INT,"175_TOT",'06_PRK') + SAM_Initial("175_TOT",INT,'06_PRK'))/2;
*target0(INT) = SAM_Initial(INT,"175_TOT",'06_PRK') ;

Scalar
   gdpfc0 'GDP at factor cost'
   gdp0   'base GDP'
   gdp00  'GDP from final SAM'
   ;
   
gdpfc0 = SUM((FACTOR,A1),SAM_Initial(FACTOR,A1,'06_PRK'));
gdp0 = gdpfc0 
*Import tariffs
+ SUM((ITAX1,C1),SAM_Initial(ITAX1,C1,'06_PRK')) 
*Export taxes
+ SUM((ETAX1,C1),SAM_Initial(ETAX1,C1,'06_PRK')) 
*Factor use taxes
+ SUM((TF,A1),SAM_Initial(TF,A1,'06_PRK'))
*Production taxes
+ SUM(A1,SAM_Initial('171_PRODTAX',A1,'06_PRK'))
*Income taxes
+ SUM((FTAX,A1),SAM_Initial(FTAX,A1,'06_PRK'))
;


Variable
   A_MAT(A,B)          'post SAM coefficient matrix'
   TSAM(A,B)    'post matrix of SAM transactions'
   Y(A)                'row sum of SAM'
   X(B)                'column sum of SAM'
   DENTROPY          'entropy difference (objective)'
   GDPFC_SAM                'GDP at factor cost'
   GDP_SAM                    'GDP at market prices'
   ;

* INITIALIZE VARIABLES
A_MAT.l(A,B)         = Abar1(A,B);
TSAM.l(A,B)   = T1(A,B);
Y.l(A)               = target0(A);
X.l(A)               = target0(A);
DENTROPY.l         = 0;
GDPFC_SAM.l               = gdpfc0;
GDP_SAM.l                   = gdp0;

* CORE EQUATIONS
Equation
   SAMEQ(A)         'row and column sum constraint'
   SAMMAKE(A,B)  'make SAM flows'
   ENTROPY          'entropy difference definition'
   ROWSUM(A)      'row target'
   COLSUM(B)       'column target'
   GDPFCDEF        'define GDP at factor cost'
   GDPDEF            'define GDP'
;   
*CORE EQUATIONS
SAMEQ(INT)..   Y(INT) =e= X(INT) ;

SAMMAKE(INT,JNT)$nonzero(INT,JNT).. TSAM(INT,JNT) =e= A_MAT(INT,JNT)*X(JNT);

ENTROPY..   DENTROPY =e= sum((INT,JNT)$nonzero(INT,JNT), A_MAT(INT,JNT)*(log(A_MAT(INT,JNT) + epsilon) - log(Abar1(INT,JNT) + epsilon))) ;

* Note that we exclude one rowsum equation since if all but one column
* and rowsum are equal, the last one must also be equal. Walras' Law
* at work.

ROWSUM(INT)$(not sameas(INT,"173_GOVT"))..   sum(JNT, TSAM(INT,JNT)) =e= Y(INT);
*ROWSUM(INT)..   sum(JNT, TSAM(INT,JNT)) =e= Y(INT);

COLSUM(JNT)..   sum(INT, TSAM(INT,JNT)) =e= X(JNT);

*ADDITIONAL MACRO CONTROL-TOTAL EQUATIONS
GDPFCDEF..   GDPFC_SAM =e= SUM((FACTOR,A1),TSAM(FACTOR,A1)) ;

GDPDEF..   GDP_SAM   =e= SUM((FACTOR,A1),TSAM(FACTOR,A1))+SUM((ITAX1,C1),TSAM(ITAX1,C1))+SUM((ETAX1,C1),TSAM(ETAX1,C1))
                                     + SUM((TF,A1),TSAM(TF,A1))+SUM(A1,TSAM('171_PRODTAX',A1))+SUM((FTAX,A1),TSAM(FTAX,A1))  ;

A_MAT.lo(INT,JNT)$nonzero(INT,JNT)           = 0;
A_MAT.up(INT,JNT)$nonzero(INT,JNT)          = 1;
A_MAT.fx(INT,JNT)$(not nonzero(INT,JNT))  = 0;

TSAM.lo(INT,JNT) = 0.0;
TSAM.up(INT,JNT) = +inf;
TSAM.fx(INT,JNT)$(not nonzero(INT,JNT)) = 0;
*TSAM.fx(INT,JNT)$(not nonzero(INT,JNT) and not (INT = "173_GOVT" or JNT = "173_GOVT")) = 0;

* Set target column sums, X. If these are not fixed, then the column sum
* constraints will not be binding and the solution values or ERR1 will be 0.
X.fx(INT) = TARGET0(INT);

* Fix Macro aggregates.
* If these are not fixed, then the macro constraints will not be binding
* and the solution values of ERR2 will be zero.
GDP_SAM.fx   = GDP0;
GDPFC_SAM.fx = GDPFC0;

Model SAMENTROP / all /;

option iterLim = 5000, limRow = 0, limCol = 0, solPrint = on;

* SAMENTROP.optFile   = 1;
  SAMENTROP.holdFixed = 1;
 option nlp          = CONOPT4;
* SAMENTROP.workSpace = 25.0;

solve SAMENTROP using nlp minimizing dentropy;

$ONTEXT
*=================================================================================
Alias (macro,a_macro), (INT,a_INT), (JNT,a_JNT);

Variable
   m_SAMEQ(A)        'multiplier for row and column sum constraint'
   m_SAMMAKE(A,B)    'multiplier for make SAM flows constraint'
   m_ROWSUM(A)       'multiplier for row target constraint'
   m_COLSUM(B)       'multiplier for column target constraint'
*   m_GDPFCDEF        'multiplier for GDP at factor cost constraint'
*   m_GDPDEF          'multiplier for GDP at market pricesconstraint'
;

* EQUATIONS FOR THE FIRST ORDER CONDITIONS
* FOR MINIMIZING THE OBJECTIVE FUNCTION
Equation
   d_A(a_INT,a_JNT)      'FOC wrt the choice variable A'
   d_TSAM(a_INT,a_JNT)   'FOC wrt the variable TSAM'
   d_Y(a_INT)           'FOC wrt the variable Y'
   d_X(a_INT)           'FOC wrt the variable X'
*   d_GDPFC             'FOC wrt the macro control variable GDPFC'
*   d_GDP               'FOC wrt the macro control variable GDP'
;

* EQUATION: FOC wrt the choice variable A
d_A(a_INT,a_JNT)..
       ((log(A_MAT(a_INT,a_JNT) + epsilon) - log(abar1(a_INT,a_JNT)  + epsilon))
       $(nonzero(a_INT,a_JNT)) + a_MAT(a_INT,a_JNT)*(1/(a_MAT(a_INT,a_JNT) + epsilon))
       $(nonzero(a_INT,a_JNT)))
    -  sum((INT,JNT)$(nonzero(INT,JNT)), m_sammake(INT,JNT)*(-(1$((sameas
       (a_INT,INT) and sameas(a_JNT,JNT))))*(x(JNT))))
   =e= 0;

* EQUATION: FOC wrt the variable TSAM
d_TSAM(a_INT,a_JNT)..
*    -  m_gdpfcdef*(-(1$((sameas(a_INT,"fac") and sameas(a_JNT,"act")))))
    -  m_colsum(a_JNT)
*    -  m_gdpdef*(-(1$((sameas(a_INT,"fac") and sameas(a_JNT,"act")))
*       +1$((sameas(a_INT,"gre") and sameas(a_JNT,"act"))) - (1$((sameas
*       (a_INT,"act") and sameas(a_JNT,"gre"))))+1$((sameas(a_INT,"gre")
*       and sameas(a_JNT,"com")))))
    -  m_rowsum(a_INT)$((not sameas(a_INT,"173_GOVT")))
    -  m_sammake(a_INT,a_JNT)$(nonzero(a_INT,a_JNT))
   =e= 0;

* EQUATION: FOC wrt the variable Y
d_Y(a_INT)..
    -  m_sameq(a_INT)
    -  sum((INT)$((not sameas(INT,"173_GOVT"))),m_rowsum(INT)*(-(1$((sameas(a_INT,INT))))))
   =e= 0;

* EQUATION FOC wrt the variable X
d_X(a_INT)..
    -  sum(JNT, m_colsum(JNT)*(-(1$((sameas(a_INT,JNT))))))
    -  sum(INT, m_sameq(INT) *(-(1$((sameas(a_INT,INT))))))
    -  sum((INT,JNT)$(nonzero(INT,JNT)), m_sammake(INT,JNT)*(-a_MAT(INT,JNT)*(1$((sameas(a_INT,JNT))))))
   =e= 0;

* EQUATION: FOC wrt the macro control variable GDPFC
*d_GDPFC..
*   - m_gdpfcdef =e= 0;

* EQUATION: FOC wrt the macro control variable GDP
*d_GDP..
*   - m_gdpdef =e= 0;

* DEFINE MODEL
* In GAMS the "." is used for pairing the complementarity variables
* and equations for the MCP solver. For example the equation
* defined by d_A is complementary to the variable A and must be
* defined over the same sets.
Model m_SAMENTROP / d_A.A_MAT, d_TSAM.TSAM
                    d_Y.Y
                    d_X.X
                    COLSUM.m_COLSUM
                    SAMEQ.m_SAMEQ
                    ROWSUM.m_ROWSUM
                    SAMMAKE.m_SAMMAKE
*                    d_GDPFC.GDPFC
*                    d_GDP.GDP
*                    GDPFCDEF.m_GDPFCDEF

*                    GDPDEF.m_GDPDEF
 /;

* SOLVE MODEL
* Shock the NLP solution
A_MAT.l(INT,JNT) = 0.9*A_MAT.l(INT,JNT);

solve m_SAMENTROP using mcp;
$OFFTEXT

execute_unload "SAM_BAL" ;

$exit

* Parameters for reporting results
Parameter
   Macsam1(A,B)  'assigned new balanced SAM flows from CE'
   Macsam2(A,B)  'balanced SAM flows from entropy diff x scalesam'
   SEM           'squared error measure'
   percent1(A,B) 'percent change of new SAM from original SAM'
   PosUnbal(A,B) 'positive unbalanced SAM'
   PosBalan(A,B) 'positive balanced SAM'
   Diffrnce(A,B) 'differnce btw original SAM and final SAM in values'
   NormEntrop    'normalized entropy a measure of total uncertainty';

macsam1(INT,JNT)      = TSAM.l(INT,JNT);
macsam1("175_TOT",JNT)     = sum(INT, macsam1(INT,JNT));
macsam1(INT,"175_TOT")     = sum(JNT, macsam1(INT,JNT));
macsam2(A,B)            = macsam1(A,B)*scalesam;
SEM                     = sum((INT,JNT), sqr(A_MAT.L(INT,JNT) - Abar1(INT,JNT)))/sqr(card(INT));
percent1(A,B)$(T1(A,B)) = 100*(macsam1(A,B) - T1(A,B))/T1(A,B);
PosUnbal(A,B)           = T1(A,B) * scalesam;
PosBalan(A,B)           = macsam2(A,B);
Diffrnce(A,B)           = PosBalan(A,B) - PosUnbal(A,B);
NormEntrop              = sum((INT,JNT)$(Abar1(INT,JNT)), A_MAT.l(INT,JNT)*log(A_MAT.l(INT,JNT)))
                        / sum((INT,JNT)$(Abar1(INT,JNT)), Abar1(INT,JNT)*log(Abar1(INT,JNT)));

display macsam1, macsam2, percent1, sem, dentropy.l, PosUnbal, PosBalan, NormEntrop, Diffrnce;

* Return negative flows to initial cell position
macsam1(INT,JNT)      = macsam1(INT,JNT) + redsam(INT,JNT);
macsam1("175_TOT",JNT) = sum(INT, macsam1(INT,JNT));
macsam1(INT,"175_TOT") = sum(JNT, macsam1(INT,JNT));
macsam2(A,B)        = macsam1(A,B)*scalesam;
*gdp00               = macsam1("fac","act") + macsam1("gre","act")
*                    - macsam1("act","gre") + macsam1("gre","com");

*display macsam1, macsam2, gdp0, gdp00, gdp.l, gdpfc0, gdpfc.l;

*Parameter ANEW(i,j);

* print some stuff
*ANEW("total",jj)  = sum(ii, A.l(ii,jj));
*ANEW(ii,"total")  = sum(jj, A.l(ii,jj));
*ABAR1("total",jj) = sum(ii, ABAR1(ii,jj));
*ABAR1(ii,"total") = sum(jj, ABAR1(ii,jj));

*display ANEW, ABAR1;


* Use the following code to specify that the column sums are known
* exactly. The errors are thus fixed to zero and two equations are
* dropped from the estimation procedure. The computational gains are
* that the constraints are all linear and the estimation problem is
* considerably smaller.

execute_unload "SAM_BAL_PRK" ;

$EXIT
