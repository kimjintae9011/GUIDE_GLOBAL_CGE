 511  *==============================================================================
 512  *   3.1.2 Rescaling the variables
 513  *==============================================================================
 514  * GTAP 8.1 data are in millions of (2004 and 2007) US dollars
 515  * (see www.gtap.agecon.purdue.edu/resources/download/5679.pdf)
 516  * With RES = 10000, model results are in tens of billions (10G$)
 517  RES              = 10000;
 518  *RES = 1;
 519  * NOTE: In GTAP parlance, "agents' prices" are prices paid by buyers, and
 520  *       "market prices" are prices received by sellers.
 521   
 522  * Household consumption = GTAP domestic purchases (VDPA) + import purchases (VIPA)
 523  * by households at agents' prices.
 524  CO(i,z)          = CO(i,z)/RES;
 525   
 526  * Public final consumption = domestic purchases (VDGA) + import purchases (VIGA)
 527  * by government at agents' prices.
 528  CGO(i,z)         = CGO(i,z)/RES;
 529   
 530  * Domestic purchases = domestic absorption:
 531  * (CO + CGO + INVO + DIO) - [ imports (IMO) + transport margins (tmrg)
 532  *                              + indirect taxes (TICO + TIMO) ]
 533  DDO(i,z)         = DDO(i,z)/RES;
 534   
 535  * Capital depreciation (DEP)
 536  DEPO(z)          = DEPO(z)/RES;
 537   
 538  * Intermediate consumption = domestic purchases (VDFA) + import purchases (VIFA)
 539  * by firms belonging to sectors other than CGDS, at agents' prices.
 540  DIO(i,j,z)       = DIO(i,j,z)/RES;
 541   
 542  * Domestic supply = domestic demand (DDO) in GTAP_AGG.gms
 543  DSO(j,i,z)        = DSO(j,i,z)/RES;
 544  DSO_I(i,z)        = DSO_I(i,z)/RES;
 545   
 546  * Exports = exports at world prices (VXWD) = imports at world prices
 547  * Note: the GTAP variable VXWD is NOT used in the DATA_AGG.gms program; the
 548  * value recorded in DATA_AGG.gdx is actually identical to IMO
 549  EXO(i,z,zj)      = EXO(i,z,zj)/RES;
 550   
 551  * Imports = imports at world prices (VIWS) - sum of transport margins on imports (VTWR)
 552  IMO(i,z,zj)      = IMO(i,z,zj)/RES;
 553   
 554  * Demand for investment purposes = domestic purchases (VDFA)+ import purchases (VIFA)
 555  * by firms of the CGDS sector at agents' prices.
 556  INVO(i,z)        = INVO(i,z)/RES;
 557   
 558  * Total capital stock at the beginning of the period (VKB)
 559  KSTO(z)          = KSTO(z)/RES;
 560   
 561  * Labor demand = Remuneration of labor at market prices, before taxes
 562  * (components of VFM, "primary factor purchases, by households, at market prices")
 563  LDO(l,j,z)       = LDO(l,j,z)/RES;
 564   
 565  * Supply of transport margins at market prices (VST), adjusted proportionately
 566  * so that MRGNO = sum of tmrg for every margin commodity
 567  MRGNO(i,z)       = MRGNO(i,z)/RES;
 568   
 569  * Remuneration of capital at market prices, before taxes
 570  * (components of VFM, "primary factor purchases, by households, at market prices")
 571  RKDO(k,j,z)      = RKDO(k,j,z)/RES;
 572   
 573  * Direct taxes = factor payment at market prices (VFM)
 574  *                - primary factor sales at agents' prices (EVOA)
 575  TDHO(z)          = TDHO(z)/RES;
 576   
 577  * Domestic taxes on commodities = demand at agents' prices - demand at market prices:
 578  * Include 6 pairs of GTAP components
 579  *       VDPA - VDPM
 580  *       VIPA - VIPM
 581  *       VDGA - VDGM
 582  *       VIGA - VIGM
 583  *       VDFA - VDFM
 584  *       VIFA - VIFM
 585  TICO(i,z)        = TICO(i,z)/RES;
 586   
 587  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 588  *                                     - factor-based subsidies (FBEP).
 589  TIKO(k,j,z)      = TIKO(k,j,z)/RES;
 590   
 591  * Import duties = "ordinary" import duties (TFRV)
 592  TIMO(i,z,zj)     = TIMO(i,z,zj)/RES;
 593   
 594  * Taxes on production = MINUS "ordinary output subsidies" (OSEP)
 595  TIPO(j,z)        = TIPO(j,z)/RES;
 596   
 597  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 598  *                                     - factor-based subsidies (FBEP).
 599  TIWO(l,j,z)      = TIWO(l,j,z)/RES;
 600   
 601  * Taxes on exports = export tax equivalent of the Multi-Fiber Agreement (MFA)
 602  * quota premium(MFRV) + "ordinary" export taxes (XTRV)
 603  TIXO(i,z,zj)     = TIXO(i,z,zj)/RES;
 604   
 605  * Transport margins at world prices = sum of margins on imports (VTWR)
 606  tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj)/RES;
 607   
 608  * Domestic output = domestic supply (DSO) + supply of transport margins (MRGNO)
 609  *                   + exports (EXO) - taxes on exports (TIXO)
 610   
 611  XSO_I(i,z)        = XSO_I(i,z)/RES;
 612  XSO(j,i,z)        = XSO(j,i,z)/RES;
 613  XSTO(j,z)         = XSTO(j,z)/RES;
 614   
 615  *==============================================================================
 616  *  3.3 Exogenous prices and parameters
 617  *==============================================================================
 618   
 619  *  Price elasticity (should be equal to one to verify homogeneity)
 620  eta = 1;
 621   
 622  *==============================================================================
 623  * CES and CET elasticities
 624  *==============================================================================
 625  * CES elasticities are defined using GTAP8.1 data for imports
 626  * (sigma_M1 and sigma_M2) and value added (sigma_VA)
 627   
 628  * Other exogenous parameters can be defined if the Excel file VAL_PAR.XLS
 629  PARAMETER
 630  PARZ;
 631   
GDXIN   C:\Users\kimc0\GUIDE_GLOBAL_CGE\1.Static_CGE\Input_w-1\JointB_VAL_230411_PAR.gdx
--- LOAD  sigma_KD = 1:sigma_KD
--- LOAD  sigma_LD = 2:sigma_LD
--- LOAD  sigma_KLE = 3:sigma_KLE
--- LOAD  sigma_X1 = 4:sigma_X1
--- LOAD  sigma_X2 = 5:sigma_X2
--- LOAD  sigma_X3 = 6:sigma_X3
--- LOAD  sigma_X0 = 7:sigma_X0
--- LOAD  sigma_Y = 8:sigma_y
--- LOAD  PARZ = 9:PARZ
 635   
 636  *$exit
 637  *------------------------------------------------------------------------------
 638  * CES - composite capital
 639  * We assume that the elasticity between the different type of capital
 640  * is twice that used for value added.
 641  * If the user wishes to assume otherwise, he can fill the appropriate area in
 642  * the Excel file VAL_PAR.xls and delete following line:
 643   sigma_KD(j,z)   = 2*sigma_VA(j,z);
 644  * sigma_KD(j,z)   = 0.5;
 645  *------------------------------------------------------------------------------
 646  * CES - composite labor
 647  * We assume that the elasticity between the different type of labor
 648  * is twice that used for value added.
 649  * If the user wishes to assume otherwise, he can fill the appropriate area in
 650  * the Excel file VAL_PAR.xls and delete following line:
 651   sigma_LD(j,z)   = 2*sigma_VA(j,z);
 652  * sigma_LD(j,z)   = 0.5;
 653  *------------------------------------------------------------------------------
 654  * CES - composite KLE, KE, ENER
 655  * sigma_KLE(j,z)  = 0.1 ;
 656   sigma_ENER(j,z) = 0.9 ;
 657   
 658  *------------------------------------------------------------------------------
 659  * CET - total output
 660  * We arbitrarily assume that the transformation elasticity between total exports,
 661  * domestic supply and margins is equal to 2 for all sectors and all region.
 662  * If the user wishes to assume otherwise, he can fill the appropriate area in
 663  * the Excel file VAL_PAR.xls.
 664   
 665  *------------------------------------------------------------------------------
 666  * CET - exports
 667  * We arbitrarily assume that the transformation elasticity between exports
 668  * to the different partners is equal to 3 for all sectors and all region.
 669  * If the user wishes to assume otherwise, he can fill the appropriate area in
 670  * the Excel file VAL_PAR.xls.
 671   
 672  *------------------------------------------------------------------------------
 673  * LES parameters - Frisch
 674  * We assume that the Frisch parameter is -1.1 for rich regions/countries and
 675  * -1.5 for other regions/countries.
 676   frisch(zrich)   = -1.1;
 677   frisch(zother)  = -1.5;
 678   
 679  * If the user wishes to assume otherwise, he can fill the appropriate area in
 680  * the Excel file VAL_PAR.xls, delete the previous 2 lines and uncomment the
 681  * following line:
 682   frisch(z)      = PARZ(z,'frisch');
 683   
 684  *------------------------------------------------------------------------------
 685  * LES parameters - Income elasticity of consumption
 686  * We arbitrarily assume that the income elasticity between is the same for all
 687  * region/country.
 688  * If the user wishes to assume otherwise, he can fill the appropriate area in
 689  * the Excel file VAL_PAR.xls.
 690   
 691  *------------------------------------------------------------------------------
 692  *  Slopes of taxation functions
 693  *   One can either choose to assign a value to the intercept and calibrate
 694  *   the slopes accordingly, or the other way around. This type of modelling
 695  *   can be useful to take into account known marginal savings or taxation rates
 696  *   or to deal with negative average saving rates in cases where savings are
 697  *   negative for some household groups.
 698  *   When no further information is available, one can simply set the intercepts
 699  *   to zero and calibrate an average rate: this is what we do here for ttdh0O.
 700  *   If the user wishes to assume otherwise, he can fill the appropriate area in
 701  *   the Excel file VAL_PAR.xls.
 702  * ttdh0O(z)       = PARZ(z,'ttdh0O');
 703   
 704   ttdh0O(z)       = 0;
 705  *   The slope ttdh1O is calibrated below in the mane GAMS file
 706   
 707  *------------------------------------------------------------------------------
 708  *  Elasticity - Investment demand function
 709  * We arbitrarily assume that this elasticity is equal to 2 for all types of
 710  * capital, all sectors and all regions.
 711  * If the user wishes to assume otherwise, he can fill the appropriate area in
 712  * the Excel file VAL_PAR.xls.
 713   
 714  *------------------------------------------------------------------------------
 715  * Also we need to assign values to some prices
 716  * All of the prices below, EXCEPT eO, may be set at arbitrary values
 717  * without loss of generality.
 718  *
 719  * In the case of eO, although exchange rates may be given arbitrary values
 720  * in the model, they must all be equal for calibration at this stage. The reason
 721  * is that the supply of margin transport services MRGNO must equal global demand.
 722  * Since there is a single world price for international transport margins
 723  * (rather than bilateral world prices for other commodities) the unit of
 724  * measurement of the volume of margin services must be the same for all regions,
 725  * and in turn, that implies that the divisor that converts the nominal value to
 726  * volume be the same for all regions. Since that divisor involves the exchange
 727  * rate, all exchange rates must be equal.
 728   
 729  * Normally, prices that may be given arbitrary values are set at 1:
 730   eO(z)           = 1;
 731   PEO(i,z,zj)     = 1;
 732   PLO(i,z)        = 1;
 733   PWMGO(i)        = 1;
 734   WO(l,z)         = 1;
 735   
 736  *==============================================================================
 737  * 4 Calibration
 738  *==============================================================================
 739  *  4.1 Calculation of income and savings related variables and parameters
 740  *==============================================================================
 741   YHKO(z)         = SUM[(k,j),RKDO(k,j,z)];
 742   YHLO(z)         = SUM[(l,j),LDO(l,j,z)];
 743  * YHO(z)          = YHLO(z)+YHKO(z);
 744   YHO(z)          = YHLO(z)+YHKO(z);
 745   YDHO(z)         = YHO(z)-TDHO(z);
 746   CTHO(z)         = SUM[i,CO(i,z)];
 747   SHO(z)          = YDHO(z)-CTHO(z);
 748   
 749   TICTO(z)        = SUM[i,TICO(i,z)];
 750   TIMTO(z)        = SUM[(i,zj),TIMO(i,zj,z)];
 751   TIWTO(z)        = SUM[(l,j),TIWO(l,j,z)];
 752   TIKTO(z)        = SUM[(k,j),TIKO(k,j,z)];
 753   TIPTO(z)        = SUM[j,TIPO(j,z)];
 754   TIXTO(z)        = SUM[(i,zj),TIXO(i,z,zj)];
 755   TPRODNO(z)      = TIKTO(z)+TIWTO(z)+TIPTO(z);
 756   TPRCTSO(z)      = TICTO(z)+TIMTO(z)+TIXTO(z);
 757   YGO(z)          = TDHO(z)+TPRCTSO(z)+TPRODNO(z);
 758   GO(z)           = SUM[i,CGO(i,z)];
 759   SGO(z)          = YGO(z)-GO(z);
 760   
 761   YROWO(z)        = SUM[(i,zj),IMO(i,zj,z)]+SUM[(i,ij,zj),tmrg(i,ij,zj,z)];
 762   SROWO(z)        = YROWO(z)-SUM[(i,zj),EXO(i,z,zj)]-SUM[i,MRGNO(i,z)];
 763   CABO(z)         = -SROWO(z);
 764   
 765   ITO(z)          = SHO(z)+SGO(z)+SROWO(z);
 766   
 767  *==============================================================================
 768  *  4.2 Calibration of parameters and other variables
 769  *==============================================================================
 770  *  4.2.1 Calibration of investment and government spending shares
 771  *==============================================================================
 772   gamma_GVT(i,z)  = CGO(i,z)/SUM[ij,CGO(ij,z)];
 773   gamma_INV(i,z)  = INVO(i,z)/SUM[ij,INVO(ij,z)] ;
 774   
 775  *==============================================================================
 776  *  4.2.2 Calibration of other prices and revised volumes (part 1)
 777  *==============================================================================
 778   LDO(l,j,z)      = LDO(l,j,z)/WO(l,z);
 779   LDCO(j,z)       = SUM[l,LDO(l,j,z)];
 780   LSO(l,z)        = SUM[j,LDO(l,j,z)];
 781   EXO(i,z,zj)     = [EXO(i,z,zj)-TIXO(i,z,zj)]/PEO(i,z,zj);
 782   EXTO(i,z)       = SUM[zj,EXO(i,z,zj)];
 783   
 784   PWXO(i,z,zj)$EXO(i,z,zj)
 785                   = {[PEO(i,z,zj)*EXO(i,z,zj)+TIXO(i,z,zj)]/EXO(i,z,zj)}/eO(z);
 786   
 787   PETO(i,z)       = SUM[zj,PEO(i,z,zj)*EXO(i,z,zj)]/EXTO(i,z);
 788   PWMO(i,z,zj)    = PWXO(i,z,zj);
 789   IMO(i,zj,z)     = EXO(i,zj,z);
 790   IMTO(i,z)       = SUM[zj,IMO(i,zj,z)];
 791   
 792   DSO(j,i,z)       = DSO(j,i,z)/PLO(i,z);
 793   DSO_I(i,z)       = SUM(j,DSO(j,i,z));
 794   DSO_J(j,z)       = SUM(i,DSO(j,i,z));
 795   QO(i,z)         = IMTO(i,z)+DDO(i,z);
 796   
 797   MRGNO(i,z)$MRGNO(i,z)
 798                   = MRGNO(i,z)/[eO(z)*PWMGO(i)];
 799   
 800   XSO_I(i,z)      = EXTO(i,z)+DDO(i,z)+MRGNO(i,z);
 801   
 802   XSTO(j,z)       = sum(i, XSO(j,i,z));
 803   
 804   PO(i,z)        = [PETO(i,z)*EXTO(i,z)+PLO(i,z)*DSO_I(i,z)
 805                    +eO(z)*PWMGO(i)*MRGNO(i,z)]/XSO_I(i,z);
 806   
 807   PO2(j,i,z)$XSO(j,i,z) = 1;
 808   
 809   PO3(i,j,z)$XSO(j,i,z) = 1;
 810   
 811   PIO(i,z)       = SUM[j$XSO(j,i,z),PO2(J,I,z)*XSO(j,i,z)]/XSO_I(i,z);
 812   
 813   PTO(j,z)       = SUM[i$XSO(j,i,z),PO2(j,i,z)*XSO(j,i,z)]/XSTO(j,z);
 814   
 815   PPO(j,z)       = [SUM[l,TIWO(l,j,z)+WO(l,z)*LDO(l,j,z)]
 816                    +SUM[k,TIKO(k,j,z)+RKDO(k,j,z)]
 817                    +SUM[nene,DIO(nene,j,z)]+SUM[ene,DIO(ene,j,z)]]/XSTO(j,z);
 818   
 819   theta2(j,i,z) = DSO(j,i,z)/sum(jj, DSO(jj,i,z));
 820   
 821   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z)*EXTO(i,z);
 822   
 823  *==============================================================================
 824  *  4.3 Calibration of tax rates, margins, prices and volumes
 825  *==============================================================================
 826  *  4.3.1 Margin rates and tax rates
 827  *==============================================================================
 828   ttixO(i,z,zj)   = [eO(z)*PWXO(i,z,zj)/PEO(i,z,zj)]-1;
 829   tticO(i,z)      = TICO(i,z)/{PLO(i,z)*DDO(i,z)
 830                     +SUM[zj,IMO(i,zj,z)*eO(z)*PWMO(i,zj,z)
 831                     +TIMO(i,zj,z)+SUM[ij,tmrg(ij,i,zj,z)]]};
 832   
 833   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
 834                   = tmrg(i,ij,zj,z)/(PWMGO(i)*eO(z)*IMO(ij,zj,z));
 835   
 836   ttimO(i,zj,z)$IMO(i,zj,z)
 837                   = TIMO(i,zj,z)/{IMO(i,zj,z)*eO(z)*(PWMO(i,zj,z)
 838                    +SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])};
 839   
 840   ttiwO(l,j,z)$LDO(l,j,z)
 841                   = TIWO(l,j,z)/[WO(l,z)*LDO(l,j,z)];
 842   
 843   ttikO(k,j,z)$RKDO(k,j,z)
 844                   = TIKO(k,j,z)/RKDO(k,j,z);
 845   
 846   ttipO(j,z)      = [PTO(j,z)/PPO(j,z)]-1;
 847   
 848   ttdh1O(z)       = [TDHO(z)-ttdh0O(z)]/YHO(z);
 849   
 850  *==============================================================================
 851  *  4.3.2 Calibration of other prices and revised volumes (part 2)
 852  *==============================================================================
 853   PDO(i,z)        = PLO(i,z)*(1+tticO(i,z));
 854   PMO(i,zj,z)     = eO(z)*(PWMO(i,zj,z)+SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])
 855                   *(1+ttimO(i,zj,z))*(1+tticO(i,z));
 856   PMTO(i,z)       = SUM[zj,PMO(i,zj,z)*IMO(i,zj,z)]/IMTO(i,z);
 857   PCO(i,z)        = [PMTO(i,z)*IMTO(i,z)+PDO(i,z)*DDO(i,z)]/QO(i,z);
 858   
 859   CO(i,z)         = CO(i,z)/PCO(i,z);
 860   CGO(i,z)        = CGO(i,z)/PCO(i,z);
 861   DIO(nene,j,z)   = DIO(nene,j,z)/PCO(nene,z);
 862   DEO(ene,j,z)    = DIO(ene,j,z)/PCO(ene,z);
 863   INVO(i,z)       = INVO(i,z)/PCO(i,z);
 864   
 865   CIO(j,z)        = SUM[nene,DIO(nene,j,z)];
 866   CEO(j,z)        = SUM[ene,DEO(ene,j,z)];
 867   
 868   DITO(nene,z)     = SUM[j,DIO(nene,j,z)];
 869   DITO(ene,z)      = SUM[j,DEO(ene,j,z)];
 870   
 871   PO4(ene,j,z)    = PCO(ene,z);
 872   
 873   PCIO(j,z)       = SUM[nene,PCO(nene,z)*DIO(nene,j,z)]/CIO(j,z);
 874   PCEO(j,z)       = SUM[ene,PCO(ene,z)*DEO(ene,j,z)]/CEO(j,z) ;
 875   
 876   WTIO(l,j,z)     = WO(l,z)*(1+ttiwO(l,j,z));
 877   
 878   WCO(j,z)$LDCO(j,z)
 879                   = SUM[l,WTIO(l,j,z)*LDO(l,j,z)]/LDCO(j,z);
 880   
 881  *==============================================================================
 882  *  4.3.3 Calibration of other prices and revised volumes (part 3)
 883  *==============================================================================
 884  * The price of capital is arbitrary:
 885   PKO(z) = 1;
 886   
 887  * The calibration of depreciation rates is based on two hypotheses:
 888  * 1. The rate of depreciation is the same for all types of capital and all
 889  *    industries in each region (this hypothesis is made to accommodate the fact
 890  *    that, in the GTAP data base, capital consumption allowance is not detailed;
 891  *    as a matter of fact, the GTAP capital consumption allowance is set at
 892  *    4% of the value of the capital stock).
 893  * 2. The rental rate of capital is uniform across industries and types of
 894  *    capital in each region.
 895  * These hypotheses lead to the following formula:
 896   
 897  * From GTAP, we know KSTO.
 898   KSTO(z)         = KSTO(z)/PKO(z);
 899   
 900  * Assuming a uniform depreciation rate for all types
 901  * of capital and all industries:
 902   delta(z)        = DEPO(z)/[PKO(z)*KSTO(z)];
 903   
 904  display delta, DEPO, PKO, KSTO ;
 905  *$EXIT
 906  * From GTAP, we know KSTO. Assuming a uniform rental rate R for all types
 907  * of capital and all industries:
 908   RKO(k,z)        = SUM[(kj,jj),RKDO(kj,jj,z)]/KSTO(z);
 909   RKO(k,z)        =1;
 910   
 911   RO(k,j,z)$RKDO(k,j,z)
 912                   = RKO(k,z);
 913   
 914  * Then from the GTAP value of income paid to capital RKD we calibrate KDO:
 915   KDO(k,j,z)$RKDO(k,j,z)
 916                   = RKDO(k,j,z)/RO(k,j,z);
 917   
 918  * The supply of capital is equal to demand:
 919   KSO(k,z)        = SUM[j,KDO(k,j,z)];
 920   
 921   A_K(z)          = 1/PKO(z)*{PROD[i$gamma_INV(i,z),(PCO(i,Z)/gamma_INV(i,z))
 922                     **gamma_INV(i,z)]};
 923   
 924   KDCO(j,z)       = SUM[k,KDO(k,j,z)];
 925   RTIO(k,j,z)     = RO(k,j,z)*(1+ttikO(k,j,z));
 926   RCO(j,z)$KDCO(j,z)
 927                   = SUM[k,RTIO(k,j,z)*KDO(k,j,z)]/KDCO(j,z);
 928   
 929  *==============================================================================
 930  *  4.3.4 Calibration of other prices and revised volumes (part 4)
 931  *==============================================================================
 932   VAO(j,z)        = LDCO(j,z)+KDCO(j,z);
 933   
 934   PVAO(j,z)       = [WCO(j,z)*LDCO(j,z)+RCO(j,z)*KDCO(j,z)]/VAO(j,z);
 935   
 936  * PIXGDPO is tautologically equal to 1, based on its formula
 937  * PIXGDPO(z)      = {SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
 938  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
 939  *                   *SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
 940  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]}**0.5;
 941   PIXGDPO(z)      = 1;
 942   
 943  * PIXGDP_WO is tautologically equal to 1, based on its formula
 944  * PIXGDP_WO       = {SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
 945  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
 946  *                   *SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
 947  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]/eO(z)}**0.5;
 948   PIXGDP_WO       = 1;
 949   
 950  * PIXCONO(z) is tautologically equal to 1, based on its formula
 951  * PIXCONO(z)      = SUM[i,PCO(i,z)*CO(i,z)]
 952  *                  /SUM[i,PCO(i,z)*CO(i,z)];
 953   PIXCONO(z)      = 1;
 954   
 955  * PIXINVO(z) is tautologically equal to 1, based on its formula
 956  * PIXINVO(z)      = PROD[i$gamma_INV(i,z),(PCO(i,z)/PCO(i,z))**gamma_INV(i,z)];
 957   PIXINVO(z)      = 1;
 958   
 959  * PIXGVTO(z) is tautologically equal to 1, based on its formula
 960  * PIXGVTO(z)      = PROD[i$gamma_GVT(i,z),(PCO(i,z)/PCO(i,z))**gamma_GVT(i,z)];
 961   PIXGVTO(z)      = 1;
 962   
 963  *==============================================================================
 964  *  4.4 Calibration of function parameters
 965  *==============================================================================
 966  *   4.4.1 Leontief functions
 967  *==============================================================================
 968   io(j,z)         = CIO(j,z)/XSTO(j,z) ;
 969   
 970   io2(j,z)        = CEO(j,z)/XSTO(j,z) ;
 971   
 972   v(j,z)          = VAO(j,z)/XSTO(j,z) ;
 973   
 974   v2(j,z)         = (CEO(j,z)+VAO(j,z))/XSTO(j,z) ;
 975   
 976   aij(nene,j,z)   = DIO(nene,j,z)/CIO(j,z);
 977  * aij2(ene,j,z)   = DIO(ene,j,z)/CEO(j,z);
 978   aij2(ene,j,z)   = DEO(ene,j,z)/CEO(j,z);
 979   
 980  *==============================================================================
 981  *   4.4.2 Calibration of CET parameters
 982  *==============================================================================
 983  *    4.4.2.0 CET between total exports and local production
 984  *==============================================================================
 985  * rho_X0(j,z)       = (1+sigma_X0(j,z))/sigma_X0(j,z);
 986   
 987  * beta_X0(j,i,z)$XSO(j,i,z)
 988  *                 = PO2(j,i,z)*XSO(j,i,z)**(1-rho_X0(j,z))/
 989  *                   SUM[ij$XSO(j,ij,z),PO2(j,ij,z)*XSO(j,ij,z)**(1-rho_X0(j,z))];
 990   
 991  * B_X0(j,z)       = XSTO(j,z)
 992  *                  /SUM[ij$XSO(j,ij,z),beta_X0(j,ij,z)*XSO(j,ij,z)**rho_X0(j,z)
 993  *                  ]**(1/rho_X0(j,z));
 994   
 995  *sigma_X1(i,z) = 1;
 996  *==============================================================================
 997  *    4.4.2.1 CET between total exports, domestic supply and margins
 998  *==============================================================================
 999   rho_X1(i,z)     = (1+sigma_X1(i,z))/sigma_X1(i,z);
1000   
1001   beta_EX_X1(i,z)$MRGNO(i,z)
1002                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1003                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1004                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1005                     eO(z)*PWMGO(i)*MRGNO(i,z)$MRGNO(i,z)**(1-rho_X1(i,z))+Tiny];
1006   
1007   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1008                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1009                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1010                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+Tiny];
1011   
1012   beta_D_X1(i,z)$MRGNO(i,z)
1013                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1014                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1015                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1016                     eO(z)*PWMGO(i)*MRGNO(i,z)**(1-rho_X1(i,z))];
1017   
1018   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1019                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1020                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1021                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1022   
1023   B_X1(i,z)       = XSO_I(i,z)/[beta_EX_X1(i,z)*EXTO(i,z)**rho_X1(i,z)
1024                    +beta_D_X1(i,z)*DSO_I(i,z)**rho_X1(i,z)+(1-beta_EX_X1(i,z)
1025                    -beta_D_X1(i,z))*MRGNO(i,z)**rho_X1(i,z)]**(1/rho_X1(i,z));
1026   
1027  *==============================================================================
1028  *    4.4.2.2 CET between exports to different trading partners
1029  *==============================================================================
1030   rho_X2(i,z)     = (1+sigma_X2(i,z))/sigma_X2(i,z);
1031   
1032   beta_X2(i,z,zj)$EXO(i,z,zj)
1033                   = [PEO(i,z,zj)*EXO(i,z,zj)**(1-rho_X2(i,z))]/
1034                     SUM[zjj$EXO(i,z,zjj),PEO(i,z,zjj)*EXO(i,z,zjj)
1035                     **(1-rho_X2(i,z))];
1036   B_X2(i,z)       = EXTO(i,z)/{SUM[zj,beta_X2(i,z,zj)*EXO(i,z,zj)**rho_X2(i,z)]
1037                     **(1/rho_X2(i,z))};
1038   
1039  display IMO, EXO, rho_X2, PEO ;
1040  *$exit
1041   
1042  *==============================================================================
1043  *   4.4.3 Calibration of CES parameters
1044  *==============================================================================
1045  *    4.4.3.0 Composite output
1046  *==============================================================================
1047   rho_X3(i,z)   = (1-sigma_X3(i,z))/sigma_X3(i,z);
1048   
1049   beta_X3(j,i,z)$XSO(j,i,z)
1050                 = [PO2(j,i,z)*XSO(j,i,z)**(1+rho_X3(i,z))]/
1051                     SUM[jj$XSO(jj,i,z),PO2(jj,i,z)*XSO(jj,i,z)**(1+rho_X3(i,z))];
1052   
1053   B_X3(i,z)     = XSO_I(i,z)
1054                    /SUM[jj$XSO(jj,i,z),beta_X3(jj,i,z)*XSO(jj,i,z)**(-rho_X3(i,z))
1055                    ]**(-1/rho_X3(i,z));
1056   
1057   POWERQO(Z) = SUM(POWER, XSO(power,'18_ELEC',z));
1058   
1059  * sigma_X4(z) = 1.5;
1060   
1061   sigma_X4(z) = 2;
1062   
1063   
1064   rho_X4(z)   = (1-sigma_X4(z))/sigma_X4(z);
1065   
1066   beta_X4(power,z)
1067                 = [PO2(power,'18_ELEC',z)*XSO(power,'18_ELEC',z)**(1+rho_X4(z))]/
1068                     SUM[power2$XSO(power2,'18_ELEC',z),PO2(power2,'18_ELEC',z)*XSO(power2,'18_ELEC',z)**(1+rho_X4(z))];
1069   
1070   B_X4(z)     = POWERQO(Z)
1071                    /SUM[power2$XSO(power2,'18_ELEC',z),beta_X4(power2,z)*XSO(power2,'18_ELEC',z)**(-rho_X4(z))
1072                    ]**(-1/rho_X4(z));
1073   
1074   TnDShare(z) = XSO('18_TnD','18_ELEC',z) / XSO_I('18_ELEC',z);
1075   
1076   PPOWERO(z) = 1;
1077   
1078  *==============================================================================
1079  *    4.4.3.1 Composite good
1080  *==============================================================================
1081   rho_M1(i,z)     = (1-sigma_m1(i,z))/sigma_m1(i,z);
1082   beta_M1(i,z)    = PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)/
1083                    {PDO(i,z)*DDO(i,z)**(rho_M1(i,z)+1)
1084                    +PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)};
1085   B_M1(i,z)       = QO(i,z)/{beta_M1(i,z)*IMTO(i,z)**(-rho_M1(i,z))
1086                    +(1-beta_M1(i,z))*DDO(i,z)**(-rho_M1(i,z))}**(-1/rho_M1(i,z));
1087   
1088  *==============================================================================
1089  *    4.4.3.2 CES between imports from different trading partners
1090  *==============================================================================
1091   rho_M2(i,z)     = (1-sigma_M2(i,z))/sigma_M2(i,z);
1092   beta_M2(i,zj,z)$IMO(i,zj,z)
1093                   = [PMO(i,zj,z)*IMO(i,zj,z)**(rho_M2(i,z)+1)]/
1094                     SUM[zjj$IMO(i,zjj,z),PMO(i,zjj,z)*IMO(i,zjj,z)
1095                      **(rho_M2(i,z)+1)];
1096   B_M2(i,z)       = IMTO(i,z)/{SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*IMO(i,zj,z)
1097                     **(-rho_M2(i,z))]**(-1/rho_M2(i,z))};
1098   
1099  *==============================================================================
1100  *    4.4.3.3 Composite capital
1101  *==============================================================================
1102   rho_KD(j,z)     = (1-sigma_KD(j,z))/sigma_KD(j,z);
1103   
1104   beta_KD(k,j,z)$KDO(k,j,z)
1105                   = [RTIO(k,j,z)*KDO(k,j,z)**(1+rho_KD(j,z))]/
1106                     SUM[kj$KDO(kj,j,z),RTIO(kj,j,z)*KDO(kj,j,z)**(1+rho_KD(j,z))];
1107   B_KD(j,z)$KDCO(j,z)
1108                   = KDCO(j,z)/{SUM[k$KDO(k,j,z),beta_KD(k,j,z)*KDO(k,j,z)
1109                     **(-rho_KD(j,z))]**(-1/rho_KD(j,z))};
1110   
1111  *==============================================================================
1112  *    4.4.3.4 Composite labor
1113  *==============================================================================
1114   rho_LD(j,z)     = (1-sigma_LD(j,z))/sigma_LD(j,z);
1115   beta_LD(l,j,z)$LDO(l,j,z)
1116                   = [WTIO(l,j,z)*LDO(l,j,z)**(1+rho_LD(j,z))]/
1117                     SUM[lj$LDO(lj,j,z),WTIO(lj,j,z)*LDO(lj,j,z)
1118                     **(1+rho_LD(j,z))];
1119   B_LD(j,z)$LDCO(j,z)
1120                   = LDCO(j,z)/{SUM[l$LDO(l,j,z),beta_LD(l,j,z)*LDO(l,j,z)
1121                     **(-rho_LD(j,z))]**(-1/rho_LD(j,z))};
1122   
1123  *===============================================================================
1124  *   Composite E
1125  *===============================================================================
1126   rho_ENER(j,z)   = (1-sigma_ENER(j,z))/sigma_ENER(j,z);
1127   
1128   beta_ENER(ene,j,z)$DEO(ene,j,z)
1129                   = [PO4(ene,j,z)*DEO(ene,j,z)**(1+rho_ENER(j,z))]/
1130                     SUM[ene2$DIO(ene,j,z),DEO(ene2,j,z)**(1+rho_ENER(j,z))];
1131   
1132   B_ENER(j,z)$CEO(j,z)
1133                   = CEO(j,z)/{SUM[ene$DEO(ene,j,z),beta_ENER(ene,j,z)*DEO(ene,j,z)
1134                     **(-rho_ENER(j,z))]**(-1/rho_ENER(j,z))};
1135   
1136  *==============================================================================
1137  *    4.4.3.5 Value added
1138  *==============================================================================
1139   sigma_VA('10_PETROLCOAL',z) = 1.260;
1140   rho_VA(j,z)     = (1-sigma_VA(j,z))/sigma_VA(j,z);
1141   
1142  display rho_VA, sigma_VA ;
1143   
1144   beta_VA(j,z)$KDCO(j,z)
1145                   = WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)/
1146                    {WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)+
1147                     RCO(j,z)*KDCO(j,z)**(rho_VA(j,z)+1)};
1148   B_VA(j,z)$KDCO(j,z)
1149                   = VAO(j,z)
1150                     /{[beta_VA(j,z)*LDCO(j,z)**(-rho_VA(j,z))+
1151                     (1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
1152                     ]**(-1/rho_VA(j,z))};
1153   
1154  *                   /{[(1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
1155  *                   ]**(-1/rho_VA(j,z))};
1156   
1157  *$exit
1158  *==============================================================================
1159  *    Composite KLE
1160  *==============================================================================
1161   KLEO(j,z)       = CEO(j,z) + VAO(j,z) ;
1162   
1163   PKLEO(j,z)      = [PCEO(j,z)*CEO(j,z)+PVAO(j,z)*VAO(j,z)]/KLEO(j,z);
1164   
1165   rho_KLE(j,z)    = (1-sigma_KLE(j,z))/sigma_KLE(j,z);
1166   
1167   beta_KLE(j,z)$KLEO(j,z)
1168                   = PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)/
1169                    {PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)+
1170                     PCEO(j,z)*CEO(j,z)**(rho_KLE(j,z)+1)};
1171   
1172   B_KLE(j,z)$KLEO(j,z)
1173                   = KLEO(j,z)
1174                     /{[beta_KLE(j,z)*VAO(j,z)**(-rho_KLE(j,z))+
1175                     (1-beta_KLE(j,z))*CEO(j,z)**(-rho_KLE(j,z))
1176                     ]**(-1/rho_KLE(j,z))};
1177   
1178  *==============================================================================
1179  *   4.4.4 Calibration of LES parameters
1180  *==============================================================================
1181  *   As the assigned values of income elasticities may not result in
1182  *   consumption shares that add up to 1, this first step
1183  *   adjusts the elasticities proportionally
1184   sigma_Y(i,z)    = sigma_Y(i,z)/{SUM[ij,sigma_Y(ij,z)*PCO(ij,z)*CO(ij,z)]
1185                     /CTHO(z)};
1186   gamma_LES(i,z)  = PCO(i,z)*CO(i,z)*sigma_Y(i,z)/CTHO(z);
1187   CMINO(i,z)      = CO(i,z)+gamma_LES(i,z)*CTHO(z)/{PCO(i,z)*frisch(z)};
1188   
1189  *==============================================================================
1190  *  4.5 Calibration of gross domestic products
1191  *==============================================================================
1192   GDP_BPO(z)      = SUM[j,PVAO(j,z)*VAO(j,z)]+TIPTO(z);
1193   GDP_MPO(z)      = GDP_BPO(z)+TPRCTSO(z);
1194   GDP_IBO(z)      = SUM[(l,j),WO(l,z)*LDO(l,j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1195                     +TPRODNO(z)+TPRCTSO(z);
1196   GDP_FDO(z)      = SUM[i,PCO(i,z)*(CO(i,z)+CGO(i,z)+INVO(i,z))]
1197                    +eO(z)*SUM[(i,zj),PWXO(i,z,zj)*EXO(i,z,zj)]
1198                    +eO(z)*SUM[i,PWMGO(i)*MRGNO(i,z)]
1199                    -eO(z)*SUM[(i,zj),IMO(i,zj,z)*(PWMO(i,zj,z)
1200                    +SUM{ij,PWMGO(ij)*tmrg(ij,i,zj,z)})];
1201   GDP_BP_WO       = SUM[z,GDP_BPO(z)/eO(z)];
1202   
1203  *==============================================================================
1204  *  4.5 Calibration of real (volume) variables computed from price indices
1205  *==============================================================================
1206   CABXO(z)        = CABO(z)/[PIXGDP_WO*eO(z)];
1207   CTH_REALO(z)    = CTHO(z)/PIXCONO(z);
1208   G_REALO(z)      = GO(z)/PIXGVTO(z);
1209   GDP_BP_REALO(z) = GDP_BPO(z)/PIXGDPO(z);
1210   GDP_BP_W_REALO  = GDP_BP_WO/PIXGDP_WO;
1211   GDP_MP_REALO(z) = GDP_MPO(z)/PIXCONO(z);
1212   IT_REALO(z)     = ITO(z)/PIXINVO(z);
1213   
1214  *==============================================================================
1215  *  4.7 Parameters of the household savings function
1216  *==============================================================================
1217   sh1O(z)         = [SHO(z)+SGO(z)]/GDP_IBO(z);
1218   sh0O(z)         = SHO(z)-sh1O(z)*YDHO(z);
1219   
1220  *==============================================================================
1221  *  4.8 Calibration of indexed transfers and parameters
1222  *==============================================================================
1223   ttdh0O(z)       = ttdh0O(z)/PIXCONO(z)**eta;
1224   sh0O(z)         = sh0O(z)/PIXCONO(z)**eta;
1225   
1226  *==============================================================================
1227  *  4.9 CO2 emission
1228  *==============================================================================
