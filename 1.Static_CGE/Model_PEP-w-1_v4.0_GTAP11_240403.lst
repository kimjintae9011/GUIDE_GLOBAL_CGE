--- LOAD  CO = 14:CO
--- LOAD  CGO = 15:CGO
--- LOAD  DDO = 16:DDO
--- LOAD  DEPO = 17:DEPO
--- LOAD  DIO = 18:DIO
--- LOAD  DSO = 19:DSO
--- LOAD  DSO_I = 20:DSO_I
--- LOAD  EXO = 21:EXO
--- LOAD  IMO = 22:IMO
--- LOAD  INVO = 23:INVO
--- LOAD  KSTO = 24:KSTO
--- LOAD  LDO = 25:LDO
--- LOAD  MRGNO = 26:MRGNO
--- LOAD  XSO = 40:XSO
--- LOAD  XSO_I = 41:XSO_I
--- LOAD  XSTO = 42:XSTO
--- LOAD  RKDO = 28:RKDO
--- LOAD  POPO = 27:POPO
--- LOAD  TDHO = 29:TDHO
--- LOAD  TICO = 31:TICO
--- LOAD  TIKO = 32:TIKO
--- LOAD  TIMO = 33:TIMO
--- LOAD  TIPO = 34:TIPO
--- LOAD  TIWO = 35:TIWO
