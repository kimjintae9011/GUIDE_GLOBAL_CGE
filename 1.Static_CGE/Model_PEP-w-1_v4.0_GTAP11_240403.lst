2494  *==============================================================================
2495  *  4.10 Energy
2496  *==============================================================================
2497  Parameter
2498   EEI(product,j,z)  Energy intensity by industry sector ktoe per 10 billion $
2499   NEI(product,j,z)  Non-Energy intensity by production sectos ktoe per 10 billion $
2500   EHI(product,z)    Energy intensity by household ktoe per 10 billion $
2501   
2502   EEO(product,j,z)  Initial Industry energy consumption in region z ktoe
2503   NEO(product,j,z)  Initial Industry non energy consumption in region z ktoe
2504   EHO(product,z)    Initial Household energy consumption in region z ktoe
2505  ;
2506   
2507   EEI(p_coal,j,z)$(DEO('02_COAL',j,z) gt 0)               = Coal_DIO(p_coal,j,z)/DEO('02_COAL',j,z);
2508   EEI(p_oil,j,z)$(DEO('03_OIL',j,z) gt 0)                 = Oil_DIO(p_oil,j,z)/DEO('03_OIL',j,z);
2509   EEI(p_gas,j,z)$(DEO('04_GAS',j,z) gt 0)                 = Gas_DIO(p_gas,j,z)/DEO('04_GAS',j,z);
2510   EEI(p_oilproduct,j,z)$(DEO('10_PETROLCOAL',j,z) gt 0)   = Oilp_DIO(p_oilproduct,j,z)/DEO('10_PETROLCOAL',j,z);
2511   EEI(p_elecheat,j,z)$(DEO('18_ELEC',j,z) gt 0)           = Elec_DIO(p_elecheat,j,z)/DEO('18_ELEC',j,z);
2512   
2513   NEI(p_coal,j,z)$(DEO('02_COAL',j,z) gt 0)              = NCoal_DIO(p_coal,j,z)/DEO('02_COAL',j,z);
2514   NEI(p_oil,j,z)$(DEO('03_OIL',j,z) gt 0)                = NOil_DIO(p_oil,j,z)/DEO('03_OIL',j,z);
2515   NEI(p_gas,j,z)$(DEO('04_GAS',j,z) gt 0)                = NGas_DIO(p_gas,j,z)/DEO('04_GAS',j,z);
2516   NEI(p_oilproduct,j,z)$(DEO('10_PETROLCOAL',j,z) gt 0)  = NOilp_DIO(p_oilproduct,j,z)/DEO('10_PETROLCOAL',j,z);
2517   
2518   EHI(p_coal,z)$(CO('02_COAL',z) gt 0)                    = Coal_CO(p_coal,z)/CO('02_COAL',z);
2519   EHI(p_oil,z)$(CO('03_OIL',z) gt 0)                      = Oil_CO(p_oil,z)/CO('03_OIL',z);
2520   EHI(p_gas,z)$(CO('04_GAS',z) gt 0)                      = Gas_CO(p_gas,z)/CO('04_GAS',z);
2521   EHI(p_oilproduct,z)$(CO('10_PETROLCOAL',z) gt 0)        = Oilp_CO(p_oilproduct,z)/CO('10_PETROLCOAL',z);
2522   EHI(p_elecheat,z)$(CO('18_ELEC',z) gt 0)                = Elec_CO(p_elecheat,z)/CO('18_ELEC',z);
2523   
2524   EEO(p_coal,j,z)       = Coal_DIO(p_coal,j,z) ;
2525   EEO(p_gas,j,z)        = Gas_DIO(p_gas,j,z) ;
2526   EEO(p_oil,j,z)        = Oil_DIO(p_oil,j,z) ;
2527   EEO(p_oilproduct,j,z) = Oilp_DIO(p_oilproduct,j,z) ;
2528   EEO(p_elecheat,j,z)   = Elec_DIO(p_elecheat,j,z) ;
2529   
2530   NEO(p_coal,j,z)       = NCoal_DIO(p_coal,j,z) ;
2531   NEO(p_gas,j,z)        = NGas_DIO(p_gas,j,z) ;
2532   NEO(p_oilproduct,j,z) = NOilp_DIO(p_oilproduct,j,z) ;
2533   
2534   EHO(p_coal,z)         = Coal_CO(p_coal,z) ;
2535   EHO(p_gas,z)          = Gas_CO(p_gas,z) ;
2536   EHO(p_oil,z)          = Oil_CO(p_oil,z) ;
2537   EHO(p_oilproduct,z)   = Oilp_CO(p_oilproduct,z) ;
2538   EHO(p_elecheat,z)     = Elec_CO(p_elecheat,z) ;
2539   
2540  *display EEI, EHI, EEO, NEO, EHO, GDPPPP, GHGsEF, CO2HO ;
2541  *execute_unload 'GHGs emission',
2542  *CO2HO, CO2IO, CH4IO, CH4HO, N2OIO, N2OHO
2543   
2544  *==============================================================================
2545  *  4.11 CO2FACTOR and CTAX
2546  *==============================================================================
2547  Parameters
2548   CO2FACTOR(ene,j,z)     CO2 emissions factor (tCO2 per 100$)
2549   CTAX0(z)               initial Carbon tax $ per ton CO2
2550   TCTAX0(z)              initial Government Revenue from Carbon tax
2551  ;
2552   
2553   CO2FACTOR(ene,j,z) = 0 ;
2554   CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*(1000/(10**8));
2555   CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z) = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*(1000/(10**8));
2556   CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*(1000/(10**8));
2557   
2558  *PetrolCoal
2559   CO2FACTOR('10_PETROLCOAL','10_PETROLCOAL',z) = 0;
2560   
2561  *PRK
2562   CO2FACTOR('02_COAL','01_AGRICULT','06_PRK')        = CO2FACTOR('02_COAL','01_AGRICULT','05_MNG');
2563   CO2FACTOR('10_PETROLCOAL','01_AGRICULT','06_PRK')  = CO2FACTOR('10_PETROLCOAL','01_AGRICULT','05_MNG');
2564   CO2FACTOR('02_COAL','28_LTRP','06_PRK')            = CO2FACTOR('02_COAL','28_LTRP','05_MNG');
2565   CO2FACTOR('02_COAL','17_OTHERIND','06_PRK')        = CO2FACTOR('02_COAL','17_OTHERIND','05_MNG');
2566   
2567  *RUS
2568   CO2FACTOR('02_COAL','08_WOODPRO','04_RUS')         = CO2FACTOR('02_COAL','08_WOODPRO','10_EEU');
2569   
2570  *LAM
2571   CO2FACTOR('04_GAS','02_COAL','08_LAM')             = CO2FACTOR('04_GAS','02_COAL','07_NAM');
2572   
2573   CTAX0(z) = 0 ;
2574   TCTAX0(z) = 0;
2575   
2576  execute_unload 'CO2FACTOR_w-1_GTAP11',
2577   CO2FACTOR ;
2578   
2579  *$exit
