 266  PARAMETER
 267  *==============================================================================
 268  *  2.1 Parameters
 269  *==============================================================================
 270   A_K(z)               Scale parameter (price of new capital)
 271   aij(i,j,z)           Input output coefficient
 272   aij2(i,j,z)          Input output coefficient (intermediate energy)
 273   B_KD(j,z)            Scale parameter (CES - composite capital)
 274   B_LD(j,z)            Scale parameter (CES - composite labor)
 275   B_M1(i,z)            Scale parameter (CES - composite commodity)
 276   B_M2(i,z)            Scale parameter (CES - composite import)
 277   B_VA(j,z)            Scale parameter (CES - value added)
 278   B_KLE(j,z)           Scale parameter (CES - composite KLE)
 279   B_ENER(j,z)          Scale parameter (CES - composite ENER)
 280   B_X1(i,z)            Scale parameter (CET - total output)
 281   B_X2(i,z)            Scale parameter (CET - composite export)
 282   B_X3(i,z)            Scale parameter (CES - top level)
 283   B_X4(z)              Scale parameter (CES - Aggregated Electricity)
 284   beta_D_X1(i,z)       Share parameter (CET - total output - local sales)
 285   beta_EX_X1(i,z)      Share parameter (CET - total output - export)
 286   beta_X2(i,z,zj)      Share parameter (CET - composite export)
 287   beta_X3(j,i,z)       Share parameter (CES - top level)
 288   beta_X4(power, z)    Share parameter (CES - Aggregated Electricity)
 289   beta_KD(k,j,z)       Share parameter (CES - composite capital)
 290   beta_LD(l,j,z)       Share parameter (CES - composite labor)
 291   beta_M1(i,z)         Share parameter (CES - composite commodity)
 292   beta_M2(i,zj,z)      Share parameter (CES - composite import)
 293   beta_VA(j,z)         Share parameter (CES - value added)
 294   beta_KLE(j,z)        Share parameter (CES - KLE composite)
 295   beta_ENER(ene,j,z)   Share parameter (CES - ENER composite)
 296   delta(z)             Depreciation rate of capital in country z
 297   eta                  Price elasticity of indexed transfers and parameters
 298   frisch(z)            Frisch parameter (LES function)
 299   gamma_GVT(i,z)       Share of commodity i in total current public expenditures on goods and services
 300   gamma_INV(i,z)       Share of commodity i in total investment expenditures
 301   gamma_LES(i,z)       Marginal share of commodity i in household consumption budget
 302   io(j,z)              Coefficient (Leontief - intermediate consumption)
 303   io2(j,z)             Coefficient (Leontief - intermediate energy consumption)
 304   v(j,z)               value added Coefficient (Leontief)
 305   v2(j,z)              KLE Share parameter (Leontief)
 306   kmob                 Flag parameter (1 if capital is mobile)
 307   RES                  Rescaling factor
 308   rho_KD(j,z)          Elasticity paameter (CES - composite capital)
 309   rho_LD(j,z)          Elasticity parameter (CES - composite labor)
 310   rho_M1(i,z)          Elasticity parameter (CES - composite commodity)
 311   rho_M2(i,z)          Elasticity parameter (CES - composite import)
 312   rho_VA(j,z)          Elasticity parameter (CES - value added)
 313   rho_KLE(j,z)         Elasticity parameter (CES - KLE)
 314   rho_ENER(j,z)        Elasticity parameter (CES - ENER)
 315   rho_X1(i,z)          Elasticity parameter (CET - composite export)
 316   rho_X2(i,z)          Elasticity parameter (CET - composite export)
 317   rho_X3(i,z)          Elasticity parameter (CES - top level)
 318   rho_X4(z)            Elasticity parameter (CES - Aggregated Electricity)
 319   sigma_KD(j,z)        Elasticity (CES - composite capital)
 320   sigma_LD(j,z)        Elasticity (CES - composite labor)
 321   sigma_M1(i,z)        Elasticity (CES - composite commodity)
 322   sigma_M2(i,z)        Elasticity (CES - composite import)
 323   sigma_VA(j,z)        Elasticity (CES - value added)
 324   sigma_KLE(j,z)       Elasticity (CES - kle)
 325   sigma_ENER(j,z)      Elasticity (CES - within energy)
 326   sigma_X0(j,z)        Elasticity (CET - exports and local sales)
 327   sigma_X1(i,z)        Elasticity (CET - total output)
 328   sigma_X2(i,z)        Elasticity (CET - composite export)
 329   sigma_X3(i,z)        Elasticity (CES - top level)
 330   sigma_X4(z)          Elasticity (CES - Aggregated Electricity)
 331   sigma_Y(i,z)         Income elasticity of consumption
 332   tmrg(i,ij,zj,z)      Rate of margin i applied to commodity ij imported from country zj
 333   TnDShare(z)          T&D share of Aggregated electricity
 334   PowerShare(z)        Power Industries share of Aggregated electricity
 335   theta2(j,i,z)        Export share of composite activity
