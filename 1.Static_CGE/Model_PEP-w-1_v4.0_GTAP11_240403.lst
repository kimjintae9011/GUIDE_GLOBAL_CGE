3020  *==============================================================================
3021  *  5.3 Equations
3022  *==============================================================================
3023  *   5.3.1 Production
3024  *==============================================================================
3025   EQ1(j3,z)..     VA(j3,z) =e= v(j3,z)*XST(j3,z);
3026   
3027   EQ1_1(j2,z)..   KLE(j2,z) =e= v2(j2,z)*XST(j2,z);
3028   
3029   EQ2(j,z)..      CI(j,z) =e= io(j,z)*XST(j,z);
3030   
3031   EQ2_1(j3,z)..   CE(j3,z) =e= io2(j3,z)*XST(j3,z);
3032   
3033   EQ3(j,z)..      VA(j,z) =e= B_VA(j,z)*{
3034                      [beta_VA(j,z)*LDC(j,z)**(-rho_VA(j,z))]$LDCO(j,z)
3035                     +[(1-beta_VA(j,z))*KDC(j,z)**(-rho_VA(j,z))]$KDCO(j,z)
3036                                                     }**(-1/rho_VA(j,z));
3037   
3038   EQ3_1(j2,z)..     KLE(j2,z) =e= B_KLE(j2,z)*{
3039                      [beta_KLE(j2,z)*VA(j2,z)**(-rho_KLE(j2,z))]$VAO(j2,z)
3040                     +[(1-beta_KLE(j2,z))*CE(j2,z)**(-rho_KLE(j2,z))]$CEO(j2,z)
3041                                                     }**(-1/rho_KLE(j2,z));
3042   
3043   EQ4(j,z)$[LDCO(j,z) and KDCO(j,z)]..
3044                   LDC(j,z) =e= {[beta_VA(j,z)/(1-beta_VA(j,z))]
3045                                *[RC(j,z)/WC(j,z)]}**sigma_VA(j,z)*KDC(j,z);
3046   
3047   EQ4_1(j2,z)$[VAO(j2,z) and CEO(j2,z)]..
3048                   VA(j2,z) =e= {[beta_KLE(j2,z)/(1-beta_KLE(j2,z))]
3049                                *[PCE(j2,z)/PVA(j2,z)]}**sigma_KLE(j2,z)*CE(j2,z);
3050   
3051   EQ5(j,z)$LDCO(j,z)..
3052                   LDC(j,z) =e= B_LD(j,z)*SUM[l$LDO(l,j,z),beta_LD(l,j,z)
3053                                  *LD(l,j,z)**(-rho_LD(j,z))]**(-1/rho_LD(j,z));
3054   
3055   EQ6(l,j,z)$LDO(l,j,z)..
3056                   LD(l,j,z) =e= [beta_LD(l,j,z)*WC(j,z)/WTI(l,j,z)]
3057                                 **sigma_LD(j,z)*B_LD(j,z)**(sigma_LD(j,z)-1)
3058                                 *LDC(j,z);
3059   
3060   EQ7(j,z)$KDCO(j,z)..
3061                   KDC(j,z) =e= B_KD(j,z)*SUM[k$KDO(k,j,z),beta_KD(k,j,z)
3062                                  *KD(k,j,z)**(-rho_KD(j,z))]**(-1/rho_KD(j,z));
3063   
3064   EQ8(k,j,z)$KDO(k,j,z)..
3065                   KD(k,j,z) =e= [beta_KD(k,j,z)*RC(j,z)/RTI(k,j,z)]
3066                                   **sigma_KD(j,z)*B_KD(j,z)**(sigma_KD(j,z)-1)
3067                                   *KDC(j,z);
3068   
3069   EQ9(nene,j,z)..   DI(nene,j,z) =e= aij(nene,j,z)*CI(j,z) ;
3070   
3071   EQ9_1(ene,j3,z)..  DE(ene,j3,z) =e= aij2(ene,j3,z)*CE(j3,z) ;
3072   
3073  * EQ9_1(ene,j,z)..  DE(ene,j,z) =e= [beta_ENER(ene,j,z)*PCE(j,z)/((1+CTAX(Z)*CO2FACTOR(ene,j,z))*P4(ene,j,z))]
3074  *                                   **sigma_ENER(j,z)*B_ENER(j,z)**(sigma_ENER(j,z)-1)
3075  *                                   *CE(j,z);
3076   
3077  *EQ9_2(ene,j2,z)..  DE(ene,j2,z) =e= [beta_ENER(ene,j2,z)*PCE(j2,z)/P4(ene,j2,z)]
3078  *                                   **sigma_ENER(j2,z)*B_ENER(j2,z)**(sigma_ENER(j2,z)-1)
3079  *                                   *CE(j2,z);
3080   
3081   EQ9_2(ene,j2,z)..  DE(ene,j2,z) =e= [beta_ENER(ene,j2,z)*PCE(j2,z)/((P4(ene,j2,z)+CTAX(Z)*CO2FACTOR(ene,j2,z)))]
3082                                     **sigma_ENER(j2,z)*B_ENER(j2,z)**(sigma_ENER(j2,z)-1)
3083                                     *CE(j2,z);
3084   
3085  * EQ9_2(ene,j2,z)..  DE(ene,j2,z) =e= [beta_ENER(ene,j2,z)*PCE(j2,z)/((1+CTAX(Z)*CO2FACTOR(ene,j2,z))*P4(ene,j2,z))]
3086  *                                   **sigma_ENER(j2,z)*B_ENER(j2,z)**(sigma_ENER(j2,z)-1)
3087  *                                   *CE(j2,z);
3088   
3089   
3090  * EQ9_3(j2,z)..      CE(j2,z) =e= B_ENER(j2,z)*SUM[ene$DEO(ene,j2,z),beta_ENER(ene,j2,z)
3091  *                                *DE(ene,j2,z)**(-rho_ENER(j2,z))]**(-1/rho_ENER(j2,z));
3092   
3093  *==============================================================================
3094  *   5.3.2 Income and savings
3095  *==============================================================================
3096  *    5.3.2.1 Households
3097  *==============================================================================
3098   EQ10(z)..       YH(z) =e= YHL(z)+YHK(z)+TCTAX(Z);
3099   
3100   EQ11(z)..       YHL(z) =e= SUM[(l,j)$LDO(l,j,z),W(l,z)*LD(l,j,z)];
3101   
3102   EQ12(z)..       YHK(z) =e= SUM[(k,j)$KDO(k,j,z),R(k,j,z)*KD(k,j,z)];
3103   
3104   EQ13(z)..       YDH(z) =e= YH(z)-TDH(z);
3105   
3106   EQ14(z)..       CTH(z) =e= YDH(z)-SH(z);
3107   
3108   EQ15(z)..       SH(z) =e= PIXCON(z)**eta*sh0(z)+sh1(z)*YDH(z);
3109   
3110  *==============================================================================
3111  *    5.3.2.2 Government
3112  *==============================================================================
3113  * EQ16(z)..       YG(z) =e= TDH(z)+TPRODN(z)+TPRCTS(z)+TCTAX(Z) ;
3114   
3115   EQ16(z)..       YG(z) =e= TDH(z)+TPRODN(z)+TPRCTS(z) ;
3116   
3117   EQ16_1(Z)..     TCTAX(Z) =e= sum((ene,j), PC(ene,z)*CTAX(Z)*CO2FACTOR(ene,j,z)*DE(ene,j,z));
3118  *eqTe(j)..       Te(j)   =e= sum(en,taue(en)*pq(en)*CO2coef(en)*X(en,j));
3119   
3120   
3121   EQ17(z)..       TPRODN(z) =e= TIWT(z)+TIKT(z)+TIPT(z);
3122   
3123   EQ18(z)..       TIWT(z) =e= SUM[(l,j)$LDO(l,j,z),TIW(l,j,z)];
3124   
3125   EQ19(z)..       TIKT(z) =e= SUM[(k,j)$KDO(k,j,z),TIK(k,j,z)];
3126   
3127   EQ20(z)..       TIPT(z) =e= SUM[j,TIP(j,z)];
3128   
3129   EQ21(z)..       TPRCTS(z) =e= TICT(z)+TIMT(z)+TIXT(z);
3130   
3131   EQ22(z)..       TICT(z) =e= SUM[i,TIC(i,z)];
3132   
3133   EQ23(z)..       TIMT(z) =e= SUM[(i,zj)$IMO(i,zj,z),TIM(i,zj,z)];
3134   
3135   EQ24(z)..       TIXT(z) =e= SUM[(i,zj)$EXO(i,z,zj),TIX(i,z,zj)];
3136   
3137   EQ25(z)..       TDH(z) =e= PIXCON(z)**eta*ttdh0(z)+ttdh1(z)*YH(z);
3138   
3139   EQ26(l,j,z)$LDO(l,j,z)..
3140                   TIW(l,j,z) =e= ttiw(l,j,z)*W(l,z)*LD(l,j,z);
3141   
3142   EQ27(k,j,z)$KDO(k,j,z)..
3143                   TIK(k,j,z) =e= ttik(k,j,z)*R(k,j,z)*KD(k,j,z);
3144   
3145   EQ28(j,z)..     TIP(j,z) =e= ttip(j,z)*PP(j,z)*XST(j,z);
3146   
3147   EQ29(i,z)..     TIC(i,z) =e= ttic(i,z)*{[PL(i,z)*DD(i,z)]$DDO(i,z)
3148                   +[SUM[zj$IMO(i,zj,z),(1+ttim(i,zj,z))*IM(i,zj,z)*e(z)
3149                    *(PWM(i,zj,z)+SUM(ij,PWMG(ij)*tmrg(ij,i,zj,z)))]]};
3150   
3151   EQ30(i,zj,z)$IMO(i,zj,z)..
3152                   TIM(i,zj,z) =e= ttim(i,zj,z)*IM(i,zj,z)*e(z)*(PWM(i,zj,z)
3153                                  +SUM[ij,PWMG(ij)*tmrg(ij,i,zj,z)]);
3154   
3155   EQ31(i,z,zj)$EXO(i,z,zj)..
3156                   TIX(i,z,zj) =e= ttix(i,z,zj)*PE(i,z,zj)*EX(i,z,zj);
3157   
3158   EQ32(z)..       SG(z) =e= YG(z)-G(z);
3159   
3160  *==============================================================================
3161  *    5.3.2.4 Rest of the world
3162  *==============================================================================
3163   EQ33(z)..       YROW(z) =e= e(z)*SUM{(i,zj)$IMO(i,zj,z),IM(i,zj,z)*
3164                             [PWM(i,zj,z)+SUM(ij,PWMG(ij)*tmrg(ij,i,zj,z))]};
3165   
3166   EQ34(z)..       SROW(z) =e= YROW(z)-e(z)*SUM[(i,zj)$EXO(i,z,zj),
3167                                 EX(i,z,zj)*PWX(i,z,zj)]-e(z)
3168                                 *SUM[i$MRGNO(i,z),MRGN(i,z)*PWMG(i)];
3169   
3170   EQ35(z)..       SROW(z) =e= -CAB(z);
3171   
3172  *==============================================================================
3173  *   5.3.3 Demand
3174  *==============================================================================
3175   EQ36(i,z)..     PC(i,z)*C(i,z) =e= PC(i,z)*CMIN(i,z)+gamma_LES(i,z)
3176                                   *{CTH(z)-SUM[ij,PC(ij,z)*CMIN(ij,z)]};
3177   
3178   EQ37(i,z)..     PC(i,z)*INV(i,z) =e= gamma_INV(i,z)*IT(z);
3179   
3180   EQ38(i,z)..     PC(i,z)*CG(i,z) =e= gamma_GVT(i,z)*G(z);
3181   
3182   EQ39(nene,z)..     DIT(nene,z) =e= SUM[j,DI(nene,j,z)];
3183   
3184   EQ39_1(ene,z)..   DIT(ene,z) =e= SUM[j,DE(ene,j,z)];
3185   
3186  *==============================================================================
3187  *   5.3.4 International trade
3188  *==============================================================================
       EQB_1(i,z)..    XS_I(i,z) =e= B_X3(i,z)*SUM[j$XSO(j,i,z),beta_X3(j,i,z)
                                      *XS(j,i,z)**(-rho_X3(i,z))]**(-1/rho_X3(i,z));
       
       EQB_2(j,i,z)${DSO(j,i,z) and [DSO(j,i,z) ne DSO_I(i,z)]}..
                       XS(j,i,z) =e= XS_I(i,z)/B_X3(i,z)**(1-sigma_X3(i,z))*
                                     [beta_X3(j,i,z)*PI(i,z)/P2(j,i,z)]
                                     **sigma_X3(i,z);
       
       EQB_3(j,i,z)${DSO(j,i,z)}..   P2(j,i,z) =e= PT(j,z);
       
       EQB_4(j,i,z)$DSO(j,i,z)..
                       P2(j,i,z)*XS(j,i,z) =e= [PET(i,z)*EXTT(j,i,z)]$EXTTO(j,i,z)
                                              +[e(z)*MRGN(i,z)*PWMG(i)]$MRGNO(i,z)
                                              +[PL(i,z)*DS(j,i,z)]$DSO(j,i,z);
       
       EQB_5(j,i,z)$DSO(j,i,z)..  EXTT(j,i,z)  =e= theta2(j,i,z)*EXT(i,z);
3207   
3208  *[Top Nest - Leontief function]
3209   EQA_1(z)..  XS('18_TnD','18_ELEC',z) =e= TnDShare(z)*XS_I('18_ELEC',z);
3210   EQA_2(z)..  XS_I('18_ELEC',z) =e= XS('18_TnD','18_ELEC',z) + POWERQ(z);
3211   
3212   
3213  *[Second Nest - CES function]
3214   EQA_3(z)..    POWERQ(z) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
3215                                  *XS(POWER,'18_ELEC',z)**(-rho_X4(z))]**(-1/rho_X4(z));
3216   
3217   EQA_4(power,'18_ELEC',z)..  XS(POWER,'18_ELEC',z) =e= POWERQ(z)/B_X4(z)**(1-sigma_X4(z))*
3218                                 [beta_X4(power,z)*PPOWER(z)/P2(POWER,'18_ELEC',z)]
3219                                 **sigma_X4(z);
3220   
3221  * exclude electiricity
3222   EQB_1(i2,z)..    XS_I(i2,z) =e= B_X3(i2,z)*SUM[j$XSO(j,i2,z),beta_X3(j,i2,z)
3223                                  *XS(j,i2,z)**(-rho_X3(i2,z))]**(-1/rho_X3(i2,z));
3224   
3225   
3226   EQB_3(j,i,z)${DSO(j,i,z)}..   P2(j,i,z) =e= PT(j,z);
3227   
3228   EQB_4(j,i,z)$DSO(j,i,z)..
3229                   P2(j,i,z)*XS(j,i,z) =e= [PET(i,z)*EXTT(j,i,z)]$EXTTO(j,i,z)
3230                                          +[e(z)*MRGN(i,z)*PWMG(i)]$MRGNO(i,z)
3231                                          +[PL(i,z)*DS(j,i,z)]$DSO(j,i,z);
3232   
3233   EQB_5(j,i,z)$DSO(j,i,z)..  EXTT(j,i,z)  =e= theta2(j,i,z)*EXT(i,z);
3234   
3235   EQ40_3(i,z)..   DS_I(i,z) =e= sum(j,DS(j,i,z)$DSO(j,i,z));
3236   
3237   EQ40_4(j,z)..   XST(j,z)  =e= sum(i,XS(j,i,z)$XSO(j,i,z));
3238   
3239   EQ40_5(i,z)..   XS_I(i,z) =e= B_X1(i,z)*{
3240                   [beta_EX_X1(i,z)*EXT(i,z)**rho_X1(i,z)]$EXTO(i,z)
3241                  +[beta_D_X1(i,z)*DS_I(i,z)**rho_X1(i,z)]$DSO_I(i,z)
3242                  +[(1-beta_EX_X1(i,z)-beta_D_X1(i,z))*MRGN(i,z)**rho_X1(i,z)]$MRGNO(i,z)
3243                                            }**(1/rho_X1(i,z));
3244   
3245   EQ41(i,z)$[EXTO(i,z) and DSO_I(i,z)]..
3246                   EXT(i,z) =e= {[beta_D_X1(i,z)/beta_EX_X1(i,z)]*[PET(i,z)/PL(i,z)]}
3247                                **sigma_X1(i,z)*DS_I(i,z);
3248   
3249   EQ42(i,z)$[MRGNO(i,z) and DSO_I(i,z)]..
3250                   MRGN(i,z) =e= {[beta_D_X1(i,z)/(1-beta_EX_X1(i,z)
3251                                   -beta_D_X1(i,z))]*[e(z)*PWMG(i)/PL(i,z)]}
3252                                   **sigma_X1(i,z)*DS_I(i,z);
3253   
3254   EQ43(i,z)$EXTO(i,z)..
3255                   EXT(i,z) =e= B_X2(i,z)*SUM[zj$EXO(i,z,zj),beta_X2(i,z,zj)
3256                                  *EX(i,z,zj)**rho_X2(i,z)]**(1/rho_X2(i,z));
3257   
3258   EQ44(i,z,zj)$EXO(i,z,zj)..
3259                   EX(i,z,zj) =e= EXT(i,z)/B_X2(i,z)**(1+sigma_X2(i,z))*
3260                                    [PE(i,z,zj)/(beta_X2(i,z,zj)*PET(i,z))]
3261                                    **sigma_X2(i,z);
3262   
3263   EQ45(i,z)..     Q(i,z) =e= B_M1(i,z)*{
3264                      [beta_M1(i,z)*IMT(i,z)**(-rho_M1(i,z))]$IMTO(i,z)
3265                     +[(1-beta_M1(i,z))*DD(i,z)**(-rho_M1(i,z))]$DDO(i,z)
3266                                          }**(-1/rho_M1(i,z));
3267   
3268   EQ46(i,z)$[IMTO(i,z) and DDO(i,z)]..
3269                   IMT(i,z) =e= {[beta_M1(i,z)/(1-beta_M1(i,z))]*[PD(i,z)
3270                                  /PMT(i,z)]}**sigma_m1(i,z)*DD(i,z);
3271   
3272   EQ47(i,z)$IMTO(i,z)..
3273                   IMT(i,z) =e= B_M2(i,z)*SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*
3274                                  IM(i,zj,z)**(-rho_M2(i,z))]**(-1/rho_M2(i,z));
3275   
3276   EQ48(i,zj,z)$IMO(i,zj,z)..
3277                   IM(i,zj,z) =e= IMT(i,z)/B_M2(i,z)**(1-sigma_M2(i,z))*
3278                                    [beta_M2(i,zj,z)*PMT(i,z)/PM(i,zj,z)]
3279                                    **sigma_M2(i,z);
3280   
3281  *==============================================================================
3282  *   5.3.5 Prices
3283  *==============================================================================
3284   EQ49(j2,z)..    PP(j2,z)*XST(j2,z) =e= PKLE(j2,z)*KLE(j2,z)+PCI(j2,z)*CI(j2,z);
3285   
3286   EQ49_1(j3,z)..  PP(j3,z)*XST(j3,z) =e= PVA(j3,z)*VA(j3,z)+PCI(j3,z)*CI(j3,z)+PCE(j3,z)*CE(j3,z);
3287   
3288   EQ50(j,z)..     PT(j,z) =e= (1+ttip(j,z))*PP(j,z);
3289   
3290   EQ51(j,z)..     PCI(j,z)*CI(j,z) =e= SUM[nene,PC(nene,z)*DI(nene,j,z)];
3291   
3292   EQ51_1(j,z)..   PCE(j,z)*CE(j,z) =e= SUM[ene,PC(ene,z)*DE(ene,j,z) + PC(ene,z)*CTAX(Z)*CO2FACTOR(ene,j,z)*DE(ene,j,z)];
3293   
3294  *EQ51_1(j,z)..   PCE(j,z)*CE(j,z) =e= SUM[ene,P4(ene,j,z)*DE(ene,j,z)];
3295   
3296   EQ52(j,z)..     PVA(j,z)*VA(j,z) =e= [WC(j,z)*LDC(j,z)]$LDCO(j,z)
3297                                       +[RC(j,z)*KDC(j,z)]$KDCO(j,z);
3298   
3299   EQ52_1(j2,z)..   PKLE(j2,z)*KLE(j2,z) =e= [PVA(j2,z)*VA(j2,z)]$VAO(j2,z) + [PCE(j2,z)*CE(j2,z)]$CEO(j2,z);
3300   
3301  * Given equations 5 and 6, equation 53 is redundant
3302  * EQ53(j,z)..     WC(j,z)*LDC(j,z) =e= SUM[l$LDO(l,j,z),WTI(l,j,z)*LD(l,j,z)];
3303   
3304   EQ54(l,j,z)$LDO(l,j,z)..
3305                   WTI(l,j,z) =e= W(l,z)*(1+ttiw(l,j,z));
3306   
3307   EQ54_1(ene,j,z)$DEO(ene,j,z)..
3308                   P4(ene,j,z) =e= PC(ene,z);
3309   
3310  * Given equations 7 and 8, equation 55 is redundant
3311  * EQ55(j,z)$(kmob and KDCO(j,z))..
3312  *                 RC(j,z)*KDC(j,z) =e= SUM[k$KDO(k,j,z),RTI(k,j,z)*KD(k,j,z)];
3313   
3314   EQ56(k,j,z)$KDO(k,j,z)..
3315                   RTI(k,j,z) =e= R(k,j,z)*(1+ttik(k,j,z));
3316   
3317   EQ57(k,j,z)$(kmob and KDO(k,j,z))..
3318                   R(k,j,z) =e= RK(k,z);
3319   
3320  * EQ58(j,z)..     P(j,z)*XST(j,z) =e= [PL(j,z)*DS(j,z)]$DSO(j,z)
3321  *                                   +[PET(j,z)*EXT(j,z)]$EXTO(j,z)
3322  *                                   +[e(z)*PWMG(j)*MRGN(j,z)]$MRGNO(j,z);
3323   
3324   EQ58(i,z)..     P(i,z)*XS_I(i,z) =e= [PL(i,z)*DS_I(i,z)]$DSO_I(i,z)
3325                                       +[PET(i,z)*EXT(i,z)]$EXTO(i,z)
3326                                       +[e(z)*PWMG(i)*MRGN(i,z)]$MRGNO(i,z);
3327   
3328  * Given equations 43 and 44, equation 59 is redundant
3329  * EQ59(i,z)$EXTO(i,z)..
3330  *                 PET(i,z)*EXT(i,z) =e= SUM[zj$EXO(i,z,zj),
3331  *                                           PE(i,z,zj)*EX(i,z,zj);
3332   
3333   EQ60(i,z,zj)$EXO(i,z,zj)..
3334                   PE(i,z,zj)*(1+ttix(i,z,zj)) =e= e(z)*PWX(i,z,zj);
3335   
3336   EQ61(i,z)$DDO(i,z)..
3337                   PD(i,z) =e= (1+ttic(i,z))*PL(i,z);
3338   
3339   EQ62(i,zj,z)$IMO(i,zj,z)..
3340                   PM(i,zj,z) =e= (1+ttic(i,z))*(1+ttim(i,zj,z))*e(z)*
3341                                    (PWM(i,zj,z)+SUM[ij,PWMG(ij)
3342                                    *tmrg(ij,i,zj,z)]);
3343   
3344  * Given equations 47 and 48, equation 63 is redundant
3345  * EQ63(i,z)$IMTO(i,z)..
3346  *                 PMT(i,z)*IMT(i,z) =e= SUM[zj$IMO(i,zj,z),
3347  *                                           PM(i,zj,z)*IM(i,zj,z);
3348   
3349   EQ64(i,z)..     PC(i,z)*Q(i,z) =e= [PD(i,z)*DD(i,z)]$DDO(i,z)+
3350                                      [PMT(i,z)*IMT(i,z)]$IMTO(i,z);
3351   
3352   EQ65(z)..       PK(z) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z)
3353                                 /gamma_INV(i,z))**gamma_INV(i,z)];
3354   
3355   EQ66(z)..       PIXGDP(z) =e=
3356                   {SUM[j,{(PVA(j,z)*VA(j,z)+TIP(j,z))/VA(j,z)}*VAO(j,z)]
3357                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
3358                   *SUM[j,{(PVA(j,z)*VA(j,z)+TIP(j,z))/VA(j,z)}*VA(j,z)]
3359                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z)]}**0.5;
3360   
3361   EQ67..          PIXGDP_W =e=
3362                   {SUM[(j,z),{(PVA(j,z)*VA(j,z)+TIP(j,z))/VA(j,z)}*VAO(j,z)/e(z)]
3363                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
3364                   *SUM[(j,z),{(PVA(j,z)*VA(j,z)+TIP(j,z))/VA(j,z)}*VA(j,z)/e(z)]
3365                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z)/eO(z)]}**0.5;
3366   
3367   EQ68(z)..       PIXCON(z) =e= SUM[i,PC(i,z)*CO(i,z)]/SUM[i,PCO(i,z)*CO(i,z)];
3368   
3369   EQ69(z)..       PIXINV(z) =e= PROD[i$gamma_INV(i,z),(PC(i,z)/PCO(i,z))
3370                                   **gamma_INV(i,z)];
3371   
3372   EQ70(z)..       PIXGVT(z) =e= PROD[i$gamma_GVT(i,z),(PC(i,z)/PCO(i,z))
3373                                   **gamma_GVT(i,z)];
3374   
3375  *==============================================================================
3376  *   5.3.6 Equilibrium
3377  *==============================================================================
3378   EQ71(i1,z)..    Q(i1,z) =e= C(i1,z)+CG(i1,z)+INV(i1,z)+DIT(i1,z);
3379   
3380   EQ72(l,z)..     LS(l,z) =e= SUM[j$LDO(l,j,z),LD(l,j,z)];
3381   
3382   EQ73(k,z)$KSO(k,z)..
3383                   KS(k,z) =e= SUM[j$KDO(k,j,z),KD(k,j,z)];
3384   
3385   EQ74(z)..       IT(z) =e= SH(z)+SG(z)-CAB(z);
3386   
3387   EQ75(z)..       DEP(z) =e= PK(z)*delta(z)*SUM[k$KSO(k,z),KS(k,z)];
3388   
3389   EQ76(i,z)$DDO(i,z)..
3390                   SUM[j$DSO(j,i,z),DS(j,i,z)] =e= DD(i,z);
3391   
3392   EQ77(i,z,zj)$EXO(i,z,zj)..
3393                   EX(i,z,zj) =e= IM(i,z,zj);
3394   
3395   EQ78(i,z,zj)$EXO(i,z,zj)..
3396                   PWX(i,z,zj) =e= PWM(i,z,zj);
3397   
3398   EQ79(i)..       SUM[z$MRGNO(i,z),MRGN(i,z)] =e= SUM[(z,zj,ij)$IMO(ij,zj,z),
3399                                                   tmrg(i,ij,zj,z)*IM(ij,zj,z)];
3400   
3401  * Given equations 33, 34 and 77, equation 80 is redundant
3402  * EQ80..          SUM[z,SROW(z)/e(z)] =e= 0;
3403   
3404  *==============================================================================
3405  *   5.3.7 Gross domestic product
3406  *==============================================================================
3407   EQ81(z)..       GDP_BP(z) =e= SUM[j,PVA(j,z)*VA(j,z)]+TIPT(z);
3408   
3409   EQ82(z)..       GDP_MP(z) =e= GDP_BP(z)+TPRCTS(z);
3410   
3411   EQ83(z)..       GDP_IB(z) =e= SUM[(l,j)$LDO(l,j,z),W(l,z)*LD(l,j,z)]
3412                                +SUM[(k,j)$KDO(k,j,z),R(k,j,z)*KD(k,j,z)]
3413                                +TPRCTS(z)+TPRODN(z);
3414   
3415   EQ84(z)..       GDP_FD(z) =e=
3416                   SUM[i,PC(i,z)*(C(i,z)+CG(i,z)+INV(i,z))]
3417                  +SUM[(i,zj)$EXO(i,z,zj),e(z)*PWX(i,z,zj)*EX(i,z,zj)]
3418                  +SUM[i$MRGNO(i,z),e(z)*PWMG(i)*MRGN(i,z)]
3419                  -SUM[(i,zj)$IMO(i,zj,z),e(z)*IM(i,zj,z)
3420                      *(PWM(i,zj,z)+SUM[ij,PWMG(ij)*tmrg(ij,i,zj,z)])];
3421   
3422   EQ85..          GDP_BP_W =e= SUM[z,GDP_BP(z)/e(z)];
3423   
3424  *==============================================================================
3425  *  5.3.8 Real (volume) variables computed from price indices
3426  *==============================================================================
3427   EQ86(z)..       CTH_REAL(z) =e= CTH(z)/PIXCON(z);
3428   
3429   EQ87(z)..       G_REAL(z) =e= G(z)/PIXGVT(z);
3430   
3431   EQ88(z)..       GDP_BP_REAL(z) =e= GDP_BP(z)/PIXGDP(z);
3432   
3433   EQ89..          GDP_BP_W_REAL =e= GDP_BP_W/PIXGDP_W;
3434   
3435   EQ90(z)..       GDP_MP_REAL(z) =e= GDP_MP(z)/PIXCON(z);
3436   
3437   EQ91(z)..       IT_REAL(z) =e= IT(z)/PIXINV(z);
3438   
3439   EQ92(z)..       CABX(z) =e= CAB(z)/[PIXGDP_W*e(z)];
3440   
3441  *==============================================================================
3442  *   5.3.9 Other
3443  *==============================================================================
3444   WALRAS(z)..     LEON(z) =e= Q('01_AGRICULT',z)-C('01_AGRICULT',z)-CG('01_AGRICULT',z)-INV('01_AGRICULT',z)
3445                              -DIT('01_AGRICULT',z);
3446   
3447  * EQ93..          OBJ   =e= sum(z, prod(i,PC(i,z)**0.5));
3448   
3449   EQ93..          OBJ   =e= 1;
3450  *==============================================================================
3451  * 6 Numerical resolution
3452  *==============================================================================
3453  *  6.1 Variable initialisation
3454  *==============================================================================
3455  *   6.1.1 Volume variables
3456  *==============================================================================
3457   CABX.L(z)        = CABXO(z);
3458   C.L(i,z)         = CO(i,z);
3459   CG.L(i,z)        = CGO(i,z);
3460   CI.L(j,z)        = CIO(j,z);
3461   CE.L(j,z)        = CEO(j,z);
3462   CMIN.L(i,z)      = CMINO(i,z);
3463   CTH_REAL.L(z)    = CTH_REALO(z);
3464   DI.L(nene,j,z)   = DIO(nene,j,z);
3465   DE.L(ene,j,z)    = DEO(ene,j,z);
