 102   
 103  * Parameters and Scalars
 104  Parameter
 105     SAM0(i,j)        'base SAM transactions matrix'
 106     T0(i,j)          'matrix of SAM transactions (flow matrix)'
 107     T1(i,j)          'SAM transactions adjusted to eliminate negative entries'
 108     Abar0(i,j)       'prior SAM coefficient matrix'
 109     Abar1(i,j)       'prior SAM adjusted to eliminate negative coefficients'
 110     Target0(i)       'targets for macro SAM column totals'
 111     vbar1(i,jwt)     'error support set 1'
 112     vbar2(macro,jwt) 'error support set 2'
 113     wbar1(i,jwt)     'weights on error support set 1'
 114     wbar2(macro,jwt) 'weights on error support set 2'
 115     sigmay1(i)       'prior standard error of column sums'
 116     sigmay2(macro)   'prior standard error of macro aggregates'
 117     epsilon          'tolerance to allow zero entries in SAM';
 118   
 119  Scalar
 120     gdp0   'base GDP'
 121     gdp00  'GDP from final SAM'
 122     gdpfc0 'GDP at factor cost';
 123   
 124  * Initializing Parameters
 125  SAM("TOTAL",jj) = sum(ii, SAM(ii,jj));
 126  SAM(ii,"TOTAL") = sum(jj, SAM(ii,jj));
 127  sam0(i,j)       = sam(i,j);
 128   
 129  * Divide SAM entries by 1000 for better scaling.
 130  * The SAM is scaled to enhance solver efficiency. Nonlinear solvers are
 131  * more efficient if variables are scaled similarly. In this case,
 132  * coefficients to be estimated range between 0 and 1, so SAM values
 133  * are also scaled.
 134   
 135  Scalar scalesam 'scaling value' / 1000 /;
 136   
 137  sam(i,j)                = sam(i,j)/scalesam ;
 138  Abar0(ii,jj)$SAM(ii,jj) = SAM(ii,jj)/SAM("TOTAL",jj);
 139   
 140  T0(ii,jj)      = SAM(ii,jj);
 141  T0("TOTAL",jj) = sum(ii, SAM(ii,jj));
 142  T0(ii,"TOTAL") = sum(jj, SAM(ii,jj));
 143   
 144  epsilon = .00001;
 145   
 146  display T0, Abar0;
 147   
      CROSS ENTROPY
      RED ALERT!!!
       
      The ENTROPY DIFFERENCE procedure uses LOGARITHMS: negative flows in
      the SAM are NOT GOOD!!!
       
      The option used here is to detect any negative flows and net them out
      of their respective symmetric cells, e.g.
          negative flow column to row is set to zero
          and added to corresponding row to column as a positive number.
      The entropy difference method can then be implemented.
      After balancing, the negative SAM values are returned to their
      original cells for printing.
 163   
 164  Set red(i,j) 'set of negative SAM flows';
 165   
 166  Parameter
 167     redsam(i,j) 'negative SAM values only'
 168     rtot(i)     'row total'
 169     ctot(i)     'column total';
 170   
 171  rtot(ii) = sum(jj, T0(ii,jj));
 172  ctot(jj) = sum(ii, T0(ii,jj));
 173   
 174  red(ii,jj)$(T0(ii,jj) < 0) = yes;
 175  redsam(ii,jj)              = 0;
 176  redsam(ii,jj)$red(ii,jj)   = T0(ii,jj);
 177  redsam(jj,ii)$red(ii,jj)   = T0(ii,jj);
 178   
 179  *Note that redsam includes each entry twice, in corresponding row
 180  *and column. So, redsam need only be subtracted from T0.
 181  T1(ii,jj)      = T0(ii,jj) - redsam(ii,jj);
 182  T1("Total",jj) = sum(ii, T1(ii,jj));
 183  T1(ii,"Total") = sum(jj, T1(ii,jj));
 184   
 185  redsam("total",jj) = sum(ii, redsam(ii,jj));
 186  redsam(ii,"total") = sum(jj, redsam(ii,jj));
 187   
 188  sam(ii,"total") = sum(jj, T1(ii,jj));
 189  sam("total",jj) = sum(ii, T1(ii,jj));
 190   
 191  rtot(ii) = sum(jj, T1(ii,jj));
 192  ctot(jj) = sum(ii, T1(ii,jj));
 193   
 194  Abar1(ii,jj) = T1(ii,jj)/sam("total",jj);
 195   
 196  display "NON-NEGATIVE SAM", redsam, T1, Abar0, Abar1, rtot, ctot;
 197   
 198  * Define set of elements of SAM that can be nonzero. In this case, only
 199  * elements which are nonzero in initial SAM.
 200  Set NONZERO(i,j) 'SAM elements that can be nonzero';
 201  NONZERO(ii,jj)$(Abar1(ii,jj)) = yes;
 202   
 203  * Initializing Parameters after accounting for negative values
 204  *   Note that target column sums are being set to average of initial
 205  *   row and column sums. Initial column sums or other values
 206  *   could have been used instead, depending on knowledge of data quality
 207  *   and any other prior information.
 208  target0(ii) = (sam(ii,"total") + sam("total",ii))/2;
 209  gdpfc0 = T1("fac","act");
 210  gdp0   = T1("fac","act") + T1("gre","act") - T1("act","gre") + T1("gre","com");
 211   
 212  display gdpfc0, gdp0;
 213   
      Define variable bounds on errors
       
      Start from assumed prior knowledge of the standard error (perhaps due
      to measurement error) of the column sums. Below, we assume that all
      column sums have a standard error of 5%. This is a Bayesian prior,
      not a maintained hypothesis.
      The estimated error is weighted sum of elements in an error support
      set:
        ERR(ii) = sum(jwt, W(ii,jwt)*VBAR(ii,jwt))
      where the W's are estimated in the CE procedure.
      The prior variance of these errors is given by:
        (sigmay(ii))**2 = sum(jwt, WBAR(ii,jwt)*(VBAR(ii,jwt))**2)
      where the WBAR's are the prior on the weights.
      The VBARs are chosen to define a domain for the support set of +/- 3
      standard errors. The prior on the weights, WBAR, are then calculated
      to yield the specified prior on the standard error, sigmay.
      In Robinson, Cattaneo, and El-Said (2001), we specify prior weights
      (WBAR) that are uniform and set the prior standard error by the
      choice of support set, VBAR. In that paper, we use a three-weight
      specification (jwt / 1*3 /);
       
      We define two sets of errors with separate weights, W1 and W2. The
      first is for specifying errors on column sums, the second for errors
      on macro aggregates (defined in the set macro).
 240   
 241  * First, define standard error for errors on column sums.
 242  sigmay1(ii) = 0.05*target0(ii);
 243   
 244  * This code assumes a prior mean of zero and a two-parameter
 245  * distribution with specified prior standard error. There are three
 246  * weights, W(ii,jwt), to be estimated. The actual moments are estimated
 247  * as part of the estimation procedure.
 248   
      * Set constants for 3-weight error distribution
      vbar1(ii,"1") = -3*sigmay1(ii);
      vbar1(ii,"2") =  0;
      vbar1(ii,"3") = -3*sigmay1(ii);
       
      wbar1(ii,"1") =  1/18;
      wbar1(ii,"2") = 16/18;
      wbar1(ii,"3") =  1/18;
 259   
      This code assumes a prior mean of zero and a prior value of kurtosis
      consistent with a prior normal distribution with mean zero, variance
      sigmay**2, and kurtosis equal to 3*sigmay**4. The addition of a prior
      on kurtosis requires estimation of 5 weights (jwt = 5);
      The prior weights wbar are specified so that:
      sum(jwt, wbar(ii,jwt)*vbar(ii,jwt)**4) = 3*sigmay(ii,jwt)**4
      as well as defining the variance as above.
      The prior weights and support set are also symmetric, so the prior
      on all odd moments is zero. The choice of +/- 1 standard error
      for vbar(ii,"2") and vbar(ii,"4") is arbitrary.
      The actual moments are estimated as part of the estimation procedure.
 273   
 274  * Set constants for 5-weight error distribution
 275  vbar1(ii,"1") = -3*sigmay1(ii);
 276  vbar1(ii,"2") = -1*sigmay1(ii);
 277  vbar1(ii,"3") =  0;
 278  vbar1(ii,"4") =  1*sigmay1(ii);
 279  vbar1(ii,"5") =  3*sigmay1(ii);
 280   
 281  wbar1(ii,"1") =  1/72;
 282  wbar1(ii,"2") = 27/72;
 283  wbar1(ii,"3") = 16/72;
 284  wbar1(ii,"4") = 27/72;
 285  wbar1(ii,"5") =  1/72;
 286   
 287  * Second, define standard errors for errors on macro aggregates
 288  sigmay2("gdpfc2") = 0.05*gdpfc0;
 289  sigmay2("gdp2")   = 0.05*gdp0;
 290   
      * Set constants for 3-weight error distribution
      vbar2(ii,"1") = -3*sigmay2(ii);
      vbar2(ii,"2") =  0;
      vbar2(ii,"3") = -3*sigmay2(ii);
       
      wbar2(ii,"1") =  1/18;
      wbar2(ii,"2") = 16/18;
      wbar2(ii,"3") =  1/18;
 301   
 302  * Set constants for 5-weight error distribution
 303  vbar2(macro,"1") = -3*sigmay2(macro);
 304  vbar2(macro,"2") = -1*sigmay2(macro);
 305  vbar2(macro,"3") =  0;
 306  vbar2(macro,"4") =  1*sigmay2(macro);
 307  vbar2(macro,"5") =  3*sigmay2(macro);
 308   
 309  wbar2(macro,"1") =  1/72;
 310  wbar2(macro,"2") = 27/72;
 311  wbar2(macro,"3") = 16/72;
 312  wbar2(macro,"4") = 27/72;
 313  wbar2(macro,"5") =  1/72;
 314   
 315  display vbar1, vbar2, sigmay1, sigmay2;
 316   
 317  Variable
 318     A(ii,jj)      'post SAM coefficient matrix'
 319     TSAM(ii,jj)   'post matrix of SAM transactions'
 320     Y(ii)         'row sum of SAM'
 321     X(ii)         'column sum of SAM'
 322     ERR1(ii)      'error value on column sums'
 323     ERR2(macro)   'error value for macro aggregates'
 324     W1(ii,jwt)    'error weights'
 325     W2(macro,jwt) 'error weights'
 326     DENTROPY      'entropy difference (objective)'
 327     GDPFC         'GDP at factor cost'
 328     GDP           'GDP at market prices';
 329   
 330  * INITIALIZE VARIABLES
 331  A.l(ii,jj)      = Abar1(ii,jj);
 332  TSAM.l(ii,jj)   = T1(ii,jj);
 333  Y.l(ii)         = target0(ii);
 334  X.l(ii)         = target0(ii);
 335  ERR1.l(ii)      = 0.0;
 336  ERR2.l(macro)   = 0.0;
 337  W1.l(ii,jwt)    = wbar1(ii,jwt);
 338  W2.l(macro,jwt) = wbar2(macro,jwt);
 339  DENTROPY.l      = 0;
 340  GDPFC.l         = gdpfc0;
 341  GDP.l           = gdp0;
 342   
 343  * CORE EQUATIONS
 344  Equation
 345     SAMEQ(i)        'row and column sum constraint'
 346     SAMMAKE(i,j)    'make SAM flows'
 347     ERROR1EQ(i)     'definition of error term 1'
 348     ERROR2EQ(macro) 'definition of error term 2'
 349     SUMW1(i)        'sum of weights 1'
 350     SUMW2(macro)    'sum of weights 2'
 351     ENTROPY         'entropy difference definition'
 352     ROWSUM(i)       'row target'
 353     COLSUM(j)       'column target'
 354     GDPFCDEF        'define GDP at factor cost'
 355     GDPDEF          'define GDP';
 356   
 357  *CORE EQUATIONS
 358  SAMEQ(ii)..
 359     Y(ii) =e= X(ii) + ERR1(ii);
 360   
 361  SAMMAKE(ii,jj)$nonzero(ii,jj)..
 362     TSAM(ii,jj) =e= A(ii,jj)*(X(jj) + ERR1(jj));
 363   
 364  ERROR1EQ(ii)..
 365     ERR1(ii) =e= sum(jwt, W1(ii,jwt)*vbar1(ii,jwt));
 366   
 367  SUMW1(ii)..
 368     sum(jwt, W1(ii,jwt)) =e= 1;
 369   
 370  ENTROPY..
 371     DENTROPY =e= sum((ii,jj)$nonzero(ii,jj), A(ii,jj)*(log(A(ii,jj) + epsilon)
 372                                            - log(Abar1(ii,jj) + epsilon)))
 373               +  sum((ii,jwt), W1(ii,jwt)*(log(W1(ii,jwt) + epsilon)
 374                                 - log(wbar1(ii,jwt) + epsilon)))
 375               +  sum((macro,jwt), W2(macro,jwt)*(log(W2(macro,jwt) + epsilon)
 376                                 - log(wbar2(macro,jwt) + epsilon)));
 377   
 378  * Note that we exclude one rowsum equation since if all but one column
 379  * and rowsum are equal, the last one must also be equal. Walras' Law
 380  * at work.
 381  ROWSUM(ii)$(not sameas(ii,"ROW"))..
 382     sum(jj, TSAM(ii,jj)) =e= Y(ii);
 383   
 384  COLSUM(jj)..
 385     sum(ii, TSAM(ii,jj)) =e= (X(jj) + ERR1(jj));
 386   
 387  *ADDITIONAL MACRO CONTROL-TOTAL EQUATIONS
 388  GDPFCDEF..
 389     GDPFC =e= TSAM("fac","act") + ERR2("gdpfc2");
 390   
 391  GDPDEF..
 392     GDP   =e= TSAM("fac","act") + TSAM("gre","act")
 393            -  TSAM("act","gre") + TSAM("gre","com") + ERR2("gdp2");
 394   
 395  ERROR2EQ(macro)..
 396     ERR2(macro) =e= sum(jwt, W2(macro,jwt)*vbar2(macro,jwt));
 397   
 398  SUMW2(macro)..
 399     sum(jwt, W2(macro,jwt)) =e= 1;
 400   
      Define bounds for cell values
       
      Defining equation SAMMAKE over non-zero elements of A ($Abar1(ii,jj))
      guarantees that the zero structure of the original SAM is maintained
      in the estimated SAM. Fixing all the zero entries to zero greatly
      reduces the size of the estimation problem. If it is desired to
      allow a zero entry to become nonzero in the estimated SAM, then
      the condition $ABAR1(ii,jj) must be replaced with a new set that
      does not include cells which are currently zero but may be nonzero.
 412   
 413  A.lo(ii,jj)$nonzero(ii,jj)       = 0;
 414  A.up(ii,jj)$nonzero(ii,jj)       = 1;
 415  A.fx(ii,jj)$(not nonzero(ii,jj)) = 0;
 416   
 417  TSAM.lo(ii,jj) = 0.0;
 418  TSAM.up(ii,jj) = +inf;
 419  TSAM.fx(ii,jj)$(not nonzero(ii,jj)) = 0;
 420   
 421  * Upper and lower bounds on the error weights
 422  W1.lo(ii,jwt)    = 0;
 423  W1.up(ii,jwt)    = 1;
 424  W2.lo(macro,jwt) = 0;
 425  W2.up(macro,jwt) = 1;
 426   
 427  * Set target column sums, X. If these are not fixed, then the column sum
 428  * constraints will not be binding and the solution values or ERR1 will be 0.
 429  X.fx(ii) = TARGET0(ii);
 430   
 431  * Fix Macro aggregates.
 432  * If these are not fixed, then the macro constraints will not be binding
 433  * and the solution values of ERR2 will be zero.
 434  GDP.fx   = GDP0;
 435  GDPFC.fx = GDPFC0;
 436   
 437  Model SAMENTROP / all /;
 438   
 439  option iterLim = 5000, limRow = 0, limCol = 0, solPrint = on;
 440   
 441  * SAMENTROP.optFile   = 1;
 442    SAMENTROP.holdFixed = 1;
 443  * option nlp          = CONOPT;
 444  * SAMENTROP.workSpace = 25.0;
 445   
 446  solve SAMENTROP using nlp minimizing dentropy;


