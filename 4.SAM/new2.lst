  67     GIN            0.0         0.0        0.0        0.0
  68     CAP            0.0         0.0        0.0   150.0000
  69     ROW            0.0   5573.8150        0.0        0.0
  70     Total   18456.5180   20758.639   9805.414   3732.706
  71   
  72     +              HOU         GRE        GIN        CAP
  73     ACT      2101.0490     -0.3270        0.0        0.0
  74  *  COM      6753.3320   1764.5000  2118.5000  2197.7980
  75     COM      6953.3320   1564.5000  2518.5000  2597.7980
  76     FAC            0.0         0.0        0.0        0.0
  77     ENT            0.0     33.0000        0.0        0.0
  78     HOU            0.0     29.6000        0.0        0.0
  79     GRE       139.5000         0.0        0.0        0.0
  80     GIN            0.0         0.0        0.0        0.0
