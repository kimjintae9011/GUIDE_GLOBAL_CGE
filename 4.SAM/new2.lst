  95     Total     5573.815            ;
  96   
  97  * Parameters and Scalars
  98  Parameter
  99     SAM0(i,j)        'base SAM transactions matrix'
 100     T0(i,j)          'matrix of SAM transactions (flow matrix)'
 101     T1(i,j)          'SAM transactions adjusted to eliminate negative entries'
 102     Abar0(i,j)       'prior SAM coefficient matrix'
 103     Abar1(i,j)       'prior SAM adjusted to eliminate negative coefficients'
 104     Target0(i)       'targets for macro SAM column totals'
 105     epsilon          'tolerance to allow zero entries in SAM';
 106   
 107  Scalar
 108     gdp0   'base GDP'
 109     gdp00  'GDP from final SAM'
 110     gdpfc0 'GDP at factor cost';
 111   
 112  * Initializing Parameters
 113  SAM("TOTAL",jj) = sum(ii, SAM(ii,jj));
 114  SAM(ii,"TOTAL") = sum(jj, SAM(ii,jj));
 115  sam0(i,j)       = sam(i,j);
 116   
 117  * Divide SAM entries by 1000 for better scaling.
 118  * The SAM is scaled to enhance solver efficiency. Nonlinear solvers are
 119  * more efficient if variables are scaled similarly. In this case,
 120  * coefficients to be estimated range between 0 and 1, so SAM values
 121  * are also scaled.
 122   
 123  Scalar scalesam 'scaling value' / 1000 /;
 124   
 125  sam(i,j)                = sam(i,j)/scalesam ;
 126  Abar0(ii,jj)$SAM(ii,jj) = SAM(ii,jj)/SAM("TOTAL",jj);
 127   
 128  T0(ii,jj)      = SAM(ii,jj);
 129  T0("TOTAL",jj) = sum(ii, SAM(ii,jj));
 130  T0(ii,"TOTAL") = sum(jj, SAM(ii,jj));
 131   
 132  epsilon = .00001;
 133   
 134  display T0, Abar0;
 135   
      CROSS ENTROPY
      RED ALERT!!!
       
      The ENTROPY DIFFERENCE procedure uses LOGARITHMS: negative flows in
      the SAM are NOT GOOD!!!
       
      The option used here is to detect any negative flows and net them out
      of their respective symmetric cells, e.g.
          negative flow column to row is set to zero
          and added to corresponding row to column as a positive number.
      The entropy difference method can then be implemented.
      After balancing, the negative SAM values are returned to their
      original cells for printing.
 151   
 152  Set red(i,j) 'set of negative SAM flows';
 153   
 154  Parameter
 155     redsam(i,j) 'negative SAM values only'
 156     rtot(i)     'row total'
 157     ctot(i)     'column total';
 158   
 159  rtot(ii) = sum(jj, T0(ii,jj));
 160  ctot(jj) = sum(ii, T0(ii,jj));
 161   
 162  red(ii,jj)$(T0(ii,jj) < 0) = yes;
 163  redsam(ii,jj)              = 0;
 164  redsam(ii,jj)$red(ii,jj)   = T0(ii,jj);
 165  redsam(jj,ii)$red(ii,jj)   = T0(ii,jj);
 166   
 167  *Note that redsam includes each entry twice, in corresponding row
 168  *and column. So, redsam need only be subtracted from T0.
 169  T1(ii,jj)      = T0(ii,jj) - redsam(ii,jj);
 170  T1("Total",jj) = sum(ii, T1(ii,jj));
 171  T1(ii,"Total") = sum(jj, T1(ii,jj));
 172   
 173  redsam("total",jj) = sum(ii, redsam(ii,jj));
 174  redsam(ii,"total") = sum(jj, redsam(ii,jj));
 175   
 176  sam(ii,"total") = sum(jj, T1(ii,jj));
 177  sam("total",jj) = sum(ii, T1(ii,jj));
 178   
 179  rtot(ii) = sum(jj, T1(ii,jj));
 180  ctot(jj) = sum(ii, T1(ii,jj));
 181   
 182  Abar1(ii,jj) = T1(ii,jj)/sam("total",jj);
 183   
 184  display "NON-NEGATIVE SAM", redsam, T1, Abar0, Abar1, rtot, ctot;
 185   
 186  * Define set of elements of SAM that can be nonzero. In this case, only
 187  * elements which are nonzero in initial SAM.
 188  Set NONZERO(i,j) 'SAM elements that can be nonzero';
 189  *NONZERO(ii,jj)$(Abar1(ii,jj)) = yes;
 190  NONZERO(ii,jj)$(Abar1(ii,jj) > 1e-10) = yes;
 191   
 192  * Initializing Parameters after accounting for negative values
 193  *   Note that target column sums are being set to average of initial
 194  *   row and column sums. Initial column sums or other values
 195  *   could have been used instead, depending on knowledge of data quality
 196  *   and any other prior information.
 197  target0(ii) = (sam(ii,"total") + sam("total",ii))/2;
 198  gdpfc0 = T1("fac","act");
 199  gdp0   = T1("fac","act") + T1("gre","act") - T1("act","gre") + T1("gre","com");
 200   
 201  display gdpfc0, gdp0;
 202   
 203  Variable
 204     A(ii,jj)      'post SAM coefficient matrix'
 205     TSAM(ii,jj)   'post matrix of SAM transactions'
 206     Y(ii)         'row sum of SAM'
 207     X(ii)         'column sum of SAM'
 208     DENTROPY      'entropy difference (objective)'
 209     GDPFC         'GDP at factor cost'
 210     GDP           'GDP at market prices';
 211   
 212  * INITIALIZE VARIABLES
 213  A.l(ii,jj)      = Abar1(ii,jj);
 214  TSAM.l(ii,jj)   = T1(ii,jj);
 215  Y.l(ii)         = target0(ii);
 216  X.l(ii)         = target0(ii);
 217  DENTROPY.l      = 0;
 218  GDPFC.l         = gdpfc0;
 219  GDP.l           = gdp0;
 220   
 221  * CORE EQUATIONS
 222  Equation
 223     SAMEQ(i)        'row and column sum constraint'
 224     SAMMAKE(i,j)    'make SAM flows'
 225     ENTROPY         'entropy difference definition'
 226     ROWSUM(i)       'row target'
 227     COLSUM(j)       'column target'
 228     GDPFCDEF        'define GDP at factor cost'
 229     GDPDEF          'define GDP';
 230   
 231  *CORE EQUATIONS
 232  SAMEQ(ii)..
 233     Y(ii) =e= X(ii) ;
 234   
 235  SAMMAKE(ii,jj)$nonzero(ii,jj)..
 236     TSAM(ii,jj) =e= A(ii,jj)*X(jj);
 237   
 238  ENTROPY..
 239     DENTROPY =e= sum((ii,jj)$nonzero(ii,jj), A(ii,jj)*(log(A(ii,jj) + epsilon)
 240                                            - log(Abar1(ii,jj) + epsilon))) ;
 241   
 242  * Note that we exclude one rowsum equation since if all but one column
 243  * and rowsum are equal, the last one must also be equal. Walras' Law
 244  * at work.
 245  ROWSUM(ii)$(not sameas(ii,"ROW"))..
 246     sum(jj, TSAM(ii,jj)) =e= Y(ii);
 247   
 248  COLSUM(jj)..
 249     sum(ii, TSAM(ii,jj)) =e= X(jj);
 250   
 251  *ADDITIONAL MACRO CONTROL-TOTAL EQUATIONS
 252  GDPFCDEF..
 253     GDPFC =e= TSAM("fac","act") ;
 254   
 255  GDPDEF..
 256     GDP   =e= TSAM("fac","act") + TSAM("gre","act")
 257            -  TSAM("act","gre") + TSAM("gre","com") ;
      Define bounds for cell values
       
      Defining equation SAMMAKE over non-zero elements of A ($Abar1(ii,jj))
      guarantees that the zero structure of the original SAM is maintained
      in the estimated SAM. Fixing all the zero entries to zero greatly
      reduces the size of the estimation problem. If it is desired to
      allow a zero entry to become nonzero in the estimated SAM, then
      the condition $ABAR1(ii,jj) must be replaced with a new set that
      does not include cells which are currently zero but may be nonzero.
 269   
 270  A.lo(ii,jj)$nonzero(ii,jj)       = 0;
 271  A.up(ii,jj)$nonzero(ii,jj)       = 1;
 272  A.fx(ii,jj)$(not nonzero(ii,jj)) = 0;
 273   
 274  TSAM.lo(ii,jj) = 0.0;
 275  TSAM.up(ii,jj) = +inf;
 276  TSAM.fx(ii,jj)$(not nonzero(ii,jj)) = 0;
 277   
 278   
 279  * Set target column sums, X. If these are not fixed, then the column sum
 280  * constraints will not be binding and the solution values or ERR1 will be 0.
 281  X.fx(ii) = TARGET0(ii);
 282   
 283  * Fix Macro aggregates.
 284  * If these are not fixed, then the macro constraints will not be binding
 285  * and the solution values of ERR2 will be zero.
 286  GDP.fx   = GDP0;
 287  GDPFC.fx = GDPFC0;
 288   
 289  Model SAMENTROP / all /;
 290   
 291  option iterLim = 5000, limRow = 0, limCol = 0, solPrint = on;
 292   
 293  * SAMENTROP.optFile   = 1;
 294    SAMENTROP.holdFixed = 1;
 295  * option nlp          = CONOPT;
 296  * SAMENTROP.workSpace = 25.0;
 297   
 298  solve SAMENTROP using nlp minimizing dentropy;
 299   
 300  Alias (macro,a_macro), (ii,a_ii), (jj,a_jj);
 301   
 302  Variable
 303     m_SAMEQ(i)        'multiplier for row and column sum constraint'
 304     m_SAMMAKE(i,j)    'multiplier for make SAM flows constraint'
 305     m_ROWSUM(i)       'multiplier for row target constraint'
 306     m_COLSUM(j)       'multiplier for column target constraint'
 307     m_GDPFCDEF        'multiplier for GDP at factor cost constraint'
 308     m_GDPDEF          'multiplier for GDP at market pricesconstraint';
 309   
 310  * EQUATIONS FOR THE FIRST ORDER CONDITIONS
 311  * FOR MINIMIZING THE OBJECTIVE FUNCTION
 312  Equation
 313     d_A(a_ii,a_jj)      'FOC wrt the choice variable A'
 314     d_TSAM(a_ii,a_jj)   'FOC wrt the variable TSAM'
 315     d_Y(a_ii)           'FOC wrt the variable Y'
 316     d_X(a_ii)           'FOC wrt the variable X'
 317     d_GDPFC             'FOC wrt the macro control variable GDPFC'
 318     d_GDP               'FOC wrt the macro control variable GDP';
 319   
 320  * EQUATION: FOC wrt the choice variable A
 321  d_A(a_ii,a_jj)..
 322         ((log(a(a_ii,a_jj) + epsilon) - log(abar1(a_ii,a_jj)  + epsilon))
 323         $(nonzero(a_ii,a_jj)) + a(a_ii,a_jj)*(1/(a(a_ii,a_jj) + epsilon))
 324         $(nonzero(a_ii,a_jj)))
 325      -  sum((ii,jj)$(nonzero(ii,jj)), m_sammake(ii,jj)*(-(1$((sameas
 326         (a_ii,ii) and sameas(a_jj,jj))))*(x(jj))))
 327     =e= 0;
 328   
 329  * EQUATION: FOC wrt the variable TSAM
 330  d_TSAM(a_ii,a_jj)..
 331      -  m_gdpfcdef*(-(1$((sameas(a_ii,"fac") and sameas(a_jj,"act")))))
 332      -  m_colsum(a_jj)
 333      -  m_gdpdef*(-(1$((sameas(a_ii,"fac") and sameas(a_jj,"act")))
 334         +1$((sameas(a_ii,"gre") and sameas(a_jj,"act"))) - (1$((sameas
 335         (a_ii,"act") and sameas(a_jj,"gre"))))+1$((sameas(a_ii,"gre")
 336         and sameas(a_jj,"com")))))
 337      -  m_rowsum(a_ii)$((not sameas(a_ii,"ROW")))
 338      -  m_sammake(a_ii,a_jj)$(nonzero(a_ii,a_jj))
 339     =e= 0;
 340   
 341  * EQUATION: FOC wrt the variable Y
 342  d_Y(a_ii)..
 343      -  m_sameq(a_ii)
 344      -  sum((ii)$((not sameas(ii,"ROW"))),m_rowsum(ii)*(-(1$((sameas(a_ii,ii))))))
 345     =e= 0;
 346   
 347  * EQUATION FOC wrt the variable X
 348  d_X(a_ii)..
 349      -  sum(jj, m_colsum(jj)*(-(1$((sameas(a_ii,jj))))))
 350      -  sum(ii, m_sameq(ii) *(-(1$((sameas(a_ii,ii))))))
 351      -  sum((ii,jj)$(nonzero(ii,jj)), m_sammake(ii,jj)*(-a(ii,jj)*(1$((sameas(a_ii,jj))))))
 352     =e= 0;
 353   
 354  * EQUATION: FOC wrt the macro control variable GDPFC
 355  d_GDPFC..
 356     - m_gdpfcdef =e= 0;
 357   
 358  * EQUATION: FOC wrt the macro control variable GDP
 359  d_GDP..
 360     - m_gdpdef =e= 0;
 361   
 362  * DEFINE MODEL
 363  * In GAMS the "." is used for pairing the complementarity variables
 364  * and equations for the MCP solver. For example the equation
 365  * defined by d_A is complementary to the variable A and must be
 366  * defined over the same sets.
 367  Model m_SAMENTROP / d_A.A, d_TSAM.TSAM
 368                      d_Y.Y
 369                      d_X.X
 370                      d_GDPFC.GDPFC
 371                      d_GDP.GDP
 372                      GDPFCDEF.m_GDPFCDEF
 373                      COLSUM.m_COLSUM
 374                      SAMEQ.m_SAMEQ
 375                      GDPDEF.m_GDPDEF
 376                      ROWSUM.m_ROWSUM
 377                      SAMMAKE.m_SAMMAKE /;
 378   
 379  * SOLVE MODEL
 380  * Shock the NLP solution
 381  A.l(ii,jj) = 0.9*A.l(ii,jj);
 382   
 383  solve m_SAMENTROP using mcp;
 384   
 385  execute_unload "SAM_BAL" ;
 386   
