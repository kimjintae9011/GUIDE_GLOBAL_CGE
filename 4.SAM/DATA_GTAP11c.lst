1191  *==============================================================================
1192  * 4.1 Real GDP projections
1193  *==============================================================================
1194   
1195  loop{time$[time.val lt 2100],
1196   g_GDP(z,time+1)           = [GDP(z,time+1)/GDP(z,time)]-1;
1197  };
1198   g_GDP(z,time)$[time.val ge 2100]
1199                           = g_GDP(z,time+2);
1200   
1201  *==============================================================================
1202  * 4.2 Total population projections
1203  *==============================================================================
1204   
1205  loop{time$[time.val lt 2100],
1206   g_POP(z,time+1)           = [TOT_POP(z,time+1)/TOT_POP(z,time)]-1;
1207  };
1208   g_POP(z,time)$[time.val ge 2100]
1209                           = g_POP(z,time+1);
1210   
