**** 257  Solve statement not checked because of previous errors
2341   
      *=================================================================================
      Alias (macro,a_macro), (INT,a_INT), (JNT,a_JNT);
       
      Variable
         m_SAMEQ(A)        'multiplier for row and column sum constraint'
         m_SAMMAKE(A,B)    'multiplier for make SAM flows constraint'
         m_ROWSUM(A)       'multiplier for row target constraint'
         m_COLSUM(B)       'multiplier for column target constraint'
      *   m_GDPFCDEF        'multiplier for GDP at factor cost constraint'
      *   m_GDPDEF          'multiplier for GDP at market pricesconstraint'
      ;
       
      * EQUATIONS FOR THE FIRST ORDER CONDITIONS
      * FOR MINIMIZING THE OBJECTIVE FUNCTION
      Equation
         d_A(a_INT,a_JNT)      'FOC wrt the choice variable A'
         d_TSAM(a_INT,a_JNT)   'FOC wrt the variable TSAM'
         d_Y(a_INT)           'FOC wrt the variable Y'
         d_X(a_INT)           'FOC wrt the variable X'
      *   d_GDPFC             'FOC wrt the macro control variable GDPFC'
      *   d_GDP               'FOC wrt the macro control variable GDP'
      ;
       
      * EQUATION: FOC wrt the choice variable A
      d_A(a_INT,a_JNT)..
             ((log(A_MAT(a_INT,a_JNT) + epsilon) - log(abar1(a_INT,a_JNT)  + epsilon))
             $(nonzero(a_INT,a_JNT)) + a_MAT(a_INT,a_JNT)*(1/(a_MAT(a_INT,a_JNT) + epsilon))
             $(nonzero(a_INT,a_JNT)))
          -  sum((INT,JNT)$(nonzero(INT,JNT)), m_sammake(INT,JNT)*(-(1$((sameas
             (a_INT,INT) and sameas(a_JNT,JNT))))*(x(JNT))))
         =e= 0;
       
      * EQUATION: FOC wrt the variable TSAM
      d_TSAM(a_INT,a_JNT)..
      *    -  m_gdpfcdef*(-(1$((sameas(a_INT,"fac") and sameas(a_JNT,"act")))))
          -  m_colsum(a_JNT)
      *    -  m_gdpdef*(-(1$((sameas(a_INT,"fac") and sameas(a_JNT,"act")))
      *       +1$((sameas(a_INT,"gre") and sameas(a_JNT,"act"))) - (1$((sameas
      *       (a_INT,"act") and sameas(a_JNT,"gre"))))+1$((sameas(a_INT,"gre")
      *       and sameas(a_JNT,"com")))))
          -  m_rowsum(a_INT)$((not sameas(a_INT,"173_GOVT")))
          -  m_sammake(a_INT,a_JNT)$(nonzero(a_INT,a_JNT))
         =e= 0;
       
      * EQUATION: FOC wrt the variable Y
      d_Y(a_INT)..
          -  m_sameq(a_INT)
          -  sum((INT)$((not sameas(INT,"173_GOVT"))),m_rowsum(INT)*(-(1$((sameas(a_INT,INT))))))
         =e= 0;
       
      * EQUATION FOC wrt the variable X
      d_X(a_INT)..
          -  sum(JNT, m_colsum(JNT)*(-(1$((sameas(a_INT,JNT))))))
          -  sum(INT, m_sameq(INT) *(-(1$((sameas(a_INT,INT))))))
          -  sum((INT,JNT)$(nonzero(INT,JNT)), m_sammake(INT,JNT)*(-a_MAT(INT,JNT)*(1$((sameas(a_INT,JNT))))))
         =e= 0;
       
      * EQUATION: FOC wrt the macro control variable GDPFC
      *d_GDPFC..
      *   - m_gdpfcdef =e= 0;
       
      * EQUATION: FOC wrt the macro control variable GDP
      *d_GDP..
      *   - m_gdpdef =e= 0;
       
      * DEFINE MODEL
      * In GAMS the "." is used for pairing the complementarity variables
      * and equations for the MCP solver. For example the equation
      * defined by d_A is complementary to the variable A and must be
      * defined over the same sets.
      Model m_SAMENTROP / d_A.A_MAT, d_TSAM.TSAM
                          d_Y.Y
                          d_X.X
                          COLSUM.m_COLSUM
                          SAMEQ.m_SAMEQ
                          ROWSUM.m_ROWSUM
                          SAMMAKE.m_SAMMAKE
      *                    d_GDPFC.GDPFC
      *                    d_GDP.GDP
      *                    GDPFCDEF.m_GDPFCDEF
       
      *                    GDPDEF.m_GDPDEF
       /;
       
      * SOLVE MODEL
      * Shock the NLP solution
      A_MAT.l(INT,JNT) = 0.9*A_MAT.l(INT,JNT);
       
      solve m_SAMENTROP using mcp;
