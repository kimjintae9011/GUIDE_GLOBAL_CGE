1179  *==============================================================================
1180  * 4.1 Real GDP projections
1181  *==============================================================================
1182   
1183  loop{time$[time.val lt 2100],
1184   g_GDP(z,time+1)           = [GDP(z,time+1)/GDP(z,time)]-1;
1185  };
1186   g_GDP(z,time)$[time.val ge 2100]
1187                           = g_GDP(z,time+2);
1188   
1189  *==============================================================================
1190  * 4.2 Total population projections
1191  *==============================================================================
1192   
1193  loop{time$[time.val lt 2100],
1194   g_POP(z,time+1)           = [TOT_POP(z,time+1)/TOT_POP(z,time)]-1;
1195  };
1196   g_POP(z,time)$[time.val ge 2100]
1197                           = g_POP(z,time+1);
1198   
