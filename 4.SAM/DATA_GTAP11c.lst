2081  *============ 2.Initial matrix ===========================================
2082  Table SAM_Initial(A,B,z) initial matrix ;
2083   
2084  *SAM_Initial(INT,JNT,z) = EPS;
2085   
2086  *Acitivities
2087  SAM_Initial(C1,A1,Z)    = SUM[(i,j)$[sam_sce2(C1,i)$sam_sce1(A1,j)], DIO(i,j,Z)];
2088  SAM_Initial(L1,A1,Z)    = SUM[(l,j)$[sam_sce3(L1,l)$sam_sce1(A1,j)], LDO2(l,j,Z)];
2089  SAM_Initial(K1,A1,Z)    = SUM[(k,j)$[sam_sce4(K1,k)$sam_sce1(A1,j)], RKDO(k,j,Z)];
2090  SAM_Initial(tf1,A1,Z)    = SUM[(l,j)$[sam_sce7(tf1,l)$sam_sce1(A1,j)], TIWO2(l,j,Z)];
2091  SAM_Initial(tf2,A1,Z)    = SUM[(k,j)$[sam_sce8(tf2,k)$sam_sce1(A1,j)], TIKO(k,j,Z)];
2092  SAM_Initial(PTX1,A1,Z) = SUM[(j)$[sam_sce1(A1,j)], TIPO(j,Z)];
2093   
2094   
2095  *Commodities
2096  SAM_Initial(A1,C1,Z)          = SUM[(i,j)$[sam_sce1(A1,j)$sam_sce2(C1,i)],  XSO(j,i,z)];
2097  SAM_Initial(ITAX1,C1,Z)     = SUM[(i,zj)$[sam_sce5(ITAX1,zj)$sam_sce2(C1,i)], TIMO(i,zj,Z)];
2098  SAM_Initial(ETAX1,C1,Z)    = SUM[(i,zj)$[sam_sce6(ETAX1,zj)$sam_sce2(C1,i)], TIXO(i,Z,zj)];
2099  SAM_Initial(MAR1,C1,Z)     = SUM[(ij,zj)$[sam_sce9(MAR1,zj)$sam_sce2(C1,ij)],tmrg('20_LTRP',ij,zj,Z)];
2100  SAM_Initial(MAR2,C1,Z)     = SUM[(ij,zj)$[sam_sce10(MAR2,zj)$sam_sce2(C1,ij)],tmrg('21_WTRP',ij,zj,Z)];
2101  SAM_Initial(MAR3,C1,Z)     = SUM[(ij,zj)$[sam_sce11(MAR3,zj)$sam_sce2(C1,ij)],tmrg('22_ATRP',ij,zj,Z)];
2102  SAM_Initial(WORLD1,C1,Z) = SUM[(i,zj)$[sam_sce12(WORLD1,zj)$sam_sce2(C1,i)], IMO(i,zj,Z)];
2103  SAM_Initial(PTX1,C1,Z)      = SUM[(i)$[sam_sce2(C1,i)], TICO(i,Z)];
2104   
2105  *Factors
2106  SAM_Initial(PRI1,L1,Z)  = sum{(l)$[sam_sce3(L1,l)],LDO2_J(l,Z)};
2107  SAM_Initial(PRI1,K1,Z)  = sum{(k)$[sam_sce4(K1,k)],RKDO_J(k,Z)};
2108  SAM_Initial(DTX1,L1,Z)  = sum{(l)$[sam_sce3(L1,l)],DTAX(l,Z)};
2109  SAM_Initial(DTX1,K1,Z)  = sum{(k)$[sam_sce4(K1,k)],DTAX(k,Z)};
2110   
2111  *Import tariffs
2112  SAM_Initial(PTX1,ITAX1,Z) = SUM[(zj)$[sam_sce5(ITAX1,zj)], sum(i,TIMO(i,zj,Z))];
2113   
2114  *Export taxes
2115  SAM_Initial(PTX1,ETAX1,Z) = SUM[(zj)$[sam_sce6(ETAX1,zj)], sum(i,TIXO(i,Z,zj))];
2116   
2117  *Factor taxes
2118  SAM_Initial(PTX1,tf1,Z)  = sum{(l)$[sam_sce7(tf1,l)],sum(j,TIWO2(l,j,Z))};
2119  SAM_Initial(PTX1,tf2,Z)  = sum{(k)$[sam_sce8(tf2,k)],sum(j,TIKO(k,j,Z))};
2120   
2121  *Transaction cost
2122  SAM_Initial('150_M1c20_L_pvst',MAR1,Z) = SUM[(zj)$[sam_sce9(MAR1,zj)],sum(ij,tmrg('20_LTRP',ij,zj,Z))];
2123  SAM_Initial('151_M2c21_W_pvst',MAR2,Z) = SUM[(zj)$[sam_sce10(MAR2,zj)],sum(ij,tmrg('21_WTRP',ij,zj,Z))];
2124  SAM_Initial('152_M3c22_A_pvst',MAR3,Z) = SUM[(zj)$[sam_sce11(MAR3,zj)],sum(ij,tmrg('22_ATRP',ij,zj,Z))];
2125   
2126  SAM_Initial('51_c_LTRP','150_M1c20_L_pvst',Z)= MRGNO('20_LTRP',Z);
2127  SAM_Initial('52_c_WTRP','151_M2c21_W_pvst',Z)= MRGNO('21_WTRP',Z);
2128  SAM_Initial('53_c_ATRP','152_M3c22_A_pvst',Z)= MRGNO('22_ATRP',Z);
2129   
2130  SAM_Initial(INV1,'150_M1c20_L_pvst',Z)  = sum(B,SAM_Initial('150_M1c20_L_pvst',B,Z))-SAM_Initial('51_c_LTRP','150_M1c20_L_pvst',Z);
2131  SAM_Initial(INV1,'151_M2c21_W_pvst',Z) = sum(B,SAM_Initial('151_M2c21_W_pvst',B,Z))-SAM_Initial('52_c_WTRP','151_M2c21_W_pvst',Z);
2132  SAM_Initial(INV1,'152_M3c22_A_pvst',Z)  = sum(B,SAM_Initial('152_M3c22_A_pvst',B,Z))-SAM_Initial('53_c_ATRP','152_M3c22_A_pvst',Z);
2133   
2134  *Import&Export
2135  SAM_Initial(C1,WORLD1,Z)= SUM[(i,zj)$[sam_sce12(WORLD1,zj)$sam_sce2(C1,i)],EXO(i,Z,zj)];
2136   
2137  *Balance of Trade
2138  SAM_Initial(INV1,WORLD1,Z)= SUM(B,SAM_Initial(WORLD1,B,Z))-SUM(C1,SAM_Initial(C1,WORLD1,Z));
2139   
2140  *Household
2141  SAM_Initial(C1,PRI1,Z)= SUM[(i)$[sam_sce2(C1,I)], CO(i,Z)];
2142  SAM_Initial(INV1,PRI1,Z)= SUM(B,SAM_Initial(PRI1,B,Z))- SUM(C1,SAM_Initial(C1,PRI1,Z));
2143   
2144  *Indirect tax
2145  SAM_Initial(GOV1,PTX1,Z)= SUM(B,SAM_Initial(PTX1,B,Z));
2146   
2147  *Direct tax
2148  SAM_Initial(GOV1,DTX1,Z)= SUM(B,SAM_Initial(DTX1,B,Z));
2149   
2150  *Government
2151  SAM_Initial(C1,GOV1,Z)= SUM[(i)$[sam_sce2(C1,I)], CGO(i,Z)];
2152   
2153  *Saving-Investment
2154  SAM_Initial(C1,INV1,Z)= SUM[(i)$[sam_sce2(C1,I)], INVO(i,Z)];
2155  SAM_Initial(INV1,GOV1,Z)= SUM(C1, SAM_Initial(C1,INV1,Z))-SUM(B,SAM_Initial(INV1,B,Z));
2156   
2157  *Total
2158  SAM_Initial('175_TOT',B,Z)= SUM(A,SAM_Initial(A,B,Z));
2159  SAM_Initial(A,'175_TOT',Z)= SUM(B,SAM_Initial(A,B,Z));
2160   
2161   
2162  Parameter
2163     SAM0(A,B)        'base SAM transactions matrix'
2164     T0(A,B)            'matrix of SAM transactions (flow matrix)'
2165     T1(A,B)            'SAM transactions adjusted to eliminate negative entries'
2166     Abar0(A,B)       'prior SAM coefficient matrix'
2167     Abar1(A,B)       'prior SAM adjusted to eliminate negative coefficients'
2168     Target0(A)       'targets for macro SAM column totals'
2169     epsilon           'tolerance to allow zero entries in SAM'
2170     ;
2171  * Initializing Parameters
2172  SAM0("175_TOT",JNT) = sum(INT, SAM_Initial(INT,JNT,'06_PRK'));
2173  SAM0(INT,"175_TOT") = sum(JNT, SAM_Initial(INT,JNT,'06_PRK'));
2174  SAM0(A,B)  = SAM_Initial(A,B,'06_PRK');
2175   
2176   
2177  Scalar scalesam 'scaling value' / 1000 /;
2178  *sam(A,B)                = sam(A,B)/scalesam ;
2179  SAM_Initial(A,B,'06_PRK') = SAM_Initial(A,B,'06_PRK')/scalesam ;
2180   
2181  Abar0(INT,JNT)$SAM_Initial(INT,JNT,'06_PRK')= SAM_Initial(INT,JNT,'06_PRK')/SAM_Initial("175_TOT",JNT,'06_PRK');
2182   
2183  T0(INT,JNT)             = SAM_Initial(INT,JNT,'06_PRK');
2184  T0("175_TOT",JNT)  = sum(INT, SAM_Initial(INT,JNT,'06_PRK'));
2185  T0(INT,"175_TOT")   = sum(JNT, SAM_Initial(INT,JNT,'06_PRK'));
2186   
2187  epsilon = .00001;
2188   
2189  display T0, Abar0;
2190   
2191   
2192  Set red(A,B) 'set of negative SAM flows';
2193   
2194  Parameter
2195     redsam(A,B) 'negative SAM values only'
2196     rtot(A)     'row total'
2197     ctot(A)     'column total';
2198   
2199  rtot(INT) = sum(JNT, T0(INT,JNT));
2200  ctot(JNT) = sum(INT, T0(INT,JNT));
2201   
2202  red(INT,JNT)$(T0(INT,JNT) < 0) = yes;
2203  redsam(INT,JNT)              = 0;
2204  redsam(INT,JNT)$red(INT,JNT)   = T0(INT,JNT);
2205  redsam(JNT,INT)$red(INT,JNT)   = T0(INT,JNT);
2206   
2207  *Note that redsam includes each entry twice, in corresponding row
2208  *and column. So, redsam need only be subtracted from T0.
2209  T1(INT,JNT)      = T0(INT,JNT) - redsam(INT,JNT);
2210  T1("175_TOT",JNT) = sum(INT, T1(INT,JNT));
2211  T1(INT,"175_TOT") = sum(JNT, T1(INT,JNT));
2212   
2213  redsam("175_TOT",JNT) = sum(INT, redsam(INT,JNT));
2214  redsam(INT,"175_TOT") = sum(JNT, redsam(INT,JNT));
2215   
2216  SAM_Initial(INT,"175_TOT",'06_PRK') = sum(JNT, T1(INT,JNT));
2217  SAM_Initial("175_TOT",JNT,'06_PRK')= sum(INT, T1(INT,JNT));
2218   
2219  rtot(INT) = sum(JNT, T1(INT,JNT));
2220  ctot(JNT) = sum(INT, T1(INT,JNT));
2221   
2222  Abar1(INT,JNT)$SAM_Initial(INT,JNT,'06_PRK') = T1(INT,JNT)/SAM_Initial("175_TOT",JNT,'06_PRK');
2223  *Abar1(INT,JNT) = T1(INT,JNT)/(SAM_Initial("175_TOT",JNT,'06_PRK')+0.000000000000001);
2224   
2225  display "NON-NEGATIVE SAM", redsam, T1, Abar0, Abar1, rtot, ctot;
2226   
2227  * Define set of elements of SAM that can be nonzero. In this case, only
2228  * elements which are nonzero in initial SAM.
2229  Set NONZERO(A,B) 'SAM elements that can be nonzero';
2230  NONZERO(INT,JNT)$(Abar1(INT,JNT)) = yes;
2231   
2232  * Initializing Parameters after accounting for negative values
2233  *   Note that target column sums are being set to average of initial
2234  *   row and column sums. Initial column sums or other values
2235  *   could have been used instead, depending on knowledge of data quality
2236  *   and any other prior information.
2237  target0(INT) = (SAM_Initial(INT,"175_TOT",'06_PRK') + SAM_Initial("175_TOT",INT,'06_PRK'))/2;
2238  *target0(INT) = SAM_Initial(INT,"175_TOT",'06_PRK') ;
2239   
2240  Scalar
2241     gdpfc0 'GDP at factor cost'
2242     gdp0   'base GDP'
2243     gdp00  'GDP from final SAM'
2244     ;
2245   
2246  gdpfc0 = SUM((FACTOR,A1),SAM_Initial(FACTOR,A1,'06_PRK'));
2247  gdp0 = gdpfc0
2248  *Import tariffs
2249  + SUM((ITAX1,C1),SAM_Initial(ITAX1,C1,'06_PRK'))
2250  *Export taxes
2251  + SUM((ETAX1,C1),SAM_Initial(ETAX1,C1,'06_PRK'))
2252  *Factor use taxes
2253  + SUM((TF,A1),SAM_Initial(TF,A1,'06_PRK'))
2254  *Production taxes
2255  + SUM(A1,SAM_Initial('171_PRODTAX',A1,'06_PRK'))
2256  *Income taxes
2257  + SUM((FTAX,A1),SAM_Initial(FTAX,A1,'06_PRK'))
2258  ;
2259   
2260   
2261  Variable
2262     A_MAT(A,B)          'post SAM coefficient matrix'
2263     TSAM(A,B)    'post matrix of SAM transactions'
2264     Y(A)                'row sum of SAM'
2265     X(B)                'column sum of SAM'
2266     DENTROPY          'entropy difference (objective)'
2267     GDPFC_SAM                'GDP at factor cost'
2268     GDP_SAM                    'GDP at market prices'
2269     ;
2270   
2271  * INITIALIZE VARIABLES
2272  A_MAT.l(A,B)         = Abar1(A,B);
2273  TSAM.l(A,B)   = T1(A,B);
2274  Y.l(A)               = target0(A);
2275  X.l(A)               = target0(A);
2276  DENTROPY.l         = 0;
2277  GDPFC_SAM.l               = gdpfc0;
2278  GDP_SAM.l                   = gdp0;
2279   
2280  * CORE EQUATIONS
2281  Equation
2282     SAMEQ(A)         'row and column sum constraint'
2283     SAMMAKE(A,B)  'make SAM flows'
2284     ENTROPY          'entropy difference definition'
2285     ROWSUM(A)      'row target'
2286     COLSUM(B)       'column target'
2287     GDPFCDEF        'define GDP at factor cost'
2288     GDPDEF            'define GDP'
2289  ;
2290  *CORE EQUATIONS
2291  SAMEQ(INT)..   Y(INT) =e= X(INT) ;
2292   
2293  SAMMAKE(INT,JNT)$nonzero(INT,JNT).. TSAM(INT,JNT) =e= A_MAT(INT,JNT)*X(JNT);
2294   
2295  ENTROPY..   DENTROPY =e= sum((INT,JNT)$nonzero(INT,JNT), A_MAT(INT,JNT)*(log(A_MAT(INT,JNT) + epsilon) - log(Abar1(INT,JNT) + epsilon))) ;
2296   
2297  * Note that we exclude one rowsum equation since if all but one column
2298  * and rowsum are equal, the last one must also be equal. Walras' Law
2299  * at work.
2300   
2301  ROWSUM(INT)$(not sameas(INT,"173_GOVT"))..   sum(JNT, TSAM(INT,JNT)) =e= Y(INT);
2302  *ROWSUM(INT)..   sum(JNT, TSAM(INT,JNT)) =e= Y(INT);
2303   
2304  COLSUM(JNT)..   sum(INT, TSAM(INT,JNT)) =e= X(JNT);
2305   
2306  *ADDITIONAL MACRO CONTROL-TOTAL EQUATIONS
2307  GDPFCDEF..   GDPFC_SAM =e= SUM((FACTOR,A1),TSAM(FACTOR,A1)) ;
2308   
2309  GDPDEF..   GDP_SAM   =e= SUM((FACTOR,A1),TSAM(FACTOR,A1))+SUM((ITAX1,C1),TSAM(ITAX1,C1))+SUM((ETAX1,C1),TSAM(ETAX1,C1))
2310                                       + SUM((TF,A1),TSAM(TF,A1))+SUM(A1,TSAM('171_PRODTAX',A1))+SUM((FTAX,A1),TSAM(FTAX,A1))  ;
2311   
2312  A_MAT.lo(INT,JNT)$nonzero(INT,JNT)           = 0;
2313  A_MAT.up(INT,JNT)$nonzero(INT,JNT)          = 1;
2314  A_MAT.fx(INT,JNT)$(not nonzero(INT,JNT))  = 0;
2315   
2316  TSAM.lo(INT,JNT) = 0.0;
2317  TSAM.up(INT,JNT) = +inf;
2318  *TSAM.fx(INT,JNT)$(not nonzero(INT,JNT)) = 0;
2319  TSAM.fx(INT,JNT)$(not nonzero(INT,JNT) and not (INT = "173_GOVT" or JNT = "173_GOVT")) = 0;
