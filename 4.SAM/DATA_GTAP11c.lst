2320   
2321  * Set target column sums, X. If these are not fixed, then the column sum
2322  * constraints will not be binding and the solution values or ERR1 will be 0.
2323  X.fx(INT) = TARGET0(INT);
2324   
2325  * Fix Macro aggregates.
2326  * If these are not fixed, then the macro constraints will not be binding
2327  * and the solution values of ERR2 will be zero.
2328  GDP_SAM.fx   = GDP0;
2329  GDPFC_SAM.fx = GDPFC0;
2330   
2331  Model SAMENTROP / all /;
2332   
2333  option iterLim = 5000, limRow = 0, limCol = 0, solPrint = on;
2334   
2335  * SAMENTROP.optFile   = 1;
2336    SAMENTROP.holdFixed = 1;
2337   option nlp          = CONOPT4;
2338  * SAMENTROP.workSpace = 25.0;
2339   
2340  solve SAMENTROP using nlp minimizing dentropy;
