! TABLO program to balance a square SAM!
! Mark Horridge October 2003 !
! Revised to use levels notation May 2008 !

! SAM BALANCING PROGRAM FOR SQUARE SAMS
  Adjusts original matrix SAM(row,col)
  with scaling factors or multipliers MULT(i)
  so that   new SAM(row,col) = old SAM(row,col)*MULT(row)/MULT(col)
  and       Row totals of new SAM = Col totals of new SAM
Also allows selected row or col totals to be held to specific values

More explanations are in the accompanying files README.TXT and SAMBAL.DOC. !

! These statements put GEMPACK into 'levels' mode !
Variable    (default=levels);
Variable    (default=change);
Equation    (default=levels);
Formula     (default=initial);
Coefficient (default=parameter);

File INFILE # The original SAM #; ! the update file will contain new SAM !

Set ACC # SAM accounts # read elements from file INFILE header "ACC";

Variable (percent_change) ! so % variable will be p_SAM. We prefer % here
because scaling rule is expressed in proportional terms !
 (all,r,ACC)(all,c,ACC) SAM(r,c) # Social Accounting Matrix #;
Read SAM from file INFILE header "SAM0";

! Compute row-col differences in levels and in changes !
Variable
 (all,r,ACC) ROWTOT(r) # Current row total #;
 (all,c,ACC) COLTOT(c) # Current col total #;
 (all,a,ACC) DIFF(a)   # Imbalance = ROWTOT-COLTOT#;
Formula&Equation
E_ROWTOT (all,r,ACC) ROWTOT(r) = sum{c,ACC, SAM(r,c)};
Formula&Equation
E_COLTOT (all,c,ACC) COLTOT(c) = sum{r,ACC, SAM(r,c)};
Formula&Equation
E_DIFF   (all,a,ACC) DIFF(a)   = ROWTOT(a) - COLTOT(a);

Coefficient (all,r,ACC)(all,c,ACC) Z(r,c) # Error weights #;
Formula     (all,r,ACC)(all,c,ACC) Z(r,c) = 1.0;
! Z is a parameter you can use to hold particular SAM cells fixed, or to force
  some cells to vary more than others. If Z(r,c)=0, SAM(r,c) will not change.
  If Z(r,c)=0.5, SAM(r,c) will change less than other cells with Z=1.0.
  But be warned -- the more cells you hold fixed, the greater the changes
  needed in other cells !

! Next equation:
 (i)   causes zero SAM cells to remain zero [pSAM(r,c) = 0]
 (ii)  causes +ve  SAM cells to be scaled by a factor [MULT(r)/MULT(c)] 
 (iii) causes -ve  SAM cells to be scaled by a factor [MULT(c)/MULT(r)] !
Coefficient (all,r,ACC)(all,c,ACC) ZZ(r,c) # Sign-adjusted error weights #;
Formula     (all,r,ACC)(all,c,ACC) ZZ(r,c) = if (SAM(r,c)>0, +Z(r,c))
                                           + if (SAM(r,c)<0, -Z(r,c));
Variable
(linear, percent_change) (all,a,ACC) mult(a)
                   # Percent change in Multipliers (initial value = 1) #;
(linear, percent_change) (all,a,ACC) fmult(a)
                   # Slack to allow extra constraint #;
Equation (linear) E_p_SAM (all,r,ACC)(all,c,ACC)
   p_SAM(r,c) =   ZZ(r,c)*[mult(r) - mult(c) + fmult(r) + fmult(c)];
Substitute p_SAM using E_p_SAM;
! The additional fmult scale, normally exogenous and zero, could be freed
  to accomodate an additional rowsum (=colsum) constraint. For example, we
  might wish to set the total size of government spending. !

! Since each cell is scaled by MULT(r)/MULT(c)
  doubling all MULT would yield the same revised SAM.
  To determine the average absolute size of the MULT
  we need an additional normalization rule, for example:!
Equation (linear) E_slack 
   sum{r,ACC,sum{c,ACC, ABS[SAM(r,c)]*[mult(r)+mult(c)]}} = 0;
! The form of the normalization rule affects the average absolute size of the
MULTs, but does not affect the final updated SAM. !

! For empty SAM rows or columns, the multiplier would be undetermined.
  So multiplier must be set to zero change for these "inactive" accounts. !
Set INACTIVE = (all,a,ACC: [sum{c,ACC, ABS[SAM(a,c)]}=0]
                        or [sum{r,ACC, ABS[SAM(r,a)]}=0]);
Equation (linear) E_multA (all,a,INACTIVE)  mult(a) = 0;

!  We wish to shock the DIFF terms to zero -- but there is a difficulty.
   Sum of all ROWTOTs = matrix total = sum of all COLTOTs
   Therefore, sum of DIFFs is necessarily zero
     -- so we cannot independently shock all DIFF elements.
   To get round the problem, we construct an ancillary exogenous variable  
   ShockDiff, which is equal to DIFF plus an endogenous slack variable.
   We will shock ShockDiff by the desired change in DIFF (slack should turn out
   to be zero or tiny). !
Set ACTIVE   =  ACC - INACTIVE;
Variable
(linear, orig_level=DIFF) (all,a,ACC) ShockDiff(a)  # variable to shock #;
(linear) slack # Slack variable to accommodate not-quite-independent shocks #;
Equation
 (linear) E_multB (all,a,ACTIVE)  c_Diff(a) = ShockDiff(a)  + slack;

