4035  *===========
4036  * Coal 2.7tCO2 per 100$
4037  * CO2FACTOR2('02_COAL',j,z,time)$CO2FACTOR('02_COAL',j,z)           = 2.7 ;
4038  * Gas 1.8tCO2 per 100$
4039  * CO2FACTOR2('04_GAS',j,z,time)$CO2FACTOR('04_GAS',j,z)             = 0.67;
4040  * Oilrproduct  0.6tCO2 per 100$
4041  * CO2FACTOR2('10_PETROLCOAL',j,z,time)$CO2FACTOR('10_PETROLCOAL',j,z) = 0.67;
4042   
4043   
4044   
4045  PARAMETER
4046   EGINucGWh(j,z)    Nuclear GWh per 10 billion $
4047   EGICoalGWh(j,z)   Coal GWh per 10 billion $
4048   EGIGasGWh(j,z)    Gas GWh per 10 billion $
4049   EGIOilGWh(j,z)    Oil GWh per 10 billion $
4050   EGIWindGWh(j,z)   Wind GWh per 10 billion $
4051   EGISolarGWh(j,z)  Solar GWh per 10 billion $
4052   EGIHydroGWh(j,z)  Hydro GWh per 10 billion $
4053   EGIWasteGWh(j,z)  Waste GWh per 10 billion $
4054   EGIBioGWh(j,z)    Bio GWh per 10 billion $
4055   EGIGeoGWh(j,z)    Geothermal GWh per 10 billion $
4056   EGIOtherGWh(j,z)  Other GWh per 10 billion $
4057  ;
4058   
4059   EGINucGWh('19_eNuclear',z) = ElecNucGWh('19_eNuclear',z) / DSO_J('19_eNuclear',z);
4060   EGICoalGWh('20_eCoal',z)   = ElecCoalGWh('20_eCoal',z) / DSO_J('20_eCoal',z);
4061   EGIGasGWh('21_eGas',z)     = ElecGasGWh('21_eGas',z) / DSO_J('21_eGas',z);
4062   EGIOilGWh('22_eOil',z)     = ElecOilGWh('22_eOil',z) / DSO_J('22_eOil',z);
4063   EGIWindGWh('23_eWind',z)   = ElecWindGWh('23_eWind',z) / DSO_J('23_eWind',z);
4064   EGISolarGWh('24_eSolar',z) = ElecSolarGWh('24_eSolar',z) / DSO_J('24_eSolar',z);
4065   EGIHydroGWh('25_eHydro',z) = ElecHydroGWh('25_eHydro',z) / DSO_J('25_eHydro',z);
4066   EGIWasteGWh('26_eOther',z) = ElecWasteGWh('26_eOther',z) / DSO_J('26_eOther',z);
4067   EGIBioGWh('26_eOther',z)   = ElecBioGWh('26_eOther',z) / DSO_J('26_eOther',z);
4068   EGIGeoGWh('26_eOther',z)   = ElecGeoGWh('26_eOther',z) / DSO_J('26_eOther',z);
4069   EGIOtherGWh('26_eOther',z) = ElecOtherGWh('26_eOther',z) / DSO_J('26_eOther',z);
4070   
4071  PARAMETER
4072   CTAXO(z)           Initial Carbon tax $ per ton CO2
4073   TCTAXO(z)          Initial Government Revenue from Carbon tax
4074   PERMITO(j,z)       CO2 emissions
4075   PERMIT_TOTALO(z)   Total CO2 emissions (billion ton)
4076  ;
4077   CTAXO(z)           = 0;
4078   TCTAXO(z)          = 0;
4079   PERMITO(j,z)       = SUM(ene, CO2FACTOR(ene,j,z) * DEO(ene,j,z));
4080   PERMIT_TOTALO(z)   = SUM(j, PERMITO(j,z));
4081   
4082   
4083  *==============================================================================
4084  * Marginal abatement curves for emissions
4085  *==============================================================================
4086  PARAMETER
4087   alpha_CO2(ene,j,z)             Emissions responsiveness parameter
4088   gamma_CO2(ene,j,z)             Adjustment speed parameter
4089   MINCO2FACTOR(ene,j,z)          Minimum CO2 emission factor
4090   CTAX_CO2(ene,j,z,time)
4091   CO2FACTOR2_Star(ene,j,z,time)
4092  ;
4093   alpha_CO2(ene,j,z)     = 0.15;
4094   gamma_CO2(ene,j,z)     = 1.5;
4095   MINCO2FACTOR(ene,j,z)  = CO2FACTOR(ene,j,z) * 0.01;
4096   
4097  SCALAR
4098   adjustment_factor
4099   trigger_price
4100   SolarWind_TFP_BAU
4101   SolarWind_TFP_NDC
4102   SolarWind_TFP_NZ
4103   residual_ratio
4104  ;
4105   
4106   adjustment_factor = 0.5;
4107   trigger_price     = 1.0;
4108   SolarWind_TFP_BAU = 0.02;
4109   SolarWind_TFP_NDC = 0.02;
4110   SolarWind_TFP_NZ  = 0.04;
4111   residual_ratio  = 0.05;
4112   
4113   TIWO_Share(j,z)   = LDO(j,z) / LSO(z);
4114   TIKO_Share(k,j,z) = KDO(k,j,z) / KSO(k,z);
4115   TIPO_Share(j,z)   = XSTO(j,z) / SUM(jj, XSTO(jj,z));
4116   
4117  *==============================================================================
4118  * Direct Air Capture
4119  *==============================================================================
4120  PARAMETER
4121   DAC_TRIGGER            DAC trigger Price (100$ per tCO2)
4122   DAC_MAX(z)                Maximum DAC yearly
4123   DAC_growth_rate(z,time)
4124   DAC_Max_Pen(z)         Maximum Penetration
4125   DAC_Logistic_Coeff(z)  Logistic Growth Rate
4126   DAC_Inflection(z)      Inflection Lapse
4127   DAC_Start_Year(z)      First Triggered Year
4128   DAC_Tech_Coeff(i)
4129   switchDAC(z,time)      Binary parameter
4130   ;
4131   
4132  SCALAR DAC_Unit_Scale       100MilliontCO2 to tCO2 / 100000000 /;
4133  SCALAR DAC_Elec_Intensity   MWh needed per ton CO2 / 2.5 /;
4134  SCALAR Price_USD_MWh        USD per MWh / 107.14 /;
4135   
4136   DAC_TRIGGER               = 5.0;
4137   DAC_MAX(z)                = sum(j,PERMITO(j,z))*0.3;
4138   DAC_MAX('09_WEU')         = sum(j,PERMITO(j,'09_WEU'))*0.5;
4139   DAC_MAX('03_JPN')         = sum(j,PERMITO(j,'03_JPN'))*0.5;
4140   DAC_growth_rate(z,time)   = 0;
4141   DAC_Max_Pen(z)             = 1.0;
4142   DAC_Logistic_Coeff(z)      = 0.2;
4143   DAC_Inflection(z)            = 15;
4144   DAC_Start_Year(z)           = 0;
4145   DAC_Tech_Coeff('18_ELEC') = (DAC_Unit_Scale * DAC_Elec_Intensity * Price_USD_MWh) / 10**10;
4146   switchDAC(z,time)           = 0;
4147   
4148  *==============================================================================
4149  * Labour Supply
4150  *==============================================================================
4151  PARAMETER
4152   W_lag(z,time)         Wage rate of type l labor in region z
4153   PIXCON_lag(z,time)    Consumer price index in region z
4154   LS_lag(z,time)        Supply of type l labor in region z (T-1)
4155   LST_lag(z,time)       Supply of type l labor in region z (Trend T-1)
4156  ;
4157   
4158  *==============================================================================
4159  * Residual
4160  *==============================================================================
4161  Parameter MRGN_RES(i) "글로벌 마진 수급의 초기 데이터 불일치 흡수 잔차";
4162  * 초기 총공급량 - 초기 총수요량의 차이를 고정값으로 계산
4163  MRGN_RES(i) = SUM(z$MRGNO(i,z), MRGNO(i,z))
4164              - SUM((z,zj,ij)$IMO(ij,zj,z), tmrg(i,ij,zj,z) * IMO(ij,zj,z));
4165   
4166  Parameter YROW_RES(z) "YROW 총수입액 계산의 초기 데이터 소수점 오차 잔차";
4167  * 초기 장부상 총수입액(YROWO)과 개별 무역액 총합의 미세한 차이를 고정값으로 계산
4168  YROW_RES(z) = YROWO(z)
4169              - { 1.0 * SUM((i,zj)$IMO(i,zj,z), IMO(i,zj,z) * [PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z))]) };
4170   
4171  *==============================================================================
4172  *  [ToT Calibration] Base Year FOB / CIF Values and Weights
4173  *==============================================================================
4174  PARAMETER
4175    VFOB0(i,z,zj)   "Base year FOB value of exports"
4176    VCIF0(i,zj,z)   "Base year CIF value of imports"
4177    W_EXP(i,z,zj)   "Bilateral export weight (Laspeyres)"
4178    W_IMP(i,zj,z)   "Bilateral import weight (Laspeyres)"
4179    PWX0(i,z,zj)    "Base year World FOB price"
4180    PCIF0(i,zj,z)   "Base year World CIF price"
4181    PX_INDEXO(z)
4182    PM_INDEXO(z)
4183    TOTO(z)
4184  ;
4185   
4186  * FOB 가치 = 수출물량 * 국제수출가격 * 환율
4187   VFOB0(i,z,zj) = eO(z) * PWXO(i,z,zj) * EXO(i,z,zj);
4188   
4189  * CIF 가치 = 수입물량 * (국제수입가격 + 국제운송마진) * 환율
4190   VCIF0(i,zj,z) = eO(z) * IMO(i,zj,z) * (PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z)));
4191   
4192  * 2. 가중치 도출 (국가 z의 총 수출/수입액 대비 각 경로의 비중)
4193   W_EXP(i,z,zj)$SUM((ii,zjj), VFOB0(ii,z,zjj)) = VFOB0(i,z,zj) / SUM((ii,zjj), VFOB0(ii,z,zjj));
4194   W_IMP(i,zj,z)$SUM((ii,zjj), VCIF0(ii,zjj,z))  = VCIF0(i,zj,z) / SUM((ii,zjj), VCIF0(ii,zjj,z));
4195   
4196  * 3. 기준연도 가격 저장 (지수 분모용)
4197   PWX0(i,z,zj) = PWXO(i,z,zj);
4198   
4199   PCIF0(i,zj,z) = PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z));
4200   
4201   PX_INDEXO(z) = SUM((i,zj)$VFOB0(i,z,zj), W_EXP(i,z,zj) * (PWXO(i,z,zj) / PWX0(i,z,zj)));
4202   
4203   PM_INDEXO(z) = SUM((i,zj)$VCIF0(i,zj,z), W_IMP(i,zj,z) * ( (PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z))) / PCIF0(i,zj,z) ));
4204   
4205   TOTO(z)$PM_INDEXO(z) = PX_INDEXO(z) / PM_INDEXO(z);
4206   
4207  execute_unload 'Calibration_Check_GTAP11c';
4208  *$exit
