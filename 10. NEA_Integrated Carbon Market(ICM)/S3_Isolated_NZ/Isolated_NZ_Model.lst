3770   NOilp_DIO(p_oilproduct,'08_WOODPRO',z) = sum(f_newoodpro, WEB(f_newoodpro, p_oilproduct, z));
3771   NOilp_DIO(p_oilproduct,'09_PAPERPRO',z) = sum(f_nepaperpro, WEB(f_nepaperpro, p_oilproduct, z));
3772   NOilp_DIO(p_oilproduct,'11_CHEMICAL',z) = sum(f_nechemical, WEB(f_nechemical, p_oilproduct, z));
3773   NOilp_DIO(p_oilproduct,'12_NONMET',z) = sum(f_nenonmet, WEB(f_nenonmet, p_oilproduct, z));
3774   NOilp_DIO(p_oilproduct,'13_IRONSTL',z) = sum(f_neironstl, WEB(f_neironstl, p_oilproduct, z));
3775   NOilp_DIO(p_oilproduct,'14_NONFERR',z) = sum(f_nenonferr, WEB(f_nenonferr, p_oilproduct, z));
3776   NOilp_DIO(p_oilproduct,'15_MACHINE',z) = sum(f_nemachine, WEB(f_nemachine, p_oilproduct, z));
3777   NOilp_DIO(p_oilproduct,'16_TRANSEQ',z) = sum(f_netranseq, WEB(f_netranseq, p_oilproduct, z));
3778   NOilp_DIO(p_oilproduct,'17_OTHERIND',z) = sum(f_neotherind, WEB(f_neotherind, p_oilproduct, z));
3779   NOilp_DIO(p_oilproduct,'27_CONSTRUC',z) = sum(f_neconstruc, WEB(f_neconstruc, p_oilproduct, z));
3780   NOilp_DIO(p_oilproduct,'28_LTRP',z) = sum(f_netransport, WEB(f_netransport, p_oilproduct, z));
3781  * NEP_DIO(p_oilproduct,'29_WTRP',z) = sum((f_domewater), domewater_fne_oilproduct(f_domewater, p_oilproductproduct, z));
3782  * NEP_DIO(p_oilproduct,'30_ATRP',z) = sum((f_domeair), domeair_fne_oilproduct(f_domeair, p_oilproductproduct, z));
3783   NOilp_DIO(p_oilproduct,'31_SER',z) = sum(f_neother, WEB(f_neother, p_oilproduct, z) );
3784  * NEP_CO(p_oilproductlz) = sum((f_household), household_fne_oilproduct(f_household, p_oilproductproduct, z));
