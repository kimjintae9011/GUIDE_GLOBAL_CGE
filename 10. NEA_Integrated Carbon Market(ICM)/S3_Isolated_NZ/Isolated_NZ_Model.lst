3235   
3236  *f_balstfur(flow)
3237  *f_cokeoven(flow)
3238  * WEB(f_balstfur, 'p4_COKCOAL', z) = WEB(f_cokeoven, 'p66_TOTAL', z) ;
3239  * WEB(f_cokeoven, 'p4_COKCOAL', z) = WEB(f_cokeoven, 'p66_TOTAL', z) ;
3240   
3241   TCoke_Share(f_cokeoven,p_coal,z)$(WEB(f_cokeoven, p_coal, z) lt 0)  = WEB(f_cokeoven, p_coal, z)$(WEB(f_cokeoven, p_coal, z) lt 0)/sum(p_coal2, WEB(f_cokeoven, p_coal2, z)$(WEB(f_cokeoven, p_coal2, z) lt 0)) ;
3242   TBlast_Share(f_balstfur,p_coal,z)$(WEB(f_balstfur, p_coal, z) lt 0) = WEB(f_balstfur, p_coal, z)$(WEB(f_balstfur, p_coal, z) lt 0)/sum(p_coal2, WEB(f_balstfur, p_coal2, z)$(WEB(f_balstfur, p_coal2, z) lt 0)) ;
3243   
3244  *Coal
3245   Coal_DIO(p_coal,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_coal, z));
3246   Coal_DIO(p_coal,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_coal, z));
3247   Coal_DIO(p_coal,'03_OIL',z) = -1*sum((f_oil), WEB(f_oil, p_coal, z));
3248   Coal_DIO(p_coal,'04_GAS',z) = -1*sum((f_gas), WEB(f_gas, p_coal, z));
3249   Coal_DIO(p_coal,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_coal, z));
3250   Coal_DIO(p_coal,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_coal, z));
3251   Coal_DIO(p_coal,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_coal, z));
3252   Coal_DIO(p_coal,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_coal, z));
3253   Coal_DIO(p_coal,'09_PAPERPRO',z) = sum((f_paperpro), WEB(f_paperpro, p_coal, z));
3254   Coal_DIO(p_coal5,'10_PETROLCOAL',z) = -1*sum((f_petrolcoal), WEB(f_petrolcoal, p_coal5, z));
3255   Coal_DIO(p_coal,'11_CHEMICAL',z) = sum((f_chemical), WEB(f_chemical, p_coal, z));
3256   Coal_DIO(p_coal,'12_NONMET',z) = sum((f_nonmet), WEB(f_nonmet, p_coal, z));
3257   Coal_DIO(p_coal,'13_IRONSTL',z) = sum((f_ironstl), WEB(f_ironstl, p_coal, z))
3258   + sum(f_cokeoven, -1*TCoke_Share(f_cokeoven,p_coal,z)*WEB(f_cokeoven, 'p66_TOTAL', z))
3259   + sum(f_balstfur, -1*TBlast_Share(f_balstfur,p_coal,z)*WEB(f_balstfur, 'p66_TOTAL', z))
3260   + sum((f_Eblastcoke), -1*WEB(f_Eblastcoke, p_coal, z))
3261  ;
3262   
3263   Coal_DIO(p_coal,'14_NONFERR',z) = sum((f_nonferr), WEB(f_nonferr, p_coal, z));
3264   Coal_DIO(p_coal,'15_MACHINE',z) = sum((f_machine), WEB(f_machine, p_coal, z));
3265   Coal_DIO(p_coal,'16_TRANSEQ',z) = sum((f_transeq), WEB(f_transeq, p_coal, z));
3266   Coal_DIO(p_coal,'17_OTHERIND',z) = sum((f_otherind), WEB(f_otherind, p_coal, z));
3267   Coal_DIO(p_coal,'18_TnD',z) = 0 ;
3268   Coal_DIO(p_coal,'19_eNuclear',z) = 0 ;
3269   Coal_DIO(p_coal,'20_eCoal',z) = -1*sum((f_elec), WEB(f_elec, p_coal, z));
3270   Coal_DIO(p_coal,'19_eNuclear',z) = 0 ;
3271   Coal_DIO(p_coal,'21_eGas',z) = 0 ;
3272   Coal_DIO(p_coal,'22_eOil',z) = 0 ;
3273   Coal_DIO(p_coal,'23_eWind',z) = 0 ;
3274   Coal_DIO(p_coal,'24_eSolar',z) = 0 ;
3275   Coal_DIO(p_coal,'25_eHydro',z) = 0 ;
3276   Coal_DIO(p_coal,'26_eOther',z) = 0 ;
3277   Coal_DIO(p_coal,'27_CONSTRUC',z) = sum((f_construc), WEB(f_construc, p_coal, z));
3278   Coal_DIO(p_coal,'28_LTRP',z) = sum((f_roadrail), WEB(f_roadrail, p_coal, z));
3279   Coal_DIO(p_coal,'29_WTRP',z) = sum((f_domewater), WEB(f_domewater, p_coal, z));
3280   Coal_DIO(p_coal,'30_ATRP',z) = sum((f_domeair), WEB(f_domeair, p_coal, z));
3281   Coal_DIO(p_coal,'31_SER',z) = sum((f_ser), WEB(f_ser, p_coal, z));
3282   Coal_CO(p_coal,z) = sum((f_household), WEB(f_household, p_coal, z));
3283   
3284   Coal_Marine(p_coal,z)   = -1*sum((f_marine_bunker), WEB(f_marine_bunker, p_coal, z));
3285   Coal_Aviation(p_coal,z) = -1*sum((f_aviation_bunker), WEB(f_aviation_bunker, p_coal, z));
3286   
3287  *Ratio
3288  Loop(j,
3289      CoalR_DIO(p_coal,j,z)$(Coal_DIO(p_coal,j,z) gt 0)
3290           = Coal_DIO(p_coal,j,z)/sum(p_coal2, Coal_DIO(p_coal2,j,z));
3291       );
3292   
3293   CoalR_CO(p_coal,z)$(Coal_CO(p_coal,z) gt 0)  = Coal_CO(p_coal,z)/ sum(p_coal2, Coal_CO(p_coal2,z));
3294   
3295  *Gas
3296   Gas_DIO(p_gas,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_gas, z));
3297   Gas_DIO(p_gas,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_gas, z));
3298   Gas_DIO(p_gas,'03_OIL',z) = 0;
3299   Gas_DIO(p_gas,'04_GAS',z) = -1*sum((f_gas), WEB(f_gas, p_gas, z));
3300   Gas_DIO(p_gas,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_gas, z));
3301   Gas_DIO(p_gas,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_gas, z));
3302   Gas_DIO(p_gas,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_gas, z));
3303   Gas_DIO(p_gas,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_gas, z));
3304   Gas_DIO(p_gas,'09_PAPERPRO',z) = sum((f_paperpro), WEB(f_paperpro, p_gas, z));
3305   Gas_DIO(p_gas,'10_PETROLCOAL',z) = -1*sum((f_petrolcoal), WEB(f_petrolcoal, p_gas, z));
3306   Gas_DIO(p_gas,'11_CHEMICAL',z) = sum((f_chemical), WEB(f_chemical, p_gas, z));
3307   Gas_DIO(p_gas,'12_NONMET',z) = sum((f_nonmet), WEB(f_nonmet, p_gas, z));
3308   Gas_DIO(p_gas,'13_IRONSTL',z) = sum((f_ironstl), WEB(f_ironstl, p_gas, z));
3309   Gas_DIO(p_gas,'14_NONFERR',z) = sum((f_nonferr), WEB(f_nonferr, p_gas, z));
3310   Gas_DIO(p_gas,'15_MACHINE',z) = sum((f_machine), WEB(f_machine, p_gas, z));
3311   Gas_DIO(p_gas,'16_TRANSEQ',z) = sum((f_transeq), WEB(f_transeq, p_gas, z));
3312   Gas_DIO(p_gas,'17_OTHERIND',z) = sum((f_otherind), WEB(f_otherind, p_gas, z));
3313   Gas_DIO(p_gas,'18_TnD',z) = 0 ;
3314   Gas_DIO(p_gas,'19_eNuclear',z) = 0 ;
3315   Gas_DIO(p_gas,'20_eCoal',z) = 0;
