4390   EQ5(j,z,time)           CES between labor categories
4391   EQ7(j,z,time)           CES between capital categories
4392   EQ8(k,j,z,time)         Demand for capital
4393   EQ9(i,j,z,time)         Leontief - demand for commodity i by sector j
4394   EQ9_1(ene,j3,z,time)    Energy nesting
4395   EQ9_2(j2,z,time)        Nested CES - Level 1
4396   EQ9_3(j2,z,time)        Nested CES - Level 2
4397   EQ9_4(j2,z,time)        Nested CES - Level 3
4398   EQ9_5(j2,z,time)        Nested CES - Level 4
4399   EQ9_6(ene2,j2,z,time)   Nested CES - Level 5
4400   EQ9_7(ene5,j2,z,time)   Nested CES - Level 6
4401   EQ9_8(ene6,j2,z,time)   Nested CES - Level 7
4402   
4403  * --- Income and Savings ---
4404   EQ10(z,time)            Household total income
4405   EQ11(z,time)            Household labor income
4406   EQ12(z,time)            Household capital income
4407   EQ13(z,time)            Household disposable income
4408   EQ14(z,time)            Household consumption budget
4409   EQ15(z,time)            Household savings
4410   EQ16(z,time)            Government total income
4411   EQ16_1(z,time)          Government revenue from Ctax
4412   EQ17(z,time)            Total government receipts of taxes on production
4413   EQ18(z,time)            Government receipts of indirect taxes on wages
4414   EQ19(z,time)            Government receipts of indirect taxes on capital
4415   EQ20(z,time)            Government receipts of indirect taxes on production
4416   EQ21(z,time)            Total government receipts of taxes on products and imports
4417   EQ22(z,time)            Government receipts of indirect taxes on consumption
4418   EQ23(z,time)            Government receipts of indirect taxes on imports
4419   EQ24(z,time)            Government receipts of indirect taxes on exports
4420   EQ25(z,time)            Household income taxes
4421   EQ26(j,z,time)          Government receipts of indirect taxes on wages
4422   EQ27(k,j,z,time)        Government receipts of indirect taxes on capital
4423   EQ28(j,z,time)          Government receipts of indirect taxes on production of industry j
4424   EQ29(i,z,time)          Government receipts of indirect taxes on commodity i
4425   EQ30(i,zj,z,time)       Government receipts of indirect taxes on imports of commodity i
4426   EQ31(i,z,zj,time)       Government receipts of indirect taxes on exports of commodity i
4427   EQ32(z,time)            Government savings
4428   EQ33(z,time)            Rest of the world total income
4429   EQ34(z,time)            Rest of the world savings
4430   EQ35(z,time)            Equivalence between current account balance and savings
4431   
4432  * --- Demand and Trade ---
4433   EQ36(i,z,time)          Household consumption of commodity i
4434   EQ37(i,z,time)          Final demand of commodity i for investment purposes
4435   EQ38(i,z,time)          Public final consumption of commodity i
4436   EQ39(i,z,time)          Total intermediate consumption of commodity i
4437   EQ39_1(i,z,time)        Total intermediate consumption of commodity i
4438   EQ39_2(i,z,time)        Total intermediate consumption of commodity i
4439   EQ40_3(i,z,time)        Domestic supply by commdities
4440   EQ40_4(j,z,time)        Total supply by commdities
4441   EQ40_5(i,z,time)        CET function between exports local production and margins
4442   EQ41(i,z,time)          Supply of composite exports
4443   EQ42(i,z,time)          Supply of margins
4444   EQ43(i,z,time)          CET function between exports by trading partner
4445   EQ44(i,z,zj,time)       Supply of exports by trading partner
4446   EQ45(i,z,time)          CES function between composite imports and local production
4447   EQ46(i,z,time)          Demand for composite imports
4448   EQ47(i,z,time)          CES function between imports by origin
4449   EQ48(i,zj,z,time)       Demand for imports by origin
4450   
4451  * --- Prices ---
4452   EQ49(j,z,time)          Producer price in energy industries j after production taxes
4453   EQ49_1(j,z,time)        Producer price in industry j after production taxes
4454   EQ50(j,z,time)          Basic price of industry j production
4455   EQ51(j,z,time)          Price index of industry j intermediate consumption
4456   EQ51_1(j2,z,time)       Price index nested CES
4457   EQ51_2(j3,z,time)       Price index nested CES
4458   EQ51_3(j2,z,time)       Price index nested CES
4459   EQ51_4(j2,z,time)       Price index nested CES
4460   EQ51_5(j2,z,time)       Price index nested CES
4461   EQ51_6(j2,z,time)       Price index nested CES
4462   EQ52(j,z,time)          Value added price
4463   EQ52_1(j,z,time)        KLE price
4464   EQ53(j,z,time)          Price of composite labor in industry j (redundant)
4465   EQ54(j,z,time)          Wages including taxes
4466   EQ54_1(ene,j,z,time)    Energy commodity prices
4467   EQ56(k,j,z,time)        Rental rate including taxes
4468   EQ58(i,z,time)          Producer price is a weighted sum of PE and PL
4469   EQ60(i,z,zj,time)       Border price of exported commodity i
4470   EQ61(i,z,time)          Price of local product i (including all taxes and margins)
4471   EQ62(i,zj,z,time)       Price of imported commodity i (including all taxes and duties)
4472   EQ64(i,z,time)          Consumer price is a weighted sum of PD and PM
4473   EQ66(z,time)            GDP deflator (Fischer index)
4474   EQ67(time)              World GDP deflator (Fischer index)
4475   EQ68(z,time)            Consumer price index (Laspeyres)
4476   EQ69(z,time)            Investment price index (derived from investment function)
4477   EQ70(z,time)            Public expenditure price index
4478   
4479  * --- Equilibrium and Macro ---
4480   EQ71(i1,z,time)         Domestic absorbtion
4481   EQ72(z,time)            Labor supply equals labor demand
4482   EQ73(k,z,time)          Capital supply equals capital demand
4483   EQ74(z,time)            Total investment equals total savings
4484   EQ75(z,time)            Depreciation
4485   EQ76(i,z,time)          Supply of domestic production equals demand
4486   EQ77(i,z,zj,time)       Exports supply equals imports demand
4487   EQ78(i,z,zj,time)       Exports price equals imports price
4488   EQ79(i,time)            World demand for margins equals world supply
4489   EQ81(z,time)            GDP at basic prices
4490   EQ82(z,time)            GDP at market prices
4491   EQ83(z,time)            GDP at market prices (income-based)
4492   EQ84(z,time)            GDP at market prices (expenditure-based)
4493   EQ85(time)              World GDP
4494   EQ86(z,time)            Real consumption budget of type h households
4495   EQ87(z,time)            Real current government expenditures on goods and services
4496   EQ88(z,time)            Real GDP at basic prices
4497   EQ89(time)              Real world GDP at basic prices
4498   EQ90(z,time)            Real GDP at market prices
4499   EQ91(z,time)            Real gross fixed capital formation
4500   EQ92(z,time)            Current account balance of region z in terms of the reference currency
4501   WALRAS(z,time)          Walras law verification
4502   
4503  * --- Nested Trade & Output ---
4504   EQA_1(z,time)           Top Nest - Leontief function Aggregated-Electricity
4505   EQA_2(Z,time)           Top Nest - Leontief function Aggregated-Electricity
4506   EQA_3(BS, Conv, I_BS, Z_GRN, time)       Top Nest - Other
4507   EQA_3_OTH(BS, Conv, I_BS, Z_OTH, time)  Top Nest - OTH IRONSTAL
4508   EQA_4(z,time)           Second Nest - CES function - Aggregated-Electricity
4509   EQA_5(POWER,i,z,time)   Second Nest - CES function - Aggregated-Electricity
4510   EQA_6(BS, Conv, I_BS, Z_GRN, time)       Second Nest - CES function - Aggregated-Backstop
4511   EQA_7_CONV(BS, Conv, I_BS, Z_GRN, time)
4512   EQA_7_BS(BS, Conv, I_BS, Z_GRN, time)
4513   EQB_1(i2,z,time)        Industry j production of commodity i (CES)
4514   EQB_2(j,i2,z,time)      Industry j production
4515   EQB_3(j,i,z,time)       Total producer price is equal to P if there is only one product
4516   EQB_4(j,i,z,time)       Basic price of industry js production of commodity i
4517   EQB_5(j,i,z,time)       Supply of exports for compsite activity
4518   
4519  * --- Dynamics and Labor ---
4520   EQ94(z,time)            Total investment expenditure constraint
4521   EQ95(z,time)            Aggregate price of capital
4522   EQ96(k,bus,z,time)      Investment demand by industry
4523   EQ97a(z,time)           Interest rate (weighted average rate of return on capital)
4524   EQ97b(z,time)           User cost of capital
4525   EQ106(z,time)           Labor supply
4526   
4527  * --- Climate Policy (CTAX, Permits, DAC) ---
4528   EQ107(j,z,time)         Permit calculation by sector
4529   EQ108(z,time)           Total permits
4530   EQ109(z,time)           Carbon tax rebate
4531   EQ110(j,z,time)         Wage share for rebate
4532   EQ111(j,z,time)         Labor rebate
4533   EQ118(z,time)           DAC volume
4534   EQ_OBJ                  Objective function
4535   
4536  * --- Green Steel (VAT Nest) ---
4537   EQ_TSFMKT(BS,Z_GRN,time)   TSF Market clearing condition
4538   EQ_TSFD(BS,Z_GRN,time)     Demand function for TSF (Leontief)
4539   EQ_VAT_REQ(BS,Z_GRN, time) VAT composite requirement
4540   EQ_PVAT(BS,Z_GRN, time)    Price of VAT composite
4541   EQ_VA_GRN(BS,Z_GRN, time)  Value added for Green Steel
4542   EQ_PP_GRN(BS,Z_GRN, time)  Producer price for Green Steel
4543   
4544  * --- Terms of Trade ---
4545   EQ_PX_INDEX(z,time)     Export price index equation
4546   EQ_PM_INDEX(z,time)     Import price index equation
4547   EQ_TOT(z,time)          Terms of Trade equation
4548   
4549  ;
4550   
4551  *==============================================================================
4552  * 5.3 Equation Definitions
4553  *==============================================================================
4554   
4555  *==============================================================================
4556  * 5.3.1 Production
4557  *==============================================================================
4558  EQ1(j3,z,t)$[not BS(j3)]..
4559      VA(j3,z,t) =e= v(j3,z) * XST(j3,z,t);
4560   
4561   EQ1_1(j2,z,t)..
4562      KLE(j2,z,t) =e= v2(j2,z) * XST(j2,z,t);
4563   
4564   EQ2(j,z,t)..
4565      CI(j,z,t) =e= io(j,z) * XST(j,z,t);
4566   
4567   EQ2_1(j3,z,t)..
4568      CE(j3,z,t) =e= io2(j3,z) * XST(j3,z,t);
4569   
4570   EQ3(j,z,t)$[XSTO(j,z)]..
4571      VA(j,z,t) =e= A_VA(z,t) * B_VA_t(j,z,t) * {
4572                    [beta_VA(j,z) * LDC(j,z,t)**(-rho_VA(j,z))]$LDCO(j,z)
4573                  + [(1 - beta_VA(j,z)) * KDC(j,z,t)**(-rho_VA(j,z))]$KDCO(j,z)
4574                  }**(-1 / rho_VA(j,z));
4575   
4576   EQ3_1(j2,z,t)..
4577      KLE(j2,z,t) =e= B_KLE(j2,z) * {
4578                      [beta_KLE(j2,z) * VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
4579                    + [(1 - beta_KLE(j2,z)) * CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
4580                    }**(-1 / rho_KLE(j2,z));
4581   
4582  EQ4_1(j2,z,t)$[VAO(j2,z) and CEO(j2,z)]..
4583      VA(j2,z,t) * (beta_KLE2(j2,z)**sigma_KLE(j2,z)) * (PVA(j2,z,t)**sigma_KLE(j2,z))
4584      =e= ((1 - beta_KLE2(j2,z))**sigma_KLE(j2,z)) * (PCE(j2,z,t)**sigma_KLE(j2,z)) * CE(j2,z,t);
4585   
4586   EQ4(j,z,t)$[LDCO(j,z) and KDCO(j,z)]..
4587      LDC(j,z,t) =e= {[beta_VA(j,z) / (1 - beta_VA(j,z))]
4588                     *[RC(j,z,t) / WC(j,z,t)]}**sigma_VA(j,z) * KDC(j,z,t);
4589   
4590   EQ5(j,z,t)$LDCO(j,z)..
4591      LDC(j,z,t) =e= LD(j,z,t);
4592   
4593   EQ7(j,z,t)$KDCO(j,z)..
4594      KDC(j,z,t) =e= B_KD(j,z) * SUM[k$KDO(k,j,z), beta_KD(k,j,z)
4595                     * KD(k,j,z,t)**(-rho_KD(j,z))]**(-1 / rho_KD(j,z));
4596   
4597   EQ8(k,j,z,t)$KDO(k,j,z)..
4598      KD(k,j,z,t) =e= [beta_KD(k,j,z) * RC(j,z,t) / RTI(k,j,z,t)]**sigma_KD(j,z)
4599                    * B_KD(j,z)**(sigma_KD(j,z) - 1) * KDC(j,z,t);
4600   
4601   EQ9(nene,j,z,t)..
4602      DI(nene,j,z,t) =e= aij_t(nene,j,z,t) * CI(j,z,t);
4603   
4604   EQ9_1(ene,j3,z,t)..
4605      DE(ene,j3,z,t) =e= aij2_t(ene,j3,z,t) * CE(j3,z,t) * AEEI(z,t);
4606   
4607  *============================= Level 1, 2, 3 (CES Energy Nesting) =====================
4608   EQ9_2(j2,z,t)..
4609      CE(j2,z,t) =e= B_ENER_elec(j2,z) * {
4610                     [(beta_ENER_elec(j2,z)) * DEelec(j2,z,t)**(-rho_ENER_elec(j2,z))]
4611                   + [(1 - beta_ENER_elec(j2,z)) * DEnelec(j2,z,t)**(-rho_ENER_elec(j2,z))]
4612                   }**(-1 / rho_ENER_elec(j2,z));
4613   
4614   EQ9_3(j2,z,t)..
4615      DEnelec(j2,z,t) =e= {[(1 - beta_ENER_elec(j2,z)) / (beta_ENER_elec(j2,z))]
4616                          *[PCEelec(j2,z,t) / PCEnelec(j2,z,t)]}**sigma_ENER_elec(j2,z) * DEelec(j2,z,t);
4617   
4618   EQ9_4(j2,z,t)..
4619      DEnelec(j2,z,t) =e= B_ENER_nelec(j2,z) * {
4620                          [(beta_ENER_nelec(j2,z)) * DEcoalgas(j2,z,t)**(-rho_ENER_nelec(j2,z))]
4621                        + [(1 - beta_ENER_nelec(j2,z)) * DEoilpetrol(j2,z,t)**(-rho_ENER_nelec(j2,z))]
4622                        }**(-1 / rho_ENER_nelec(j2,z));
4623   
4624   EQ9_5(j2,z,t)..
4625      DEoilpetrol(j2,z,t) =e= {[(1 - beta_ENER_nelec(j2,z)) / (beta_ENER_nelec(j2,z))]
4626                              *[PCEcoalgas(j2,z,t) / PCEoilpetrol(j2,z,t)]}**sigma_ENER_nelec(j2,z) * DEcoalgas(j2,z,t);
4627   
4628   EQ9_6(ene2,j2,z,t)..
4629      DE(ene2,j2,z,t) =e= DEelec(j2,z,t) * AEEI(z,t);
4630   
4631   EQ9_7(ene5,j2,z,t)..
4632      DE(ene5,j2,z,t) =e= [beta_ENER_coalgas(ene5,j2,z) * PCEcoalgas(j2,z,t) / (P4(ene5,j2,z,t) + P4(ene5,j2,z,t) * CTAX(z,t) * CO2FACTOR2(ene5,j2,z,t))]
4633                          **sigma_ENER_coalgas(j2,z) * B_ENER_coalgas(j2,z)**(sigma_ENER_coalgas(j2,z) - 1)
4634                          * DEcoalgas(j2,z,t) * AEEI(z,t);
4635   
4636   EQ9_8(ene6,j2,z,t)..
4637      DE(ene6,j2,z,t) =e= [beta_ENER_oilprod(ene6,j2,z) * PCEoilpetrol(j2,z,t) / (P4(ene6,j2,z,t) + P4(ene6,j2,z,t) * CTAX(z,t) * CO2FACTOR2(ene6,j2,z,t))]
4638                          **sigma_ENER_oilprod(j2,z) * B_ENER_oilprod(j2,z)**(sigma_ENER_oilprod(j2,z) - 1)
4639                          * DEoilpetrol(j2,z,t) * AEEI(z,t);
4640   
4641  *==============================================================================
4642  * 5.3.2 Income and savings
4643  *==============================================================================
4644   EQ10(z,t)..
4645      YH(z,t) =e= YHL(z,t) + YHK(z,t) + REBATE(z,t) * recycle_hou(z,t)
4646                + SUM((BS, Z_GRN)$sameas(z, Z_GRN), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t));
4647   
4648   EQ11(z,t)..
4649      YHL(z,t) =e= SUM[(j)$LDO(j,z), W(z,t) * (LD(j,z,t))];
4650   
4651   EQ12(z,t)..
4652      YHK(z,t) =e= SUM[(k,j)$KDO(k,j,z), R(k,j,z,t) * (KD(k,j,z,t))];
4653   
4654   EQ13(z,t)..
4655      YDH(z,t) =e= YH(z,t) - TDH(z,t);
4656   
4657   EQ14(z,t)..
4658      CTH(z,t) =e= YDH(z,t) - SH(z,t);
4659   
4660   EQ15(z,t)..
4661      SH(z,t) =e= PIXCON(z,t)**eta * sh0(z,t) + sh1(z,t) * YDH(z,t);
4662   
4663  *==============================================================================
4664  * 5.3.2.2 Government
4665  *==============================================================================
4666   EQ16(z,t)..
4667      YG(z,t) =e= TDH(z,t) + TPRODN(z,t) + TPRCTS(z,t) + REBATE(z,t) * recycle_gov(z,t) - SUM(i1, PC(i1,z,t) * QDAC(z,t) * DAC_Tech_Coeff(i1));
4668   
4669   EQ16_1(z,t)..
4670      TCTAX(z,t) =e= SUM((ene,j), PC(ene,z,t) * CTAX(z,t) * CO2FACTOR2(ene,j,z,t) * DE(ene,j,z,t));
4671   
4672   EQ17(z,t)..
4673      TPRODN(z,t) =e= TIWT(z,t) + TIKT(z,t) + TIPT(z,t);
4674   
4675  EQ18(z,t)..
4676      TIWT(z,t) =e= SUM[(j)$LDO(j,z), TIW(j,z,t)] ;
4677   
4678   EQ19(z,t)..
4679      TIKT(z,t) =e= SUM[(k,j)$KDO(k,j,z), TIK(k,j,z,t)] ;
4680   
4681   EQ20(z,t)..
4682      TIPT(z,t) =e= SUM[j, TIP(j,z,t)] ;
4683   
4684   EQ21(z,t)..
4685      TPRCTS(z,t) =e= TICT(z,t) + TIMT(z,t) + TIXT(z,t);
4686   
4687   EQ22(z,t)..
4688      TICT(z,t) =e= SUM[i, TIC(i,z,t)];
4689   
4690   EQ23(z,t)..
4691      TIMT(z,t) =e= SUM[(i,zj)$IMO(i,zj,z), TIM(i,zj,z,t)];
4692   
4693   EQ24(z,t)..
4694      TIXT(z,t) =e= SUM[(i,zj)$EXO(i,z,zj), TIX(i,z,zj,t)];
4695   
4696   EQ25(z,t)..
4697      TDH(z,t) =e= PIXCON(z,t)**eta * ttdh0(z,t) + ttdh1(z,t) * YH(z,t);
4698   
4699   EQ26(j,z,t)$LDO(j,z)..
4700      TIW(j,z,t) =e= ttiw(j,z,t) * W(z,t) * (LD(j,z,t)) - LaborRebate(j,z,t);
4701   
4702   EQ27(k,j,z,t)$KDO(k,j,z)..
4703      TIK(k,j,z,t) =e= ttik(k,j,z,t) * R(k,j,z,t) * (KD(k,j,z,t));
4704   
4705   EQ28(j,z,t)..
4706      TIP(j,z,t) =e= ttip(j,z,t) * PP(j,z,t) * XST(j,z,t);
4707   
4708   EQ29(i,z,t)..
4709      TIC(i,z,t) =e= ttic(i,z,t) * {
4710                     [PL(i,z,t) * DD(i,z,t)]$DDO(i,z)
4711                   + [SUM[zj$IMO(i,zj,z), (1 + ttim(i,zj,z,t)) * IM(i,zj,z,t) * e(z,t)
4712                     *(PWM(i,zj,z,t) + SUM(ij, PWMG(ij,t) * tmrg(ij,i,zj,z)))]]
4713                   };
4714   
4715   EQ30(i,zj,z,t)$IMO(i,zj,z)..
4716      TIM(i,zj,z,t) =e= ttim(i,zj,z,t) * IM(i,zj,z,t) * e(z,t) * (PWM(i,zj,z,t) + SUM[ij, PWMG(ij,t) * tmrg(ij,i,zj,z)]);
4717   
4718   EQ31(i,z,zj,t)$EXO(i,z,zj)..
4719      TIX(i,z,zj,t) =e= ttix(i,z,zj,t) * PE(i,z,zj,t) * EX(i,z,zj,t);
4720   
4721   EQ32(z,t)..
4722      SG(z,t) =e= YG(z,t) - G(z,t);
4723   
4724  *==============================================================================
4725  * 5.3.2.4 Rest of the world
4726  *==============================================================================
4727   EQ33(z,t)..
4728      YROW(z,t) =e= e(z,t) * SUM{(i,zj)$IMO(i,zj,z), IM(i,zj,z,t) * [PWM(i,zj,z,t) + SUM(ij, PWMG(ij,t) * tmrg(ij,i,zj,z))]}+YROW_RES(z);
4729   
4730   EQ34(z,t)..
4731      SROW(z,t) =e= YROW(z,t) - e(z,t) * SUM[(i,zj)$EXO(i,z,zj), EX(i,z,zj,t) * PWX(i,z,zj,t)]
4732                    - e(z,t) * SUM[i$MRGNO(i,z), MRGN(i,z,t) * PWMG(i,t)];
4733   
4734   EQ35(z,t)..
4735      SROW(z,t) =e= -CAB(z,t);
4736   
4737  *==============================================================================
4738  * 5.3.3 Demand
4739  *==============================================================================
4740   EQ36(i,z,t)..
4741      PC(i,z,t) * C(i,z,t) =e= PC(i,z,t) * (CMIN(i,z,t))
4742                             + gamma_LES(i,z) * {CTH(z,t) - SUM[ij, PC(ij,z,t) * (CMIN(ij,z,t))]};
4743   
4744   EQ37(i,z,t)..
4745      PC(i,z,t) * INV(i,z,t) =e= gamma_INV(i,z) * IT(z,t);
4746   
4747   EQ38(i,z,t)..
4748      PC(i,z,t) * CG(i,z,t) =e= gamma_GVT(i,z) * G(z,t);
4749   
4750   EQ39(nene,z,t)..
4751      DIT(nene,z,t) =e= SUM[j, DI(nene,j,z,t)];
4752   
4753   EQ39_1(ene1,z,t)..
4754      DIT(ene1,z,t) =e= SUM[j, DE(ene1,j,z,t)];
4755   
4756   EQ39_2(ene2,z,t)..
4757      DIT(ene2,z,t) =e= SUM[j, DE(ene2,j,z,t)];
4758   
4759  *==============================================================================
4760  * 5.3.4 International trade
4761  *==============================================================================
4762   EQA_1(z,t)..
4763      XS('18_TnD','18_ELEC',z,t) =e= TnDShare(z) * XS_I('18_ELEC',z,t);
4764   
4765   EQA_2(z,t)..
4766      XS_I('18_ELEC',z,t) =e= XS('18_TnD','18_ELEC',z,t) + QPOWER(z,t);
4767   
4768   EQA_3(BS, Conv, I_BS, Z_GRN, t)$MAP_BS(BS, Conv, I_BS)..
4769      XS_I(I_BS, Z_GRN, t) =e= QBS(BS, Z_GRN, t);
4770   
4771   EQA_3_OTH(BS, Conv, I_BS, Z_OTH, t)$MAP_BS(BS, Conv, I_BS)..
4772      XS_I(I_BS, Z_OTH, t) =e= XS(Conv, I_BS, Z_OTH, t);
4773   
4774   EQA_4(z,t)..
4775      QPOWER(z,t) =e= B_X4(z) * SUM[POWER, beta_X4(power,z) * XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1 / rho_X4(z));
4776   
4777   EQA_5(power,'18_ELEC',z,t)..
4778      XS(POWER,'18_ELEC',z,t) =e= QPOWER(z,t) / B_X4(z)**(1 - sigma_X4(z)) *
4779                                  [beta_X4(power,z) * PPOWER(z,t) / P2(POWER,'18_ELEC',z,t)]**sigma_X4(z);
4780   
4781  EQA_6(BS, Conv, I_BS, Z_GRN, t)$MAP_BS(BS, Conv, I_BS)..
4782      QBS(BS, Z_GRN, t) =e= B_BS(BS, Z_GRN) * (
4783            beta_BS_t(Conv, I_BS, Z_GRN, t) * XS(Conv, I_BS, Z_GRN, t)**(-rho_BS(BS, Z_GRN))
4784          + beta_BS_t(BS, I_BS, Z_GRN, t) * XS(BS, I_BS, Z_GRN, t)**(-rho_BS(BS, Z_GRN))
4785      )**(-1 / rho_BS(BS, Z_GRN));
4786   
4787   EQA_7_CONV(BS, Conv, I_BS, Z_GRN, t)$MAP_BS(BS, Conv, I_BS)..
4788      XS(Conv, I_BS, Z_GRN, t) =e= QBS(BS, Z_GRN, t) / B_BS(BS, Z_GRN)**(1 - sigma_BS(BS, Z_GRN)) *
4789          [beta_BS_t(Conv, I_BS, Z_GRN, t) * PBS(BS, Z_GRN, t) / P2(Conv, I_BS, Z_GRN, t)]**sigma_BS(BS, Z_GRN);
4790   
4791   EQA_7_BS(BS, Conv, I_BS, Z_GRN, t)$MAP_BS(BS, Conv, I_BS)..
4792      XS(BS, I_BS, Z_GRN, t) =e= QBS(BS, Z_GRN, t) / B_BS(BS, Z_GRN)**(1 - sigma_BS(BS, Z_GRN)) *
4793          [beta_BS_t(BS, I_BS, Z_GRN, t) * PBS(BS, Z_GRN, t) / P2(BS, I_BS, Z_GRN, t)]**sigma_BS(BS, Z_GRN);
4794   
4795   EQB_1(i2,z,t)..
4796      XS_I(i2,z,t) =e= B_X3(i2,z) * SUM[j$XSO(j,i2,z), beta_X3(j,i2,z) * XS(j,i2,z,t)**(-rho_X3(i2,z))]**(-1 / rho_X3(i2,z));
4797   
4798   EQB_2(j,i2,z,t)${DSO(j,i2,z) and [DSO(j,i2,z) ne DSO_I(i2,z)]}..
4799      XS(j,i2,z,t) =e= XS_I(i2,z,t) / B_X3(i2,z)**(1 - sigma_X3(i2,z)) *[beta_X3(j,i2,z) * P(i2,z,t) / P2(j,i2,z,t)]**sigma_X3(i2,z);
4800   
4801   EQB_3(j,i,z,t)${DSO(j,i,z)}..
4802      P2(j,i,z,t) =e= PT(j,z,t);
4803   
4804   EQB_4(j,i,z,t)$DSO(j,i,z)..
4805  *    P2(j,i,z,t) * XS(j,i,z,t) =e= [PET(i,z,t) * EXTT(j,i,z,t)]$EXTTO(j,i,z)
4806  *                                + [e(z,t) * MRGN(i,z,t) * PWMG(i,t)]$MRGNO(i,z)
4807  *                                + [PL(i,z,t) * DS(j,i,z,t)]$DSO(j,i,z);
4808   
4809      P2(j,i,z,t) * XS(j,i,z,t) =e= [PET(i,z,t) * EXTT(j,i,z,t)]$EXTTO(j,i,z)
4810                                  + [e(z,t) * MRGN(i,z,t) * PWMG(i,t) * SHR_MRGN(j,i,z)]$MRGNO(i,z)
4811                                  + [PL(i,z,t) * DS(j,i,z,t)]$DSO(j,i,z);
4812   
4813   EQB_5(j,i,z,t)$DSO(j,i,z)..
4814      EXTT(j,i,z,t) =e= theta2(j,i,z) * EXT(i,z,t);
4815   
4816   EQ40_3(i,z,t)..
4817      DS_I(i,z,t) =e= SUM(j, DS(j,i,z,t)$DSO(j,i,z));
4818   
4819   EQ40_4(j,z,t)..
4820      XST(j,z,t)  =e= SUM(i, XS(j,i,z,t)$XSO(j,i,z));
4821   
4822   EQ40_5(i,z,t)..
4823      XS_I(i,z,t) =e= B_X1(i,z) * {
4824                      [beta_EX_X1(i,z) * EXT(i,z,t)**rho_X1(i,z)]$EXTO(i,z)
4825                    + [beta_D_X1(i,z) * DS_I(i,z,t)**rho_X1(i,z)]$DSO_I(i,z)
4826                    + [(1 - beta_EX_X1(i,z) - beta_D_X1(i,z)) * MRGN(i,z,t)**rho_X1(i,z)]$MRGNO(i,z)
4827                    }**(1 / rho_X1(i,z));
4828   
4829   EQ41(i,z,t)$[EXTO(i,z) and DSO_I(i,z)]..
4830      EXT(i,z,t) =e= {[beta_D_X1(i,z) / beta_EX_X1(i,z)] * [PET(i,z,t) / PL(i,z,t)]}**sigma_X1(i,z) * DS_I(i,z,t);
4831   
4832   EQ42(i,z,t)$[MRGNO(i,z) and DSO_I(i,z)]..
4833      MRGN(i,z,t) =e= {[beta_D_X1(i,z) / (1 - beta_EX_X1(i,z) - beta_D_X1(i,z))] * [e(z,t) * PWMG(i,t) / PL(i,z,t)]}**sigma_X1(i,z) * DS_I(i,z,t);
4834   
4835   EQ43(i,z,t)$EXTO(i,z)..
4836      EXT(i,z,t) =e= B_X2(i,z) * SUM[zj$EXO(i,z,zj), beta_X2(i,z,zj) * EX(i,z,zj,t)**rho_X2(i,z)]**(1 / rho_X2(i,z));
4837   
4838   EQ44(i,z,zj,t)$EXO(i,z,zj)..
4839      EX(i,z,zj,t) =e= EXT(i,z,t) / B_X2(i,z)**(1 + sigma_X2(i,z)) *
4840                       [PE(i,z,zj,t) / (beta_X2(i,z,zj) * PET(i,z,t))]**sigma_X2(i,z);
4841   
4842   EQ45(i,z,t)..
4843      Q(i,z,t) =e= B_M1(i,z) * {
4844                   [beta_M1(i,z) * IMT(i,z,t)**(-rho_M1(i,z))]$IMTO(i,z)
4845                 + [(1 - beta_M1(i,z)) * DD(i,z,t)**(-rho_M1(i,z))]$DDO(i,z)
4846                   }**(-1 / rho_M1(i,z));
4847   
4848   EQ46(i,z,t)$[IMTO(i,z) and DDO(i,z)]..
4849      IMT(i,z,t) =e= {[beta_M1(i,z) / (1 - beta_M1(i,z))] * [PD(i,z,t) / PMT(i,z,t)]}**sigma_M1(i,z) * DD(i,z,t);
4850   
4851   EQ47(i,z,t)$IMTO(i,z)..
4852      IMT(i,z,t) =e= B_M2(i,z) * SUM[zj$IMO(i,zj,z), beta_M2(i,zj,z) * IM(i,zj,z,t)**(-rho_M2(i,z))]**(-1 / rho_M2(i,z));
4853   
4854   EQ48(i,zj,z,t)$IMO(i,zj,z)..
4855      IM(i,zj,z,t) =e= IMT(i,z,t) / B_M2(i,z)**(1 - sigma_M2(i,z)) *
4856                       [beta_M2(i,zj,z) * PMT(i,z,t) / PM(i,zj,z,t)]**sigma_M2(i,z);
4857   
4858  *==============================================================================
4859  * 5.3.5 Prices
4860  *==============================================================================
4861   EQ49(j2,z,t)..
4862      PP(j2,z,t) * XST(j2,z,t) =e= PKLE(j2,z,t) * KLE(j2,z,t) + PCI(j2,z,t) * CI(j2,z,t);
4863   
4864  EQ49_1(j3,z,t)$[not BS(j3)]..
4865      PP(j3,z,t) * XST(j3,z,t) =e= PVA(j3,z,t) * VA(j3,z,t) + PCI(j3,z,t) * CI(j3,z,t) + PCE(j3,z,t) * CE(j3,z,t);
4866   
4867   EQ50(j,z,t)..
4868      PT(j,z,t) =e= (1 + ttip(j,z,t)) * PP(j,z,t);
4869   
4870   EQ51(j,z,t)..
4871      PCI(j,z,t) * CI(j,z,t) =e= SUM[nene, PC(nene,z,t) * DI(nene,j,z,t)];
4872   
4873   EQ51_2(j3,z,t)..
4874      PCE(j3,z,t) * CE(j3,z,t) =e= SUM[ene, PC(ene,z,t) * DE(ene,j3,z,t) + PC(ene,z,t) * CTAX(z,t) * CO2FACTOR2(ene,j3,z,t) * DE(ene,j3,z,t)];
4875   
4876   EQ51_1(j2,z,t)..
4877      PCE(j2,z,t) * CE(j2,z,t) =e= [PCEelec(j2,z,t) * DEelec(j2,z,t) + PCEnelec(j2,z,t) * DEnelec(j2,z,t)];
4878   
4879   EQ51_3(j2,z,t)..
4880      PCEelec(j2,z,t) * DEelec(j2,z,t) =e= PC("18_ELEC",z,t) * DE("18_ELEC",j2,z,t);
4881   
4882   EQ51_4(j2,z,t)..
4883      PCEnelec(j2,z,t) * DEnelec(j2,z,t) =e= [PCEcoalgas(j2,z,t) * DEcoalgas(j2,z,t) + PCEoilpetrol(j2,z,t) * DEoilpetrol(j2,z,t)];
4884   
4885   EQ51_5(j2,z,t)..
4886      PCEcoalgas(j2,z,t) * DEcoalgas(j2,z,t) =e= [PC("02_COAL",z,t) * DE("02_COAL",j2,z,t) + PC("02_COAL",z,t) * CTAX(z,t) * CO2FACTOR2("02_COAL",j2,z,t) * DE("02_COAL",j2,z,t)
4887                                               + PC("04_GAS",z,t) * DE("04_GAS",j2,z,t) + PC("04_GAS",z,t) * CTAX(z,t) * CO2FACTOR2("04_GAS",j2,z,t) * DE("04_GAS",j2,z,t)];
4888   
4889   EQ51_6(j2,z,t)..
4890      PCEoilpetrol(j2,z,t) * DEoilpetrol(j2,z,t) =e= [PC("03_OIL",z,t) * DE("03_OIL",j2,z,t) + PC("03_OIL",z,t) * CTAX(z,t) * CO2FACTOR2("03_OIL",j2,z,t) * DE("03_OIL",j2,z,t)
4891                                                   + PC("10_PETROLCOAL",z,t) * DE("10_PETROLCOAL",j2,z,t) + PC("10_PETROLCOAL",z,t) * CTAX(z,t) * CO2FACTOR2("10_PETROLCOAL",j2,z,t) * DE("10_PETROLCOAL",j2,z,t)];
4892   
4893  EQ52(j,z,t)..
4894      PVA(j,z,t) * VA(j,z,t) =e= [WC(j,z,t) * LDC(j,z,t)]$LDCO(j,z)
4895                               + [RC(j,z,t) * KDC(j,z,t)]$KDCO(j,z);
4896   
4897   EQ52_1(j2,z,t)..
4898      PKLE(j2,z,t) * KLE(j2,z,t) =e= [PVA(j2,z,t) * VA(j2,z,t)]$VAO(j2,z)
4899                                   + [PCE(j2,z,t) * CE(j2,z,t)]$CEO(j2,z);
4900   
4901   EQ53(j,z,t)..
4902      WC(j,z,t) * LDC(j,z,t) =e= WTI(j,z,t) * (LD(j,z,t));
4903   
4904   EQ54(j,z,t)$LDO(j,z)..
4905      WTI(j,z,t) * LD(j,z,t) =e= W(z,t) * (1 + ttiw(j,z,t)) * LD(j,z,t) - LaborRebate(j,z,t);
4906   
4907   EQ54_1(ene,j2,z,t)$DEO(ene,j2,z)..
4908      P4(ene,j2,z,t) =e= PC(ene,z,t);
4909   
4910   EQ56(k,j,z,t)$KDO(k,j,z)..
4911      RTI(k,j,z,t) =e= R(k,j,z,t) * (1 + ttik(k,j,z,t));
4912   
4913   EQ58(i,z,t)..
4914      P(i,z,t) * XS_I(i,z,t) =e= [PL(i,z,t) * DS_I(i,z,t)]$DSO_I(i,z)
4915                               + [PET(i,z,t) * EXT(i,z,t)]$EXTO(i,z)
4916                               + [e(z,t) * PWMG(i,t) * MRGN(i,z,t)]$MRGNO(i,z);
4917   
4918   EQ60(i,z,zj,t)$EXO(i,z,zj)..
4919      PE(i,z,zj,t) * (1 + ttix(i,z,zj,t)) =e= e(z,t) * PWX(i,z,zj,t);
4920   
4921   EQ61(i,z,t)$DDO(i,z)..
4922      PD(i,z,t) =e= (1 + ttic(i,z,t)) * PL(i,z,t);
4923   
4924   EQ62(i,zj,z,t)$IMO(i,zj,z)..
4925      PM(i,zj,z,t) =e= (1 + ttic(i,z,t)) * (1 + ttim(i,zj,z,t)) * e(z,t) * (PWM(i,zj,z,t) + SUM[ij, PWMG(ij,t) * tmrg(ij,i,zj,z)]);
4926   
4927   EQ64(i,z,t)..
4928      PC(i,z,t) * Q(i,z,t) =e= [PD(i,z,t) * DD(i,z,t)]$DDO(i,z) + [PMT(i,z,t) * IMT(i,z,t)]$IMTO(i,z);
4929   
4930  EQ66(z,t)..
4931      PIXGDP(z,t) =e= {
4932        ( SUM[j$XSTO(j,z), {(PVA(j,z,t) * VA(j,z,t) + TIP(j,z,t)) / VA(j,z,t)} * VAO(j,z)]
4933          + SUM[(BS, Z_GRN)$(sameas(z, Z_GRN) and XSTO(BS, Z_GRN)), PTSF(BS, Z_GRN, t) * TSFO(BS, Z_GRN)] )
4934        /
4935        ( SUM[j$XSTO(j,z), {(PVAO(j,z) * VAO(j,z) + TIPO(j,z)) / VAO(j,z)} * VAO(j,z)]
4936          + SUM[(BS, Z_GRN)$(sameas(z, Z_GRN) and XSTO(BS, Z_GRN)), PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN)] )
4937        * ( SUM[j$XSTO(j,z), {(PVA(j,z,t) * VA(j,z,t) + TIP(j,z,t)) / VA(j,z,t)} * VA(j,z,t)]
4938          + SUM[(BS, Z_GRN)$(sameas(z, Z_GRN) and XSTO(BS, Z_GRN)), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t)] )
4939        /
4940        ( SUM[j$XSTO(j,z), {(PVAO(j,z) * VAO(j,z) + TIPO(j,z)) / VAO(j,z)} * VA(j,z,t)]
4941          + SUM[(BS, Z_GRN)$(sameas(z, Z_GRN) and XSTO(BS, Z_GRN)), PTSFO(BS, Z_GRN) * TSFD(BS, Z_GRN, t)] )
4942      }**0.5;
4943   
4944   EQ67(t)..
4945      PIXGDP_W(t) =e= {
4946        ( SUM[(j,z)$XSTO(j,z), {(PVA(j,z,t) * VA(j,z,t) + TIP(j,z,t)) / VA(j,z,t)} * VAO(j,z) / e(z,t)]
4947          + SUM[(BS, Z_GRN)$XSTO(BS, Z_GRN), PTSF(BS, Z_GRN, t) * TSFO(BS, Z_GRN) / e(Z_GRN, t)] )
4948        /
4949        ( SUM[(j,z)$XSTO(j,z), {(PVAO(j,z) * VAO(j,z) + TIPO(j,z)) / VAO(j,z)} * VAO(j,z) / eO(z)]
4950          + SUM[(BS, Z_GRN)$XSTO(BS, Z_GRN), PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN) / eO(Z_GRN)] )
4951        * ( SUM[(j,z)$XSTO(j,z), {(PVA(j,z,t) * VA(j,z,t) + TIP(j,z,t)) / VA(j,z,t)} * VA(j,z,t) / e(z,t)]
4952          + SUM[(BS, Z_GRN)$XSTO(BS, Z_GRN), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t) / e(Z_GRN, t)] )
4953        /
4954        ( SUM[(j,z)$XSTO(j,z), {(PVAO(j,z) * VAO(j,z) + TIPO(j,z)) / VAO(j,z)} * VA(j,z,t) / eO(z)]
4955          + SUM[(BS, Z_GRN)$XSTO(BS, Z_GRN), PTSFO(BS, Z_GRN) * TSFD(BS, Z_GRN, t) / eO(Z_GRN)] )
4956      }**0.5;
4957   
4958   EQ68(z,t)..
4959      PIXCON(z,t) =e= SUM[i, PC(i,z,t) * CO(i,z)] / SUM[i, PCO(i,z) * CO(i,z)];
4960   
4961   EQ69(z,t)..
4962      PIXINV(z,t) =e= PROD[i$gamma_INV(i,z), (PC(i,z,t) / PCO(i,z))**gamma_INV(i,z)];
4963   
4964   EQ70(z,t)..
4965      PIXGVT(z,t) =e= PROD[i$gamma_GVT(i,z), (PC(i,z,t) / PCO(i,z))**gamma_GVT(i,z)];
4966   
4967  *==============================================================================
4968  * 5.3.6 Equilibrium
4969  *==============================================================================
4970  EQ71(i1,z,t)..
4971      Q(i1,z,t) =e= C(i1,z,t) + CG(i1,z,t) + INV(i1,z,t) + DIT(i1,z,t) + (QDAC(z,t) * DAC_Tech_Coeff(i1)) ;
4972   
4973   EQ72(z,t)..
4974      LS(z,t) =e= SUM[j$LDO(j,z), LD(j,z,t)] ;
4975   
4976   EQ73(k,z,t)$KSO(k,z)..
4977      KS(k,z,t) =e= SUM[j$KDO(k,j,z), KD(k,j,z,t)] ;
4978   
4979   EQ74(z,t)..
4980      IT(z,t) =e= SH(z,t) + SG(z,t) - CAB(z,t);
4981   
4982   EQ75(z,t)..
4983      DEP(z,t) =e= PK(z,t) * delta(z) * SUM[k$KSO(k,z), KS(k,z,t)];
4984   
4985   EQ76(i,z,t)$DDO(i,z)..
4986      SUM[j$DSO(j,i,z), DS(j,i,z,t)] =e= DD(i,z,t);
4987   
4988   EQ77(i,z,zj,t)$EXO(i,z,zj)..
4989      EX(i,z,zj,t) =e= IM(i,z,zj,t);
4990   
4991   EQ78(i,z,zj,t)$EXO(i,z,zj)..
4992      PWX(i,z,zj,t) =e= PWM(i,z,zj,t);
4993   
4994   EQ79(i,t)..
4995      SUM[z$MRGNO(i,z), MRGN(i,z,t)] =e= SUM[(z,zj,ij)$IMO(ij,zj,z), tmrg(i,ij,zj,z) * IM(ij,zj,z,t)]+MRGN_RES(i) ;
4996   
4997  *==============================================================================
4998  * 5.3.7 Gross domestic product
4999  *==============================================================================
5000   EQ81(z,t)..
5001      GDP_BP(z,t) =e= SUM[j, PVA(j,z,t) * VA(j,z,t)] + TIPT(z,t)
5002                    + SUM((BS, Z_GRN)$sameas(z, Z_GRN), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t));
5003   
5004   EQ82(z,t)..
5005      GDP_MP(z,t) =e= GDP_BP(z,t) + TPRCTS(z,t) + TCTAX(z,t);
5006   
5007   EQ83(z,t)..
5008      GDP_IB(z,t) =e= SUM[(j)$LDO(j,z), W(z,t) * (LD(j,z,t))]
5009                    + SUM[(k,j)$KDO(k,j,z), R(k,j,z,t) * (KD(k,j,z,t))]
5010                    + SUM((BS, Z_GRN)$sameas(z, Z_GRN), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t))
5011                    + TPRCTS(z,t) + TPRODN(z,t) + TCTAX(z,t);
5012   
5013   EQ84(z,t)..
5014      GDP_FD(z,t) =e= SUM[i, PC(i,z,t) * (C(i,z,t) + CG(i,z,t) + INV(i,z,t))]
5015                    + SUM[(i,zj)$EXO(i,z,zj), e(z,t) * PWX(i,z,zj,t) * EX(i,z,zj,t)]
5016                    + SUM[i$MRGNO(i,z), e(z,t) * PWMG(i,t) * MRGN(i,z,t)]
5017                    - SUM[(i,zj)$IMO(i,zj,z), e(z,t) * IM(i,zj,z,t) * (PWM(i,zj,z,t) + SUM[ij, PWMG(ij,t) * tmrg(ij,i,zj,z)])]
5018                    + SUM(i1, PC(i1,z,t) * QDAC(z,t) * DAC_Tech_Coeff(i1));
5019   
5020   EQ85(t)..
5021      GDP_BP_W(t) =e= SUM[z, GDP_BP(z,t) / e(z,t)];
5022   
5023  *==============================================================================
5024  * 5.3.8 Real (volume) variables computed from price indices
5025  *==============================================================================
5026   EQ86(z,t)..
5027      CTH_REAL(z,t) =e= CTH(z,t) / PIXCON(z,t);
5028   
5029   EQ87(z,t)..
5030      G_REAL(z,t) =e= G(z,t) / PIXGVT(z,t);
5031   
5032   EQ88(z,t)..
5033      GDP_BP_REAL(z,t) =e= GDP_BP(z,t) / PIXGDP(z,t);
5034   
5035   EQ89(t)..
5036      GDP_BP_W_REAL(t) =e= GDP_BP_W(t) / PIXGDP_W(t);
5037   
5038   EQ90(z,t)..
5039      GDP_MP_REAL(z,t) =e= GDP_MP(z,t) / PIXCON(z,t);
5040   
5041   EQ91(z,t)..
5042      IT_REAL(z,t) =e= IT(z,t) / PIXINV(z,t);
5043   
5044   EQ92(z,t)..
5045      CABX(z,t) =e= CAB(z,t) / [PIXGDP_W(t) * e(z,t)];
5046   
5047  *==============================================================================
5048  * 5.3.8 Dynamic equations
5049  *==============================================================================
5050   EQ94(z,t)..
5051      IT(z,t) =e= PK(z,t) * SUM[(k,j)$KDO(k,j,z), IND(k,j,z,t)];
5052   
5053   EQ95(z,t)..
5054      PK(z,t) =e= 1 / A_K(z) * PROD[i$gamma_INV(i,z), (PC(i,z,t) / gamma_INV(i,z))**gamma_INV(i,z)];
5055   
5056   EQ96(k,bus,z,t)$KDO(k,bus,z)..
5057      IND(k,bus,z,t) =e= phi(z,t) * [R(k,bus,z,t) / U(z,t)]**sigma_INV(k,bus,z) * (KD(k,bus,z,t));
5058   
5059   EQ97a(z,t)..
5060      IR(z,t) =e= {SUM[(k,j)$KDO(k,j,z), R(k,j,z,t) * (KD(k,j,z,t))] - DEP(z,t)} /
5061                  {PK(z,t) * SUM[(k,j)$KDO(k,j,z), (KD(k,j,z,t))]};
5062   
5063   EQ97b(z,t)..
5064      U(z,t) =e= PK(z,t) * (delta(z) + IR(z,t));
5065   
5066  *==============================================================================
5067  * 5.3.9 Other
5068  *==============================================================================
5069   WALRAS(z,t)..
5070      LEON(z,t) =e= Q('01_AGRICULT',z,t) - C('01_AGRICULT',z,t) - CG('01_AGRICULT',z,t) - INV('01_AGRICULT',z,t) - DIT('01_AGRICULT',z,t);
5071   
5072  *================================================================================
5073  * 6 Labour Supply
5074  *================================================================================
5075   EQ106(z,t)..
5076      LS(z,t) =e= LST(z,t) * ((W(z,t) / PIXCON(z,t)) / (W_lag(z,t) / PIXCON_lag(z,t)))**elasLS(z);
5077   
5078  *==============================================================================
5079  * 7 PERMIT
5080  *==============================================================================
5081   EQ107(j,z,t)..
5082      PERMIT(j,z,t) =e= SUM(ene, CO2FACTOR2(ene,j,z,t) * DE(ene,j,z,t));
5083   
5084   EQ108(z,t)..
5085      PERMIT_TOTAL(z,t) =e= SUM(j, PERMIT(j,z,t)) - QDAC(z,t) * switchDAC(z,t);
5086   
5087  *==============================================================================
5088  * 8 Carbon Tax Revenue Recycling
5089  *==============================================================================
5090   EQ109(z,t)..
5091      REBATE(z,t) =e= TCTAX(z,t);
5092   
5093   EQ110(j,z,t)..
5094      TIW_Share(j,z,t) =e= LD(j,z,t) / SUM(jj, LD(jj,z,t));
5095   
5096   EQ111(j,z,t)..
5097      LaborRebate(j,z,t) =e= TIW_Share(j,z,t) * TCTAX(z,t) * recycle_labor(z,t);
5098   
5099  *==============================================================================
5100  * 9 DAC
5101  *==============================================================================
5102   EQ118(z,t)..
5103      QDAC(z,t) =e= DAC_MAX(z) * DAC_growth_rate(z,t) * switchDAC(z,t);
5104   
5105   EQ_OBJ..
5106      OBJ =e= 1.0;
5107   
5108  *==============================================================================
5109  * 10 TSF Equations - CES
5110  *==============================================================================
5111   EQ_PP_GRN(BS, Z_GRN, t)..
5112      PP(BS, Z_GRN, t) * XST(BS, Z_GRN, t) =e= PVAT(BS, Z_GRN, t) * VAT(BS, Z_GRN, t)
5113                                             + PCI(BS, Z_GRN, t) * CI(BS, Z_GRN, t)
5114                                             + PCE(BS, Z_GRN, t) * CE(BS, Z_GRN, t);
5115   
5116   EQ_VA_GRN(BS, Z_GRN, t)..
5117      VA(BS, Z_GRN, t) =e= VAT(BS, Z_GRN, t)
5118                         * (beta_VAT(BS, Z_GRN) * PVAT(BS, Z_GRN, t) / PVA(BS, Z_GRN, t))**sigma_VAT(BS, Z_GRN)
5119                         * (B_VAT_t(BS, Z_GRN, t))**(sigma_VAT(BS, Z_GRN) - 1);
5120   
5121   EQ_VAT_REQ(BS, Z_GRN, t)..
5122      VAT(BS, Z_GRN, t) =e= v_vat(BS, Z_GRN) * XST(BS, Z_GRN, t);
5123   
5124  EQ_PVAT(BS, Z_GRN, t)..
5125      PVAT(BS, Z_GRN, t) * VAT(BS, Z_GRN, t) =e= PVA(BS, Z_GRN, t) * VA(BS, Z_GRN, t)
5126                                               + PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t);
5127   
5128   EQ_TSFD(BS, Z_GRN, t)..
5129      TSFD(BS, Z_GRN, t) =e= VAT(BS, Z_GRN, t)
5130                           * ((1 - beta_VAT(BS, Z_GRN)) * PVAT(BS, Z_GRN, t) / PTSF(BS, Z_GRN, t))**sigma_VAT(BS, Z_GRN)
5131                           * (B_VAT_t(BS, Z_GRN, t))**(sigma_VAT(BS, Z_GRN) - 1);
5132   
5133   EQ_TSFMKT(BS, Z_GRN, t)..
5134      TSFS(BS, Z_GRN, t) =e= TSFD(BS, Z_GRN, t);
5135   
5136  * ===================================================================
5137  * 11. Terms of Trade (ToT) Equations (Bilateral World Prices)
5138  * ===================================================================
5139   EQ_PX_INDEX(z,t)..
5140      PX_INDEX(z,t) =e= SUM((i,zj)$VFOB0(i,z,zj), W_EXP(i,z,zj) * (PWX(i,z,zj,t) / PWX0(i,z,zj)));
5141   
5142   EQ_PM_INDEX(z,t)..
5143      PM_INDEX(z,t) =e= SUM((i,zj)$VCIF0(i,zj,z), W_IMP(i,zj,z) * ( (PWM(i,zj,z,t) + SUM(ij, PWMG(ij,t) * tmrg(ij,i,zj,z))) / PCIF0(i,zj,z) ));
5144   
5145   EQ_TOT(z,t)..
5146      TOT(z,t) * PM_INDEX(z,t) =e= PX_INDEX(z,t);
5147   
5148  *==============================================================================
5149  * 6 Numerical resolution to compute A_VA, sh0, G, G_REAL and IND
5150  *==============================================================================
5151  option cns = conopt4;
5152  *option cns = path;
5153  *option cns = minos;
5154  *option nlp = conopt4;
5155   
5156  *option iterlim = 0;
5157  *option limrow = 100, limcol = 100;
5158  *option conopt4.TolPiv = 1e-6;
5159  *option iterlim = 100;
5160  *option reslim = 1000;
5161  *option lmmxsf = t ;
5162  *Eliminating display of solution makes it easier to check whether model solves
5163  *and to identify year when it crashes.
5164  *option profile=1;
5165  *option profile=3;
5166  *option profiletol=10;
5167   
5168  *Fast solve option
5169  option profile=0;
5170  option limrow=0, limcol=0, solprint = off;

