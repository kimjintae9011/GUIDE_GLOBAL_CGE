3964  *  4.12 CO2FACTOR and CTAX
3965  *==============================================================================
3966  Parameters
3967   CO2_Energy(ene,j,z)        CO2 emissions from Energy
3968  ;
3969   
3970   CO2_Energy('02_COAL',j,z) = sum(p_coal,CO2IO(p_coal,j,z));
3971   CO2_Energy('03_OIL',j,z)  = sum(p_oil,CO2IO(p_oil,j,z));
3972   CO2_Energy('04_GAS',j,z)  = sum(p_gas,CO2IO(p_gas,j,z));
3973   CO2_Energy('10_PETROLCOAL',j,z)  = sum(p_oilproduct,CO2IO(p_oilproduct,j,z));
3974   
3975  Parameters
3976   CO2FACTOR(ene,j,z)       CO2 emissions factor (tCO2 per 100$)
3977   CO2FACTOR2(ene,j,z,time) Time series CO2 emissions factor (tCO2 per 100$)
3978  ;
3979   
3980   CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*(1000/(10**8));
3981   CO2FACTOR('03_OIL',j,z)$DEO('03_OIL',j,z)   = [sum(p_oil,CO2IO(p_oil,j,z))/DEO('03_OIL',j,z)]*(1000/(10**8));
3982   CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z)   = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*(1000/(10**8));
3983   CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*(1000/(10**8));
3984   
3985  Parameters
3986  Global_CO2FACTOR(ene,j)       Global Average CO2 emissions factor (tCO2 per 100$)
3987  ;
3988   
3989   Global_CO2FACTOR('02_COAL',j)            = [sum((p_coal,z),CO2IO(p_coal,j,z))/sum(z,DEO('02_COAL',j,z))]*(1000/(10**8));
3990   Global_CO2FACTOR('03_OIL',j)               = [sum((p_oil,z),CO2IO(p_oil,j,z))/sum(z,DEO('03_OIL',j,z))]*(1000/(10**8));
3991   Global_CO2FACTOR('04_GAS',j)              = [sum((p_gas,z),CO2IO(p_gas,j,z))/sum(z,DEO('04_GAS',j,z))]*(1000/(10**8));
3992   Global_CO2FACTOR('10_PETROLCOAL',j) = [sum((p_oilproduct,z),CO2IO(p_oilproduct,j,z))/sum(z,DEO('10_PETROLCOAL',j,z))]*(1000/(10**8));
3993   
      *MNG
      CO2FACTOR('02_COAL','31_SER','05_MNG')        = 2;
       
      *PRK
       CO2FACTOR('02_COAL','01_AGRICULT','06_PRK')        = CO2FACTOR('02_COAL','01_AGRICULT','05_MNG');
       CO2FACTOR('10_PETROLCOAL','01_AGRICULT','06_PRK')  = CO2FACTOR('10_PETROLCOAL','01_AGRICULT','05_MNG');
       CO2FACTOR('02_COAL','28_LTRP','06_PRK')            = CO2FACTOR('02_COAL','28_LTRP','05_MNG');
       CO2FACTOR('02_COAL','17_OTHERIND','06_PRK')        = CO2FACTOR('02_COAL','17_OTHERIND','05_MNG');
       
      *RUS
       CO2FACTOR('02_COAL','08_WOODPRO','04_RUS')    = CO2FACTOR('02_COAL','08_WOODPRO','10_EEU');
       CO2FACTOR('04_GAS','17_OTHERIND','04_RUS')      = SMAX(j$(not sameas(j, '17_OTHERIND')), CO2FACTOR('04_GAS', j, '04_RUS'));
       
      *LAM
       CO2FACTOR('04_GAS','02_COAL','08_LAM')             = CO2FACTOR('04_GAS','02_COAL','07_NAM');
       
      * CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) gt 10) = 10 ;
4013   
4014  CO2FACTOR(ene, j, z)$(
4015      not sameas(j, '13_IRONSTL') and
4016      not sameas(j, '20_eCoal') and
4017      not sameas(j, '21_eGas') and
4018      not sameas(j, '22_eOil')
4019  ) = MIN(CO2FACTOR(ene, j, z), Global_CO2FACTOR(ene, j));
