--- LOAD  sigma_X1 = 4:sigma_X1
--- LOAD  sigma_X2 = 5:sigma_X2
--- LOAD  sigma_X3 = 6:sigma_X3
--- LOAD  sigma_X0 = 7:sigma_X0
--- LOAD  sigma_Y = 8:sigma_y
--- LOAD  sigma_INV = 10:sigma_inv
--- LOAD  PARZ = 9:PARZ
1005   
1006  *===============================================================================
1007  * Elasticity Parameter Assignments
1008  *===============================================================================
1009  *CES - KLE(backstop)
1010   sigma_KLE(BS,z)          = 0.5;
1011   sigma_KLE('16_TRANSEQ','07_NAM') = 0.5 ;
1012   
1013   
1014  * CES - composite K-L
1015   sigma_VA('10_PETROLCOAL',z) = 0.2;
1016   sigma_VA('18_TnD',z)        = 0.2;
1017   sigma_VA('19_eNuclear',z)   = 0.2;
1018   sigma_VA('20_eCoal',z)      = 0.2;
1019   sigma_VA('21_eGas',z)       = 0.2;
1020   sigma_VA('22_eOil',z)       = 0.2;
1021   sigma_VA('23_eWind',z)      = 0.2;
1022   sigma_VA('24_eSolar',z)     = 0.2;
1023   sigma_VA('25_eHydro',z)     = 0.2;
1024   sigma_VA('26_eOther',z)     = 0.2;
1025   sigma_VA(BS,z)              = 0.5;
1026   
1027  * CES - composite capital
1028    sigma_KD(j,z)        = 2 * sigma_VA(j,z);
1029    sigma_KD(BS,Z)     = 0.5;
1030   
1031  * CES - composite labor
1032    sigma_LD(j,z)        = 2 * sigma_VA(j,z);
1033    sigma_LD(BS,Z)     = 0.5;
1034   
1035  * CES - composite ENER
1036   sigma_ENER_elec(j2,z)         = 1.5;
1037   sigma_ENER_nelec(j2,z)       = 0.5;
1038   sigma_ENER_coalgas(j2,z)    = 2.0;
1039   sigma_ENER_oilprod(j2,z)     = 0.5;
1040   
1041  * CES - DOM vs.IMP
1042   sigma_M1('03_OIL','06_PRK') = 0.5;
1043   sigma_M1('04_GAS',Z) = 6;
1044   sigma_M1('11_CHEMICAL','05_MNG') = 1.5;
1045   sigma_M1('13_IRONSTL','05_MNG') = 1.1;
1046   
1047  * CES - IMP sourcing
1048   sigma_M2('03_OIL',Z) = 2;
1049   sigma_M2('04_GAS',Z) = 2;
1050   
1051  *CET - exports and local sales
1052   sigma_X0(j,z)                 = 1.5;
1053   
1054  * CET - total output
1055   sigma_X2(i,z)                 = 2;
1056   
1057  * CES - composite Power sector
1058   sigma_X4(z)                   = 2.5;
1059   sigma_X4('07_NAM')       = 1.5;
1060   sigma_X4('09_WEU')       = 1.5;
1061  * sigma_X4('16_PAS')        = 0.5;
1062   sigma_X4('06_PRK')        = 0.5;
1063   
1064  * CES - composite BS sector
1065   sigma_BS(BS, Z_GRN)       = 5;
1066   sigma_BS(BS, '07_NAM')    = 5;
1067   sigma_BS(BS, '09_WEU')    = 5;
1068   
1069  * sigma_VAT(BS,Z_GRN)   = 1.5;
1070   sigma_VAT('32_BSCHEMICAL',Z_GRN)   = 0.5;
1071   sigma_VAT('33_BSNONMET',Z_GRN)     = 0.5;
1072   sigma_VAT('34_BSIRONSTL',Z_GRN)     = 0.5;
1073   sigma_VAT('35_BS_LTRP',Z_GRN)         = 0.5;
1074   sigma_VAT('36_BS_WTRP',Z_GRN)        = 0.5;
1075   sigma_VAT('37_BS_ATRP',Z_GRN)         = 0.5;
1076   
1077  * Investment demand elasticity
1078   sigma_INV(k,j,z)              = 0.5;
1079   
1080  * LES parameters - Frisch all (1.1)
1081  * frisch(z)                     = PARZ(z,'frisch');
1082   frisch('01_KOR') = -1.30;
1083   frisch('02_CHN') = -1.45;
1084   frisch('03_JPN') = -1.25;
1085   frisch('04_RUS') = -1.45;
1086   frisch('05_MNG') = -1.70;
1087   frisch('06_PRK') = -2.00;
1088   frisch('07_NAM') = -1.20;
1089   frisch('08_LAM') = -1.50;
1090   frisch('09_WEU') = -1.20;
1091   frisch('10_EEU') = -1.40;
1092   frisch('11_FSU') = -1.60;
1093   frisch('12_MEA') = -1.60;
1094   frisch('13_AFR') = -1.90;
1095   frisch('14_CPA') = -1.70;
1096   frisch('15_SAS') = -1.80;
1097   frisch('16_PAS') = -1.50;
1098   frisch('17_PAO') = -1.20;
1099   
1100  * Labour supply
1101   elasLS(z)                     = 0.1;
1102   
1103  *==============================================================================
1104  * Rescaling
1105  *==============================================================================
1106  * GTAP data are in millions of US dollars With RES = 10000, model results are in tens of billions (10G$)
1107   RES = 10000;
1108   CO(i,z)          = CO(i,z) / RES;
1109   CGO(i,z)         = CGO(i,z) / RES;
1110   DDO(i,z)         = DDO(i,z) / RES;
1111   DEPO(z)          = DEPO(z) / RES;
1112   DIO(i,j,z)       = DIO(i,j,z) / RES;
1113   DSO(j,i,z)       = DSO(j,i,z) / RES;
1114   DSO_I(i,z)       = DSO_I(i,z) / RES;
1115   EXO(i,z,zj)      = EXO(i,z,zj) / RES;
1116   IMO(i,z,zj)      = IMO(i,z,zj) / RES;
1117   INVO(i,z)        = INVO(i,z) / RES;
1118   KSTO(z)          = KSTO(z) / RES;
1119   LDO(j,z)         = LDO(j,z) / RES;
1120   MRGNO(i,z)       = MRGNO(i,z) / RES;
1121   RKDO(k,j,z)      = RKDO(k,j,z) / RES;
1122   TDHO(z)          = TDHO(z) / RES;
1123   TICO(i,z)        = TICO(i,z) / RES;
1124   TIKO(k,j,z)      = TIKO(k,j,z) / RES;
1125   TIMO(i,z,zj)     = TIMO(i,z,zj) / RES;
1126   TIPO(j,z)        = TIPO(j,z) / RES;
1127   TIWO(j,z)        = TIWO(j,z) / RES;
1128   TIXO(i,z,zj)     = TIXO(i,z,zj) / RES;
1129   tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj) / RES;
1130   XSO_I(i,z)       = XSO_I(i,z) / RES;
1131   XSO(j,i,z)       = XSO(j,i,z) / RES;
1132   XSTO(j,z)        = XSTO(j,z) / RES;
1133   
1134  *==============================================================================
1135  * [NEW] Backstop Technology Split & TSF Initialization (Upstream Injection)
1136  *==============================================================================
1137  PARAMETER
1138   seed(j)                Initial share of the new technology
1139   TSFO(j, z)             Initial year TSF input for backstop (Value)
1140   PTSFO(j, z)            Initial year TSF price for backstop
1141   Green_Markup(j, z)     Initial efficiency penalty for backstop
1142   SHR_MRGN(j, i, z)      Share of international transport margin for sector j !! [Added] Margin distribution share
1143  ;
1144   
1145  seed(BS) = 0.01;
1146  PTSFO(BS, Z_GRN) = 1.0;
1147  Green_Markup(BS, Z_GRN) = 1.0;
1148   
1149  * [Added] Initialize default margin share to 1.0 (100%) for all industries before splitting
1150  SHR_MRGN(j, i, z)$XSO(j, i, z) = 1.0;
1151   
1152  LOOP(Z_GRN,
1153  *--------------------------------------------------------------------------
1154  * [1] Split raw data by seed share and preserve identities
1155  *--------------------------------------------------------------------------
1156    LOOP(MAP_BS(j, jj, i),
1157  * Allocate to backstop industry
1158      LDO(j, Z_GRN)       = LDO(jj, Z_GRN) * seed(j);
1159      RKDO(k, j, Z_GRN)   = RKDO(k, jj, Z_GRN) * seed(j);
1160      TIPO(j, Z_GRN)      = TIPO(jj, Z_GRN) * seed(j);
1161      TIWO(j, Z_GRN)      = TIWO(jj, Z_GRN) * seed(j);
1162      TIKO(k, j, Z_GRN)   = TIKO(k, jj, Z_GRN) * seed(j);
1163      DIO(ii, j, Z_GRN)   = DIO(ii, jj, Z_GRN) * seed(j);
1164      EMPLOY(j, Z_GRN)    = EMPLOY(jj, Z_GRN) * seed(j);
1165   
1166      XSO(j, i, Z_GRN)    = (XSO(jj, i, Z_GRN) * seed(j)) / Green_Markup(j, Z_GRN);
1167      XSTO(j, Z_GRN)      = (XSTO(jj, Z_GRN) * seed(j)) / Green_Markup(j, Z_GRN);
1168      DSO(j, i, Z_GRN)    = (DSO(jj, i, Z_GRN) * seed(j)) / Green_Markup(j, Z_GRN);
1169   
1170  * [Added] Allocate international margin share to backstop industry by seed share
1171      SHR_MRGN(j, i, Z_GRN) = seed(j);
1172   
1173  * Deduct exact share from conventional industry
1174      LDO(jj, Z_GRN)      = LDO(jj, Z_GRN) * (1 - seed(j));
1175      RKDO(k, jj, Z_GRN)  = RKDO(k, jj, Z_GRN) * (1 - seed(j));
1176      TIPO(jj, Z_GRN)     = TIPO(jj, Z_GRN) * (1 - seed(j));
1177      TIWO(jj, Z_GRN)     = TIWO(jj, Z_GRN) * (1 - seed(j));
1178      TIKO(k, jj, Z_GRN)  = TIKO(k, jj, Z_GRN) * (1 - seed(j));
1179      DIO(ii, jj, Z_GRN)  = DIO(ii, jj, Z_GRN) * (1 - seed(j));
1180      EMPLOY(jj, Z_GRN)   = EMPLOY(jj, Z_GRN) * (1 - seed(j));
1181   
1182      XSO(jj, i, Z_GRN)   = XSO(jj, i, Z_GRN) * (1 - seed(j));
1183      XSTO(jj, Z_GRN)     = XSTO(jj, Z_GRN) * (1 - seed(j));
1184      DSO(jj, i, Z_GRN)   = DSO(jj, i, Z_GRN) * (1 - seed(j));
1185   
1186  * [Added] Deduct international margin share from conventional industry (remaining share)
1187      SHR_MRGN(jj, i, Z_GRN) = 1.0 - seed(j);
1188    );
1189   
1190  *--------------------------------------------------------------------------
1191  * [2] Technology Specific Factor (TSF) Allocation
1192  *--------------------------------------------------------------------------
1193    LOOP(BS,
1194      TSFO(BS, Z_GRN) = (RKDO('cap', BS, Z_GRN) * 0.9) / PTSFO(BS, Z_GRN);
1195      RKDO('cap', BS, Z_GRN) = RKDO('cap', BS, Z_GRN) - (PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN));
1196    );
1197  );
1198   
1199  * Calculate initial values for TSF intensity and time series
1200  LOOP(BS,
1201    v_tsf(BS, Z_GRN)      = TSFO(BS, Z_GRN) / XSTO(BS, Z_GRN);
1202    TSFS(BS, Z_GRN, time) = TSFO(BS, Z_GRN);
1203  );
1204   
1205  *==============================================================================
1206  * 3.3 Exogenous prices and parameters
1207  *==============================================================================
1208   eta                = 1;
1209   ttdh0O(z)       = 0;
1210   eO(z)             = 1;
1211   PEO(i,z,zj)      = 1;
1212   PLO(i,z)          = 1;
1213   PWMGO(i)      = 1;
1214   WO(z)            = 1;
1215   WO_lag(z)      = WO(z);
1216   
1217  * -------------------------------------------------------------------
1218  * [동태 모형 고도화] 유령 산업에 초소형 정상 구조(Micro-Seed) 주입
1219  * -------------------------------------------------------------------
1220  SCALAR micro_tol / 0.01 /;
1221   
1222  * 1. 필터링을 위해 임시 PPO(가격 왜곡도)를 먼저 계산
1223  PARAMETER PPO_TEMP(j,z);
1224  PPO_TEMP(j,z)$XSTO(j,z) = ( TIWO(j,z) + WO(z)*LDO(j,z)
1225                            + SUM(k, TIKO(k,j,z) + RKDO(k,j,z))
1226                            + SUM(i, DIO(i,j,z)) ) / XSTO(j,z);
1227   
1228  * 2. [수정됨] 생산량이 적거나(XSTO < 0.01) OR 가격 왜곡이 극심한 경우(PPO > 2.0) 모두 포함
1229  LOOP((j,z)$( ( (XSTO(j,z) < micro_tol) or (PPO_TEMP(j,z) > 2.0) )
1230               and (PPO_TEMP(j,z) > 1.2 or PPO_TEMP(j,z) < 0.8)
1231               and not (BS(j) and Z_OTH(z)) ),
1232   
1233  * 3. 생산량(XSTO)이 너무 작으면 최소 Seed로 덮어쓰고, 어느 정도 있으면 그 규모 유지
1234      XSTO(j,z) = MAX(XSTO(j,z), 1E-5);
1235   
1236  * 4. 중국(02_CHN)의 동일 산업(j) 투입 구조 비율을 이식
1237      LDO(j,z)    = XSTO(j,z) * (LDO(j,'02_CHN') / XSTO(j,'02_CHN'));
1238      TIWO(j,z)   = XSTO(j,z) * (TIWO(j,'02_CHN') / XSTO(j,'02_CHN'));
1239      TIPO(j,z)   = XSTO(j,z) * (TIPO(j,'02_CHN') / XSTO(j,'02_CHN'));
1240   
1241      LOOP(k,
1242          RKDO(k,j,z) = XSTO(j,z) * (RKDO(k,j,'02_CHN') / XSTO(j,'02_CHN'));
1243          TIKO(k,j,z) = XSTO(j,z) * (TIKO(k,j,'02_CHN') / XSTO(j,'02_CHN'));
1244      );
1245   
1246      LOOP(i,
1247          DIO(i,j,z)  = XSTO(j,z) * (DIO(i,j,'02_CHN') / XSTO(j,'02_CHN'));
1248      );
1249  );
1250   
1251  *==============================================================================
1252  * Calibration
1253  *==============================================================================
1254   YHKO(z)          = SUM[(k,j), RKDO(k,j,z)];
1255   YHLO(z)          = SUM[(j), LDO(j,z)];
1256   YHO(z)           = YHLO(z) + YHKO(z) + SUM[BS, PTSFO(BS,z) * TSFO(BS,z)];
1257   YDHO(z)          = YHO(z) - TDHO(z);
1258   CTHO(z)          = SUM[i, CO(i,z)];
1259   SHO(z)           = YDHO(z) - CTHO(z);
1260   TICTO(z)         = SUM[i, TICO(i,z)];
1261   TIMTO(z)         = SUM[(i,zj), TIMO(i,zj,z)];
1262   TIWTO(z)         = SUM[(j), TIWO(j,z)];
1263   TIKTO(z)         = SUM[(k,j), TIKO(k,j,z)];
1264   TIPTO(z)         = SUM[j, TIPO(j,z)];
1265   TIXTO(z)         = SUM[(i,zj), TIXO(i,z,zj)];
1266   TPRODNO(z)       = TIKTO(z) + TIWTO(z) + TIPTO(z);
1267   TPRCTSO(z)       = TICTO(z) + TIMTO(z) + TIXTO(z);
1268   YGO(z)           = TDHO(z) + TPRCTSO(z) + TPRODNO(z);
1269   GO(z)            = SUM[i, CGO(i,z)];
1270   SGO(z)           = YGO(z) - GO(z);
1271   YROWO(z)         = SUM[(i,zj), IMO(i,zj,z)] + SUM[(i,ij,zj), tmrg(i,ij,zj,z)];
1272   SROWO(z)         = YROWO(z) - SUM[(i,zj), EXO(i,z,zj)] - SUM[i, MRGNO(i,z)];
1273   CABO(z)          = -SROWO(z);
1274   ITO(z)           = SHO(z) + SGO(z) + SROWO(z);
1275   
1276  *==============================================================================
1277  * Calibration of parameters and other variables
1278  *==============================================================================
1279   gamma_GVT(i,z)   = CGO(i,z) / SUM[ij, CGO(ij,z)];
1280   gamma_INV(i,z)   = INVO(i,z) / SUM[ij, INVO(ij,z)];
1281   
1282  *==============================================================================
1283  * Calibration of other prices and revised volumes (part 1)
1284  *==============================================================================
1285   LDO(j,z)         = LDO(j,z) / WO(z);
1286   LDCO(j,z)        = LDO(j,z);
1287   LSO(z)           = SUM[j, LDO(j,z)];
1288   LSTO(z)          = LSO(z);
1289   LSO_lag(z)       = LSO(z);
1290   LSTO_lag(z)      = LSO(z);
1291   EXO(i,z,zj)      = [EXO(i,z,zj) - TIXO(i,z,zj)] / PEO(i,z,zj);
1292   EXTO(i,z)        = SUM[zj, EXO(i,z,zj)];
1293   PWXO(i,z,zj)$EXO(i,z,zj)
1294                    = { [PEO(i,z,zj) * EXO(i,z,zj) + TIXO(i,z,zj)] / EXO(i,z,zj) } / eO(z);
1295   PETO(i,z)        = SUM[zj, PEO(i,z,zj) * EXO(i,z,zj)] / EXTO(i,z);
1296   PWMO(i,z,zj)     = PWXO(i,z,zj);
1297   IMO(i,zj,z)      = EXO(i,zj,z);
1298   IMTO(i,z)        = SUM[zj, IMO(i,zj,z)];
1299   
1300   DSO(j,i,z)       = DSO(j,i,z) / PLO(i,z);
1301   DSO_I(i,z)       = SUM(j, DSO(j,i,z));
1302   DSO_J(j,z)       = SUM(i, DSO(j,i,z));
1303   QO(i,z)          = IMTO(i,z) + DDO(i,z);
1304   MRGNO(i,z)$MRGNO(i,z)
1305                    = MRGNO(i,z) / [eO(z) * PWMGO(i)];
1306   XSO_I(i,z)       = EXTO(i,z) + DDO(i,z) + MRGNO(i,z);
1307   
1308   XSTO(j,z)        = SUM(i, XSO(j,i,z));
1309   PO(i,z)          = [ PETO(i,z) * EXTO(i,z) + PLO(i,z) * DSO_I(i,z)
1310                      + eO(z) * PWMGO(i) * MRGNO(i,z) ] / XSO_I(i,z);
1311   PO2(j,i,z)$XSO(j,i,z)                  = 1;
1312   PO2(BS,I_BS,Z_GRN) = Green_Markup(BS,Z_GRN);
1313   
1314   PO3(i,j,z)$XSO(j,i,z)                  = 1;
1315   
1316   PIO(i,z)         = SUM[j$XSO(j,i,z), PO2(J,I,z) * XSO(j,i,z)] / XSO_I(i,z);
1317   
1318   PTO(j,z)$XSTO(j,z) = SUM[i$XSO(j,i,z), PO2(j,i,z) * XSO(j,i,z)] / XSTO(j,z);
1319   
1320   PPO(j,z)$XSTO(j,z)
1321      = ( TIWO(j,z) + WO(z) * LDO(j,z)
1322        + SUM[k, TIKO(k,j,z) + RKDO(k,j,z)]
1323        + (PTSFO(j,z) * TSFO(j,z))$BS(j)
1324        + SUM[nene, DIO(nene,j,z)]
1325        + SUM[ene, DIO(ene,j,z)] ) / XSTO(j,z);
1326   
1327  * ==============================================================================
1328   
1329   theta2(j,i,z)    = DSO(j,i,z) / SUM(jj, DSO(jj,i,z));
1330   
1331   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z) * EXTO(i,z);
1332   
1333  *==============================================================================
1334  * Calibration of tax rates, margins, prices and volumes
1335  *==============================================================================
1336   ttixO(i,z,zj)    = [eO(z) * PWXO(i,z,zj) / PEO(i,z,zj)] - 1;
1337   tticO(i,z)       = TICO(i,z) /
1338                      { PLO(i,z) * DDO(i,z)
1339                      + SUM[zj, IMO(i,zj,z) * eO(z) * PWMO(i,zj,z)
1340                      + TIMO(i,zj,z) + SUM[ij, tmrg(ij,i,zj,z)]] };
1341   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
1342                    = tmrg(i,ij,zj,z) / (PWMGO(i) * eO(z) * IMO(ij,zj,z));
1343   ttimO(i,zj,z)$IMO(i,zj,z)
1344                    = TIMO(i,zj,z) /
1345                      { IMO(i,zj,z) * eO(z) * (PWMO(i,zj,z)
1346                      + SUM[ij, PWMGO(ij) * tmrg(ij,i,zj,z)]) };
1347   ttiwO(j,z)$LDO(j,z)
1348                    = TIWO(j,z) / [WO(z) * LDO(j,z)];
1349   ttikO(k,j,z)$RKDO(k,j,z)
1350                    = TIKO(k,j,z) / RKDO(k,j,z);
1351   ttipO(j,z)$XSTO(j,z) = [PTO(j,z) / PPO(j,z)] - 1;
1352   
1353   ttdh1O(z)        = [TDHO(z) - ttdh0O(z)] / YHO(z);
1354   
1355  *==============================================================================
1356  * Calibration of other prices and revised volumes (part 2)
1357  *==============================================================================
1358   PDO(i,z)         = PLO(i,z) * (1 + tticO(i,z));
1359   PMO(i,zj,z)      = eO(z) * (PWMO(i,zj,z) + SUM[ij, PWMGO(ij) * tmrg(ij,i,zj,z)])
1360                    * (1 + ttimO(i,zj,z)) * (1 + tticO(i,z));
1361   PMTO(i,z)        = SUM[zj, PMO(i,zj,z) * IMO(i,zj,z)] / IMTO(i,z);
1362   PCO(i,z)         = [PMTO(i,z) * IMTO(i,z) + PDO(i,z) * DDO(i,z)] / QO(i,z);
1363   CO(i,z)          = CO(i,z) / PCO(i,z);
1364   CGO(i,z)         = CGO(i,z) / PCO(i,z);
1365   DIO(nene,j,z)    = DIO(nene,j,z) / PCO(nene,z);
1366   DEO(ene,j,z)     = DIO(ene,j,z) / PCO(ene,z);
1367   
1368   DEelecO(j,z)     = DIO("18_ELEC",j,z) / PCO("18_ELEC",z);
1369   DEnelecO(j,z)    = SUM(ene3, DEO(ene3,j,z));
1370   
1371   DEcoalgasO(j,z)  = SUM(ene5, DEO(ene5,j,z));
1372   DEcoalO(j,z)     = DEO("02_COAL ",j,z);
1373   DEgasO(j,z)      = DEO("04_GAS",j,z);
1374   
1375   DEoilpetrolO(j,z)= SUM(ene6, DEO(ene6,j,z));
1376   DEoilO(j,z)      = DEO("03_OIL",j,z);
1377   DEpetrolO(j,z)   = DEO("10_PETROLCOAL",j,z);
1378   INVO(i,z)        = INVO(i,z) / PCO(i,z);
1379   
1380   CIO(j,z)         = SUM[nene, DIO(nene,j,z)];
1381   CEO(j3,z)        = SUM[ene, DEO(ene,j3,z)];
1382   CEO(j2,z)        = DEelecO(j2,z) + DEnelecO(j2,z);
1383   DITO(nene,z)     = SUM[j, DIO(nene,j,z)];
1384   DITO(ene,z)      = SUM[j, DEO(ene,j,z)];
1385   
1386   PO4(ene,j,z)     = PCO(ene,z);
1387   PCIO(j,z)$XSTO(j,z)
1388                    = SUM[nene, PCO(nene,z) * DIO(nene,j,z)] / CIO(j,z);
1389   
1390   PCEcoalO(j,z)$XSTO(j,z)   = PO4("02_COAL",j,z);
1391   PCEgasO(j,z)$XSTO(j,z)    = PO4("04_GAS",j,z);
1392   PCEoilO(j,z)$XSTO(j,z)    = PO4("03_OIL",j,z);
1393   PCEpetrolO(j,z)$XSTO(j,z) = PO4("10_PETROLCOAL",j,z);
1394   
1395   PCEoilpetrolO(j,z)$XSTO(j,z)
1396      = [ PCEoilO(j,z) * DEoilO(j,z) + PCEpetrolO(j,z) * DEpetrolO(j,z) ] / DEoilpetrolO(j,z);
1397   
1398   PCEcoalgasO(j,z)$XSTO(j,z)
1399      = [ PCEcoalO(j,z) * DEcoalO(j,z) + PCEgasO(j,z) * DEgasO(j,z) ] / DEcoalgasO(j,z);
1400   
1401   PCEnelecO(j,z)$XSTO(j,z)
1402      = [ PCEcoalgasO(j,z) * DEcoalgasO(j,z) + PCEoilpetrolO(j,z) * DEoilpetrolO(j,z) ] / DEnelecO(j,z);
1403   
1404   PCEelecO(j,z)$XSTO(j,z)
1405      = SUM[ene4, PCO(ene4,z) * DEO(ene4,j,z)] / DEelecO(j,z);
1406   
1407   PCEO(j,z)$XSTO(j,z)
1408      = [ PCEelecO(j,z) * DEelecO(j,z) + PCEnelecO(j,z) * DEnelecO(j,z) ] / CEO(j,z);
1409   
1410   PCEO(j3,z)$XSTO(j3,z)
1411      = SUM[ene, PCO(ene,z) * DEO(ene,j3,z)] / CEO(j3,z);
1412   
1413   WTIO(j,z)$XSTO(j,z)       = WO(z) * (1 + ttiwO(j,z));
1414   WCO(j,z)$LDCO(j,z)        = (WTIO(j,z) * LDO(j,z)) / LDCO(j,z);
1415   
1416  *==============================================================================
1417  * Calibration of dynamic parameters
1418  *==============================================================================
1419   PKO(z)           = 1;
1420   KSTO(z)          = KSTO(z) / PKO(z);
1421   KSTO(z)          = KSTO(z) - SUM((BS,Z_GRN)$sameas(z, Z_GRN), PTSFO(BS,Z_GRN) * TSFO(BS,Z_GRN));
1422   
1423   delta(z)         = DEPO(z) / [PKO(z) * KSTO(z)];
1424   
1425   RO(k,j,z)$RKDO(k,j,z)
1426                    = SUM[(kj,jj), RKDO(kj,jj,z)] / KSTO(z);
1427   
1428   KDO(k,j,z)$RKDO(k,j,z)
1429                    = RKDO(k,j,z) / RO(k,j,z);
1430   
1431   KSO(k,z)         = SUM[j, KDO(k,j,z)];
1432   IRO(z)           = { SUM[(k,j)$RKDO(k,j,z), RKDO(k,j,z)] - DEPO(z) } / [PKO(z) * KSTO(z)];
1433   UO(z)            = PKO(z) * (IRO(z) + delta(z));
1434   phiO(z)          = [ITO(z) / PKO(z)] / KSTO(z);
1435   
1436   INDO(k,j,z)$KDO(k,j,z)
1437                    = phiO(z) * KDO(k,j,z);
1438   
1439   A_K(z)           = 1 / PKO(z) * { PROD[i$gamma_INV(i,z), (PCO(i,z) / gamma_INV(i,z))**gamma_INV(i,z)] };
1440   KDCO(j,z)        = SUM[k, KDO(k,j,z)];
1441   RTIO(k,j,z)      = RO(k,j,z) * (1 + ttikO(k,j,z));
1442   
1443   RCO(j,z)$KDCO(j,z)
1444                    = SUM[k, RTIO(k,j,z) * KDO(k,j,z)] / KDCO(j,z);
1445   
1446  *==============================================================================
1447  * Calibration of other prices and revised volumes
1448  *==============================================================================
1449   VAO(j,z)       = LDCO(j,z) + KDCO(j,z);
1450   
1451   PVAO(j,z)$XSTO(j,z)
1452                     = [ WCO(j,z) * LDCO(j,z) + RCO(j,z) * KDCO(j,z) ] / VAO(j,z);
1453   
1454   KLEO(j,z)$XSTO(j,z)  = CEO(j,z) + VAO(j,z);
1455   
1456   PKLEO(j,z)$XSTO(j,z)
1457                      = [PCEO(j,z) * CEO(j,z) + PVAO(j,z) * VAO(j,z)] / KLEO(j,z);
1458   
1459   VATO(BS, Z_GRN)      = VAO(BS, Z_GRN) + TSFO(BS, Z_GRN);
1460   
1461   PVATO(BS, Z_GRN)
1462                      = [PVAO(BS, Z_GRN) * VAO(BS, Z_GRN) + PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN)] / VATO(BS, Z_GRN);
1463   
1464   PIXGDPO(z)           = 1;
1465   PIXGDP_WO          = 1;
1466   PIXCONO(z)           = 1;
1467   PIXCONO_lag(z)     = PIXCONO(z);
1468   PIXINVO(z)            = 1;
1469   PIXGVTO(z)           = 1;
1470   PPOWERO(z)         = 1;
1471   PBSO(BS, Z_GRN)  = 1.0;
1472   
1473  *==============================================================================
1474  * Calibration of LES parameters
1475  *==============================================================================
1476   sigma_Y(i,z)   = sigma_Y(i,z) / { SUM[ij, sigma_Y(ij,z) * PCO(ij,z) * CO(ij,z)] / CTHO(z) };
1477   gamma_LES(i,z) = PCO(i,z) * CO(i,z) * sigma_Y(i,z) / CTHO(z);
1478   CMINO(i,z)     = CO(i,z) + gamma_LES(i,z) * CTHO(z) / {PCO(i,z) * frisch(z)};
1479   
1480  *$Ontext
1481  * ==============================================================================
1482  * [ADDITION] Backup setup of initial values for tracking parameter changes
1483  * ==============================================================================
1484  SET eval_sig "Evaluation items for sigmas" / Initial "Initial value", Final "Final value", Diff "Difference (Change)" /;
1485  SET sig_type "Types of Industry Elasticities" /
1486      s_coalgas "sigma_ENER_coalgas",
1487      s_oilprod "sigma_ENER_oilprod",
1488      s_nelec   "sigma_ENER_nelec",
1489      s_elec    "sigma_ENER_elec",
1490      s_kle     "sigma_KLE"
1491  /;
1492   
1493  PARAMETER Init_sigma_M1(ene,z) "Backup for initial sigma_M1";
1494  PARAMETER Init_sigma_M2(ene,z) "Backup for initial sigma_M2";
1495  PARAMETER Init_sigma_IND(j,z,sig_type) "Backup for initial industry nest sigmas";
1496   
1497  * Store the current (initial) parameter values before entering the loop
1498  Init_sigma_M1(ene,z) = sigma_M1(ene,z);
1499  Init_sigma_M2(ene,z) = sigma_M2(ene,z);
1500  Init_sigma_IND(j,z,'s_coalgas') = sigma_ENER_coalgas(j,z);
1501  Init_sigma_IND(j,z,'s_oilprod') = sigma_ENER_oilprod(j,z);
1502  Init_sigma_IND(j,z,'s_nelec')   = sigma_ENER_nelec(j,z);
1503  Init_sigma_IND(j,z,'s_elec')    = sigma_ENER_elec(j,z);
1504  Init_sigma_IND(j,z,'s_kle')     = sigma_KLE(j,z);
1505   
1506  * ==============================================================================
1507  * Calculation of Economy-Wide Ex-ante Own-Price Elasticities for Energy
1508  * (Industries + Households + Government + Investment + Exports)
1509  * ==============================================================================
1510   
1511  PARAMETERS
1512  * 1. Industry Nest Shares
1513      S_E_KLE(j,z), S_NE_E(j,z), S_Elec_E(j,z)
1514      S_CG_NE(j,z), S_OP_NE(j,z)
1515      S_Coal_CG(j,z), S_Gas_CG(j,z), S_Oil_OP(j,z), S_Petrol_OP(j,z)
1516   
1517  * 2. Armington & Demand Shares
1518      S_DOM(i,z)           "Share of Domestic product in composite demand"
1519      W_IND(i,j,z)         "Share of Industry j in Total Composite Demand QO"
1520      W_HH(i,z)            "Share of Household in Total Composite Demand QO"
1521      W_INV(i,z)           "Share of Investment in Total Composite Demand QO"
1522      W_GOV(i,z)           "Share of Government in Total Composite Demand QO"
1523      W_DDO(i,z)           "Share of Domestic Sales in Total Output"
1524      W_EXTO(i,z)          "Share of Export Sales in Total Output"
1525      Val_Total(i,z)       "Total Value of Domestic and Export Sales"
1526   
1527  * 3. Composite Price Elasticities by Agent (Imported + Domestic)
1528      Elas_Comp_IND(ene,j,z) "Composite elasticity for Industry"
1529      Elas_Comp_HH(ene,z)    "Composite elasticity for Household (LES)"
1530      Elas_Comp_INV(ene,z)   "Composite elasticity for Investment (Cobb-Douglas = -1)"
1531      Elas_Comp_GOV(ene,z)   "Composite elasticity for Government (Cobb-Douglas = -1)"
1532   
1533  * 4. Domestic Price Elasticities by Agent
1534      Elas_Dom_IND(ene,j,z)  "Domestic elasticity for Industry"
1535      Elas_Dom_HH(ene,z)     "Domestic elasticity for Household"
1536      Elas_Dom_INV(ene,z)    "Domestic elasticity for Investment"
1537      Elas_Dom_GOV(ene,z)    "Domestic elasticity for Government"
1538      Elas_EXP(ene,z)        "Export elasticity (based on importer's sigma_M2)"
1539   
1540  * 5. Economy-Wide Price Elasticities
1541      Elas_Total_DDO(ene,z)  "Weighted elasticity of Total Domestic Demand (DDO)"
1542      Elas_Total_ECON(ene,z) "Economy-wide Ex-ante Price Elasticity of Energy Commodity"
1543  ;
1544   
1545  * ------------------------------------------------------------------------------
1546  * Step 1. Calculate Shares
1547  * ------------------------------------------------------------------------------
1548  * Industry nest shares
1549  S_E_KLE(j2,z)$(PKLEO(j2,z)*KLEO(j2,z)) = (PCEO(j2,z)*CEO(j2,z)) / (PKLEO(j2,z)*KLEO(j2,z));
1550  S_NE_E(j2,z)$(PCEO(j2,z)*CEO(j2,z))    = (PCEnelecO(j2,z)*DEnelecO(j2,z)) / (PCEO(j2,z)*CEO(j2,z));
1551  S_Elec_E(j2,z)$(PCEO(j2,z)*CEO(j2,z))  = (PCEelecO(j2,z)*DEelecO(j2,z)) / (PCEO(j2,z)*CEO(j2,z));
1552  S_CG_NE(j2,z)$(PCEnelecO(j2,z)*DEnelecO(j2,z)) = (PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)) / (PCEnelecO(j2,z)*DEnelecO(j2,z));
1553  S_OP_NE(j2,z)$(PCEnelecO(j2,z)*DEnelecO(j2,z)) = (PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)) / (PCEnelecO(j2,z)*DEnelecO(j2,z));
1554  S_Coal_CG(j2,z)$(PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)) = (PCO('02_COAL',z)*DEO('02_COAL',j2,z)) / (PCEcoalgasO(j2,z)*DEcoalgasO(j2,z));
1555  S_Gas_CG(j2,z)$(PCEcoalgasO(j2,z)*DEcoalgasO(j2,z))  = (PCO('04_GAS',z)*DEO('04_GAS',j2,z)) / (PCEcoalgasO(j2,z)*DEcoalgasO(j2,z));
1556  S_Oil_OP(j2,z)$(PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)) = (PCO('03_OIL',z)*DEO('03_OIL',j2,z)) / (PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z));
1557  S_Petrol_OP(j2,z)$(PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)) = (PCO('10_PETROLCOAL',z)*DEO('10_PETROLCOAL',j2,z)) / (PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z));
1558   
1559  * Armington domestic shares (DDO relative to QO)
1560  S_DOM(ene,z)$(PCO(ene,z)*QO(ene,z)) = (PDO(ene,z)*DDO(ene,z)) / (PCO(ene,z)*QO(ene,z));
1561   
1562  * Consumption share of each agent in total domestic composite (QO)
1563  W_IND(ene,j,z)$QO(ene,z) = DEO(ene,j,z) / QO(ene,z);
1564  W_HH(ene,z)$QO(ene,z)    = CO(ene,z) / QO(ene,z);
1565  W_INV(ene,z)$QO(ene,z)   = INVO(ene,z) / QO(ene,z);
1566  W_GOV(ene,z)$QO(ene,z)   = CGO(ene,z) / QO(ene,z);
1567   
1568  * Share of domestic sales (DDO) and exports (EXTO) in total national output
1569  Val_Total(ene,z) = PDO(ene,z)*DDO(ene,z) + PETO(ene,z)*EXTO(ene,z);
1570  W_DDO(ene,z)$Val_Total(ene,z)  = (PDO(ene,z)*DDO(ene,z)) / Val_Total(ene,z);
1571  W_EXTO(ene,z)$Val_Total(ene,z) = (PETO(ene,z)*EXTO(ene,z)) / Val_Total(ene,z);
1572   
1573  * ------------------------------------------------------------------------------
1574  * Step 2. Calculate Composite Price Elasticities by Agent
1575  * ------------------------------------------------------------------------------
1576  * 1. Industry (Only KLE industries have elasticity, Non-KLE is Leontief so 0)
1577  Elas_Comp_IND('02_COAL',j2,z)$DEO('02_COAL',j2,z) =
1578      - (1 - S_Coal_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Coal_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1579      - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1580   
1581  Elas_Comp_IND('04_GAS',j2,z)$DEO('04_GAS',j2,z) =
1582      - (1 - S_Gas_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Gas_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1583      - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1584   
1585  Elas_Comp_IND('03_OIL',j2,z)$DEO('03_OIL',j2,z) =
1586      - (1 - S_Oil_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Oil_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1587      - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1588   
1589  Elas_Comp_IND('10_PETROLCOAL',j2,z)$DEO('10_PETROLCOAL',j2,z) =
1590      - (1 - S_Petrol_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Petrol_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1591      - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1592   
1593  Elas_Comp_IND('18_ELEC',j2,z)$DEO('18_ELEC',j2,z) =
1594      - (1 - S_Elec_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Elec_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1595   
1596  Elas_Comp_IND(ene,j3,z)$DEO(ene,j3,z) = 0;
1597   
1598  * 2. Household (LES Function)
1599  Elas_Comp_HH(ene,z)$CO(ene,z) = CMINO(ene,z) / CO(ene,z) * (1 - gamma_LES(ene,z)) - 1;
1600   
1601  * 3. Investment & Government (Cobb-Douglas Expenditure)
1602  Elas_Comp_INV(ene,z)$INVO(ene,z) = -1.0;
1603  Elas_Comp_GOV(ene,z)$CGO(ene,z)  = -1.0;
1604   
1605  * ------------------------------------------------------------------------------
1606  * Step 3. Derive Domestic Energy Price Elasticities by Agent (incorporating Armington effect)
1607  * ------------------------------------------------------------------------------
1608  Elas_Dom_IND(ene,j,z)$DEO(ene,j,z) = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_IND(ene,j,z);
1609  Elas_Dom_HH(ene,z)$CO(ene,z)       = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_HH(ene,z);
1610  Elas_Dom_INV(ene,z)$INVO(ene,z)    = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_INV(ene,z);
1611  Elas_Dom_GOV(ene,z)$CGO(ene,z)     = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_GOV(ene,z);
1612   
1613  * Exports (Weighted average of trading partners' import substitution elasticity sigma_M2)
1614  Elas_EXP(ene,z)$EXTO(ene,z) = SUM(zj$EXO(ene,z,zj), (EXO(ene,z,zj)/EXTO(ene,z)) * (-sigma_M2(ene,zj)));
1615   
1616  * ------------------------------------------------------------------------------
1617  * Step 4. Derive Economy-Wide Energy Price Elasticity (Aggregation)
1618  * ------------------------------------------------------------------------------
1619  * Domestic demand aggregation (Weighted Average of Domestic Agents)
1620  Elas_Total_DDO(ene,z) =
1621      SUM(j, W_IND(ene,j,z) * Elas_Dom_IND(ene,j,z))
1622      + W_HH(ene,z)  * Elas_Dom_HH(ene,z)
1623      + W_INV(ene,z) * Elas_Dom_INV(ene,z)
1624      + W_GOV(ene,z) * Elas_Dom_GOV(ene,z);
1625   
1626  * Domestic + Export aggregation (Final Economy-Wide Elasticity)
1627  Elas_Total_ECON(ene,z) =
1628      W_DDO(ene,z) * Elas_Total_DDO(ene,z) + W_EXTO(ene,z) * Elas_EXP(ene,z);
1629   
1630  DISPLAY Elas_Total_ECON, Elas_Total_DDO, Elas_Dom_HH, Elas_EXP;
1631   
1632  * ==============================================================================
1633  * Set and Parameter Declaration for Comparison Report
1634  * ==============================================================================
1635  SET eval "Comparison Items" / Initial "Initial Value", Final "Final Value", Target "Target Value" /;
1636  PARAMETER Report_Elas(ene,z,eval) "Elasticity Comparison Report (Based on DDO)";
1637  PARAMETER Initial_Elas_ECON(ene,z) "Backup of initial elasticity";
1638   
1639  * Backup initially calculated DDO elasticity before entering the loop
1640  Initial_Elas_ECON(ene,z) = Elas_Total_ECON(ene,z);
1641   
1642  * ==============================================================================
1643  * Step 0. Set Target Elasticities and Iterative Algorithm Parameters
1644  * ==============================================================================
1645  TABLE Target_Elas(ene,z) "Target economy-wide elasticities by region and energy commodity"
1646                 01_KOR  02_CHN  03_JPN  04_RUS  05_MNG  06_PRK  07_NAM  08_LAM  09_WEU  10_EEU  11_FSU  12_MEA  13_AFR  14_CPA  15_SAS  16_PAS  17_PAO
1647  02_COAL         -0.88   -0.46   -0.74   -0.30   -0.58   -0.30   -0.97   -0.50   -1.03   -0.85   -0.67   -0.76   -0.82   -0.46   -0.71   -1.12   -0.80
1648  03_OIL          -0.52   -0.34   -0.54   -0.15   -0.66   -0.15   -0.92   -0.58   -0.74   -0.45   -0.15   -0.39   -0.95   -0.34   -0.98   -0.52   -0.99
1649  04_GAS          -0.74   -1.16   -0.52   -0.30   -0.67   -0.15   -0.73   -0.69   -0.85   -0.71   -0.57   -0.62   -0.69   -1.16   -0.18   -0.15   -1.25
1650  10_PETROLCOAL   -0.52   -0.34   -0.54   -0.15   -0.66   -0.15   -0.92   -0.58   -0.74   -0.45   -0.15   -0.39   -0.95   -0.34   -0.98   -0.52   -0.99
1651  18_ELEC         -0.48   -0.42   -0.45   -0.21   -0.35   -0.21   -0.49   -0.47   -0.30   -0.26   -0.21   -0.37   -0.57   -0.42   -0.29   -0.30   -0.29
1652  ;
1653   
1654  * Set targets based on DDO
1655  Parameter Target_ECON(ene,z);
1656  Target_ECON('02_COAL',z) = Target_Elas('02_COAL',z);
1657  Target_ECON('03_OIL',z) = Target_Elas('03_OIL',z);
1658  Target_ECON('04_GAS',z) = Target_Elas('04_GAS',z);
1659  Target_ECON('10_PETROLCOAL',z) = Target_Elas('10_PETROLCOAL',z);
1660  Target_ECON('18_ELEC',z) = Target_Elas('18_ELEC',z);
1661   
1662  SET iter "Maximum number of iterations" / 1*1000 /;
1663  SCALAR step "Update speed (Damping factor)" / 0.15 /;
1664  PARAMETER Adj_Ratio(ene,z) "Ratio to target";
1665  PARAMETER Ind_Total_Weight(ene,z) "Total industry weight";
1666   
1667  Ind_Total_Weight(ene,z) = SUM(j, W_IND(ene,j,z));
1668   
1669  * ==============================================================================
1670  * Declare temporary parameters before entering the loop (for calculating error weights by industry)
1671  * ==============================================================================
1672  PARAMETER Ind_Err_CG(j,z) "Weighted average error of Coal-Gas nest by industry";
1673  PARAMETER Ind_Err_OP(j,z) "Weighted average error of Oil products nest by industry";
1674  PARAMETER Ind_Err_NE(j,z) "Weighted average error of Non-Elec nest by industry";
1675  PARAMETER Ind_Err_Tot(j,z) "Weighted average error of total energy by industry";
1676   
1677  * ==============================================================================
1678  * Algorithm Start
1679  * ==============================================================================
1680  LOOP(iter,
1681  * --------------------------------------------------------------------------
1682  * 1. Recalculate elasticity based on currently updated sigma values
1683  * --------------------------------------------------------------------------
1684      Elas_Comp_IND('02_COAL',j2,z)$DEO('02_COAL',j2,z) =
1685          - (1 - S_Coal_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Coal_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1686          - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1687   
1688      Elas_Comp_IND('04_GAS',j2,z)$DEO('04_GAS',j2,z) =
1689          - (1 - S_Gas_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Gas_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1690          - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1691   
1692      Elas_Comp_IND('03_OIL',j2,z)$DEO('03_OIL',j2,z) =
1693          - (1 - S_Oil_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Oil_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1694          - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1695   
1696      Elas_Comp_IND('10_PETROLCOAL',j2,z)$DEO('10_PETROLCOAL',j2,z) =
1697          - (1 - S_Petrol_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Petrol_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1698          - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1699   
1700      Elas_Comp_IND('18_ELEC',j2,z)$DEO('18_ELEC',j2,z) =
1701          - (1 - S_Elec_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Elec_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1702   
1703      Elas_Dom_IND(ene,j,z)$DEO(ene,j,z) = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_IND(ene,j,z);
1704      Elas_Dom_HH(ene,z)$CO(ene,z)       = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_HH(ene,z);
1705      Elas_Dom_INV(ene,z)$INVO(ene,z)    = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_INV(ene,z);
1706      Elas_Dom_GOV(ene,z)$CGO(ene,z)     = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_GOV(ene,z);
1707   
1708      Elas_Total_DDO(ene,z) =
1709          SUM(j, W_IND(ene,j,z) * Elas_Dom_IND(ene,j,z))
1710          + W_HH(ene,z)  * Elas_Dom_HH(ene,z)
1711          + W_INV(ene,z) * Elas_Dom_INV(ene,z)
1712          + W_GOV(ene,z) * Elas_Dom_GOV(ene,z);
1713   
1714      Elas_EXP(ene,z)$EXTO(ene,z) = SUM(zj$EXO(ene,z,zj), (EXO(ene,z,zj)/EXTO(ene,z)) * (-sigma_M2(ene,zj)));
1715      Elas_Total_ECON(ene,z) = W_DDO(ene,z) * Elas_Total_DDO(ene,z) + W_EXTO(ene,z) * Elas_EXP(ene,z);
1716   
1717  * --------------------------------------------------------------------------
1718  * 2. Calculate error ratio at the national level (Initialize first, keep 1.0 for fuels without target)
1719  * --------------------------------------------------------------------------
1720      Adj_Ratio(ene,z) = 1.0;
1721      Adj_Ratio(ene,z)$(Elas_Total_ECON(ene,z) ne 0 and Target_ECON(ene,z) ne 0) = Target_ECON(ene,z) / Elas_Total_ECON(ene,z);
1722      Adj_Ratio(ene,z) = max(0.2, min(5.0, Adj_Ratio(ene,z)));
1723   
1724  * --------------------------------------------------------------------------
1725  * 3. Parameter Update (Reflecting high-precision industry-specific nest weights)
1726  * --------------------------------------------------------------------------
1727      sigma_M1(ene,z)$(1 - S_DOM(ene,z) > 0.05) = sigma_M1(ene,z) * (1 + step * (Adj_Ratio(ene,z) - 1));
1728  *    sigma_M2(ene,z) = sigma_M2(ene,z) * (1 + step * (Adj_Ratio(ene,z) - 1));
1729      sigma_M2(ene,z) = sigma_M1(ene,z) * (Init_sigma_M2(ene,z) / Init_sigma_M1(ene,z));
1730   
1731      LOOP(j2,
1732  * A. Derive weighted average error by nest within each industry (j2) (Follow the error of the fuel heavily consumed by the industry)
1733          Ind_Err_CG(j2,z)  = S_Coal_CG(j2,z)*Adj_Ratio('02_COAL',z) + S_Gas_CG(j2,z)*Adj_Ratio('04_GAS',z);
1734          Ind_Err_OP(j2,z)  = S_Oil_OP(j2,z)*Adj_Ratio('03_OIL',z)   + S_Petrol_OP(j2,z)*Adj_Ratio('10_PETROLCOAL',z);
1735          Ind_Err_NE(j2,z)  = S_CG_NE(j2,z)*Ind_Err_CG(j2,z)         + S_OP_NE(j2,z)*Ind_Err_OP(j2,z);
1736          Ind_Err_Tot(j2,z) = S_Elec_E(j2,z)*Adj_Ratio('18_ELEC',z)  + S_NE_E(j2,z)*Ind_Err_NE(j2,z);
1737   
1738  * B. Parameter modification (Cross-application according to mathematical partial derivative structure)
1739  * Lower nests dominate the elasticity of "minority" fuels, so track errors inversely (Cross)
1740          sigma_ENER_coalgas(j2,z) = sigma_ENER_coalgas(j2,z) * (1 + step * ( S_Coal_CG(j2,z)*Adj_Ratio('04_GAS',z) + S_Gas_CG(j2,z)*Adj_Ratio('02_COAL',z) - 1 ));
1741          sigma_ENER_oilprod(j2,z) = sigma_ENER_oilprod(j2,z) * (1 + step * ( S_Oil_OP(j2,z)*Adj_Ratio('10_PETROLCOAL',z) + S_Petrol_OP(j2,z)*Adj_Ratio('03_OIL',z) - 1 ));
1742   
1743  * Upper nests dominate the elasticity of "majority" fuels, so track the weighted average of the nest
1744          sigma_ENER_nelec(j2,z) = sigma_ENER_nelec(j2,z) * (1 + step * (Ind_Err_NE(j2,z) - 1));
1745   
1746  * Cross nest (Cross-application of errors between electricity and non-electricity)
1747          sigma_ENER_elec(j2,z) = sigma_ENER_elec(j2,z) * (1 + step * ( S_NE_E(j2,z)*Adj_Ratio('18_ELEC',z) + S_Elec_E(j2,z)*Ind_Err_NE(j2,z) - 1 ));
1748   
1749  * Top KLE elasticity tracks the integrated energy error of the entire industry
1750          sigma_KLE(j2,z) = sigma_KLE(j2,z) * (1 + (step/2) * (Ind_Err_Tot(j2,z) - 1));
1751      );
1752   
1753  * --------------------------------------------------------------------------
1754  * 4. Logical Constraints for Parameters
1755  * --------------------------------------------------------------------------
1756  *    sigma_M1(ene,z) = max(0.5, min(15.0, sigma_M1(ene,z)));
1757  *    sigma_M2(ene,z) = max(0.5, min(30.0, sigma_M2(ene,z)));
1758   
1759  *    sigma_ENER_coalgas(j,z) = max(0.5, min(3.0, sigma_ENER_coalgas(j,z)));
1760  *    sigma_ENER_oilprod(j,z) = max(0.5, min(3.0, sigma_ENER_oilprod(j,z)));
1761  *    sigma_ENER_nelec(j,z)   = max(0.5, min(3.0, sigma_ENER_nelec(j,z)));
1762  *    sigma_ENER_elec(j,z)    = max(0.5, min(3.0, sigma_ENER_elec(j,z)));
1763  *    sigma_KLE(j,z)          = max(0.5, min(3.0, sigma_KLE(j,z)));
1764   
1765      sigma_M1(ene,z) = max(0.5, min(15.0, sigma_M1(ene,z)));
1766      sigma_M2(ene,z) = max(0.5, min(30.0, sigma_M2(ene,z)));
1767      sigma_ENER_coalgas(j,z) = max(0.5, min(3.0, sigma_ENER_coalgas(j,z)));
1768      sigma_ENER_oilprod(j,z) = max(0.5, min(3.0, sigma_ENER_oilprod(j,z)));
1769      sigma_ENER_nelec(j,z)   = max(0.5, min(3.0, sigma_ENER_nelec(j,z)));
1770      sigma_ENER_elec(j,z)    = max(0.5, min(3.0, sigma_ENER_elec(j,z)));
1771      sigma_KLE(j,z)          = max(0.5, min(3.0, sigma_KLE(j,z)));
1772   
1773  * [2단계] 대체탄력성 1.0 부근(0.9 ~ 1.1) 회피 조건 추가 (Deadzone 설정)
1774  * 값이 0.9 초과 1.0 이하인 경우 0.9로 고정
1775  * 값이 1.0 초과 1.1 미만인 경우 1.1로 고정
1776   
1777      sigma_M1(ene,z)$(sigma_M1(ene,z) > 0.9 and sigma_M1(ene,z) <= 1.0) = 0.9;
1778      sigma_M1(ene,z)$(sigma_M1(ene,z) > 1.0 and sigma_M1(ene,z) <  1.1) = 1.1;
1779   
1780      sigma_M2(ene,z)$(sigma_M2(ene,z) > 0.9 and sigma_M2(ene,z) <= 1.0) = 0.9;
1781      sigma_M2(ene,z)$(sigma_M2(ene,z) > 1.0 and sigma_M2(ene,z) <  1.1) = 1.1;
1782   
1783      sigma_ENER_coalgas(j,z)$(sigma_ENER_coalgas(j,z) > 0.9 and sigma_ENER_coalgas(j,z) <= 1.0) = 0.9;
1784      sigma_ENER_coalgas(j,z)$(sigma_ENER_coalgas(j,z) > 1.0 and sigma_ENER_coalgas(j,z) <  1.1) = 1.1;
1785   
1786      sigma_ENER_oilprod(j,z)$(sigma_ENER_oilprod(j,z) > 0.9 and sigma_ENER_oilprod(j,z) <= 1.0) = 0.9;
1787      sigma_ENER_oilprod(j,z)$(sigma_ENER_oilprod(j,z) > 1.0 and sigma_ENER_oilprod(j,z) <  1.1) = 1.1;
1788   
1789      sigma_ENER_nelec(j,z)$(sigma_ENER_nelec(j,z) > 0.9 and sigma_ENER_nelec(j,z) <= 1.0) = 0.9;
1790      sigma_ENER_nelec(j,z)$(sigma_ENER_nelec(j,z) > 1.0 and sigma_ENER_nelec(j,z) <  1.1) = 1.1;
1791   
1792      sigma_ENER_elec(j,z)$(sigma_ENER_elec(j,z) > 0.9 and sigma_ENER_elec(j,z) <= 1.0) = 0.9;
1793      sigma_ENER_elec(j,z)$(sigma_ENER_elec(j,z) > 1.0 and sigma_ENER_elec(j,z) <  1.1) = 1.1;
1794   
1795      sigma_KLE(j,z)$(sigma_KLE(j,z) > 0.9 and sigma_KLE(j,z) <= 1.0) = 0.9;
1796      sigma_KLE(j,z)$(sigma_KLE(j,z) > 1.0 and sigma_KLE(j,z) <  1.1) = 1.1;
1797   
1798  );
1799   
1800  * ==============================================================================
1801  * [ADDITION] Generate consolidated report for elasticity parameter changes
1802  * ==============================================================================
1803  PARAMETER Report_sigma_M1(ene,z,eval_sig) "Report for Armington sigma_M1 changes";
1804  PARAMETER Report_sigma_M2(ene,z,eval_sig) "Report for Armington sigma_M2 changes";
1805  PARAMETER Report_sigma_IND(j,z,sig_type,eval_sig) "Report for Industry nest sigma changes";
1806   
1807  * 1. Generate report for sigma_M1
1808  Report_sigma_M1(ene,z,'Initial') = Init_sigma_M1(ene,z);
1809  Report_sigma_M1(ene,z,'Final')   = sigma_M1(ene,z);
1810  Report_sigma_M1(ene,z,'Diff')    = sigma_M1(ene,z) - Init_sigma_M1(ene,z);
1811   
1812  Report_sigma_M2(ene,z,'Initial') = Init_sigma_M2(ene,z);
1813  Report_sigma_M2(ene,z,'Final')   = sigma_M2(ene,z);
1814  Report_sigma_M2(ene,z,'Diff')    = sigma_M2(ene,z) - Init_sigma_M2(ene,z);
1815   
1816  * 2. Generate consolidated report for industry-specific elasticities
1817  Report_sigma_IND(j,z,'s_coalgas','Initial') = Init_sigma_IND(j,z,'s_coalgas');
1818  Report_sigma_IND(j,z,'s_coalgas','Final')   = sigma_ENER_coalgas(j,z);
1819  Report_sigma_IND(j,z,'s_coalgas','Diff')    = sigma_ENER_coalgas(j,z) - Init_sigma_IND(j,z,'s_coalgas');
1820   
1821  Report_sigma_IND(j,z,'s_oilprod','Initial') = Init_sigma_IND(j,z,'s_oilprod');
1822  Report_sigma_IND(j,z,'s_oilprod','Final')   = sigma_ENER_oilprod(j,z);
1823  Report_sigma_IND(j,z,'s_oilprod','Diff')    = sigma_ENER_oilprod(j,z) - Init_sigma_IND(j,z,'s_oilprod');
1824   
1825  Report_sigma_IND(j,z,'s_nelec','Initial') = Init_sigma_IND(j,z,'s_nelec');
1826  Report_sigma_IND(j,z,'s_nelec','Final')   = sigma_ENER_nelec(j,z);
1827  Report_sigma_IND(j,z,'s_nelec','Diff')    = sigma_ENER_nelec(j,z) - Init_sigma_IND(j,z,'s_nelec');
1828   
1829  Report_sigma_IND(j,z,'s_elec','Initial') = Init_sigma_IND(j,z,'s_elec');
1830  Report_sigma_IND(j,z,'s_elec','Final')   = sigma_ENER_elec(j,z);
1831  Report_sigma_IND(j,z,'s_elec','Diff')    = sigma_ENER_elec(j,z) - Init_sigma_IND(j,z,'s_elec');
1832   
1833  Report_sigma_IND(j,z,'s_kle','Initial') = Init_sigma_IND(j,z,'s_kle');
1834  Report_sigma_IND(j,z,'s_kle','Final')   = sigma_KLE(j,z);
1835  Report_sigma_IND(j,z,'s_kle','Diff')    = sigma_KLE(j,z) - Init_sigma_IND(j,z,'s_kle');
1836   
1837  Report_Elas(ene,z,'Initial') = Initial_Elas_ECON(ene,z);
1838  Report_Elas(ene,z,'Final')   = Elas_Total_ECON(ene,z);
1839  Report_Elas(ene,z,'Target')  = Target_ECON(ene,z);
1840   
1841  * Display results in the .lst file
1842  DISPLAY Report_sigma_M1, Report_sigma_IND;
1843  *$Offtext
1844  *==============================================================================
1845  * Calibration of function parameters
1846  *==============================================================================
1847   io(j,z)$XSTO(j,z)         = CIO(j,z) / XSTO(j,z);
1848   io2(j,z)$XSTO(j,z)        = CEO(j,z) / XSTO(j,z);
1849   v(j,z)$XSTO(j,z)          = VAO(j,z) / XSTO(j,z);
1850   v2(j,z)$XSTO(j,z)         = (CEO(j,z) + VAO(j,z)) / XSTO(j,z);
1851   
1852   aij(nene,j,z)$XSTO(j,z)   = DIO(nene,j,z) / CIO(j,z);
1853   aij2(ene,j,z)$XSTO(j,z)   = DEO(ene,j,z) / CEO(j,z);
1854   aij_t(nene,j,z,time)        = aij(nene,j,z);
1855   aij2_t(ene,j,z,time)        = aij2(ene,j,z);
1856   
1857  *==============================================================================
1858  * Calibration of CET parameters
1859  *==============================================================================
1860   rho_X1(i,z) = (1 + sigma_X1(i,z)) / sigma_X1(i,z);
1861   
1862   beta_EX_X1(i,z)$MRGNO(i,z)
1863      = [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z)) ] /
1864        [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z))
1865        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z))
1866        + eO(z)     * PWMGO(i) * MRGNO(i,z)$MRGNO(i,z)**(1 - rho_X1(i,z)) ];
1867   
1868   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1869      = [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z)) ] /
1870        [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z))
1871        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z)) ];
1872   
1873   beta_D_X1(i,z)$MRGNO(i,z)
1874      = [ PLO(i,z) * DSO_I(i,z)**(1 - rho_X1(i,z)) ] /
1875        [ PETO(i,z) * EXTO(i,z)**(1 - rho_X1(i,z))
1876        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z))
1877        + eO(z)     * PWMGO(i) * MRGNO(i,z)**(1 - rho_X1(i,z)) ];
1878   
1879   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1880      = [ PLO(i,z) * DSO_I(i,z)**(1 - rho_X1(i,z)) ] /
1881        [ PETO(i,z) * EXTO(i,z)**(1 - rho_X1(i,z))
1882        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z)) ];
1883   
1884   B_X1(i,z)
1885      = XSO_I(i,z) /
1886        [ beta_EX_X1(i,z) * EXTO(i,z)**rho_X1(i,z)
1887        + beta_D_X1(i,z)  * DSO_I(i,z)**rho_X1(i,z)
1888        + (1 - beta_EX_X1(i,z) - beta_D_X1(i,z)) * MRGNO(i,z)**rho_X1(i,z)
1889        ]**(1 / rho_X1(i,z));
1890   
1891  *==============================================================================
1892  * CET between exports to different trading partners
1893  *==============================================================================
1894   rho_X2(i,z) = (1 + sigma_X2(i,z)) / sigma_X2(i,z);
1895   
1896   beta_X2(i,z,zj)$EXO(i,z,zj)
1897      = [ PEO(i,z,zj) * EXO(i,z,zj)**(1 - rho_X2(i,z)) ] /
1898        SUM[zjj$EXO(i,z,zjj), PEO(i,z,zjj) * EXO(i,z,zjj)**(1 - rho_X2(i,z)) ];
1899   
1900   B_X2(i,z)
1901      = EXTO(i,z) /
1902        { SUM[zj, beta_X2(i,z,zj) * EXO(i,z,zj)**rho_X2(i,z)]**(1 / rho_X2(i,z)) };
1903   
1904  *==============================================================================
1905  * Calibration of CES parameters
1906  *==============================================================================
1907   rho_X3(i,z) = (1 - sigma_X3(i,z)) / sigma_X3(i,z);
1908   
1909   beta_X3(j,i,z)$XSO(j,i,z)
1910      = [ PO2(j,i,z) * XSO(j,i,z)**(1 + rho_X3(i,z)) ] /
1911        SUM[jj$XSO(jj,i,z), PO2(jj,i,z) * XSO(jj,i,z)**(1 + rho_X3(i,z)) ];
1912   
1913   B_X3(i,z)
1914      = XSO_I(i,z) /
1915        SUM[jj$XSO(jj,i,z), beta_X3(jj,i,z) * XSO(jj,i,z)**(-rho_X3(i,z))]**(-1 / rho_X3(i,z));
1916   
1917  * Electricity
1918   QPOWERO(z) = SUM(POWER, XSO(power,'18_ELEC',z));
1919   rho_X4(z)  = (1 - sigma_X4(z)) / sigma_X4(z);
1920   
1921   beta_X4(power,z)
1922      = [ PO2(power,'18_ELEC',z) * XSO(power,'18_ELEC',z)**(1 + rho_X4(z)) ] /
1923        SUM[powerr$XSO(powerr,'18_ELEC',z), PO2(powerr,'18_ELEC',z) * XSO(powerr,'18_ELEC',z)**(1 + rho_X4(z)) ];
1924   
1925   B_X4(z)
1926      = QPOWERO(z) /
1927        SUM[powerr$XSO(powerr,'18_ELEC',z), beta_X4(powerr,z) * XSO(powerr,'18_ELEC',z)**(-rho_X4(z))]**(-1 / rho_X4(z));
1928   
1929   TnDShare(z) = XSO('18_TnD','18_ELEC',z) / XSO_I('18_ELEC',z);
1930   
1931  *Backstop
1932  LOOP(MAP_BS(bs, conv, I_BS),
1933   
1934      QBSO(bs, Z_GRN) = XSO(conv, I_BS, Z_GRN) + XSO(bs, I_BS, Z_GRN);
1935   
1936      rho_BS(bs, Z_GRN) = (1 - sigma_BS(bs, Z_GRN)) / sigma_BS(bs, Z_GRN);
1937   
1938      beta_BS(conv, I_BS, Z_GRN)
1939          = [ PO2(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] /
1940            ( [ PO2(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] +
1941              [ PO2(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] );
1942   
1943      beta_BS(bs, I_BS, Z_GRN)
1944          = [ PO2(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] /
1945            ( [ PO2(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] +
1946              [ PO2(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] );
1947   
1948      B_BS(bs, Z_GRN)
1949          = QBSO(bs, Z_GRN) /
1950            ( beta_BS(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(-rho_BS(bs, Z_GRN)) +
1951              beta_BS(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(-rho_BS(bs, Z_GRN)) )**(-1 / rho_BS(bs, Z_GRN));
1952   
1953      beta_BS_t(conv, I_BS, Z_GRN, time) = beta_BS(conv, I_BS, Z_GRN);
1954      beta_BS_t(bs, I_BS, Z_GRN, time)   = beta_BS(bs, I_BS, Z_GRN);
1955  );
1956   
1957  *==============================================================================
1958  * Composite good
1959  *==============================================================================
1960   rho_M1(i,z) = (1 - sigma_M1(i,z)) / sigma_M1(i,z);
1961   
1962   beta_M1(i,z)
1963      = PMTO(i,z) * IMTO(i,z)**(rho_M1(i,z) + 1) /
1964        { PDO(i,z)  * DDO(i,z)**(rho_M1(i,z) + 1)
1965        + PMTO(i,z) * IMTO(i,z)**(rho_M1(i,z) + 1) };
1966   
1967   B_M1(i,z)
1968      = QO(i,z) /
1969        { beta_M1(i,z) * IMTO(i,z)**(-rho_M1(i,z))
1970        + (1 - beta_M1(i,z)) * DDO(i,z)**(-rho_M1(i,z)) }**(-1 / rho_M1(i,z));
1971   
1972  *==============================================================================
1973  * CES between imports from different trading partners
1974  *==============================================================================
1975   rho_M2(i,z) = (1 - sigma_M2(i,z)) / sigma_M2(i,z);
1976   
1977   beta_M2(i,zj,z)$IMO(i,zj,z)
1978      = [ PMO(i,zj,z) * IMO(i,zj,z)**(rho_M2(i,z) + 1) ] /
1979        SUM[zjj$IMO(i,zjj,z), PMO(i,zjj,z) * IMO(i,zjj,z)**(rho_M2(i,z) + 1) ];
1980   
1981   B_M2(i,z)
1982      = IMTO(i,z) /
1983        { SUM[zj$IMO(i,zj,z), beta_M2(i,zj,z) * IMO(i,zj,z)**(-rho_M2(i,z))]**(-1 / rho_M2(i,z)) };
1984   
1985  *==============================================================================
1986  * Composite capital
1987  *==============================================================================
1988   rho_KD(j,z) = (1 - sigma_KD(j,z)) / sigma_KD(j,z);
1989   
1990   beta_KD(k,j,z)$KDO(k,j,z)
1991      = [ RTIO(k,j,z) * KDO(k,j,z)**(1 + rho_KD(j,z)) ] /
1992        SUM[kj$KDO(kj,j,z), RTIO(kj,j,z) * KDO(kj,j,z)**(1 + rho_KD(j,z)) ];
1993   
1994   B_KD(j,z)$KDCO(j,z)
1995      = KDCO(j,z) /
1996        { SUM[k$KDO(k,j,z), beta_KD(k,j,z) * KDO(k,j,z)**(-rho_KD(j,z))]**(-1 / rho_KD(j,z)) };
1997   
1998  *===============================================================================
1999  * Composite E
2000  *===============================================================================
2001  * Level 5_1 (Coal/Gas)
2002   rho_ENER_coalgas(j2,z) = (1 - sigma_ENER_coalgas(j2,z)) / sigma_ENER_coalgas(j2,z);
2003   
2004   beta_ENER_coalgas(ene5,j2,z)
2005      = [ PO4(ene5,j2,z) * DEO(ene5,j2,z)**(1 + rho_ENER_coalgas(j2,z)) ] /
2006        SUM[enee5, PO4(enee5,j2,z) * DEO(enee5,j2,z)**(1 + rho_ENER_coalgas(j2,z)) ];
2007   
2008   B_ENER_coalgas(j2,z)
2009      = DEcoalgasO(j2,z) /
2010        { SUM[ene5, beta_ENER_coalgas(ene5,j2,z) * DEO(ene5,j2,z)**(-rho_ENER_coalgas(j2,z))] }**(-1 / rho_ENER_coalgas(j2,z));
2011   
2012  * Level 5_2 (Oil/Petrol)
2013   rho_ENER_oilprod(j2,z) = (1 - sigma_ENER_oilprod(j2,z)) / sigma_ENER_oilprod(j2,z);
2014   
2015   beta_ENER_oilprod(ene6,j2,z)
2016      = [ PO4(ene6,j2,z) * DEO(ene6,j2,z)**(1 + rho_ENER_oilprod(j2,z)) ] /
2017        SUM[enee6, PO4(enee6,j2,z) * DEO(enee6,j2,z)**(1 + rho_ENER_oilprod(j2,z)) ];
2018   
2019   B_ENER_oilprod(j2,z)
2020      = DEoilpetrolO(j2,z) /
2021        { SUM[ene6, beta_ENER_oilprod(ene6,j2,z) * DEO(ene6,j2,z)**(-rho_ENER_oilprod(j2,z))] }**(-1 / rho_ENER_oilprod(j2,z));
2022   
2023  * Level 4 (Coal-Gas / Oil-Petrol)
2024   rho_ENER_nelec(j2,z) = (1 - sigma_ENER_nelec(j2,z)) / sigma_ENER_nelec(j2,z);
2025   
2026   beta_ENER_nelec(j2,z)
2027      = PCEcoalgasO(j2,z) * DEcoalgasO(j2,z)**(rho_ENER_nelec(j2,z) + 1) /
2028        { PCEcoalgasO(j2,z) * DEcoalgasO(j2,z)**(rho_ENER_nelec(j2,z) + 1)
2029        + PCEoilpetrolO(j2,z) * DEoilpetrolO(j2,z)**(rho_ENER_nelec(j2,z) + 1) };
2030   
2031   B_ENER_nelec(j2,z)
2032      = DEnelecO(j2,z) /
2033        { [ beta_ENER_nelec(j2,z) * DEcoalgasO(j2,z)**(-rho_ENER_nelec(j2,z))
2034          + (1 - beta_ENER_nelec(j2,z)) * DEoilpetrolO(j2,z)**(-rho_ENER_nelec(j2,z)) ] }**(-1 / rho_ENER_nelec(j2,z));
2035   
2036  * Level 2 (Elec / Non-Elec)
2037   rho_ENER_elec(j2,z) = (1 - sigma_ENER_elec(j2,z)) / sigma_ENER_elec(j2,z);
2038   
2039   beta_ENER_elec(j2,z)
2040      = PCEelecO(j2,z) * DEelecO(j2,z)**(rho_ENER_elec(j2,z) + 1) /
2041        { PCEelecO(j2,z) * DEelecO(j2,z)**(rho_ENER_elec(j2,z) + 1)
2042        + PCEnelecO(j2,z) * DEnelecO(j2,z)**(rho_ENER_elec(j2,z) + 1) };
2043   
2044   B_ENER_elec(j2,z)
2045      = CEO(j2,z) /
2046        { [ beta_ENER_elec(j2,z) * DEelecO(j2,z)**(-rho_ENER_elec(j2,z))
2047          + (1 - beta_ENER_elec(j2,z)) * DEnelecO(j2,z)**(-rho_ENER_elec(j2,z)) ] }**(-1 / rho_ENER_elec(j2,z));
2048   
2049  *==============================================================================
2050  * Value added
2051  *==============================================================================
2052   rho_VA(j,z) = (1 - sigma_VA(j,z)) / sigma_VA(j,z);
2053   
2054   beta_VA(j,z)$KDCO(j,z)
2055      = WCO(j,z) * LDCO(j,z)**(rho_VA(j,z) + 1) /
2056        { WCO(j,z) * LDCO(j,z)**(rho_VA(j,z) + 1)
2057        + RCO(j,z) * KDCO(j,z)**(rho_VA(j,z) + 1) };
2058   
2059   B_VA(j,z)$KDCO(j,z)
2060      = VAO(j,z) /
2061        { [ beta_VA(j,z) * LDCO(j,z)**(-rho_VA(j,z))
2062          + (1 - beta_VA(j,z)) * KDCO(j,z)**(-rho_VA(j,z)) ] }**(-1 / rho_VA(j,z));
2063   
2064   B_VA_t(j,z,time) = B_VA(j,z);
2065   
2066  *==============================================================================
2067  * Calibration of VAT nest for ALL Backstop Sectors (BS)
2068  *==============================================================================
2069  rho_VAT(BS, Z_GRN)   = (1 - sigma_VAT(BS, Z_GRN)) / sigma_VAT(BS, Z_GRN);
2070   
2071   beta_VAT(BS, Z_GRN)
2072      = ( PVAO(BS, Z_GRN) * VAO(BS, Z_GRN)**(1 + rho_VAT(BS, Z_GRN)) ) /
2073        ( PVAO(BS, Z_GRN) * VAO(BS, Z_GRN)**(1 + rho_VAT(BS, Z_GRN))
2074        + PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN)**(1 + rho_VAT(BS, Z_GRN)) );
2075   
2076   B_VAT(BS, Z_GRN)
2077      = VATO(BS, Z_GRN) /
2078        ( beta_VAT(BS, Z_GRN) * VAO(BS, Z_GRN)**(-rho_VAT(BS, Z_GRN))
2079        + (1 - beta_VAT(BS, Z_GRN)) * TSFO(BS, Z_GRN)**(-rho_VAT(BS, Z_GRN)) )**(-1 / rho_VAT(BS, Z_GRN));
2080   
2081   v_vat(BS, Z_GRN)     = VATO(BS, Z_GRN) / XSTO(BS, Z_GRN);
2082   
2083   B_VAT_t(BS, Z_GRN, time) = B_VAT(BS, Z_GRN);
2084   
2085  *==============================================================================
2086  * Composite KLE
2087  *==============================================================================
2088   rho_KLE(j,z) = (1 - sigma_KLE(j,z)) / sigma_KLE(j,z);
2089   
2090   beta_KLE(j,z)$KLEO(j,z)
2091      = PVAO(j,z) * VAO(j,z)**(rho_KLE(j,z) + 1) /
2092        { PVAO(j,z) * VAO(j,z)**(rho_KLE(j,z) + 1)
2093        + PCEO(j,z) * CEO(j,z)**(rho_KLE(j,z) + 1) };
2094   
2095   beta_KLE2(j,z)$KLEO(j,z)
2096      = 1 - beta_KLE(j,z);
2097   
2098   B_KLE(j,z)$KLEO(j,z)
2099      = KLEO(j,z) /
2100        { [ beta_KLE(j,z) * VAO(j,z)**(-rho_KLE(j,z))
2101          + beta_KLE2(j,z) * CEO(j,z)**(-rho_KLE(j,z)) ] }**(-1 / rho_KLE(j,z));
2102   
2103  *==============================================================================
2104  * Calibration of gross domestic products
2105  *==============================================================================
2106  GDP_BPO(z)     = SUM[j, PVAO(j,z) * VAO(j,z)] + SUM[BS, PTSFO(BS,z) * TSFO(BS,z)] + TIPTO(z);
2107   GDP_MPO(z)     = GDP_BPO(z) + TPRCTSO(z);
2108   
2109  GDP_IBO(z)
2110      = SUM[(j), WO(z) * LDO(j,z)]
2111      + SUM[(k,j), RO(k,j,z) * KDO(k,j,z)]
2112      + SUM[BS, PTSFO(BS,z) * TSFO(BS,z)]
2113      + TPRODNO(z)
2114      + TPRCTSO(z);
2115   
2116   GDP_FDO(z)
2117      = SUM[i, PCO(i,z) * (CO(i,z) + CGO(i,z) + INVO(i,z))]
2118      + eO(z) * SUM[(i,zj), PWXO(i,z,zj) * EXO(i,z,zj)]
2119      + eO(z) * SUM[i, PWMGO(i) * MRGNO(i,z)]
2120      - eO(z) * SUM[(i,zj), IMO(i,zj,z) * (PWMO(i,zj,z) + SUM{ij, PWMGO(ij) * tmrg(ij,i,zj,z)})];
2121   
2122   GDP_BP_WO      = SUM[z, GDP_BPO(z) / eO(z)];
2123   
2124  *==============================================================================
2125  * Calibration of real (volume) variables computed from price indices
2126  *==============================================================================
2127   CABXO(z)       = CABO(z) / [PIXGDP_WO * eO(z)];
2128   
2129   CABXsur(z,T1)  = CABXO(z)$[CABXO(z) gt 0];
2130   CABXdef(z,T1)  = CABXO(z)$[CABXO(z) lt 0];
2131   
2132   CABXsur(z,time)$[ord(time) gt 1] = CABXO(z) * (1 + g_GDP(z,time))$[CABXO(z) gt 0];
2133   CABXdef(z,time)$[ord(time) gt 1] = CABXO(z) * (1 + g_GDP(z,time))$[CABXO(z) lt 0];
2134   
2135   Bal(time)      = SUM(zj, CABXsur(zj,time)) + SUM(zj, CABXdef(zj,time));
2136   
2137   mu(time)       = SUM(zj, CABXsur(zj,time)) /
2138                    { SUM(zj, CABXsur(zj,time)) + SUM(zj, ABS(CABXdef(zj,time))) };
2139   
2140   CABXsur(z,time) = CABXsur(z,time) * { 1 - mu(time) * Bal(time) / SUM(zj, CABXsur(zj,time)) };
2141   CABXdef(z,time) = CABXdef(z,time) * { 1 - [1 - mu(time)] * Bal(time) / SUM(zj, CABXdef(zj,time)) };
2142   CABix(z,time)   = [ CABXsur(z,time) + CABXdef(z,time) ] / CABXO(z);
2143   
2144   CTH_REALO(z)   = CTHO(z) / PIXCONO(z);
2145   G_REALO(z)     = GO(z) / PIXGVTO(z);
2146   GDP_BP_REALO(z)= GDP_BPO(z) / PIXGDPO(z);
2147   GDP_BP_W_REALO = GDP_BP_WO / PIXGDP_WO;
2148   GDP_MP_REALO(z)= GDP_MPO(z) / PIXCONO(z);
2149   IT_REALO(z)    = ITO(z) / PIXINVO(z);
2150   
2151   sh1O(z)        = [SHO(z) + SGO(z)] / GDP_IBO(z);
2152   sh0O(z)        = SHO(z) - sh1O(z) * YDHO(z);
2153   
2154   sh0O(z)        = sh0O(z) / PIXCONO(z)**eta;
2155   ttdh0O(z)      = ttdh0O(z) / PIXCONO(z)**eta;
2156   
2157   OBJO           = 1;
2158   growthz(z)    = 0.02;
2159   
