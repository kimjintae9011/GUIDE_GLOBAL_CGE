3793  * NEP_CO(p_oillz) = sum((f_household), household_fne_oilproduct(f_household, p_oilproduct, z));
3794   
3795  *Ratio
3796  Loop(j,
3797      NOilR_DIO(p_oil,j,z)$(NOil_DIO(p_oil,j,z) gt 0)
3798           = NOil_DIO(p_oil,j,z)/sum(p_oil2, NOil_DIO(p_oil2,j,z));
3799       );
3800   
3801  *Oilproducts non-energy
3802   NOilp_DIO(p_oilproduct,'05_MINING',z) = sum(f_nemining, WEB(f_nemining, p_oilproduct, z));
3803   NOilp_DIO(p_oilproduct,'06_FOODPRO',z) = sum(f_nefoodpro, WEB(f_nefoodpro, p_oilproduct, z));
3804   NOilp_DIO(p_oilproduct,'07_TEXTILES',z) = sum(f_netextiles, WEB(f_netextiles, p_oilproduct, z));
3805   NOilp_DIO(p_oilproduct,'08_WOODPRO',z) = sum(f_newoodpro, WEB(f_newoodpro, p_oilproduct, z));
3806   NOilp_DIO(p_oilproduct,'09_PAPERPRO',z) = sum(f_nepaperpro, WEB(f_nepaperpro, p_oilproduct, z));
3807   NOilp_DIO(p_oilproduct,'11_CHEMICAL',z) = sum(f_nechemical, WEB(f_nechemical, p_oilproduct, z));
3808   NOilp_DIO(p_oilproduct,'12_NONMET',z) = sum(f_nenonmet, WEB(f_nenonmet, p_oilproduct, z));
3809   NOilp_DIO(p_oilproduct,'13_IRONSTL',z) = sum(f_neironstl, WEB(f_neironstl, p_oilproduct, z));
3810   NOilp_DIO(p_oilproduct,'14_NONFERR',z) = sum(f_nenonferr, WEB(f_nenonferr, p_oilproduct, z));
3811   NOilp_DIO(p_oilproduct,'15_MACHINE',z) = sum(f_nemachine, WEB(f_nemachine, p_oilproduct, z));
3812   NOilp_DIO(p_oilproduct,'16_TRANSEQ',z) = sum(f_netranseq, WEB(f_netranseq, p_oilproduct, z));
3813   NOilp_DIO(p_oilproduct,'17_OTHERIND',z) = sum(f_neotherind, WEB(f_neotherind, p_oilproduct, z));
3814   NOilp_DIO(p_oilproduct,'27_CONSTRUC',z) = sum(f_neconstruc, WEB(f_neconstruc, p_oilproduct, z));
3815   NOilp_DIO(p_oilproduct,'28_LTRP',z) = sum(f_netransport, WEB(f_netransport, p_oilproduct, z));
3816  * NEP_DIO(p_oilproduct,'29_WTRP',z) = sum((f_domewater), domewater_fne_oilproduct(f_domewater, p_oilproductproduct, z));
3817  * NEP_DIO(p_oilproduct,'30_ATRP',z) = sum((f_domeair), domeair_fne_oilproduct(f_domeair, p_oilproductproduct, z));
3818   NOilp_DIO(p_oilproduct,'31_SER',z) = sum(f_neother, WEB(f_neother, p_oilproduct, z) );
3819  * NEP_CO(p_oilproductlz) = sum((f_household), household_fne_oilproduct(f_household, p_oilproductproduct, z));
3820   
