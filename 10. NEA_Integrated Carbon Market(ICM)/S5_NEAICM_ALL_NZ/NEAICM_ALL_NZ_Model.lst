4107   CTAXO(z)           Initial Carbon tax $ per ton CO2
4108   TCTAXO(z)          Initial Government Revenue from Carbon tax
4109   NEA_REGIONAL_CTAXO
4110   PERMITO(j,z)       CO2 emissions
4111   PERMIT_TOTALO(z)   Total CO2 emissions (billion ton)
4112  ;
4113   CTAXO(z)           = 0;
4114   TCTAXO(z)          = 0;
4115   NEA_REGIONAL_CTAXO = 0;
4116   PERMITO(j,z)       = SUM(ene, CO2FACTOR(ene,j,z) * DEO(ene,j,z));
4117   PERMIT_TOTALO(z)   = SUM(j, PERMITO(j,z));
4118   
4119  *==============================================================================
4120  * Marginal abatement curves for emissions
4121  *==============================================================================
4122  PARAMETER
4123   alpha_CO2(ene,j,z)             Emissions responsiveness parameter
4124   gamma_CO2(ene,j,z)             Adjustment speed parameter
4125   MINCO2FACTOR(ene,j,z)          Minimum CO2 emission factor
4126   CTAX_CO2(ene,j,z,time)
4127   CO2FACTOR2_Star(ene,j,z,time)
4128  ;
4129   alpha_CO2(ene,j,z)     = 0.15;
4130   gamma_CO2(ene,j,z)     = 1.5;
4131   MINCO2FACTOR(ene,j,z)  = CO2FACTOR(ene,j,z) * 0.01;
4132   
4133  SCALAR
4134   adjustment_factor
4135   trigger_price
4136   SolarWind_TFP_BAU
4137   SolarWind_TFP_NDC
4138   SolarWind_TFP_NZ
4139   residual_ratio
4140  ;
4141   
4142   adjustment_factor = 0.5;
4143   trigger_price     = 1.0;
4144   SolarWind_TFP_BAU = 0.02;
4145   SolarWind_TFP_NDC = 0.02;
4146   SolarWind_TFP_NZ  = 0.04;
4147   residual_ratio  = 0.05;
4148   
4149   TIWO_Share(j,z)   = LDO(j,z) / LSO(z);
4150   TIKO_Share(k,j,z) = KDO(k,j,z) / KSO(k,z);
4151   TIPO_Share(j,z)   = XSTO(j,z) / SUM(jj, XSTO(jj,z));
4152   
4153  *==============================================================================
4154  * Direct Air Capture
4155  *==============================================================================
4156  PARAMETER
4157   DAC_TRIGGER            DAC trigger Price (100$ per tCO2)
4158   DAC_MAX(z)                Maximum DAC yearly
4159   DAC_growth_rate(z,time)
4160   DAC_Max_Pen(z)         Maximum Penetration
4161   DAC_Logistic_Coeff(z)  Logistic Growth Rate
4162   DAC_Inflection(z)      Inflection Lapse
4163   DAC_Start_Year(z)      First Triggered Year
4164   DAC_Tech_Coeff(i)
4165   switchDAC(z,time)      Binary parameter
4166   ;
4167   
4168  SCALAR DAC_Unit_Scale       100MilliontCO2 to tCO2 / 100000000 /;
4169  SCALAR DAC_Elec_Intensity   MWh needed per ton CO2 / 2.5 /;
4170  SCALAR Price_USD_MWh        USD per MWh / 107.14 /;
4171   
4172   DAC_TRIGGER               = 5.0;
4173   DAC_MAX(z)                = sum(j,PERMITO(j,z))*0.3;
4174   DAC_MAX('09_WEU')         = sum(j,PERMITO(j,'09_WEU'))*0.5;
4175   DAC_MAX('03_JPN')         = sum(j,PERMITO(j,'03_JPN'))*0.5;
4176   DAC_growth_rate(z,time)   = 0;
4177   DAC_Max_Pen(z)             = 1.0;
4178   DAC_Logistic_Coeff(z)      = 0.2;
4179   DAC_Inflection(z)            = 15;
4180   DAC_Start_Year(z)           = 0;
4181   DAC_Tech_Coeff('18_ELEC') = (DAC_Unit_Scale * DAC_Elec_Intensity * Price_USD_MWh) / 10**10;
4182   switchDAC(z,time)           = 0;
4183   
4184  *==============================================================================
4185  * Labour Supply
4186  *==============================================================================
4187  PARAMETER
4188   W_lag(z,time)         Wage rate of type l labor in region z
4189   PIXCON_lag(z,time)    Consumer price index in region z
4190   LS_lag(z,time)        Supply of type l labor in region z (T-1)
4191   LST_lag(z,time)       Supply of type l labor in region z (Trend T-1)
4192  ;
4193   
4194  *==============================================================================
4195  * Residual
4196  *==============================================================================
4197  Parameter MRGN_RES(i) "글로벌 마진 수급의 초기 데이터 불일치 흡수 잔차";
4198  * 초기 총공급량 - 초기 총수요량의 차이를 고정값으로 계산
4199  MRGN_RES(i) = SUM(z$MRGNO(i,z), MRGNO(i,z))
4200              - SUM((z,zj,ij)$IMO(ij,zj,z), tmrg(i,ij,zj,z) * IMO(ij,zj,z));
4201   
4202  Parameter YROW_RES(z) "YROW 총수입액 계산의 초기 데이터 소수점 오차 잔차";
4203  * 초기 장부상 총수입액(YROWO)과 개별 무역액 총합의 미세한 차이를 고정값으로 계산
4204  YROW_RES(z) = YROWO(z)
4205              - { 1.0 * SUM((i,zj)$IMO(i,zj,z), IMO(i,zj,z) * [PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z))]) };
4206   
4207  *==============================================================================
4208  *  [ToT Calibration] Base Year FOB / CIF Values and Weights
4209  *==============================================================================
4210  PARAMETER
4211    VFOB0(i,z,zj)   "Base year FOB value of exports"
4212    VCIF0(i,zj,z)   "Base year CIF value of imports"
4213    W_EXP(i,z,zj)   "Bilateral export weight (Laspeyres)"
4214    W_IMP(i,zj,z)   "Bilateral import weight (Laspeyres)"
4215    PWX0(i,z,zj)    "Base year World FOB price"
4216    PCIF0(i,zj,z)   "Base year World CIF price"
4217    PX_INDEXO(z)
4218    PM_INDEXO(z)
4219    TOTO(z)
4220  ;
4221   
4222  * FOB 가치 = 수출물량 * 국제수출가격 * 환율
4223   VFOB0(i,z,zj) = eO(z) * PWXO(i,z,zj) * EXO(i,z,zj);
4224   
4225  * CIF 가치 = 수입물량 * (국제수입가격 + 국제운송마진) * 환율
4226   VCIF0(i,zj,z) = eO(z) * IMO(i,zj,z) * (PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z)));
4227   
4228  * 2. 가중치 도출 (국가 z의 총 수출/수입액 대비 각 경로의 비중)
4229   W_EXP(i,z,zj)$SUM((ii,zjj), VFOB0(ii,z,zjj)) = VFOB0(i,z,zj) / SUM((ii,zjj), VFOB0(ii,z,zjj));
4230   W_IMP(i,zj,z)$SUM((ii,zjj), VCIF0(ii,zjj,z))  = VCIF0(i,zj,z) / SUM((ii,zjj), VCIF0(ii,zjj,z));
4231   
4232  * 3. 기준연도 가격 저장 (지수 분모용)
4233   PWX0(i,z,zj) = PWXO(i,z,zj);
4234   
4235   PCIF0(i,zj,z) = PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z));
4236   
4237   PX_INDEXO(z) = SUM((i,zj)$VFOB0(i,z,zj), W_EXP(i,z,zj) * (PWXO(i,z,zj) / PWX0(i,z,zj)));
4238   
4239   PM_INDEXO(z) = SUM((i,zj)$VCIF0(i,zj,z), W_IMP(i,zj,z) * ( (PWMO(i,zj,z) + SUM(ij, PWMGO(ij) * tmrg(ij,i,zj,z))) / PCIF0(i,zj,z) ));
4240   
4241   TOTO(z)$PM_INDEXO(z) = PX_INDEXO(z) / PM_INDEXO(z);
4242  *execute_unload 'Calibration_Check_GTAP11c';
4243  *$exit
