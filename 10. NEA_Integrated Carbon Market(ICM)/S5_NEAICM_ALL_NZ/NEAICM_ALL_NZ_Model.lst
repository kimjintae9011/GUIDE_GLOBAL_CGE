4402   ttdh1(z,time)           Slope (household income tax)
4403   ttic(i,z,time)          Tax rate on commodity i
4404   ttik(k,j,z,time)        Tax rate on capital k used in industry j
4405   ttim(i,zj,z,time)       Rate of taxes and duties on imports of commodity i from country zj
4406   ttip(j,z,time)          Tax rate on the production of industry j
4407   ttiw(j,z,time)          Tax rate on type l worker compensation in industry j
4408   ttix(i,z,zj,time)       Export tax rate on exported commodity i
4409   A_VA(z,time)            Multifactor productivity
4410   LEON(z,time)            Excess supply on the last market in region z
4411   OBJ                     Objective function value
4412  ;
4413   
4414  *==============================================================================
4415  * Equations Declaration
4416  *==============================================================================
4417  EQUATIONS
4418  * --- Production and Inputs ---
4419   EQ1(j,z,time)           Leontief - demand for value added
4420   EQ1_1(j,z,time)         Leontief - demand for KLE (Industries)
4421   EQ2(j,z,time)           Leontief - demand for intermediate consumption
4422   EQ2_1(j,z,time)         Leontief - demand for intermediate energy consumption (Energy Industries)
4423   EQ3(j,z,time)           CES - combination of labor and capital
4424   EQ3_1(j,z,time)         CES - combination of composite energy and value added
4425   EQ4(j,z,time)           CES - demand for composite labor
4426   EQ4_1(j,z,time)         Demand for value added relative to composite energy
4427   EQ5(j,z,time)           CES between labor categories
4428   EQ7(j,z,time)           CES between capital categories
4429   EQ8(k,j,z,time)         Demand for capital
4430   EQ9(i,j,z,time)         Leontief - demand for commodity i by sector j
4431   EQ9_1(ene,j3,z,time)    Energy nesting
4432   EQ9_2(j2,z,time)        Nested CES - Level 1
4433   EQ9_3(j2,z,time)        Nested CES - Level 2
4434   EQ9_4(j2,z,time)        Nested CES - Level 3
4435   EQ9_5(j2,z,time)        Nested CES - Level 4
4436   EQ9_6(ene2,j2,z,time)   Nested CES - Level 5
4437   EQ9_7(ene5,j2,z,time)   Nested CES - Level 6
4438   EQ9_8(ene6,j2,z,time)   Nested CES - Level 7
4439   
4440  * --- Income and Savings ---
4441   EQ10(z,time)            Household total income
4442   EQ11(z,time)            Household labor income
4443   EQ12(z,time)            Household capital income
4444   EQ13(z,time)            Household disposable income
4445   EQ14(z,time)            Household consumption budget
4446   EQ15(z,time)            Household savings
4447   EQ16(z,time)            Government total income
4448   EQ16_1(z,time)          Government revenue from Ctax
4449   EQ17(z,time)            Total government receipts of taxes on production
4450   EQ18(z,time)            Government receipts of indirect taxes on wages
4451   EQ19(z,time)            Government receipts of indirect taxes on capital
4452   EQ20(z,time)            Government receipts of indirect taxes on production
4453   EQ21(z,time)            Total government receipts of taxes on products and imports
4454   EQ22(z,time)            Government receipts of indirect taxes on consumption
4455   EQ23(z,time)            Government receipts of indirect taxes on imports
4456   EQ24(z,time)            Government receipts of indirect taxes on exports
4457   EQ25(z,time)            Household income taxes
4458   EQ26(j,z,time)          Government receipts of indirect taxes on wages
4459   EQ27(k,j,z,time)        Government receipts of indirect taxes on capital
4460   EQ28(j,z,time)          Government receipts of indirect taxes on production of industry j
4461   EQ29(i,z,time)          Government receipts of indirect taxes on commodity i
4462   EQ30(i,zj,z,time)       Government receipts of indirect taxes on imports of commodity i
4463   EQ31(i,z,zj,time)       Government receipts of indirect taxes on exports of commodity i
4464   EQ32(z,time)            Government savings
4465   EQ33(z,time)            Rest of the world total income
4466   EQ34(z,time)            Rest of the world savings
4467   EQ35(z,time)            Equivalence between current account balance and savings
4468   
4469  * --- Demand and Trade ---
4470   EQ36(i,z,time)          Household consumption of commodity i
4471   EQ37(i,z,time)          Final demand of commodity i for investment purposes
4472   EQ38(i,z,time)          Public final consumption of commodity i
4473   EQ39(i,z,time)          Total intermediate consumption of commodity i
4474   EQ39_1(i,z,time)        Total intermediate consumption of commodity i
4475   EQ39_2(i,z,time)        Total intermediate consumption of commodity i
4476   EQ40_3(i,z,time)        Domestic supply by commdities
4477   EQ40_4(j,z,time)        Total supply by commdities
4478   EQ40_5(i,z,time)        CET function between exports local production and margins
4479   EQ41(i,z,time)          Supply of composite exports
4480   EQ42(i,z,time)          Supply of margins
4481   EQ43(i,z,time)          CET function between exports by trading partner
4482   EQ44(i,z,zj,time)       Supply of exports by trading partner
4483   EQ45(i,z,time)          CES function between composite imports and local production
4484   EQ46(i,z,time)          Demand for composite imports
4485   EQ47(i,z,time)          CES function between imports by origin
4486   EQ48(i,zj,z,time)       Demand for imports by origin
4487   
4488  * --- Prices ---
4489   EQ49(j,z,time)          Producer price in energy industries j after production taxes
4490   EQ49_1(j,z,time)        Producer price in industry j after production taxes
4491   EQ50(j,z,time)          Basic price of industry j production
4492   EQ51(j,z,time)          Price index of industry j intermediate consumption
4493   EQ51_1(j2,z,time)       Price index nested CES
4494   EQ51_2(j3,z,time)       Price index nested CES
4495   EQ51_3(j2,z,time)       Price index nested CES
4496   EQ51_4(j2,z,time)       Price index nested CES
4497   EQ51_5(j2,z,time)       Price index nested CES
4498   EQ51_6(j2,z,time)       Price index nested CES
4499   EQ52(j,z,time)          Value added price
4500   EQ52_1(j,z,time)        KLE price
4501   EQ53(j,z,time)          Price of composite labor in industry j (redundant)
4502   EQ54(j,z,time)          Wages including taxes
4503   EQ54_1(ene,j,z,time)    Energy commodity prices
4504   EQ56(k,j,z,time)        Rental rate including taxes
4505   EQ58(i,z,time)          Producer price is a weighted sum of PE and PL
4506   EQ60(i,z,zj,time)       Border price of exported commodity i
4507   EQ61(i,z,time)          Price of local product i (including all taxes and margins)
4508   EQ62(i,zj,z,time)       Price of imported commodity i (including all taxes and duties)
4509   EQ64(i,z,time)          Consumer price is a weighted sum of PD and PM
4510   EQ66(z,time)            GDP deflator (Fischer index)
4511   EQ67(time)              World GDP deflator (Fischer index)
4512   EQ68(z,time)            Consumer price index (Laspeyres)
4513   EQ69(z,time)            Investment price index (derived from investment function)
4514   EQ70(z,time)            Public expenditure price index
4515   
4516  * --- Equilibrium and Macro ---
4517   EQ71(i1,z,time)         Domestic absorbtion
4518   EQ72(z,time)            Labor supply equals labor demand
4519   EQ73(k,z,time)          Capital supply equals capital demand
4520   EQ74(z,time)            Total investment equals total savings
4521   EQ75(z,time)            Depreciation
4522   EQ76(i,z,time)          Supply of domestic production equals demand
4523   EQ77(i,z,zj,time)       Exports supply equals imports demand
4524   EQ78(i,z,zj,time)       Exports price equals imports price
4525   EQ79(i,time)            World demand for margins equals world supply
4526   EQ81(z,time)            GDP at basic prices
4527   EQ82(z,time)            GDP at market prices
4528   EQ83(z,time)            GDP at market prices (income-based)
4529   EQ84(z,time)            GDP at market prices (expenditure-based)
4530   EQ85(time)              World GDP
4531   EQ86(z,time)            Real consumption budget of type h households
4532   EQ87(z,time)            Real current government expenditures on goods and services
4533   EQ88(z,time)            Real GDP at basic prices
4534   EQ89(time)              Real world GDP at basic prices
4535   EQ90(z,time)            Real GDP at market prices
4536   EQ91(z,time)            Real gross fixed capital formation
4537   EQ92(z,time)            Current account balance of region z in terms of the reference currency
4538   WALRAS(z,time)          Walras law verification
4539   
4540  * --- Nested Trade & Output ---
4541   EQA_1(z,time)           Top Nest - Leontief function Aggregated-Electricity
4542   EQA_2(Z,time)           Top Nest - Leontief function Aggregated-Electricity
4543   EQA_3(BS, Conv, I_BS, Z_GRN, time)       Top Nest - Other
4544   EQA_3_OTH(BS, Conv, I_BS, Z_OTH, time)  Top Nest - OTH IRONSTAL
4545   EQA_4(z,time)           Second Nest - CES function - Aggregated-Electricity
4546   EQA_5(POWER,i,z,time)   Second Nest - CES function - Aggregated-Electricity
4547   EQA_6(BS, Conv, I_BS, Z_GRN, time)       Second Nest - CES function - Aggregated-Backstop
4548   EQA_7_CONV(BS, Conv, I_BS, Z_GRN, time)
4549   EQA_7_BS(BS, Conv, I_BS, Z_GRN, time)
4550   EQB_1(i2,z,time)        Industry j production of commodity i (CES)
4551   EQB_2(j,i2,z,time)      Industry j production
4552   EQB_3(j,i,z,time)       Total producer price is equal to P if there is only one product
4553   EQB_4(j,i,z,time)       Basic price of industry js production of commodity i
4554   EQB_5(j,i,z,time)       Supply of exports for compsite activity
4555   
4556  * --- Dynamics and Labor ---
4557   EQ94(z,time)            Total investment expenditure constraint
4558   EQ95(z,time)            Aggregate price of capital
4559   EQ96(k,bus,z,time)      Investment demand by industry
4560   EQ97a(z,time)           Interest rate (weighted average rate of return on capital)
4561   EQ97b(z,time)           User cost of capital
4562   EQ106(z,time)           Labor supply
4563   
4564  * --- Climate Policy (CTAX, Permits, DAC) ---
4565   EQ107(j,z,time)         Permit calculation by sector
4566   EQ108(z,time)           Total permits
4567   EQ109(z,time)           Carbon tax rebate
4568   EQ110(j,z,time)         Wage share for rebate
4569   EQ111(j,z,time)         Labor rebate
4570   EQ118(z,time)           DAC volume
4571   EQ_OBJ                  Objective function
4572   EQ_NEA_Cap(time)
4573   EQ_NEA_Price_Sync(NEA, time)
4574   EQ_Independent_Cap(PERMITOTH, time)
4575   
4576  * --- Green Steel (VAT Nest) ---
4577   EQ_TSFMKT(BS,Z_GRN,time)   TSF Market clearing condition
4578   EQ_TSFD(BS,Z_GRN,time)     Demand function for TSF (Leontief)
4579   EQ_VAT_REQ(BS,Z_GRN, time) VAT composite requirement
4580   EQ_PVAT(BS,Z_GRN, time)    Price of VAT composite
4581   EQ_VA_GRN(BS,Z_GRN, time)  Value added for Green Steel
4582   EQ_PP_GRN(BS,Z_GRN, time)  Producer price for Green Steel
4583   
4584  * --- Terms of Trade ---
4585   EQ_PX_INDEX(z,time)     Export price index equation
4586   EQ_PM_INDEX(z,time)     Import price index equation
4587   EQ_TOT(z,time)          Terms of Trade equation
4588   
4589  ;
4590   
4591  *==============================================================================
4592  * 5.3 Equation Definitions
4593  *==============================================================================
4594   
4595  *==============================================================================
4596  * 5.3.1 Production
4597  *==============================================================================
4598  EQ1(j3,z,t)$[not BS(j3)]..
4599      VA(j3,z,t) =e= v(j3,z) * XST(j3,z,t);
4600   
4601   EQ1_1(j2,z,t)..
4602      KLE(j2,z,t) =e= v2(j2,z) * XST(j2,z,t);
4603   
4604   EQ2(j,z,t)..
4605      CI(j,z,t) =e= io(j,z) * XST(j,z,t);
4606   
4607   EQ2_1(j3,z,t)..
4608      CE(j3,z,t) =e= io2(j3,z) * XST(j3,z,t);
4609   
4610   EQ3(j,z,t)$[XSTO(j,z)]..
4611      VA(j,z,t) =e= A_VA(z,t) * B_VA_t(j,z,t) * {
4612                    [beta_VA(j,z) * LDC(j,z,t)**(-rho_VA(j,z))]$LDCO(j,z)
4613                  + [(1 - beta_VA(j,z)) * KDC(j,z,t)**(-rho_VA(j,z))]$KDCO(j,z)
4614                  }**(-1 / rho_VA(j,z));
4615   
4616   EQ3_1(j2,z,t)..
4617      KLE(j2,z,t) =e= B_KLE(j2,z) * {
4618                      [beta_KLE(j2,z) * VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
4619                    + [(1 - beta_KLE(j2,z)) * CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
4620                    }**(-1 / rho_KLE(j2,z));
4621   
4622  EQ4_1(j2,z,t)$[VAO(j2,z) and CEO(j2,z)]..
4623      VA(j2,z,t) * (beta_KLE2(j2,z)**sigma_KLE(j2,z)) * (PVA(j2,z,t)**sigma_KLE(j2,z))
4624      =e= ((1 - beta_KLE2(j2,z))**sigma_KLE(j2,z)) * (PCE(j2,z,t)**sigma_KLE(j2,z)) * CE(j2,z,t);
4625   
4626   EQ4(j,z,t)$[LDCO(j,z) and KDCO(j,z)]..
4627      LDC(j,z,t) =e= {[beta_VA(j,z) / (1 - beta_VA(j,z))]
4628                     *[RC(j,z,t) / WC(j,z,t)]}**sigma_VA(j,z) * KDC(j,z,t);
4629   
4630   EQ5(j,z,t)$LDCO(j,z)..
4631      LDC(j,z,t) =e= LD(j,z,t);
4632   
4633   EQ7(j,z,t)$KDCO(j,z)..
4634      KDC(j,z,t) =e= B_KD(j,z) * SUM[k$KDO(k,j,z), beta_KD(k,j,z)
4635                     * KD(k,j,z,t)**(-rho_KD(j,z))]**(-1 / rho_KD(j,z));
4636   
4637   EQ8(k,j,z,t)$KDO(k,j,z)..
4638      KD(k,j,z,t) =e= [beta_KD(k,j,z) * RC(j,z,t) / RTI(k,j,z,t)]**sigma_KD(j,z)
4639                    * B_KD(j,z)**(sigma_KD(j,z) - 1) * KDC(j,z,t);
4640   
4641   EQ9(nene,j,z,t)..
4642      DI(nene,j,z,t) =e= aij_t(nene,j,z,t) * CI(j,z,t);
4643   
4644   EQ9_1(ene,j3,z,t)..
4645      DE(ene,j3,z,t) =e= aij2_t(ene,j3,z,t) * CE(j3,z,t) * AEEI(z,t);
4646   
4647  *============================= Level 1, 2, 3 (CES Energy Nesting) =====================
4648   EQ9_2(j2,z,t)..
4649      CE(j2,z,t) =e= B_ENER_elec(j2,z) * {
4650                     [(beta_ENER_elec(j2,z)) * DEelec(j2,z,t)**(-rho_ENER_elec(j2,z))]
4651                   + [(1 - beta_ENER_elec(j2,z)) * DEnelec(j2,z,t)**(-rho_ENER_elec(j2,z))]
4652                   }**(-1 / rho_ENER_elec(j2,z));
4653   
4654   EQ9_3(j2,z,t)..
4655      DEnelec(j2,z,t) =e= {[(1 - beta_ENER_elec(j2,z)) / (beta_ENER_elec(j2,z))]
4656                          *[PCEelec(j2,z,t) / PCEnelec(j2,z,t)]}**sigma_ENER_elec(j2,z) * DEelec(j2,z,t);
4657   
4658   EQ9_4(j2,z,t)..
4659      DEnelec(j2,z,t) =e= B_ENER_nelec(j2,z) * {
4660                          [(beta_ENER_nelec(j2,z)) * DEcoalgas(j2,z,t)**(-rho_ENER_nelec(j2,z))]
4661                        + [(1 - beta_ENER_nelec(j2,z)) * DEoilpetrol(j2,z,t)**(-rho_ENER_nelec(j2,z))]
4662                        }**(-1 / rho_ENER_nelec(j2,z));
4663   
4664   EQ9_5(j2,z,t)..
4665      DEoilpetrol(j2,z,t) =e= {[(1 - beta_ENER_nelec(j2,z)) / (beta_ENER_nelec(j2,z))]
4666                              *[PCEcoalgas(j2,z,t) / PCEoilpetrol(j2,z,t)]}**sigma_ENER_nelec(j2,z) * DEcoalgas(j2,z,t);
4667   
4668   EQ9_6(ene2,j2,z,t)..
4669      DE(ene2,j2,z,t) =e= DEelec(j2,z,t) * AEEI(z,t);
4670   
4671   EQ9_7(ene5,j2,z,t)..
4672      DE(ene5,j2,z,t) =e= [beta_ENER_coalgas(ene5,j2,z) * PCEcoalgas(j2,z,t) / (P4(ene5,j2,z,t) + P4(ene5,j2,z,t) * CTAX(z,t) * CO2FACTOR2(ene5,j2,z,t))]
4673                          **sigma_ENER_coalgas(j2,z) * B_ENER_coalgas(j2,z)**(sigma_ENER_coalgas(j2,z) - 1)
4674                          * DEcoalgas(j2,z,t) * AEEI(z,t);
4675   
4676   EQ9_8(ene6,j2,z,t)..
4677      DE(ene6,j2,z,t) =e= [beta_ENER_oilprod(ene6,j2,z) * PCEoilpetrol(j2,z,t) / (P4(ene6,j2,z,t) + P4(ene6,j2,z,t) * CTAX(z,t) * CO2FACTOR2(ene6,j2,z,t))]
4678                          **sigma_ENER_oilprod(j2,z) * B_ENER_oilprod(j2,z)**(sigma_ENER_oilprod(j2,z) - 1)
4679                          * DEoilpetrol(j2,z,t) * AEEI(z,t);
4680   
4681  *==============================================================================
4682  * 5.3.2 Income and savings
4683  *==============================================================================
4684   EQ10(z,t)..
4685      YH(z,t) =e= YHL(z,t) + YHK(z,t) + REBATE(z,t) * recycle_hou(z,t)
4686                + SUM((BS, Z_GRN)$sameas(z, Z_GRN), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t));
4687   
4688   EQ11(z,t)..
4689      YHL(z,t) =e= SUM[(j)$LDO(j,z), W(z,t) * (LD(j,z,t))];
4690   
4691   EQ12(z,t)..
4692      YHK(z,t) =e= SUM[(k,j)$KDO(k,j,z), R(k,j,z,t) * (KD(k,j,z,t))];
4693   
4694   EQ13(z,t)..
4695      YDH(z,t) =e= YH(z,t) - TDH(z,t);
4696   
4697   EQ14(z,t)..
4698      CTH(z,t) =e= YDH(z,t) - SH(z,t);
4699   
4700   EQ15(z,t)..
4701      SH(z,t) =e= PIXCON(z,t)**eta * sh0(z,t) + sh1(z,t) * YDH(z,t);
4702   
4703  *==============================================================================
4704  * 5.3.2.2 Government
4705  *==============================================================================
4706   EQ16(z,t)..
4707      YG(z,t) =e= TDH(z,t) + TPRODN(z,t) + TPRCTS(z,t) + REBATE(z,t) * recycle_gov(z,t) - SUM(i1, PC(i1,z,t) * QDAC(z,t) * DAC_Tech_Coeff(i1));
4708   
4709   EQ16_1(z,t)..
4710      TCTAX(z,t) =e= SUM((ene,j), PC(ene,z,t) * CTAX(z,t) * CO2FACTOR2(ene,j,z,t) * DE(ene,j,z,t));
4711   
4712   EQ17(z,t)..
4713      TPRODN(z,t) =e= TIWT(z,t) + TIKT(z,t) + TIPT(z,t);
4714   
4715  EQ18(z,t)..
4716      TIWT(z,t) =e= SUM[(j)$LDO(j,z), TIW(j,z,t)] ;
4717   
4718   EQ19(z,t)..
4719      TIKT(z,t) =e= SUM[(k,j)$KDO(k,j,z), TIK(k,j,z,t)] ;
4720   
4721   EQ20(z,t)..
4722      TIPT(z,t) =e= SUM[j, TIP(j,z,t)] ;
4723   
4724   EQ21(z,t)..
4725      TPRCTS(z,t) =e= TICT(z,t) + TIMT(z,t) + TIXT(z,t);
4726   
4727   EQ22(z,t)..
4728      TICT(z,t) =e= SUM[i, TIC(i,z,t)];
4729   
4730   EQ23(z,t)..
4731      TIMT(z,t) =e= SUM[(i,zj)$IMO(i,zj,z), TIM(i,zj,z,t)];
4732   
4733   EQ24(z,t)..
4734      TIXT(z,t) =e= SUM[(i,zj)$EXO(i,z,zj), TIX(i,z,zj,t)];
4735   
4736   EQ25(z,t)..
4737      TDH(z,t) =e= PIXCON(z,t)**eta * ttdh0(z,t) + ttdh1(z,t) * YH(z,t);
4738   
4739   EQ26(j,z,t)$LDO(j,z)..
4740      TIW(j,z,t) =e= ttiw(j,z,t) * W(z,t) * (LD(j,z,t)) - LaborRebate(j,z,t);
4741   
4742   EQ27(k,j,z,t)$KDO(k,j,z)..
4743      TIK(k,j,z,t) =e= ttik(k,j,z,t) * R(k,j,z,t) * (KD(k,j,z,t));
4744   
4745   EQ28(j,z,t)..
4746      TIP(j,z,t) =e= ttip(j,z,t) * PP(j,z,t) * XST(j,z,t);
4747   
4748   EQ29(i,z,t)..
4749      TIC(i,z,t) =e= ttic(i,z,t) * {
4750                     [PL(i,z,t) * DD(i,z,t)]$DDO(i,z)
4751                   + [SUM[zj$IMO(i,zj,z), (1 + ttim(i,zj,z,t)) * IM(i,zj,z,t) * e(z,t)
4752                     *(PWM(i,zj,z,t) + SUM(ij, PWMG(ij,t) * tmrg(ij,i,zj,z)))]]
4753                   };
4754   
4755   EQ30(i,zj,z,t)$IMO(i,zj,z)..
4756      TIM(i,zj,z,t) =e= ttim(i,zj,z,t) * IM(i,zj,z,t) * e(z,t) * (PWM(i,zj,z,t) + SUM[ij, PWMG(ij,t) * tmrg(ij,i,zj,z)]);
4757   
4758   EQ31(i,z,zj,t)$EXO(i,z,zj)..
4759      TIX(i,z,zj,t) =e= ttix(i,z,zj,t) * PE(i,z,zj,t) * EX(i,z,zj,t);
4760   
4761   EQ32(z,t)..
4762      SG(z,t) =e= YG(z,t) - G(z,t);
4763   
4764  *==============================================================================
4765  * 5.3.2.4 Rest of the world
4766  *==============================================================================
4767   EQ33(z,t)..
4768      YROW(z,t) =e= e(z,t) * SUM{(i,zj)$IMO(i,zj,z), IM(i,zj,z,t) * [PWM(i,zj,z,t) + SUM(ij, PWMG(ij,t) * tmrg(ij,i,zj,z))]}+YROW_RES(z);
4769   
4770   EQ34(z,t)..
4771      SROW(z,t) =e= YROW(z,t) - e(z,t) * SUM[(i,zj)$EXO(i,z,zj), EX(i,z,zj,t) * PWX(i,z,zj,t)]
4772                    - e(z,t) * SUM[i$MRGNO(i,z), MRGN(i,z,t) * PWMG(i,t)]
4773                    - [(S3_EMISSIONS(z,t)/10000 - PERMIT_TOTAL(z,t)) * NEA_REGIONAL_CTAX(t)]$NEA(z);
4774   
4775   EQ35(z,t)..
4776      SROW(z,t) =e= -CAB(z,t);
4777   
4778  *==============================================================================
4779  * 5.3.3 Demand
4780  *==============================================================================
4781   EQ36(i,z,t)..
4782      PC(i,z,t) * C(i,z,t) =e= PC(i,z,t) * (CMIN(i,z,t))
4783                             + gamma_LES(i,z) * {CTH(z,t) - SUM[ij, PC(ij,z,t) * (CMIN(ij,z,t))]};
4784   
4785   EQ37(i,z,t)..
4786      PC(i,z,t) * INV(i,z,t) =e= gamma_INV(i,z) * IT(z,t);
4787   
4788   EQ38(i,z,t)..
4789      PC(i,z,t) * CG(i,z,t) =e= gamma_GVT(i,z) * G(z,t);
4790   
4791   EQ39(nene,z,t)..
4792      DIT(nene,z,t) =e= SUM[j, DI(nene,j,z,t)];
4793   
4794   EQ39_1(ene1,z,t)..
4795      DIT(ene1,z,t) =e= SUM[j, DE(ene1,j,z,t)];
4796   
4797   EQ39_2(ene2,z,t)..
4798      DIT(ene2,z,t) =e= SUM[j, DE(ene2,j,z,t)];
4799   
4800  *==============================================================================
4801  * 5.3.4 International trade
4802  *==============================================================================
4803   EQA_1(z,t)..
4804      XS('18_TnD','18_ELEC',z,t) =e= TnDShare(z) * XS_I('18_ELEC',z,t);
4805   
4806   EQA_2(z,t)..
4807      XS_I('18_ELEC',z,t) =e= XS('18_TnD','18_ELEC',z,t) + QPOWER(z,t);
4808   
4809   EQA_3(BS, Conv, I_BS, Z_GRN, t)$MAP_BS(BS, Conv, I_BS)..
4810      XS_I(I_BS, Z_GRN, t) =e= QBS(BS, Z_GRN, t);
4811   
4812   EQA_3_OTH(BS, Conv, I_BS, Z_OTH, t)$MAP_BS(BS, Conv, I_BS)..
4813      XS_I(I_BS, Z_OTH, t) =e= XS(Conv, I_BS, Z_OTH, t);
4814   
4815   EQA_4(z,t)..
4816      QPOWER(z,t) =e= B_X4(z) * SUM[POWER, beta_X4(power,z) * XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1 / rho_X4(z));
4817   
4818   EQA_5(power,'18_ELEC',z,t)..
4819      XS(POWER,'18_ELEC',z,t) =e= QPOWER(z,t) / B_X4(z)**(1 - sigma_X4(z)) *
4820                                  [beta_X4(power,z) * PPOWER(z,t) / P2(POWER,'18_ELEC',z,t)]**sigma_X4(z);
4821   
4822  EQA_6(BS, Conv, I_BS, Z_GRN, t)$MAP_BS(BS, Conv, I_BS)..
4823      QBS(BS, Z_GRN, t) =e= B_BS(BS, Z_GRN) * (
4824            beta_BS_t(Conv, I_BS, Z_GRN, t) * XS(Conv, I_BS, Z_GRN, t)**(-rho_BS(BS, Z_GRN))
4825          + beta_BS_t(BS, I_BS, Z_GRN, t) * XS(BS, I_BS, Z_GRN, t)**(-rho_BS(BS, Z_GRN))
4826      )**(-1 / rho_BS(BS, Z_GRN));
4827   
4828   EQA_7_CONV(BS, Conv, I_BS, Z_GRN, t)$MAP_BS(BS, Conv, I_BS)..
4829      XS(Conv, I_BS, Z_GRN, t) =e= QBS(BS, Z_GRN, t) / B_BS(BS, Z_GRN)**(1 - sigma_BS(BS, Z_GRN)) *
4830          [beta_BS_t(Conv, I_BS, Z_GRN, t) * PBS(BS, Z_GRN, t) / P2(Conv, I_BS, Z_GRN, t)]**sigma_BS(BS, Z_GRN);
4831   
4832   EQA_7_BS(BS, Conv, I_BS, Z_GRN, t)$MAP_BS(BS, Conv, I_BS)..
4833      XS(BS, I_BS, Z_GRN, t) =e= QBS(BS, Z_GRN, t) / B_BS(BS, Z_GRN)**(1 - sigma_BS(BS, Z_GRN)) *
4834          [beta_BS_t(BS, I_BS, Z_GRN, t) * PBS(BS, Z_GRN, t) / P2(BS, I_BS, Z_GRN, t)]**sigma_BS(BS, Z_GRN);
4835   
4836   EQB_1(i2,z,t)..
4837      XS_I(i2,z,t) =e= B_X3(i2,z) * SUM[j$XSO(j,i2,z), beta_X3(j,i2,z) * XS(j,i2,z,t)**(-rho_X3(i2,z))]**(-1 / rho_X3(i2,z));
4838   
4839   EQB_2(j,i2,z,t)${DSO(j,i2,z) and [DSO(j,i2,z) ne DSO_I(i2,z)]}..
4840      XS(j,i2,z,t) =e= XS_I(i2,z,t) / B_X3(i2,z)**(1 - sigma_X3(i2,z)) *[beta_X3(j,i2,z) * P(i2,z,t) / P2(j,i2,z,t)]**sigma_X3(i2,z);
4841   
4842   EQB_3(j,i,z,t)${DSO(j,i,z)}..
4843      P2(j,i,z,t) =e= PT(j,z,t);
4844   
4845   EQB_4(j,i,z,t)$DSO(j,i,z)..
4846  *    P2(j,i,z,t) * XS(j,i,z,t) =e= [PET(i,z,t) * EXTT(j,i,z,t)]$EXTTO(j,i,z)
4847  *                                + [e(z,t) * MRGN(i,z,t) * PWMG(i,t)]$MRGNO(i,z)
4848  *                                + [PL(i,z,t) * DS(j,i,z,t)]$DSO(j,i,z);
4849   
4850      P2(j,i,z,t) * XS(j,i,z,t) =e= [PET(i,z,t) * EXTT(j,i,z,t)]$EXTTO(j,i,z)
4851                                  + [e(z,t) * MRGN(i,z,t) * PWMG(i,t) * SHR_MRGN(j,i,z)]$MRGNO(i,z)
4852                                  + [PL(i,z,t) * DS(j,i,z,t)]$DSO(j,i,z);
4853   
4854   EQB_5(j,i,z,t)$DSO(j,i,z)..
4855      EXTT(j,i,z,t) =e= theta2(j,i,z) * EXT(i,z,t);
4856   
4857   EQ40_3(i,z,t)..
4858      DS_I(i,z,t) =e= SUM(j, DS(j,i,z,t)$DSO(j,i,z));
4859   
4860   EQ40_4(j,z,t)..
4861      XST(j,z,t)  =e= SUM(i, XS(j,i,z,t)$XSO(j,i,z));
4862   
4863   EQ40_5(i,z,t)..
4864      XS_I(i,z,t) =e= B_X1(i,z) * {
4865                      [beta_EX_X1(i,z) * EXT(i,z,t)**rho_X1(i,z)]$EXTO(i,z)
4866                    + [beta_D_X1(i,z) * DS_I(i,z,t)**rho_X1(i,z)]$DSO_I(i,z)
4867                    + [(1 - beta_EX_X1(i,z) - beta_D_X1(i,z)) * MRGN(i,z,t)**rho_X1(i,z)]$MRGNO(i,z)
4868                    }**(1 / rho_X1(i,z));
4869   
4870   EQ41(i,z,t)$[EXTO(i,z) and DSO_I(i,z)]..
4871      EXT(i,z,t) =e= {[beta_D_X1(i,z) / beta_EX_X1(i,z)] * [PET(i,z,t) / PL(i,z,t)]}**sigma_X1(i,z) * DS_I(i,z,t);
4872   
4873   EQ42(i,z,t)$[MRGNO(i,z) and DSO_I(i,z)]..
4874      MRGN(i,z,t) =e= {[beta_D_X1(i,z) / (1 - beta_EX_X1(i,z) - beta_D_X1(i,z))] * [e(z,t) * PWMG(i,t) / PL(i,z,t)]}**sigma_X1(i,z) * DS_I(i,z,t);
4875   
4876   EQ43(i,z,t)$EXTO(i,z)..
4877      EXT(i,z,t) =e= B_X2(i,z) * SUM[zj$EXO(i,z,zj), beta_X2(i,z,zj) * EX(i,z,zj,t)**rho_X2(i,z)]**(1 / rho_X2(i,z));
4878   
4879   EQ44(i,z,zj,t)$EXO(i,z,zj)..
4880      EX(i,z,zj,t) =e= EXT(i,z,t) / B_X2(i,z)**(1 + sigma_X2(i,z)) *
4881                       [PE(i,z,zj,t) / (beta_X2(i,z,zj) * PET(i,z,t))]**sigma_X2(i,z);
4882   
4883   EQ45(i,z,t)..
4884      Q(i,z,t) =e= B_M1(i,z) * {
4885                   [beta_M1(i,z) * IMT(i,z,t)**(-rho_M1(i,z))]$IMTO(i,z)
4886                 + [(1 - beta_M1(i,z)) * DD(i,z,t)**(-rho_M1(i,z))]$DDO(i,z)
4887                   }**(-1 / rho_M1(i,z));
4888   
4889   EQ46(i,z,t)$[IMTO(i,z) and DDO(i,z)]..
4890      IMT(i,z,t) =e= {[beta_M1(i,z) / (1 - beta_M1(i,z))] * [PD(i,z,t) / PMT(i,z,t)]}**sigma_M1(i,z) * DD(i,z,t);
4891   
4892   EQ47(i,z,t)$IMTO(i,z)..
4893      IMT(i,z,t) =e= B_M2(i,z) * SUM[zj$IMO(i,zj,z), beta_M2(i,zj,z) * IM(i,zj,z,t)**(-rho_M2(i,z))]**(-1 / rho_M2(i,z));
4894   
4895   EQ48(i,zj,z,t)$IMO(i,zj,z)..
4896      IM(i,zj,z,t) =e= IMT(i,z,t) / B_M2(i,z)**(1 - sigma_M2(i,z)) *
4897                       [beta_M2(i,zj,z) * PMT(i,z,t) / PM(i,zj,z,t)]**sigma_M2(i,z);
4898   
4899  *==============================================================================
4900  * 5.3.5 Prices
4901  *==============================================================================
4902   EQ49(j2,z,t)..
4903      PP(j2,z,t) * XST(j2,z,t) =e= PKLE(j2,z,t) * KLE(j2,z,t) + PCI(j2,z,t) * CI(j2,z,t);
4904   
4905  EQ49_1(j3,z,t)$[not BS(j3)]..
4906      PP(j3,z,t) * XST(j3,z,t) =e= PVA(j3,z,t) * VA(j3,z,t) + PCI(j3,z,t) * CI(j3,z,t) + PCE(j3,z,t) * CE(j3,z,t);
4907   
4908   EQ50(j,z,t)..
4909      PT(j,z,t) =e= (1 + ttip(j,z,t)) * PP(j,z,t);
4910   
4911   EQ51(j,z,t)..
4912      PCI(j,z,t) * CI(j,z,t) =e= SUM[nene, PC(nene,z,t) * DI(nene,j,z,t)];
4913   
4914   EQ51_2(j3,z,t)..
4915      PCE(j3,z,t) * CE(j3,z,t) =e= SUM[ene, PC(ene,z,t) * DE(ene,j3,z,t) + PC(ene,z,t) * CTAX(z,t) * CO2FACTOR2(ene,j3,z,t) * DE(ene,j3,z,t)];
4916   
4917   EQ51_1(j2,z,t)..
4918      PCE(j2,z,t) * CE(j2,z,t) =e= [PCEelec(j2,z,t) * DEelec(j2,z,t) + PCEnelec(j2,z,t) * DEnelec(j2,z,t)];
4919   
4920   EQ51_3(j2,z,t)..
4921      PCEelec(j2,z,t) * DEelec(j2,z,t) =e= PC("18_ELEC",z,t) * DE("18_ELEC",j2,z,t);
4922   
4923   EQ51_4(j2,z,t)..
4924      PCEnelec(j2,z,t) * DEnelec(j2,z,t) =e= [PCEcoalgas(j2,z,t) * DEcoalgas(j2,z,t) + PCEoilpetrol(j2,z,t) * DEoilpetrol(j2,z,t)];
4925   
4926   EQ51_5(j2,z,t)..
4927      PCEcoalgas(j2,z,t) * DEcoalgas(j2,z,t) =e= [PC("02_COAL",z,t) * DE("02_COAL",j2,z,t) + PC("02_COAL",z,t) * CTAX(z,t) * CO2FACTOR2("02_COAL",j2,z,t) * DE("02_COAL",j2,z,t)
4928                                               + PC("04_GAS",z,t) * DE("04_GAS",j2,z,t) + PC("04_GAS",z,t) * CTAX(z,t) * CO2FACTOR2("04_GAS",j2,z,t) * DE("04_GAS",j2,z,t)];
4929   
4930   EQ51_6(j2,z,t)..
4931      PCEoilpetrol(j2,z,t) * DEoilpetrol(j2,z,t) =e= [PC("03_OIL",z,t) * DE("03_OIL",j2,z,t) + PC("03_OIL",z,t) * CTAX(z,t) * CO2FACTOR2("03_OIL",j2,z,t) * DE("03_OIL",j2,z,t)
4932                                                   + PC("10_PETROLCOAL",z,t) * DE("10_PETROLCOAL",j2,z,t) + PC("10_PETROLCOAL",z,t) * CTAX(z,t) * CO2FACTOR2("10_PETROLCOAL",j2,z,t) * DE("10_PETROLCOAL",j2,z,t)];
4933   
4934  EQ52(j,z,t)..
4935      PVA(j,z,t) * VA(j,z,t) =e= [WC(j,z,t) * LDC(j,z,t)]$LDCO(j,z)
4936                               + [RC(j,z,t) * KDC(j,z,t)]$KDCO(j,z);
4937   
4938   EQ52_1(j2,z,t)..
4939      PKLE(j2,z,t) * KLE(j2,z,t) =e= [PVA(j2,z,t) * VA(j2,z,t)]$VAO(j2,z)
4940                                   + [PCE(j2,z,t) * CE(j2,z,t)]$CEO(j2,z);
4941   
4942   EQ53(j,z,t)..
4943      WC(j,z,t) * LDC(j,z,t) =e= WTI(j,z,t) * (LD(j,z,t));
4944   
4945   EQ54(j,z,t)$LDO(j,z)..
4946      WTI(j,z,t) * LD(j,z,t) =e= W(z,t) * (1 + ttiw(j,z,t)) * LD(j,z,t) - LaborRebate(j,z,t);
4947   
4948   EQ54_1(ene,j2,z,t)$DEO(ene,j2,z)..
4949      P4(ene,j2,z,t) =e= PC(ene,z,t);
4950   
4951   EQ56(k,j,z,t)$KDO(k,j,z)..
4952      RTI(k,j,z,t) =e= R(k,j,z,t) * (1 + ttik(k,j,z,t));
4953   
4954   EQ58(i,z,t)..
4955      P(i,z,t) * XS_I(i,z,t) =e= [PL(i,z,t) * DS_I(i,z,t)]$DSO_I(i,z)
4956                               + [PET(i,z,t) * EXT(i,z,t)]$EXTO(i,z)
4957                               + [e(z,t) * PWMG(i,t) * MRGN(i,z,t)]$MRGNO(i,z);
4958   
4959   EQ60(i,z,zj,t)$EXO(i,z,zj)..
4960      PE(i,z,zj,t) * (1 + ttix(i,z,zj,t)) =e= e(z,t) * PWX(i,z,zj,t);
4961   
4962   EQ61(i,z,t)$DDO(i,z)..
4963      PD(i,z,t) =e= (1 + ttic(i,z,t)) * PL(i,z,t);
4964   
4965   EQ62(i,zj,z,t)$IMO(i,zj,z)..
4966      PM(i,zj,z,t) =e= (1 + ttic(i,z,t)) * (1 + ttim(i,zj,z,t)) * e(z,t) * (PWM(i,zj,z,t) + SUM[ij, PWMG(ij,t) * tmrg(ij,i,zj,z)]);
4967   
4968   EQ64(i,z,t)..
4969      PC(i,z,t) * Q(i,z,t) =e= [PD(i,z,t) * DD(i,z,t)]$DDO(i,z) + [PMT(i,z,t) * IMT(i,z,t)]$IMTO(i,z);
4970   
4971  EQ66(z,t)..
4972      PIXGDP(z,t) =e= {
4973        ( SUM[j$XSTO(j,z), {(PVA(j,z,t) * VA(j,z,t) + TIP(j,z,t)) / VA(j,z,t)} * VAO(j,z)]
4974          + SUM[(BS, Z_GRN)$(sameas(z, Z_GRN) and XSTO(BS, Z_GRN)), PTSF(BS, Z_GRN, t) * TSFO(BS, Z_GRN)] )
4975        /
4976        ( SUM[j$XSTO(j,z), {(PVAO(j,z) * VAO(j,z) + TIPO(j,z)) / VAO(j,z)} * VAO(j,z)]
4977          + SUM[(BS, Z_GRN)$(sameas(z, Z_GRN) and XSTO(BS, Z_GRN)), PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN)] )
4978        * ( SUM[j$XSTO(j,z), {(PVA(j,z,t) * VA(j,z,t) + TIP(j,z,t)) / VA(j,z,t)} * VA(j,z,t)]
4979          + SUM[(BS, Z_GRN)$(sameas(z, Z_GRN) and XSTO(BS, Z_GRN)), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t)] )
4980        /
4981        ( SUM[j$XSTO(j,z), {(PVAO(j,z) * VAO(j,z) + TIPO(j,z)) / VAO(j,z)} * VA(j,z,t)]
4982          + SUM[(BS, Z_GRN)$(sameas(z, Z_GRN) and XSTO(BS, Z_GRN)), PTSFO(BS, Z_GRN) * TSFD(BS, Z_GRN, t)] )
4983      }**0.5;
4984   
4985   EQ67(t)..
4986      PIXGDP_W(t) =e= {
4987        ( SUM[(j,z)$XSTO(j,z), {(PVA(j,z,t) * VA(j,z,t) + TIP(j,z,t)) / VA(j,z,t)} * VAO(j,z) / e(z,t)]
4988          + SUM[(BS, Z_GRN)$XSTO(BS, Z_GRN), PTSF(BS, Z_GRN, t) * TSFO(BS, Z_GRN) / e(Z_GRN, t)] )
4989        /
4990        ( SUM[(j,z)$XSTO(j,z), {(PVAO(j,z) * VAO(j,z) + TIPO(j,z)) / VAO(j,z)} * VAO(j,z) / eO(z)]
4991          + SUM[(BS, Z_GRN)$XSTO(BS, Z_GRN), PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN) / eO(Z_GRN)] )
4992        * ( SUM[(j,z)$XSTO(j,z), {(PVA(j,z,t) * VA(j,z,t) + TIP(j,z,t)) / VA(j,z,t)} * VA(j,z,t) / e(z,t)]
4993          + SUM[(BS, Z_GRN)$XSTO(BS, Z_GRN), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t) / e(Z_GRN, t)] )
4994        /
4995        ( SUM[(j,z)$XSTO(j,z), {(PVAO(j,z) * VAO(j,z) + TIPO(j,z)) / VAO(j,z)} * VA(j,z,t) / eO(z)]
4996          + SUM[(BS, Z_GRN)$XSTO(BS, Z_GRN), PTSFO(BS, Z_GRN) * TSFD(BS, Z_GRN, t) / eO(Z_GRN)] )
4997      }**0.5;
4998   
4999   EQ68(z,t)..
5000      PIXCON(z,t) =e= SUM[i, PC(i,z,t) * CO(i,z)] / SUM[i, PCO(i,z) * CO(i,z)];
5001   
5002   EQ69(z,t)..
5003      PIXINV(z,t) =e= PROD[i$gamma_INV(i,z), (PC(i,z,t) / PCO(i,z))**gamma_INV(i,z)];
5004   
5005   EQ70(z,t)..
5006      PIXGVT(z,t) =e= PROD[i$gamma_GVT(i,z), (PC(i,z,t) / PCO(i,z))**gamma_GVT(i,z)];
5007   
5008  *==============================================================================
5009  * 5.3.6 Equilibrium
5010  *==============================================================================
5011  EQ71(i1,z,t)..
5012      Q(i1,z,t) =e= C(i1,z,t) + CG(i1,z,t) + INV(i1,z,t) + DIT(i1,z,t) + (QDAC(z,t) * DAC_Tech_Coeff(i1)) ;
5013   
5014   EQ72(z,t)..
5015      LS(z,t) =e= SUM[j$LDO(j,z), LD(j,z,t)] ;
5016   
5017   EQ73(k,z,t)$KSO(k,z)..
5018      KS(k,z,t) =e= SUM[j$KDO(k,j,z), KD(k,j,z,t)] ;
5019   
5020   EQ74(z,t)..
5021      IT(z,t) =e= SH(z,t) + SG(z,t) - CAB(z,t);
5022   
5023   EQ75(z,t)..
5024      DEP(z,t) =e= PK(z,t) * delta(z) * SUM[k$KSO(k,z), KS(k,z,t)];
5025   
5026   EQ76(i,z,t)$DDO(i,z)..
5027      SUM[j$DSO(j,i,z), DS(j,i,z,t)] =e= DD(i,z,t);
5028   
5029   EQ77(i,z,zj,t)$EXO(i,z,zj)..
5030      EX(i,z,zj,t) =e= IM(i,z,zj,t);
5031   
5032   EQ78(i,z,zj,t)$EXO(i,z,zj)..
5033      PWX(i,z,zj,t) =e= PWM(i,z,zj,t);
5034   
5035   EQ79(i,t)..
5036      SUM[z$MRGNO(i,z), MRGN(i,z,t)] =e= SUM[(z,zj,ij)$IMO(ij,zj,z), tmrg(i,ij,zj,z) * IM(ij,zj,z,t)]+MRGN_RES(i) ;
5037   
5038  *==============================================================================
5039  * 5.3.7 Gross domestic product
5040  *==============================================================================
5041   EQ81(z,t)..
5042      GDP_BP(z,t) =e= SUM[j, PVA(j,z,t) * VA(j,z,t)] + TIPT(z,t)
5043                    + SUM((BS, Z_GRN)$sameas(z, Z_GRN), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t));
5044   
5045   EQ82(z,t)..
5046      GDP_MP(z,t) =e= GDP_BP(z,t) + TPRCTS(z,t) + TCTAX(z,t);
5047   
5048   EQ83(z,t)..
5049      GDP_IB(z,t) =e= SUM[(j)$LDO(j,z), W(z,t) * (LD(j,z,t))]
5050                    + SUM[(k,j)$KDO(k,j,z), R(k,j,z,t) * (KD(k,j,z,t))]
5051                    + SUM((BS, Z_GRN)$sameas(z, Z_GRN), PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t))
5052                    + TPRCTS(z,t) + TPRODN(z,t) + TCTAX(z,t);
5053   
5054   EQ84(z,t)..
5055      GDP_FD(z,t) =e= SUM[i, PC(i,z,t) * (C(i,z,t) + CG(i,z,t) + INV(i,z,t))]
5056                    + SUM[(i,zj)$EXO(i,z,zj), e(z,t) * PWX(i,z,zj,t) * EX(i,z,zj,t)]
5057                    + SUM[i$MRGNO(i,z), e(z,t) * PWMG(i,t) * MRGN(i,z,t)]
5058                    - SUM[(i,zj)$IMO(i,zj,z), e(z,t) * IM(i,zj,z,t) * (PWM(i,zj,z,t) + SUM[ij, PWMG(ij,t) * tmrg(ij,i,zj,z)])]
5059                    + SUM(i1, PC(i1,z,t) * QDAC(z,t) * DAC_Tech_Coeff(i1));
5060   
5061   EQ85(t)..
5062      GDP_BP_W(t) =e= SUM[z, GDP_BP(z,t) / e(z,t)];
5063   
5064  *==============================================================================
5065  * 5.3.8 Real (volume) variables computed from price indices
5066  *==============================================================================
5067   EQ86(z,t)..
5068      CTH_REAL(z,t) =e= CTH(z,t) / PIXCON(z,t);
5069   
5070   EQ87(z,t)..
5071      G_REAL(z,t) =e= G(z,t) / PIXGVT(z,t);
5072   
5073   EQ88(z,t)..
5074      GDP_BP_REAL(z,t) =e= GDP_BP(z,t) / PIXGDP(z,t);
5075   
5076   EQ89(t)..
5077      GDP_BP_W_REAL(t) =e= GDP_BP_W(t) / PIXGDP_W(t);
5078   
5079   EQ90(z,t)..
5080      GDP_MP_REAL(z,t) =e= GDP_MP(z,t) / PIXCON(z,t);
5081   
5082   EQ91(z,t)..
5083      IT_REAL(z,t) =e= IT(z,t) / PIXINV(z,t);
5084   
5085   EQ92(z,t)..
5086      CABX(z,t) =e= CAB(z,t) / [PIXGDP_W(t) * e(z,t)];
5087   
5088  *==============================================================================
5089  * 5.3.8 Dynamic equations
5090  *==============================================================================
5091   EQ94(z,t)..
5092      IT(z,t) =e= PK(z,t) * SUM[(k,j)$KDO(k,j,z), IND(k,j,z,t)];
5093   
5094   EQ95(z,t)..
5095      PK(z,t) =e= 1 / A_K(z) * PROD[i$gamma_INV(i,z), (PC(i,z,t) / gamma_INV(i,z))**gamma_INV(i,z)];
5096   
5097   EQ96(k,bus,z,t)$KDO(k,bus,z)..
5098      IND(k,bus,z,t) =e= phi(z,t) * [R(k,bus,z,t) / U(z,t)]**sigma_INV(k,bus,z) * (KD(k,bus,z,t));
5099   
5100   EQ97a(z,t)..
5101      IR(z,t) =e= {SUM[(k,j)$KDO(k,j,z), R(k,j,z,t) * (KD(k,j,z,t))] - DEP(z,t)} /
5102                  {PK(z,t) * SUM[(k,j)$KDO(k,j,z), (KD(k,j,z,t))]};
5103   
5104   EQ97b(z,t)..
5105      U(z,t) =e= PK(z,t) * (delta(z) + IR(z,t));
5106   
5107  *==============================================================================
5108  * 5.3.9 Other
5109  *==============================================================================
5110   WALRAS(z,t)..
5111      LEON(z,t) =e= Q('01_AGRICULT',z,t) - C('01_AGRICULT',z,t) - CG('01_AGRICULT',z,t) - INV('01_AGRICULT',z,t) - DIT('01_AGRICULT',z,t);
5112   
5113  *================================================================================
5114  * 6 Labour Supply
5115  *================================================================================
5116   EQ106(z,t)..
5117      LS(z,t) =e= LST(z,t) * ((W(z,t) / PIXCON(z,t)) / (W_lag(z,t) / PIXCON_lag(z,t)))**elasLS(z);
5118   
5119  *==============================================================================
5120  * 7 PERMIT
5121  *==============================================================================
5122   EQ107(j,z,t)..
5123      PERMIT(j,z,t) =e= SUM(ene, CO2FACTOR2(ene,j,z,t) * DE(ene,j,z,t));
5124   
5125   EQ108(z,t)..
5126      PERMIT_TOTAL(z,t) =e= SUM(j, PERMIT(j,z,t)) - QDAC(z,t) * switchDAC(z,t);
5127   
5128   EQ_NEA_Cap(t)..
5129      SUM(NEA, PERMIT_TOTAL(NEA, t)) =e= S4_PERMIT(t)/10000;
5130   
5131  EQ_NEA_Price_Sync(NEA, t)..
5132      CTAX(NEA, t) =e= NEA_REGIONAL_CTAX(t);
5133   
5134  EQ_Independent_Cap(PERMITOTH, t)..
5135      PERMIT_TOTAL(PERMITOTH, t) =e= S3_EMISSIONS(PERMITOTH, t)/10000;
5136   
5137  *==============================================================================
5138  * 8 Carbon Tax Revenue Recycling
5139  *==============================================================================
5140  EQ109(z,t)..
5141      REBATE(z,t) =e= TCTAX(z,t) + [(S3_EMISSIONS(z, t)/10000- PERMIT_TOTAL(z, t)) * NEA_REGIONAL_CTAX(t)]$NEA(Z);
5142   
5143   EQ110(j,z,t)..
5144      TIW_Share(j,z,t) =e= LD(j,z,t) / SUM(jj, LD(jj,z,t));
5145   
5146   EQ111(j,z,t)..
5147      LaborRebate(j,z,t) =e= TIW_Share(j,z,t) * TCTAX(z,t) * recycle_labor(z,t);
5148   
5149  *==============================================================================
5150  * 9 DAC
5151  *==============================================================================
5152   EQ118(z,t)..
5153      QDAC(z,t) =e= DAC_MAX(z) * DAC_growth_rate(z,t) * switchDAC(z,t);
5154   
5155   EQ_OBJ..
5156      OBJ =e= 1.0;
5157   
5158  *==============================================================================
5159  * 10 TSF Equations - CES
5160  *==============================================================================
5161   EQ_PP_GRN(BS, Z_GRN, t)..
5162      PP(BS, Z_GRN, t) * XST(BS, Z_GRN, t) =e= PVAT(BS, Z_GRN, t) * VAT(BS, Z_GRN, t)
5163                                             + PCI(BS, Z_GRN, t) * CI(BS, Z_GRN, t)
5164                                             + PCE(BS, Z_GRN, t) * CE(BS, Z_GRN, t);
5165   
5166   EQ_VA_GRN(BS, Z_GRN, t)..
5167      VA(BS, Z_GRN, t) =e= VAT(BS, Z_GRN, t)
5168                         * (beta_VAT(BS, Z_GRN) * PVAT(BS, Z_GRN, t) / PVA(BS, Z_GRN, t))**sigma_VAT(BS, Z_GRN)
5169                         * (B_VAT_t(BS, Z_GRN, t))**(sigma_VAT(BS, Z_GRN) - 1);
5170   
5171   EQ_VAT_REQ(BS, Z_GRN, t)..
5172      VAT(BS, Z_GRN, t) =e= v_vat(BS, Z_GRN) * XST(BS, Z_GRN, t);
5173   
5174  EQ_PVAT(BS, Z_GRN, t)..
5175      PVAT(BS, Z_GRN, t) * VAT(BS, Z_GRN, t) =e= PVA(BS, Z_GRN, t) * VA(BS, Z_GRN, t)
5176                                               + PTSF(BS, Z_GRN, t) * TSFD(BS, Z_GRN, t);
5177   
5178   EQ_TSFD(BS, Z_GRN, t)..
5179      TSFD(BS, Z_GRN, t) =e= VAT(BS, Z_GRN, t)
5180                           * ((1 - beta_VAT(BS, Z_GRN)) * PVAT(BS, Z_GRN, t) / PTSF(BS, Z_GRN, t))**sigma_VAT(BS, Z_GRN)
5181                           * (B_VAT_t(BS, Z_GRN, t))**(sigma_VAT(BS, Z_GRN) - 1);
5182   
5183   EQ_TSFMKT(BS, Z_GRN, t)..
5184      TSFS(BS, Z_GRN, t) =e= TSFD(BS, Z_GRN, t);
5185   
5186  * ===================================================================
5187  * 11. Terms of Trade (ToT) Equations (Bilateral World Prices)
5188  * ===================================================================
5189   EQ_PX_INDEX(z,t)..
5190      PX_INDEX(z,t) =e= SUM((i,zj)$VFOB0(i,z,zj), W_EXP(i,z,zj) * (PWX(i,z,zj,t) / PWX0(i,z,zj)));
5191   
5192   EQ_PM_INDEX(z,t)..
5193      PM_INDEX(z,t) =e= SUM((i,zj)$VCIF0(i,zj,z), W_IMP(i,zj,z) * ( (PWM(i,zj,z,t) + SUM(ij, PWMG(ij,t) * tmrg(ij,i,zj,z))) / PCIF0(i,zj,z) ));
5194   
5195   EQ_TOT(z,t)..
5196      TOT(z,t) * PM_INDEX(z,t) =e= PX_INDEX(z,t);
5197   
5198  *==============================================================================
5199  * 6 Numerical resolution to compute A_VA, sh0, G, G_REAL and IND
5200  *==============================================================================
5201  option cns = conopt4;
5202  *option cns = path;
5203  *option cns = minos;
5204  *option nlp = conopt4;
5205   
5206  *option iterlim = 0;
5207  *option limrow = 100, limcol = 100;
5208  *option conopt4.TolPiv = 1e-6;
5209  *option iterlim = 100;
5210  *option reslim = 1000;
5211  *option lmmxsf = t ;
5212  *Eliminating display of solution makes it easier to check whether model solves
5213  *and to identify year when it crashes.
5214  *option profile=1;
5215  *option profile=3;
5216  *option profiletol=10;
5217   
5218  *Fast solve option
5219  option profile=0;
5220  option limrow=0, limcol=0, solprint = off;
5359   K_idle.fx(k,j,z,time)        = 0;
