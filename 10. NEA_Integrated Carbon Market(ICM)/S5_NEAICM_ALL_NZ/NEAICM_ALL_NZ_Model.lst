4094   EGINucGWh('19_eNuclear',z) = ElecNucGWh('19_eNuclear',z) / DSO_J('19_eNuclear',z);
4095   EGICoalGWh('20_eCoal',z)   = ElecCoalGWh('20_eCoal',z) / DSO_J('20_eCoal',z);
4096   EGIGasGWh('21_eGas',z)     = ElecGasGWh('21_eGas',z) / DSO_J('21_eGas',z);
4097   EGIOilGWh('22_eOil',z)     = ElecOilGWh('22_eOil',z) / DSO_J('22_eOil',z);
4098   EGIWindGWh('23_eWind',z)   = ElecWindGWh('23_eWind',z) / DSO_J('23_eWind',z);
4099   EGISolarGWh('24_eSolar',z) = ElecSolarGWh('24_eSolar',z) / DSO_J('24_eSolar',z);
4100   EGIHydroGWh('25_eHydro',z) = ElecHydroGWh('25_eHydro',z) / DSO_J('25_eHydro',z);
4101   EGIWasteGWh('26_eOther',z) = ElecWasteGWh('26_eOther',z) / DSO_J('26_eOther',z);
4102   EGIBioGWh('26_eOther',z)   = ElecBioGWh('26_eOther',z) / DSO_J('26_eOther',z);
4103   EGIGeoGWh('26_eOther',z)   = ElecGeoGWh('26_eOther',z) / DSO_J('26_eOther',z);
4104   EGIOtherGWh('26_eOther',z) = ElecOtherGWh('26_eOther',z) / DSO_J('26_eOther',z);
