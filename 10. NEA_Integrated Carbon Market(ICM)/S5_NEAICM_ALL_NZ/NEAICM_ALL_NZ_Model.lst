3998  *==============================================================================
3999  *  4.12 CO2FACTOR and CTAX
4000  *==============================================================================
4001  Parameters
4002   CO2_Energy(ene,j,z)        CO2 emissions from Energy
4003  ;
4004   
4005   CO2_Energy('02_COAL',j,z) = sum(p_coal,CO2IO(p_coal,j,z));
4006   CO2_Energy('03_OIL',j,z)  = sum(p_oil,CO2IO(p_oil,j,z));
4007   CO2_Energy('04_GAS',j,z)  = sum(p_gas,CO2IO(p_gas,j,z));
4008   CO2_Energy('10_PETROLCOAL',j,z)  = sum(p_oilproduct,CO2IO(p_oilproduct,j,z));
4009   
4010  Parameters
4011   CO2FACTOR(ene,j,z)       CO2 emissions factor (tCO2 per 100$)
4012   CO2FACTOR2(ene,j,z,time) Time series CO2 emissions factor (tCO2 per 100$)
4013  ;
4014   
4015   CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*(1000/(10**8));
4016   CO2FACTOR('03_OIL',j,z)$DEO('03_OIL',j,z)   = [sum(p_oil,CO2IO(p_oil,j,z))/DEO('03_OIL',j,z)]*(1000/(10**8));
4017   CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z)   = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*(1000/(10**8));
4018   CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*(1000/(10**8));
4019   
4020  Parameters
4021  Global_CO2FACTOR(ene,j)       Global Average CO2 emissions factor (tCO2 per 100$)
4022  ;
4023   
4024   Global_CO2FACTOR('02_COAL',j)            = [sum((p_coal,z),CO2IO(p_coal,j,z))/sum(z,DEO('02_COAL',j,z))]*(1000/(10**8));
4025   Global_CO2FACTOR('03_OIL',j)               = [sum((p_oil,z),CO2IO(p_oil,j,z))/sum(z,DEO('03_OIL',j,z))]*(1000/(10**8));
4026   Global_CO2FACTOR('04_GAS',j)              = [sum((p_gas,z),CO2IO(p_gas,j,z))/sum(z,DEO('04_GAS',j,z))]*(1000/(10**8));
4027   Global_CO2FACTOR('10_PETROLCOAL',j) = [sum((p_oilproduct,z),CO2IO(p_oilproduct,j,z))/sum(z,DEO('10_PETROLCOAL',j,z))]*(1000/(10**8));
4028   
      *MNG
      CO2FACTOR('02_COAL','31_SER','05_MNG')        = 2;
       
      *PRK
       CO2FACTOR('02_COAL','01_AGRICULT','06_PRK')        = CO2FACTOR('02_COAL','01_AGRICULT','05_MNG');
       CO2FACTOR('10_PETROLCOAL','01_AGRICULT','06_PRK')  = CO2FACTOR('10_PETROLCOAL','01_AGRICULT','05_MNG');
       CO2FACTOR('02_COAL','28_LTRP','06_PRK')            = CO2FACTOR('02_COAL','28_LTRP','05_MNG');
       CO2FACTOR('02_COAL','17_OTHERIND','06_PRK')        = CO2FACTOR('02_COAL','17_OTHERIND','05_MNG');
       
      *RUS
       CO2FACTOR('02_COAL','08_WOODPRO','04_RUS')    = CO2FACTOR('02_COAL','08_WOODPRO','10_EEU');
       CO2FACTOR('04_GAS','17_OTHERIND','04_RUS')      = SMAX(j$(not sameas(j, '17_OTHERIND')), CO2FACTOR('04_GAS', j, '04_RUS'));
       
      *LAM
       CO2FACTOR('04_GAS','02_COAL','08_LAM')             = CO2FACTOR('04_GAS','02_COAL','07_NAM');
       
      * CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) gt 10) = 10 ;
4048   
4049  CO2FACTOR(ene, j, z)$(
4050      not sameas(j, '13_IRONSTL') and
4051      not sameas(j, '20_eCoal') and
4052      not sameas(j, '21_eGas') and
4053      not sameas(j, '22_eOil')
4054  ) = MIN(CO2FACTOR(ene, j, z), Global_CO2FACTOR(ene, j));
4055   
4056  *Otherind Sector
4057   CO2FACTOR('02_COAL','17_OTHERIND',Z)$DEO('02_COAL','17_OTHERIND',z) = Global_CO2FACTOR('02_COAL','20_eCoal');
4058   CO2FACTOR('03_OIL','17_OTHERIND',Z)$DEO('03_OIL','17_OTHERIND',z) = Global_CO2FACTOR('03_OIL','03_OIL');
4059   CO2FACTOR('04_GAS','17_OTHERIND',Z)$DEO('04_GAS','17_OTHERIND',z) = Global_CO2FACTOR('04_Gas','21_eGas');
4060   CO2FACTOR('10_PETROLCOAL','17_OTHERIND',Z)$DEO('10_PETROLCOAL','17_OTHERIND',z) = Global_CO2FACTOR('10_PETROLCOAL','22_eOil');
4061   
4062   CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) lt 0) = 0.1 ;
4063   
4064   CO2FACTOR('02_COAL','20_eCoal','06_PRK') = CO2FACTOR('02_COAL','20_eCoal','05_MNG') ;
4065   
4066   CO2FACTOR('10_PETROLCOAL','22_eOil','06_PRK') = CO2FACTOR('10_PETROLCOAL','22_eOil','05_MNG') ;
4067   
4068   CO2FACTOR2(ene,j,z,time) = CO2FACTOR(ene,j,z);
4069   
4070  *===========
4071  * Coal 2.7tCO2 per 100$
4072  * CO2FACTOR2('02_COAL',j,z,time)$CO2FACTOR('02_COAL',j,z)           = 2.7 ;
4073  * Gas 1.8tCO2 per 100$
4074  * CO2FACTOR2('04_GAS',j,z,time)$CO2FACTOR('04_GAS',j,z)             = 0.67;
4075  * Oilrproduct  0.6tCO2 per 100$
4076  * CO2FACTOR2('10_PETROLCOAL',j,z,time)$CO2FACTOR('10_PETROLCOAL',j,z) = 0.67;
