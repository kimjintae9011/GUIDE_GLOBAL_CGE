1040   
1041  *===============================================================================
1042  * Elasticity Parameter Assignments
1043  *===============================================================================
1044  *CES - KLE(backstop)
1045   sigma_KLE(BS,z)          = 0.5;
1046   sigma_KLE('16_TRANSEQ','07_NAM') = 0.5 ;
1047   
1048  * CES - composite K-L
1049   sigma_VA('10_PETROLCOAL',z) = 0.2;
1050   sigma_VA('18_TnD',z)        = 0.2;
1051   sigma_VA('19_eNuclear',z)   = 0.2;
1052   sigma_VA('20_eCoal',z)      = 0.2;
1053   sigma_VA('21_eGas',z)       = 0.2;
1054   sigma_VA('22_eOil',z)       = 0.2;
1055   sigma_VA('23_eWind',z)      = 0.2;
1056   sigma_VA('24_eSolar',z)     = 0.2;
1057   sigma_VA('25_eHydro',z)     = 0.2;
1058   sigma_VA('26_eOther',z)     = 0.2;
1059   sigma_VA(BS,z)              = 0.5;
1060   
1061  * CES - composite capital
1062    sigma_KD(j,z)        = 2 * sigma_VA(j,z);
1063    sigma_KD(BS,Z)     = 0.5;
1064   
1065  * CES - composite labor
1066    sigma_LD(j,z)        = 2 * sigma_VA(j,z);
1067    sigma_LD(BS,Z)     = 0.5;
1068   
1069  * CES - composite ENER
1070   sigma_ENER_elec(j2,z)         = 1.5;
1071   sigma_ENER_nelec(j2,z)       = 0.5;
1072   sigma_ENER_coalgas(j2,z)    = 2.0;
1073   sigma_ENER_oilprod(j2,z)     = 0.5;
1074   
1075  * CES - DOM vs.IMP
1076   sigma_M1('03_OIL','06_PRK') = 0.5;
1077   sigma_M1('04_GAS',Z) = 6;
1078   sigma_M1('11_CHEMICAL','05_MNG') = 1.5;
1079   sigma_M1('13_IRONSTL','05_MNG') = 1.1;
1080   
1081  * CES - IMP sourcing
1082   sigma_M2('03_OIL',Z) = 2;
1083   sigma_M2('04_GAS',Z) = 2;
1084   
1085  *CET - exports and local sales
1086   sigma_X0(j,z)                 = 1.5;
1087   
1088  * CET - total output
1089   sigma_X2(i,z)                 = 2;
1090   
1091  * CES - composite Power sector
1092   sigma_X4(z)              = 2.5;
1093   sigma_X4('07_NAM')       = 1.5;
1094   sigma_X4('09_WEU')       = 1.5;
1095  * sigma_X4('16_PAS')      = 0.5;
1096   sigma_X4('06_PRK')       = 0.5;
1097   
1098  * CES - composite BS sector
1099   sigma_BS(BS, Z_GRN)       = 5;
1100   sigma_BS(BS, '07_NAM')    = 5;
1101   sigma_BS(BS, '09_WEU')    = 5;
1102   
1103  * sigma_VAT(BS,Z_GRN)   = 1.5;
1104  sigma_VAT('32_BSCHEMICAL',Z_GRN)   = 0.5;
1105  sigma_VAT('33_BSNONMET',Z_GRN)     = 0.5;
1106  sigma_VAT('34_BSIRONSTL',Z_GRN)     = 0.5;
1107  sigma_VAT('35_BS_LTRP',Z_GRN)         = 0.5;
1108  sigma_VAT('36_BS_WTRP',Z_GRN)        = 0.5;
1109  sigma_VAT('37_BS_ATRP',Z_GRN)         = 0.5;
1110   
1111  * Investment demand elasticity
1112   sigma_INV(k,j,z)              = 0.5;
1113   
1114  * LES parameters - Frisch all (1.1)
1115  * frisch(z)                     = PARZ(z,'frisch');
1116  frisch('01_KOR') = -1.30;
1117  frisch('02_CHN') = -1.45;
1118  frisch('03_JPN') = -1.25;
1119  frisch('04_RUS') = -1.45;
1120  frisch('05_MNG') = -1.70;
1121  frisch('06_PRK') = -2.00;
1122  frisch('07_NAM') = -1.20;
1123  frisch('08_LAM') = -1.50;
1124  frisch('09_WEU') = -1.20;
1125  frisch('10_EEU') = -1.40;
1126  frisch('11_FSU') = -1.60;
1127  frisch('12_MEA') = -1.60;
1128  frisch('13_AFR') = -1.90;
1129  frisch('14_CPA') = -1.70;
1130  frisch('15_SAS') = -1.80;
1131  frisch('16_PAS') = -1.50;
1132  frisch('17_PAO') = -1.20;
1133   
1134  * Labour supply
1135   elasLS(z)                     = 0.1;
1136   
1137  *==============================================================================
1138  * Rescaling
1139  *==============================================================================
1140  * GTAP data are in millions of US dollars With RES = 10000, model results are in tens of billions (10G$)
1141   RES = 10000;
1142   CO(i,z)          = CO(i,z) / RES;
1143   CGO(i,z)         = CGO(i,z) / RES;
1144   DDO(i,z)         = DDO(i,z) / RES;
1145   DEPO(z)          = DEPO(z) / RES;
1146   DIO(i,j,z)       = DIO(i,j,z) / RES;
1147   DSO(j,i,z)       = DSO(j,i,z) / RES;
1148   DSO_I(i,z)       = DSO_I(i,z) / RES;
1149   EXO(i,z,zj)      = EXO(i,z,zj) / RES;
1150   IMO(i,z,zj)      = IMO(i,z,zj) / RES;
1151   INVO(i,z)        = INVO(i,z) / RES;
1152   KSTO(z)          = KSTO(z) / RES;
1153   LDO(j,z)         = LDO(j,z) / RES;
1154   MRGNO(i,z)       = MRGNO(i,z) / RES;
1155   RKDO(k,j,z)      = RKDO(k,j,z) / RES;
1156   TDHO(z)          = TDHO(z) / RES;
1157   TICO(i,z)        = TICO(i,z) / RES;
1158   TIKO(k,j,z)      = TIKO(k,j,z) / RES;
1159   TIMO(i,z,zj)     = TIMO(i,z,zj) / RES;
1160   TIPO(j,z)        = TIPO(j,z) / RES;
1161   TIWO(j,z)        = TIWO(j,z) / RES;
1162   TIXO(i,z,zj)     = TIXO(i,z,zj) / RES;
1163   tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj) / RES;
1164   XSO_I(i,z)       = XSO_I(i,z) / RES;
1165   XSO(j,i,z)       = XSO(j,i,z) / RES;
1166   XSTO(j,z)        = XSTO(j,z) / RES;
1167   
1168  *==============================================================================
1169  * [NEW] Backstop Technology Split & TSF Initialization (Upstream Injection)
1170  *==============================================================================
1171  PARAMETER
1172   seed(j)                Initial share of the new technology
1173   TSFO(j, z)             Initial year TSF input for backstop (Value)
1174   PTSFO(j, z)            Initial year TSF price for backstop
1175   Green_Markup(j, z)     Initial efficiency penalty for backstop
1176   SHR_MRGN(j, i, z)      Share of international transport margin for sector j !! [Added] Margin distribution share
1177  ;
1178   
1179  seed(BS) = 0.01;
1180  PTSFO(BS, Z_GRN) = 1.0;
1181  Green_Markup(BS, Z_GRN) = 1.0;
1182   
1183  * [Added] Initialize default margin share to 1.0 (100%) for all industries before splitting
1184  SHR_MRGN(j, i, z)$XSO(j, i, z) = 1.0;
1185   
1186  LOOP(Z_GRN,
1187  *--------------------------------------------------------------------------
1188  * [1] Split raw data by seed share and preserve identities
1189  *--------------------------------------------------------------------------
1190    LOOP(MAP_BS(j, jj, i),
1191  * Allocate to backstop industry
1192      LDO(j, Z_GRN)       = LDO(jj, Z_GRN) * seed(j);
1193      RKDO(k, j, Z_GRN)   = RKDO(k, jj, Z_GRN) * seed(j);
1194      TIPO(j, Z_GRN)      = TIPO(jj, Z_GRN) * seed(j);
1195      TIWO(j, Z_GRN)      = TIWO(jj, Z_GRN) * seed(j);
1196      TIKO(k, j, Z_GRN)   = TIKO(k, jj, Z_GRN) * seed(j);
1197      DIO(ii, j, Z_GRN)   = DIO(ii, jj, Z_GRN) * seed(j);
1198      EMPLOY(j, Z_GRN)    = EMPLOY(jj, Z_GRN) * seed(j);
1199   
1200      XSO(j, i, Z_GRN)    = (XSO(jj, i, Z_GRN) * seed(j)) / Green_Markup(j, Z_GRN);
1201      XSTO(j, Z_GRN)      = (XSTO(jj, Z_GRN) * seed(j)) / Green_Markup(j, Z_GRN);
1202      DSO(j, i, Z_GRN)    = (DSO(jj, i, Z_GRN) * seed(j)) / Green_Markup(j, Z_GRN);
1203   
1204  * [Added] Allocate international margin share to backstop industry by seed share
1205      SHR_MRGN(j, i, Z_GRN) = seed(j);
1206   
1207  * Deduct exact share from conventional industry
1208      LDO(jj, Z_GRN)      = LDO(jj, Z_GRN) * (1 - seed(j));
1209      RKDO(k, jj, Z_GRN)  = RKDO(k, jj, Z_GRN) * (1 - seed(j));
1210      TIPO(jj, Z_GRN)     = TIPO(jj, Z_GRN) * (1 - seed(j));
1211      TIWO(jj, Z_GRN)     = TIWO(jj, Z_GRN) * (1 - seed(j));
1212      TIKO(k, jj, Z_GRN)  = TIKO(k, jj, Z_GRN) * (1 - seed(j));
1213      DIO(ii, jj, Z_GRN)  = DIO(ii, jj, Z_GRN) * (1 - seed(j));
1214      EMPLOY(jj, Z_GRN)   = EMPLOY(jj, Z_GRN) * (1 - seed(j));
1215   
1216      XSO(jj, i, Z_GRN)   = XSO(jj, i, Z_GRN) * (1 - seed(j));
1217      XSTO(jj, Z_GRN)     = XSTO(jj, Z_GRN) * (1 - seed(j));
1218      DSO(jj, i, Z_GRN)   = DSO(jj, i, Z_GRN) * (1 - seed(j));
1219   
1220  * [Added] Deduct international margin share from conventional industry (remaining share)
1221      SHR_MRGN(jj, i, Z_GRN) = 1.0 - seed(j);
1222    );
1223   
1224  *--------------------------------------------------------------------------
1225  * [2] Technology Specific Factor (TSF) Allocation
1226  *--------------------------------------------------------------------------
1227    LOOP(BS,
1228      TSFO(BS, Z_GRN) = (RKDO('cap', BS, Z_GRN) * 0.9) / PTSFO(BS, Z_GRN);
1229      RKDO('cap', BS, Z_GRN) = RKDO('cap', BS, Z_GRN) - (PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN));
1230    );
1231  );
1232   
1233  * Calculate initial values for TSF intensity and time series
1234  LOOP(BS,
1235    v_tsf(BS, Z_GRN)      = TSFO(BS, Z_GRN) / XSTO(BS, Z_GRN);
1236    TSFS(BS, Z_GRN, time) = TSFO(BS, Z_GRN);
1237  );
1238   
1239  *==============================================================================
1240  * 3.3 Exogenous prices and parameters
1241  *==============================================================================
1242   eta                = 1;
1243   ttdh0O(z)       = 0;
1244   eO(z)             = 1;
1245   PEO(i,z,zj)      = 1;
1246   PLO(i,z)          = 1;
1247   PWMGO(i)      = 1;
1248   WO(z)            = 1;
1249   WO_lag(z)      = WO(z);
1250   
1251  * -------------------------------------------------------------------
1252  * [동태 모형 고도화] 유령 산업에 초소형 정상 구조(Micro-Seed) 주입
1253  * -------------------------------------------------------------------
1254  SCALAR micro_tol / 0.01 /;
1255   
1256  * 1. 필터링을 위해 임시 PPO(가격 왜곡도)를 먼저 계산
1257  PARAMETER PPO_TEMP(j,z);
1258  PPO_TEMP(j,z)$XSTO(j,z) = ( TIWO(j,z) + WO(z)*LDO(j,z)
1259                            + SUM(k, TIKO(k,j,z) + RKDO(k,j,z))
1260                            + SUM(i, DIO(i,j,z)) ) / XSTO(j,z);
1261   
1262  * 2. [수정됨] 생산량이 적거나(XSTO < 0.01) OR 가격 왜곡이 극심한 경우(PPO > 2.0) 모두 포함
1263  LOOP((j,z)$( ( (XSTO(j,z) < micro_tol) or (PPO_TEMP(j,z) > 2.0) )
1264               and (PPO_TEMP(j,z) > 1.2 or PPO_TEMP(j,z) < 0.8)
1265               and not (BS(j) and Z_OTH(z)) ),
1266   
1267  * 3. 생산량(XSTO)이 너무 작으면 최소 Seed로 덮어쓰고, 어느 정도 있으면 그 규모 유지
1268      XSTO(j,z) = MAX(XSTO(j,z), 1E-5);
1269   
1270  * 4. 중국(02_CHN)의 동일 산업(j) 투입 구조 비율을 이식
1271      LDO(j,z)    = XSTO(j,z) * (LDO(j,'02_CHN') / XSTO(j,'02_CHN'));
1272      TIWO(j,z)   = XSTO(j,z) * (TIWO(j,'02_CHN') / XSTO(j,'02_CHN'));
1273      TIPO(j,z)   = XSTO(j,z) * (TIPO(j,'02_CHN') / XSTO(j,'02_CHN'));
1274   
1275      LOOP(k,
1276          RKDO(k,j,z) = XSTO(j,z) * (RKDO(k,j,'02_CHN') / XSTO(j,'02_CHN'));
1277          TIKO(k,j,z) = XSTO(j,z) * (TIKO(k,j,'02_CHN') / XSTO(j,'02_CHN'));
1278      );
1279   
1280      LOOP(i,
1281          DIO(i,j,z)  = XSTO(j,z) * (DIO(i,j,'02_CHN') / XSTO(j,'02_CHN'));
1282      );
1283  );
1284   
1285  *==============================================================================
1286  * Calibration
1287  *==============================================================================
1288   YHKO(z)          = SUM[(k,j), RKDO(k,j,z)];
1289   YHLO(z)          = SUM[(j), LDO(j,z)];
1290   YHO(z)           = YHLO(z) + YHKO(z) + SUM[BS, PTSFO(BS,z) * TSFO(BS,z)];
1291   YDHO(z)          = YHO(z) - TDHO(z);
1292   CTHO(z)          = SUM[i, CO(i,z)];
1293   SHO(z)           = YDHO(z) - CTHO(z);
1294   TICTO(z)         = SUM[i, TICO(i,z)];
1295   TIMTO(z)         = SUM[(i,zj), TIMO(i,zj,z)];
1296   TIWTO(z)         = SUM[(j), TIWO(j,z)];
1297   TIKTO(z)         = SUM[(k,j), TIKO(k,j,z)];
1298   TIPTO(z)         = SUM[j, TIPO(j,z)];
1299   TIXTO(z)         = SUM[(i,zj), TIXO(i,z,zj)];
1300   TPRODNO(z)       = TIKTO(z) + TIWTO(z) + TIPTO(z);
1301   TPRCTSO(z)       = TICTO(z) + TIMTO(z) + TIXTO(z);
1302   YGO(z)           = TDHO(z) + TPRCTSO(z) + TPRODNO(z);
1303   GO(z)            = SUM[i, CGO(i,z)];
1304   SGO(z)           = YGO(z) - GO(z);
1305   YROWO(z)         = SUM[(i,zj), IMO(i,zj,z)] + SUM[(i,ij,zj), tmrg(i,ij,zj,z)];
1306   SROWO(z)         = YROWO(z) - SUM[(i,zj), EXO(i,z,zj)] - SUM[i, MRGNO(i,z)];
1307   CABO(z)          = -SROWO(z);
1308   ITO(z)           = SHO(z) + SGO(z) + SROWO(z);
1309   
1310  *==============================================================================
1311  * Calibration of parameters and other variables
1312  *==============================================================================
1313   gamma_GVT(i,z)   = CGO(i,z) / SUM[ij, CGO(ij,z)];
1314   gamma_INV(i,z)   = INVO(i,z) / SUM[ij, INVO(ij,z)];
1315   
1316  *==============================================================================
1317  * Calibration of other prices and revised volumes (part 1)
1318  *==============================================================================
1319   LDO(j,z)         = LDO(j,z) / WO(z);
1320   LDCO(j,z)        = LDO(j,z);
1321   LSO(z)           = SUM[j, LDO(j,z)];
1322   LSTO(z)          = LSO(z);
1323   LSO_lag(z)       = LSO(z);
1324   LSTO_lag(z)      = LSO(z);
1325   EXO(i,z,zj)      = [EXO(i,z,zj) - TIXO(i,z,zj)] / PEO(i,z,zj);
1326   EXTO(i,z)        = SUM[zj, EXO(i,z,zj)];
1327   PWXO(i,z,zj)$EXO(i,z,zj)
1328                    = { [PEO(i,z,zj) * EXO(i,z,zj) + TIXO(i,z,zj)] / EXO(i,z,zj) } / eO(z);
1329   PETO(i,z)        = SUM[zj, PEO(i,z,zj) * EXO(i,z,zj)] / EXTO(i,z);
1330   PWMO(i,z,zj)     = PWXO(i,z,zj);
1331   IMO(i,zj,z)      = EXO(i,zj,z);
1332   IMTO(i,z)        = SUM[zj, IMO(i,zj,z)];
1333   
1334   DSO(j,i,z)       = DSO(j,i,z) / PLO(i,z);
1335   DSO_I(i,z)       = SUM(j, DSO(j,i,z));
1336   DSO_J(j,z)       = SUM(i, DSO(j,i,z));
1337   QO(i,z)          = IMTO(i,z) + DDO(i,z);
1338   MRGNO(i,z)$MRGNO(i,z)
1339                    = MRGNO(i,z) / [eO(z) * PWMGO(i)];
1340   XSO_I(i,z)       = EXTO(i,z) + DDO(i,z) + MRGNO(i,z);
1341   
1342   XSTO(j,z)        = SUM(i, XSO(j,i,z));
1343   PO(i,z)          = [ PETO(i,z) * EXTO(i,z) + PLO(i,z) * DSO_I(i,z)
1344                      + eO(z) * PWMGO(i) * MRGNO(i,z) ] / XSO_I(i,z);
1345   PO2(j,i,z)$XSO(j,i,z)                  = 1;
1346   PO2(BS,I_BS,Z_GRN) = Green_Markup(BS,Z_GRN);
1347   
1348   PO3(i,j,z)$XSO(j,i,z)                  = 1;
1349   
1350   PIO(i,z)         = SUM[j$XSO(j,i,z), PO2(J,I,z) * XSO(j,i,z)] / XSO_I(i,z);
1351   
1352   PTO(j,z)$XSTO(j,z) = SUM[i$XSO(j,i,z), PO2(j,i,z) * XSO(j,i,z)] / XSTO(j,z);
1353   
1354   PPO(j,z)$XSTO(j,z)
1355      = ( TIWO(j,z) + WO(z) * LDO(j,z)
1356        + SUM[k, TIKO(k,j,z) + RKDO(k,j,z)]
1357        + (PTSFO(j,z) * TSFO(j,z))$BS(j)
1358        + SUM[nene, DIO(nene,j,z)]
1359        + SUM[ene, DIO(ene,j,z)] ) / XSTO(j,z);
1360   
1361  * ==============================================================================
1362   
1363   theta2(j,i,z)    = DSO(j,i,z) / SUM(jj, DSO(jj,i,z));
1364   
1365   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z) * EXTO(i,z);
1366   
1367  *==============================================================================
1368  * Calibration of tax rates, margins, prices and volumes
1369  *==============================================================================
1370   ttixO(i,z,zj)    = [eO(z) * PWXO(i,z,zj) / PEO(i,z,zj)] - 1;
1371   tticO(i,z)       = TICO(i,z) /
1372                      { PLO(i,z) * DDO(i,z)
1373                      + SUM[zj, IMO(i,zj,z) * eO(z) * PWMO(i,zj,z)
1374                      + TIMO(i,zj,z) + SUM[ij, tmrg(ij,i,zj,z)]] };
1375   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
1376                    = tmrg(i,ij,zj,z) / (PWMGO(i) * eO(z) * IMO(ij,zj,z));
1377   ttimO(i,zj,z)$IMO(i,zj,z)
1378                    = TIMO(i,zj,z) /
1379                      { IMO(i,zj,z) * eO(z) * (PWMO(i,zj,z)
1380                      + SUM[ij, PWMGO(ij) * tmrg(ij,i,zj,z)]) };
1381   ttiwO(j,z)$LDO(j,z)
1382                    = TIWO(j,z) / [WO(z) * LDO(j,z)];
1383   ttikO(k,j,z)$RKDO(k,j,z)
1384                    = TIKO(k,j,z) / RKDO(k,j,z);
1385   ttipO(j,z)$XSTO(j,z) = [PTO(j,z) / PPO(j,z)] - 1;
1386   
1387   ttdh1O(z)        = [TDHO(z) - ttdh0O(z)] / YHO(z);
1388   
1389  *==============================================================================
1390  * Calibration of other prices and revised volumes (part 2)
1391  *==============================================================================
1392   PDO(i,z)         = PLO(i,z) * (1 + tticO(i,z));
1393   PMO(i,zj,z)      = eO(z) * (PWMO(i,zj,z) + SUM[ij, PWMGO(ij) * tmrg(ij,i,zj,z)])
1394                    * (1 + ttimO(i,zj,z)) * (1 + tticO(i,z));
1395   PMTO(i,z)        = SUM[zj, PMO(i,zj,z) * IMO(i,zj,z)] / IMTO(i,z);
1396   PCO(i,z)         = [PMTO(i,z) * IMTO(i,z) + PDO(i,z) * DDO(i,z)] / QO(i,z);
1397   CO(i,z)          = CO(i,z) / PCO(i,z);
1398   CGO(i,z)         = CGO(i,z) / PCO(i,z);
1399   DIO(nene,j,z)    = DIO(nene,j,z) / PCO(nene,z);
1400   DEO(ene,j,z)     = DIO(ene,j,z) / PCO(ene,z);
1401   
1402   DEelecO(j,z)     = DIO("18_ELEC",j,z) / PCO("18_ELEC",z);
1403   DEnelecO(j,z)    = SUM(ene3, DEO(ene3,j,z));
1404   
1405   DEcoalgasO(j,z)  = SUM(ene5, DEO(ene5,j,z));
1406   DEcoalO(j,z)     = DEO("02_COAL ",j,z);
1407   DEgasO(j,z)      = DEO("04_GAS",j,z);
1408   
1409   DEoilpetrolO(j,z)= SUM(ene6, DEO(ene6,j,z));
1410   DEoilO(j,z)      = DEO("03_OIL",j,z);
1411   DEpetrolO(j,z)   = DEO("10_PETROLCOAL",j,z);
1412   INVO(i,z)        = INVO(i,z) / PCO(i,z);
1413   
1414   CIO(j,z)         = SUM[nene, DIO(nene,j,z)];
1415   CEO(j3,z)        = SUM[ene, DEO(ene,j3,z)];
1416   CEO(j2,z)        = DEelecO(j2,z) + DEnelecO(j2,z);
1417   DITO(nene,z)     = SUM[j, DIO(nene,j,z)];
1418   DITO(ene,z)      = SUM[j, DEO(ene,j,z)];
1419   
1420   PO4(ene,j,z)     = PCO(ene,z);
1421   PCIO(j,z)$XSTO(j,z)
1422                    = SUM[nene, PCO(nene,z) * DIO(nene,j,z)] / CIO(j,z);
1423   
1424   PCEcoalO(j,z)$XSTO(j,z)   = PO4("02_COAL",j,z);
1425   PCEgasO(j,z)$XSTO(j,z)    = PO4("04_GAS",j,z);
1426   PCEoilO(j,z)$XSTO(j,z)    = PO4("03_OIL",j,z);
1427   PCEpetrolO(j,z)$XSTO(j,z) = PO4("10_PETROLCOAL",j,z);
1428   
1429   PCEoilpetrolO(j,z)$XSTO(j,z)
1430      = [ PCEoilO(j,z) * DEoilO(j,z) + PCEpetrolO(j,z) * DEpetrolO(j,z) ] / DEoilpetrolO(j,z);
1431   
1432   PCEcoalgasO(j,z)$XSTO(j,z)
1433      = [ PCEcoalO(j,z) * DEcoalO(j,z) + PCEgasO(j,z) * DEgasO(j,z) ] / DEcoalgasO(j,z);
1434   
1435   PCEnelecO(j,z)$XSTO(j,z)
1436      = [ PCEcoalgasO(j,z) * DEcoalgasO(j,z) + PCEoilpetrolO(j,z) * DEoilpetrolO(j,z) ] / DEnelecO(j,z);
1437   
1438   PCEelecO(j,z)$XSTO(j,z)
1439      = SUM[ene4, PCO(ene4,z) * DEO(ene4,j,z)] / DEelecO(j,z);
1440   
1441   PCEO(j,z)$XSTO(j,z)
1442      = [ PCEelecO(j,z) * DEelecO(j,z) + PCEnelecO(j,z) * DEnelecO(j,z) ] / CEO(j,z);
1443   
1444   PCEO(j3,z)$XSTO(j3,z)
1445      = SUM[ene, PCO(ene,z) * DEO(ene,j3,z)] / CEO(j3,z);
1446   
1447   WTIO(j,z)$XSTO(j,z)       = WO(z) * (1 + ttiwO(j,z));
1448   WCO(j,z)$LDCO(j,z)        = (WTIO(j,z) * LDO(j,z)) / LDCO(j,z);
1449   
1450  *==============================================================================
1451  * Calibration of dynamic parameters
1452  *==============================================================================
1453   PKO(z)           = 1;
1454   KSTO(z)          = KSTO(z) / PKO(z);
1455   KSTO(z)          = KSTO(z) - SUM((BS,Z_GRN)$sameas(z, Z_GRN), PTSFO(BS,Z_GRN) * TSFO(BS,Z_GRN));
1456   
1457   delta(z)         = DEPO(z) / [PKO(z) * KSTO(z)];
1458   
1459   RO(k,j,z)$RKDO(k,j,z)
1460                    = SUM[(kj,jj), RKDO(kj,jj,z)] / KSTO(z);
1461   
1462   KDO(k,j,z)$RKDO(k,j,z)
1463                    = RKDO(k,j,z) / RO(k,j,z);
1464   
1465   KSO(k,z)         = SUM[j, KDO(k,j,z)];
1466   IRO(z)           = { SUM[(k,j)$RKDO(k,j,z), RKDO(k,j,z)] - DEPO(z) } / [PKO(z) * KSTO(z)];
1467   UO(z)            = PKO(z) * (IRO(z) + delta(z));
1468   phiO(z)          = [ITO(z) / PKO(z)] / KSTO(z);
1469   
1470   INDO(k,j,z)$KDO(k,j,z)
1471                    = phiO(z) * KDO(k,j,z);
1472   
1473   A_K(z)           = 1 / PKO(z) * { PROD[i$gamma_INV(i,z), (PCO(i,z) / gamma_INV(i,z))**gamma_INV(i,z)] };
1474   KDCO(j,z)        = SUM[k, KDO(k,j,z)];
1475   RTIO(k,j,z)      = RO(k,j,z) * (1 + ttikO(k,j,z));
1476   
1477   RCO(j,z)$KDCO(j,z)
1478                    = SUM[k, RTIO(k,j,z) * KDO(k,j,z)] / KDCO(j,z);
1479   
1480  *==============================================================================
1481  * Calibration of other prices and revised volumes
1482  *==============================================================================
1483   VAO(j,z)       = LDCO(j,z) + KDCO(j,z);
1484   
1485   PVAO(j,z)$XSTO(j,z)
1486                     = [ WCO(j,z) * LDCO(j,z) + RCO(j,z) * KDCO(j,z) ] / VAO(j,z);
1487   
1488   KLEO(j,z)$XSTO(j,z)  = CEO(j,z) + VAO(j,z);
1489   
1490   PKLEO(j,z)$XSTO(j,z)
1491                      = [PCEO(j,z) * CEO(j,z) + PVAO(j,z) * VAO(j,z)] / KLEO(j,z);
1492   
1493   VATO(BS, Z_GRN)      = VAO(BS, Z_GRN) + TSFO(BS, Z_GRN);
1494   
1495   PVATO(BS, Z_GRN)
1496                      = [PVAO(BS, Z_GRN) * VAO(BS, Z_GRN) + PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN)] / VATO(BS, Z_GRN);
1497   
1498   PIXGDPO(z)           = 1;
1499   PIXGDP_WO          = 1;
1500   PIXCONO(z)           = 1;
1501   PIXCONO_lag(z)     = PIXCONO(z);
1502   PIXINVO(z)            = 1;
1503   PIXGVTO(z)           = 1;
1504   PPOWERO(z)         = 1;
1505   PBSO(BS, Z_GRN)  = 1.0;
1506   
1507  *==============================================================================
1508  * Calibration of LES parameters
1509  *==============================================================================
1510   sigma_Y(i,z)   = sigma_Y(i,z) / { SUM[ij, sigma_Y(ij,z) * PCO(ij,z) * CO(ij,z)] / CTHO(z) };
1511   gamma_LES(i,z) = PCO(i,z) * CO(i,z) * sigma_Y(i,z) / CTHO(z);
1512   CMINO(i,z)     = CO(i,z) + gamma_LES(i,z) * CTHO(z) / {PCO(i,z) * frisch(z)};
1513   
1514  *$Ontext
1515  * ==============================================================================
1516  * [ADDITION] Backup setup of initial values for tracking parameter changes
1517  * ==============================================================================
1518  SET eval_sig "Evaluation items for sigmas" / Initial "Initial value", Final "Final value", Diff "Difference (Change)" /;
1519  SET sig_type "Types of Industry Elasticities" /
1520      s_coalgas "sigma_ENER_coalgas",
1521      s_oilprod "sigma_ENER_oilprod",
1522      s_nelec   "sigma_ENER_nelec",
1523      s_elec    "sigma_ENER_elec",
1524      s_kle     "sigma_KLE"
1525  /;
1526   
1527  PARAMETER Init_sigma_M1(ene,z) "Backup for initial sigma_M1";
1528  PARAMETER Init_sigma_M2(ene,z) "Backup for initial sigma_M2";
1529  PARAMETER Init_sigma_IND(j,z,sig_type) "Backup for initial industry nest sigmas";
1530   
1531  * Store the current (initial) parameter values before entering the loop
1532  Init_sigma_M1(ene,z) = sigma_M1(ene,z);
1533  Init_sigma_M2(ene,z) = sigma_M2(ene,z);
1534  Init_sigma_IND(j,z,'s_coalgas') = sigma_ENER_coalgas(j,z);
1535  Init_sigma_IND(j,z,'s_oilprod') = sigma_ENER_oilprod(j,z);
1536  Init_sigma_IND(j,z,'s_nelec')   = sigma_ENER_nelec(j,z);
1537  Init_sigma_IND(j,z,'s_elec')    = sigma_ENER_elec(j,z);
1538  Init_sigma_IND(j,z,'s_kle')     = sigma_KLE(j,z);
1539   
1540  * ==============================================================================
1541  * Calculation of Economy-Wide Ex-ante Own-Price Elasticities for Energy
1542  * (Industries + Households + Government + Investment + Exports)
1543  * ==============================================================================
1544   
1545  PARAMETERS
1546  * 1. Industry Nest Shares
1547      S_E_KLE(j,z), S_NE_E(j,z), S_Elec_E(j,z)
1548      S_CG_NE(j,z), S_OP_NE(j,z)
1549      S_Coal_CG(j,z), S_Gas_CG(j,z), S_Oil_OP(j,z), S_Petrol_OP(j,z)
1550   
1551  * 2. Armington & Demand Shares
1552      S_DOM(i,z)           "Share of Domestic product in composite demand"
1553      W_IND(i,j,z)         "Share of Industry j in Total Composite Demand QO"
1554      W_HH(i,z)            "Share of Household in Total Composite Demand QO"
1555      W_INV(i,z)           "Share of Investment in Total Composite Demand QO"
1556      W_GOV(i,z)           "Share of Government in Total Composite Demand QO"
1557      W_DDO(i,z)           "Share of Domestic Sales in Total Output"
1558      W_EXTO(i,z)          "Share of Export Sales in Total Output"
1559      Val_Total(i,z)       "Total Value of Domestic and Export Sales"
1560   
1561  * 3. Composite Price Elasticities by Agent (Imported + Domestic)
1562      Elas_Comp_IND(ene,j,z) "Composite elasticity for Industry"
1563      Elas_Comp_HH(ene,z)    "Composite elasticity for Household (LES)"
1564      Elas_Comp_INV(ene,z)   "Composite elasticity for Investment (Cobb-Douglas = -1)"
1565      Elas_Comp_GOV(ene,z)   "Composite elasticity for Government (Cobb-Douglas = -1)"
1566   
1567  * 4. Domestic Price Elasticities by Agent
1568      Elas_Dom_IND(ene,j,z)  "Domestic elasticity for Industry"
1569      Elas_Dom_HH(ene,z)     "Domestic elasticity for Household"
1570      Elas_Dom_INV(ene,z)    "Domestic elasticity for Investment"
1571      Elas_Dom_GOV(ene,z)    "Domestic elasticity for Government"
1572      Elas_EXP(ene,z)        "Export elasticity (based on importer's sigma_M2)"
1573   
1574  * 5. Economy-Wide Price Elasticities
1575      Elas_Total_DDO(ene,z)  "Weighted elasticity of Total Domestic Demand (DDO)"
1576      Elas_Total_ECON(ene,z) "Economy-wide Ex-ante Price Elasticity of Energy Commodity"
1577  ;
1578   
1579  * ------------------------------------------------------------------------------
1580  * Step 1. Calculate Shares
1581  * ------------------------------------------------------------------------------
1582  * Industry nest shares
1583  S_E_KLE(j2,z)$(PKLEO(j2,z)*KLEO(j2,z)) = (PCEO(j2,z)*CEO(j2,z)) / (PKLEO(j2,z)*KLEO(j2,z));
1584  S_NE_E(j2,z)$(PCEO(j2,z)*CEO(j2,z))    = (PCEnelecO(j2,z)*DEnelecO(j2,z)) / (PCEO(j2,z)*CEO(j2,z));
1585  S_Elec_E(j2,z)$(PCEO(j2,z)*CEO(j2,z))  = (PCEelecO(j2,z)*DEelecO(j2,z)) / (PCEO(j2,z)*CEO(j2,z));
1586  S_CG_NE(j2,z)$(PCEnelecO(j2,z)*DEnelecO(j2,z)) = (PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)) / (PCEnelecO(j2,z)*DEnelecO(j2,z));
1587  S_OP_NE(j2,z)$(PCEnelecO(j2,z)*DEnelecO(j2,z)) = (PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)) / (PCEnelecO(j2,z)*DEnelecO(j2,z));
1588  S_Coal_CG(j2,z)$(PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)) = (PCO('02_COAL',z)*DEO('02_COAL',j2,z)) / (PCEcoalgasO(j2,z)*DEcoalgasO(j2,z));
1589  S_Gas_CG(j2,z)$(PCEcoalgasO(j2,z)*DEcoalgasO(j2,z))  = (PCO('04_GAS',z)*DEO('04_GAS',j2,z)) / (PCEcoalgasO(j2,z)*DEcoalgasO(j2,z));
1590  S_Oil_OP(j2,z)$(PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)) = (PCO('03_OIL',z)*DEO('03_OIL',j2,z)) / (PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z));
1591  S_Petrol_OP(j2,z)$(PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)) = (PCO('10_PETROLCOAL',z)*DEO('10_PETROLCOAL',j2,z)) / (PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z));
1592   
1593  * Armington domestic shares (DDO relative to QO)
1594  S_DOM(ene,z)$(PCO(ene,z)*QO(ene,z)) = (PDO(ene,z)*DDO(ene,z)) / (PCO(ene,z)*QO(ene,z));
1595   
1596  * Consumption share of each agent in total domestic composite (QO)
1597  W_IND(ene,j,z)$QO(ene,z) = DEO(ene,j,z) / QO(ene,z);
1598  W_HH(ene,z)$QO(ene,z)    = CO(ene,z) / QO(ene,z);
1599  W_INV(ene,z)$QO(ene,z)   = INVO(ene,z) / QO(ene,z);
1600  W_GOV(ene,z)$QO(ene,z)   = CGO(ene,z) / QO(ene,z);
1601   
1602  * Share of domestic sales (DDO) and exports (EXTO) in total national output
1603  Val_Total(ene,z) = PDO(ene,z)*DDO(ene,z) + PETO(ene,z)*EXTO(ene,z);
1604  W_DDO(ene,z)$Val_Total(ene,z)  = (PDO(ene,z)*DDO(ene,z)) / Val_Total(ene,z);
1605  W_EXTO(ene,z)$Val_Total(ene,z) = (PETO(ene,z)*EXTO(ene,z)) / Val_Total(ene,z);
1606   
1607  * ------------------------------------------------------------------------------
1608  * Step 2. Calculate Composite Price Elasticities by Agent
1609  * ------------------------------------------------------------------------------
1610  * 1. Industry (Only KLE industries have elasticity, Non-KLE is Leontief so 0)
1611  Elas_Comp_IND('02_COAL',j2,z)$DEO('02_COAL',j2,z) =
1612      - (1 - S_Coal_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Coal_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1613      - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1614   
1615  Elas_Comp_IND('04_GAS',j2,z)$DEO('04_GAS',j2,z) =
1616      - (1 - S_Gas_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Gas_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1617      - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1618   
1619  Elas_Comp_IND('03_OIL',j2,z)$DEO('03_OIL',j2,z) =
1620      - (1 - S_Oil_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Oil_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1621      - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1622   
1623  Elas_Comp_IND('10_PETROLCOAL',j2,z)$DEO('10_PETROLCOAL',j2,z) =
1624      - (1 - S_Petrol_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Petrol_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1625      - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1626   
1627  Elas_Comp_IND('18_ELEC',j2,z)$DEO('18_ELEC',j2,z) =
1628      - (1 - S_Elec_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Elec_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1629   
1630  Elas_Comp_IND(ene,j3,z)$DEO(ene,j3,z) = 0;
1631   
1632  * 2. Household (LES Function)
1633  Elas_Comp_HH(ene,z)$CO(ene,z) = CMINO(ene,z) / CO(ene,z) * (1 - gamma_LES(ene,z)) - 1;
1634   
1635  * 3. Investment & Government (Cobb-Douglas Expenditure)
1636  Elas_Comp_INV(ene,z)$INVO(ene,z) = -1.0;
1637  Elas_Comp_GOV(ene,z)$CGO(ene,z)  = -1.0;
1638   
1639  * ------------------------------------------------------------------------------
1640  * Step 3. Derive Domestic Energy Price Elasticities by Agent (incorporating Armington effect)
1641  * ------------------------------------------------------------------------------
1642  Elas_Dom_IND(ene,j,z)$DEO(ene,j,z) = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_IND(ene,j,z);
1643  Elas_Dom_HH(ene,z)$CO(ene,z)       = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_HH(ene,z);
1644  Elas_Dom_INV(ene,z)$INVO(ene,z)    = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_INV(ene,z);
1645  Elas_Dom_GOV(ene,z)$CGO(ene,z)     = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_GOV(ene,z);
1646   
1647  * Exports (Weighted average of trading partners' import substitution elasticity sigma_M2)
1648  Elas_EXP(ene,z)$EXTO(ene,z) = SUM(zj$EXO(ene,z,zj), (EXO(ene,z,zj)/EXTO(ene,z)) * (-sigma_M2(ene,zj)));
1649   
1650  * ------------------------------------------------------------------------------
1651  * Step 4. Derive Economy-Wide Energy Price Elasticity (Aggregation)
1652  * ------------------------------------------------------------------------------
1653  * Domestic demand aggregation (Weighted Average of Domestic Agents)
1654  Elas_Total_DDO(ene,z) =
1655      SUM(j, W_IND(ene,j,z) * Elas_Dom_IND(ene,j,z))
1656      + W_HH(ene,z)  * Elas_Dom_HH(ene,z)
1657      + W_INV(ene,z) * Elas_Dom_INV(ene,z)
1658      + W_GOV(ene,z) * Elas_Dom_GOV(ene,z);
1659   
1660  * Domestic + Export aggregation (Final Economy-Wide Elasticity)
1661  Elas_Total_ECON(ene,z) =
1662      W_DDO(ene,z) * Elas_Total_DDO(ene,z) + W_EXTO(ene,z) * Elas_EXP(ene,z);
1663   
1664  DISPLAY Elas_Total_ECON, Elas_Total_DDO, Elas_Dom_HH, Elas_EXP;
1665   
1666  * ==============================================================================
1667  * Set and Parameter Declaration for Comparison Report
1668  * ==============================================================================
1669  SET eval "Comparison Items" / Initial "Initial Value", Final "Final Value", Target "Target Value" /;
1670  PARAMETER Report_Elas(ene,z,eval) "Elasticity Comparison Report (Based on DDO)";
1671  PARAMETER Initial_Elas_ECON(ene,z) "Backup of initial elasticity";
1672   
1673  * Backup initially calculated DDO elasticity before entering the loop
1674  Initial_Elas_ECON(ene,z) = Elas_Total_ECON(ene,z);
1675   
1676  * ==============================================================================
1677  * Step 0. Set Target Elasticities and Iterative Algorithm Parameters
1678  * ==============================================================================
1679  TABLE Target_Elas(ene,z) "Target economy-wide elasticities by region and energy commodity"
1680                 01_KOR  02_CHN  03_JPN  04_RUS  05_MNG  06_PRK  07_NAM  08_LAM  09_WEU  10_EEU  11_FSU  12_MEA  13_AFR  14_CPA  15_SAS  16_PAS  17_PAO
1681  02_COAL         -0.88   -0.46   -0.74   -0.30   -0.58   -0.30   -0.97   -0.50   -1.03   -0.85   -0.67   -0.76   -0.82   -0.46   -0.71   -1.12   -0.80
1682  03_OIL          -0.52   -0.34   -0.54   -0.15   -0.66   -0.15   -0.92   -0.58   -0.74   -0.45   -0.15   -0.39   -0.95   -0.34   -0.98   -0.52   -0.99
1683  04_GAS          -0.74   -1.16   -0.52   -0.30   -0.67   -0.15   -0.73   -0.69   -0.85   -0.71   -0.57   -0.62   -0.69   -1.16   -0.18   -0.15   -1.25
1684  10_PETROLCOAL   -0.52   -0.34   -0.54   -0.15   -0.66   -0.15   -0.92   -0.58   -0.74   -0.45   -0.15   -0.39   -0.95   -0.34   -0.98   -0.52   -0.99
1685  18_ELEC         -0.48   -0.42   -0.45   -0.21   -0.35   -0.21   -0.49   -0.47   -0.30   -0.26   -0.21   -0.37   -0.57   -0.42   -0.29   -0.30   -0.29
1686  ;
1687   
1688  * Set targets based on DDO
1689  Parameter Target_ECON(ene,z);
1690  Target_ECON('02_COAL',z) = Target_Elas('02_COAL',z);
1691  Target_ECON('03_OIL',z) = Target_Elas('03_OIL',z);
1692  Target_ECON('04_GAS',z) = Target_Elas('04_GAS',z);
1693  Target_ECON('10_PETROLCOAL',z) = Target_Elas('10_PETROLCOAL',z);
1694  Target_ECON('18_ELEC',z) = Target_Elas('18_ELEC',z);
1695   
1696  SET iter "Maximum number of iterations" / 1*1000 /;
1697  SCALAR step "Update speed (Damping factor)" / 0.15 /;
1698  PARAMETER Adj_Ratio(ene,z) "Ratio to target";
1699  PARAMETER Ind_Total_Weight(ene,z) "Total industry weight";
1700   
1701  Ind_Total_Weight(ene,z) = SUM(j, W_IND(ene,j,z));
1702   
1703  * ==============================================================================
1704  * Declare temporary parameters before entering the loop (for calculating error weights by industry)
1705  * ==============================================================================
1706  PARAMETER Ind_Err_CG(j,z) "Weighted average error of Coal-Gas nest by industry";
1707  PARAMETER Ind_Err_OP(j,z) "Weighted average error of Oil products nest by industry";
1708  PARAMETER Ind_Err_NE(j,z) "Weighted average error of Non-Elec nest by industry";
1709  PARAMETER Ind_Err_Tot(j,z) "Weighted average error of total energy by industry";
1710   
1711  * ==============================================================================
1712  * Algorithm Start
1713  * ==============================================================================
1714  LOOP(iter,
1715  * --------------------------------------------------------------------------
1716  * 1. Recalculate elasticity based on currently updated sigma values
1717  * --------------------------------------------------------------------------
1718      Elas_Comp_IND('02_COAL',j2,z)$DEO('02_COAL',j2,z) =
1719          - (1 - S_Coal_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Coal_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1720          - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Coal_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1721   
1722      Elas_Comp_IND('04_GAS',j2,z)$DEO('04_GAS',j2,z) =
1723          - (1 - S_Gas_CG(j2,z)) * sigma_ENER_coalgas(j2,z) - S_Gas_CG(j2,z) * (1 - S_CG_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1724          - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Gas_CG(j2,z) * S_CG_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1725   
1726      Elas_Comp_IND('03_OIL',j2,z)$DEO('03_OIL',j2,z) =
1727          - (1 - S_Oil_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Oil_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1728          - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Oil_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1729   
1730      Elas_Comp_IND('10_PETROLCOAL',j2,z)$DEO('10_PETROLCOAL',j2,z) =
1731          - (1 - S_Petrol_OP(j2,z)) * sigma_ENER_oilprod(j2,z) - S_Petrol_OP(j2,z) * (1 - S_OP_NE(j2,z)) * sigma_ENER_nelec(j2,z)
1732          - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * (1 - S_NE_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Petrol_OP(j2,z) * S_OP_NE(j2,z) * S_NE_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1733   
1734      Elas_Comp_IND('18_ELEC',j2,z)$DEO('18_ELEC',j2,z) =
1735          - (1 - S_Elec_E(j2,z)) * sigma_ENER_elec(j2,z) - S_Elec_E(j2,z) * (1 - S_E_KLE(j2,z)) * sigma_KLE(j2,z);
1736   
1737      Elas_Dom_IND(ene,j,z)$DEO(ene,j,z) = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_IND(ene,j,z);
1738      Elas_Dom_HH(ene,z)$CO(ene,z)       = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_HH(ene,z);
1739      Elas_Dom_INV(ene,z)$INVO(ene,z)    = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_INV(ene,z);
1740      Elas_Dom_GOV(ene,z)$CGO(ene,z)     = - (1 - S_DOM(ene,z)) * sigma_M1(ene,z) + S_DOM(ene,z) * Elas_Comp_GOV(ene,z);
1741   
1742      Elas_Total_DDO(ene,z) =
1743          SUM(j, W_IND(ene,j,z) * Elas_Dom_IND(ene,j,z))
1744          + W_HH(ene,z)  * Elas_Dom_HH(ene,z)
1745          + W_INV(ene,z) * Elas_Dom_INV(ene,z)
1746          + W_GOV(ene,z) * Elas_Dom_GOV(ene,z);
1747   
1748      Elas_EXP(ene,z)$EXTO(ene,z) = SUM(zj$EXO(ene,z,zj), (EXO(ene,z,zj)/EXTO(ene,z)) * (-sigma_M2(ene,zj)));
1749      Elas_Total_ECON(ene,z) = W_DDO(ene,z) * Elas_Total_DDO(ene,z) + W_EXTO(ene,z) * Elas_EXP(ene,z);
1750   
1751  * --------------------------------------------------------------------------
1752  * 2. Calculate error ratio at the national level (Initialize first, keep 1.0 for fuels without target)
1753  * --------------------------------------------------------------------------
1754      Adj_Ratio(ene,z) = 1.0;
1755      Adj_Ratio(ene,z)$(Elas_Total_ECON(ene,z) ne 0 and Target_ECON(ene,z) ne 0) = Target_ECON(ene,z) / Elas_Total_ECON(ene,z);
1756      Adj_Ratio(ene,z) = max(0.2, min(5.0, Adj_Ratio(ene,z)));
1757   
1758  * --------------------------------------------------------------------------
1759  * 3. Parameter Update (Reflecting high-precision industry-specific nest weights)
1760  * --------------------------------------------------------------------------
1761      sigma_M1(ene,z)$(1 - S_DOM(ene,z) > 0.05) = sigma_M1(ene,z) * (1 + step * (Adj_Ratio(ene,z) - 1));
1762  *    sigma_M2(ene,z) = sigma_M2(ene,z) * (1 + step * (Adj_Ratio(ene,z) - 1));
1763      sigma_M2(ene,z) = sigma_M1(ene,z) * (Init_sigma_M2(ene,z) / Init_sigma_M1(ene,z));
1764   
1765      LOOP(j2,
1766  * A. Derive weighted average error by nest within each industry (j2) (Follow the error of the fuel heavily consumed by the industry)
1767          Ind_Err_CG(j2,z)  = S_Coal_CG(j2,z)*Adj_Ratio('02_COAL',z) + S_Gas_CG(j2,z)*Adj_Ratio('04_GAS',z);
1768          Ind_Err_OP(j2,z)  = S_Oil_OP(j2,z)*Adj_Ratio('03_OIL',z)   + S_Petrol_OP(j2,z)*Adj_Ratio('10_PETROLCOAL',z);
1769          Ind_Err_NE(j2,z)  = S_CG_NE(j2,z)*Ind_Err_CG(j2,z)         + S_OP_NE(j2,z)*Ind_Err_OP(j2,z);
1770          Ind_Err_Tot(j2,z) = S_Elec_E(j2,z)*Adj_Ratio('18_ELEC',z)  + S_NE_E(j2,z)*Ind_Err_NE(j2,z);
1771   
1772  * B. Parameter modification (Cross-application according to mathematical partial derivative structure)
1773  * Lower nests dominate the elasticity of "minority" fuels, so track errors inversely (Cross)
1774          sigma_ENER_coalgas(j2,z) = sigma_ENER_coalgas(j2,z) * (1 + step * ( S_Coal_CG(j2,z)*Adj_Ratio('04_GAS',z) + S_Gas_CG(j2,z)*Adj_Ratio('02_COAL',z) - 1 ));
1775          sigma_ENER_oilprod(j2,z) = sigma_ENER_oilprod(j2,z) * (1 + step * ( S_Oil_OP(j2,z)*Adj_Ratio('10_PETROLCOAL',z) + S_Petrol_OP(j2,z)*Adj_Ratio('03_OIL',z) - 1 ));
1776   
1777  * Upper nests dominate the elasticity of "majority" fuels, so track the weighted average of the nest
1778          sigma_ENER_nelec(j2,z) = sigma_ENER_nelec(j2,z) * (1 + step * (Ind_Err_NE(j2,z) - 1));
1779   
1780  * Cross nest (Cross-application of errors between electricity and non-electricity)
1781          sigma_ENER_elec(j2,z) = sigma_ENER_elec(j2,z) * (1 + step * ( S_NE_E(j2,z)*Adj_Ratio('18_ELEC',z) + S_Elec_E(j2,z)*Ind_Err_NE(j2,z) - 1 ));
1782   
1783  * Top KLE elasticity tracks the integrated energy error of the entire industry
1784          sigma_KLE(j2,z) = sigma_KLE(j2,z) * (1 + (step/2) * (Ind_Err_Tot(j2,z) - 1));
1785      );
1786   
1787  * --------------------------------------------------------------------------
1788  * 4. Logical Constraints for Parameters
1789  * --------------------------------------------------------------------------
1790  *    sigma_M1(ene,z) = max(0.5, min(15.0, sigma_M1(ene,z)));
1791  *    sigma_M2(ene,z) = max(0.5, min(30.0, sigma_M2(ene,z)));
1792   
1793  *    sigma_ENER_coalgas(j,z) = max(0.5, min(3.0, sigma_ENER_coalgas(j,z)));
1794  *    sigma_ENER_oilprod(j,z) = max(0.5, min(3.0, sigma_ENER_oilprod(j,z)));
1795  *    sigma_ENER_nelec(j,z)   = max(0.5, min(3.0, sigma_ENER_nelec(j,z)));
1796  *    sigma_ENER_elec(j,z)    = max(0.5, min(3.0, sigma_ENER_elec(j,z)));
1797  *    sigma_KLE(j,z)          = max(0.5, min(3.0, sigma_KLE(j,z)));
1798   
1799      sigma_M1(ene,z) = max(0.5, min(15.0, sigma_M1(ene,z)));
1800      sigma_M2(ene,z) = max(0.5, min(30.0, sigma_M2(ene,z)));
1801      sigma_ENER_coalgas(j,z) = max(0.5, min(3.0, sigma_ENER_coalgas(j,z)));
1802      sigma_ENER_oilprod(j,z) = max(0.5, min(3.0, sigma_ENER_oilprod(j,z)));
1803      sigma_ENER_nelec(j,z)   = max(0.5, min(3.0, sigma_ENER_nelec(j,z)));
1804      sigma_ENER_elec(j,z)    = max(0.5, min(3.0, sigma_ENER_elec(j,z)));
1805      sigma_KLE(j,z)          = max(0.5, min(3.0, sigma_KLE(j,z)));
1806   
1807  * [2단계] 대체탄력성 1.0 부근(0.9 ~ 1.1) 회피 조건 추가 (Deadzone 설정)
1808  * 값이 0.9 초과 1.0 이하인 경우 0.9로 고정
1809  * 값이 1.0 초과 1.1 미만인 경우 1.1로 고정
1810   
1811      sigma_M1(ene,z)$(sigma_M1(ene,z) > 0.9 and sigma_M1(ene,z) <= 1.0) = 0.9;
1812      sigma_M1(ene,z)$(sigma_M1(ene,z) > 1.0 and sigma_M1(ene,z) <  1.1) = 1.1;
1813   
1814      sigma_M2(ene,z)$(sigma_M2(ene,z) > 0.9 and sigma_M2(ene,z) <= 1.0) = 0.9;
1815      sigma_M2(ene,z)$(sigma_M2(ene,z) > 1.0 and sigma_M2(ene,z) <  1.1) = 1.1;
1816   
1817      sigma_ENER_coalgas(j,z)$(sigma_ENER_coalgas(j,z) > 0.9 and sigma_ENER_coalgas(j,z) <= 1.0) = 0.9;
1818      sigma_ENER_coalgas(j,z)$(sigma_ENER_coalgas(j,z) > 1.0 and sigma_ENER_coalgas(j,z) <  1.1) = 1.1;
1819   
1820      sigma_ENER_oilprod(j,z)$(sigma_ENER_oilprod(j,z) > 0.9 and sigma_ENER_oilprod(j,z) <= 1.0) = 0.9;
1821      sigma_ENER_oilprod(j,z)$(sigma_ENER_oilprod(j,z) > 1.0 and sigma_ENER_oilprod(j,z) <  1.1) = 1.1;
1822   
1823      sigma_ENER_nelec(j,z)$(sigma_ENER_nelec(j,z) > 0.9 and sigma_ENER_nelec(j,z) <= 1.0) = 0.9;
1824      sigma_ENER_nelec(j,z)$(sigma_ENER_nelec(j,z) > 1.0 and sigma_ENER_nelec(j,z) <  1.1) = 1.1;
1825   
1826      sigma_ENER_elec(j,z)$(sigma_ENER_elec(j,z) > 0.9 and sigma_ENER_elec(j,z) <= 1.0) = 0.9;
1827      sigma_ENER_elec(j,z)$(sigma_ENER_elec(j,z) > 1.0 and sigma_ENER_elec(j,z) <  1.1) = 1.1;
1828   
1829      sigma_KLE(j,z)$(sigma_KLE(j,z) > 0.9 and sigma_KLE(j,z) <= 1.0) = 0.9;
1830      sigma_KLE(j,z)$(sigma_KLE(j,z) > 1.0 and sigma_KLE(j,z) <  1.1) = 1.1;
1831   
1832  );
1833   
1834  * ==============================================================================
1835  * [ADDITION] Generate consolidated report for elasticity parameter changes
1836  * ==============================================================================
1837  PARAMETER Report_sigma_M1(ene,z,eval_sig) "Report for Armington sigma_M1 changes";
1838  PARAMETER Report_sigma_M2(ene,z,eval_sig) "Report for Armington sigma_M2 changes";
1839  PARAMETER Report_sigma_IND(j,z,sig_type,eval_sig) "Report for Industry nest sigma changes";
1840   
1841  * 1. Generate report for sigma_M1
1842  Report_sigma_M1(ene,z,'Initial') = Init_sigma_M1(ene,z);
1843  Report_sigma_M1(ene,z,'Final')   = sigma_M1(ene,z);
1844  Report_sigma_M1(ene,z,'Diff')    = sigma_M1(ene,z) - Init_sigma_M1(ene,z);
1845   
1846  Report_sigma_M2(ene,z,'Initial') = Init_sigma_M2(ene,z);
1847  Report_sigma_M2(ene,z,'Final')   = sigma_M2(ene,z);
1848  Report_sigma_M2(ene,z,'Diff')    = sigma_M2(ene,z) - Init_sigma_M2(ene,z);
1849   
1850  * 2. Generate consolidated report for industry-specific elasticities
1851  Report_sigma_IND(j,z,'s_coalgas','Initial') = Init_sigma_IND(j,z,'s_coalgas');
1852  Report_sigma_IND(j,z,'s_coalgas','Final')   = sigma_ENER_coalgas(j,z);
1853  Report_sigma_IND(j,z,'s_coalgas','Diff')    = sigma_ENER_coalgas(j,z) - Init_sigma_IND(j,z,'s_coalgas');
1854   
1855  Report_sigma_IND(j,z,'s_oilprod','Initial') = Init_sigma_IND(j,z,'s_oilprod');
1856  Report_sigma_IND(j,z,'s_oilprod','Final')   = sigma_ENER_oilprod(j,z);
1857  Report_sigma_IND(j,z,'s_oilprod','Diff')    = sigma_ENER_oilprod(j,z) - Init_sigma_IND(j,z,'s_oilprod');
1858   
1859  Report_sigma_IND(j,z,'s_nelec','Initial') = Init_sigma_IND(j,z,'s_nelec');
1860  Report_sigma_IND(j,z,'s_nelec','Final')   = sigma_ENER_nelec(j,z);
1861  Report_sigma_IND(j,z,'s_nelec','Diff')    = sigma_ENER_nelec(j,z) - Init_sigma_IND(j,z,'s_nelec');
1862   
1863  Report_sigma_IND(j,z,'s_elec','Initial') = Init_sigma_IND(j,z,'s_elec');
1864  Report_sigma_IND(j,z,'s_elec','Final')   = sigma_ENER_elec(j,z);
1865  Report_sigma_IND(j,z,'s_elec','Diff')    = sigma_ENER_elec(j,z) - Init_sigma_IND(j,z,'s_elec');
1866   
1867  Report_sigma_IND(j,z,'s_kle','Initial') = Init_sigma_IND(j,z,'s_kle');
1868  Report_sigma_IND(j,z,'s_kle','Final')   = sigma_KLE(j,z);
1869  Report_sigma_IND(j,z,'s_kle','Diff')    = sigma_KLE(j,z) - Init_sigma_IND(j,z,'s_kle');
1870   
1871  Report_Elas(ene,z,'Initial') = Initial_Elas_ECON(ene,z);
1872  Report_Elas(ene,z,'Final')   = Elas_Total_ECON(ene,z);
1873  Report_Elas(ene,z,'Target')  = Target_ECON(ene,z);
1874   
1875  * Display results in the .lst file
1876  DISPLAY Report_sigma_M1, Report_sigma_IND;
1877  *$Offtext
1878   
1879  *==============================================================================
1880  * Calibration of function parameters
1881  *==============================================================================
1882   io(j,z)$XSTO(j,z)         = CIO(j,z) / XSTO(j,z);
1883   io2(j,z)$XSTO(j,z)        = CEO(j,z) / XSTO(j,z);
1884   v(j,z)$XSTO(j,z)          = VAO(j,z) / XSTO(j,z);
1885   v2(j,z)$XSTO(j,z)         = (CEO(j,z) + VAO(j,z)) / XSTO(j,z);
1886   
1887   aij(nene,j,z)$XSTO(j,z)   = DIO(nene,j,z) / CIO(j,z);
1888   aij2(ene,j,z)$XSTO(j,z)   = DEO(ene,j,z) / CEO(j,z);
1889   aij_t(nene,j,z,time)        = aij(nene,j,z);
1890   aij2_t(ene,j,z,time)        = aij2(ene,j,z);
1891   
1892  *==============================================================================
1893  * Calibration of CET parameters
1894  *==============================================================================
1895   rho_X1(i,z) = (1 + sigma_X1(i,z)) / sigma_X1(i,z);
1896   
1897   beta_EX_X1(i,z)$MRGNO(i,z)
1898      = [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z)) ] /
1899        [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z))
1900        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z))
1901        + eO(z)     * PWMGO(i) * MRGNO(i,z)$MRGNO(i,z)**(1 - rho_X1(i,z)) ];
1902   
1903   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1904      = [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z)) ] /
1905        [ PETO(i,z) * EXTO(i,z)$EXTO(i,z)**(1 - rho_X1(i,z))
1906        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z)) ];
1907   
1908   beta_D_X1(i,z)$MRGNO(i,z)
1909      = [ PLO(i,z) * DSO_I(i,z)**(1 - rho_X1(i,z)) ] /
1910        [ PETO(i,z) * EXTO(i,z)**(1 - rho_X1(i,z))
1911        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z))
1912        + eO(z)     * PWMGO(i) * MRGNO(i,z)**(1 - rho_X1(i,z)) ];
1913   
1914   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1915      = [ PLO(i,z) * DSO_I(i,z)**(1 - rho_X1(i,z)) ] /
1916        [ PETO(i,z) * EXTO(i,z)**(1 - rho_X1(i,z))
1917        + PLO(i,z)  * DSO_I(i,z)**(1 - rho_X1(i,z)) ];
1918   
1919   B_X1(i,z)
1920      = XSO_I(i,z) /
1921        [ beta_EX_X1(i,z) * EXTO(i,z)**rho_X1(i,z)
1922        + beta_D_X1(i,z)  * DSO_I(i,z)**rho_X1(i,z)
1923        + (1 - beta_EX_X1(i,z) - beta_D_X1(i,z)) * MRGNO(i,z)**rho_X1(i,z)
1924        ]**(1 / rho_X1(i,z));
1925   
1926  *==============================================================================
1927  * CET between exports to different trading partners
1928  *==============================================================================
1929   rho_X2(i,z) = (1 + sigma_X2(i,z)) / sigma_X2(i,z);
1930   
1931   beta_X2(i,z,zj)$EXO(i,z,zj)
1932      = [ PEO(i,z,zj) * EXO(i,z,zj)**(1 - rho_X2(i,z)) ] /
1933        SUM[zjj$EXO(i,z,zjj), PEO(i,z,zjj) * EXO(i,z,zjj)**(1 - rho_X2(i,z)) ];
1934   
1935   B_X2(i,z)
1936      = EXTO(i,z) /
1937        { SUM[zj, beta_X2(i,z,zj) * EXO(i,z,zj)**rho_X2(i,z)]**(1 / rho_X2(i,z)) };
1938   
1939  *==============================================================================
1940  * Calibration of CES parameters
1941  *==============================================================================
1942   rho_X3(i,z) = (1 - sigma_X3(i,z)) / sigma_X3(i,z);
1943   
1944   beta_X3(j,i,z)$XSO(j,i,z)
1945      = [ PO2(j,i,z) * XSO(j,i,z)**(1 + rho_X3(i,z)) ] /
1946        SUM[jj$XSO(jj,i,z), PO2(jj,i,z) * XSO(jj,i,z)**(1 + rho_X3(i,z)) ];
1947   
1948   B_X3(i,z)
1949      = XSO_I(i,z) /
1950        SUM[jj$XSO(jj,i,z), beta_X3(jj,i,z) * XSO(jj,i,z)**(-rho_X3(i,z))]**(-1 / rho_X3(i,z));
1951   
1952  * Electricity
1953   QPOWERO(z) = SUM(POWER, XSO(power,'18_ELEC',z));
1954   rho_X4(z)  = (1 - sigma_X4(z)) / sigma_X4(z);
1955   
1956   beta_X4(power,z)
1957      = [ PO2(power,'18_ELEC',z) * XSO(power,'18_ELEC',z)**(1 + rho_X4(z)) ] /
1958        SUM[powerr$XSO(powerr,'18_ELEC',z), PO2(powerr,'18_ELEC',z) * XSO(powerr,'18_ELEC',z)**(1 + rho_X4(z)) ];
1959   
1960   B_X4(z)
1961      = QPOWERO(z) /
1962        SUM[powerr$XSO(powerr,'18_ELEC',z), beta_X4(powerr,z) * XSO(powerr,'18_ELEC',z)**(-rho_X4(z))]**(-1 / rho_X4(z));
1963   
1964   TnDShare(z) = XSO('18_TnD','18_ELEC',z) / XSO_I('18_ELEC',z);
1965   
1966  *Backstop
1967  LOOP(MAP_BS(bs, conv, I_BS),
1968   
1969      QBSO(bs, Z_GRN) = XSO(conv, I_BS, Z_GRN) + XSO(bs, I_BS, Z_GRN);
1970   
1971      rho_BS(bs, Z_GRN) = (1 - sigma_BS(bs, Z_GRN)) / sigma_BS(bs, Z_GRN);
1972   
1973      beta_BS(conv, I_BS, Z_GRN)
1974          = [ PO2(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] /
1975            ( [ PO2(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] +
1976              [ PO2(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] );
1977   
1978      beta_BS(bs, I_BS, Z_GRN)
1979          = [ PO2(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] /
1980            ( [ PO2(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] +
1981              [ PO2(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(1 + rho_BS(bs, Z_GRN)) ] );
1982   
1983      B_BS(bs, Z_GRN)
1984          = QBSO(bs, Z_GRN) /
1985            ( beta_BS(conv, I_BS, Z_GRN) * XSO(conv, I_BS, Z_GRN)**(-rho_BS(bs, Z_GRN)) +
1986              beta_BS(bs, I_BS, Z_GRN) * XSO(bs, I_BS, Z_GRN)**(-rho_BS(bs, Z_GRN)) )**(-1 / rho_BS(bs, Z_GRN));
1987   
1988      beta_BS_t(conv, I_BS, Z_GRN, time) = beta_BS(conv, I_BS, Z_GRN);
1989      beta_BS_t(bs, I_BS, Z_GRN, time)   = beta_BS(bs, I_BS, Z_GRN);
1990  );
1991   
1992  *==============================================================================
1993  * Composite good
1994  *==============================================================================
1995   rho_M1(i,z) = (1 - sigma_M1(i,z)) / sigma_M1(i,z);
1996   
1997   beta_M1(i,z)
1998      = PMTO(i,z) * IMTO(i,z)**(rho_M1(i,z) + 1) /
1999        { PDO(i,z)  * DDO(i,z)**(rho_M1(i,z) + 1)
2000        + PMTO(i,z) * IMTO(i,z)**(rho_M1(i,z) + 1) };
2001   
2002   B_M1(i,z)
2003      = QO(i,z) /
2004        { beta_M1(i,z) * IMTO(i,z)**(-rho_M1(i,z))
2005        + (1 - beta_M1(i,z)) * DDO(i,z)**(-rho_M1(i,z)) }**(-1 / rho_M1(i,z));
2006   
2007  *==============================================================================
2008  * CES between imports from different trading partners
2009  *==============================================================================
2010   rho_M2(i,z) = (1 - sigma_M2(i,z)) / sigma_M2(i,z);
2011   
2012   beta_M2(i,zj,z)$IMO(i,zj,z)
2013      = [ PMO(i,zj,z) * IMO(i,zj,z)**(rho_M2(i,z) + 1) ] /
2014        SUM[zjj$IMO(i,zjj,z), PMO(i,zjj,z) * IMO(i,zjj,z)**(rho_M2(i,z) + 1) ];
2015   
2016   B_M2(i,z)
2017      = IMTO(i,z) /
2018        { SUM[zj$IMO(i,zj,z), beta_M2(i,zj,z) * IMO(i,zj,z)**(-rho_M2(i,z))]**(-1 / rho_M2(i,z)) };
2019   
2020  *==============================================================================
2021  * Composite capital
2022  *==============================================================================
2023   rho_KD(j,z) = (1 - sigma_KD(j,z)) / sigma_KD(j,z);
2024   
2025   beta_KD(k,j,z)$KDO(k,j,z)
2026      = [ RTIO(k,j,z) * KDO(k,j,z)**(1 + rho_KD(j,z)) ] /
2027        SUM[kj$KDO(kj,j,z), RTIO(kj,j,z) * KDO(kj,j,z)**(1 + rho_KD(j,z)) ];
2028   
2029   B_KD(j,z)$KDCO(j,z)
2030      = KDCO(j,z) /
2031        { SUM[k$KDO(k,j,z), beta_KD(k,j,z) * KDO(k,j,z)**(-rho_KD(j,z))]**(-1 / rho_KD(j,z)) };
2032   
2033  *===============================================================================
2034  * Composite E
2035  *===============================================================================
2036  * Level 5_1 (Coal/Gas)
2037   rho_ENER_coalgas(j2,z) = (1 - sigma_ENER_coalgas(j2,z)) / sigma_ENER_coalgas(j2,z);
2038   
2039   beta_ENER_coalgas(ene5,j2,z)
2040      = [ PO4(ene5,j2,z) * DEO(ene5,j2,z)**(1 + rho_ENER_coalgas(j2,z)) ] /
2041        SUM[enee5, PO4(enee5,j2,z) * DEO(enee5,j2,z)**(1 + rho_ENER_coalgas(j2,z)) ];
2042   
2043   B_ENER_coalgas(j2,z)
2044      = DEcoalgasO(j2,z) /
2045        { SUM[ene5, beta_ENER_coalgas(ene5,j2,z) * DEO(ene5,j2,z)**(-rho_ENER_coalgas(j2,z))] }**(-1 / rho_ENER_coalgas(j2,z));
2046   
2047  * Level 5_2 (Oil/Petrol)
2048   rho_ENER_oilprod(j2,z) = (1 - sigma_ENER_oilprod(j2,z)) / sigma_ENER_oilprod(j2,z);
2049   
2050   beta_ENER_oilprod(ene6,j2,z)
2051      = [ PO4(ene6,j2,z) * DEO(ene6,j2,z)**(1 + rho_ENER_oilprod(j2,z)) ] /
2052        SUM[enee6, PO4(enee6,j2,z) * DEO(enee6,j2,z)**(1 + rho_ENER_oilprod(j2,z)) ];
2053   
2054   B_ENER_oilprod(j2,z)
2055      = DEoilpetrolO(j2,z) /
2056        { SUM[ene6, beta_ENER_oilprod(ene6,j2,z) * DEO(ene6,j2,z)**(-rho_ENER_oilprod(j2,z))] }**(-1 / rho_ENER_oilprod(j2,z));
2057   
2058  * Level 4 (Coal-Gas / Oil-Petrol)
2059   rho_ENER_nelec(j2,z) = (1 - sigma_ENER_nelec(j2,z)) / sigma_ENER_nelec(j2,z);
2060   
2061   beta_ENER_nelec(j2,z)
2062      = PCEcoalgasO(j2,z) * DEcoalgasO(j2,z)**(rho_ENER_nelec(j2,z) + 1) /
2063        { PCEcoalgasO(j2,z) * DEcoalgasO(j2,z)**(rho_ENER_nelec(j2,z) + 1)
2064        + PCEoilpetrolO(j2,z) * DEoilpetrolO(j2,z)**(rho_ENER_nelec(j2,z) + 1) };
2065   
2066   B_ENER_nelec(j2,z)
2067      = DEnelecO(j2,z) /
2068        { [ beta_ENER_nelec(j2,z) * DEcoalgasO(j2,z)**(-rho_ENER_nelec(j2,z))
2069          + (1 - beta_ENER_nelec(j2,z)) * DEoilpetrolO(j2,z)**(-rho_ENER_nelec(j2,z)) ] }**(-1 / rho_ENER_nelec(j2,z));
2070   
2071  * Level 2 (Elec / Non-Elec)
2072   rho_ENER_elec(j2,z) = (1 - sigma_ENER_elec(j2,z)) / sigma_ENER_elec(j2,z);
2073   
2074   beta_ENER_elec(j2,z)
2075      = PCEelecO(j2,z) * DEelecO(j2,z)**(rho_ENER_elec(j2,z) + 1) /
2076        { PCEelecO(j2,z) * DEelecO(j2,z)**(rho_ENER_elec(j2,z) + 1)
2077        + PCEnelecO(j2,z) * DEnelecO(j2,z)**(rho_ENER_elec(j2,z) + 1) };
2078   
2079   B_ENER_elec(j2,z)
2080      = CEO(j2,z) /
2081        { [ beta_ENER_elec(j2,z) * DEelecO(j2,z)**(-rho_ENER_elec(j2,z))
2082          + (1 - beta_ENER_elec(j2,z)) * DEnelecO(j2,z)**(-rho_ENER_elec(j2,z)) ] }**(-1 / rho_ENER_elec(j2,z));
2083   
2084  *==============================================================================
2085  * Value added
2086  *==============================================================================
2087   rho_VA(j,z) = (1 - sigma_VA(j,z)) / sigma_VA(j,z);
2088   
2089   beta_VA(j,z)$KDCO(j,z)
2090      = WCO(j,z) * LDCO(j,z)**(rho_VA(j,z) + 1) /
2091        { WCO(j,z) * LDCO(j,z)**(rho_VA(j,z) + 1)
2092        + RCO(j,z) * KDCO(j,z)**(rho_VA(j,z) + 1) };
2093   
2094   B_VA(j,z)$KDCO(j,z)
2095      = VAO(j,z) /
2096        { [ beta_VA(j,z) * LDCO(j,z)**(-rho_VA(j,z))
2097          + (1 - beta_VA(j,z)) * KDCO(j,z)**(-rho_VA(j,z)) ] }**(-1 / rho_VA(j,z));
2098   
2099   B_VA_t(j,z,time) = B_VA(j,z);
2100   
2101  *==============================================================================
2102  * Calibration of VAT nest for ALL Backstop Sectors (BS)
2103  *==============================================================================
2104  rho_VAT(BS, Z_GRN)   = (1 - sigma_VAT(BS, Z_GRN)) / sigma_VAT(BS, Z_GRN);
2105   
2106   beta_VAT(BS, Z_GRN)
2107      = ( PVAO(BS, Z_GRN) * VAO(BS, Z_GRN)**(1 + rho_VAT(BS, Z_GRN)) ) /
2108        ( PVAO(BS, Z_GRN) * VAO(BS, Z_GRN)**(1 + rho_VAT(BS, Z_GRN))
2109        + PTSFO(BS, Z_GRN) * TSFO(BS, Z_GRN)**(1 + rho_VAT(BS, Z_GRN)) );
2110   
2111   B_VAT(BS, Z_GRN)
2112      = VATO(BS, Z_GRN) /
2113        ( beta_VAT(BS, Z_GRN) * VAO(BS, Z_GRN)**(-rho_VAT(BS, Z_GRN))
2114        + (1 - beta_VAT(BS, Z_GRN)) * TSFO(BS, Z_GRN)**(-rho_VAT(BS, Z_GRN)) )**(-1 / rho_VAT(BS, Z_GRN));
2115   
2116   v_vat(BS, Z_GRN)     = VATO(BS, Z_GRN) / XSTO(BS, Z_GRN);
2117   
2118   B_VAT_t(BS, Z_GRN, time) = B_VAT(BS, Z_GRN);
2119   
2120  *==============================================================================
2121  * Composite KLE
2122  *==============================================================================
2123   rho_KLE(j,z) = (1 - sigma_KLE(j,z)) / sigma_KLE(j,z);
2124   
2125   beta_KLE(j,z)$KLEO(j,z)
2126      = PVAO(j,z) * VAO(j,z)**(rho_KLE(j,z) + 1) /
2127        { PVAO(j,z) * VAO(j,z)**(rho_KLE(j,z) + 1)
2128        + PCEO(j,z) * CEO(j,z)**(rho_KLE(j,z) + 1) };
2129   
2130   beta_KLE2(j,z)$KLEO(j,z)
2131      = 1 - beta_KLE(j,z);
2132   
2133   B_KLE(j,z)$KLEO(j,z)
2134      = KLEO(j,z) /
2135        { [ beta_KLE(j,z) * VAO(j,z)**(-rho_KLE(j,z))
2136          + beta_KLE2(j,z) * CEO(j,z)**(-rho_KLE(j,z)) ] }**(-1 / rho_KLE(j,z));
2137   
2138  *==============================================================================
2139  * Calibration of gross domestic products
2140  *==============================================================================
2141  GDP_BPO(z)     = SUM[j, PVAO(j,z) * VAO(j,z)] + SUM[BS, PTSFO(BS,z) * TSFO(BS,z)] + TIPTO(z);
2142   GDP_MPO(z)     = GDP_BPO(z) + TPRCTSO(z);
2143   
2144  GDP_IBO(z)
2145      = SUM[(j), WO(z) * LDO(j,z)]
2146      + SUM[(k,j), RO(k,j,z) * KDO(k,j,z)]
2147      + SUM[BS, PTSFO(BS,z) * TSFO(BS,z)]
2148      + TPRODNO(z)
2149      + TPRCTSO(z);
2150   
2151   GDP_FDO(z)
2152      = SUM[i, PCO(i,z) * (CO(i,z) + CGO(i,z) + INVO(i,z))]
2153      + eO(z) * SUM[(i,zj), PWXO(i,z,zj) * EXO(i,z,zj)]
2154      + eO(z) * SUM[i, PWMGO(i) * MRGNO(i,z)]
2155      - eO(z) * SUM[(i,zj), IMO(i,zj,z) * (PWMO(i,zj,z) + SUM{ij, PWMGO(ij) * tmrg(ij,i,zj,z)})];
2156   
2157   GDP_BP_WO      = SUM[z, GDP_BPO(z) / eO(z)];
2158   
2159  *==============================================================================
2160  * Calibration of real (volume) variables computed from price indices
2161  *==============================================================================
2162   CABXO(z)       = CABO(z) / [PIXGDP_WO * eO(z)];
2163   
2164   CABXsur(z,T1)  = CABXO(z)$[CABXO(z) gt 0];
2165   CABXdef(z,T1)  = CABXO(z)$[CABXO(z) lt 0];
2166   
2167   CABXsur(z,time)$[ord(time) gt 1] = CABXO(z) * (1 + g_GDP(z,time))$[CABXO(z) gt 0];
2168   CABXdef(z,time)$[ord(time) gt 1] = CABXO(z) * (1 + g_GDP(z,time))$[CABXO(z) lt 0];
2169   
2170   Bal(time)      = SUM(zj, CABXsur(zj,time)) + SUM(zj, CABXdef(zj,time));
2171   
2172   mu(time)       = SUM(zj, CABXsur(zj,time)) /
2173                    { SUM(zj, CABXsur(zj,time)) + SUM(zj, ABS(CABXdef(zj,time))) };
2174   
2175   CABXsur(z,time) = CABXsur(z,time) * { 1 - mu(time) * Bal(time) / SUM(zj, CABXsur(zj,time)) };
2176   CABXdef(z,time) = CABXdef(z,time) * { 1 - [1 - mu(time)] * Bal(time) / SUM(zj, CABXdef(zj,time)) };
2177   CABix(z,time)   = [ CABXsur(z,time) + CABXdef(z,time) ] / CABXO(z);
2178   
2179   CTH_REALO(z)   = CTHO(z) / PIXCONO(z);
2180   G_REALO(z)     = GO(z) / PIXGVTO(z);
2181   GDP_BP_REALO(z)= GDP_BPO(z) / PIXGDPO(z);
2182   GDP_BP_W_REALO = GDP_BP_WO / PIXGDP_WO;
2183   GDP_MP_REALO(z)= GDP_MPO(z) / PIXCONO(z);
2184   IT_REALO(z)    = ITO(z) / PIXINVO(z);
2185   
2186   sh1O(z)        = [SHO(z) + SGO(z)] / GDP_IBO(z);
2187   sh0O(z)        = SHO(z) - sh1O(z) * YDHO(z);
2188   
2189   sh0O(z)        = sh0O(z) / PIXCONO(z)**eta;
2190   ttdh0O(z)      = ttdh0O(z) / PIXCONO(z)**eta;
2191   
2192   OBJO           = 1;
2193   growthz(z)    = 0.02;
2194   
