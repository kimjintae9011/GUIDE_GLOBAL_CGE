1172  *==============================================================================
1173  * 4.1 Real GDP projections
1174  *==============================================================================
1175   
1176  loop{time$[time.val lt 2100],
1177   g_GDP(z,time+1)           = [GDP(z,time+1)/GDP(z,time)]-1;
1178  };
1179   g_GDP(z,time)$[time.val ge 2100]
1180                           = g_GDP(z,time+2);
1181   
1182  *==============================================================================
1183  * 4.2 Total population projections
1184  *==============================================================================
1185   
1186  loop{time$[time.val lt 2100],
1187   g_POP(z,time+1)           = [TOT_POP(z,time+1)/TOT_POP(z,time)]-1;
1188  };
1189   g_POP(z,time)$[time.val ge 2100]
1190                           = g_POP(z,time+1);
