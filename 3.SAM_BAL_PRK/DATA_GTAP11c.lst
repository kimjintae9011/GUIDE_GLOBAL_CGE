2457  DIO(i,j,z) = SUM[(C1,A1)$[sam_sce14(i,C1)$sam_sce13(j,A1)], SAM1(C1,A1,Z)];
2458  IMO(i,zj,z) = SUM[(World1,C1)$[sam_sce24(zj,World1)$sam_sce14(i,C1)], SAM1(World1,C1,Z)];
2459   
2460  Parameter EXOPRK(i);
2461   
2462   EXOPRK(i) = SUM[(C1)$[sam_sce14(i,C1)], SAM1(C1,'154_ww_r_02CHN','06_PRK')];
2463   
2464  *lt Strictly less than
2465   IMO(i,zj, z)$(IMO(i, zj, z) lt 0.1) = 0.1 ;
2466   IMO(i,zj,z)$sameas(zj,z) = 0 ;
2467  *------------------------------------------------------------------------------
2468  * 2.4.5-A 북한 무역 행렬 초기화 및 새로운 SAM 데이터 이식
2469  *------------------------------------------------------------------------------
2470  * (1) 북한과 관련된 모든 수입 흐름을 0.1로 초기화 (마카오 노이즈 제거)
2471  IMO(i,"06_PRK",z) = 0.1;
2472  IMO(i,"06_PRK","02_CHN") =  EXOPRK(i);
2473   
2474   IMO(i,zj, z)$(IMO(i, zj, z) lt 0.1) = 0.1 ;
2475   IMO(i,zj,z)$sameas(zj,z) = 0 ;
2476   
2477  EXO(i,zj,z) = IMO(i,zj,z);
2478  EXTO(i,z) = SUM(zj, EXO(i,z,zj));
2479  tmrg('20_LTRP',ij,zj,z) = SUM[(MAR1,C1)$[sam_sce21(zj,MAR1)$sam_sce14(ij,C1)],SAM1(MAR1,C1,Z)];
2480  tmrg('21_WTRP',ij,zj,z) = SUM[(MAR2,C1)$[sam_sce22(zj,MAR2)$sam_sce14(ij,C1)],SAM1(MAR2,C1,Z)];
2481  tmrg('22_ATRP',ij,zj,z) = SUM[(MAR3,C1)$[sam_sce23(zj,MAR3)$sam_sce14(ij,C1)],SAM1(MAR3,C1,Z)];
2482  MRGNO('20_LTRP',z) = SAM1('51_c_LTRP','150_M1c20_L_pvst',Z);
2483  MRGNO('21_WTRP',z) = SAM1('52_c_WTRP','151_M2c21_W_pvst',Z);
2484  MRGNO('22_ATRP',z) = SAM1('53_c_ATRP','152_M3c22_A_pvst',Z);
2485  TIMO(i,zj,z) = SUM[(ITAX1,C1)$[sam_sce19(zj,ITAX1)$sam_sce14(i,C1)], SAM1(ITAX1,C1,Z)];
2486  TIXO(i,z,zj) = SUM[(ETAX1,C1)$[sam_sce20(zJ,ETAX1)$sam_sce14(i,C1)], SAM1(ETAX1,C1,Z)];
2487   
2488  TIXO(i,z,zj)$(sameas(z,'06_PRK') or sameas(zj,'06_PRK')) = 0;
2489  * 북한 관련 수출세 일단 0으로 초기화
2490   
2491  TIWO2(l,j,z) = SUM[(tf1,A1)$[sam_sce17(l,tf1)$sam_sce13(j,A1)], SAM1(tf1,A1,Z)];
2492  TIWO2_J(l,z) = SUM(j, TIWO2(l,j,z));
2493  TIWO(j,z) = SUM(l, TIWO2(l,j,z));
2494  TIWO_J(z) = SUM(j, TIWO(j,z));
2495  TIKO(k,j,z) = SUM[(tf2,A1)$[sam_sce18(k,tf2)$sam_sce13(j,A1)], SAM1(tf2,A1,Z)];
2496  TIKO_J(k,z) = SUM(j, TIKO(k,j,z));
2497  TIPO(j,z) = SUM[(PTX1,A1)$[sam_sce13(j,A1)], SAM1(PTX1,A1,Z)];
2498  TICO(i,z) = SUM[(PTX1,C1)$[sam_sce14(i,C1)], SAM1(PTX1,C1,Z)];
2499  TDHO(z) = SUM[(DTX1),SAM1(DTX1,'175_TOT',Z)];
2500  DTAX('land',z) = SAM1('172_DIRTAX','55_Land',Z);
2501  DTAX('slab ',z) = SAM1('172_DIRTAX','56_UnSkLab',Z);
2502  DTAX('ulab',z) = SAM1('172_DIRTAX','57_SkLab',Z);
2503  DTAX('cap',z) = SAM1('172_DIRTAX','58_Capital',Z);
2504  DTAX('natr',z) = SAM1('172_DIRTAX','59_NatRes',Z);
2505  LDO2(l,j,Z) = SUM[(L1,A1)$[sam_sce15(l,L1)$sam_sce13(j,A1)], SAM1(L1,A1,Z)];
2506  LDO2_J(l,z) = SUM(j,LDO2(l,j,z));
2507  LDO(j,z) = SUM(l,LDO2(l,j,z));
2508  LDO_J(z) = SUM(j,LDO(j,z));
2509  RKDO(k,j,Z) = SUM[(K1,A1)$[sam_sce16(k,K1)$sam_sce13(j,A1)], SAM1(K1,A1,Z)];
2510  * Once again, to avoid descrepencies, domestic purchases are calculated by substracting imports, transport margins and indirect taxes from total domestic absorption.
2511  DDO(i,Z) = CO(i,Z)+CGO(i,Z)+INVO(i,Z)+SUM[j,DIO(i,j,Z)]-TICO(i,Z)-SUM[zj,TIMO(i,zj,Z)]-SUM[zj,IMO(i,zj,Z)]-SUM[(ij,zj),tmrg(ij,i,zj,Z)];
2512  MAKE(j,i,z) = SUM[(A1,C1)$[sam_sce13(j,A1)$sam_sce14(i,C1)], SAM1(A1,C1,Z)];
2513   
      *==============================================================================
      * Equilibrate data
      *==============================================================================
      * Equilibrium on the world margin market
      *  The first step would be to equilibrate international markets. As there is a small difference between supply of margins and demand, we chose to adjust
      *  the supply side by increasing or reducing each region's production proportionately.
      MRGNO(i,z)$MRGNO(i,z) = MRGNO(i,z)*SUM[(ij,zj,zjj),tmrg(i,ij,zj,zjj)] /SUM[zjj,MRGNO(i,zjj)];
       
      *Equilibrium in each region
      *  As exports have already been set equal to imports, the remaining differences would appear in the national data. Total production is first set equal to
      *  the sum of production for the domestic market (DSO), adjusted production of margins (MRGNO) and exports.
      DSO_I(i,z) = DDO(i,Z);
      XSO_I(i,z) = DDO(i,z)+MRGNO(i,z)+SUM[zj,EXO(i,z,zj)-TIXO(i,z,zj)]; 
      XSO(j,i,z) = XSO_I(i,z)*[MAKE(j,i,z)/sum(jj,MAKE(jj,i,z))];
      XSTO(j,z) = SUM(i, XSO(j,i,z));
      EXTO(i,z) = SUM[zj,EXO(i,z,zj)];
      DSO(j,i,z) = DDO(i,z)*[MAKE(j,i,z)/sum(jj,MAKE(jj,i,z))];
       
      *Balancing
      * The operating surplus is the variable that was used to equilibrate the regional data.
      * As all other variables (income, savings and so on) will be calculated based on the variables described in these steps, there should not be any other descrepency.
      RKDO('cap',j,z) = XSTO(j,z)-SUM[i,DIO(i,j,z)]-LDO(j,z)-TIWO(j,z)-TIPO(j,z)-SUM[k,TIKO(k,j,z)]-RKDO('land',j,z) -RKDO('natr',j,z);
      TotalCost(j,z) = SUM[i,DIO(i,j,z)]+LDO(j,z)+TIWO(j,z)+TIPO(j,z)+SUM[k,TIKO(k,j,z)+RKDO(k,j,z)];
2539   
2540  *==============================================================================
2541  * Equilibrate data (수정본: 북한 스케일 다운 방어 로직 포함)
2542  *==============================================================================
2543  * (1) 마진 보정 전의 원래 글로벌 마진 공급량 기억
2544  *PARAMETER MRGNO_OLD(i, z);
2545  *MRGNO_OLD(i, z) = MRGNO(i, z);
2546   
2547  * (2) 기존 코드: 북한의 마진 수요 감소에 맞춰 글로벌 마진 공급량을 자동으로 줄임
2548  *MRGNO(i,z)$MRGNO(i,z) = MRGNO(i,z)*SUM[(ij,zj,zjj),tmrg(i,ij,zj,zjj)] /SUM[zjj,MRGNO(i,zjj)];
2549   
2550  * (3) [추가] 증발한 마진 공급량 및 파트너국 수출량 계산
2551  PARAMETER
2552      TRADE_LOSS_EX(i, z)  "증발한 파트너 국가의 대북 수출액"
2553  *    MARGIN_LOSS(i, z)    "증발한 파트너 국가의 운송 마진 공급액"
2554  ;
2555   
2556  * 마진 손실량 = 원래 공급량 - 북한 수요 감소 반영 후 쪼그라든 공급량
2557  *MARGIN_LOSS(i, z) = MRGNO_OLD(i, z) - MRGNO(i, z);
2558   
2559  * 수출 손실량 = 원래 대북 수출량(SAM0) - 수정된 대북 수출량(SAM1)
2560  TRADE_LOSS_EX(i, z)$(not sameas(z,'06_PRK')) =
2561      SUM[(WORLD1,C1)$[sam_sce24(z,WORLD1)$sam_sce14(i,C1)], SAM0(WORLD1,C1,'06_PRK')]
2562    - SUM[(WORLD1,C1)$[sam_sce24(z,WORLD1)$sam_sce14(i,C1)], SAM1(WORLD1,C1,'06_PRK')];
2563   
2564  * (4) [핵심] 증발한 수출 및 마진 물량을 파트너 국가의 내수(DDO, CO)가 흡수하게 하여 RKDO 방어
2565  DDO(i, z)$(not sameas(z,'06_PRK')) = DDO(i, z) + TRADE_LOSS_EX(i, z) ;
2566  CO(i, z)$(not sameas(z,'06_PRK'))  = CO(i, z)  + TRADE_LOSS_EX(i, z) ;
2567   
2568  *DDO(i, z)$(not sameas(z,'06_PRK')) = DDO(i, z) + TRADE_LOSS_EX(i, z) + MARGIN_LOSS(i, z);
2569  *CO(i, z)$(not sameas(z,'06_PRK'))  = CO(i, z)  + TRADE_LOSS_EX(i, z) + MARGIN_LOSS(i, z);
2570   
2571  * for Data Balancing in 2019 Database
2572  TIPO('17_OTHERIND ','06_PRK')       =  -7.66751 -0.1;
2573  TIPO('22_eOil','06_PRK')                  = -0.696132 -3.00982-0.2-0.05;
2574  TIPO('13_IRONSTL','06_PRK')          =  -0.0799852 -0.1;
2575   
2576  *------------------------------------------------------------------------------
2577  * 이후 기존 잔차 및 밸런싱 코드 정상 작동 (XSO, RKDO 붕괴 방지됨)
2578  *------------------------------------------------------------------------------
2579  DSO_I(i,z) = DDO(i,Z);
2580  XSO_I(i,z) = DDO(i,z)+MRGNO(i,z)+SUM[zj,EXO(i,z,zj)-TIXO(i,z,zj)];
2581  XSO(j,i,z) = XSO_I(i,z)*[MAKE(j,i,z)/sum(jj,MAKE(jj,i,z))];
2582  XSTO(j,z)  = SUM(i, XSO(j,i,z));
2583  EXTO(i,z)  = SUM[zj,EXO(i,z,zj)];
2584  DSO(j,i,z) = DDO(i,z)*[MAKE(j,i,z)/sum(jj,MAKE(jj,i,z))];
2585   
2586  RKDO('cap',j,z) = XSTO(j,z)-SUM[i,DIO(i,j,z)]-LDO(j,z)-TIWO(j,z)-TIPO(j,z)-SUM[k,TIKO(k,j,z)]-RKDO('land',j,z) -RKDO('natr',j,z);
2587  TotalCost(j,z)  = SUM[i,DIO(i,j,z)]+LDO(j,z)+TIWO(j,z)+TIPO(j,z)+SUM[k,TIKO(k,j,z)+RKDO(k,j,z)];
