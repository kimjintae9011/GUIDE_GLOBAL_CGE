 984   sigma_M1('04_GAS',Z) = 6;
 985   
 986  * CES - IMP sourcing
 987   sigma_M2('03_OIL',Z) = 2;
 988   sigma_M2('04_GAS',Z) = 2;
 989   
 990   sigma_X0(j,z)  = 1.5;
 991  * CET - total output
 992   sigma_X2(i,Z)  = 2;
 993   
 994  * CES - composite Power sector
 995  * sigma_X4(z)    = 4;
 996   sigma_X4(z)    = 2;
 997   
 998  * Investment demand elasticity
 999   sigma_INV(k,j,z) = 2;
1000   
1001  * LES parameters - Frisch all (1.1)
1002   frisch(z)  = PARZ(z,'frisch');
1003   frisch(z)  = -1.8;
