 977   sigma_ENER_elec(j2,z)        = 2.0 ;
 978   sigma_ENER_nelec(j2,z)      = 2.0 ;
 979   sigma_ENER_coalgas(j2,z)   = 1.5;
 980   sigma_ENER_oilprod(j2,z)    = 0.5 ;
 981   
 982  * CES - DOM vs.IMP
