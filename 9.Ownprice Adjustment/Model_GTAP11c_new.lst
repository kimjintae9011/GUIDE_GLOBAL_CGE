3682   EGIOilGWh('22_eOil',z)     = ElecOilGWh('22_eOil',z)/DSO_J('22_eOil',z);
3683   EGIWindGWh('23_eWind',z)   = ElecWindGWh('23_eWind',z)/DSO_J('23_eWind',z);
3684   EGISolarGWh('24_eSolar',z) = ElecSolarGWh('24_eSolar',z)/DSO_J('24_eSolar',z);
3685   EGIHydroGWh('25_eHydro',z) = ElecHydroGWh('25_eHydro',z)/DSO_J('25_eHydro',z);
3686   EGIWasteGWh('26_eOther',z) = ElecWasteGWh('26_eOther',z)/DSO_J('26_eOther',z);
3687   EGIBioGWh('26_eOther',z)   = ElecBioGWh('26_eOther',z)/DSO_J('26_eOther',z);
3688   EGIGeoGWh('26_eOther',z)   = ElecGeoGWh('26_eOther',z)/DSO_J('26_eOther',z);
3689   EGIOtherGWh('26_eOther',z) = ElecOtherGWh('26_eOther',z)/DSO_J('26_eOther',z);
