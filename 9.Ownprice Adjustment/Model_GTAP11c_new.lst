5171   TIW_Share.L(j,z,time)      = TIW_Share.L(j,z,time-1);
5172  * deltatik.L(j,z,time)       = deltatik.L(j,z,time-1);
5173  * ttik.L('cap',j,z,time)     = ttik.L('cap',j,z,time-1);
5174  * ttik_lag.L(j,z,time)       = ttik_lag.L(j,z,time-1);
5175  * TIK_Share.L(j,z,time)      = TIK_Share.L(j,z,time-1);
5176  * deltatip.L(j,z,time)       = deltatip.L(j,z,time-1);
5177  * ttip.L(j,z,time)           = ttip.L(j,z,time-1);
5178  * ttip_lag.L(j,z,time)       = ttip_lag.L(j,z,time-1);
5179  * TIP_Share.L(j,z,time)      = TIP_Share.L(j,z,time-1);
5180   TIX.L(i,z,zj,time)         = TIX.L(i,z,zj,time-1);
5181   TIXT.L(z,time)             = TIXT.L(z,time-1);
5182   TPRODN.l(z,time)           = TPRODN.l(z,time-1);
5183   TPRCTS.l(z,time)           = TPRCTS.l(z,time-1);
5184   YDH.L(z,time)              = YDH.L(z,time-1);
5185   YG.L(z,time)               = YG.L(z,time-1);
5186   YH.L(z,time)               = YH.L(z,time-1);
5187   YHK.L(z,time)              = YHK.L(z,time-1);
5188   YHL.L(z,time)              = YHL.L(z,time-1);
5189   YROW.L(z,time)             = YROW.L(z,time-1);
5190   
5191  *============================================================================
5192  *   A.2.4 Rates and intercepts
5193  *==============================================================================
5194   phi.L(z,time)       = phi.L(z,time-1);
5195   
5196  };
5197   
5198  *==============================================================================
5199  *   6.1.1.1 Lower bounds on some variables
5200  *==============================================================================
5201   
5202  *==============================================================================
5203  *   6.1.3 Closures
5204  *==============================================================================
5205  *$ontext
5206  * FP CLOSURE: fixed PIXGDPs; numeraire is exchange rate of reference region
5207  * The exchange rates are endogenous, except for the reference region.
5208   e.FX(zr,time)      = eO(zr);
5209   PIXGDP.FX(z,time)  = PIXGDPO(z)/sum[zr,eO(zr)];
5210  *$offtext
5211   
      * FE CLOSURE: fixed exchange rates; numeraire is PIXGDP of reference region
      * The exchange rates can be fixed at arbitrary values
       PIXGDP.FX(zr,time)  = PIXGDPO(zr);
       e.FX(z,time)        = eO(z);
5218   
5219  *==============================================================================
5220  *   6.2.2.2 Variables fixed each period according to their lagged values
5221  *==============================================================================
5222   CABX.FX(z1,time)   = CABXO(z1)*cabix(z1,time);
5223   
5224   CMIN.FX(i,z,t1)    = CMINO(i,z);
5225   CMIN.FX(i,z,time)$[ord(time) gt 1]
5226                             = CMIN.l(i,z,time-1)*[1+g_GDP(z,time)];
5227   
5228   KD.fx(k,j,z,t1)$KDO(k,j,z)
5229                             = KDO(k,j,z);
5230   KD.fx(k,j,z,time)${[ord(time) gt 1] and KDO(k,j,z)}
5231                             = KD.l(k,j,z,time-1)*[1-delta(z)]+IND.l(k,j,z,time-1);
5232   
5233   LST.FX(z,t1)    = LSTO(z);
5234   LST.FX(z,time)$[ord(time) gt 1]
5235                        = LST.l(z,time-1)*[1+g_POP(z,time)];
5236   
5237   LS_lag(z,t1)    = LSO(z);
5238   LS_lag(z,time)$[ord(time) gt 1]
5239                        = LS.l(z,time-1);
5240   
5241   LST_lag(z,t1)   = LSTO(z);
5242   LST_lag(z,time)$[ord(time) gt 1]
5243                        = LST.l(z,time-1);
5244   
5245   W_lag(z,t1)    = WO_lag(z);
5246   W_lag(z,time)$[ord(time) gt 1]
5247                       = W.l(z,time-1);
5248   
5249   PIXCON_lag(z,t1)   = PIXCONO_lag(z);
5250   PIXCON_lag(z,time)$[ord(time) gt 1]
5251                      = PIXCON.l(z,time-1);
5252   
5253  *==============================================================================
5254  *   CTAX and PERMIT and TCTAX Recycling
5255  *==============================================================================
5256  * CTAX.fx(z,time)$[ord(time) gt 1]
5257  *                            = CTAX_Cal(z,time);
5258   
5259  * PERMIT_TOTAL.fx(z,time)$[ord(time) gt 1]
5260  *                             = PERMIT_TOTALO(Z)*PERMIT_Cal(z,time);
5261   
5262   recycle_gov(z,time)     = 0 ;
5263   recycle_hou(z,time)     = 1 ;
5264   recycle_labor(z,time)   = 0 ;
5265   recycle_capital(z,time) = 0 ;
5266   recycle_ptax(z,time)    = 0 ;
5267   
5268  *==============================================================================
5269  *  AEEI
5270  *==============================================================================
5271   AEEI(z,time) = 1;
5272   
5273  *==============================================================================
5274  * For Own price elasticity experiment  2
5275  *==============================================================================
5276  PC.fx("02_COAL",'01_KOR',time) = PCO("02_COAL",'01_KOR')*(1+0.01);
5277   
5278  *==============================================================================
5279  *   6.2.2.3 Resolution
5280  *==============================================================================
5281  SOLVE CGE USING CNS;
5282   
5283  * The single element in subset T(time) is removed, and the subset is now empty.
5284  T(time)          = NO;
5285  * End of LOOP over time periods
5286  ];
5287   
5288  *==============================================================================
5289  *   6.2.3 Results
5290  *==============================================================================
5291  *   In this file, values for the BAU scenario are computed and saved
5292  *   for the construction of result tables.
5293   
5294  *==============================================================================
5295  *   6.2.3.1 Declaration of parameters to store results
5296  *==============================================================================
5297  PARAMETER
5298   valPC(ene,z,time,scen)        Purchaser price of composite commodity i (including all taxes and margins) in region z
5299   valQ(ene,z,time,scen)         Quantity demanded of composite commodity i in region z
5300   valDE(ene,j,z,time,scen)     Intermediate consumption(energy) of commodity i by industry j in region z
5301   valC(ene,z,time,scen)         Consumption of commodity i by households in region z
5302   valcoal_elas(z)
5303   valgas_elas(z)
5304   valpetrolcoal_elas(z)
5305   valelec_elas(z)
5306   valsigma_Y(i,z,scen)
5307  ;
5308   
5309  *==============================================================================
5310  *   6.2.3.2 Assignment of solution values to result parameters
5311  *==============================================================================
5312   valPC(ene,z,time,'bau')      = PC.l(ene,z,time);
5313   valQ(ene,z,time,'bau')       = Q.l(ene,z,time);
5314   valDE(ene,j,z,time,'bau')   = DE.l(ene,j,z,time);
5315   valC(ene,z,time,'bau')       = C.l(ene,z,time);
5316   valcoal_elas(z)                 = ((valQ('02_COAL',z,'2019','bau')-QO('02_COAL',z))/QO('02_COAL',z))/((valPC('02_COAL',z,'2019','bau')-PCO('02_COAL',z))/PCO('02_COAL',z));
5317   valgas_elas(z)                  = ((valQ('04_GAS',z,'2019','bau')-QO('04_GAS',z))/QO('04_GAS',z))/((valPC('04_GAS',z,'2019','bau')-PCO('04_GAS',z))/PCO('04_GAS',z));
5318   valpetrolcoal_elas(z)         = ((valQ('10_PETROLCOAL',z,'2019','bau')-QO('10_PETROLCOAL',z))/QO('10_PETROLCOAL',z))/((valPC('10_PETROLCOAL',z,'2019','bau')-PCO('10_PETROLCOAL',z))/PCO('10_PETROLCOAL',z));
5319   valelec_elas(z)                  = ((valQ('18_ELEC',z,'2019','bau')-QO('18_ELEC',z))/QO('18_ELEC',z))/((valPC('18_ELEC',z,'2019','bau')-PCO('18_ELEC',z))/PCO('18_ELEC',z));
5320   valsigma_Y(ene,z,scen)      = sigma_Y(ene,z);
5321   
5322  * GDX 파일명을 짧게 변경하여 경로 오류 가능성을 줄입니다.
5323  execute_unload 'valelas', valPC, valQ, valC, valDE, valcoal_elas,  valgas_elas,  valpetrolcoal_elas,  valelec_elas,   valsigma_Y ;
5324   
      execute_unload 'valcoal_elas', valcoal_elas  ;
      execute_unload 'valgas_elas', valgas_elas  ;
      execute_unload 'valpetrolcoal_elas', valpetrolcoal_elas  ;
      execute_unload 'valelec_elas', valelec_elas  ;
       
      execute 'gdxxrw.exe valcoal_elas.gdx par=valcoal_elas rng=Sheet1!a1' ;
      execute 'gdxxrw.exe valgas_elas.gdx par=valgas_elas rng=Sheet1!a1' ;
      execute 'gdxxrw.exe valpetrolcoal_elas.gdx par=valpetrolcoal_elas rng=Sheet1!a1' ;
      execute 'gdxxrw.exe valelec_elas.gdx par=valelec_elas rng=Sheet1!a1' ;

