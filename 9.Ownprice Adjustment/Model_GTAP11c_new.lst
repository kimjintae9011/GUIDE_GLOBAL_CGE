1017   sigma_KLE('06_FOODPRO ','01_KOR')        = 0.5 ;
1018   sigma_KLE('07_TEXTILES','01_KOR')        = 0.5 ;
1019   sigma_KLE('08_WOODPRO','01_KOR')        = 0.5 ;
1020   sigma_KLE('09_PAPERPRO','01_KOR')        = 0.5 ;
1021   sigma_KLE('11_CHEMICAL','01_KOR')        = 0.5 ;
1022   sigma_KLE('12_NONMET','01_KOR')         = 0.5 ;
1023   sigma_KLE('13_IRONSTL','01_KOR')         = 0.5 ;
1024   sigma_KLE('14_NONFERR','01_KOR')         = 0.5 ;
1025   sigma_KLE('15_MACHINE','01_KOR')         = 0.5 ;
1026   sigma_KLE('16_TRANSEQ','01_KOR')         = 0.5 ;
1027   sigma_KLE('17_OTHERIND','01_KOR')        = 0.5 ;
1028   sigma_KLE('31_SER ','01_KOR')                 = 0.5 ;
1029   
1030   sigma_ENER_elec(j,'01_KOR') = 0.1 ;
1031   
1032   sigma_Y('18_ELEC','01_KOR') = 0.1* sigma_Y('18_ELEC','01_KOR');
1033   
1034   
1035  *Coal
1036   sigma_KLE('20_eCoal','01_KOR')                 = 1.2;
1037   sigma_ENER_elec('20_eCoal','01_KOR')       = 0.4;
1038   sigma_ENER_nelec('20_eCoal','01_KOR')      = 0.4 ;
1039   sigma_ENER_coalgas('20_eCoal','01_KOR')  = 1.5;
1040   sigma_ENER_oilprod('20_eCoal','01_KOR')   = 0.4 ;
1041   
1042  *Gas
1043   sigma_ENER_coalgas(j,'01_KOR')  = 1.1;
1044   sigma_ENER_nelec(j,'01_KOR') = 0.5 ;
1045   
1046   sigma_Y('04_GAS','01_KOR') = 0.1* sigma_Y('04_GAS','01_KOR');
1047   
1048  *PetrolCoal
1049   sigma_KLE('10_PETROLCOAL','01_KOR')     = 0.5 ;
1050   sigma_KLE('11_CHEMICAL','01_KOR')         = 0.5 ;
1051   sigma_KLE('22_eOil','01_KOR')         = 0.5 ;
1052   sigma_KLE('28_LTRP','01_KOR')                 = 0.5 ;
1053   
1054   sigma_ENER_nelec(j,'01_KOR') = 0.5 ;
1055   sigma_ENER_oilprod(j,'01_KOR')   = 0.1 ;
1056   
1057  * sigma_Y('10_PETROLCOAL','01_KOR') = 0.1* sigma_Y('10_PETROLCOAL','01_KOR');
1058  *$offtext
1059  *==============================================================================
1060  *   Rescaling
1061  *==============================================================================
1062  * GTAP data are in millions of US dollars With RES = 10000, model results are in tens of billions (10G$)
1063  RES              = 10000;
1064  CO(i,z)          = CO(i,z)/RES;
1065  CGO(i,z)         = CGO(i,z)/RES;
1066  DDO(i,z)         = DDO(i,z)/RES;
1067  DEPO(z)          = DEPO(z)/RES;
1068  DIO(i,j,z)       = DIO(i,j,z)/RES;
1069  DSO(j,i,z)       = DSO(j,i,z)/RES;
1070  DSO_I(i,z)       = DSO_I(i,z)/RES;
1071  EXO(i,z,zj)      = EXO(i,z,zj)/RES;
1072  IMO(i,z,zj)      = IMO(i,z,zj)/RES;
1073  INVO(i,z)        = INVO(i,z)/RES;
1074  KSTO(z)          = KSTO(z)/RES;
1075  LDO(j,z)         = LDO(j,z)/RES;
1076  MRGNO(i,z)       = MRGNO(i,z)/RES;
1077  RKDO(k,j,z)      = RKDO(k,j,z)/RES;
1078  TDHO(z)          = TDHO(z)/RES;
1079  TICO(i,z)        = TICO(i,z)/RES;
1080  TIKO(k,j,z)      = TIKO(k,j,z)/RES;
1081  TIMO(i,z,zj)     = TIMO(i,z,zj)/RES;
1082  TIPO(j,z)        = TIPO(j,z)/RES;
1083  TIWO(j,z)        = TIWO(j,z)/RES;
1084  TIXO(i,z,zj)     = TIXO(i,z,zj)/RES;
1085  tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj)/RES;
1086  XSO_I(i,z)       = XSO_I(i,z)/RES;
1087  XSO(j,i,z)       = XSO(j,i,z)/RES;
1088  XSTO(j,z)        = XSTO(j,z)/RES;
1089   
1090  *==============================================================================
1091  *  3.3 Exogenous prices and parameters
1092  *==============================================================================
1093  *  Price elasticity (should be equal to one to verify homogeneity)
1094  eta = 1;
1095   
1096  *------------------------------------------------------------------------------
1097  *  Slopes of taxation functions
1098  *   One can either choose to assign a value to the intercepts and calibrate
1099  *   the slopes accordingly, or the other way around. This type of modelling
1100  *   can be useful to take into account known marginal savings or taxation rates
1101  *   or to deal with negative average saving rates in cases where savings are
1102  *   negative for some household groups.
1103  *   When no further information is available, one can simply set the intercepts
1104  *   to zero and calibrate an average rate: this is what we do here for ttdh0O.
1105  *   If the user wishes to assume otherwise, he can fill the appropriate area in
1106  *   the Excel file VAL_PAR.xls.
1107  * ttdh0O(z)       = PARZ(z,'ttdh0O');
1108   ttdh0O(z)       = 0;
1109  *   The slope ttdh1O is calibrated below in the mane GAMS file
1110   
1111  *------------------------------------------------------------------------------
1112  * Also we need to assign values to some prices
1113  * All of the prices below, EXCEPT eO, may be set at arbitrary values
1114  * without loss of generality.
1115  *
1116  * In the case of eO, although exchange rates may be given arbitrary values
1117  * in the model, they must all be equal for calibration at this stage. The reason
1118  * is that the supply of margin transport services MRGNO must equal global demand.
1119  * Since there is a single world price for international transport margins
1120  * (rather than bilateral world prices for other commodities) the unit of
1121  * measurement of the volume of margin services must be the same for all regions,
1122  * and in turn, that implies that the divisor that converts the nominal value to
1123  * volume be the same for all regions. Since that divisor involves the exchange
1124  * rate, all exchange rates must be equal.
1125   
1126  * Normally, prices that may be given arbitrary values are set at 1:
1127   eO(z)            = 1;
1128   PEO(i,z,zj)      = 1;
1129   PLO(i,z)         = 1;
1130   PWMGO(i)         = 1;
1131   WO(z)            = 1;
1132   WO_lag(z)        = WO(z) ;
1133   
1134  *==============================================================================
1135  * Calibration
1136  *==============================================================================
1137   YHKO(z)         = SUM[(k,j),RKDO(k,j,z)];
1138   YHLO(z)         = SUM[(j),LDO(j,z)];
1139   YHO(z)          = YHLO(z)+YHKO(z);
1140   YDHO(z)         = YHO(z)-TDHO(z);
1141   CTHO(z)         = SUM[i,CO(i,z)];
1142   SHO(z)          = YDHO(z)-CTHO(z);
1143   TICTO(z)        = SUM[i,TICO(i,z)];
1144   TIMTO(z)        = SUM[(i,zj),TIMO(i,zj,z)];
1145   TIWTO(z)        = SUM[(j),TIWO(j,z)];
1146   TIKTO(z)        = SUM[(k,j),TIKO(k,j,z)];
1147   TIPTO(z)        = SUM[j,TIPO(j,z)];
1148   TIXTO(z)        = SUM[(i,zj),TIXO(i,z,zj)];
1149   TPRODNO(z)      = TIKTO(z)+TIWTO(z)+TIPTO(z);
1150   TPRCTSO(z)      = TICTO(z)+TIMTO(z)+TIXTO(z);
1151   YGO(z)          = TDHO(z)+TPRCTSO(z)+TPRODNO(z);
1152   GO(z)           = SUM[i,CGO(i,z)];
1153   SGO(z)          = YGO(z)-GO(z);
1154   YROWO(z)        = SUM[(i,zj),IMO(i,zj,z)]+SUM[(i,ij,zj),tmrg(i,ij,zj,z)];
1155   SROWO(z)        = YROWO(z)-SUM[(i,zj),EXO(i,z,zj)]-SUM[i,MRGNO(i,z)];
1156   CABO(z)         = -SROWO(z);
1157   ITO(z)          = SHO(z)+SGO(z)+SROWO(z);
1158   
1159  *==============================================================================
1160  *  Calibration of parameters and other variables
1161  *==============================================================================
1162  *  Calibration of investment and government spending shares
1163  *==============================================================================
1164   gamma_GVT(i,z)  = CGO(i,z)/SUM[ij,CGO(ij,z)];
1165   gamma_INV(i,z)  = INVO(i,z)/SUM[ij,INVO(ij,z)] ;
1166   
1167  *==============================================================================
1168  *  Calibration of other prices and revised volumes (part 1)
1169  *==============================================================================
1170   LDO(j,z)      = LDO(j,z)/WO(z);
1171   LDCO(j,z)     = LDO(j,z);
1172   LSO(z)        = SUM[j,LDO(j,z)];
1173   LSTO(z)       = LSO(z) ;
1174   LSO_lag(z)    = LSO(z) ;
1175   LSTO_lag(z)   = LSO(z) ;
1176   EXO(i,z,zj)  = [EXO(i,z,zj)-TIXO(i,z,zj)]/PEO(i,z,zj);
1177   EXTO(i,z)    = SUM[zj,EXO(i,z,zj)];
1178   PWXO(i,z,zj)$EXO(i,z,zj)
1179                   = {[PEO(i,z,zj)*EXO(i,z,zj)+TIXO(i,z,zj)]/EXO(i,z,zj)}/eO(z);
1180   
1181   PETO(i,z)       = SUM[zj,PEO(i,z,zj)*EXO(i,z,zj)]/EXTO(i,z);
1182  * PETO(i,z)$(EXTO(i,z) > 0) = SUM[zj, PEO(i,z,zj) * EXO(i,z,zj)] / EXTO(i,z);
1183  * PETO(i,z)$(EXTO(i,z) = 0) = 0;
1184   PWMO(i,z,zj)    = PWXO(i,z,zj);
1185   IMO(i,zj,z)     = EXO(i,zj,z);
1186   IMTO(i,z)       = SUM[zj,IMO(i,zj,z)];
1187   
1188   DSO(j,i,z)      = DSO(j,i,z)/PLO(i,z);
1189   DSO_I(i,z)      = SUM(j,DSO(j,i,z));
1190   DSO_J(j,z)      = SUM(i,DSO(j,i,z));
1191   QO(i,z)         = IMTO(i,z)+DDO(i,z);
1192   
1193   MRGNO(i,z)$MRGNO(i,z)
1194                   = MRGNO(i,z)/[eO(z)*PWMGO(i)];
1195   
1196   XSO_I(i,z)      = EXTO(i,z)+DDO(i,z)+MRGNO(i,z);
1197   
1198   XSTO(j,z)       = sum(i, XSO(j,i,z));
1199   
1200   PO(i,z)         = [PETO(i,z)*EXTO(i,z)+PLO(i,z)*DSO_I(i,z)
1201                    +eO(z)*PWMGO(i)*MRGNO(i,z)]/XSO_I(i,z);
1202   
1203   PO2(j,i,z)$XSO(j,i,z) = 1;
1204   
1205   PO3(i,j,z)$XSO(j,i,z) = 1;
1206   
1207   PIO(i,z)       = SUM[j$XSO(j,i,z),PO2(J,I,z)*XSO(j,i,z)]/XSO_I(i,z);
1208   
1209   PTO(j,z)       = SUM[i$XSO(j,i,z),PO2(j,i,z)*XSO(j,i,z)]/XSTO(j,z);
1210   
1211   PPO(j,z)       = (TIWO(j,z)+WO(z)*LDO(j,z)
1212                    +SUM[k,TIKO(k,j,z)+RKDO(k,j,z)]
1213                    +SUM[nene,DIO(nene,j,z)]+SUM[ene,DIO(ene,j,z)])/XSTO(j,z);
1214   
1215   theta2(j,i,z)  = DSO(j,i,z)/sum(jj, DSO(jj,i,z));
1216   
1217   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z)*EXTO(i,z);
1218   
1219  *==============================================================================
1220  *  Calibration of tax rates, margins, prices and volumes
1221  *==============================================================================
1222  *  Margin rates and tax rates
1223  *==============================================================================
1224   ttixO(i,z,zj)   = [eO(z)*PWXO(i,z,zj)/PEO(i,z,zj)]-1;
1225   tticO(i,z)      = TICO(i,z)/{PLO(i,z)*DDO(i,z)
1226                     +SUM[zj,IMO(i,zj,z)*eO(z)*PWMO(i,zj,z)
1227                     +TIMO(i,zj,z)+SUM[ij,tmrg(ij,i,zj,z)]]};
1228   
1229   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
1230                   = tmrg(i,ij,zj,z)/(PWMGO(i)*eO(z)*IMO(ij,zj,z));
1231   
1232   ttimO(i,zj,z)$IMO(i,zj,z)
1233                   = TIMO(i,zj,z)/{IMO(i,zj,z)*eO(z)*(PWMO(i,zj,z)
1234                    +SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])};
1235   
1236   ttiwO(j,z)$LDO(j,z)
1237                   = TIWO(j,z)/[WO(z)*LDO(j,z)];
1238   
1239   ttikO(k,j,z)$RKDO(k,j,z)
1240                   = TIKO(k,j,z)/RKDO(k,j,z);
1241   
1242   ttipO(j,z)      = [PTO(j,z)/PPO(j,z)]-1;
1243   
1244   ttdh1O(z)       = [TDHO(z)-ttdh0O(z)]/YHO(z);
1245   
1246  *==============================================================================
1247  *  Calibration of other prices and revised volumes (part 2)
1248  *==============================================================================
1249   PDO(i,z)        = PLO(i,z)*(1+tticO(i,z));
1250   PMO(i,zj,z)     = eO(z)*(PWMO(i,zj,z)+SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])
1251                   *(1+ttimO(i,zj,z))*(1+tticO(i,z));
1252   PMTO(i,z)       = SUM[zj,PMO(i,zj,z)*IMO(i,zj,z)]/IMTO(i,z);
1253   PCO(i,z)        = [PMTO(i,z)*IMTO(i,z)+PDO(i,z)*DDO(i,z)]/QO(i,z);
1254   
1255   CO(i,z)         = CO(i,z)/PCO(i,z);
1256   CGO(i,z)        = CGO(i,z)/PCO(i,z);
1257   DIO(nene,j,z)   = DIO(nene,j,z)/PCO(nene,z);
1258   DEO(ene,j,z)    = DIO(ene,j,z)/PCO(ene,z);
1259   
1260   DEelecO(j,z)    = DIO("18_ELEC",j,z)/PCO("18_ELEC",z);
1261   DEnelecO(j,z)   = sum(ene3,DEO(ene3,j,z));
1262   
1263   DEcoalgasO(j,z) = sum(ene5,DEO(ene5,j,z));
1264   DEcoalO(j,z)    = DEO("02_COAL ",j,z);
1265   DEgasO(j,z)     = DEO("04_GAS",j,z);
1266   
1267   DEoilpetrolO(j,z) = sum(ene6,DEO(ene6,j,z));
1268   DEoilO(j,z)       = DEO("03_OIL",j,z);
1269   DEpetrolO(j,z)    = DEO("10_PETROLCOAL",j,z);
1270   
1271   INVO(i,z)       = INVO(i,z)/PCO(i,z);
1272   
1273   CIO(j,z)        = SUM[nene,DIO(nene,j,z)];
1274   CEO(j3,z)        = SUM[ene,DEO(ene,j3,z)];
1275   CEO(j2,z)        = DEelecO(j2,z)+DEnelecO(j2,z);
1276   
1277   DITO(nene,z)    = SUM[j,DIO(nene,j,z)];
1278   DITO(ene,z)     = SUM[j,DEO(ene,j,z)];
1279   
1280   PO4(ene,j,z)    = PCO(ene,z);
1281   
1282   PCIO(j,z)       = SUM[nene,PCO(nene,z)*DIO(nene,j,z)]/CIO(j,z);
1283   
1284   PCEcoalO(j,z)   = PO4("02_COAL",j,z) ;
1285   PCEgasO(j,z)    = PO4("04_GAS",j,z) ;
1286   PCEoilO(j,z)    = PO4("03_OIL",j,z) ;
1287   PCEpetrolO(j,z) = PO4("10_PETROLCOAL",j,z) ;
1288   
1289   PCEoilpetrolO(j,z)  = [PCEoilO(j,z)*DEoilO(j,z)+PCEpetrolO(j,z)*DEpetrolO(j,z)]
1290                     /DEoilpetrolO(j,z) ;
1291   
1292   PCEcoalgasO(j,z)  = [PCEcoalO(j,z)*DEcoalO(j,z)+PCEgasO(j,z)*DEgasO(j,z)]
1293                     /DEcoalgasO(j,z) ;
1294   
1295   PCEnelecO(j,z)  = [PCEcoalgasO(j,z)*DEcoalgasO(j,z)+PCEoilpetrolO(j,z)*DEoilpetrolO(j,z)]
1296                     /DEnelecO(j,z) ;
1297   
1298   PCEelecO(j,z)   = SUM[ene4,PCO(ene4,z)*DEO(ene4,j,z)]/DEelecO(j,z) ;
1299   PCEO(j,z)       = [PCEelecO(j,z)*DEelecO(j,z)+PCEnelecO(j,z)*DEnelecO(j,z)]/CEO(j,z) ;
1300   PCEO(j3,z)       = SUM[ene,PCO(ene,z)*DEO(ene,j3,z)]/CEO(j3,z) ;
1301   WTIO(j,z)     = WO(z)*(1+ttiwO(j,z));
1302   WCO(j,z)$LDCO(j,z)
1303                   = (WTIO(j,z)*LDO(j,z))/LDCO(j,z);
1304   
1305  *==============================================================================
1306  *  Calibration of dynamic parameters
1307  *==============================================================================
1308  * Calibration of dynamic parameters following new procedure.
1309  * The price of capital is arbitrary:
1310   PKO(z) = 1;
1311   
1312  * The calibration of depreciation rates is based on two hypotheses:
1313  * 1. The rate of depreciation is the same for all types of capital and all
1314  *    industries in each region (this hypothesis is made to accommodate the fact
1315  *    that, in the GTAP data base, capital consumption allowance is not detailed;
1316  *    as a matter of fact, the GTAP capital consumption allowance is set at
1317  *    4% of the value of the capital stock).
1318  * 2. The rental rate of capital is uniform across industries and types of
1319  *    capital in each region.
1320  * 3. The investment rate (IND/KD) is uniform across industries and types of
1321  *    capital in each region.
1322  * These hypotheses lead to the following formulae:
1323   
1324  * From GTAP, we know KSTO.
1325   KSTO(z)         = KSTO(z)/PKO(z);
1326   
1327  * Assuming a uniform depreciation rate for all types
1328  * of capital and all industries:
1329   delta(z)        = DEPO(z)/[PKO(z)*KSTO(z)];
1330   
1331  * From GTAP, we know KSTO. Assuming a uniform rental rate R for all types
1332  * of capital and all industries:
1333   RO(k,j,z)$RKDO(k,j,z)
1334                   = SUM[(kj,jj),RKDO(kj,jj,z)]/KSTO(z);
1335   
1336  * Then from the GTAP value of income paid to capital RKD we calibrate KDO:
1337   KDO(k,j,z)$RKDO(k,j,z)
1338                   = RKDO(k,j,z)/RO(k,j,z);
1339   
1340  * The supply of capital is equal to demand:
1341   KSO(k,z)        = SUM[j,KDO(k,j,z)];
1342   
1343  * The rate of return on capital, net of depreciation, is:
1344   IRO(z)         = {SUM[(k,j)$RKDO(k,j,z),RKDO(k,j,z)]-DEPO(z)}/[PKO(z)*KSTO(z)];
1345   
1346  * The user cost of capital follows
1347   UO(z)           = PKO(z)*(IRO(z)+delta(z));
1348   
1349  * Combining
1350  * - the hypothesis of uniform investment rates
1351  * - the hypothesis of uniform rental rates
1352  * - the hypothesis of uniform depreciation rates
1353  * leads to
1354   phiO(z)         = [ITO(z)/PKO(z)]/KSTO(z);
1355   
1356  * Investment by destination follows:
1357   INDO(k,j,z)$KDO(k,j,z)
1358                   = phiO(z)*KDO(k,j,z);
1359   
1360   A_K(z)          = 1/PKO(z)*{PROD[i$gamma_INV(i,z),(PCO(i,Z)/gamma_INV(i,z))
1361                     **gamma_INV(i,z)]};
1362   
1363   KDCO(j,z)       = SUM[k,KDO(k,j,z)];
1364   RTIO(k,j,z)     = RO(k,j,z)*(1+ttikO(k,j,z));
1365   RCO(j,z)$KDCO(j,z)
1366                   = SUM[k,RTIO(k,j,z)*KDO(k,j,z)]/KDCO(j,z);
1367   
1368  *==============================================================================
1369  *  Calibration of other prices and revised volumes (part 3)
1370  *==============================================================================
1371   VAO(j,z)        = LDCO(j,z)+KDCO(j,z);
1372   
1373   PVAO(j,z)       = [WCO(j,z)*LDCO(j,z)+RCO(j,z)*KDCO(j,z)]/VAO(j,z);
1374   
1375  * PIXGDPO is tautologically equal to 1, based on its formula
1376  * PIXGDPO(z)      = {SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1377  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1378  *                   *SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1379  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]}**0.5;
1380   PIXGDPO(z)      = 1;
1381   
1382  * PIXGDP_WO is tautologically equal to 1, based on its formula
1383  * PIXGDP_WO       = {SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1384  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1385  *                   *SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1386  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]/eO(z)}**0.5;
1387   PIXGDP_WO       = 1;
1388   
1389  * PIXCONO(z) is tautologically equal to 1, based on its formula
1390  * PIXCONO(z)      = SUM[i,PCO(i,z)*CO(i,z)]
1391  *                  /SUM[i,PCO(i,z)*CO(i,z)];
1392   PIXCONO(z)      = 1;
1393   PIXCONO_lag(z)  = PIXCONO(z);
1394   
1395  * PIXINVO(z) is tautologically equal to 1, based on its formula
1396  * PIXINVO(z)      = PROD[i$gamma_INV(i,z),(PCO(i,z)/PCO(i,z))**gamma_INV(i,z)];
1397   PIXINVO(z)      = 1;
1398   
1399  * PIXGVTO(z) is tautologically equal to 1, based on its formula
1400  * PIXGVTO(z)      = PROD[i$gamma_GVT(i,z),(PCO(i,z)/PCO(i,z))**gamma_GVT(i,z)];
1401   PIXGVTO(z)      = 1;
1402   
1403  *==============================================================================
1404  *  Calibration of function parameters
1405  *==============================================================================
1406  *   Leontief functions
1407  *==============================================================================
1408   io(j,z)         = CIO(j,z)/XSTO(j,z) ;
1409   
1410   io2(j,z)        = CEO(j,z)/XSTO(j,z) ;
1411   
1412   v(j,z)          = VAO(j,z)/XSTO(j,z) ;
1413   
1414   v2(j,z)         = (CEO(j,z)+VAO(j,z))/XSTO(j,z) ;
1415   
1416   aij(nene,j,z)   = DIO(nene,j,z)/CIO(j,z);
1417   
1418   aij2(ene,j,z)   = DEO(ene,j,z)/CEO(j,z);
1419   
1420   aij2_t(ene,j,z,time) =  aij2(ene,j,z);
1421   
1422  *==============================================================================
1423  *   Calibration of CET parameters
1424  *==============================================================================
1425  *    CET between total exports, domestic supply and margins
1426  *==============================================================================
1427   rho_X1(i,z)     = (1+sigma_X1(i,z))/sigma_X1(i,z);
1428   
1429   beta_EX_X1(i,z)$MRGNO(i,z)
1430                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1431                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1432                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1433                     eO(z)*PWMGO(i)*MRGNO(i,z)$MRGNO(i,z)**(1-rho_X1(i,z))];
1434   
1435   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1436                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1437                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1438                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1439   
1440   beta_D_X1(i,z)$MRGNO(i,z)
1441                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1442                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1443                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1444                     eO(z)*PWMGO(i)*MRGNO(i,z)**(1-rho_X1(i,z))];
1445   
1446   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1447                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1448                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1449                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1450   
1451   B_X1(i,z)       = XSO_I(i,z)/[beta_EX_X1(i,z)*EXTO(i,z)**rho_X1(i,z)
1452                    +beta_D_X1(i,z)*DSO_I(i,z)**rho_X1(i,z)+(1-beta_EX_X1(i,z)
1453                    -beta_D_X1(i,z))*MRGNO(i,z)**rho_X1(i,z)]**(1/rho_X1(i,z));
1454   
1455  *==============================================================================
1456  *    CET between exports to different trading partners
1457  *==============================================================================
1458   rho_X2(i,z)     = (1+sigma_X2(i,z))/sigma_X2(i,z);
1459   
1460   beta_X2(i,z,zj)$EXO(i,z,zj)
1461                   = [PEO(i,z,zj)*EXO(i,z,zj)**(1-rho_X2(i,z))]/
1462                     SUM[zjj$EXO(i,z,zjj),PEO(i,z,zjj)*EXO(i,z,zjj)
1463                     **(1-rho_X2(i,z))];
1464   
1465   B_X2(i,z)       = EXTO(i,z)/{SUM[zj,beta_X2(i,z,zj)*EXO(i,z,zj)**rho_X2(i,z)]
1466                     **(1/rho_X2(i,z))};
1467   
1468  *==============================================================================
1469  *   Calibration of CES parameters
1470  *==============================================================================
1471  *    Composite output
1472  *==============================================================================
1473   rho_X3(i,z)   = (1-sigma_X3(i,z))/sigma_X3(i,z);
1474   
1475   beta_X3(j,i,z)$XSO(j,i,z)
1476                 = [PO2(j,i,z)*XSO(j,i,z)**(1+rho_X3(i,z))]/
1477                     SUM[jj$XSO(jj,i,z),PO2(jj,i,z)*XSO(jj,i,z)**(1+rho_X3(i,z))];
1478   
1479   B_X3(i,z)     = XSO_I(i,z)
1480                    /SUM[jj$XSO(jj,i,z),beta_X3(jj,i,z)*XSO(jj,i,z)**(-rho_X3(i,z))
1481                    ]**(-1/rho_X3(i,z));
1482   
1483   POWERQO(Z) = SUM(POWER, XSO(power,'18_ELEC',z));
1484   
1485   rho_X4(z)   = (1-sigma_X4(z))/sigma_X4(z);
1486   
1487   beta_X4(power,z)
1488                 = [PO2(power,'18_ELEC',z)*XSO(power,'18_ELEC',z)**(1+rho_X4(z))]/
1489                     SUM[powerr$XSO(powerr,'18_ELEC',z),PO2(powerr,'18_ELEC',z)*XSO(powerr,'18_ELEC',z)**(1+rho_X4(z))];
1490   
1491   B_X4(z)     = POWERQO(Z)
1492                    /SUM[powerr$XSO(powerr,'18_ELEC',z),beta_X4(powerr,z)*XSO(powerr,'18_ELEC',z)**(-rho_X4(z))
1493                    ]**(-1/rho_X4(z));
1494   
1495   TnDShare(z) = XSO('18_TnD','18_ELEC',z)/XSO_I('18_ELEC',z);
1496   
1497   PPOWERO(z) = 1;
1498   
1499  *==============================================================================
1500  *    Composite good
1501  *==============================================================================
1502   rho_M1(i,z)     = (1-sigma_m1(i,z))/sigma_m1(i,z);
1503   
1504   beta_M1(i,z)    = PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)/
1505                    {PDO(i,z)*DDO(i,z)**(rho_M1(i,z)+1)
1506                    +PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)};
1507   
1508   B_M1(i,z)       = QO(i,z)/{beta_M1(i,z)*IMTO(i,z)**(-rho_M1(i,z))
1509                    +(1-beta_M1(i,z))*DDO(i,z)**(-rho_M1(i,z))}**(-1/rho_M1(i,z));
1510   
1511  *==============================================================================
1512  *   CES between imports from different trading partners
1513  *==============================================================================
1514   rho_M2(i,z)     = (1-sigma_M2(i,z))/sigma_M2(i,z);
1515   
1516   beta_M2(i,zj,z)$IMO(i,zj,z)
1517                   = [PMO(i,zj,z)*IMO(i,zj,z)**(rho_M2(i,z)+1)]/
1518                     SUM[zjj$IMO(i,zjj,z),PMO(i,zjj,z)*IMO(i,zjj,z)
1519                      **(rho_M2(i,z)+1)];
1520   
1521   B_M2(i,z)       = IMTO(i,z)/{SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*IMO(i,zj,z)
1522                     **(-rho_M2(i,z))]**(-1/rho_M2(i,z))};
1523   
1524  *==============================================================================
1525  *    Composite capital
1526  *==============================================================================
1527   rho_KD(j,z)     = (1-sigma_KD(j,z))/sigma_KD(j,z);
1528   
1529   beta_KD(k,j,z)$KDO(k,j,z)
1530                   = [RTIO(k,j,z)*KDO(k,j,z)**(1+rho_KD(j,z))]/
1531                     SUM[kj$KDO(kj,j,z),RTIO(kj,j,z)*KDO(kj,j,z)**(1+rho_KD(j,z))];
1532   B_KD(j,z)$KDCO(j,z)
1533                   = KDCO(j,z)/{SUM[k$KDO(k,j,z),beta_KD(k,j,z)*KDO(k,j,z)
1534                     **(-rho_KD(j,z))]**(-1/rho_KD(j,z))};
1535   
1536  *===============================================================================
1537  *   Composite E
1538  *===============================================================================
1539  *Leontief
1540   Share_Elec(j2,z) = DEO('18_ELEC',j2,z)/sum(ene,DEO(ene,j2,z));
1541   Share_nElec(ene3,j2,z) = DEO(ene3,j2,z)/sum(enee3,DEO(enee3,j2,z));
1542   Share_coalgas2(j2,z) = sum(ene5,DEO(ene5,j2,z))/sum(enee3,DEO(enee3,j2,z));
1543   Share_Oilpetrol2(j2,z) = sum(ene6,DEO(ene6,j2,z))/sum(enee3,DEO(enee3,j2,z));
1544   Share_coalgas(ene5,j2,z) = DEO(ene5,j2,z)/sum(enee5,DEO(enee5,j2,z));
1545   Share_Oilpetrol(ene6,j2,z) = DEO(ene6,j2,z)/sum(enee6,DEO(enee6,j2,z));
1546   
1547  *CES No Level
1548  * rho_ENER(j,z)   = (1-sigma_ENER(j,z))/sigma_ENER(j,z);
1549   
1550  * beta_ENER(ene,j,z)$DEO(ene,j,z)
1551  *                 = [PO4(ene,j,z)*DEO(ene,j,z)**(1+rho_ENER(j,z))]/
1552  *                   SUM[enee,PO4(enee,j,z)*DEO(enee,j,z)
1553  *                   **(1+rho_ENER(j,z))];
1554   
1555  * B_ENER(j,z)$CEO(j,z)
1556  *                 = CEO(j,z)/{SUM[ene,beta_ENER(ene,j,z)*DEO(ene,j,z)
1557  *                   **(-rho_ENER(j,z))]**(-1/rho_ENER(j,z))};
1558   
1559  *Level 5_1 (Coal/Gas)
1560   rho_ENER_coalgas(j2,z)   = (1-sigma_ENER_coalgas(j2,z))/sigma_ENER_coalgas(j2,z);
1561   
1562   beta_ENER_coalgas(ene5,j2,z)
1563                   = [PO4(ene5,j2,z)*DEO(ene5,j2,z)**(1+rho_ENER_coalgas(j2,z))]/
1564                     SUM[enee5,PO4(enee5,j2,z)*DEO(enee5,j2,z)
1565                     **(1+rho_ENER_coalgas(j2,z))];
1566   B_ENER_coalgas(j2,z)
1567                   = DEcoalgasO(j2,z)/{SUM[ene5,beta_ENER_coalgas(ene5,j2,z)*DEO(ene5,j2,z)
1568                     **(-rho_ENER_coalgas(j2,z))]**(-1/rho_ENER_coalgas(j2,z))};
1569   
1570  *Level 5_2 (oil/petrol)
1571   rho_ENER_oilprod(j2,z)   = (1-sigma_ENER_oilprod(j2,z))/sigma_ENER_oilprod(j2,z);
1572   
1573   beta_ENER_oilprod(ene6,j2,z)
1574                   = [PO4(ene6,j2,z)*DEO(ene6,j2,z)**(1+rho_ENER_oilprod(j2,z))]/
1575                     SUM[enee6,PO4(enee6,j2,z)*DEO(enee6,j2,z)
1576                     **(1+rho_ENER_oilprod(j2,z))];
1577   B_ENER_oilprod(j2,z)
1578                   = DEoilpetrolO(j2,z)/{SUM[ene6,beta_ENER_oilprod(ene6,j2,z)*DEO(ene6,j2,z)
1579                     **(-rho_ENER_oilprod(j2,z))]**(-1/rho_ENER_oilprod(j2,z))};
1580   
1581  *Level 4 (Coal-Gas/Oil-Petrol)
1582   rho_ENER_nelec(j2,z)   = (1-sigma_ENER_nelec(j2,z))/sigma_ENER_nelec(j2,z);
1583   
1584   beta_ENER_nelec(j2,z)
1585                   = PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)**(rho_ENER_nelec(j2,z)+1)/
1586                    {PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)**(rho_ENER_nelec(j2,z)+1)+
1587                     PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)**(rho_ENER_nelec(j2,z)+1)};
1588   B_ENER_nelec(j2,z)
1589                   = DEnelecO(j2,z)
1590                     /{[beta_ENER_nelec(j2,z)*DEcoalgasO(j2,z)**(-rho_ENER_nelec(j2,z))+
1591                     (1-beta_ENER_nelec(j2,z))*DEoilpetrolO(j2,z)**(-rho_ENER_nelec(j2,z))
1592                     ]**(-1/rho_ENER_nelec(j2,z))};
1593   
1594  *Level 3 (Coal/Gas/Oil/Petrol)
1595  * rho_ENER3(j2,z)   = (1-sigma_ENER3(j2,z))/sigma_ENER3(j2,z);
1596   
1597  * beta_ENER3(ene3,j2,z)
1598  *                 = [PO4(ene3,j2,z)*DEO(ene3,j2,z)**(1+rho_ENER3(j2,z))]/
1599  *                   SUM[enee3,PO4(enee3,j2,z)*DEO(enee3,j2,z)
1600  *                   **(1+rho_ENER3(j2,z))];
1601   
1602  * B_ENER3(j2,z)
1603  *                 = DEnelecO(j2,z)/{SUM[ene3,beta_ENER3(ene3,j2,z)*DEO(ene3,j2,z)
1604  *                   **(-rho_ENER3(j2,z))]**(-1/rho_ENER3(j2,z))};
1605   
1606  *Level 2 (Elec/Non Elec)
1607   rho_ENER_elec(j2,z)   = (1-sigma_ENER_elec(j2,z))/sigma_ENER_elec(j2,z);
1608   
1609   beta_ENER_elec(j2,z)
1610                   = PCEelecO(j2,z)*DEelecO(j2,z)**(rho_ENER_elec(j2,z)+1)/
1611                    {PCEelecO(j2,z)*DEelecO(j2,z)**(rho_ENER_elec(j2,z)+1)+
1612                     PCEnelecO(j2,z)*DEnelecO(j2,z)**(rho_ENER_elec(j2,z)+1)};
1613   B_ENER_elec(j2,z)
1614                   = CEO(j2,z)
1615                     /{[beta_ENER_elec(j2,z)*DEelecO(j2,z)**(-rho_ENER_elec(j2,z))+
1616                     (1-beta_ENER_elec(j2,z))*DEnelecO(j2,z)**(-rho_ENER_elec(j2,z))
1617                     ]**(-1/rho_ENER_elec(j2,z))};
1618   
1619  *==============================================================================
1620  *    4.6.3.5 Value added
1621  *==============================================================================
1622   rho_VA(j,z)     = (1-sigma_VA(j,z))/sigma_VA(j,z);
1623   
1624   beta_VA(j,z)$KDCO(j,z)
1625                   = WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)/
1626                    {WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)+
1627                     RCO(j,z)*KDCO(j,z)**(rho_VA(j,z)+1)};
1628   B_VA(j,z)$KDCO(j,z)
1629                   = VAO(j,z)
1630                     /{[beta_VA(j,z)*LDCO(j,z)**(-rho_VA(j,z))+
1631                     (1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
1632                     ]**(-1/rho_VA(j,z))};
1633   
1634   B_VA_t(j,z,time) = B_VA(j,z);
1635   
1636  *==============================================================================
1637  *    Composite KLE
1638  *==============================================================================
1639    KLEO(j,z)       = CEO(j,z) + VAO(j,z) ;
1640   
1641   PKLEO(j,z)      = [PCEO(j,z)*CEO(j,z)+PVAO(j,z)*VAO(j,z)]/KLEO(j,z);
1642   
1643   rho_KLE(j,z)    = (1-sigma_KLE(j,z))/sigma_KLE(j,z);
1644   
1645   beta_KLE(j,z)$KLEO(j,z)
1646                   = PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)/
1647                    {PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)+
1648                     PCEO(j,z)*CEO(j,z)**(rho_KLE(j,z)+1)};
1649   
1650   beta_KLE2(j,z)$KLEO(j,z)
1651                   = 1-beta_KLE(j,z);
1652   
1653   B_KLE(j,z)$KLEO(j,z)
1654                   = KLEO(j,z)
1655                     /{[beta_KLE(j,z)*VAO(j,z)**(-rho_KLE(j,z))+
1656                     (beta_KLE2(j,z))*CEO(j,z)**(-rho_KLE(j,z))
1657                     ]**(-1/rho_KLE(j,z))};
1658   
1659  *B_KLE(j,z)$KLEO(j,z)
1660  *                 = KLEO(j,z)
1661  *                   /{[beta_KLE(j,z)*(VAO(j,z)+EPS)**(-rho_KLE(j,z))+
1662  *                   (beta_KLE2(j,z))*(CEO(j,z)+EPS)**(-rho_KLE(j,z))
1663  *                   ]**(-1/rho_KLE(j,z))};
1664   
1665  *==============================================================================
1666  *  Calibration of LES parameters
1667  *==============================================================================
1668  *   As the assigned values of income elasticities may not result in
1669  *   consumption shares that add up to 1, this first step
1670  *   adjusts the elasticities proportionally
1671   sigma_Y(i,z)    = sigma_Y(i,z)/{SUM[ij,sigma_Y(ij,z)*PCO(ij,z)*CO(ij,z)]
1672                     /CTHO(z)};
1673   gamma_LES(i,z)  = PCO(i,z)*CO(i,z)*sigma_Y(i,z)/CTHO(z);
1674   CMINO(i,z)      = CO(i,z)+gamma_LES(i,z)*CTHO(z)/{PCO(i,z)*frisch(z)};
1675   
1676  *==============================================================================
1677  *  Calibration of gross domestic products
1678  *==============================================================================
1679   GDP_BPO(z)      = SUM[j,PVAO(j,z)*VAO(j,z)]+TIPTO(z);
1680   GDP_MPO(z)      = GDP_BPO(z)+TPRCTSO(z);
1681  * GDP_IBO(z)      = SUM[(l,j),WO(l,z)*LDO(l,j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1682   GDP_IBO(z)      = SUM[(j),WO(z)*LDO(j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1683                     +TPRODNO(z)+TPRCTSO(z);
1684   GDP_FDO(z)      = SUM[i,PCO(i,z)*(CO(i,z)+CGO(i,z)+INVO(i,z))]
1685                    +eO(z)*SUM[(i,zj),PWXO(i,z,zj)*EXO(i,z,zj)]
1686                    +eO(z)*SUM[i,PWMGO(i)*MRGNO(i,z)]
1687                    -eO(z)*SUM[(i,zj),IMO(i,zj,z)*(PWMO(i,zj,z)
1688                    +SUM{ij,PWMGO(ij)*tmrg(ij,i,zj,z)})];
1689   GDP_BP_WO       = SUM[z,GDP_BPO(z)/eO(z)];
1690   
1691  *==============================================================================
1692  *  4.8 Calibration of real (volume) variables computed from price indices
1693  *==============================================================================
1694   CABXO(z)        = CABO(z)/[PIXGDP_WO*eO(z)];
1695   
1696  *------------------------------------------------------------------------------
1697  * Calculation of CAB index
1698  * If every region's CABX grows exogenously according to exogro, then the
1699  * worldwide sum of CABX's will not be zero. If, due to redundancy, the reference
1700  * region's CABX is left implicit, then it will not grow according to that
1701  * region's exogro (it follows that the solution will depend on the choice of
1702  * reference region). CABix is formed from exogro by inflating or deflating the
1703  * updating factors of positive (SURplus) and negative (DEFicit) CABX's in such
1704  * a way that their sum remains zero.
1705   
1706  *$ontext
1707  Parameter CABXsur(z,time), CABXdef(z,time), bal(time), mu(time), CABix(z,time);
1708  * CABXsur(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) gt 0];
1709  * CABXdef(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) lt 0];
1710   
1711   CABXsur(z,t1) = CABXO(z)$[CABXO(z) gt 0];
1712   CABXdef(z,t1) = CABXO(z)$[CABXO(z) lt 0];
1713   
1714   CABXsur(z,time)$[ord(time) gt 1] = CABXO(z)*(1+g_GDP(z,time))$[CABXO(z) gt 0];
1715   CABXdef(z,time)$[ord(time) gt 1] = CABXO(z)*(1+g_GDP(z,time))$[CABXO(z) lt 0];
1716   
1717   Bal(time)           = sum(zj,CABXsur(zj,time))+sum(zj,CABXdef(zj,time));
1718   mu(time)           = sum(zj,CABXsur(zj,time))/
1719                          {sum(zj,CABXsur(zj,time))+sum(zj,abs[CABXdef(zj,time)])};
1720   CABXsur(z,time) = CABXsur(z,time)*{1-mu(time)*Bal(time)/sum(zj,CABXsur(zj,time))};
1721   CABXdef(z,time) = CABXdef(z,time)*{1-[1-mu(time)]*Bal(time)/sum(zj,CABXdef(zj,time))};
1722   CABix(z,time)     = [CABXsur(z,time)+CABXdef(z,time)]/CABXO(z);
1723  *$offtext
1724  *------------------------------------------------------------------------------
1725   
1726   CTH_REALO(z)    = CTHO(z)/PIXCONO(z);
1727   G_REALO(z)      = GO(z)/PIXGVTO(z);
1728   GDP_BP_REALO(z) = GDP_BPO(z)/PIXGDPO(z);
1729   GDP_BP_W_REALO  = GDP_BP_WO/PIXGDP_WO;
1730   GDP_MP_REALO(z) = GDP_MPO(z)/PIXCONO(z);
1731   IT_REALO(z)     = ITO(z)/PIXINVO(z);
1732   
1733  *==============================================================================
1734  *  Parameters of the household savings function
1735  *==============================================================================
1736   sh1O(z)         = [SHO(z)+SGO(z)]/GDP_IBO(z);
1737   sh0O(z)         = SHO(z)-sh1O(z)*YDHO(z);
1738   
1739  *==============================================================================
1740  *  Re-calibration of indexed transfers and parameters
1741  *==============================================================================
1742   sh0O(z)         = sh0O(z)/PIXCONO(z)**eta;
1743   ttdh0O(z)       = ttdh0O(z)/PIXCONO(z)**eta;
