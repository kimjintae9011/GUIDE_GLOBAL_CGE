 960  * CES - composite K-L
 961  * sigma_VA('10_PETROLCOAL',z)  = 1.26;
 962   sigma_VA('18_TnD',z)         = 0.2;
 963   sigma_VA('19_eNuclear',z)   = 0.2;
 964   sigma_VA('20_eCoal',z)       = 0.2;
 965   sigma_VA('21_eGas',z)        = 0.2;
 966   sigma_VA('22_eOil',z)         = 0.2;
