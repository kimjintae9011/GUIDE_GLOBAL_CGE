 969   sigma_VA('25_eHydro',z)     = 0.2;
 970   sigma_VA('26_eOther',z)     = 0.2;
 971   
 972  * CES - composite ENER
 973  * sigma_ENER(j,z)              = 1.1 ;
 974  * sigma_ENER3(j2,z)           = 1.1 ;
