4162   
4163  *==============================================================================
4164  *  5.3 Equations
4165  *==============================================================================
4166  *   5.3.1 Production
4167  *==============================================================================
4168   EQ1(j3,z,t)..     VA(j3,z,t) =e= v(j3,z)*XST(j3,z,t);
4169   
4170   EQ1_1(j2,z,t)..   KLE(j2,z,t) =e= v2(j2,z)*XST(j2,z,t);
4171   
4172   EQ2(j,z,t)..      CI(j,z,t) =e= io(j,z)*XST(j,z,t);
4173   
4174   EQ2_1(j3,z,t)..   CE(j3,z,t) =e= io2(j3,z)*XST(j3,z,t);
4175   
4176   EQ3(j,z,t)..      VA(j,z,t) =e= A_VA(z,t)*B_VA_t(j,z,t)*{
4177                      [beta_VA(j,z)*LDC(j,z,t)**(-rho_VA(j,z))]$LDCO(j,z)
4178                     +[(1-beta_VA(j,z))*KDC(j,z,t)**(-rho_VA(j,z))]$KDCO(j,z)
4179                                                     }**(-1/rho_VA(j,z));
4180   
4181   EQ3_1(j2,z,t)..   KLE(j2,z,t) =e= B_KLE(j2,z)*{
4182                      [beta_KLE(j2,z)*VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
4183                     +[(1-beta_KLE(j2,z))*CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
4184                                                     }**(-1/rho_KLE(j2,z));
4185   
4186   EQ4_1(j2,z,t)$[VAO(j2,z) and CEO(j2,z)]..
4187                   VA(j2,z,t) =e= {[(1-beta_KLE2(j2,z))/(beta_KLE2(j2,z))]
4188                                *[PCE(j2,z,t)/PVA(j2,z,t)]}**sigma_KLE(j2,z)*CE(j2,z,t);
4189   
4190   EQ4(j,z,t)$[LDCO(j,z) and KDCO(j,z)]..
4191                   LDC(j,z,t) =e= {[beta_VA(j,z)/(1-beta_VA(j,z))]
4192                                *[RC(j,z,t)/WC(j,z,t)]}**sigma_VA(j,z)*KDC(j,z,t);
4193   
4194   EQ5(j,z,t)$LDCO(j,z)..
4195                   LDC(j,z,t) =e= LD(j,z,t)+LBS(j,z,t);
4196   
4197   EQ7(j,z,t)$KDCO(j,z)..
4198                   KDC(j,z,t) =e= B_KD(j,z)*SUM[k$KDO(k,j,z),beta_KD(k,j,z)
4199                                  *KD(k,j,z,t)**(-rho_KD(j,z))]**(-1/rho_KD(j,z))+sum(k,KBS(k,j,z,t));
4200   
4201   EQ8(k,j,z,t)$KDO(k,j,z)..
4202                    KD(k,j,z,t) =e= [beta_KD(k,j,z)*RC(j,z,t)/RTI(k,j,z,t)]**sigma_KD(j,z)*B_KD(j,z)**(sigma_KD(j,z)-1)
4203                      * (KDC(j,z,t) - sum(kj, KBS(kj,j,z,t)));
4204   
4205   EQ9(nene,j,z,t)..   DI(nene,j,z,t) =e= aij(nene,j,z)*CI(j,z,t) ;
4206   
4207  * EQ9_1(ene,j3,z,t)..  DE(ene,j3,z,t)   =e= aij2(ene,j3,z)*CE(j3,z,t)*AEEI(z,t) ;
4208   EQ9_1(ene,j3,z,t)..  DE(ene,j3,z,t)   =e= aij2_t(ene,j3,z,t)*CE(j3,z,t)*AEEI(z,t) ;
4209   
4210  *=============================Simple Nesting=========================================
4211  * EQ9_2(ene,j2,z,t)..  DE(ene,j2,z,t) =e= [beta_ENER_t(ene,j2,z,t)*PCE(j2,z,t)/((P4(ene,j2,z,t)+P4(ene,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j2,z,t)))]
4212  *                                   **sigma_ENER(j2,z)*B_ENER_t(j2,z,t)**(sigma_ENER(j2,z)-1)
4213  *                                   *CE(j2,z,t);
4214   
4215  *=============================Leontief===========================================
4216  * EQ9_2(j2,z,t)..       DEelec(j2,z,t)  =e= Share_Elec(j2,z)*CE(j2,z,t);
4217   
4218  * EQ9_3(j2,z,t)..       DEnelec(j2,z,t) =e= (1-Share_Elec(j2,z))*CE(j2,z,t);
4219   
4220  * EQ9_4(ene3,j2,z,t)..  DE(ene3,j2,z,t) =e= Share_nElec(ene3,j2,z)*DEnelec(j2,z,t);
4221   
4222  * EQ9_5(ene2,j2,z,t)..  DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
4223   
4224  *=============================Level 1, 2=======================================
4225  * EQ9_2(j2,z,t)..       CE(j2,z,t)  =e= B_ENER2(j2,z)*{[(beta_ENER2(j2,z))*DEelec(j2,z,t)**(-rho_ENER2(j2,z))]
4226  *                                                     +[(1-beta_ENER2(j2,z))*DEnelec(j2,z,t)**(-rho_ENER2(j2,z))]
4227  *                                                   }**(-1/rho_ENER2(j2,z));
4228   
4229  * EQ9_3(j2,z,t)..       DEelec(j2,z,t) =e= {[(beta_ENER2(j2,z))/(1-beta_ENER2(j2,z))]
4230  *                                        *[PCEnelec(j2,z,t)/PCEelec(j2,z,t)]}**sigma_ENER2(j2,z)*DEnelec(j2,z,t);
4231   
4232  * EQ9_4(ene3,j2,z,t)..  DE(ene3,j2,z,t) =e= [beta_ENER3(ene3,j2,z)*PCEnelec(j2,z,t)/P4(ene3,j2,z,t)]
4233  *                                            **sigma_ENER3(j2,z)*B_ENER3(j2,z)**(sigma_ENER3(j2,z)-1)
4234  *                                            *DEnelec(j2,z,t);
4235   
4236  * EQ9_5(ene2,j2,z,t)..  DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
4237   
4238  *=============================Level 1, 2, 3 (Leonteif) =======================================
4239  * EQ9_2(j2,z,t)..        DEelec(j2,z,t)  =e= Share_Elec(j2,z)*CE(j2,z,t);
4240   
4241  * EQ9_3(j2,z,t)..        DEnelec(j2,z,t) =e= (1-Share_Elec(j2,z))*CE(j2,z,t);
4242   
4243  * EQ9_4(j2,z,t)..        DEcoalgas(j2,z,t) =e= Share_coalgas2(j2,z)*DEnelec(j2,z,t);
4244   
4245  * EQ9_5(j2,z,t)..        DEoilpetrol(j2,z,t) =e= (1-Share_coalgas2(j2,z))*DEnelec(j2,z,t);
4246   
4247  * EQ9_6(ene2,j2,z,t)..   DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
4248   
4249  * EQ9_7(ene5,j2,z,t)..   DE(ene5,j2,z,t) =e= Share_coalgas(ene5,j2,z)*DEcoalgas(j2,z,t);
4250   
4251  * EQ9_8(ene6,j2,z,t)..   DE(ene6,j2,z,t) =e= Share_oilpetrol(ene6,j2,z)*DEoilpetrol(j2,z,t);
4252   
4253  *=============================Level 1, 2, 3 (CES) =======================================
4254   EQ9_2(j2,z,t)..        CE(j2,z,t)  =e= B_ENER_elec(j2,z)*{[(beta_ENER_elec(j2,z))*DEelec(j2,z,t)**(-rho_ENER_elec(j2,z))]
4255                                             +[(1-beta_ENER_elec(j2,z))*DEnelec(j2,z,t)**(-rho_ENER_elec(j2,z))]
4256                                              }**(-1/rho_ENER_elec(j2,z));
4257   
4258   EQ9_3(j2,z,t)..        DEnelec(j2,z,t) =e= {[(1-beta_ENER_elec(j2,z))/(beta_ENER_elec(j2,z))]
4259                                          *[PCEelec(j2,z,t)/PCEnelec(j2,z,t)]}**sigma_ENER_elec(j2,z)*DEelec(j2,z,t);
4260   
4261   EQ9_4(j2,z,t)..        DEnelec(j2,z,t) =e= B_ENER_nelec(j2,z)*{[(beta_ENER_nelec(j2,z))*DEcoalgas(j2,z,t)**(-rho_ENER_nelec(j2,z))]
4262                                             +[(1-beta_ENER_nelec(j2,z))*DEoilpetrol(j2,z,t)**(-rho_ENER_nelec(j2,z))]
4263                                              }**(-1/rho_ENER_nelec(j2,z));
4264   
4265   EQ9_5(j2,z,t)..        DEoilpetrol(j2,z,t) =e= {[(1-beta_ENER_nelec(j2,z))/(beta_ENER_nelec(j2,z))]
4266                                         *[PCEcoalgas(j2,z,t)/PCEoilpetrol(j2,z,t)]}**sigma_ENER_nelec(j2,z)*DEcoalgas(j2,z,t);
4267   
4268   EQ9_6(ene2,j2,z,t)..   DE(ene2,j2,z,t) =e= DEelec(j2,z,t)*AEEI(z,t) ;
4269   
4270   EQ9_7(ene5,j2,z,t)..   DE(ene5,j2,z,t) =e= [beta_ENER_coalgas(ene5,j2,z)*PCEcoalgas(j2,z,t)/(P4(ene5,j2,z,t)+P4(ene5,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene5,j2,z,t))]
4271                                              **sigma_ENER_coalgas(j2,z)*B_ENER_coalgas(j2,z)**(sigma_ENER_coalgas(j2,z)-1)
4272                                              *DEcoalgas(j2,z,t)*AEEI(z,t);
4273   
4274   EQ9_8(ene6,j2,z,t)..   DE(ene6,j2,z,t) =e= [beta_ENER_oilprod(ene6,j2,z)*PCEoilpetrol(j2,z,t)/(P4(ene6,j2,z,t)+P4(ene6,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene6,j2,z,t))]
4275                                              **sigma_ENER_oilprod(j2,z)*B_ENER_oilprod(j2,z)**(sigma_ENER_oilprod(j2,z)-1)
4276                                              *DEoilpetrol(j2,z,t)*AEEI(z,t);
4277   
4278  *==============================================================================
4279  *   5.3.2 Income and savings
4280  *==============================================================================
4281  *    5.3.2.1 Households
4282  *==============================================================================
4283   EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t)+SUM(i3,MARKUP(i3,z,t))+REBATE(z,t)*recycle_hou(z,t) ;
4284   
4285   EQ11(z,t)..       YHL(z,t) =e= SUM[(j)$LDO(j,z),W(z,t)*(LD(j,z,t)+LBS(j,z,t))];
4286   
4287   EQ12(z,t)..       YHK(z,t) =e= SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*(KD(k,j,z,t)+KBS(k,j,z,t))];
4288   
4289   EQ13(z,t)..       YDH(z,t) =e= YH(z,t)-TDH(z,t);
4290   
4291   EQ14(z,t)..       CTH(z,t) =e= YDH(z,t)-SH(z,t);
4292   
4293   EQ15(z,t)..       SH(z,t) =e= PIXCON(z,t)**eta*sh0(z,t)+sh1(z,t)*YDH(z,t);
4294   
4295  *==============================================================================
4296  *    5.3.2.2 Government
4297  *==============================================================================
4298   EQ16(z,t)..       YG(z,t) =e= TDH(z,t)+TPRODN(z,t)+TPRCTS(z,t)+REBATE(z,t)*recycle_gov(z,t);
4299   
4300   EQ16_1(z,t)..    TCTAX(z,t) =e= sum((ene,j), PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t));
4301   
4302   EQ17(z,t)..       TPRODN(z,t) =e= TIWT(z,t)+TIKT(z,t)+TIPT(z,t);
4303   
4304   EQ18(z,t)..       TIWT(z,t) =e= SUM[(j)$LDO(j,z),TIW(j,z,t)];
4305   
4306   EQ19(z,t)..       TIKT(z,t) =e= SUM[(k,j)$KDO(k,j,z),TIK(k,j,z,t)];
4307   
4308   EQ20(z,t)..       TIPT(z,t) =e= SUM[j,TIP(j,z,t)];
4309   
4310   EQ21(z,t)..       TPRCTS(z,t) =e= TICT(z,t)+TIMT(z,t)+TIXT(z,t);
4311   
4312   EQ22(z,t)..       TICT(z,t) =e= SUM[i,TIC(i,z,t)];
4313   
4314   EQ23(z,t)..       TIMT(z,t) =e= SUM[(i,zj)$IMO(i,zj,z),TIM(i,zj,z,t)];
4315   
4316   EQ24(z,t)..       TIXT(z,t) =e= SUM[(i,zj)$EXO(i,z,zj),TIX(i,z,zj,t)];
4317   
4318   EQ25(z,t)..       TDH(z,t) =e= PIXCON(z,t)**eta*ttdh0(z,t)+ttdh1(z,t)*YH(z,t);
4319   
4320   EQ26(j,z,t)$LDO(j,z)..
4321                          TIW(j,z,t) =e= ttiw(j,z,t)*W(z,t)*(LD(j,z,t)+LBS(j,z,t)) -LaborRebate(j,z,t);
4322   
4323   EQ27(k,j,z,t)$KDO(k,j,z)..
4324                          TIK(k,j,z,t) =e= ttik(k,j,z,t)*R(k,j,z,t)*(KD(k,j,z,t)+KBS(k,j,z,t));
4325   
4326   EQ28(j,z,t)..     TIP(j,z,t) =e= ttip(j,z,t)*PP(j,z,t)*XST(j,z,t);
4327   
4328   EQ29(i,z,t)..     TIC(i,z,t) =e= ttic(i,z,t)*{[PL(i,z,t)*DD(i,z,t)]$DDO(i,z)
4329                   +[SUM[zj$IMO(i,zj,z),(1+ttim(i,zj,z,t))*IM(i,zj,z,t)*e(z,t)
4330                    *(PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z)))]]};
4331   
4332   EQ30(i,zj,z,t)$IMO(i,zj,z)..
4333                   TIM(i,zj,z,t) =e= ttim(i,zj,z,t)*IM(i,zj,z,t)*e(z,t)*
4334                                     (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
4335                                     *tmrg(ij,i,zj,z)]);
4336   
4337   EQ31(i,z,zj,t)$EXO(i,z,zj)..
4338                   TIX(i,z,zj,t) =e= ttix(i,z,zj,t)*PE(i,z,zj,t)*EX(i,z,zj,t);
4339   
4340   EQ32(z,t)..       SG(z,t) =e= YG(z,t)-G(z,t);
4341   
4342  *==============================================================================
4343  *    5.3.2.4 Rest of the world
4344  *==============================================================================
4345   EQ33(z,t)..       YROW(z,t) =e= e(z,t)*SUM{(i,zj)$IMO(i,zj,z),IM(i,zj,z,t)*
4346                             [PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z))]};
4347   
4348   EQ34(z,t)..       SROW(z,t) =e= YROW(z,t)-e(z,t)*SUM[(i,zj)$EXO(i,z,zj),
4349                                 EX(i,z,zj,t)*PWX(i,z,zj,t)]-e(z,t)
4350                                 *SUM[i$MRGNO(i,z),MRGN(i,z,t)*PWMG(i,t)];
4351   
4352   EQ35(z,t)..       SROW(z,t) =e= -CAB(z,t);
4353   
4354  *==============================================================================
4355  *   5.3.3 Demand
4356  *==============================================================================
4357   EQ36(i,z,t)..  PC(i,z,t)*C(i,z,t) =e= PC(i,z,t) * (CMIN(i,z,t))
4358                         + gamma_LES(i,z) * {CTH(z,t) - SUM[ij, PC(ij,z,t) * (CMIN(ij,z,t) )]};
4359   
4360   EQ37(i,z,t)..     PC(i,z,t)*INV(i,z,t) =e= gamma_INV(i,z)*IT(z,t);
4361   
4362   EQ38(i,z,t)..     PC(i,z,t)*CG(i,z,t) =e= gamma_GVT(i,z)*G(z,t);
4363   
4364   EQ39(nene,z,t)..    DIT(nene,z,t) =e= SUM[j,DI(nene,j,z,t)];
4365   
4366   EQ39_1(ene1,z,t)..  DIT(ene1,z,t) =e= SUM[j,DE(ene1,j,z,t)];
4367   
4368   EQ39_2(ene2,z,t)..  DIT(ene2,z,t) =e= SUM[j,DE(ene2,j,z,t)];
4369   
4370  *==============================================================================
4371  *   5.3.4 International trade
4372  *==============================================================================
       EQB_1(i,z)..    XS_I(i,z) =e= B_X3(i,z)*SUM[j$XSO(j,i,z),beta_X3(j,i,z)
                                      *XS(j,i,z)**(-rho_X3(i,z))]**(-1/rho_X3(i,z));
       
       EQB_2(j,i,z)${DSO(j,i,z) and [DSO(j,i,z) ne DSO_I(i,z)]}..
                       XS(j,i,z) =e= XS_I(i,z)/B_X3(i,z)**(1-sigma_X3(i,z))*
                                     [beta_X3(j,i,z)*PI(i,z)/P2(j,i,z)]
                                     **sigma_X3(i,z);
       
       EQB_3(j,i,z)${DSO(j,i,z)}..   P2(j,i,z) =e= PT(j,z);
       
       EQB_4(j,i,z)$DSO(j,i,z)..
                       P2(j,i,z)*XS(j,i,z) =e= [PET(i,z)*EXTT(j,i,z)]$EXTTO(j,i,z)
                                              +[e(z)*MRGN(i,z)*PWMG(i)]$MRGNO(i,z)
                                              +[PL(i,z)*DS(j,i,z)]$DSO(j,i,z);
       
       EQB_5(j,i,z)$DSO(j,i,z)..  EXTT(j,i,z)  =e= theta2(j,i,z)*EXT(i,z);
4391   
4392  *[Top Nest - Leontief function]
4393   EQA_1(z,t)..  XS('18_TnD','18_ELEC',z,t) =e= TnDShare(z)*XS_I('18_ELEC',z,t);
4394   EQA_2(z,t)..  XS_I('18_ELEC',z,t) =e= XS('18_TnD','18_ELEC',z,t) + POWERQ(z,t);
4395   
4396  *[Second Nest - CES function]
4397  * EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
4398  *                                *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
4399   EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
4400                                  *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
4401   
4402  * EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
4403  *                               [beta_X4(power,z)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
4404  *                               **sigma_X4(z);
4405   
4406   EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
4407                                 [beta_X4(power,z)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
4408                                 **sigma_X4(z);
4409   
4410  * exclude electiricity
4411   EQB_1(i2,z,t)..    XS_I(i2,z,t) =e= B_X3(i2,z)*SUM[j$XSO(j,i2,z),beta_X3(j,i2,z)
4412                                  *XS(j,i2,z,t)**(-rho_X3(i2,z))]**(-1/rho_X3(i2,z));
4413   
4414   EQB_3(j,i,z,t)${DSO(j,i,z)}..   P2(j,i,z,t) =e= PT(j,z,t);
4415   
4416   EQB_4(j,i,z,t)$DSO(j,i,z)..
4417                   P2(j,i,z,t)*XS(j,i,z,t) =e= [PET(i,z,t)*EXTT(j,i,z,t)]$EXTTO(j,i,z)
4418                                          +[e(z,t)*MRGN(i,z,t)*PWMG(i,t)]$MRGNO(i,z)
4419                                          +[PL(i,z,t)*DS(j,i,z,t)]$DSO(j,i,z);
4420   
4421   EQB_5(j,i,z,t)$DSO(j,i,z)..  EXTT(j,i,z,t)  =e= theta2(j,i,z)*EXT(i,z,t);
4422   
4423   EQ40_3(i,z,t)..   DS_I(i,z,t) =e= sum(j,DS(j,i,z,t)$DSO(j,i,z));
4424   
4425   EQ40_4(j,z,t)..   XST(j,z,t)  =e= sum(i,XS(j,i,z,t)$XSO(j,i,z)) ;
4426   
4427   EQ40_5(i,z,t)..   XS_I(i,z,t) =e= B_X1(i,z)*{
4428  * EQ40_5(i,z,t)..   XS_I2(i,z,t) =e= B_X1(i,z)*{
4429                   [beta_EX_X1(i,z)*EXT(i,z,t)**rho_X1(i,z)]$EXTO(i,z)
4430                  +[beta_D_X1(i,z)*DS_I(i,z,t)**rho_X1(i,z)]$DSO_I(i,z)
4431                  +[(1-beta_EX_X1(i,z)-beta_D_X1(i,z))*MRGN(i,z,t)**rho_X1(i,z)]$MRGNO(i,z)
4432                                            }**(1/rho_X1(i,z));
4433   
4434   EQ41(i,z,t)$[EXTO(i,z) and DSO_I(i,z)]..
4435                   EXT(i,z,t) =e= {[beta_D_X1(i,z)/beta_EX_X1(i,z)]*[PET(i,z,t)/PL(i,z,t)]}
4436                                **sigma_X1(i,z)*DS_I(i,z,t);
4437   
4438   EQ42(i,z,t)$[MRGNO(i,z) and DSO_I(i,z)]..
4439                   MRGN(i,z,t) =e= {[beta_D_X1(i,z)/(1-beta_EX_X1(i,z)
4440                                   -beta_D_X1(i,z))]*[e(z,t)*PWMG(i,t)/PL(i,z,t)]}
4441                                   **sigma_X1(i,z)*DS_I(i,z,t);
4442   
4443   EQ43(i,z,t)$EXTO(i,z)..
4444                   EXT(i,z,t) =e= B_X2(i,z)*SUM[zj$EXO(i,z,zj),beta_X2(i,z,zj)
4445                                  *EX(i,z,zj,t)**rho_X2(i,z)]**(1/rho_X2(i,z));
4446   
4447   EQ44(i,z,zj,t)$EXO(i,z,zj)..
4448                   EX(i,z,zj,t) =e= EXT(i,z,t)/B_X2(i,z)**(1+sigma_X2(i,z))*
4449                                    [PE(i,z,zj,t)/(beta_X2(i,z,zj)*PET(i,z,t))]
4450                                    **sigma_X2(i,z);
4451   
4452   EQ45(i,z,t)..     Q(i,z,t) =e= B_M1(i,z)*{
4453                      [beta_M1(i,z)*IMT(i,z,t)**(-rho_M1(i,z))]$IMTO(i,z)
4454                     +[(1-beta_M1(i,z))*DD(i,z,t)**(-rho_M1(i,z))]$DDO(i,z)
4455                                          }**(-1/rho_M1(i,z));
4456   
4457   EQ46(i,z,t)$[IMTO(i,z) and DDO(i,z)]..
4458                   IMT(i,z,t) =e= {[beta_M1(i,z)/(1-beta_M1(i,z))]*[PD(i,z,t)
4459                                  /PMT(i,z,t)]}**sigma_m1(i,z)*DD(i,z,t);
4460   
4461   EQ47(i,z,t)$IMTO(i,z)..
4462                   IMT(i,z,t) =e= B_M2(i,z)*SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*
4463                                  IM(i,zj,z,t)**(-rho_M2(i,z))]**(-1/rho_M2(i,z));
4464   
4465   EQ48(i,zj,z,t)$IMO(i,zj,z)..
4466                   IM(i,zj,z,t) =e= IMT(i,z,t)/B_M2(i,z)**(1-sigma_M2(i,z))*
4467                                    [beta_M2(i,zj,z)*PMT(i,z,t)/PM(i,zj,z,t)]
4468                                    **sigma_M2(i,z);
4469   
4470  *==============================================================================
4471  *   5.3.5 Prices
4472  *==============================================================================
4473   EQ49(j2,z,t)..       PP(j2,z,t)*XST(j2,z,t) =e= PKLE(j2,z,t)*KLE(j2,z,t)+PCI(j2,z,t)*CI(j2,z,t);
4474   
4475   EQ49_1(j3,z,t)..    PP(j3,z,t)*XST(j3,z,t) =e= PVA(j3,z,t)*VA(j3,z,t)+PCI(j3,z,t)*CI(j3,z,t)+PCE(j3,z,t)*CE(j3,z,t);
4476   
4477   EQ50(j,z,t)..        PT(j,z,t) =e= (1+ttip(j,z,t))*PP(j,z,t);
4478   
4479   EQ51(j,z,t)..        PCI(j,z,t)*CI(j,z,t) =e= SUM[nene,PC(nene,z,t)*DI(nene,j,z,t)];
4480   
4481  *Simple Nesting
4482  * EQ51_1(j,z,t)..    PCE(j,z,t)*CE(j,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j,z,t) + PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t)];
4483   
4484  *============================== Level 1-3 ========================================
4485  * EQ51_1(j2,z,t)..   PCE(j2,z,t)*CE(j2,z,t) =e= [PCEelec(j2,z,t)*DEelec(j2,z,t)+PCEnelec(j2,z,t)*DEnelec(j2,z,t)];
4486   
4487  * EQ51_12(j3,z,t)..  PCE(j3,z,t)*CE(j3,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j3,z,t)+PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j3,z,t)*DE(ene,j3,z,t)];
4488   
4489  * EQ51_2(j2,z,t)..   PCEelec(j2,z,t)*DEelec(j2,z,t) =e= PC("18_ELEC",z,t)*DE("18_ELEC",j2,z,t);
4490   
4491  * EQ51_3(j2,z,t)..   PCEnelec(j2,z,t)*DEnelec(j2,z,t) =e= SUM[ene3,PC(ene3,z,t)*DE(ene3,j2,z,t)+PC(ene3,z,t)*CTAX(z,t)*CO2FACTOR2(ene3,j2,z,t)*DE(ene3,j2,z,t)];
4492   
4493  *================================= Level 1-5 ======================================
4494   EQ51_2(j3,z,t)..   PCE(j3,z,t)*CE(j3,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j3,z,t)+PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j3,z,t)*DE(ene,j3,z,t)];
4495   
4496   EQ51_1(j2,z,t)..   PCE(j2,z,t)*CE(j2,z,t) =e= [PCEelec(j2,z,t)*DEelec(j2,z,t)+PCEnelec(j2,z,t)*DEnelec(j2,z,t)];
4497   
4498   EQ51_3(j2,z,t)..   PCEelec(j2,z,t)*DEelec(j2,z,t) =e= PC("18_ELEC",z,t)*DE("18_ELEC",j2,z,t);
4499   
4500   EQ51_4(j2,z,t)..   PCEnelec(j2,z,t)*DEnelec(j2,z,t) =e= [PCEcoalgas(j2,z,t)*DEcoalgas(j2,z,t)+PCEoilpetrol(j2,z,t)*DEoilpetrol(j2,z,t)];
4501   
4502   EQ51_5(j2,z,t)..   PCEcoalgas(j2,z,t)*DEcoalgas(j2,z,t) =e= [PC("02_COAL",z,t)*DE("02_COAL",j2,z,t)+PC("02_COAL",z,t)*CTAX(z,t)*CO2FACTOR2("02_COAL",j2,z,t)*DE("02_COAL",j2,z,t)
4503                      +PC("04_GAS",z,t)*DE("04_GAS",j2,z,t)+PC("04_GAS",z,t)*CTAX(z,t)*CO2FACTOR2("04_GAS",j2,z,t)*DE("04_GAS",j2,z,t)];
4504   
4505   EQ51_6(j2,z,t)..   PCEoilpetrol(j2,z,t)*DEoilpetrol(j2,z,t) =e= [PC("03_OIL",z,t)*DE("03_OIL",j2,z,t)+PC("03_OIL",z,t)*CTAX(z,t)*CO2FACTOR2("03_OIL",j2,z,t)*DE("03_OIL",j2,z,t)
4506                      +PC("10_PETROLCOAL",z,t)*DE("10_PETROLCOAL",j2,z,t)+PC("10_PETROLCOAL",z,t)*CTAX(z,t)*CO2FACTOR2("10_PETROLCOAL",j2,z,t)*DE("10_PETROLCOAL",j2,z,t)];
4507   
4508  *==================================================================================
4509   EQ52(j,z,t)..      PVA(j,z,t)*VA(j,z,t) =e= [WC(j,z,t)*LDC(j,z,t)]$LDCO(j,z)
4510                                       +[RC(j,z,t)*KDC(j,z,t)]$KDCO(j,z);
4511   
4512   EQ52_1(j2,z,t)..   PKLE(j2,z,t)*KLE(j2,z,t) =e= [PVA(j2,z,t)*VA(j2,z,t)]$VAO(j2,z)
4513                                         +[PCE(j2,z,t)*CE(j2,z,t)]$CEO(j2,z);
4514   
4515  * Given equations 5 and 6, equation 53 is redundant
4516  * EQ53(j,z)..     WC(j,z)*LDC(j,z) =e= SUM[l$LDO(l,j,z),WTI(l,j,z)*LD(l,j,z)];
4517   EQ53(j,z,t)..     WC(j,z,t)*LDC(j,z,t) =e= WTI(j,z,t)*(LD(j,z,t)+LBS(j,z,t));
4518   
4519   EQ54(j,z,t)$LDO(j,z)..
4520                   WTI(j,z,t)*LD(j,z,t) =e= W(z,t)*(1+ttiw(j,z,t))*LD(j,z,t) -LaborRebate(j,z,t);
4521   
4522   EQ54_1(ene,j2,z,t)$DEO(ene,j2,z)..
4523                   P4(ene,j2,z,t) =e= PC(ene,z,t);
4524   
4525  * Given equations 7 and 8, equation 55 is redundant
4526  * EQ55(j,z)$(kmob and KDCO(j,z))..
4527  *                 RC(j,z)*KDC(j,z) =e= SUM[k$KDO(k,j,z),RTI(k,j,z)*KD(k,j,z)];
4528   
4529  * EQ55(j,z,t)$KDCO(j,z)..
4530  *                RC(j,z,t)*KDC(j,z,t) =e= SUM[k$KDO(k,j,z),RTI(k,j,z,t)*(KD(k,j,z,t)+KBS(k,j,z,t))];
4531   
4532   EQ56(k,j,z,t)$KDO(k,j,z)..
4533                   RTI(k,j,z,t) =e= R(k,j,z,t)*(1+ttik(k,j,z,t));
4534   
4535  * EQ57(k,j,z,t)$(kmob and KDO(k,j,z))..
4536  *                 R(k,j,z,t) =e= RK(k,z,t);
4537   
4538   EQ58(i,z,t)..     P(i,z,t)*XS_I(i,z,t)=e= [PL(i,z,t)*DS_I(i,z,t)]$DSO_I(i,z)
4539                                       +[PET(i,z,t)*EXT(i,z,t)]$EXTO(i,z)
4540                                       +[e(z,t)*PWMG(i,t)*MRGN(i,z,t)]$MRGNO(i,z);
4541   
4542  * Given equations 43 and 44, equation 59 is redundant
4543  * EQ59(i,z)$EXTO(i,z)..
4544  *                 PET(i,z)*EXT(i,z) =e= SUM[zj$EXO(i,z,zj),
4545  *                                           PE(i,z,zj)*EX(i,z,zj);
4546   
4547   EQ60(i,z,zj,t)$EXO(i,z,zj)..
4548                   PE(i,z,zj,t)*(1+ttix(i,z,zj,t)) =e= e(z,t)*PWX(i,z,zj,t);
4549   
4550   EQ61(i,z,t)$DDO(i,z)..
4551                   PD(i,z,t) =e= (1+ttic(i,z,t))*PL(i,z,t);
4552   
4553   EQ62(i,zj,z,t)$IMO(i,zj,z)..
4554                   PM(i,zj,z,t) =e= (1+ttic(i,z,t))*(1+ttim(i,zj,z,t))*e(z,t)*
4555                                    (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
4556                                    *tmrg(ij,i,zj,z)]);
4557   
4558  * Given equations 47 and 48, equation 63 is redundant
4559  * EQ63(i,z)$IMTO(i,z)..
4560  *                 PMT(i,z)*IMT(i,z) =e= SUM[zj$IMO(i,zj,z),
4561  *                                           PM(i,zj,z)*IM(i,zj,z);
4562   
4563   EQ64(i,z,t)..     PC(i,z,t)*Q(i,z,t) =e= [PD(i,z,t)*DD(i,z,t)]$DDO(i,z)+
4564                                      [PMT(i,z,t)*IMT(i,z,t)]$IMTO(i,z);
4565   
4566  * EQ65(z,t)..       PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
4567  *                               /gamma_INV(i,z))**gamma_INV(i,z)];
4568   
4569   EQ66(z,t)..       PIXGDP(z,t) =e=
4570                   {SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)]
4571                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
4572                   *SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)]
4573                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)]}**0.5;
4574   
4575   EQ67(t)..         PIXGDP_W(t) =e=
4576                   {SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)/e(z,t)]
4577                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
4578                   *SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)/e(z,t)]
4579                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)/eO(z)]}**0.5;
4580   
4581   EQ68(z,t)..       PIXCON(z,t) =e= SUM[i,PC(i,z,t)*CO(i,z)]/SUM[i,PCO(i,z)*CO(i,z)];
4582   
4583   EQ69(z,t)..       PIXINV(z,t) =e= PROD[i$gamma_INV(i,z),(PC(i,z,t)/PCO(i,z))
4584                                   **gamma_INV(i,z)];
4585   
4586   EQ70(z,t)..       PIXGVT(z,t) =e= PROD[i$gamma_GVT(i,z),(PC(i,z,t)/PCO(i,z))
4587                                   **gamma_GVT(i,z)];
4588   
4589  *==============================================================================
4590  *   5.3.6 Equilibrium
4591  *==============================================================================
4592   EQ71(i1,z,t)..    Q(i1,z,t) =e= C(i1,z,t)+CG(i1,z,t)+INV(i1,z,t)+DIT(i1,z,t);
4593   
4594   EQ71_2(i3,z,t)..  Q(i3,z,t) + XDBS(i3,z,t) =e= C(i3,z,t) + CG(i3,z,t) + INV(i3,z,t) + DIT(i3,z,t);
4595  * EQ71_2(i3,z,t)..  Q(i3,z,t) =e= C(i3,z,t) + CG(i3,z,t) + INV(i3,z,t) + DIT(i3,z,t);
4596   
4597   EQ72(z,t)..       LS(z,t) =e= SUM[j$LDO(j,z),LD(j,z,t)+LBS(j,z,t)];
4598   
4599   EQ73(k,z,t)$KSO(k,z)..
4600                         KS(k,z,t) =e= SUM[j$KDO(k,j,z),KD(k,j,z,t)+KBS(k,j,z,t)];
4601   
4602   EQ74(z,t)..       IT(z,t) =e= SH(z,t)+SG(z,t)-CAB(z,t);
4603   
4604   EQ75(z,t)..       DEP(z,t) =e= PK(z,t)*delta(z)*SUM[k$KSO(k,z),KS(k,z,t)];
4605   
4606   EQ76(i,z,t)$DDO(i,z)..
4607                     SUM[j$DSO(j,i,z),DS(j,i,z,t)] =e= DD(i,z,t);
4608   
4609   EQ77(i,z,zj,t)$EXO(i,z,zj)..
4610                     EX(i,z,zj,t) =e= IM(i,z,zj,t);
4611   
4612   EQ78(i,z,zj,t)$EXO(i,z,zj)..
4613                     PWX(i,z,zj,t) =e= PWM(i,z,zj,t);
4614   
4615   EQ79(i,t)..       SUM[z$MRGNO(i,z),MRGN(i,z,t)] =e= SUM[(z,zj,ij)$IMO(ij,zj,z),
4616                                                   tmrg(i,ij,zj,z)*IM(ij,zj,z,t)];
4617   
4618  * Given equations 33, 34 and 77, equation 80 is redundant
4619  *EQ80..          SUM[z,SROW(z,t)/e(z,t)] =e= 0;
4620   
4621  *==============================================================================
4622  *   5.3.7 Gross domestic product
4623  *==============================================================================
4624   EQ81(z,t)..       GDP_BP(z,t) =e= SUM[j,PVA(j,z,t)*VA(j,z,t)]+TIPT(z,t);
4625   
4626   EQ82(z,t)..       GDP_MP(z,t) =e= GDP_BP(z,t)+TPRCTS(z,t)+TCTAX(z,t)+SUM(i3,MARKUP(i3,z,t));
4627   
4628   EQ83(z,t)..       GDP_IB(z,t) =e= SUM[(j)$LDO(j,z),W(z,t)*(LD(j,z,t)+LBS(j,z,t))]
4629                                +SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*(KD(k,j,z,t)+KBS(k,j,z,t))]
4630                                +TPRCTS(z,t)+TPRODN(z,t)+TCTAX(z,t)+SUM(i3,MARKUP(i3,z,t));
4631   
4632   EQ84(z,t)..       GDP_FD(z,t) =e=
4633                                   SUM[i,PC(i,z,t)*(C(i,z,t)+CG(i,z,t)+INV(i,z,t))]
4634                                  +SUM[(i,zj)$EXO(i,z,zj),e(z,t)*PWX(i,z,zj,t)*EX(i,z,zj,t)]
4635                                  +SUM[i$MRGNO(i,z),e(z,t)*PWMG(i,t)*MRGN(i,z,t)]
4636                                  -SUM[(i,zj)$IMO(i,zj,z),e(z,t)*IM(i,zj,z,t)
4637                                      *(PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)*tmrg(ij,i,zj,z)])];
4638   
4639   EQ85(t)..          GDP_BP_W(t) =e= SUM[z,GDP_BP(z,t)/e(z,t)];
4640   
4641  *==============================================================================
4642  *  5.3.8 Real (volume) variables computed from price indices
4643  *==============================================================================
4644   EQ86(z,t)..       CTH_REAL(z,t) =e= CTH(z,t)/PIXCON(z,t);
4645   
4646   EQ87(z,t)..       G_REAL(z,t) =e= G(z,t)/PIXGVT(z,t);
4647   
4648   EQ88(z,t)..       GDP_BP_REAL(z,t) =e= GDP_BP(z,t)/PIXGDP(z,t);
4649   
4650   EQ89(t)..         GDP_BP_W_REAL(t) =e= GDP_BP_W(t)/PIXGDP_W(t);
4651   
4652   EQ90(z,t)..       GDP_MP_REAL(z,t) =e= GDP_MP(z,t)/PIXCON(z,t);
4653   
4654   EQ91(z,t)..       IT_REAL(z,t) =e= IT(z,t)/PIXINV(z,t);
4655   
4656   EQ92(z,t)..       CABX(z,t) =e= CAB(z,t)/[PIXGDP_W(t)*e(z,t)];
4657   
4658  *==============================================================================
4659  *   5.3.8 Dynamic equations
4660  *==============================================================================
4661   EQ94(z,t)..     IT(z,t) =e= PK(z,t)*SUM[(k,j)$KDO(k,j,z),IND(k,j,z,t)];
4662   
4663   EQ95(z,t)..     PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
4664                                 /gamma_INV(i,z))**gamma_INV(i,z)];
4665   
4666   EQ96(k,bus,z,t)$KDO(k,bus,z)..
4667                       IND(k,bus,z,t) =e= phi(z,t)*[R(k,bus,z,t)/U(z,t)]
4668                                    **sigma_INV(k,bus,z)*KD(k,bus,z,t);
4669   
4670   EQ97a(z,t)..    IR(z,t) =e= {SUM[(k,j)$KDO(k,j,z),
4671                                R(k,j,z,t)*KD(k,j,z,t)]-DEP(z,t)}/
4672                               {PK(z,t)*SUM[(k,j)$KDO(k,j,z),KD(k,j,z,t)]};
4673   
4674   EQ97b(z,t)..    U(z,t) =e= PK(z,t)*(delta(z)+IR(z,t));
4675   
4676  *==============================================================================
4677  *   5.3.9 Other
4678  *==============================================================================
4679   WALRAS(z,t)..   LEON(z,t) =e= Q('01_AGRICULT',z,t)-C('01_AGRICULT',z,t)-CG('01_AGRICULT',z,t)-INV('01_AGRICULT',z,t)
4680                              -DIT('01_AGRICULT',z,t);
4681   
4682  *==============================================================================
4683  *   5.3.10 Backstop technology
4684  *==============================================================================
4685   EQ98(i3,z,t)..    C_Conventional(i3,z,t) =e= (1-penetration_rate(i3,z,t))*[C(i3,z,t)+CG(i3,z,t)+INV(i3,z,t)+DIT(i3,z,t)];
4686   
4687   EQ99(i3,z,t)..    XDBS(i3,z,t) =e= penetration_rate(i3,z,t)*[C(i3,z,t)+CG(i3,z,t)+INV(i3,z,t)+DIT(i3,z,t)];
4688   
4689  * EQ99(i3,z,t)..    XDBS(i3,z,t) =e= penetration_rate(i3,z,t) * XS_I2(i3,z,t);
4690   
4691   EQ100(j,z,t)..    XDBS2(j,z,t) =e= sum{i3$COMtoIND(j,i3),XDBS(i3,z,t)};
4692   
4693   EQ101(j,z,t)..    LBS(j,z,t) =e= Lab_Share(j,z)*XDBS2(j,z,t);
4694   
4695   EQ102(k,j,z,t)..  KBS(k,j,z,t) =e= Cap_Share(j,z)*XDBS2(j,z,t)*KDO(k,j,z)/sum(kj,KDO(kj,j,z));
4696   
4697   EQ103(i3,z,t)..   CLBS(i3,z,t)  =e= sum{j$INDtoCOM(i3,j),LBS(j,z,t)*WTI(j,z,t)};
4698   
4699   EQ104(i3,z,t)..   CKBS(i3,z,t) =e= sum{ j$INDtoCOM(i3,j), sum( k $ KDO(k,j,z), KBS(k,j,z,t)*RTI(k,j,z,t))};
4700   
4701   EQ105(i3,z,t)..   MARKUP(i3,z,t) =e= {P(i3,z,t)*XDBS(i3,z,t)-CLBS(i3,z,t)-CKBS(i3,z,t)} ;
4702   
4703  * EQ105_1(i,z,t)..  XS_I2(i,z,t) =e= XS_I(i,z,t) + XDBS(i,z,t);
4704   
4705  *================================================================================
4706  * 6 Labour Supply
4707  *================================================================================
4708   EQ106(z,t)..  LS(z,t) =e= LST(z,t) *((W(z,t)/PIXCON(z,t)) / (W_lag(z,t)/PIXCON_lag(z,t)))**elasLS(z);
4709   
4710  *==============================================================================
4711  * 7 PERMET
4712  *==============================================================================
4713   EQ107(j,z,t).. PERMIT(j,z,t) =e= sum(ene, CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t));
4714   
4715   EQ108(z,t)..  PERMIT_TOTAL(z,t) =e=  sum(j,PERMIT(j,z,t))  ;
4716   
4717   EQ108_1(t).. PERMIT_NEA_TOTAL(t) =e= sum(NEA, PERMIT_TOTAL(NEA,t));
4718   
4719  *==============================================================================
4720  * 8 Carbon Tax Revenue Recycling
4721  *==============================================================================
4722  EQ109(z,t)..     REBATE(z,t) =e= TCTAX(z,t);
4723   
4724  EQ110(j,z,t)..   TIW_Share(j,z,t) =e= LD(j,z,t)/SUM(jj,LD(jj,z,t));
4725   
4726  EQ111(j,z,t)..   LaborRebate(j,z,t) =e= TIW_Share(j,z,t) * TCTAX(z,t) * recycle_labor(z,t);
4727   
4728  *EQ112(j,z,t)..   TIK_Share(j,z,t) =e= KD('cap',j,z,t)/SUM(jj,KD('cap',jj,z,t));
4729   
4730  *EQ113(j,z,t)..   ttik('cap',j,z,t) =e= ttik_lag(j,z,t) + deltatik(j,z,t);
4731   
4732  *EQ114(j,z,t)..   deltatik(j,z,t) =e= -TIK_Share(j,z,t)*REBATE(z,t)/(R('cap',j,z,t)*KD('cap',j,z,t))*recycle_capital(z,t);
4733   
4734  *EQ115(j,z,t)..   TIP_Share(j,z,t) =e= XST(j,z,t)/SUM(jj,XST(jj,z,t));
4735   
4736  *EQ116(j,z,t)..   ttip(j,z,t) =e= ttip_lag(j,z,t) + deltatip(j,z,t);
4737   
4738  *EQ117(j,z,t)..   deltatip(j,z,t) =e= -TIP_Share(j,z,t) * REBATE(z,t) / (PP(j,z,t)*XST(j,z,t))*recycle_ptax(z,t);
4739   
4740  *==============================================================================
4741  * 6 Numerical resolution to compute A_VA, sh0, G, G_REAL and IND
4742  *==============================================================================
4743  option cns = conopt4;
4744  *option cns = path;
4745  *option cns = minos;
4746   
4747  *option conopt4.TolPiv = 1e-6;
4748  *option iterlim = 100;
4749  *option reslim = 1000;
4750  *option iterlim = 0;
4751  *option lmmxsf = t ;
4752   
4753  *Eliminating display of solution makes it easier to check whether model solves
4754  *and to identify year when it crashes.
4755  *option profile=1;
4756  *option profile=3;
4757  *option profiletol=10;
4758   
4759  *Fast solve option
4760  *option profile=0;
4761  *option limrow=0, limcol=0, solprint = off;
4762  *$Offlisting
4763  *$Offsymlist
4764  *$Offinclude
4765   
4766  MODEL CGE World wide dynamic model /all/ ;
4767  CGE.holdfixed=1;
4768   
4769  *==============================================================================
4770  *  6.1 Scenarios
4771  *==============================================================================
4772  * Define the set of scenarios
4773  * For each scenario, there are two files to $INCLUDE:
4774  * SOLVE, and RESULTS.
4775   
4776  SET
4777  SCEN  List of scenarios
4778  /
4779   BAU             Business As Usual
4780   NDC             30 NDC Target - Frozen Ambition
4781   NZ               Net Zero
4782  /
4783  ;
4784   
4785  *==============================================================================
4786  *  6.2.1.1 Choice of multifactor productivity
4787  *==============================================================================
4788  *  6.2.1.1.1 Input for multifactor productivity
4789  *==============================================================================
4790  * Multifactor productivity is retrieved from a model BAU solution with
4791  * endogenous A_VA(z,time) in equation 3, and exogenous real GDPs, fixed at
4792  * values that are projected using Four?, Benassy-Qu?r? and Fontagn? projected
4793  * growth rates. So the solution is forced to follow the GDP projected growth
4794  * paths. The solution values of A_VA are stored as parameter A_VA_RES.
4795  *-------------------------------------------------------------------------------
4796  PARAMETER
4797   A_VA_RES(z,time)     Value of A_VA to reproduce real GDP projections
4798   GX(z,time)           Current government expenditures on goods and services in region z
4799   G_REALX(z,time)      Current real government expenditures on goods and services in region z
4800   INDX(k,j,z,time)     Volume of new type k capital investment to industry j in region z
4801   sh0X(z,time)         Intercept (household savings)
4802   sh1X(z,time)         Household savings rate
4803  ;
4804   
GDXIN   C:\Users\kimc0\GUIDE_GLOBAL_CGE\9.Ownprice Adjustment\Input_CGE\B_line_GTAP11c_new.gdx
--- LOAD  A_VA_RES = 1:A_VA_RES
--- LOAD  GX = 2:GX
--- LOAD  G_REALX = 3:G_REALX
--- LOAD  INDX = 4:INDX
--- LOAD  sh1X = 26:sh1X
--- LOAD  sh0X = 27:sh0X
4807   
4808  *==============================================================================
4809  *  6.2.1.1.2 Choice of multifactor productivity
4810  *==============================================================================
4811  * If you want to reproduce the real GDP projections, set:
4812  * A_VA.FX(z,time)     = A_VA_RES(z,time);
4813  * Otherwise, simply put A_VA equal to one:
4814   A_VA.FX(z,time)    = 1;
4815   
4816  *==============================================================================
4817  *   6.2.1.2 Choice of reference region
4818  *==============================================================================
4819  * By default, the reference region is USA,
4820   zr(z)                = no;
4821   zr('07_NAM')    = yes;
4822   z1(z)               = NOT[zr(z)];
4823   
4824  *==============================================================================
4825  *   6.2.1.3 Choice between closures FE and FP
4826  *==============================================================================
4827  *$ontext
4828  * FP CLOSURE: fixed PIXGDPs; numeraire is exchange rate of reference region
4829  * The exchange rates are endogenous, except for the reference region.
4830   e.FX(zr,time)          = eO(zr);
4831   PIXGDP.FX(z,time)  = PIXGDPO(z)/sum(zr,eO(zr));
4832  *$offtext
4833   
      * FE CLOSURE: fixed exchange rates; numeraire is PIXGDP of reference region
      * The exchange rates can be fixed at arbitrary values
       PIXGDP.FX(zr,time)  = PIXGDPO(zr);
       e.FX(z,time)        = eO(z);
4840   
4841  *==============================================================================
4842  *   6.2.1.4 Other exogenous variables
4843  *==============================================================================
4844   G_REAL.FX(z,time)        = G_REALX(z,time);
4845   IND.fx(k,pub,z,time)      = INDX(k,pub,z,time);
4846   sh0.fx(z,time)               = sh0X(z,time);
4847   sh1.fx(z,time)               = sh1X(z,time);
4848   ttdh0.fx(z,time)             = ttdh0O(z);
4849   ttdh1.fx(z,time)             = ttdh1O(z);
