3579  *==============================================================================
3580  *  4.12 CO2FACTOR and CTAX
3581  *==============================================================================
3582  Parameters
3583   CO2_Energy(ene,j,z)        CO2 emissions from Energy
3584  ;
3585   
3586   CO2_Energy('02_COAL',j,z) = sum(p_coal,CO2IO(p_coal,j,z));
3587   CO2_Energy('03_OIL',j,z)  = sum(p_oil,CO2IO(p_oil,j,z));
3588   CO2_Energy('04_GAS',j,z)  = sum(p_gas,CO2IO(p_gas,j,z));
3589   CO2_Energy('10_PETROLCOAL',j,z)  = sum(p_oilproduct,CO2IO(p_oilproduct,j,z));
3590   
3591  Parameters
3592   CO2FACTOR(ene,j,z)       CO2 emissions factor (tCO2 per 100$)
3593   CO2FACTOR2(ene,j,z,time) Time series CO2 emissions factor (tCO2 per 100$)
3594  ;
3595   
3596   CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*(1000/(10**8));
3597   CO2FACTOR('03_OIL',j,z)$DEO('03_OIL',j,z)   = [sum(p_oil,CO2IO(p_oil,j,z))/DEO('03_OIL',j,z)]*(1000/(10**8));
3598   CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z)   = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*(1000/(10**8));
3599   CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*(1000/(10**8));
3600   
3601  Parameters
3602  Global_CO2FACTOR(ene,j)       Global Average CO2 emissions factor (tCO2 per 100$)
3603  ;
3604   
3605   Global_CO2FACTOR('02_COAL',j)            = [sum((p_coal,z),CO2IO(p_coal,j,z))/sum(z,DEO('02_COAL',j,z))]*(1000/(10**8));
3606   Global_CO2FACTOR('03_OIL',j)               = [sum((p_oil,z),CO2IO(p_oil,j,z))/sum(z,DEO('03_OIL',j,z))]*(1000/(10**8));
3607   Global_CO2FACTOR('04_GAS',j)              = [sum((p_gas,z),CO2IO(p_gas,j,z))/sum(z,DEO('04_GAS',j,z))]*(1000/(10**8));
3608   Global_CO2FACTOR('10_PETROLCOAL',j) = [sum((p_oilproduct,z),CO2IO(p_oilproduct,j,z))/sum(z,DEO('10_PETROLCOAL',j,z))]*(1000/(10**8));
3609   
      *MNG
      CO2FACTOR('02_COAL','31_SER','05_MNG')        = 2;
       
      *PRK
       CO2FACTOR('02_COAL','01_AGRICULT','06_PRK')        = CO2FACTOR('02_COAL','01_AGRICULT','05_MNG');
       CO2FACTOR('10_PETROLCOAL','01_AGRICULT','06_PRK')  = CO2FACTOR('10_PETROLCOAL','01_AGRICULT','05_MNG');
       CO2FACTOR('02_COAL','28_LTRP','06_PRK')            = CO2FACTOR('02_COAL','28_LTRP','05_MNG');
       CO2FACTOR('02_COAL','17_OTHERIND','06_PRK')        = CO2FACTOR('02_COAL','17_OTHERIND','05_MNG');
       
      *RUS
       CO2FACTOR('02_COAL','08_WOODPRO','04_RUS')    = CO2FACTOR('02_COAL','08_WOODPRO','10_EEU');
       CO2FACTOR('04_GAS','17_OTHERIND','04_RUS')      = SMAX(j$(not sameas(j, '17_OTHERIND')), CO2FACTOR('04_GAS', j, '04_RUS'));
       
      *LAM
       CO2FACTOR('04_GAS','02_COAL','08_LAM')             = CO2FACTOR('04_GAS','02_COAL','07_NAM');
       
      * CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) gt 10) = 10 ;
3629   
3630  CO2FACTOR(ene, j, z)$(
3631      not sameas(j, '13_IRONSTL') and
3632      not sameas(j, '20_eCoal') and
3633      not sameas(j, '21_eGas') and
3634      not sameas(j, '22_eOil')
3635  ) = MIN(CO2FACTOR(ene, j, z), Global_CO2FACTOR(ene, j));
3636   
3637  *Otherind Sector
3638   CO2FACTOR('02_COAL','17_OTHERIND',Z)$DEO('02_COAL','17_OTHERIND',z) = Global_CO2FACTOR('02_COAL','20_eCoal');
3639   CO2FACTOR('03_OIL','17_OTHERIND',Z)$DEO('03_OIL','17_OTHERIND',z) = Global_CO2FACTOR('03_OIL','03_OIL');
3640   CO2FACTOR('04_GAS','17_OTHERIND',Z)$DEO('04_GAS','17_OTHERIND',z) = Global_CO2FACTOR('04_Gas','21_eGas');
3641   CO2FACTOR('10_PETROLCOAL','17_OTHERIND',Z)$DEO('10_PETROLCOAL','17_OTHERIND',z) = Global_CO2FACTOR('10_PETROLCOAL','22_eOil');
3642   
3643   CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) lt 0) = 0.1 ;
3644   
3645   
3646   CO2FACTOR('02_COAL','20_eCoal','06_PRK') = CO2FACTOR('02_COAL','20_eCoal','05_MNG') ;
3647   
3648   CO2FACTOR('10_PETROLCOAL','22_eOil','06_PRK') = CO2FACTOR('10_PETROLCOAL','22_eOil','05_MNG') ;
3649   
3650   CO2FACTOR2(ene,j,z,time) = CO2FACTOR(ene,j,z);
3651   
3652  *===========
3653  * Coal 2.7tCO2 per 100$
3654  * CO2FACTOR2('02_COAL',j,z,time)$CO2FACTOR('02_COAL',j,z)           = 2.7 ;
3655  * Gas 1.8tCO2 per 100$
3656  * CO2FACTOR2('04_GAS',j,z,time)$CO2FACTOR('04_GAS',j,z)             = 0.67;
3657  * Oilrproduct  0.6tCO2 per 100$
3658  * CO2FACTOR2('10_PETROLCOAL',j,z,time)$CO2FACTOR('10_PETROLCOAL',j,z) = 0.67;
3659   
