3691  *==============================================================================
3692  *  Backstop technology
3693  *==============================================================================
3694   switch(i3,z,time)  = 0 ;
3695   penetration_rate(i3,z,time) = eps ;
3696   
3697  Parameters
3698   Max_Pen(i3,z)           Maximum Penetration Rate
3699   Logistic_Coeff(i3,z)    Logistic Growth Rate Coefficient
3700   Gompertz_Coeff(i3,z) Gompertz  Growth Rate Coefficient
3701   Start_Year(i3, z)        First Year
3702   Inflection_Lapse(i3, z) Inflection Point Time
3703  ;
3704   
3705  Parameters
3706   CTAX0(z)           Initial Carbon tax $ per ton CO2
3707   TCTAX0(z)          Initial Government Revenue from Carbon tax
3708   PERMITO(j,z)       CO2 emissions
3709   PERMIT_TOTALO(z)   Total CO2 emissions (billion ton)
3710   PERMIT_NEA_TOTALO
3711  ;
3712   
3713   CTAX0(z)          = 0;
3714   TCTAX0(z)         = 0;
3715   PERMITO(j,z)      = sum(ene, CO2FACTOR(ene,j,z)*DEO(ene,j,z)) ;
3716   PERMIT_TOTALO(z)  = sum(j,PERMITO(j,z));
3717   PERMIT_NEA_TOTALO = sum(NEA, PERMIT_TOTALO(NEA));
3718   
3719  *==============================================================================
3720  *   Marginal abatement curves for emissions
3721  *==============================================================================
3722  Parameters
3723   alpha_CO2(ene,j,z)   Emissions responsiveness parameter – higher values imply stronger reduction in emissions intensity in response to carbon price
3724   gamma_CO2(ene,j,z)   Adjustment speed parameter – governs how rapidly emissions intensity responds to changes in carbon price
3725   MINCO2FACTOR(ene,j,z) minimum CO2 emission factor
3726   CTAX_CO2(ene,j,z,time)
3727   CO2FACTOR2_Star(ene,j,z,time)
3728  ;
3729   
3730   alpha_CO2(ene,j,z)          = 0.15 ;
3731   gamma_CO2(ene,j,z)       = 1.5 ;
3732   MINCO2FACTOR(ene,j,z)  = CO2FACTOR(ene,j,z)*0.1 ;
3733   
3734  Scalar
3735  adjustment_factor
3736  trigger_price
3737  SolarWind_TFP_BAU
3738  SolarWind_TFP_NDC
3739  SolarWind_TFP_NZ
3740  ;
3741   
3742  adjustment_factor = 0.5 ;
3743  trigger_price  = 1.0 ;
3744  SolarWind_TFP_BAU =0.02;
3745  SolarWind_TFP_NDC=0.02;
3746  SolarWind_TFP_NZ =0.04;
3747   
3748  *==============================================================================
3749  *   Carbon tax recycling
3750  *==============================================================================
3751   TIWO_Share(j,z)    =   LDO(j,z)/LSO(z);
3752   TIKO_Share(k,j,z)   =  KDO(k,j,z)/KSO(k,z);
3753   TIPO_Share(j,z)     =  XSTO(j,z)/sum(jj,XSTO(jj,z));
3754   
3755  *==============================================================================
3756  *   Labour Supply
3757  *==============================================================================
3758  Parameters
3759   W_lag(z,time)         Wage rate of type l labor in region z
3760   PIXCON_lag(z,time)    Consumer price index in region z
3761   LS_lag(z,time)        Supply of type l labor in region z (T-1)
3762   LST_lag(z,time)       Supply of type l labor in region z (Trend T-1)
3763  ;
3764   
3765  *==============================================================================
3766  *  Own-price elasticities (Compensated)
3767  *==============================================================================
3768  PARAMETER
3769   elas_elec(j,z)               Own price elasticities(electricity)
3770   elas_gas(j,z)               Own price elasticities(gas)
3771   elas_oil(j,z)                 Own price elasticities(oil)
3772   elas_coal(j,z)               Own price elasticities(coal)
3773   elas_petrolcoal(j,z)       Own price elasticities(petrolcoal)
3774   elas_Hou_ENER(ene,z)  Own price elasticities Household
3775  ;
3776   
3777   elas_elec(j2,z)       = -1*(1- DEO('18_ELEC',j2,z)/sum(ene,DEO(ene,j2,z)))*sigma_ENER_elec(j2,z) ;
3778   elas_elec(j3,z)       = eps ;
3779   
3780   elas_gas(j2,z)        = -1*(1- DEO('04_GAS',j2,z)/(DEO('02_COAL',j2,z)+DEO('04_GAS',j2,z)))*sigma_ENER_coalgas(j2,z) ;
3781   elas_gas(j3,z)        = eps ;
3782   
3783   elas_coal(j2,z)       = -1*(1- DEO('02_COAL',j2,z)/(DEO('02_COAL',j2,z)+DEO('04_GAS',j2,z)))*sigma_ENER_coalgas(j2,z) ;
3784   elas_coal(j3,z)       = eps ;
3785   
3786   elas_oil(j2,z)          = -1*(1- DEO('03_OIL',j2,z)/(DEO('03_OIL',j2,z)+DEO('10_PETROLCOAL',j2,z)))*sigma_ENER_oilprod(j2,z) ;
3787   elas_oil(j3,z)          = eps ;
3788   
3789   elas_petrolcoal(j2,z)  = -1*(1- DEO('10_PETROLCOAL',j2,z)/(DEO('03_OIL',j2,z)+DEO('10_PETROLCOAL',j2,z)))*sigma_ENER_oilprod(j2,z) ;
3790   elas_petrolcoal(j3,z)  = eps ;
3791   
3792   elas_Hou_ENER(ene,z)   = CMINO(ene,z)/CO(ene,z)*(1-gamma_LES(ene,z)) -1 ;
3793   
3794  execute_unload 'Calibration_Check_GTAP11c';
3795  *$exit
