1216   Zrich('10_EEU')        = yes;
1217   Zrich('17_PAO')        = yes;
1218   Zother(Z)              = yes$[not Zrich(Z)];
1219   
1220  execute_unload 'Input\DATA_AGG-2019_GTAP11c.gdx',
1221   
