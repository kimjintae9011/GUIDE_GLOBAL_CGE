3285   NOilp_DIO(p_oilproduct,'14_NONFERR',z) = sum(f_nenonferr, WEB(f_nenonferr, p_oilproduct, z));
3286   NOilp_DIO(p_oilproduct,'15_MACHINE',z) = sum(f_nemachine, WEB(f_nemachine, p_oilproduct, z));
3287   NOilp_DIO(p_oilproduct,'16_TRANSEQ',z) = sum(f_netranseq, WEB(f_netranseq, p_oilproduct, z));
