3476  *==============================================================================
3477  *  4.12 CO2FACTOR and CTAX
3478  *==============================================================================
3479  Parameters
3480   CO2_Energy(ene,j,z)        CO2 emissions from Energy
3481  ;
3482   
3483   CO2_Energy('02_COAL',j,z) = sum(p_coal,CO2IO(p_coal,j,z));
3484   CO2_Energy('03_OIL',j,z)  = sum(p_oil,CO2IO(p_oil,j,z));
3485   CO2_Energy('04_GAS',j,z)  = sum(p_gas,CO2IO(p_gas,j,z));
3486   CO2_Energy('10_PETROLCOAL',j,z)  = sum(p_oilproduct,CO2IO(p_oilproduct,j,z));
3487   
3488  Parameters
3489   CO2FACTOR(ene,j,z)       CO2 emissions factor (tCO2 per 100$)
3490   CO2FACTOR2(ene,j,z,time) Time series CO2 emissions factor (tCO2 per 100$)
3491  ;
3492   
3493   CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*(1000/(10**8));
3494   CO2FACTOR('03_OIL',j,z)$DEO('03_OIL',j,z)   = [sum(p_oil,CO2IO(p_oil,j,z))/DEO('03_OIL',j,z)]*(1000/(10**8));
3495   CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z)   = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*(1000/(10**8));
3496   CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*(1000/(10**8));
3497   
3498  *PRK
3499   CO2FACTOR('02_COAL','01_AGRICULT','06_PRK')        = CO2FACTOR('02_COAL','01_AGRICULT','05_MNG');
3500   CO2FACTOR('10_PETROLCOAL','01_AGRICULT','06_PRK')  = CO2FACTOR('10_PETROLCOAL','01_AGRICULT','05_MNG');
3501   CO2FACTOR('02_COAL','28_LTRP','06_PRK')            = CO2FACTOR('02_COAL','28_LTRP','05_MNG');
3502   CO2FACTOR('02_COAL','17_OTHERIND','06_PRK')        = CO2FACTOR('02_COAL','17_OTHERIND','05_MNG');
3503   
3504  *RUS
3505   CO2FACTOR('02_COAL','08_WOODPRO','04_RUS')         = CO2FACTOR('02_COAL','08_WOODPRO','10_EEU');
3506   
3507  *LAM
3508   CO2FACTOR('04_GAS','02_COAL','08_LAM')             = CO2FACTOR('04_GAS','02_COAL','07_NAM');
3509   
3510   CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) gt 10) = 10 ;
3511   CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) lt 0) = 3.28666e-05 ;
3512  * CO2FACTOR2(ene,j,z)$(CO2FACTOR2(ene,j,z) lt 0.1) = 0.1 ;
3513   
3514   CO2FACTOR2(ene,j,z,time) = CO2FACTOR(ene,j,z);
3515   
3516   
3517  *===========
3518  * Coal 2.7tCO2 per 100$
3519  * CO2FACTOR2('02_COAL',j,z,time)$CO2FACTOR('02_COAL',j,z)           = 2.7 ;
3520  * Gas 1.8tCO2 per 100$
3521  * CO2FACTOR2('04_GAS',j,z,time)$CO2FACTOR('04_GAS',j,z)             = 0.67;
3522  * Oilrproduct  0.6tCO2 per 100$
3523  * CO2FACTOR2('10_PETROLCOAL',j,z,time)$CO2FACTOR('10_PETROLCOAL',j,z) = 0.67;
3524   
      *Petrolcoal
       CO2FACTOR('10_PETROLCOAL','10_PETROLCOAL',z) = 0;
       CO2FACTOR('02_COAL','10_PETROLCOAL',z) = CO2FACTOR('02_COAL','13_IRONSTL',z);
       
      *KOR
      * CO2FACTOR('02_COAL','10_PETROLCOAL','01_KOR') = 0;
      * CO2FACTOR(ene,'20_eCoal','01_KOR') =  CO2FACTOR(ene,'20_eCoal','03_JPN');
