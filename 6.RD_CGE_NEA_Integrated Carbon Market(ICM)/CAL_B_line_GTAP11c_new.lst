3604  *   Labor taxes
3605  *==============================================================================
3606   TIWO_Share(j,z)    =   LDO(j,z)/LSO(z);
3607   TIKO_Share(k,j,z)   =  KDO(k,j,z)/KSO(k,z);
3608   TIPO_Share(j,z)     =  XSTO(j,z)/sum(jj,XSTO(jj,z));
