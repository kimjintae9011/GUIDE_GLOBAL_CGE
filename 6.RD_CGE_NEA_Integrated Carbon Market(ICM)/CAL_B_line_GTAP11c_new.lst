 841   sigma_VA('19_eNuclear',z)    = 0.2;
 842   sigma_VA('20_eCoal',z)       = 0.2;
 843   sigma_VA('21_eGas',z)        = 0.2;
 844   sigma_VA('22_eOil',z)        = 0.2;
 845   sigma_VA('23_eWind',z)       = 0.2;
 846   sigma_VA('24_eSolar',z)      = 0.2;
 847   sigma_VA('25_eHydro',z)      = 0.2;
 848   sigma_VA('26_eOther',z)      = 0.2;
 849   
