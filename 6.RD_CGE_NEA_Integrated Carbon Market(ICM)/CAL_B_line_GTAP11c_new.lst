3249   NOil_DIO(p_oil,'05_MINING',z) = sum(f_nemining, WEB(f_nemining, p_oil, z));
3250   NOil_DIO(p_oil,'06_FOODPRO',z) = sum(f_nefoodpro, WEB(f_nefoodpro, p_oil, z));
3251   NOil_DIO(p_oil,'07_TEXTILES',z) = sum(f_netextiles, WEB(f_netextiles, p_oil, z));
3252   NOil_DIO(p_oil,'08_WOODPRO',z) = sum(f_newoodpro, WEB(f_newoodpro, p_oil, z));
3253   NOil_DIO(p_oil,'09_PAPERPRO',z) = sum(f_nepaperpro, WEB(f_nepaperpro, p_oil, z));
3254   NOil_DIO(p_oil,'11_CHEMICAL',z) = sum(f_nechemical, WEB(f_nechemical, p_oil, z));
3255   NOil_DIO(p_oil,'12_NONMET',z) = sum(f_nenonmet, WEB(f_nenonmet, p_oil, z));
3256   NOil_DIO(p_oil,'13_IRONSTL',z) = sum(f_neironstl, WEB(f_neironstl, p_oil, z));
3257   NOil_DIO(p_oil,'14_NONFERR',z) = sum(f_nenonferr, WEB(f_nenonferr, p_oil, z));
3258   NOil_DIO(p_oil,'15_MACHINE',z) = sum(f_nemachine, WEB(f_nemachine, p_oil, z));
3259   NOil_DIO(p_oil,'16_TRANSEQ',z) = sum(f_netranseq, WEB(f_netranseq, p_oil, z));
3260   NOil_DIO(p_oil,'17_OTHERIND',z) = sum(f_neotherind, WEB(f_neotherind, p_oil, z));
3261   NOil_DIO(p_oil,'27_CONSTRUC',z) = sum(f_neconstruc, WEB(f_neconstruc, p_oil, z));
3262   NOil_DIO(p_oil,'28_LTRP',z) = sum(f_netransport, WEB(f_netransport, p_oil, z));
3263  * NEP_DIO(p_oil,'29_WTRP',z) = sum((f_domewater), domewater_fne_oilproduct(f_domewater, p_oilproduct, z));
3264  * NEP_DIO(p_oil,'30_ATRP',z) = sum((f_domeair), domeair_fne_oilproduct(f_domeair, p_oilproduct, z));
3265   NOil_DIO(p_oil,'31_SER',z) = sum(f_neother, WEB(f_neother, p_oil, z) );
3266  * NEP_CO(p_oillz) = sum((f_household), household_fne_oilproduct(f_household, p_oilproduct, z));
3267   
3268  *Ratio
3269  Loop(j,
3270      NOilR_DIO(p_oil,j,z)$(NOil_DIO(p_oil,j,z) gt 0)
3271           = NOil_DIO(p_oil,j,z)/sum(p_oil2, NOil_DIO(p_oil2,j,z));
3272       );
3273   
