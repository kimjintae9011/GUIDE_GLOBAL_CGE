3565  *==============================================================================
3566   switch(i3,z,time)  = 0 ;
3567   penetration_rate(i3,z,time) = 0.01 ;
3568   
3569  Parameters
3570   CTAX0(z)           Initial Carbon tax $ per ton CO2
3571   TCTAX0(z)          Initial Government Revenue from Carbon tax
3572   PERMITO(j,z)       CO2 emissions
3573   PERMIT_TOTALO(z)   Total CO2 emissions (billion ton)
3574  ;
3575   
3576   CTAX0(z)          = 0;
3577   TCTAX0(z)         = 0;
3578   PERMITO(j,z)      = sum(ene, CO2FACTOR(ene,j,z)*DEO(ene,j,z)) ;
3579   PERMIT_TOTALO(z)  = sum(j,PERMITO(j,z));
3580   
3581  *==============================================================================
3582  *   Marginal abatement curves for emissions
3583  *==============================================================================
3584  Parameters
3585   alpha_CO2(ene,j,z)   Emissions responsiveness parameter – higher values imply stronger reduction in emissions intensity in response to carbon price
3586   gamma_CO2(ene,j,z)   Adjustment speed parameter – governs how rapidly emissions intensity responds to changes in carbon price
3587   MINCO2FACTOR(ene,j,z) minimum CO2 emission factor
3588   CTAX_CO2(ene,j,z,time)
3589   CO2FACTOR2_Star(ene,j,z,time)
3590   AbateCostO(j,z)
3591   AbateCost(j,z,time)
3592   theta_CO2(j,z)
3593   delta_CO2(j,z)
3594  ;
3595   
3596   alpha_CO2(ene,j,z)     = 0.15 ;
3597   gamma_CO2(ene,j,z)     = 1.5 ;
3598   MINCO2FACTOR(ene,j,z)  = CO2FACTOR(ene,j,z)*0.1 ;
3599   AbateCostO(j,z)        = 0 ;
3600   theta_CO2(j,z)         = 0.2;
3601   delta_CO2(j,z)         = 1;
3602   
