 889  *==============================================================================
 890  *   3.1.2 Rescaling the variables
 891  *==============================================================================
 892  * GTAP 8.1 data are in millions of (2004 and 2007) US dollars
 893  * (see www.gtap.agecon.purdue.edu/resources/download/5679.pdf)
 894  * With RES = 10000, model results are in tens of billions (10G$)
 895  RES              = 10000;
 896   
 897  * NOTE: In GTAP parlance, "agents' prices" are prices paid by buyers, and
 898  *       "market prices" are prices received by sellers.
 899   
 900  * Household consumption = GTAP domestic purchases (VDPA) + import purchases (VIPA)
 901  * by households at agents' prices.
 902  CO(i,z)          = CO(i,z)/RES;
 903   
 904  * Public final consumption = domestic purchases (VDGA) + import purchases (VIGA)
 905  * by government at agents' prices.
 906  CGO(i,z)         = CGO(i,z)/RES;
 907   
 908  * Domestic purchases = domestic absorption:
 909  * (CO + CGO + INVO + DIO) - [ imports (IMO) + transport margins (tmrg)
 910  *                              + indirect taxes (TICO + TIMO) ]
 911  DDO(i,z)         = DDO(i,z)/RES;
 912   
 913  * Capital depreciation (DEP)
 914  DEPO(z)          = DEPO(z)/RES;
 915   
 916  * Intermediate consumption = domestic purchases (VDFA) + import purchases (VIFA)
 917  * by firms belonging to sectors other than CGDS, at agents' prices.
 918  DIO(i,j,z)       = DIO(i,j,z)/RES;
 919   
 920  * Domestic supply = domestic demand (DDO) in GTAP_AGG.gms
 921  DSO(j,i,z)       = DSO(j,i,z)/RES;
 922  DSO_I(i,z)       = DSO_I(i,z)/RES;
 923   
 924  * Exports = exports at world prices (VXWD) = imports at world prices
 925  * Note: the GTAP variable VXWD is NOT used in the DATA_AGG.gms program; the
 926  * value recorded in DATA_AGG.gdx is actually identical to IMO
 927  EXO(i,z,zj)      = EXO(i,z,zj)/RES;
 928   
 929  * Imports = imports at world prices (VIWS) - sum of transport margins on imports (VTWR)
 930  IMO(i,z,zj)      = IMO(i,z,zj)/RES;
 931   
 932  * Demand for investment purposes = domestic purchases (VDFA)+ import purchases (VIFA)
 933  * by firms of the CGDS sector at agents' prices.
 934  INVO(i,z)        = INVO(i,z)/RES;
 935   
 936  * Total capital stock at the beginning of the period (VKB)
 937  KSTO(z)          = KSTO(z)/RES;
 938   
 939  * Labor demand = Remuneration of labor at market prices, before taxes
 940  * (components of VFM, "primary factor purchases, by households, at market prices")
 941  *LDO(l,j,z)       = LDO(l,j,z)/RES;
 942  LDO(j,z)         = LDO(j,z)/RES;
 943   
 944  * Supply of transport margins at market prices (VST), adjusted proportionately
 945  * so that MRGNO = sum of tmrg for every margin commodity
 946  MRGNO(i,z)       = MRGNO(i,z)/RES;
 947   
 948  * Remuneration of capital at market prices, before taxes
 949  * (components of VFM, "primary factor purchases, by households, at market prices")
 950  RKDO(k,j,z)      = RKDO(k,j,z)/RES;
 951   
 952  * Direct taxes = factor payment at market prices (VFM)
 953  *                - primary factor sales at agents' prices (EVOA)
 954  TDHO(z)          = TDHO(z)/RES;
 955   
 956  * Domestic taxes on commodities = demand at agents' prices - demand at market prices:
 957  * Include 6 pairs of GTAP components
 958  *       VDPA - VDPM
 959  *       VIPA - VIPM
 960  *       VDGA - VDGM
 961  *       VIGA - VIGM
 962  *       VDFA - VDFM
 963  *       VIFA - VIFM
 964  TICO(i,z)        = TICO(i,z)/RES;
 965   
 966  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 967  *                                     - factor-based subsidies (FBEP).
 968  TIKO(k,j,z)      = TIKO(k,j,z)/RES;
 969   
 970  * Import duties = "ordinary" import duties (TFRV)
 971  TIMO(i,z,zj)     = TIMO(i,z,zj)/RES;
 972   
 973  * Taxes on production = MINUS "ordinary output subsidies" (OSEP)
 974  TIPO(j,z)        = TIPO(j,z)/RES;
 975   
 976  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 977  *                                     - factor-based subsidies (FBEP).
 978  *TIWO(l,j,z)      = TIWO(l,j,z)/RES;
 979   TIWO(j,z)        = TIWO(j,z)/RES;
 980   
 981  * Taxes on exports = export tax equivalent of the Multi-Fiber Agreement (MFA)
 982  * quota premium(MFRV) + "ordinary" export taxes (XTRV)
 983  TIXO(i,z,zj)     = TIXO(i,z,zj)/RES;
 984   
 985  * Transport margins at world prices = sum of margins on imports (VTWR)
 986  tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj)/RES;
 987   
 988  * Domestic output = domestic supply (DSO) + supply of transport margins (MRGNO)
 989  *                   + exports (EXO) - taxes on exports (TIXO)
 990   
 991  XSO_I(i,z)       = XSO_I(i,z)/RES;
 992  XSO(j,i,z)       = XSO(j,i,z)/RES;
 993  XSTO(j,z)        = XSTO(j,z)/RES;
 994   
 995  *==============================================================================
 996  *  3.3 Exogenous prices and parameters
 997  *==============================================================================
 998  *  Price elasticity (should be equal to one to verify homogeneity)
 999  eta = 1;
1000   
1001  *------------------------------------------------------------------------------
1002  *  Slopes of taxation functions
1003  *   One can either choose to assign a value to the intercepts and calibrate
1004  *   the slopes accordingly, or the other way around. This type of modelling
1005  *   can be useful to take into account known marginal savings or taxation rates
1006  *   or to deal with negative average saving rates in cases where savings are
1007  *   negative for some household groups.
1008  *   When no further information is available, one can simply set the intercepts
1009  *   to zero and calibrate an average rate: this is what we do here for ttdh0O.
1010  *   If the user wishes to assume otherwise, he can fill the appropriate area in
1011  *   the Excel file VAL_PAR.xls.
1012  * ttdh0O(z)       = PARZ(z,'ttdh0O');
1013   ttdh0O(z)       = 0;
1014  *   The slope ttdh1O is calibrated below in the mane GAMS file
1015   
1016  *------------------------------------------------------------------------------
1017  * Also we need to assign values to some prices
1018  * All of the prices below, EXCEPT eO, may be set at arbitrary values
1019  * without loss of generality.
1020  *
1021  * In the case of eO, although exchange rates may be given arbitrary values
1022  * in the model, they must all be equal for calibration at this stage. The reason
1023  * is that the supply of margin transport services MRGNO must equal global demand.
1024  * Since there is a single world price for international transport margins
1025  * (rather than bilateral world prices for other commodities) the unit of
1026  * measurement of the volume of margin services must be the same for all regions,
1027  * and in turn, that implies that the divisor that converts the nominal value to
1028  * volume be the same for all regions. Since that divisor involves the exchange
1029  * rate, all exchange rates must be equal.
1030   
1031  * Normally, prices that may be given arbitrary values are set at 1:
1032   eO(z)            = 1;
1033   PEO(i,z,zj)      = 1;
1034   PLO(i,z)         = 1;
1035   PWMGO(i)         = 1;
1036   WO(z)            = 1;
1037   WO_lag(z)        = WO(z) ;
1038   
1039  *==============================================================================
1040  * 4 Calibration
1041  *==============================================================================
1042  *  4.1 Calculation of income and savings related variables and parameters
1043  *==============================================================================
1044   YHKO(z)         = SUM[(k,j),RKDO(k,j,z)];
1045   YHLO(z)         = SUM[(j),LDO(j,z)];
1046   YHO(z)          = YHLO(z)+YHKO(z);
1047   YDHO(z)         = YHO(z)-TDHO(z);
1048   CTHO(z)         = SUM[i,CO(i,z)];
1049   SHO(z)          = YDHO(z)-CTHO(z);
1050   TICTO(z)        = SUM[i,TICO(i,z)];
1051   TIMTO(z)        = SUM[(i,zj),TIMO(i,zj,z)];
1052   TIWTO(z)        = SUM[(j),TIWO(j,z)];
1053   TIKTO(z)        = SUM[(k,j),TIKO(k,j,z)];
1054   TIPTO(z)        = SUM[j,TIPO(j,z)];
1055   TIXTO(z)        = SUM[(i,zj),TIXO(i,z,zj)];
1056   TPRODNO(z)      = TIKTO(z)+TIWTO(z)+TIPTO(z);
1057   TPRCTSO(z)      = TICTO(z)+TIMTO(z)+TIXTO(z);
1058   YGO(z)          = TDHO(z)+TPRCTSO(z)+TPRODNO(z);
1059   GO(z)           = SUM[i,CGO(i,z)];
1060   SGO(z)          = YGO(z)-GO(z);
1061   YROWO(z)        = SUM[(i,zj),IMO(i,zj,z)]+SUM[(i,ij,zj),tmrg(i,ij,zj,z)];
1062   SROWO(z)        = YROWO(z)-SUM[(i,zj),EXO(i,z,zj)]-SUM[i,MRGNO(i,z)];
1063   CABO(z)         = -SROWO(z);
1064   ITO(z)          = SHO(z)+SGO(z)+SROWO(z);
1065   
1066  *==============================================================================
1067  *  4.2 Calibration of parameters and other variables
1068  *==============================================================================
1069  *  4.2.1 Calibration of investment and government spending shares
1070  *==============================================================================
1071   gamma_GVT(i,z)  = CGO(i,z)/SUM[ij,CGO(ij,z)];
1072   gamma_INV(i,z)  = INVO(i,z)/SUM[ij,INVO(ij,z)] ;
1073   
1074  *==============================================================================
1075  *  4.2.2 Calibration of other prices and revised volumes (part 1)
1076  *==============================================================================
1077   LDO(j,z)      = LDO(j,z)/WO(z);
1078   LDCO(j,z)     = LDO(j,z);
1079   LSO(z)        = SUM[j,LDO(j,z)];
1080   LSTO(z)       = LSO(z) ;
1081   LSO_lag(z)    = LSO(z) ;
1082   LSTO_lag(z)   = LSO(z) ;
1083   EXO(i,z,zj)  = [EXO(i,z,zj)-TIXO(i,z,zj)]/PEO(i,z,zj);
1084   EXTO(i,z)    = SUM[zj,EXO(i,z,zj)];
1085   PWXO(i,z,zj)$EXO(i,z,zj)
1086                   = {[PEO(i,z,zj)*EXO(i,z,zj)+TIXO(i,z,zj)]/EXO(i,z,zj)}/eO(z);
1087   
1088   PETO(i,z)       = SUM[zj,PEO(i,z,zj)*EXO(i,z,zj)]/EXTO(i,z);
1089  * PETO(i,z)$(EXTO(i,z) > 0) = SUM[zj, PEO(i,z,zj) * EXO(i,z,zj)] / EXTO(i,z);
1090  * PETO(i,z)$(EXTO(i,z) = 0) = 0;
1091   PWMO(i,z,zj)    = PWXO(i,z,zj);
1092   IMO(i,zj,z)     = EXO(i,zj,z);
1093   IMTO(i,z)       = SUM[zj,IMO(i,zj,z)];
1094   
1095   DSO(j,i,z)      = DSO(j,i,z)/PLO(i,z);
1096   DSO_I(i,z)      = SUM(j,DSO(j,i,z));
1097   DSO_J(j,z)      = SUM(i,DSO(j,i,z));
1098   QO(i,z)         = IMTO(i,z)+DDO(i,z);
1099   
1100   MRGNO(i,z)$MRGNO(i,z)
1101                   = MRGNO(i,z)/[eO(z)*PWMGO(i)];
1102   
1103   XSO_I(i,z)      = EXTO(i,z)+DDO(i,z)+MRGNO(i,z);
1104   
1105   XSTO(j,z)       = sum(i, XSO(j,i,z));
1106   
1107   PO(i,z)         = [PETO(i,z)*EXTO(i,z)+PLO(i,z)*DSO_I(i,z)
1108                    +eO(z)*PWMGO(i)*MRGNO(i,z)]/XSO_I(i,z);
1109   
1110   PO2(j,i,z)$XSO(j,i,z) = 1;
1111   
1112   PO3(i,j,z)$XSO(j,i,z) = 1;
1113   
1114   PIO(i,z)       = SUM[j$XSO(j,i,z),PO2(J,I,z)*XSO(j,i,z)]/XSO_I(i,z);
1115   
1116   PTO(j,z)       = SUM[i$XSO(j,i,z),PO2(j,i,z)*XSO(j,i,z)]/XSTO(j,z);
1117   
1118   PPO(j,z)       = (TIWO(j,z)+WO(z)*LDO(j,z)
1119                    +SUM[k,TIKO(k,j,z)+RKDO(k,j,z)]
1120                    +SUM[nene,DIO(nene,j,z)]+SUM[ene,DIO(ene,j,z)])/XSTO(j,z);
1121   
1122   theta2(j,i,z)  = DSO(j,i,z)/sum(jj, DSO(jj,i,z));
1123   
1124   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z)*EXTO(i,z);
1125   
1126  *==============================================================================
1127  *  4.3 Calibration of tax rates, margins, prices and volumes
1128  *==============================================================================
1129  *  4.3.1 Margin rates and tax rates
1130  *==============================================================================
1131   ttixO(i,z,zj)   = [eO(z)*PWXO(i,z,zj)/PEO(i,z,zj)]-1;
1132   tticO(i,z)      = TICO(i,z)/{PLO(i,z)*DDO(i,z)
1133                     +SUM[zj,IMO(i,zj,z)*eO(z)*PWMO(i,zj,z)
1134                     +TIMO(i,zj,z)+SUM[ij,tmrg(ij,i,zj,z)]]};
1135   
1136   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
1137                   = tmrg(i,ij,zj,z)/(PWMGO(i)*eO(z)*IMO(ij,zj,z));
1138   
1139   ttimO(i,zj,z)$IMO(i,zj,z)
1140                   = TIMO(i,zj,z)/{IMO(i,zj,z)*eO(z)*(PWMO(i,zj,z)
1141                    +SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])};
1142   
1143   ttiwO(j,z)$LDO(j,z)
1144                   = TIWO(j,z)/[WO(z)*LDO(j,z)];
1145   
1146   ttikO(k,j,z)$RKDO(k,j,z)
1147                   = TIKO(k,j,z)/RKDO(k,j,z);
1148   
1149   ttipO(j,z)      = [PTO(j,z)/PPO(j,z)]-1;
1150   
1151   ttdh1O(z)       = [TDHO(z)-ttdh0O(z)]/YHO(z);
1152   
1153  *==============================================================================
1154  *  4.3.2 Calibration of other prices and revised volumes (part 2)
1155  *==============================================================================
1156   PDO(i,z)        = PLO(i,z)*(1+tticO(i,z));
1157   PMO(i,zj,z)     = eO(z)*(PWMO(i,zj,z)+SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])
1158                   *(1+ttimO(i,zj,z))*(1+tticO(i,z));
1159   PMTO(i,z)       = SUM[zj,PMO(i,zj,z)*IMO(i,zj,z)]/IMTO(i,z);
1160   PCO(i,z)        = [PMTO(i,z)*IMTO(i,z)+PDO(i,z)*DDO(i,z)]/QO(i,z);
1161   
1162   CO(i,z)         = CO(i,z)/PCO(i,z);
1163   CGO(i,z)        = CGO(i,z)/PCO(i,z);
1164   DIO(nene,j,z)   = DIO(nene,j,z)/PCO(nene,z);
1165   DEO(ene,j,z)    = DIO(ene,j,z)/PCO(ene,z);
1166   
1167   DEelecO(j,z)    = DIO("18_ELEC",j,z)/PCO("18_ELEC",z);
1168   DEnelecO(j,z)   = sum(ene3,DEO(ene3,j,z));
1169   
1170   DEcoalgasO(j,z) = sum(ene5,DEO(ene5,j,z));
1171   DEcoalO(j,z)    = DEO("02_COAL ",j,z);
1172   DEgasO(j,z)     = DEO("04_GAS",j,z);
1173   
1174   DEoilpetrolO(j,z) = sum(ene6,DEO(ene6,j,z));
1175   DEoilO(j,z)       = DEO("03_OIL",j,z);
1176   DEpetrolO(j,z)    = DEO("10_PETROLCOAL",j,z);
1177   
1178   INVO(i,z)       = INVO(i,z)/PCO(i,z);
1179   
1180   CIO(j,z)        = SUM[nene,DIO(nene,j,z)];
1181   CEO(j3,z)        = SUM[ene,DEO(ene,j3,z)];
1182   CEO(j2,z)        = DEelecO(j2,z)+DEnelecO(j2,z);
1183   
1184   DITO(nene,z)    = SUM[j,DIO(nene,j,z)];
1185   DITO(ene,z)     = SUM[j,DEO(ene,j,z)];
1186   
1187   PO4(ene,j,z)    = PCO(ene,z);
1188   
1189   PCIO(j,z)       = SUM[nene,PCO(nene,z)*DIO(nene,j,z)]/CIO(j,z);
1190   
1191   PCEcoalO(j,z)   = PO4("02_COAL",j,z) ;
1192   PCEgasO(j,z)    = PO4("04_GAS",j,z) ;
1193   PCEoilO(j,z)    = PO4("03_OIL",j,z) ;
1194   PCEpetrolO(j,z) = PO4("10_PETROLCOAL",j,z) ;
1195   
1196   PCEoilpetrolO(j,z)  = [PCEoilO(j,z)*DEoilO(j,z)+PCEpetrolO(j,z)*DEpetrolO(j,z)]
1197                     /DEoilpetrolO(j,z) ;
1198   
1199   PCEcoalgasO(j,z)  = [PCEcoalO(j,z)*DEcoalO(j,z)+PCEgasO(j,z)*DEgasO(j,z)]
1200                     /DEcoalgasO(j,z) ;
1201   
1202   PCEnelecO(j,z)  = [PCEcoalgasO(j,z)*DEcoalgasO(j,z)+PCEoilpetrolO(j,z)*DEoilpetrolO(j,z)]
1203                     /DEnelecO(j,z) ;
1204   
1205   PCEelecO(j,z)   = SUM[ene4,PCO(ene4,z)*DEO(ene4,j,z)]/DEelecO(j,z) ;
1206   PCEO(j,z)       = [PCEelecO(j,z)*DEelecO(j,z)+PCEnelecO(j,z)*DEnelecO(j,z)]/CEO(j,z) ;
1207   PCEO(j3,z)       = SUM[ene,PCO(ene,z)*DEO(ene,j3,z)]/CEO(j3,z) ;
1208   WTIO(j,z)     = WO(z)*(1+ttiwO(j,z));
1209   WCO(j,z)$LDCO(j,z)
1210                   = (WTIO(j,z)*LDO(j,z))/LDCO(j,z);
1211   
1212  *==============================================================================
1213  *  4.4 Calibration of dynamic parameters
1214  *==============================================================================
1215  * Calibration of dynamic parameters following new procedure.
1216  * The price of capital is arbitrary:
1217   PKO(z) = 1;
1218   
1219  * The calibration of depreciation rates is based on two hypotheses:
1220  * 1. The rate of depreciation is the same for all types of capital and all
1221  *    industries in each region (this hypothesis is made to accommodate the fact
1222  *    that, in the GTAP data base, capital consumption allowance is not detailed;
1223  *    as a matter of fact, the GTAP capital consumption allowance is set at
1224  *    4% of the value of the capital stock).
1225  * 2. The rental rate of capital is uniform across industries and types of
1226  *    capital in each region.
1227  * 3. The investment rate (IND/KD) is uniform across industries and types of
1228  *    capital in each region.
1229  * These hypotheses lead to the following formulae:
1230   
1231  * From GTAP, we know KSTO.
1232   KSTO(z)         = KSTO(z)/PKO(z);
1233   
1234  * Assuming a uniform depreciation rate for all types
1235  * of capital and all industries:
1236   delta(z)        = DEPO(z)/[PKO(z)*KSTO(z)];
1237   
1238  * From GTAP, we know KSTO. Assuming a uniform rental rate R for all types
1239  * of capital and all industries:
1240   RO(k,j,z)$RKDO(k,j,z)
1241                   = SUM[(kj,jj),RKDO(kj,jj,z)]/KSTO(z);
1242   
1243  * Then from the GTAP value of income paid to capital RKD we calibrate KDO:
1244   KDO(k,j,z)$RKDO(k,j,z)
1245                   = RKDO(k,j,z)/RO(k,j,z);
1246   
1247  * The supply of capital is equal to demand:
1248   KSO(k,z)        = SUM[j,KDO(k,j,z)];
1249   
1250  * The rate of return on capital, net of depreciation, is:
1251   IRO(z)         = {SUM[(k,j)$RKDO(k,j,z),RKDO(k,j,z)]-DEPO(z)}/[PKO(z)*KSTO(z)];
1252   
1253  * The user cost of capital follows
1254   UO(z)           = PKO(z)*(IRO(z)+delta(z));
1255   
1256  * Combining
1257  * - the hypothesis of uniform investment rates
1258  * - the hypothesis of uniform rental rates
1259  * - the hypothesis of uniform depreciation rates
1260  * leads to
1261   phiO(z)         = [ITO(z)/PKO(z)]/KSTO(z);
1262   
1263  * Investment by destination follows:
1264   INDO(k,j,z)$KDO(k,j,z)
1265                   = phiO(z)*KDO(k,j,z);
1266   
1267   A_K(z)          = 1/PKO(z)*{PROD[i$gamma_INV(i,z),(PCO(i,Z)/gamma_INV(i,z))
1268                     **gamma_INV(i,z)]};
1269   
1270   KDCO(j,z)       = SUM[k,KDO(k,j,z)];
1271   RTIO(k,j,z)     = RO(k,j,z)*(1+ttikO(k,j,z));
1272   RCO(j,z)$KDCO(j,z)
1273                   = SUM[k,RTIO(k,j,z)*KDO(k,j,z)]/KDCO(j,z);
1274   
1275  *==============================================================================
1276  *  4.5 Calibration of other prices and revised volumes (part 3)
1277  *==============================================================================
1278   VAO(j,z)        = LDCO(j,z)+KDCO(j,z);
1279   
1280   PVAO(j,z)       = [WCO(j,z)*LDCO(j,z)+RCO(j,z)*KDCO(j,z)]/VAO(j,z);
1281   
1282  * PIXGDPO is tautologically equal to 1, based on its formula
1283  * PIXGDPO(z)      = {SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1284  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1285  *                   *SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1286  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]}**0.5;
1287   PIXGDPO(z)      = 1;
1288   
1289  * PIXGDP_WO is tautologically equal to 1, based on its formula
1290  * PIXGDP_WO       = {SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1291  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1292  *                   *SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1293  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]/eO(z)}**0.5;
1294   PIXGDP_WO       = 1;
1295   
1296  * PIXCONO(z) is tautologically equal to 1, based on its formula
1297  * PIXCONO(z)      = SUM[i,PCO(i,z)*CO(i,z)]
1298  *                  /SUM[i,PCO(i,z)*CO(i,z)];
1299   PIXCONO(z)      = 1;
1300   PIXCONO_lag(z)  = PIXCONO(z);
1301   
1302  * PIXINVO(z) is tautologically equal to 1, based on its formula
1303  * PIXINVO(z)      = PROD[i$gamma_INV(i,z),(PCO(i,z)/PCO(i,z))**gamma_INV(i,z)];
1304   PIXINVO(z)      = 1;
1305   
1306  * PIXGVTO(z) is tautologically equal to 1, based on its formula
1307  * PIXGVTO(z)      = PROD[i$gamma_GVT(i,z),(PCO(i,z)/PCO(i,z))**gamma_GVT(i,z)];
1308   PIXGVTO(z)      = 1;
1309   
1310  *==============================================================================
1311  *  4.6 Calibration of function parameters
1312  *==============================================================================
1313  *   4.6.1 Leontief functions
1314  *==============================================================================
1315   io(j,z)         = CIO(j,z)/XSTO(j,z) ;
1316   
1317   io2(j,z)        = CEO(j,z)/XSTO(j,z) ;
1318   
1319   v(j,z)          = VAO(j,z)/XSTO(j,z) ;
1320   
1321   v2(j,z)         = (CEO(j,z)+VAO(j,z))/XSTO(j,z) ;
1322   
1323   aij(nene,j,z)   = DIO(nene,j,z)/CIO(j,z);
1324   
1325   aij2(ene,j,z)   = DEO(ene,j,z)/CEO(j,z);
1326   
1327  *==============================================================================
1328  *   4.6.2 Calibration of CET parameters
1329  *==============================================================================
1330  *    4.6.2.1 CET between total exports, domestic supply and margins
1331  *==============================================================================
1332   rho_X1(i,z)     = (1+sigma_X1(i,z))/sigma_X1(i,z);
1333   
1334   beta_EX_X1(i,z)$MRGNO(i,z)
1335                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1336                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1337                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1338                     eO(z)*PWMGO(i)*MRGNO(i,z)$MRGNO(i,z)**(1-rho_X1(i,z))];
1339   
1340   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1341                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1342                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1343                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1344   
1345   beta_D_X1(i,z)$MRGNO(i,z)
1346                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1347                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1348                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1349                     eO(z)*PWMGO(i)*MRGNO(i,z)**(1-rho_X1(i,z))];
1350   
1351   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1352                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1353                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1354                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1355   
1356   B_X1(i,z)       = XSO_I(i,z)/[beta_EX_X1(i,z)*EXTO(i,z)**rho_X1(i,z)
1357                    +beta_D_X1(i,z)*DSO_I(i,z)**rho_X1(i,z)+(1-beta_EX_X1(i,z)
1358                    -beta_D_X1(i,z))*MRGNO(i,z)**rho_X1(i,z)]**(1/rho_X1(i,z));
1359   
1360  *==============================================================================
1361  *    4.6.2.2 CET between exports to different trading partners
1362  *==============================================================================
1363   rho_X2(i,z)     = (1+sigma_X2(i,z))/sigma_X2(i,z);
1364   
1365   beta_X2(i,z,zj)$EXO(i,z,zj)
1366                   = [PEO(i,z,zj)*EXO(i,z,zj)**(1-rho_X2(i,z))]/
1367                     SUM[zjj$EXO(i,z,zjj),PEO(i,z,zjj)*EXO(i,z,zjj)
1368                     **(1-rho_X2(i,z))];
1369   
1370   B_X2(i,z)       = EXTO(i,z)/{SUM[zj,beta_X2(i,z,zj)*EXO(i,z,zj)**rho_X2(i,z)]
1371                     **(1/rho_X2(i,z))};
1372   
1373  *==============================================================================
1374  *   4.6.3 Calibration of CES parameters
1375  *==============================================================================
1376  *    4.6.3.0 Composite output
1377  *==============================================================================
1378   rho_X3(i,z)   = (1-sigma_X3(i,z))/sigma_X3(i,z);
1379   
1380   beta_X3(j,i,z)$XSO(j,i,z)
1381                 = [PO2(j,i,z)*XSO(j,i,z)**(1+rho_X3(i,z))]/
1382                     SUM[jj$XSO(jj,i,z),PO2(jj,i,z)*XSO(jj,i,z)**(1+rho_X3(i,z))];
1383   
1384   B_X3(i,z)     = XSO_I(i,z)
1385                    /SUM[jj$XSO(jj,i,z),beta_X3(jj,i,z)*XSO(jj,i,z)**(-rho_X3(i,z))
1386                    ]**(-1/rho_X3(i,z));
1387   
1388   POWERQO(Z) = SUM(POWER, XSO(power,'18_ELEC',z));
1389   
1390   rho_X4(z)   = (1-sigma_X4(z))/sigma_X4(z);
1391   
1392   beta_X4(power,z)
1393                 = [PO2(power,'18_ELEC',z)*XSO(power,'18_ELEC',z)**(1+rho_X4(z))]/
1394                     SUM[powerr$XSO(powerr,'18_ELEC',z),PO2(powerr,'18_ELEC',z)*XSO(powerr,'18_ELEC',z)**(1+rho_X4(z))];
1395   
1396   B_X4(z)     = POWERQO(Z)
1397                    /SUM[powerr$XSO(powerr,'18_ELEC',z),beta_X4(powerr,z)*XSO(powerr,'18_ELEC',z)**(-rho_X4(z))
1398                    ]**(-1/rho_X4(z));
1399   
1400   TnDShare(z) = XSO('18_TnD','18_ELEC',z)/XSO_I('18_ELEC',z);
1401   
1402   PPOWERO(z) = 1;
1403   
1404  *==============================================================================
1405  *    4.6.3.1 Composite good
1406  *==============================================================================
1407   rho_M1(i,z)     = (1-sigma_m1(i,z))/sigma_m1(i,z);
1408   
1409   beta_M1(i,z)    = PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)/
1410                    {PDO(i,z)*DDO(i,z)**(rho_M1(i,z)+1)
1411                    +PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)};
1412   
1413   B_M1(i,z)       = QO(i,z)/{beta_M1(i,z)*IMTO(i,z)**(-rho_M1(i,z))
1414                    +(1-beta_M1(i,z))*DDO(i,z)**(-rho_M1(i,z))}**(-1/rho_M1(i,z));
1415   
1416  *==============================================================================
1417  *    4.6.3.2 CES between imports from different trading partners
1418  *==============================================================================
1419   rho_M2(i,z)     = (1-sigma_M2(i,z))/sigma_M2(i,z);
1420   
1421   beta_M2(i,zj,z)$IMO(i,zj,z)
1422                   = [PMO(i,zj,z)*IMO(i,zj,z)**(rho_M2(i,z)+1)]/
1423                     SUM[zjj$IMO(i,zjj,z),PMO(i,zjj,z)*IMO(i,zjj,z)
1424                      **(rho_M2(i,z)+1)];
1425   
1426   B_M2(i,z)       = IMTO(i,z)/{SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*IMO(i,zj,z)
1427                     **(-rho_M2(i,z))]**(-1/rho_M2(i,z))};
1428   
1429  *==============================================================================
1430  *    4.6.3.3 Composite capital
1431  *==============================================================================
1432   rho_KD(j,z)     = (1-sigma_KD(j,z))/sigma_KD(j,z);
1433   
1434   beta_KD(k,j,z)$KDO(k,j,z)
1435                   = [RTIO(k,j,z)*KDO(k,j,z)**(1+rho_KD(j,z))]/
1436                     SUM[kj$KDO(kj,j,z),RTIO(kj,j,z)*KDO(kj,j,z)**(1+rho_KD(j,z))];
1437   B_KD(j,z)$KDCO(j,z)
1438                   = KDCO(j,z)/{SUM[k$KDO(k,j,z),beta_KD(k,j,z)*KDO(k,j,z)
1439                     **(-rho_KD(j,z))]**(-1/rho_KD(j,z))};
1440   
1441  *===============================================================================
1442  *   Composite E
1443  *===============================================================================
1444  *Leontief
1445   Share_Elec(j2,z) = DEO('18_ELEC',j2,z)/sum(ene,DEO(ene,j2,z));
1446   Share_nElec(ene3,j2,z) = DEO(ene3,j2,z)/sum(enee3,DEO(enee3,j2,z));
1447   Share_coalgas2(j2,z) = sum(ene5,DEO(ene5,j2,z))/sum(enee3,DEO(enee3,j2,z));
1448   Share_Oilpetrol2(j2,z) = sum(ene6,DEO(ene6,j2,z))/sum(enee3,DEO(enee3,j2,z));
1449   Share_coalgas(ene5,j2,z) = DEO(ene5,j2,z)/sum(enee5,DEO(enee5,j2,z));
1450   Share_Oilpetrol(ene6,j2,z) = DEO(ene6,j2,z)/sum(enee6,DEO(enee6,j2,z));
1451   
1452  *CES No Level
1453   rho_ENER(j,z)   = (1-sigma_ENER(j,z))/sigma_ENER(j,z);
1454   
1455   beta_ENER(ene,j,z)$DEO(ene,j,z)
1456                   = [PO4(ene,j,z)*DEO(ene,j,z)**(1+rho_ENER(j,z))]/
1457                     SUM[enee,PO4(enee,j,z)*DEO(enee,j,z)
1458                     **(1+rho_ENER(j,z))];
1459   
1460   B_ENER(j,z)$CEO(j,z)
1461                   = CEO(j,z)/{SUM[ene,beta_ENER(ene,j,z)*DEO(ene,j,z)
1462                     **(-rho_ENER(j,z))]**(-1/rho_ENER(j,z))};
1463   
1464   B_ENER_t(j,z,time) = B_ENER(j,z)*(1/AEEI_low(z,'2019'));
1465   
1466  *Level 5_1 (Coal/Gas)
1467   rho_ENER5_1(j2,z)   = (1-sigma_ENER5_1(j2,z))/sigma_ENER5_1(j2,z);
1468   
1469   beta_ENER5_1(ene5,j2,z)
1470                   = [PO4(ene5,j2,z)*DEO(ene5,j2,z)**(1+rho_ENER5_1(j2,z))]/
1471                     SUM[enee5,PO4(enee5,j2,z)*DEO(enee5,j2,z)
1472                     **(1+rho_ENER5_1(j2,z))];
1473   B_ENER5_1(j2,z)
1474                   = DEcoalgasO(j2,z)/{SUM[ene5,beta_ENER5_1(ene5,j2,z)*DEO(ene5,j2,z)
1475                     **(-rho_ENER5_1(j2,z))]**(-1/rho_ENER5_1(j2,z))};
1476   
1477  *Level 5_2 (oil/petrol)
1478   rho_ENER5_2(j2,z)   = (1-sigma_ENER5_2(j2,z))/sigma_ENER5_2(j2,z);
1479   
1480   beta_ENER5_2(ene6,j2,z)
1481                   = [PO4(ene6,j2,z)*DEO(ene6,j2,z)**(1+rho_ENER5_2(j2,z))]/
1482                     SUM[enee6,PO4(enee6,j2,z)*DEO(enee6,j2,z)
1483                     **(1+rho_ENER5_2(j2,z))];
1484   B_ENER5_2(j2,z)
1485                   = DEoilpetrolO(j2,z)/{SUM[ene6,beta_ENER5_2(ene6,j2,z)*DEO(ene6,j2,z)
1486                     **(-rho_ENER5_2(j2,z))]**(-1/rho_ENER5_2(j2,z))};
1487   
1488  *Level 4 (Coal-Gas/Oil-Petrol)
1489   rho_ENER4(j2,z)   = (1-sigma_ENER4(j2,z))/sigma_ENER4(j2,z);
1490   
1491   beta_ENER4(j2,z)
1492                   = PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)**(rho_ENER4(j2,z)+1)/
1493                    {PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)**(rho_ENER4(j2,z)+1)+
1494                     PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)**(rho_ENER4(j2,z)+1)};
1495   B_ENER4(j2,z)
1496                   = DEnelecO(j2,z)
1497                     /{[beta_ENER4(j2,z)*DEcoalgasO(j2,z)**(-rho_ENER4(j2,z))+
1498                     (1-beta_ENER4(j2,z))*DEoilpetrolO(j2,z)**(-rho_ENER4(j2,z))
1499                     ]**(-1/rho_ENER4(j2,z))};
1500   
1501  *Level 3 (Coal/Gas/Oil/Petrol)
1502   rho_ENER3(j2,z)   = (1-sigma_ENER3(j2,z))/sigma_ENER3(j2,z);
1503   
1504   beta_ENER3(ene3,j2,z)
1505                   = [PO4(ene3,j2,z)*DEO(ene3,j2,z)**(1+rho_ENER3(j2,z))]/
1506                     SUM[enee3,PO4(enee3,j2,z)*DEO(enee3,j2,z)
1507                     **(1+rho_ENER3(j2,z))];
1508   
1509   B_ENER3(j2,z)
1510                   = DEnelecO(j2,z)/{SUM[ene3,beta_ENER3(ene3,j2,z)*DEO(ene3,j2,z)
1511                     **(-rho_ENER3(j2,z))]**(-1/rho_ENER3(j2,z))};
1512   
1513  *Level 2 (Elec/Non Elec)
1514   rho_ENER2(j2,z)   = (1-sigma_ENER2(j2,z))/sigma_ENER2(j2,z);
1515   
1516   beta_ENER2(j2,z)
1517                   = PCEelecO(j2,z)*DEelecO(j2,z)**(rho_ENER2(j2,z)+1)/
1518                    {PCEelecO(j2,z)*DEelecO(j2,z)**(rho_ENER2(j2,z)+1)+
1519                     PCEnelecO(j2,z)*DEnelecO(j2,z)**(rho_ENER2(j2,z)+1)};
1520   B_ENER2(j2,z)
1521                   = CEO(j2,z)
1522                     /{[beta_ENER2(j2,z)*DEelecO(j2,z)**(-rho_ENER2(j2,z))+
1523                     (1-beta_ENER2(j2,z))*DEnelecO(j2,z)**(-rho_ENER2(j2,z))
1524                     ]**(-1/rho_ENER2(j2,z))};
1525   
1526  *==============================================================================
1527  *    4.6.3.5 Value added
1528  *==============================================================================
1529   rho_VA(j,z)     = (1-sigma_VA(j,z))/sigma_VA(j,z);
1530   
1531   beta_VA(j,z)$KDCO(j,z)
1532                   = WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)/
1533                    {WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)+
1534                     RCO(j,z)*KDCO(j,z)**(rho_VA(j,z)+1)};
1535   B_VA(j,z)$KDCO(j,z)
1536                   = VAO(j,z)
1537                     /{[beta_VA(j,z)*LDCO(j,z)**(-rho_VA(j,z))+
1538                     (1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
1539                     ]**(-1/rho_VA(j,z))};
1540   
1541   B_VA_t(j,z,time) = B_VA(j,z);
1542  * B_VA_t(j,z,time) = B_VA(j,z)*(1/AEEI_low(z,'2019'));
1543   
1544  *==============================================================================
1545  *    Composite KLE
1546  *==============================================================================
1547   KLEO(j,z)       = CEO(j,z) + VAO(j,z) ;
1548   
1549   PKLEO(j,z)      = [PCEO(j,z)*CEO(j,z)+PVAO(j,z)*VAO(j,z)]/KLEO(j,z);
1550   
1551   rho_KLE(j,z)    = (1-sigma_KLE(j,z))/sigma_KLE(j,z);
1552   
1553   beta_KLE(j,z)$KLEO(j,z)
1554                   = PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)/
1555                    {PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)+
1556                     PCEO(j,z)*CEO(j,z)**(rho_KLE(j,z)+1)};
1557   
1558   beta_KLE2(j,z)$KLEO(j,z)
1559                   = 1-beta_KLE(j,z);
1560   
1561   B_KLE(j,z)$KLEO(j,z)
1562                   = KLEO(j,z)
1563                     /{[beta_KLE(j,z)*VAO(j,z)**(-rho_KLE(j,z))+
1564                     (beta_KLE2(j,z))*CEO(j,z)**(-rho_KLE(j,z))
1565                     ]**(-1/rho_KLE(j,z))};
1566   
1567   beta_KLE2_t(j,z,time) = beta_KLE2(j,z)*AEEI_low(z,'2019');
1568   
1569  *==============================================================================
1570  *   4.6.4 Calibration of LES parameters
1571  *==============================================================================
1572  *   As the assigned values of income elasticities may not result in
1573  *   consumption shares that add up to 1, this first step
1574  *   adjusts the elasticities proportionally
1575   sigma_Y(i,z)    = sigma_Y(i,z)/{SUM[ij,sigma_Y(ij,z)*PCO(ij,z)*CO(ij,z)]
1576                     /CTHO(z)};
1577   gamma_LES(i,z)  = PCO(i,z)*CO(i,z)*sigma_Y(i,z)/CTHO(z);
1578   CMINO(i,z)      = CO(i,z)+gamma_LES(i,z)*CTHO(z)/{PCO(i,z)*frisch(z)};
1579   
1580  *==============================================================================
1581  *  4.7 Calibration of gross domestic products
1582  *==============================================================================
1583   GDP_BPO(z)      = SUM[j,PVAO(j,z)*VAO(j,z)]+TIPTO(z);
1584   GDP_MPO(z)      = GDP_BPO(z)+TPRCTSO(z);
1585  * GDP_IBO(z)      = SUM[(l,j),WO(l,z)*LDO(l,j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1586   GDP_IBO(z)      = SUM[(j),WO(z)*LDO(j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1587                     +TPRODNO(z)+TPRCTSO(z);
1588   GDP_FDO(z)      = SUM[i,PCO(i,z)*(CO(i,z)+CGO(i,z)+INVO(i,z))]
1589                    +eO(z)*SUM[(i,zj),PWXO(i,z,zj)*EXO(i,z,zj)]
1590                    +eO(z)*SUM[i,PWMGO(i)*MRGNO(i,z)]
1591                    -eO(z)*SUM[(i,zj),IMO(i,zj,z)*(PWMO(i,zj,z)
1592                    +SUM{ij,PWMGO(ij)*tmrg(ij,i,zj,z)})];
1593   GDP_BP_WO       = SUM[z,GDP_BPO(z)/eO(z)];
1594   
1595  *==============================================================================
1596  *  4.8 Calibration of real (volume) variables computed from price indices
1597  *==============================================================================
1598   CABXO(z)        = CABO(z)/[PIXGDP_WO*eO(z)];
1599   
1600  *------------------------------------------------------------------------------
1601  * Calculation of CAB index
1602  * If every region's CABX grows exogenously according to exogro, then the
1603  * worldwide sum of CABX's will not be zero. If, due to redundancy, the reference
1604  * region's CABX is left implicit, then it will not grow according to that
1605  * region's exogro (it follows that the solution will depend on the choice of
1606  * reference region). CABix is formed from exogro by inflating or deflating the
1607  * updating factors of positive (SURplus) and negative (DEFicit) CABX's in such
1608  * a way that their sum remains zero.
1609   
      Parameter CABXsur(z,time), CABXdef(z,time), bal(time), mu(time), CABix(z,time);
       CABXsur(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) gt 0];
       CABXdef(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) lt 0];
       Bal(time)       = sum(zj,CABXsur(zj,time))+sum(zj,CABXdef(zj,time));
       mu(time)        = sum(zj,CABXsur(zj,time))/
                           {sum(zj,CABXsur(zj,time))+sum(zj,abs[CABXdef(zj,time)])};
       CABXsur(z,time) = CABXsur(z,time)*{1-mu(time)*Bal(time)/sum(zj,CABXsur(zj,time))};
       CABXdef(z,time) = CABXdef(z,time)*{1-[1-mu(time)]*Bal(time)/sum(zj,CABXdef(zj,time))};
       CABix(z,time)   = [CABXsur(z,time)+CABXdef(z,time)]/CABXO(z);
1621  *------------------------------------------------------------------------------
1622   
1623   CTH_REALO(z)    = CTHO(z)/PIXCONO(z);
1624   G_REALO(z)      = GO(z)/PIXGVTO(z);
1625   GDP_BP_REALO(z) = GDP_BPO(z)/PIXGDPO(z);
1626   GDP_BP_W_REALO  = GDP_BP_WO/PIXGDP_WO;
1627   GDP_MP_REALO(z) = GDP_MPO(z)/PIXCONO(z);
1628   IT_REALO(z)     = ITO(z)/PIXINVO(z);
1629   
1630  *==============================================================================
1631  *  4.9 Parameters of the household savings function
1632  *==============================================================================
1633   sh1O(z)         = [SHO(z)+SGO(z)]/GDP_IBO(z);
1634   sh0O(z)         = SHO(z)-sh1O(z)*YDHO(z);
1635   
1636  *==============================================================================
1637  *  4.10 Re-calibration of indexed transfers and parameters
1638  *==============================================================================
1639   sh0O(z)         = sh0O(z)/PIXCONO(z)**eta;
1640   ttdh0O(z)       = ttdh0O(z)/PIXCONO(z)**eta;
1641   
1642  *==============================================================================
1643  *  4.9 CO2 emission
