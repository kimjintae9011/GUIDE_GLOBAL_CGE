 851   sigma_ENER(j,z)              = 1.1 ;
 852   sigma_ENER2(j2,z)           = 1.1 ;
 853  * sigma_ENER2(j2,z)          = 0.5;
 854   sigma_ENER3(j2,z)           = 1.1 ;
 855   sigma_ENER4(j2,z)           = 2.0 ;
 856   sigma_ENER5_1(j2,z)        = 2.0 ;
 857   sigma_ENER5_2(j2,z)        = 2.0 ;
