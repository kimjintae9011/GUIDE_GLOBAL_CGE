 847  *==============================================================================
 848  *   Rescaling
 849  *==============================================================================
 850  * GTAP data are in millions of US dollars With RES = 10000, model results are in tens of billions (10G$)
 851  RES              = 10000;
 852  CO(i,z)          = CO(i,z)/RES;
 853  CGO(i,z)         = CGO(i,z)/RES;
 854  DDO(i,z)         = DDO(i,z)/RES;
 855  DEPO(z)          = DEPO(z)/RES;
 856  DIO(i,j,z)       = DIO(i,j,z)/RES;
 857  DSO(j,i,z)       = DSO(j,i,z)/RES;
 858  DSO_I(i,z)       = DSO_I(i,z)/RES;
 859  EXO(i,z,zj)      = EXO(i,z,zj)/RES;
 860  IMO(i,z,zj)      = IMO(i,z,zj)/RES;
 861  INVO(i,z)        = INVO(i,z)/RES;
 862  KSTO(z)          = KSTO(z)/RES;
 863  LDO(j,z)         = LDO(j,z)/RES;
 864  MRGNO(i,z)       = MRGNO(i,z)/RES;
 865  RKDO(k,j,z)      = RKDO(k,j,z)/RES;
 866  TDHO(z)          = TDHO(z)/RES;
 867  TICO(i,z)        = TICO(i,z)/RES;
 868  TIKO(k,j,z)      = TIKO(k,j,z)/RES;
 869  TIMO(i,z,zj)     = TIMO(i,z,zj)/RES;
 870  TIPO(j,z)        = TIPO(j,z)/RES;
 871  TIWO(j,z)        = TIWO(j,z)/RES;
 872  TIXO(i,z,zj)     = TIXO(i,z,zj)/RES;
 873  tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj)/RES;
 874  XSO_I(i,z)       = XSO_I(i,z)/RES;
 875  XSO(j,i,z)       = XSO(j,i,z)/RES;
 876  XSTO(j,z)        = XSTO(j,z)/RES;
 877   
 878  *==============================================================================
 879  *  3.3 Exogenous prices and parameters
 880  *==============================================================================
 881  *  Price elasticity (should be equal to one to verify homogeneity)
 882  eta = 1;
 883   
 884  *------------------------------------------------------------------------------
 885  *  Slopes of taxation functions
 886  *   One can either choose to assign a value to the intercepts and calibrate
 887  *   the slopes accordingly, or the other way around. This type of modelling
 888  *   can be useful to take into account known marginal savings or taxation rates
 889  *   or to deal with negative average saving rates in cases where savings are
 890  *   negative for some household groups.
 891  *   When no further information is available, one can simply set the intercepts
 892  *   to zero and calibrate an average rate: this is what we do here for ttdh0O.
 893  *   If the user wishes to assume otherwise, he can fill the appropriate area in
 894  *   the Excel file VAL_PAR.xls.
 895  * ttdh0O(z)       = PARZ(z,'ttdh0O');
 896   ttdh0O(z)       = 0;
 897  *   The slope ttdh1O is calibrated below in the mane GAMS file
 898   
 899  *------------------------------------------------------------------------------
 900  * Also we need to assign values to some prices
 901  * All of the prices below, EXCEPT eO, may be set at arbitrary values
 902  * without loss of generality.
 903  *
 904  * In the case of eO, although exchange rates may be given arbitrary values
 905  * in the model, they must all be equal for calibration at this stage. The reason
 906  * is that the supply of margin transport services MRGNO must equal global demand.
 907  * Since there is a single world price for international transport margins
 908  * (rather than bilateral world prices for other commodities) the unit of
 909  * measurement of the volume of margin services must be the same for all regions,
 910  * and in turn, that implies that the divisor that converts the nominal value to
 911  * volume be the same for all regions. Since that divisor involves the exchange
 912  * rate, all exchange rates must be equal.
 913   
 914  * Normally, prices that may be given arbitrary values are set at 1:
 915   eO(z)            = 1;
 916   PEO(i,z,zj)      = 1;
 917   PLO(i,z)         = 1;
 918   PWMGO(i)         = 1;
 919   WO(z)            = 1;
 920   WO_lag(z)        = WO(z) ;
 921   
 922  *==============================================================================
 923  * Calibration
 924  *==============================================================================
 925   YHKO(z)         = SUM[(k,j),RKDO(k,j,z)];
 926   YHLO(z)         = SUM[(j),LDO(j,z)];
 927   YHO(z)          = YHLO(z)+YHKO(z);
 928   YDHO(z)         = YHO(z)-TDHO(z);
 929   CTHO(z)         = SUM[i,CO(i,z)];
 930   SHO(z)          = YDHO(z)-CTHO(z);
 931   TICTO(z)        = SUM[i,TICO(i,z)];
 932   TIMTO(z)        = SUM[(i,zj),TIMO(i,zj,z)];
 933   TIWTO(z)        = SUM[(j),TIWO(j,z)];
 934   TIKTO(z)        = SUM[(k,j),TIKO(k,j,z)];
 935   TIPTO(z)        = SUM[j,TIPO(j,z)];
 936   TIXTO(z)        = SUM[(i,zj),TIXO(i,z,zj)];
 937   TPRODNO(z)      = TIKTO(z)+TIWTO(z)+TIPTO(z);
 938   TPRCTSO(z)      = TICTO(z)+TIMTO(z)+TIXTO(z);
 939   YGO(z)          = TDHO(z)+TPRCTSO(z)+TPRODNO(z);
 940   GO(z)           = SUM[i,CGO(i,z)];
 941   SGO(z)          = YGO(z)-GO(z);
 942   YROWO(z)        = SUM[(i,zj),IMO(i,zj,z)]+SUM[(i,ij,zj),tmrg(i,ij,zj,z)];
 943   SROWO(z)        = YROWO(z)-SUM[(i,zj),EXO(i,z,zj)]-SUM[i,MRGNO(i,z)];
 944   CABO(z)         = -SROWO(z);
 945   ITO(z)          = SHO(z)+SGO(z)+SROWO(z);
 946   
 947  *==============================================================================
 948  *  Calibration of parameters and other variables
 949  *==============================================================================
 950  *  Calibration of investment and government spending shares
 951  *==============================================================================
 952   gamma_GVT(i,z)  = CGO(i,z)/SUM[ij,CGO(ij,z)];
 953   gamma_INV(i,z)  = INVO(i,z)/SUM[ij,INVO(ij,z)] ;
 954   
 955  *==============================================================================
 956  *  Calibration of other prices and revised volumes (part 1)
 957  *==============================================================================
 958   LDO(j,z)      = LDO(j,z)/WO(z);
 959   LDCO(j,z)     = LDO(j,z);
 960   LSO(z)        = SUM[j,LDO(j,z)];
 961   LSTO(z)       = LSO(z) ;
 962   LSO_lag(z)    = LSO(z) ;
 963   LSTO_lag(z)   = LSO(z) ;
 964   EXO(i,z,zj)  = [EXO(i,z,zj)-TIXO(i,z,zj)]/PEO(i,z,zj);
 965   EXTO(i,z)    = SUM[zj,EXO(i,z,zj)];
 966   PWXO(i,z,zj)$EXO(i,z,zj)
 967                   = {[PEO(i,z,zj)*EXO(i,z,zj)+TIXO(i,z,zj)]/EXO(i,z,zj)}/eO(z);
 968   
 969   PETO(i,z)       = SUM[zj,PEO(i,z,zj)*EXO(i,z,zj)]/EXTO(i,z);
 970  * PETO(i,z)$(EXTO(i,z) > 0) = SUM[zj, PEO(i,z,zj) * EXO(i,z,zj)] / EXTO(i,z);
 971  * PETO(i,z)$(EXTO(i,z) = 0) = 0;
 972   PWMO(i,z,zj)    = PWXO(i,z,zj);
 973   IMO(i,zj,z)     = EXO(i,zj,z);
 974   IMTO(i,z)       = SUM[zj,IMO(i,zj,z)];
 975   
 976   DSO(j,i,z)      = DSO(j,i,z)/PLO(i,z);
 977   DSO_I(i,z)      = SUM(j,DSO(j,i,z));
 978   DSO_J(j,z)      = SUM(i,DSO(j,i,z));
 979   QO(i,z)         = IMTO(i,z)+DDO(i,z);
 980   
 981   MRGNO(i,z)$MRGNO(i,z)
 982                   = MRGNO(i,z)/[eO(z)*PWMGO(i)];
 983   
 984   XSO_I(i,z)      = EXTO(i,z)+DDO(i,z)+MRGNO(i,z);
 985   
 986   XSTO(j,z)       = sum(i, XSO(j,i,z));
 987   
 988   PO(i,z)         = [PETO(i,z)*EXTO(i,z)+PLO(i,z)*DSO_I(i,z)
 989                    +eO(z)*PWMGO(i)*MRGNO(i,z)]/XSO_I(i,z);
 990   
 991   PO2(j,i,z)$XSO(j,i,z) = 1;
 992   
 993   PO3(i,j,z)$XSO(j,i,z) = 1;
 994   
 995   PIO(i,z)       = SUM[j$XSO(j,i,z),PO2(J,I,z)*XSO(j,i,z)]/XSO_I(i,z);
 996   
 997   PTO(j,z)       = SUM[i$XSO(j,i,z),PO2(j,i,z)*XSO(j,i,z)]/XSTO(j,z);
 998   
 999   PPO(j,z)       = (TIWO(j,z)+WO(z)*LDO(j,z)
1000                    +SUM[k,TIKO(k,j,z)+RKDO(k,j,z)]
1001                    +SUM[nene,DIO(nene,j,z)]+SUM[ene,DIO(ene,j,z)])/XSTO(j,z);
1002   
1003   theta2(j,i,z)  = DSO(j,i,z)/sum(jj, DSO(jj,i,z));
1004   
1005   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z)*EXTO(i,z);
1006   
1007  *==============================================================================
1008  *  Calibration of tax rates, margins, prices and volumes
1009  *==============================================================================
1010  *  Margin rates and tax rates
1011  *==============================================================================
1012   ttixO(i,z,zj)   = [eO(z)*PWXO(i,z,zj)/PEO(i,z,zj)]-1;
1013   tticO(i,z)      = TICO(i,z)/{PLO(i,z)*DDO(i,z)
1014                     +SUM[zj,IMO(i,zj,z)*eO(z)*PWMO(i,zj,z)
1015                     +TIMO(i,zj,z)+SUM[ij,tmrg(ij,i,zj,z)]]};
1016   
1017   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
1018                   = tmrg(i,ij,zj,z)/(PWMGO(i)*eO(z)*IMO(ij,zj,z));
1019   
1020   ttimO(i,zj,z)$IMO(i,zj,z)
1021                   = TIMO(i,zj,z)/{IMO(i,zj,z)*eO(z)*(PWMO(i,zj,z)
1022                    +SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])};
1023   
1024   ttiwO(j,z)$LDO(j,z)
1025                   = TIWO(j,z)/[WO(z)*LDO(j,z)];
1026   
1027   ttikO(k,j,z)$RKDO(k,j,z)
1028                   = TIKO(k,j,z)/RKDO(k,j,z);
1029   
1030   ttipO(j,z)      = [PTO(j,z)/PPO(j,z)]-1;
1031   
1032   ttdh1O(z)       = [TDHO(z)-ttdh0O(z)]/YHO(z);
1033   
1034  *==============================================================================
1035  *  Calibration of other prices and revised volumes (part 2)
1036  *==============================================================================
1037   PDO(i,z)        = PLO(i,z)*(1+tticO(i,z));
1038   PMO(i,zj,z)     = eO(z)*(PWMO(i,zj,z)+SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])
1039                   *(1+ttimO(i,zj,z))*(1+tticO(i,z));
1040   PMTO(i,z)       = SUM[zj,PMO(i,zj,z)*IMO(i,zj,z)]/IMTO(i,z);
1041   PCO(i,z)        = [PMTO(i,z)*IMTO(i,z)+PDO(i,z)*DDO(i,z)]/QO(i,z);
1042   
1043   CO(i,z)         = CO(i,z)/PCO(i,z);
1044   CGO(i,z)        = CGO(i,z)/PCO(i,z);
1045   DIO(nene,j,z)   = DIO(nene,j,z)/PCO(nene,z);
1046   DEO(ene,j,z)    = DIO(ene,j,z)/PCO(ene,z);
1047   
1048   DEelecO(j,z)    = DIO("18_ELEC",j,z)/PCO("18_ELEC",z);
1049   DEnelecO(j,z)   = sum(ene3,DEO(ene3,j,z));
1050   
1051   DEcoalgasO(j,z) = sum(ene5,DEO(ene5,j,z));
1052   DEcoalO(j,z)    = DEO("02_COAL ",j,z);
1053   DEgasO(j,z)     = DEO("04_GAS",j,z);
1054   
1055   DEoilpetrolO(j,z) = sum(ene6,DEO(ene6,j,z));
1056   DEoilO(j,z)       = DEO("03_OIL",j,z);
1057   DEpetrolO(j,z)    = DEO("10_PETROLCOAL",j,z);
1058   
1059   INVO(i,z)       = INVO(i,z)/PCO(i,z);
1060   
1061   CIO(j,z)        = SUM[nene,DIO(nene,j,z)];
1062   CEO(j3,z)        = SUM[ene,DEO(ene,j3,z)];
1063   CEO(j2,z)        = DEelecO(j2,z)+DEnelecO(j2,z);
1064   
1065   DITO(nene,z)    = SUM[j,DIO(nene,j,z)];
1066   DITO(ene,z)     = SUM[j,DEO(ene,j,z)];
1067   
1068   PO4(ene,j,z)    = PCO(ene,z);
1069   
1070   PCIO(j,z)       = SUM[nene,PCO(nene,z)*DIO(nene,j,z)]/CIO(j,z);
1071   
1072   PCEcoalO(j,z)   = PO4("02_COAL",j,z) ;
1073   PCEgasO(j,z)    = PO4("04_GAS",j,z) ;
1074   PCEoilO(j,z)    = PO4("03_OIL",j,z) ;
1075   PCEpetrolO(j,z) = PO4("10_PETROLCOAL",j,z) ;
1076   
1077   PCEoilpetrolO(j,z)  = [PCEoilO(j,z)*DEoilO(j,z)+PCEpetrolO(j,z)*DEpetrolO(j,z)]
1078                     /DEoilpetrolO(j,z) ;
1079   
1080   PCEcoalgasO(j,z)  = [PCEcoalO(j,z)*DEcoalO(j,z)+PCEgasO(j,z)*DEgasO(j,z)]
1081                     /DEcoalgasO(j,z) ;
1082   
1083   PCEnelecO(j,z)  = [PCEcoalgasO(j,z)*DEcoalgasO(j,z)+PCEoilpetrolO(j,z)*DEoilpetrolO(j,z)]
1084                     /DEnelecO(j,z) ;
1085   
1086   PCEelecO(j,z)   = SUM[ene4,PCO(ene4,z)*DEO(ene4,j,z)]/DEelecO(j,z) ;
1087   PCEO(j,z)       = [PCEelecO(j,z)*DEelecO(j,z)+PCEnelecO(j,z)*DEnelecO(j,z)]/CEO(j,z) ;
1088   PCEO(j3,z)       = SUM[ene,PCO(ene,z)*DEO(ene,j3,z)]/CEO(j3,z) ;
1089   WTIO(j,z)     = WO(z)*(1+ttiwO(j,z));
1090   WCO(j,z)$LDCO(j,z)
1091                   = (WTIO(j,z)*LDO(j,z))/LDCO(j,z);
1092   
1093  *==============================================================================
1094  *  Calibration of dynamic parameters
1095  *==============================================================================
1096  * Calibration of dynamic parameters following new procedure.
1097  * The price of capital is arbitrary:
1098   PKO(z) = 1;
1099   
1100  * The calibration of depreciation rates is based on two hypotheses:
1101  * 1. The rate of depreciation is the same for all types of capital and all
1102  *    industries in each region (this hypothesis is made to accommodate the fact
1103  *    that, in the GTAP data base, capital consumption allowance is not detailed;
1104  *    as a matter of fact, the GTAP capital consumption allowance is set at
1105  *    4% of the value of the capital stock).
1106  * 2. The rental rate of capital is uniform across industries and types of
1107  *    capital in each region.
1108  * 3. The investment rate (IND/KD) is uniform across industries and types of
1109  *    capital in each region.
1110  * These hypotheses lead to the following formulae:
1111   
1112  * From GTAP, we know KSTO.
1113   KSTO(z)         = KSTO(z)/PKO(z);
1114   
1115  * Assuming a uniform depreciation rate for all types
1116  * of capital and all industries:
1117   delta(z)        = DEPO(z)/[PKO(z)*KSTO(z)];
1118   
1119  * From GTAP, we know KSTO. Assuming a uniform rental rate R for all types
1120  * of capital and all industries:
1121   RO(k,j,z)$RKDO(k,j,z)
1122                   = SUM[(kj,jj),RKDO(kj,jj,z)]/KSTO(z);
1123   
1124  * Then from the GTAP value of income paid to capital RKD we calibrate KDO:
1125   KDO(k,j,z)$RKDO(k,j,z)
1126                   = RKDO(k,j,z)/RO(k,j,z);
1127   
1128  * The supply of capital is equal to demand:
1129   KSO(k,z)        = SUM[j,KDO(k,j,z)];
1130   
1131  * The rate of return on capital, net of depreciation, is:
1132   IRO(z)         = {SUM[(k,j)$RKDO(k,j,z),RKDO(k,j,z)]-DEPO(z)}/[PKO(z)*KSTO(z)];
1133   
1134  * The user cost of capital follows
1135   UO(z)           = PKO(z)*(IRO(z)+delta(z));
1136   
1137  * Combining
1138  * - the hypothesis of uniform investment rates
1139  * - the hypothesis of uniform rental rates
1140  * - the hypothesis of uniform depreciation rates
1141  * leads to
1142   phiO(z)         = [ITO(z)/PKO(z)]/KSTO(z);
1143   
1144  * Investment by destination follows:
1145   INDO(k,j,z)$KDO(k,j,z)
1146                   = phiO(z)*KDO(k,j,z);
1147   
1148   A_K(z)          = 1/PKO(z)*{PROD[i$gamma_INV(i,z),(PCO(i,Z)/gamma_INV(i,z))
1149                     **gamma_INV(i,z)]};
1150   
1151   KDCO(j,z)       = SUM[k,KDO(k,j,z)];
1152   RTIO(k,j,z)     = RO(k,j,z)*(1+ttikO(k,j,z));
1153   RCO(j,z)$KDCO(j,z)
1154                   = SUM[k,RTIO(k,j,z)*KDO(k,j,z)]/KDCO(j,z);
1155   
1156  *==============================================================================
1157  *  Calibration of other prices and revised volumes (part 3)
1158  *==============================================================================
1159   VAO(j,z)        = LDCO(j,z)+KDCO(j,z);
1160   
1161   PVAO(j,z)       = [WCO(j,z)*LDCO(j,z)+RCO(j,z)*KDCO(j,z)]/VAO(j,z);
1162   
1163  * PIXGDPO is tautologically equal to 1, based on its formula
1164  * PIXGDPO(z)      = {SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1165  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1166  *                   *SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
1167  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]}**0.5;
1168   PIXGDPO(z)      = 1;
1169   
1170  * PIXGDP_WO is tautologically equal to 1, based on its formula
1171  * PIXGDP_WO       = {SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1172  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1173  *                   *SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
1174  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]/eO(z)}**0.5;
1175   PIXGDP_WO       = 1;
1176   
1177  * PIXCONO(z) is tautologically equal to 1, based on its formula
1178  * PIXCONO(z)      = SUM[i,PCO(i,z)*CO(i,z)]
1179  *                  /SUM[i,PCO(i,z)*CO(i,z)];
1180   PIXCONO(z)      = 1;
1181   PIXCONO_lag(z)  = PIXCONO(z);
1182   
1183  * PIXINVO(z) is tautologically equal to 1, based on its formula
1184  * PIXINVO(z)      = PROD[i$gamma_INV(i,z),(PCO(i,z)/PCO(i,z))**gamma_INV(i,z)];
1185   PIXINVO(z)      = 1;
1186   
1187  * PIXGVTO(z) is tautologically equal to 1, based on its formula
1188  * PIXGVTO(z)      = PROD[i$gamma_GVT(i,z),(PCO(i,z)/PCO(i,z))**gamma_GVT(i,z)];
1189   PIXGVTO(z)      = 1;
1190   
1191  *==============================================================================
1192  *  Calibration of function parameters
1193  *==============================================================================
1194  *   Leontief functions
1195  *==============================================================================
1196   io(j,z)         = CIO(j,z)/XSTO(j,z) ;
1197   
1198   io2(j,z)        = CEO(j,z)/XSTO(j,z) ;
1199   
1200   v(j,z)          = VAO(j,z)/XSTO(j,z) ;
1201   
1202   v2(j,z)         = (CEO(j,z)+VAO(j,z))/XSTO(j,z) ;
1203   
1204   aij(nene,j,z)   = DIO(nene,j,z)/CIO(j,z);
1205   
1206   aij2(ene,j,z)   = DEO(ene,j,z)/CEO(j,z);
1207   
1208  *==============================================================================
1209  *   Calibration of CET parameters
1210  *==============================================================================
1211  *    CET between total exports, domestic supply and margins
1212  *==============================================================================
1213   rho_X1(i,z)     = (1+sigma_X1(i,z))/sigma_X1(i,z);
1214   
1215   beta_EX_X1(i,z)$MRGNO(i,z)
1216                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1217                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1218                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1219                     eO(z)*PWMGO(i)*MRGNO(i,z)$MRGNO(i,z)**(1-rho_X1(i,z))];
1220   
1221   beta_EX_X1(i,z)$(MRGNO(i,z) eq 0)
1222                   = [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))]/
1223                     [PETO(i,z)*EXTO(i,z)$EXTO(i,z)**(1-rho_X1(i,z))+
1224                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1225   
1226   beta_D_X1(i,z)$MRGNO(i,z)
1227                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1228                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1229                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))+
1230                     eO(z)*PWMGO(i)*MRGNO(i,z)**(1-rho_X1(i,z))];
1231   
1232   beta_D_X1(i,z)$(MRGNO(i,z) eq 0)
1233                   = [PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))]/
1234                     [PETO(i,z)*EXTO(i,z)**(1-rho_X1(i,z))+
1235                     PLO(i,z)*DSO_I(i,z)**(1-rho_X1(i,z))];
1236   
1237   B_X1(i,z)       = XSO_I(i,z)/[beta_EX_X1(i,z)*EXTO(i,z)**rho_X1(i,z)
1238                    +beta_D_X1(i,z)*DSO_I(i,z)**rho_X1(i,z)+(1-beta_EX_X1(i,z)
1239                    -beta_D_X1(i,z))*MRGNO(i,z)**rho_X1(i,z)]**(1/rho_X1(i,z));
1240   
1241  *==============================================================================
1242  *    CET between exports to different trading partners
1243  *==============================================================================
1244   rho_X2(i,z)     = (1+sigma_X2(i,z))/sigma_X2(i,z);
1245   
1246   beta_X2(i,z,zj)$EXO(i,z,zj)
1247                   = [PEO(i,z,zj)*EXO(i,z,zj)**(1-rho_X2(i,z))]/
1248                     SUM[zjj$EXO(i,z,zjj),PEO(i,z,zjj)*EXO(i,z,zjj)
1249                     **(1-rho_X2(i,z))];
1250   
1251   B_X2(i,z)       = EXTO(i,z)/{SUM[zj,beta_X2(i,z,zj)*EXO(i,z,zj)**rho_X2(i,z)]
1252                     **(1/rho_X2(i,z))};
1253   
1254  *==============================================================================
1255  *   Calibration of CES parameters
1256  *==============================================================================
1257  *    Composite output
1258  *==============================================================================
1259   rho_X3(i,z)   = (1-sigma_X3(i,z))/sigma_X3(i,z);
1260   
1261   beta_X3(j,i,z)$XSO(j,i,z)
1262                 = [PO2(j,i,z)*XSO(j,i,z)**(1+rho_X3(i,z))]/
1263                     SUM[jj$XSO(jj,i,z),PO2(jj,i,z)*XSO(jj,i,z)**(1+rho_X3(i,z))];
1264   
1265   B_X3(i,z)     = XSO_I(i,z)
1266                    /SUM[jj$XSO(jj,i,z),beta_X3(jj,i,z)*XSO(jj,i,z)**(-rho_X3(i,z))
1267                    ]**(-1/rho_X3(i,z));
1268   
1269   POWERQO(Z) = SUM(POWER, XSO(power,'18_ELEC',z));
1270   
1271   rho_X4(z)   = (1-sigma_X4(z))/sigma_X4(z);
1272   
1273   beta_X4(power,z)
1274                 = [PO2(power,'18_ELEC',z)*XSO(power,'18_ELEC',z)**(1+rho_X4(z))]/
1275                     SUM[powerr$XSO(powerr,'18_ELEC',z),PO2(powerr,'18_ELEC',z)*XSO(powerr,'18_ELEC',z)**(1+rho_X4(z))];
1276   
1277   B_X4(z)     = POWERQO(Z)
1278                    /SUM[powerr$XSO(powerr,'18_ELEC',z),beta_X4(powerr,z)*XSO(powerr,'18_ELEC',z)**(-rho_X4(z))
1279                    ]**(-1/rho_X4(z));
1280   
1281   TnDShare(z) = XSO('18_TnD','18_ELEC',z)/XSO_I('18_ELEC',z);
1282   
1283   PPOWERO(z) = 1;
1284   
1285  *==============================================================================
1286  *    Composite good
1287  *==============================================================================
1288   rho_M1(i,z)     = (1-sigma_m1(i,z))/sigma_m1(i,z);
1289   
1290   beta_M1(i,z)    = PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)/
1291                    {PDO(i,z)*DDO(i,z)**(rho_M1(i,z)+1)
1292                    +PMTO(i,z)*IMTO(i,z)**(rho_M1(i,z)+1)};
1293   
1294   B_M1(i,z)       = QO(i,z)/{beta_M1(i,z)*IMTO(i,z)**(-rho_M1(i,z))
1295                    +(1-beta_M1(i,z))*DDO(i,z)**(-rho_M1(i,z))}**(-1/rho_M1(i,z));
1296   
1297  *==============================================================================
1298  *   CES between imports from different trading partners
1299  *==============================================================================
1300   rho_M2(i,z)     = (1-sigma_M2(i,z))/sigma_M2(i,z);
1301   
1302   beta_M2(i,zj,z)$IMO(i,zj,z)
1303                   = [PMO(i,zj,z)*IMO(i,zj,z)**(rho_M2(i,z)+1)]/
1304                     SUM[zjj$IMO(i,zjj,z),PMO(i,zjj,z)*IMO(i,zjj,z)
1305                      **(rho_M2(i,z)+1)];
1306   
1307   B_M2(i,z)       = IMTO(i,z)/{SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*IMO(i,zj,z)
1308                     **(-rho_M2(i,z))]**(-1/rho_M2(i,z))};
1309   
1310  *==============================================================================
1311  *    Composite capital
1312  *==============================================================================
1313   rho_KD(j,z)     = (1-sigma_KD(j,z))/sigma_KD(j,z);
1314   
1315   beta_KD(k,j,z)$KDO(k,j,z)
1316                   = [RTIO(k,j,z)*KDO(k,j,z)**(1+rho_KD(j,z))]/
1317                     SUM[kj$KDO(kj,j,z),RTIO(kj,j,z)*KDO(kj,j,z)**(1+rho_KD(j,z))];
1318   B_KD(j,z)$KDCO(j,z)
1319                   = KDCO(j,z)/{SUM[k$KDO(k,j,z),beta_KD(k,j,z)*KDO(k,j,z)
1320                     **(-rho_KD(j,z))]**(-1/rho_KD(j,z))};
1321   
1322  *===============================================================================
1323  *   Composite E
1324  *===============================================================================
1325  *Leontief
1326   Share_Elec(j2,z) = DEO('18_ELEC',j2,z)/sum(ene,DEO(ene,j2,z));
1327   Share_nElec(ene3,j2,z) = DEO(ene3,j2,z)/sum(enee3,DEO(enee3,j2,z));
1328   Share_coalgas2(j2,z) = sum(ene5,DEO(ene5,j2,z))/sum(enee3,DEO(enee3,j2,z));
1329   Share_Oilpetrol2(j2,z) = sum(ene6,DEO(ene6,j2,z))/sum(enee3,DEO(enee3,j2,z));
1330   Share_coalgas(ene5,j2,z) = DEO(ene5,j2,z)/sum(enee5,DEO(enee5,j2,z));
1331   Share_Oilpetrol(ene6,j2,z) = DEO(ene6,j2,z)/sum(enee6,DEO(enee6,j2,z));
1332   
1333  *CES No Level
1334   rho_ENER(j,z)   = (1-sigma_ENER(j,z))/sigma_ENER(j,z);
1335   
1336   beta_ENER(ene,j,z)$DEO(ene,j,z)
1337                   = [PO4(ene,j,z)*DEO(ene,j,z)**(1+rho_ENER(j,z))]/
1338                     SUM[enee,PO4(enee,j,z)*DEO(enee,j,z)
1339                     **(1+rho_ENER(j,z))];
1340   
1341   B_ENER(j,z)$CEO(j,z)
1342                   = CEO(j,z)/{SUM[ene,beta_ENER(ene,j,z)*DEO(ene,j,z)
1343                     **(-rho_ENER(j,z))]**(-1/rho_ENER(j,z))};
1344   
1345   B_ENER_t(j,z,time) = B_ENER(j,z)*(1/AEEI_low(z,'2019'));
1346   
1347  *Level 5_1 (Coal/Gas)
1348   rho_ENER5_1(j2,z)   = (1-sigma_ENER5_1(j2,z))/sigma_ENER5_1(j2,z);
1349   
1350   beta_ENER5_1(ene5,j2,z)
1351                   = [PO4(ene5,j2,z)*DEO(ene5,j2,z)**(1+rho_ENER5_1(j2,z))]/
1352                     SUM[enee5,PO4(enee5,j2,z)*DEO(enee5,j2,z)
1353                     **(1+rho_ENER5_1(j2,z))];
1354   B_ENER5_1(j2,z)
1355                   = DEcoalgasO(j2,z)/{SUM[ene5,beta_ENER5_1(ene5,j2,z)*DEO(ene5,j2,z)
1356                     **(-rho_ENER5_1(j2,z))]**(-1/rho_ENER5_1(j2,z))};
1357   
1358  *Level 5_2 (oil/petrol)
1359   rho_ENER5_2(j2,z)   = (1-sigma_ENER5_2(j2,z))/sigma_ENER5_2(j2,z);
1360   
1361   beta_ENER5_2(ene6,j2,z)
1362                   = [PO4(ene6,j2,z)*DEO(ene6,j2,z)**(1+rho_ENER5_2(j2,z))]/
1363                     SUM[enee6,PO4(enee6,j2,z)*DEO(enee6,j2,z)
1364                     **(1+rho_ENER5_2(j2,z))];
1365   B_ENER5_2(j2,z)
1366                   = DEoilpetrolO(j2,z)/{SUM[ene6,beta_ENER5_2(ene6,j2,z)*DEO(ene6,j2,z)
1367                     **(-rho_ENER5_2(j2,z))]**(-1/rho_ENER5_2(j2,z))};
1368   
1369  *Level 4 (Coal-Gas/Oil-Petrol)
1370   rho_ENER4(j2,z)   = (1-sigma_ENER4(j2,z))/sigma_ENER4(j2,z);
1371   
1372   beta_ENER4(j2,z)
1373                   = PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)**(rho_ENER4(j2,z)+1)/
1374                    {PCEcoalgasO(j2,z)*DEcoalgasO(j2,z)**(rho_ENER4(j2,z)+1)+
1375                     PCEoilpetrolO(j2,z)*DEoilpetrolO(j2,z)**(rho_ENER4(j2,z)+1)};
1376   B_ENER4(j2,z)
1377                   = DEnelecO(j2,z)
1378                     /{[beta_ENER4(j2,z)*DEcoalgasO(j2,z)**(-rho_ENER4(j2,z))+
1379                     (1-beta_ENER4(j2,z))*DEoilpetrolO(j2,z)**(-rho_ENER4(j2,z))
1380                     ]**(-1/rho_ENER4(j2,z))};
1381   
1382  *Level 3 (Coal/Gas/Oil/Petrol)
1383   rho_ENER3(j2,z)   = (1-sigma_ENER3(j2,z))/sigma_ENER3(j2,z);
1384   
1385   beta_ENER3(ene3,j2,z)
1386                   = [PO4(ene3,j2,z)*DEO(ene3,j2,z)**(1+rho_ENER3(j2,z))]/
1387                     SUM[enee3,PO4(enee3,j2,z)*DEO(enee3,j2,z)
1388                     **(1+rho_ENER3(j2,z))];
1389   
1390   B_ENER3(j2,z)
1391                   = DEnelecO(j2,z)/{SUM[ene3,beta_ENER3(ene3,j2,z)*DEO(ene3,j2,z)
1392                     **(-rho_ENER3(j2,z))]**(-1/rho_ENER3(j2,z))};
1393   
1394  *Level 2 (Elec/Non Elec)
1395   rho_ENER2(j2,z)   = (1-sigma_ENER2(j2,z))/sigma_ENER2(j2,z);
1396   
1397   beta_ENER2(j2,z)
1398                   = PCEelecO(j2,z)*DEelecO(j2,z)**(rho_ENER2(j2,z)+1)/
1399                    {PCEelecO(j2,z)*DEelecO(j2,z)**(rho_ENER2(j2,z)+1)+
1400                     PCEnelecO(j2,z)*DEnelecO(j2,z)**(rho_ENER2(j2,z)+1)};
1401   B_ENER2(j2,z)
1402                   = CEO(j2,z)
1403                     /{[beta_ENER2(j2,z)*DEelecO(j2,z)**(-rho_ENER2(j2,z))+
1404                     (1-beta_ENER2(j2,z))*DEnelecO(j2,z)**(-rho_ENER2(j2,z))
1405                     ]**(-1/rho_ENER2(j2,z))};
1406   
1407  *==============================================================================
1408  *    4.6.3.5 Value added
1409  *==============================================================================
1410   rho_VA(j,z)     = (1-sigma_VA(j,z))/sigma_VA(j,z);
1411   
1412   beta_VA(j,z)$KDCO(j,z)
1413                   = WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)/
1414                    {WCO(j,z)*LDCO(j,z)**(rho_VA(j,z)+1)+
1415                     RCO(j,z)*KDCO(j,z)**(rho_VA(j,z)+1)};
1416   B_VA(j,z)$KDCO(j,z)
1417                   = VAO(j,z)
1418                     /{[beta_VA(j,z)*LDCO(j,z)**(-rho_VA(j,z))+
1419                     (1-beta_VA(j,z))*KDCO(j,z)**(-rho_VA(j,z))
1420                     ]**(-1/rho_VA(j,z))};
1421   
1422  *==============================================================================
1423  *    Composite KLE
1424  *==============================================================================
1425   KLEO(j,z)       = CEO(j,z) + VAO(j,z) ;
1426   
1427   PKLEO(j,z)      = [PCEO(j,z)*CEO(j,z)+PVAO(j,z)*VAO(j,z)]/KLEO(j,z);
1428   
1429   rho_KLE(j,z)    = (1-sigma_KLE(j,z))/sigma_KLE(j,z);
1430   
1431   beta_KLE(j,z)$KLEO(j,z)
1432                   = PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)/
1433                    {PVAO(j,z)*VAO(j,z)**(rho_KLE(j,z)+1)+
1434                     PCEO(j,z)*CEO(j,z)**(rho_KLE(j,z)+1)};
1435   
1436   beta_KLE2(j,z)$KLEO(j,z)
1437                   = 1-beta_KLE(j,z);
1438   
1439   B_KLE(j,z)$KLEO(j,z)
1440                   = KLEO(j,z)
1441                     /{[beta_KLE(j,z)*VAO(j,z)**(-rho_KLE(j,z))+
1442                     (beta_KLE2(j,z))*CEO(j,z)**(-rho_KLE(j,z))
1443                     ]**(-1/rho_KLE(j,z))};
1444   
1445   beta_KLE2_t(j,z,time) = beta_KLE2(j,z)*AEEI_low(z,'2019');
1446   
1447  *==============================================================================
1448  *  Calibration of LES parameters
1449  *==============================================================================
1450  *   As the assigned values of income elasticities may not result in
1451  *   consumption shares that add up to 1, this first step
1452  *   adjusts the elasticities proportionally
1453   sigma_Y(i,z)    = sigma_Y(i,z)/{SUM[ij,sigma_Y(ij,z)*PCO(ij,z)*CO(ij,z)]
1454                     /CTHO(z)};
1455   gamma_LES(i,z)  = PCO(i,z)*CO(i,z)*sigma_Y(i,z)/CTHO(z);
1456   CMINO(i,z)      = CO(i,z)+gamma_LES(i,z)*CTHO(z)/{PCO(i,z)*frisch(z)};
1457   
1458  *==============================================================================
1459  *  Calibration of gross domestic products
1460  *==============================================================================
1461   GDP_BPO(z)      = SUM[j,PVAO(j,z)*VAO(j,z)]+TIPTO(z);
1462   GDP_MPO(z)      = GDP_BPO(z)+TPRCTSO(z);
1463  * GDP_IBO(z)      = SUM[(l,j),WO(l,z)*LDO(l,j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1464   GDP_IBO(z)      = SUM[(j),WO(z)*LDO(j,z)]+SUM[(k,j),RO(k,j,z)*KDO(k,j,z)]
1465                     +TPRODNO(z)+TPRCTSO(z);
1466   GDP_FDO(z)      = SUM[i,PCO(i,z)*(CO(i,z)+CGO(i,z)+INVO(i,z))]
1467                    +eO(z)*SUM[(i,zj),PWXO(i,z,zj)*EXO(i,z,zj)]
1468                    +eO(z)*SUM[i,PWMGO(i)*MRGNO(i,z)]
1469                    -eO(z)*SUM[(i,zj),IMO(i,zj,z)*(PWMO(i,zj,z)
1470                    +SUM{ij,PWMGO(ij)*tmrg(ij,i,zj,z)})];
1471   GDP_BP_WO       = SUM[z,GDP_BPO(z)/eO(z)];
1472   
1473  *==============================================================================
1474  *  4.8 Calibration of real (volume) variables computed from price indices
1475  *==============================================================================
1476   CABXO(z)        = CABO(z)/[PIXGDP_WO*eO(z)];
1477   
1478  *------------------------------------------------------------------------------
1479  * Calculation of CAB index
1480  * If every region's CABX grows exogenously according to exogro, then the
1481  * worldwide sum of CABX's will not be zero. If, due to redundancy, the reference
1482  * region's CABX is left implicit, then it will not grow according to that
1483  * region's exogro (it follows that the solution will depend on the choice of
1484  * reference region). CABix is formed from exogro by inflating or deflating the
1485  * updating factors of positive (SURplus) and negative (DEFicit) CABX's in such
1486  * a way that their sum remains zero.
1487   
      Parameter CABXsur(z,time), CABXdef(z,time), bal(time), mu(time), CABix(z,time);
       CABXsur(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) gt 0];
       CABXdef(z,time) = CABXO(z)*exogro(z,time)$[CABXO(z) lt 0];
       Bal(time)       = sum(zj,CABXsur(zj,time))+sum(zj,CABXdef(zj,time));
       mu(time)        = sum(zj,CABXsur(zj,time))/
                           {sum(zj,CABXsur(zj,time))+sum(zj,abs[CABXdef(zj,time)])};
       CABXsur(z,time) = CABXsur(z,time)*{1-mu(time)*Bal(time)/sum(zj,CABXsur(zj,time))};
       CABXdef(z,time) = CABXdef(z,time)*{1-[1-mu(time)]*Bal(time)/sum(zj,CABXdef(zj,time))};
       CABix(z,time)   = [CABXsur(z,time)+CABXdef(z,time)]/CABXO(z);
1499  *------------------------------------------------------------------------------
1500   
1501   CTH_REALO(z)    = CTHO(z)/PIXCONO(z);
1502   G_REALO(z)      = GO(z)/PIXGVTO(z);
1503   GDP_BP_REALO(z) = GDP_BPO(z)/PIXGDPO(z);
1504   GDP_BP_W_REALO  = GDP_BP_WO/PIXGDP_WO;
1505   GDP_MP_REALO(z) = GDP_MPO(z)/PIXCONO(z);
1506   IT_REALO(z)     = ITO(z)/PIXINVO(z);
1507   
1508  *==============================================================================
1509  *  Parameters of the household savings function
1510  *==============================================================================
1511   sh1O(z)         = [SHO(z)+SGO(z)]/GDP_IBO(z);
1512   sh0O(z)         = SHO(z)-sh1O(z)*YDHO(z);
1513   
1514  *==============================================================================
1515  *  Re-calibration of indexed transfers and parameters
1516  *==============================================================================
1517   sh0O(z)         = sh0O(z)/PIXCONO(z)**eta;
1518   ttdh0O(z)       = ttdh0O(z)/PIXCONO(z)**eta;
