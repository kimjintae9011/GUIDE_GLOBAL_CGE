3353  *==============================================================================
3354  *  4.12 CO2FACTOR and CTAX
3355  *==============================================================================
3356  Parameters
3357   CO2_Energy(ene,j,z)        CO2 emissions from Energy
3358  ;
3359   
3360   CO2_Energy('02_COAL',j,z) = sum(p_coal,CO2IO(p_coal,j,z));
3361   CO2_Energy('03_OIL',j,z)  = sum(p_oil,CO2IO(p_oil,j,z));
3362   CO2_Energy('04_GAS',j,z)  = sum(p_gas,CO2IO(p_gas,j,z));
3363   CO2_Energy('10_PETROLCOAL',j,z)  = sum(p_oilproduct,CO2IO(p_oilproduct,j,z));
3364   
3365  Parameters
3366   CO2FACTOR(ene,j,z)       CO2 emissions factor (tCO2 per 100$)
3367   CO2FACTOR2(ene,j,z,time) Time series CO2 emissions factor (tCO2 per 100$)
3368  ;
3369   
3370   CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*(1000/(10**8));
3371   CO2FACTOR('03_OIL',j,z)$DEO('03_OIL',j,z)   = [sum(p_oil,CO2IO(p_oil,j,z))/DEO('03_OIL',j,z)]*(1000/(10**8));
3372   CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z)   = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*(1000/(10**8));
3373   CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*(1000/(10**8));
3374   
3375  *PRK
3376   CO2FACTOR('02_COAL','01_AGRICULT','06_PRK')        = CO2FACTOR('02_COAL','01_AGRICULT','05_MNG');
3377   CO2FACTOR('10_PETROLCOAL','01_AGRICULT','06_PRK')  = CO2FACTOR('10_PETROLCOAL','01_AGRICULT','05_MNG');
3378   CO2FACTOR('02_COAL','28_LTRP','06_PRK')            = CO2FACTOR('02_COAL','28_LTRP','05_MNG');
3379   CO2FACTOR('02_COAL','17_OTHERIND','06_PRK')        = CO2FACTOR('02_COAL','17_OTHERIND','05_MNG');
3380   
3381  *RUS
3382   CO2FACTOR('02_COAL','08_WOODPRO','04_RUS')         = CO2FACTOR('02_COAL','08_WOODPRO','10_EEU');
3383   
3384  *LAM
3385   CO2FACTOR('04_GAS','02_COAL','08_LAM')             = CO2FACTOR('04_GAS','02_COAL','07_NAM');
3386   
3387   CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) gt 10) = 10 ;
3388   CO2FACTOR(ene,j,z)$(CO2FACTOR(ene,j,z) lt 0) = 3.28666e-05 ;
3389  * CO2FACTOR2(ene,j,z)$(CO2FACTOR2(ene,j,z) lt 0.1) = 0.1 ;
3390   
3391   CO2FACTOR2(ene,j,z,time) = CO2FACTOR(ene,j,z);
3392   
      *Petrolcoal
       CO2FACTOR('10_PETROLCOAL','10_PETROLCOAL',z) = 0;
       CO2FACTOR('02_COAL','10_PETROLCOAL',z) = CO2FACTOR('02_COAL','13_IRONSTL',z);
       
      *KOR
      * CO2FACTOR('02_COAL','10_PETROLCOAL','01_KOR') = 0;
      * CO2FACTOR(ene,'20_eCoal','01_KOR') =  CO2FACTOR(ene,'20_eCoal','03_JPN');
