3186   NCoal_Total(p_coal,z) = sum(j, NCoal_DIO(p_coal,j,z)) ;
3187   NGas_Total(p_gas,z) = sum(j, NGas_DIO(p_gas,j,z)) ;
3188   NOilp_Total(p_oilproduct,z) = sum(j, NOilp_DIO(p_oilproduct,j,z)) ;
3189   
3190  *Total Energy Supply
3191   TES_Coal(p_coal_TES,z)    =  sum(f_TES, WEB(f_TES, p_coal_TES, z));
3192   TES_Gas(p_gas,z)          =  sum(f_TES, WEB(f_TES, p_gas, z));
3193   TES_Oil(p_oil,z)          =  sum(f_TES, WEB(f_TES, p_oil, z));
3194   
3195   
3196  *=============================Eelectricity============================================================
3197   ElecNucGWh('19_eNuclear',z)  = sum((f_elecoutput, p_nuclear), WEB(f_elecoutput, p_nuclear,z));
3198   ElecCoalGWh('20_eCoal',z)    = sum((f_elecoutput, p_coal), WEB(f_elecoutput, p_coal,z));
3199   ElecGasGWh('21_eGas',z)      = sum((f_elecoutput, p_gas), WEB(f_elecoutput, p_gas,z));
3200   ElecOilGWh('22_eOil',z)      = sum((f_elecoutput, p_oilproduct), WEB(f_elecoutput, p_oilproduct,z));
3201   ElecWindGWh('23_eWind',z)    = sum((f_elecoutput, p_wind), WEB(f_elecoutput, p_wind,z));
3202   ElecSolarGWh('24_eSolar',z)  = sum((f_elecoutput, p_solar), WEB(f_elecoutput, p_solar,z));
3203   ElecHydroGWh('25_eHydro',z)  = sum((f_elecoutput, p_hydro), WEB(f_elecoutput, p_Hydro,z));
3204  * ElecOtherGWh('26_eOther',z)  = sum((f_elecoutput, p_elecother), WEB(f_elecoutput, p_elecother,z));
3205   ElecwasteGWh('26_eOther',z)  = sum((f_elecoutput, p_elecwaste), WEB(f_elecoutput, p_elecwaste,z));
3206   ElecbioGWh('26_eOther',z)    = sum((f_elecoutput, p_elecbio), WEB(f_elecoutput, p_elecbio,z));
3207   ElecgeoGWh('26_eOther',z)    = sum((f_elecoutput, p_elecgeo), WEB(f_elecoutput, p_elecgeo,z));
3208   ElecOtherGWh('26_eOther',z)  = sum((f_elecoutput, p_elecother), WEB(f_elecoutput, p_elecother,z));
