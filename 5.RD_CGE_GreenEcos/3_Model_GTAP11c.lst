3851  *==============================================================================
3852  *  5.3 Equations
3853  *==============================================================================
3854  *   5.3.1 Production
3855  *==============================================================================
3856   EQ1(j3,z,t)..     VA(j3,z,t) =e= v(j3,z)*XST(j3,z,t);
3857   
3858   EQ1_1(j2,z,t)..   KLE(j2,z,t) =e= v2(j2,z)*XST(j2,z,t);
3859   
3860   EQ2(j,z,t)..      CI(j,z,t) =e= io(j,z)*XST(j,z,t);
3861   
3862   EQ2_1(j3,z,t)..   CE(j3,z,t) =e= io2(j3,z)*XST(j3,z,t);
3863   
3864   EQ3(j,z,t)..      VA(j,z,t) =e= A_VA(z,t)*B_VA(j,z)*{
3865                      [beta_VA(j,z)*LDC(j,z,t)**(-rho_VA(j,z))]$LDCO(j,z)
3866                     +[(1-beta_VA(j,z))*KDC(j,z,t)**(-rho_VA(j,z))]$KDCO(j,z)
3867                                                     }**(-1/rho_VA(j,z));
3868   
3869   EQ3_1(j2,z,t)..   KLE(j2,z,t) =e= B_KLE(j2,z)*{
3870                      [beta_KLE(j2,z)*VA(j2,z,t)**(-rho_KLE(j2,z))]$VAO(j2,z)
3871                     +[(1-beta_KLE(j2,z))*CE(j2,z,t)**(-rho_KLE(j2,z))]$CEO(j2,z)
3872                                                     }**(-1/rho_KLE(j2,z));
3873   
3874   EQ4_1(j2,z,t)$[VAO(j2,z) and CEO(j2,z)]..
3875                   VA(j2,z,t) =e= {[(1-beta_KLE2(j2,z))/(beta_KLE2(j2,z))]
3876                                *[PCE(j2,z,t)/PVA(j2,z,t)]}**sigma_KLE(j2,z)*CE(j2,z,t);
3877   
3878   EQ4(j,z,t)$[LDCO(j,z) and KDCO(j,z)]..
3879                   LDC(j,z,t) =e= {[beta_VA(j,z)/(1-beta_VA(j,z))]
3880                                *[RC(j,z,t)/WC(j,z,t)]}**sigma_VA(j,z)*KDC(j,z,t);
3881   
3882  * EQ5(j,z,t)$LDCO(j,z)..
3883  *                 LDC(j,z,t) =e= B_LD(j,z)*SUM[l$LDO(l,j,z),beta_LD(l,j,z)
3884  *                                *LD(l,j,z,t)**(-rho_LD(j,z))]**(-1/rho_LD(j,z));
3885   
3886   EQ5(j,z,t)$LDCO(j,z)..
3887                   LDC(j,z,t) =e= LD(j,z,t);
3888   
3889  * EQ6(l,j,z,t)$LDO(l,j,z)..
3890  *                 LD(l,j,z,t) =e= [beta_LD(l,j,z)*WC(j,z,t)/WTI(l,j,z,t)]
3891  *                               **sigma_LD(j,z)*B_LD(j,z)**(sigma_LD(j,z)-1)
3892  *                               *LDC(j,z,t);
3893   
3894   EQ7(j,z,t)$KDCO(j,z)..
3895                   KDC(j,z,t) =e= B_KD(j,z)*SUM[k$KDO(k,j,z),beta_KD(k,j,z)
3896                                  *KD(k,j,z,t)**(-rho_KD(j,z))]**(-1/rho_KD(j,z));
3897   
3898   EQ8(k,j,z,t)$KDO(k,j,z)..
3899                   KD(k,j,z,t) =e= [beta_KD(k,j,z)*RC(j,z,t)/RTI(k,j,z,t)]
3900                                   **sigma_KD(j,z)*B_KD(j,z)**(sigma_KD(j,z)-1)
3901                                   *KDC(j,z,t);
3902   
3903   EQ9(nene,j,z,t)..   DI(nene,j,z,t) =e= aij(nene,j,z)*CI(j,z,t) ;
3904   
3905   EQ9_1(ene,j3,z,t)..  DE(ene,j3,z,t)   =e= aij2(ene,j3,z)*CE(j3,z,t) ;
3906   
3907  *=============================Simple Nesting=========================================
3908  * EQ9_2(ene,j2,z,t)..  DE(ene,j2,z,t) =e= [beta_ENER_t(ene,j2,z,t)*PCE(j2,z,t)/((P4(ene,j2,z,t)+P4(ene,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j2,z,t)))]
3909  *                                   **sigma_ENER(j2,z)*B_ENER_t(j2,z,t)**(sigma_ENER(j2,z)-1)
3910  *                                   *CE(j2,z,t);
3911   
3912  *=============================Leontief===========================================
3913  * EQ9_2(j2,z,t)..       DEelec(j2,z,t)  =e= Share_Elec(j2,z)*CE(j2,z,t);
3914   
3915  * EQ9_3(j2,z,t)..       DEnelec(j2,z,t) =e= (1-Share_Elec(j2,z))*CE(j2,z,t);
3916   
3917  * EQ9_4(ene3,j2,z,t)..  DE(ene3,j2,z,t) =e= Share_nElec(ene3,j2,z)*DEnelec(j2,z,t);
3918   
3919  * EQ9_5(ene2,j2,z,t)..  DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
3920   
3921  *=============================Level 1, 2=======================================
3922  * EQ9_2(j2,z,t)..       CE(j2,z,t)  =e= B_ENER2(j2,z)*{[(beta_ENER2(j2,z))*DEelec(j2,z,t)**(-rho_ENER2(j2,z))]
3923  *                                                     +[(1-beta_ENER2(j2,z))*DEnelec(j2,z,t)**(-rho_ENER2(j2,z))]
3924  *                                                   }**(-1/rho_ENER2(j2,z));
3925   
3926  * EQ9_3(j2,z,t)..       DEelec(j2,z,t) =e= {[(beta_ENER2(j2,z))/(1-beta_ENER2(j2,z))]
3927  *                                        *[PCEnelec(j2,z,t)/PCEelec(j2,z,t)]}**sigma_ENER2(j2,z)*DEnelec(j2,z,t);
3928   
3929  * EQ9_4(ene3,j2,z,t)..  DE(ene3,j2,z,t) =e= [beta_ENER3(ene3,j2,z)*PCEnelec(j2,z,t)/P4(ene3,j2,z,t)]
3930  *                                            **sigma_ENER3(j2,z)*B_ENER3(j2,z)**(sigma_ENER3(j2,z)-1)
3931  *                                            *DEnelec(j2,z,t);
3932   
3933  * EQ9_5(ene2,j2,z,t)..  DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
3934   
3935  *=============================Level 1, 2, 3 (Leonteif) =======================================
3936  * EQ9_2(j2,z,t)..        DEelec(j2,z,t)  =e= Share_Elec(j2,z)*CE(j2,z,t);
3937   
3938  * EQ9_3(j2,z,t)..        DEnelec(j2,z,t) =e= (1-Share_Elec(j2,z))*CE(j2,z,t);
3939   
3940  * EQ9_4(j2,z,t)..        DEcoalgas(j2,z,t) =e= Share_coalgas2(j2,z)*DEnelec(j2,z,t);
3941   
3942  * EQ9_5(j2,z,t)..        DEoilpetrol(j2,z,t) =e= (1-Share_coalgas2(j2,z))*DEnelec(j2,z,t);
3943   
3944  * EQ9_6(ene2,j2,z,t)..   DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
3945   
3946  * EQ9_7(ene5,j2,z,t)..   DE(ene5,j2,z,t) =e= Share_coalgas(ene5,j2,z)*DEcoalgas(j2,z,t);
3947   
3948  * EQ9_8(ene6,j2,z,t)..   DE(ene6,j2,z,t) =e= Share_oilpetrol(ene6,j2,z)*DEoilpetrol(j2,z,t);
3949   
3950  *=============================Level 1, 2, 3 (CES) =======================================
3951   EQ9_2(j2,z,t)..        CE(j2,z,t)  =e= B_ENER2(j2,z)*{[(beta_ENER2(j2,z))*DEelec(j2,z,t)**(-rho_ENER2(j2,z))]
3952                                             +[(1-beta_ENER2(j2,z))*DEnelec(j2,z,t)**(-rho_ENER2(j2,z))]
3953                                              }**(-1/rho_ENER2(j2,z));
3954   
3955   EQ9_3(j2,z,t)..        DEnelec(j2,z,t) =e= {[(1-beta_ENER2(j2,z))/(beta_ENER2(j2,z))]
3956                                          *[PCEelec(j2,z,t)/PCEnelec(j2,z,t)]}**sigma_ENER2(j2,z)*DEelec(j2,z,t);
3957   
3958   EQ9_4(j2,z,t)..        DEnelec(j2,z,t) =e= B_ENER4(j2,z)*{[(beta_ENER4(j2,z))*DEcoalgas(j2,z,t)**(-rho_ENER4(j2,z))]
3959                                             +[(1-beta_ENER4(j2,z))*DEoilpetrol(j2,z,t)**(-rho_ENER4(j2,z))]
3960                                              }**(-1/rho_ENER4(j2,z));
3961   
3962   EQ9_5(j2,z,t)..        DEoilpetrol(j2,z,t) =e= {[(1-beta_ENER4(j2,z))/(beta_ENER4(j2,z))]
3963                                         *[PCEcoalgas(j2,z,t)/PCEoilpetrol(j2,z,t)]}**sigma_ENER4(j2,z)*DEcoalgas(j2,z,t);
3964   
3965   EQ9_6(ene2,j2,z,t)..   DE(ene2,j2,z,t) =e= DEelec(j2,z,t) ;
3966   
3967   EQ9_7(ene5,j2,z,t)..   DE(ene5,j2,z,t) =e= [beta_ENER5_1(ene5,j2,z)*PCEcoalgas(j2,z,t)/(P4(ene5,j2,z,t)+P4(ene5,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene5,j2,z,t))]
3968                                              **sigma_ENER5_1(j2,z)*B_ENER5_1(j2,z)**(sigma_ENER5_1(j2,z)-1)
3969                                              *DEcoalgas(j2,z,t);
3970   
3971   EQ9_8(ene6,j2,z,t)..   DE(ene6,j2,z,t) =e= [beta_ENER5_2(ene6,j2,z)*PCEoilpetrol(j2,z,t)/(P4(ene6,j2,z,t)+P4(ene6,j2,z,t)*CTAX(z,t)*CO2FACTOR2(ene6,j2,z,t))]
3972                                              **sigma_ENER5_2(j2,z)*B_ENER5_2(j2,z)**(sigma_ENER5_2(j2,z)-1)
3973                                              *DEoilpetrol(j2,z,t);
3974   
3975  *==============================================================================
3976  *   5.3.2 Income and savings
3977  *==============================================================================
3978  *    5.3.2.1 Households
3979  *==============================================================================
3980   EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t)+SUM(i3,MARKUP(i3,z,t));
3981  * EQ10(z,t)..       YH(z,t) =e= YHL(z,t)+YHK(z,t)+SUM(i3,MARKUP(i3,z,t))+TCTAX(z,t);
3982   
3983   EQ11(z,t)..       YHL(z,t) =e= SUM[(j)$LDO(j,z),W(z,t)*LD(j,z,t)];
3984   
3985   EQ12(z,t)..       YHK(z,t) =e= SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*KD(k,j,z,t)];
3986   
3987   EQ13(z,t)..       YDH(z,t) =e= YH(z,t)-TDH(z,t);
3988   
3989   EQ14(z,t)..       CTH(z,t) =e= YDH(z,t)-SH(z,t);
3990   
3991   EQ15(z,t)..       SH(z,t) =e= PIXCON(z,t)**eta*sh0(z,t)+sh1(z,t)*YDH(z,t);
3992   
3993  *==============================================================================
3994  *    5.3.2.2 Government
3995  *==============================================================================
3996  * EQ16(z,t)..       YG(z,t) =e= TDH(z,t)+TPRODN(z,t)+TPRCTS(z,t)+TCTAX(z,t);
3997   EQ16(z,t)..       YG(z,t) =e= TDH(z,t)+TPRODN(z,t)+TPRCTS(z,t);
3998   
3999   EQ16_1(z,t)..     TCTAX(z,t) =e= sum((ene,j), PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t));
4000   
4001   EQ17(z,t)..       TPRODN(z,t) =e= TIWT(z,t)+TIKT(z,t)+TIPT(z,t);
4002   
4003   EQ18(z,t)..       TIWT(z,t) =e= SUM[(j)$LDO(j,z),TIW(j,z,t)];
4004   
4005   EQ19(z,t)..       TIKT(z,t) =e= SUM[(k,j)$KDO(k,j,z),TIK(k,j,z,t)];
4006   
4007   EQ20(z,t)..       TIPT(z,t) =e= SUM[j,TIP(j,z,t)];
4008   
4009   EQ21(z,t)..       TPRCTS(z,t) =e= TICT(z,t)+TIMT(z,t)+TIXT(z,t);
4010   
4011   EQ22(z,t)..       TICT(z,t) =e= SUM[i,TIC(i,z,t)];
4012   
4013   EQ23(z,t)..       TIMT(z,t) =e= SUM[(i,zj)$IMO(i,zj,z),TIM(i,zj,z,t)];
4014   
4015   EQ24(z,t)..       TIXT(z,t) =e= SUM[(i,zj)$EXO(i,z,zj),TIX(i,z,zj,t)];
4016   
4017   EQ25(z,t)..       TDH(z,t) =e= PIXCON(z,t)**eta*ttdh0(z,t)+ttdh1(z,t)*YH(z,t);
4018   
4019   EQ26(j,z,t)$LDO(j,z)..
4020                   TIW(j,z,t) =e= ttiw(j,z,t)*W(z,t)*LD(j,z,t);
4021   
4022   EQ27(k,j,z,t)$KDO(k,j,z)..
4023                   TIK(k,j,z,t) =e= ttik(k,j,z,t)*R(k,j,z,t)*KD(k,j,z,t);
4024   
4025   EQ28(j,z,t)..     TIP(j,z,t) =e= ttip(j,z,t)*PP(j,z,t)*XST(j,z,t);
4026   
4027   EQ29(i,z,t)..     TIC(i,z,t) =e= ttic(i,z,t)*{[PL(i,z,t)*DD(i,z,t)]$DDO(i,z)
4028                   +[SUM[zj$IMO(i,zj,z),(1+ttim(i,zj,z,t))*IM(i,zj,z,t)*e(z,t)
4029                    *(PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z)))]]};
4030   
4031   EQ30(i,zj,z,t)$IMO(i,zj,z)..
4032                   TIM(i,zj,z,t) =e= ttim(i,zj,z,t)*IM(i,zj,z,t)*e(z,t)*
4033                                     (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
4034                                     *tmrg(ij,i,zj,z)]);
4035   
4036   EQ31(i,z,zj,t)$EXO(i,z,zj)..
4037                   TIX(i,z,zj,t) =e= ttix(i,z,zj,t)*PE(i,z,zj,t)*EX(i,z,zj,t);
4038   
4039   EQ32(z,t)..       SG(z,t) =e= YG(z,t)-G(z,t);
4040   
4041  *==============================================================================
4042  *    5.3.2.4 Rest of the world
4043  *==============================================================================
4044   EQ33(z,t)..       YROW(z,t) =e= e(z,t)*SUM{(i,zj)$IMO(i,zj,z),IM(i,zj,z,t)*
4045                             [PWM(i,zj,z,t)+SUM(ij,PWMG(ij,t)*tmrg(ij,i,zj,z))]};
4046   
4047   EQ34(z,t)..       SROW(z,t) =e= YROW(z,t)-e(z,t)*SUM[(i,zj)$EXO(i,z,zj),
4048                                 EX(i,z,zj,t)*PWX(i,z,zj,t)]-e(z,t)
4049                                 *SUM[i$MRGNO(i,z),MRGN(i,z,t)*PWMG(i,t)];
4050   
4051   EQ35(z,t)..       SROW(z,t) =e= -CAB(z,t);
4052   
4053  *==============================================================================
4054  *   5.3.3 Demand
4055  *==============================================================================
4056   EQ36(i,z,t)..     PC(i,z,t)*C(i,z,t) =e= PC(i,z,t)*CMIN(i,z,t)+gamma_LES(i,z)
4057                                   *{CTH(z,t)-SUM[ij,PC(ij,z,t)*CMIN(ij,z,t)]};
4058   
4059   EQ37(i,z,t)..     PC(i,z,t)*INV(i,z,t) =e= gamma_INV(i,z)*IT(z,t);
4060   
4061   EQ38(i,z,t)..     PC(i,z,t)*CG(i,z,t) =e= gamma_GVT(i,z)*G(z,t);
4062   
4063   EQ39(nene,z,t)..    DIT(nene,z,t) =e= SUM[j,DI(nene,j,z,t)];
4064   
4065   EQ39_1(ene1,z,t)..  DIT(ene1,z,t) =e= SUM[j,DE(ene1,j,z,t)];
4066   
4067   EQ39_2(ene2,z,t)..  DIT(ene2,z,t) =e= SUM[j,DE(ene2,j,z,t)];
4068   
4069  *==============================================================================
4070  *   5.3.4 International trade
4071  *==============================================================================
       EQB_1(i,z)..    XS_I(i,z) =e= B_X3(i,z)*SUM[j$XSO(j,i,z),beta_X3(j,i,z)
                                      *XS(j,i,z)**(-rho_X3(i,z))]**(-1/rho_X3(i,z));
       
       EQB_2(j,i,z)${DSO(j,i,z) and [DSO(j,i,z) ne DSO_I(i,z)]}..
                       XS(j,i,z) =e= XS_I(i,z)/B_X3(i,z)**(1-sigma_X3(i,z))*
                                     [beta_X3(j,i,z)*PI(i,z)/P2(j,i,z)]
                                     **sigma_X3(i,z);
       
       EQB_3(j,i,z)${DSO(j,i,z)}..   P2(j,i,z) =e= PT(j,z);
       
       EQB_4(j,i,z)$DSO(j,i,z)..
                       P2(j,i,z)*XS(j,i,z) =e= [PET(i,z)*EXTT(j,i,z)]$EXTTO(j,i,z)
                                              +[e(z)*MRGN(i,z)*PWMG(i)]$MRGNO(i,z)
                                              +[PL(i,z)*DS(j,i,z)]$DSO(j,i,z);
       
       EQB_5(j,i,z)$DSO(j,i,z)..  EXTT(j,i,z)  =e= theta2(j,i,z)*EXT(i,z);
4090   
4091  *[Top Nest - Leontief function]
4092   EQA_1(z,t)..  XS('18_TnD','18_ELEC',z,t) =e= TnDShare(z)*XS_I('18_ELEC',z,t);
4093   EQA_2(z,t)..  XS_I('18_ELEC',z,t) =e= XS('18_TnD','18_ELEC',z,t) + POWERQ(z,t);
4094   
4095   
4096  *[Second Nest - CES function]
4097  * EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
4098  *                                *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
4099   EQA_3(z,t)..    POWERQ(z,t) =e= B_X4(z)*SUM[POWER, beta_X4(power,z)
4100                                  *XS(POWER,'18_ELEC',z,t)**(-rho_X4(z))]**(-1/rho_X4(z));
4101   
4102  * EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
4103  *                               [beta_X4(power,z)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
4104  *                               **sigma_X4(z);
4105   
4106   EQA_4(power,'18_ELEC',z,t)..  XS(POWER,'18_ELEC',z,t) =e= POWERQ(z,t)/B_X4(z)**(1-sigma_X4(z))*
4107                                 [beta_X4(power,z)*PPOWER(z,t)/P2(POWER,'18_ELEC',z,t)]
4108                                 **sigma_X4(z);
4109   
4110  * exclude electiricity
4111   EQB_1(i2,z,t)..    XS_I(i2,z,t) =e= B_X3(i2,z)*SUM[j$XSO(j,i2,z),beta_X3(j,i2,z)
4112                                  *XS(j,i2,z,t)**(-rho_X3(i2,z))]**(-1/rho_X3(i2,z));
4113   
4114   
4115   EQB_3(j,i,z,t)${DSO(j,i,z)}..   P2(j,i,z,t) =e= PT(j,z,t);
4116   
4117   EQB_4(j,i,z,t)$DSO(j,i,z)..
4118                   P2(j,i,z,t)*XS(j,i,z,t) =e= [PET(i,z,t)*EXTT(j,i,z,t)]$EXTTO(j,i,z)
4119                                          +[e(z,t)*MRGN(i,z,t)*PWMG(i,t)]$MRGNO(i,z)
4120                                          +[PL(i,z,t)*DS(j,i,z,t)]$DSO(j,i,z);
4121   
4122   EQB_5(j,i,z,t)$DSO(j,i,z)..  EXTT(j,i,z,t)  =e= theta2(j,i,z)*EXT(i,z,t);
4123   
4124   EQ40_3(i,z,t)..   DS_I(i,z,t) =e= sum(j,DS(j,i,z,t)$DSO(j,i,z));
4125   
4126   EQ40_4(j,z,t)..   XST(j,z,t)  =e= sum(i,XS(j,i,z,t)$XSO(j,i,z));
4127   
4128   EQ40_5(i,z,t)..   XS_I(i,z,t) =e= B_X1(i,z)*{
4129                   [beta_EX_X1(i,z)*EXT(i,z,t)**rho_X1(i,z)]$EXTO(i,z)
4130                  +[beta_D_X1(i,z)*DS_I(i,z,t)**rho_X1(i,z)]$DSO_I(i,z)
4131                  +[(1-beta_EX_X1(i,z)-beta_D_X1(i,z))*MRGN(i,z,t)**rho_X1(i,z)]$MRGNO(i,z)
4132                                            }**(1/rho_X1(i,z));
4133   
4134   EQ41(i,z,t)$[EXTO(i,z) and DSO_I(i,z)]..
4135                   EXT(i,z,t) =e= {[beta_D_X1(i,z)/beta_EX_X1(i,z)]*[PET(i,z,t)/PL(i,z,t)]}
4136                                **sigma_X1(i,z)*DS_I(i,z,t);
4137   
4138   EQ42(i,z,t)$[MRGNO(i,z) and DSO_I(i,z)]..
4139                   MRGN(i,z,t) =e= {[beta_D_X1(i,z)/(1-beta_EX_X1(i,z)
4140                                   -beta_D_X1(i,z))]*[e(z,t)*PWMG(i,t)/PL(i,z,t)]}
4141                                   **sigma_X1(i,z)*DS_I(i,z,t);
4142   
4143   EQ43(i,z,t)$EXTO(i,z)..
4144                   EXT(i,z,t) =e= B_X2(i,z)*SUM[zj$EXO(i,z,zj),beta_X2(i,z,zj)
4145                                  *EX(i,z,zj,t)**rho_X2(i,z)]**(1/rho_X2(i,z));
4146   
4147   EQ44(i,z,zj,t)$EXO(i,z,zj)..
4148                   EX(i,z,zj,t) =e= EXT(i,z,t)/B_X2(i,z)**(1+sigma_X2(i,z))*
4149                                    [PE(i,z,zj,t)/(beta_X2(i,z,zj)*PET(i,z,t))]
4150                                    **sigma_X2(i,z);
4151   
4152   EQ45(i,z,t)..     Q(i,z,t) =e= B_M1(i,z)*{
4153                      [beta_M1(i,z)*IMT(i,z,t)**(-rho_M1(i,z))]$IMTO(i,z)
4154                     +[(1-beta_M1(i,z))*DD(i,z,t)**(-rho_M1(i,z))]$DDO(i,z)
4155                                          }**(-1/rho_M1(i,z));
4156   
4157   EQ46(i,z,t)$[IMTO(i,z) and DDO(i,z)]..
4158                   IMT(i,z,t) =e= {[beta_M1(i,z)/(1-beta_M1(i,z))]*[PD(i,z,t)
4159                                  /PMT(i,z,t)]}**sigma_m1(i,z)*DD(i,z,t);
4160   
4161   EQ47(i,z,t)$IMTO(i,z)..
4162                   IMT(i,z,t) =e= B_M2(i,z)*SUM[zj$IMO(i,zj,z),beta_M2(i,zj,z)*
4163                                  IM(i,zj,z,t)**(-rho_M2(i,z))]**(-1/rho_M2(i,z));
4164   
4165   EQ48(i,zj,z,t)$IMO(i,zj,z)..
4166                   IM(i,zj,z,t) =e= IMT(i,z,t)/B_M2(i,z)**(1-sigma_M2(i,z))*
4167                                    [beta_M2(i,zj,z)*PMT(i,z,t)/PM(i,zj,z,t)]
4168                                    **sigma_M2(i,z);
4169   
4170  *==============================================================================
4171  *   5.3.5 Prices
4172  *==============================================================================
4173   EQ49(j2,z,t)..     PP(j2,z,t)*XST(j2,z,t) =e= PKLE(j2,z,t)*KLE(j2,z,t)+PCI(j2,z,t)*CI(j2,z,t);
4174   
4175   EQ49_1(j3,z,t)..   PP(j3,z,t)*XST(j3,z,t) =e= PVA(j3,z,t)*VA(j3,z,t)+PCI(j3,z,t)*CI(j3,z,t)+PCE(j3,z,t)*CE(j3,z,t);
4176   
4177   EQ50(j,z,t)..      PT(j,z,t) =e= (1+ttip(j,z,t))*PP(j,z,t);
4178   
4179   EQ51(j,z,t)..      PCI(j,z,t)*CI(j,z,t) =e= SUM[nene,PC(nene,z,t)*DI(nene,j,z,t)];
4180   
4181  *Simple Nesting
4182  * EQ51_1(j,z,t)..    PCE(j,z,t)*CE(j,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j,z,t) + PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t)];
4183   
4184  *============================== Level 1-3 ========================================
4185  * EQ51_1(j2,z,t)..   PCE(j2,z,t)*CE(j2,z,t) =e= [PCEelec(j2,z,t)*DEelec(j2,z,t)+PCEnelec(j2,z,t)*DEnelec(j2,z,t)];
4186   
4187  * EQ51_12(j3,z,t)..  PCE(j3,z,t)*CE(j3,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j3,z,t)+PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j3,z,t)*DE(ene,j3,z,t)];
4188   
4189  * EQ51_2(j2,z,t)..   PCEelec(j2,z,t)*DEelec(j2,z,t) =e= PC("18_ELEC",z,t)*DE("18_ELEC",j2,z,t);
4190   
4191  * EQ51_3(j2,z,t)..   PCEnelec(j2,z,t)*DEnelec(j2,z,t) =e= SUM[ene3,PC(ene3,z,t)*DE(ene3,j2,z,t)+PC(ene3,z,t)*CTAX(z,t)*CO2FACTOR2(ene3,j2,z,t)*DE(ene3,j2,z,t)];
4192  *================================= Level 1-5 ======================================
4193   EQ51_2(j3,z,t)..   PCE(j3,z,t)*CE(j3,z,t) =e= SUM[ene,PC(ene,z,t)*DE(ene,j3,z,t)+PC(ene,z,t)*CTAX(z,t)*CO2FACTOR2(ene,j3,z,t)*DE(ene,j3,z,t)];
4194   
4195   EQ51_1(j2,z,t)..   PCE(j2,z,t)*CE(j2,z,t) =e= [PCEelec(j2,z,t)*DEelec(j2,z,t)+PCEnelec(j2,z,t)*DEnelec(j2,z,t)];
4196   
4197   EQ51_3(j2,z,t)..   PCEelec(j2,z,t)*DEelec(j2,z,t) =e= PC("18_ELEC",z,t)*DE("18_ELEC",j2,z,t);
4198   
4199   EQ51_4(j2,z,t)..   PCEnelec(j2,z,t)*DEnelec(j2,z,t) =e= [PCEcoalgas(j2,z,t)*DEcoalgas(j2,z,t)+PCEoilpetrol(j2,z,t)*DEoilpetrol(j2,z,t)];
4200   
4201   EQ51_5(j2,z,t)..   PCEcoalgas(j2,z,t)*DEcoalgas(j2,z,t) =e= [PC("02_COAL",z,t)*DE("02_COAL",j2,z,t)+PC("02_COAL",z,t)*CTAX(z,t)*CO2FACTOR2("02_COAL",j2,z,t)*DE("02_COAL",j2,z,t)
4202                      +PC("04_GAS",z,t)*DE("04_GAS",j2,z,t)+PC("04_GAS",z,t)*CTAX(z,t)*CO2FACTOR2("04_GAS",j2,z,t)*DE("04_GAS",j2,z,t)];
4203   
4204   EQ51_6(j2,z,t)..   PCEoilpetrol(j2,z,t)*DEoilpetrol(j2,z,t) =e= [PC("03_OIL",z,t)*DE("03_OIL",j2,z,t)+PC("03_OIL",z,t)*CTAX(z,t)*CO2FACTOR2("03_OIL",j2,z,t)*DE("03_OIL",j2,z,t)
4205                      +PC("10_PETROLCOAL",z,t)*DE("10_PETROLCOAL",j2,z,t)+PC("10_PETROLCOAL",z,t)*CTAX(z,t)*CO2FACTOR2("10_PETROLCOAL",j2,z,t)*DE("10_PETROLCOAL",j2,z,t)];
4206  *==================================================================================
4207   
4208   EQ52(j,z,t)..      PVA(j,z,t)*VA(j,z,t) =e= [WC(j,z,t)*LDC(j,z,t)]$LDCO(j,z)
4209                                       +[RC(j,z,t)*KDC(j,z,t)]$KDCO(j,z);
4210   
4211   EQ52_1(j2,z,t)..   PKLE(j2,z,t)*KLE(j2,z,t) =e= [PVA(j2,z,t)*VA(j2,z,t)]$VAO(j2,z)
4212                                         +[PCE(j2,z,t)*CE(j2,z,t)]$CEO(j2,z);
4213   
4214  * Given equations 5 and 6, equation 53 is redundant
4215  * EQ53(j,z)..     WC(j,z)*LDC(j,z) =e= SUM[l$LDO(l,j,z),WTI(l,j,z)*LD(l,j,z)];
4216   EQ53(j,z,t)..     WC(j,z,t)*LDC(j,z,t) =e= WTI(j,z,t)*LD(j,z,t);
4217   
4218   EQ54(j,z,t)$LDO(j,z)..
4219                   WTI(j,z,t) =e= W(z,t)*(1+ttiw(j,z,t));
4220   
4221   EQ54_1(ene,j2,z,t)$DEO(ene,j2,z)..
4222                   P4(ene,j2,z,t) =e= PC(ene,z,t);
4223   
4224  * Given equations 7 and 8, equation 55 is redundant
4225  * EQ55(j,z)$(kmob and KDCO(j,z))..
4226  *                 RC(j,z)*KDC(j,z) =e= SUM[k$KDO(k,j,z),RTI(k,j,z)*KD(k,j,z)];
4227   
4228   EQ56(k,j,z,t)$KDO(k,j,z)..
4229                   RTI(k,j,z,t) =e= R(k,j,z,t)*(1+ttik(k,j,z,t));
4230   
4231  * EQ57(k,j,z,t)$(kmob and KDO(k,j,z))..
4232  *                 R(k,j,z,t) =e= RK(k,z,t);
4233   
4234   EQ58(i,z,t)..     P(i,z,t)*XS_I(i,z,t) =e= [PL(i,z,t)*DS_I(i,z,t)]$DSO_I(i,z)
4235                                       +[PET(i,z,t)*EXT(i,z,t)]$EXTO(i,z)
4236                                       +[e(z,t)*PWMG(i,t)*MRGN(i,z,t)]$MRGNO(i,z);
4237   
4238  * Given equations 43 and 44, equation 59 is redundant
4239  * EQ59(i,z)$EXTO(i,z)..
4240  *                 PET(i,z)*EXT(i,z) =e= SUM[zj$EXO(i,z,zj),
4241  *                                           PE(i,z,zj)*EX(i,z,zj);
4242   
4243   EQ60(i,z,zj,t)$EXO(i,z,zj)..
4244                   PE(i,z,zj,t)*(1+ttix(i,z,zj,t)) =e= e(z,t)*PWX(i,z,zj,t);
4245   
4246   EQ61(i,z,t)$DDO(i,z)..
4247                   PD(i,z,t) =e= (1+ttic(i,z,t))*PL(i,z,t);
4248   
4249   EQ62(i,zj,z,t)$IMO(i,zj,z)..
4250                   PM(i,zj,z,t) =e= (1+ttic(i,z,t))*(1+ttim(i,zj,z,t))*e(z,t)*
4251                                    (PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)
4252                                    *tmrg(ij,i,zj,z)]);
4253   
4254  * Given equations 47 and 48, equation 63 is redundant
4255  * EQ63(i,z)$IMTO(i,z)..
4256  *                 PMT(i,z)*IMT(i,z) =e= SUM[zj$IMO(i,zj,z),
4257  *                                           PM(i,zj,z)*IM(i,zj,z);
4258   
4259   EQ64(i,z,t)..     PC(i,z,t)*Q(i,z,t) =e= [PD(i,z,t)*DD(i,z,t)]$DDO(i,z)+
4260                                      [PMT(i,z,t)*IMT(i,z,t)]$IMTO(i,z);
4261   
4262  * EQ65(z,t)..       PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
4263  *                               /gamma_INV(i,z))**gamma_INV(i,z)];
4264   
4265   EQ66(z,t)..       PIXGDP(z,t) =e=
4266                   {SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)]
4267                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
4268                   *SUM[j,{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)]
4269                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)]}**0.5;
4270   
4271   EQ67(t)..         PIXGDP_W(t) =e=
4272                   {SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VAO(j,z)/e(z,t)]
4273                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
4274                   *SUM[(j,z),{(PVA(j,z,t)*VA(j,z,t)+TIP(j,z,t))/VA(j,z,t)}*VA(j,z,t)/e(z,t)]
4275                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VA(j,z,t)/eO(z)]}**0.5;
4276   
4277   EQ68(z,t)..       PIXCON(z,t) =e= SUM[i,PC(i,z,t)*CO(i,z)]/SUM[i,PCO(i,z)*CO(i,z)];
4278   
4279   EQ69(z,t)..       PIXINV(z,t) =e= PROD[i$gamma_INV(i,z),(PC(i,z,t)/PCO(i,z))
4280                                   **gamma_INV(i,z)];
4281   
4282   EQ70(z,t)..       PIXGVT(z,t) =e= PROD[i$gamma_GVT(i,z),(PC(i,z,t)/PCO(i,z))
4283                                   **gamma_GVT(i,z)];
4284   
4285  *==============================================================================
4286  *   5.3.6 Equilibrium
4287  *==============================================================================
4288   EQ71(i1,z,t)..    Q(i1,z,t) =e= C(i1,z,t)+CG(i1,z,t)+INV(i1,z,t)+DIT(i1,z,t);
4289   
4290   EQ71_2(i3,z,t)..  Q(i3,z,t) =e= C_Conventional(i3,z,t);
4291   
4292   EQ72(z,t)..     LS(z,t) =e= SUM[j$LDO(j,z),LD(j,z,t)];
4293   
4294   EQ73(k,z,t)$KSO(k,z)..
4295                         KS(k,z,t) =e= SUM[j$KDO(k,j,z),KD(k,j,z,t)];
4296   
4297   EQ74(z,t)..       IT(z,t) =e= SH(z,t)+SG(z,t)-CAB(z,t);
4298   
4299   EQ75(z,t)..       DEP(z,t) =e= PK(z,t)*delta(z)*SUM[k$KSO(k,z),KS(k,z,t)];
4300   
4301   EQ76(i,z,t)$DDO(i,z)..
4302                     SUM[j$DSO(j,i,z),DS(j,i,z,t)] =e= DD(i,z,t);
4303   
4304   EQ77(i,z,zj,t)$EXO(i,z,zj)..
4305                     EX(i,z,zj,t) =e= IM(i,z,zj,t);
4306   
4307   EQ78(i,z,zj,t)$EXO(i,z,zj)..
4308                     PWX(i,z,zj,t) =e= PWM(i,z,zj,t);
4309   
4310   EQ79(i,t)..       SUM[z$MRGNO(i,z),MRGN(i,z,t)] =e= SUM[(z,zj,ij)$IMO(ij,zj,z),
4311                                                   tmrg(i,ij,zj,z)*IM(ij,zj,z,t)];
4312   
4313  * Given equations 33, 34 and 77, equation 80 is redundant
4314  * EQ80..          SUM[z,SROW(z)/e(z)] =e= 0;
4315   
4316  *==============================================================================
4317  *   5.3.7 Gross domestic product
4318  *==============================================================================
4319   EQ81(z,t)..       GDP_BP(z,t) =e= SUM[j,PVA(j,z,t)*VA(j,z,t)]+TIPT(z,t);
4320   
4321   EQ82(z,t)..       GDP_MP(z,t) =e= GDP_BP(z,t)+TPRCTS(z,t);
4322   
4323   EQ83(z,t)..       GDP_IB(z,t) =e= SUM[(j)$LDO(j,z),W(z,t)*LD(j,z,t)]
4324                                +SUM[(k,j)$KDO(k,j,z),R(k,j,z,t)*KD(k,j,z,t)]
4325                                +TPRCTS(z,t)+TPRODN(z,t);
4326   
4327   EQ84(z,t)..       GDP_FD(z,t) =e=
4328                   SUM[i,PC(i,z,t)*(C(i,z,t)+CG(i,z,t)+INV(i,z,t))]
4329                  +SUM[(i,zj)$EXO(i,z,zj),e(z,t)*PWX(i,z,zj,t)*EX(i,z,zj,t)]
4330                  +SUM[i$MRGNO(i,z),e(z,t)*PWMG(i,t)*MRGN(i,z,t)]
4331                  -SUM[(i,zj)$IMO(i,zj,z),e(z,t)*IM(i,zj,z,t)
4332                      *(PWM(i,zj,z,t)+SUM[ij,PWMG(ij,t)*tmrg(ij,i,zj,z)])]
4333                  -TCTAX(z,t) ;
4334   
4335   EQ85(t)..          GDP_BP_W(t) =e= SUM[z,GDP_BP(z,t)/e(z,t)];
4336   
4337  *==============================================================================
4338  *  5.3.8 Real (volume) variables computed from price indices
4339  *==============================================================================
4340   EQ86(z,t)..       CTH_REAL(z,t) =e= CTH(z,t)/PIXCON(z,t);
4341   
4342   EQ87(z,t)..       G_REAL(z,t) =e= G(z,t)/PIXGVT(z,t);
4343   
4344   EQ88(z,t)..       GDP_BP_REAL(z,t) =e= GDP_BP(z,t)/PIXGDP(z,t);
4345   
4346   EQ89(t)..         GDP_BP_W_REAL(t) =e= GDP_BP_W(t)/PIXGDP_W(t);
4347   
4348   EQ90(z,t)..       GDP_MP_REAL(z,t) =e= GDP_MP(z,t)/PIXCON(z,t);
4349   
4350   EQ91(z,t)..       IT_REAL(z,t) =e= IT(z,t)/PIXINV(z,t);
4351   
4352   EQ92(z,t)..       CABX(z,t) =e= CAB(z,t)/[PIXGDP_W(t)*e(z,t)];
4353   
4354  *==============================================================================
4355  *   5.3.8 Dynamic equations
4356  *==============================================================================
4357   EQ94(z,t)..     IT(z,t) =e= PK(z,t)*SUM[(k,j)$KDO(k,j,z),IND(k,j,z,t)];
4358   
4359   EQ95(z,t)..     PK(z,t) =e= 1/A_K(z)*PROD[i$gamma_INV(i,z),(PC(i,z,t)
4360                                 /gamma_INV(i,z))**gamma_INV(i,z)];
4361   
4362   EQ96(k,bus,z,t)$KDO(k,bus,z)..
4363                   IND(k,bus,z,t) =e= phi(z,t)*[R(k,bus,z,t)/U(z,t)]
4364                                    **sigma_INV(k,bus,z)*KD(k,bus,z,t);
4365   
4366   EQ97a(z,t)..    IR(z,t) =e= {SUM[(k,j)$KDO(k,j,z),
4367                                R(k,j,z,t)*KD(k,j,z,t)]-DEP(z,t)}/
4368                               {PK(z,t)*SUM[(k,j)$KDO(k,j,z),KD(k,j,z,t)]};
4369   
4370   EQ97b(z,t)..    U(z,t) =e= PK(z,t)*(delta(z)+IR(z,t));
4371   
4372  *==============================================================================
4373  *   5.3.9 Other
4374  *==============================================================================
4375   WALRAS(z,t)..   LEON(z,t) =e= Q('01_AGRICULT',z,t)-C('01_AGRICULT',z,t)-CG('01_AGRICULT',z,t)-INV('01_AGRICULT',z,t)
4376                              -DIT('01_AGRICULT',z,t);
4377   
4378  *==============================================================================
4379  *   5.3.10 Backstop technology
4380  *==============================================================================
4381   EQ98(i3,z,t)..    C_Conventional(i3,z,t) =e= (1-penetration_rate(i3,z,t)*switch(i3,z,t))*[C(i3,z,t)+CG(i3,z,t)+INV(i3,z,t)+DIT(i3,z,t)];
4382   
4383   EQ99(i3,z,t)..    XDBS(i3,z,t) =e= penetration_rate(i3,z,t)*switch(i3,z,t)*[C(i3,z,t)+CG(i3,z,t)+INV(i3,z,t)+DIT(i3,z,t)];
4384   
4385   EQ100(j,z,t)..    XDBS2(j,z,t) =e= sum{i3$COMtoIND(j,i3),XDBS(i3,z,t)};
4386   
4387   EQ101(j,z,t)..    LBS(j,z,t) =e= 0.6*XDBS2(j,z,t);
4388   
4389   EQ102(k,j,z,t)..   KBS(k,j,z,t) =e= 0.3*XDBS2(j,z,t)*KDO(k,j,z)/sum(kj,KDO(kj,j,z));
4390   
4391   EQ103(i3,z,t)..   CLBS(i3,z,t)  =e= sum{j$INDtoCOM(i3,j),LBS(j,z,t)*WC(j,z,t)};
4392   
4393   EQ104(i3,z,t)..   CKBS(i3,z,t)  =e= sum{k,sum{j$INDtoCOM(i3,j),KBS(k,j,z,t)*RC(j,z,t)}};
4394   
4395   EQ105(i3,z,t)..   MARKUP(i3,z,t) =e= {PC(i3,z,t)*XDBS(i3,z,t)-CLBS(i3,z,t)-CKBS(i3,z,t)}*switch(i3,z,t) ;
4396   
4397  *================================================================================
4398  * 6 Labour Supply
4399  *================================================================================
4400   EQ106(z,t)..  LS(z,t) =e= LST(z,t) *((W(z,t)/PIXCON(z,t)) / (W_lag(z,t)/PIXCON_lag(z,t)))**elasLS(z);
4401   
4402  *==============================================================================
4403  * 7 PERMET
4404  *==============================================================================
4405   EQ107(j,z,t).. PERMIT(j,z,t) =e= sum(ene, CO2FACTOR2(ene,j,z,t)*DE(ene,j,z,t));
4406   
4407   EQ108(z,t)..  PERMIT_TOTAL(z,t) =E=  sum(j,PERMIT(j,z,t))  ;
4408   
4409  *==============================================================================
4410  *   8 Carbon Tax Revenue Recycling
4411  *==============================================================================
4412   
4413  EQ109(j,z,t)..   TIW_Share(j,z,t) =e= LD(j,z,t)/SUM(jj,LD(jj,z,t));
4414  *EQ109(j,z,t)..   TIW_Share(j,z,t) =e= 0;
4415   
4416  EQ110(j,z,t)..    ttiw(j,z,t) =e= ttiw_lag(j,z,t) + deltatiw(j,z,t);
4417   
4418  EQ111(j,z,t)..   deltatiw(j,z,t) =e= -TIW_Share(j,z,t) * REBATE(z,t) / (W(z,t)*LD(j,z,t));
4419   
4420  EQ112(z,t)..  REBATE(z,t) =e= TCTAX(z,t);
