2593  *
2594   
2595  *f_balstfur(flow)
2596  *f_cokeoven(flow)
2597  * WEB(f_balstfur, 'p4_COKCOAL', z) = WEB(f_cokeoven, 'p66_TOTAL', z) ;
2598  * WEB(f_cokeoven, 'p4_COKCOAL', z) = WEB(f_cokeoven, 'p66_TOTAL', z) ;
2599   
2600   TCoke_Share(f_cokeoven,p_coal,z)$(WEB(f_cokeoven, p_coal, z) lt 0)  = WEB(f_cokeoven, p_coal, z)$(WEB(f_cokeoven, p_coal, z) lt 0)/sum(p_coal2, WEB(f_cokeoven, p_coal2, z)$(WEB(f_cokeoven, p_coal2, z) lt 0)) ;
2601   TBlast_Share(f_balstfur,p_coal,z)$(WEB(f_balstfur, p_coal, z) lt 0) = WEB(f_balstfur, p_coal, z)$(WEB(f_balstfur, p_coal, z) lt 0)/sum(p_coal2, WEB(f_balstfur, p_coal2, z)$(WEB(f_balstfur, p_coal2, z) lt 0)) ;
2602   
2603  display TCoke_Share, TBlast_Share ;
2604   
2605  *Coal
2606   Coal_DIO(p_coal,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_coal, z));
2607   Coal_DIO(p_coal,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_coal, z));
2608   Coal_DIO(p_coal,'03_OIL',z) = -1*sum((f_oil), WEB(f_oil, p_coal, z));
2609   Coal_DIO(p_coal,'04_GAS',z) = -1*sum((f_gas), WEB(f_gas, p_coal, z));
2610   Coal_DIO(p_coal,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_coal, z));
2611   Coal_DIO(p_coal,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_coal, z));
2612   Coal_DIO(p_coal,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_coal, z));
2613   Coal_DIO(p_coal,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_coal, z));
2614   Coal_DIO(p_coal,'09_PAPERPRO',z) = sum((f_paperpro), WEB(f_paperpro, p_coal, z));
2615   Coal_DIO(p_coal5,'10_PETROLCOAL',z) = -1*sum((f_petrolcoal), WEB(f_petrolcoal, p_coal5, z));
2616   Coal_DIO(p_coal,'11_CHEMICAL',z) = sum((f_chemical), WEB(f_chemical, p_coal, z));
2617   Coal_DIO(p_coal,'12_NONMET',z) = sum((f_nonmet), WEB(f_nonmet, p_coal, z));
2618   Coal_DIO(p_coal,'13_IRONSTL',z) = sum((f_ironstl), WEB(f_ironstl, p_coal, z))
2619   + sum(f_cokeoven, -1*TCoke_Share(f_cokeoven,p_coal,z)*WEB(f_cokeoven, 'p66_TOTAL', z))
2620   + sum(f_balstfur, -1*TBlast_Share(f_balstfur,p_coal,z)*WEB(f_balstfur, 'p66_TOTAL', z))
2621   + sum((f_Eblastcoke), -1*WEB(f_Eblastcoke, p_coal, z))
2622  ;
2623   
2624   Coal_DIO(p_coal,'14_NONFERR',z) = sum((f_nonferr), WEB(f_nonferr, p_coal, z));
2625   Coal_DIO(p_coal,'15_MACHINE',z) = sum((f_machine), WEB(f_machine, p_coal, z));
2626   Coal_DIO(p_coal,'16_TRANSEQ',z) = sum((f_transeq), WEB(f_transeq, p_coal, z));
2627   Coal_DIO(p_coal,'17_OTHERIND',z) = sum((f_otherind), WEB(f_otherind, p_coal, z));
2628   Coal_DIO(p_coal,'18_TnD',z) = 0 ;
2629   Coal_DIO(p_coal,'19_eNuclear',z) = 0 ;
2630   Coal_DIO(p_coal,'20_eCoal',z) = -1*sum((f_elec), WEB(f_elec, p_coal, z));
2631   Coal_DIO(p_coal,'19_eNuclear',z) = 0 ;
2632   Coal_DIO(p_coal,'21_eGas',z) = 0 ;
2633   Coal_DIO(p_coal,'22_eOil',z) = 0 ;
2634   Coal_DIO(p_coal,'23_eWind',z) = 0 ;
2635   Coal_DIO(p_coal,'24_eSolar',z) = 0 ;
2636   Coal_DIO(p_coal,'25_eHydro',z) = 0 ;
2637   Coal_DIO(p_coal,'26_eOther',z) = 0 ;
2638   Coal_DIO(p_coal,'27_CONSTRUC',z) = sum((f_construc), WEB(f_construc, p_coal, z));
2639   Coal_DIO(p_coal,'28_LTRP',z) = sum((f_roadrail), WEB(f_roadrail, p_coal, z));
2640   Coal_DIO(p_coal,'29_WTRP',z) = sum((f_domewater), WEB(f_domewater, p_coal, z));
2641   Coal_DIO(p_coal,'30_ATRP',z) = sum((f_domeair), WEB(f_domeair, p_coal, z));
2642   Coal_DIO(p_coal,'31_SER',z) = sum((f_ser), WEB(f_ser, p_coal, z));
2643   Coal_CO(p_coal,z) = sum((f_household), WEB(f_household, p_coal, z));
2644   
2645   Coal_Marine(p_coal,z)   = -1*sum((f_marine_bunker), WEB(f_marine_bunker, p_coal, z));
2646   Coal_Aviation(p_coal,z) = -1*sum((f_aviation_bunker), WEB(f_aviation_bunker, p_coal, z));
2647   
2648  *Ratio
2649  Loop(j,
2650      CoalR_DIO(p_coal,j,z)$(Coal_DIO(p_coal,j,z) gt 0)
2651           = Coal_DIO(p_coal,j,z)/sum(p_coal2, Coal_DIO(p_coal2,j,z));
2652       );
2653   
2654   CoalR_CO(p_coal,z)$(Coal_CO(p_coal,z) gt 0)  = Coal_CO(p_coal,z)/ sum(p_coal2, Coal_CO(p_coal2,z));
2655   
2656  display Coal_DIO, CoalR_DIO, CoalR_CO ;
2657   
2658  *Gas
2659   Gas_DIO(p_gas,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_gas, z));
2660   Gas_DIO(p_gas,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_gas, z));
2661   Gas_DIO(p_gas,'03_OIL',z) = 0;
2662   Gas_DIO(p_gas,'04_GAS',z) = -1*sum((f_gas), WEB(f_gas, p_gas, z));
2663   Gas_DIO(p_gas,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_gas, z));
2664   Gas_DIO(p_gas,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_gas, z));
2665   Gas_DIO(p_gas,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_gas, z));
2666   Gas_DIO(p_gas,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_gas, z));
2667   Gas_DIO(p_gas,'09_PAPERPRO',z) = sum((f_paperpro), WEB(f_paperpro, p_gas, z));
2668   Gas_DIO(p_gas,'10_PETROLCOAL',z) = -1*sum((f_petrolcoal), WEB(f_petrolcoal, p_gas, z));
2669   Gas_DIO(p_gas,'11_CHEMICAL',z) = sum((f_chemical), WEB(f_chemical, p_gas, z));
2670   Gas_DIO(p_gas,'12_NONMET',z) = sum((f_nonmet), WEB(f_nonmet, p_gas, z));
2671   Gas_DIO(p_gas,'13_IRONSTL',z) = sum((f_ironstl), WEB(f_ironstl, p_gas, z));
2672   Gas_DIO(p_gas,'14_NONFERR',z) = sum((f_nonferr), WEB(f_nonferr, p_gas, z));
2673   Gas_DIO(p_gas,'15_MACHINE',z) = sum((f_machine), WEB(f_machine, p_gas, z));
2674   Gas_DIO(p_gas,'16_TRANSEQ',z) = sum((f_transeq), WEB(f_transeq, p_gas, z));
2675   Gas_DIO(p_gas,'17_OTHERIND',z) = sum((f_otherind), WEB(f_otherind, p_gas, z));
2676   Gas_DIO(p_gas,'18_TnD',z) = 0 ;
2677   Gas_DIO(p_gas,'19_eNuclear',z) = 0 ;
2678   Gas_DIO(p_gas,'20_eCoal',z) = 0;
2679   Gas_DIO(p_gas,'19_eNuclear',z) = 0 ;
2680   Gas_DIO(p_gas,'21_eGas',z) = -1*sum((f_elec), WEB(f_elec, p_gas, z)) ;
2681   Gas_DIO(p_gas,'22_eOil',z) = 0 ;
2682   Gas_DIO(p_gas,'23_eWind',z) = 0 ;
2683   Gas_DIO(p_gas,'24_eSolar',z) = 0 ;
2684   Gas_DIO(p_gas,'25_eHydro',z) = 0 ;
2685   Gas_DIO(p_gas,'26_eOther',z) = 0 ;
2686   Gas_DIO(p_gas,'27_CONSTRUC',z) = sum((f_construc), WEB(f_construc, p_gas, z));
2687   Gas_DIO(p_gas,'28_LTRP',z) = sum((f_roadrail), WEB(f_roadrail, p_gas, z));
2688   Gas_DIO(p_gas,'29_WTRP',z) = sum((f_domewater), WEB(f_domewater, p_gas, z));
2689   Gas_DIO(p_gas,'30_ATRP',z) = sum((f_domeair), WEB(f_domeair, p_gas, z));
2690   Gas_DIO(p_gas,'31_SER',z) = sum((f_ser), WEB(f_ser, p_gas, z));
2691   Gas_CO(p_gas,z) = sum((f_household), WEB(f_household, p_gas, z));
2692   
2693   Gas_Marine(p_gas,z)   = -1*sum((f_marine_bunker), WEB(f_marine_bunker, p_gas, z));
2694   Gas_Aviation(p_gas,z) = -1*sum((f_aviation_bunker), WEB(f_aviation_bunker, p_gas, z));
2695   
2696  *Ratio
2697  Loop(j,
2698      GasR_DIO(p_gas,j,z)$(Gas_DIO(p_gas,j,z) gt 0)
2699           = Gas_DIO(p_gas,j,z)/sum(p_gas2, Gas_DIO(p_gas2,j,z));
2700       );
2701   
2702   GasR_CO(p_gas,z)$(Gas_CO(p_gas,z) gt 0)  = Gas_CO(p_gas,z)/ sum(p_gas2, Gas_CO(p_gas2,z));
2703   
2704   
2705  display Gas_DIO, GasR_DIO, GasR_CO ;
2706   
2707  *Oil
2708   Oil_DIO(p_oil,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_oil, z));
2709   Oil_DIO(p_oil,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_oil, z));
2710   Oil_DIO(p_oil,'03_OIL',z) = -1*sum((f_oil), WEB(f_oil, p_oil, z));
2711   Oil_DIO(p_oil,'04_GAS',z) = 0;
2712   Oil_DIO(p_oil,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_oil, z));
2713   Oil_DIO(p_oil,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_oil, z));
2714   Oil_DIO(p_oil,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_oil, z));
2715   Oil_DIO(p_oil,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_oil, z));
