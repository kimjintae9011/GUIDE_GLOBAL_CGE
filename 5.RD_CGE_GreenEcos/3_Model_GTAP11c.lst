3433  *==============================================================================
3434  *  Backstop technology
3435  *==============================================================================
3436   switch(i3,z,time)  = 0 ;
3437   penetration_rate(i3,z,time) = 0.01 ;
3438   
3439  Parameters
3440   CTAX0(z)           Initial Carbon tax $ per ton CO2
3441   TCTAX0(z)          Initial Government Revenue from Carbon tax
3442   PERMITO(j,z)       CO2 emissions
3443   PERMIT_TOTALO(z)   Total CO2 emissions (billion ton)
3444  ;
3445   
3446   CTAX0(z)          = 0;
3447   TCTAX0(z)         = 0;
3448   PERMITO(j,z)      = sum(ene, CO2FACTOR(ene,j,z)*DEO(ene,j,z)) ;
3449   PERMIT_TOTALO(z)  = sum(j,PERMITO(j,z));
3450   
3451  *==============================================================================
3452  *   Marginal abatement curves for emissions
3453  *==============================================================================
3454  Parameters
3455   alpha_CO2(ene,j,z)   Emissions responsiveness parameter – higher values imply stronger reduction in emissions intensity in response to carbon price
3456   gamma_CO2(ene,j,z)   Adjustment speed parameter – governs how rapidly emissions intensity responds to changes in carbon price
3457   MINCO2FACTOR(ene,j,z) minimum CO2 emission factor
3458   CTAX_CO2(ene,j,z,time)
3459   CO2FACTOR2_Star(ene,j,z,time)
3460   AbateCostO(j,z)
3461   AbateCost(j,z,time)
3462   theta_CO2(j,z)
3463   delta_CO2(j,z)
3464  ;
3465   
3466   alpha_CO2(ene,j,z)     = 0.15 ;
3467   gamma_CO2(ene,j,z)     = 1.5 ;
3468   MINCO2FACTOR(ene,j,z)  = CO2FACTOR(ene,j,z)*0.1 ;
3469   AbateCostO(j,z)        = 0 ;
3470   theta_CO2(j,z)         = 0.2;
3471   delta_CO2(j,z)         = 1;
3472   
3473  *==============================================================================
3474  *   Carbon tax recycling
3475  *==============================================================================
3476   TIWO_Share(j,z)    =   LDO(j,z)/LSO(z);
3477  * TIWO_Share(j,z)    =   PERMITO(j,z)/ PERMIT_TOTALO(z);
3478   TIKO_Share(k,j,z)   =  KDO(k,j,z)/KSO(k,z);
3479   TIPO_Share(j,z)     =  XSTO(j,z)/sum(jj,XSTO(jj,z));
