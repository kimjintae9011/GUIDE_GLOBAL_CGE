 802   sigma_VA('22_eOil',z)        = 0.2;
 803   sigma_VA('23_eWind',z)       = 0.2;
 804   sigma_VA('24_eSolar',z)      = 0.2;
 805   sigma_VA('25_eHydro',z)      = 0.2;
 806   sigma_VA('26_eOther',z)      = 0.2;
 807   
 808  * CES - composite ENER
 809   sigma_ENER(j,z)              = 1.1 ;
 810   sigma_ENER2(j2,z)            = 1.1 ;
 811   sigma_ENER3(j2,z)            = 1.1 ;
 812   sigma_ENER4(j2,z)            = 2.0 ;
 813   sigma_ENER5_1(j2,z)          = 2.0 ;
 814   sigma_ENER5_2(j2,z)          = 2.0 ;
 815   
