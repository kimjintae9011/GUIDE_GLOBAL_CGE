3171  * NEP_CO(p_oilproductlz) = sum((f_household), household_fne_oilproduct(f_household, p_oilproductproduct, z));
3172   
3173  *Ratio
3174  Loop(j,
3175      NOilpR_DIO(p_oilproduct,j,z)$(NOilp_DIO(p_oilproduct,j,z) gt 0)
3176           = NOilp_DIO(p_oilproduct,j,z)/sum(p_oilproduct2, NOilp_DIO(p_oilproduct2,j,z));
3177       );
3178   
3179  display NOilp_DIO, NOilpR_DIO ;
3180   
3181   
3182   Coal_Total(p_coal,z) = sum(j,Coal_DIO(p_coal,j,z)) + Coal_CO(p_coal,z) ;
3183   Gas_Total(p_gas,z) = sum(j, Gas_DIO(p_gas,j,z)) + Gas_CO(p_gas,z) ;
3184   Oilp_Total(p_oilproduct,z) = sum(j, Oilp_DIO(p_oilproduct,j,z)) + Oilp_CO(p_oilproduct,z) ;
