125_M3c22__R9r. 09_WEU
128_M3c22__R10r. 10_EEU
131_M3c22__R11r. 11_FSU
134_M3c22__R12r. 12_MEA
137_M3c22__R13r. 13_AFR
140_M3c22__R14r. 14_CPA
143_M3c22__R15r. 15_SAS
146_M3c22__R16r. 16_PAS
149_M3c22__R17r. 17_PAO
/

sam_sce12(WORLD1, z) Mapping of sectors
/
153_ww_r_01KOR. 01_KOR
154_ww_r_02CHN. 02_CHN
155_ww_r_03JPN. 03_JPN
156_ww_r_04RUS. 04_RUS
157_ww_r_05MNG. 05_MNG
158_ww_r_06PRK. 06_PRK
159_ww_r_07NAM. 07_NAM
160_ww_r_08LAM. 08_LAM
161_ww_r_09WEU. 09_WEU
162_ww_r_10EEU. 10_EEU
163_ww_r_11FSU. 11_FSU
164_ww_r_12MEA. 12_MEA
165_ww_r_13AFR. 13_AFR
166_ww_r_14CPA. 14_CPA
167_ww_r_15SAS. 15_SAS
168_ww_r_16PAS. 16_PAS
169_ww_r_17PAO. 17_PAO
/

;

ALIAS(A,B);
ALIAS(A1,A11);
ALIAS(C1,C11);
ALIAS(INT,JNT);

INT(A) = YES;
INT('175_TOT') = NO;

*============ 2.Initial matrix ===========================================
PARAMETER
SAM0(A,B,z) initial matrix ,
SAM0_01_KOR(A,B), 
SAM0_02_CHN(A,B),
SAM0_03_JPN(A,B),
SAM0_04_RUS(A,B),
SAM0_05_MNG(A,B),
SAM0_06_PRK(A,B),
SAM0_07_NAM(A,B),
SAM0_08_LAM(A,B),
SAM0_09_WEU(A,B),
SAM0_10_EEU(A,B),
SAM0_11_FSU(A,B),
SAM0_12_MEA(A,B),
SAM0_13_AFR(A,B),
SAM0_14_CPA(A,B),
SAM0_15_SAS(A,B),
SAM0_16_PAS(A,B),
SAM0_17_PAO(A,B) 
;

SAM0(INT,JNT,z) = EPS;

*Acitivities
SAM0(C1,A1,Z)  = SUM[(i,j)$[sam_sce2(C1,i)$sam_sce1(A1,j)], DIO(i,j,Z)];
SAM0(L1,A1,Z)  = SUM[(l,j)$[sam_sce3(L1,l)$sam_sce1(A1,j)], LDO2(l,j,Z)];
SAM0(K1,A1,Z)  = SUM[(k,j)$[sam_sce4(K1,k)$sam_sce1(A1,j)], RKDO(k,j,Z)];
SAM0(tf1,A1,Z)  = SUM[(l,j)$[sam_sce7(tf1,l)$sam_sce1(A1,j)], TIWO2(l,j,Z)];
SAM0(tf2,A1,Z)  = SUM[(k,j)$[sam_sce8(tf2,k)$sam_sce1(A1,j)], TIKO(k,j,Z)];
SAM0(PTX1,A1,Z) = SUM[(j)$[sam_sce1(A1,j)], TIPO(j,Z)];

*Commodities
SAM0(A1,C1,Z)       = SUM[(i,j)$[sam_sce1(A1,j)$sam_sce2(C1,i)],  XSO(j,i,z)];
SAM0(ITAX1,C1,Z)  = SUM[(i,zj)$[sam_sce5(ITAX1,zj)$sam_sce2(C1,i)], TIMO(i,zj,Z)];
SAM0(ETAX1,C1,Z)  = SUM[(i,zj)$[sam_sce6(ETAX1,zj)$sam_sce2(C1,i)], TIXO(i,Z,zj)];
SAM0(MAR1,C1,Z)  = SUM[(ij,zj)$[sam_sce9(MAR1,zj)$sam_sce2(C1,ij)],tmrg('20_LTRP',ij,zj,Z)];
SAM0(MAR2,C1,Z)  = SUM[(ij,zj)$[sam_sce10(MAR2,zj)$sam_sce2(C1,ij)],tmrg('21_WTRP',ij,zj,Z)];
SAM0(MAR3,C1,Z)  = SUM[(ij,zj)$[sam_sce11(MAR3,zj)$sam_sce2(C1,ij)],tmrg('22_ATRP',ij,zj,Z)];
SAM0(WORLD1,C1,Z) = SUM[(i,zj)$[sam_sce12(WORLD1,zj)$sam_sce2(C1,i)], IMO(i,zj,Z)];
SAM0(PTX1,C1,Z) = SUM[(i)$[sam_sce2(C1,i)], TICO(i,Z)];

*Factors
SAM0(PRI1,L1,Z)  = sum{(l)$[sam_sce3(L1,l)],LDO2_J(l,Z)};
SAM0(PRI1,K1,Z)  = sum{(k)$[sam_sce4(K1,k)],RKDO_J(k,Z)};
SAM0(DTX1,L1,Z)  = sum{(l)$[sam_sce3(L1,l)],DTAX(l,Z)};
SAM0(DTX1,K1,Z)  = sum{(k)$[sam_sce4(K1,k)],DTAX(k,Z)};

*Import tariffs
SAM0(PTX1,ITAX1,Z) = SUM[(zj)$[sam_sce5(ITAX1,zj)], sum(i,TIMO(i,zj,Z))];

*Export taxes
SAM0(PTX1,ETAX1,Z) = SUM[(zj)$[sam_sce6(ETAX1,zj)], sum(i,TIXO(i,Z,zj))];

*Factor taxes
SAM0(PTX1,tf1,Z)  = sum{(l)$[sam_sce7(tf1,l)],sum(j,TIWO2(l,j,Z))};
SAM0(PTX1,tf2,Z)  = sum{(k)$[sam_sce8(tf2,k)],sum(j,TIKO(k,j,Z))};

*Transaction cost
SAM0('150_M1c20_L_pvst',MAR1,Z) = SUM[(zj)$[sam_sce9(MAR1,zj)],sum(ij,tmrg('20_LTRP',ij,zj,Z))];
SAM0('151_M2c21_W_pvst',MAR2,Z) = SUM[(zj)$[sam_sce10(MAR2,zj)],sum(ij,tmrg('21_WTRP',ij,zj,Z))];
SAM0('152_M3c22_A_pvst',MAR3,Z) = SUM[(zj)$[sam_sce11(MAR3,zj)],sum(ij,tmrg('22_ATRP',ij,zj,Z))];

SAM0('51_c_LTRP','150_M1c20_L_pvst',Z)= MRGNO('20_LTRP',Z);
SAM0('52_c_WTRP','151_M2c21_W_pvst',Z)= MRGNO('21_WTRP',Z);
SAM0('53_c_ATRP','152_M3c22_A_pvst',Z)= MRGNO('22_ATRP',Z);

SAM0(INV1,'150_M1c20_L_pvst',Z) = sum(B,SAM0('150_M1c20_L_pvst',B,Z))-SAM0('51_c_LTRP','150_M1c20_L_pvst',Z);
SAM0(INV1,'151_M2c21_W_pvst',Z) = sum(B,SAM0('151_M2c21_W_pvst',B,Z))-SAM0('52_c_WTRP','151_M2c21_W_pvst',Z);
SAM0(INV1,'152_M3c22_A_pvst',Z) = sum(B,SAM0('152_M3c22_A_pvst',B,Z))-SAM0('53_c_ATRP','152_M3c22_A_pvst',Z);

*Import&Export
SAM0(C1,WORLD1,Z)= SUM[(i,zj)$[sam_sce12(WORLD1,zj)$sam_sce2(C1,i)],EXO(i,Z,zj)];

*Balance of Trade
SAM0(INV1,WORLD1,Z)= SUM(B,SAM0(WORLD1,B,Z))-SUM(C1,SAM0(C1,WORLD1,Z));

*Household
SAM0(C1,PRI1,Z)= SUM[(i)$[sam_sce2(C1,I)], CO(i,Z)];
SAM0(INV1,PRI1,Z)= SUM(B,SAM0(PRI1,B,Z))- SUM(C1,SAM0(C1,PRI1,Z));

*Indirect tax
SAM0(GOV1,PTX1,Z)= SUM(B,SAM0(PTX1,B,Z));

*Direct tax
SAM0(GOV1,DTX1,Z)=  TDHO(z) ;
*SAM0(GOV1,DTX1,Z)= SUM(B,SAM0(DTX1,B,Z));

*Government
SAM0(C1,GOV1,Z)= SUM[(i)$[sam_sce2(C1,I)], CGO(i,Z)];

*Saving-Investment
SAM0(C1,INV1,Z)= SUM[(i)$[sam_sce2(C1,I)], INVO(i,Z)];
SAM0(INV1,GOV1,Z)= SUM(C1, SAM0(C1,INV1,Z))-SUM(B,SAM0(INV1,B,Z));

*Total
SAM0('175_TOT',B,Z)= SUM(A,SAM0(A,B,Z));
SAM0(A,'175_TOT',Z)= SUM(B,SAM0(A,B,Z));

SAM0_01_KOR(A,B) = SAM0(A,B,'01_KOR');
SAM0_02_CHN(A,B) = SAM0(A,B,'02_CHN');
SAM0_03_JPN(A,B) = SAM0(A,B,'03_JPN');
SAM0_04_RUS(A,B) = SAM0(A,B,'04_RUS');
SAM0_05_MNG(A,B) = SAM0(A,B,'05_MNG');
SAM0_06_PRK(A,B) = SAM0(A,B,'06_PRK');
SAM0_07_NAM(A,B) = SAM0(A,B,'07_NAM');
SAM0_08_LAM(A,B) = SAM0(A,B,'08_LAM');
SAM0_09_WEU(A,B) = SAM0(A,B,'09_WEU');
SAM0_10_EEU(A,B) = SAM0(A,B,'10_EEU');
SAM0_11_FSU(A,B) = SAM0(A,B,'11_FSU');
SAM0_12_MEA(A,B) = SAM0(A,B,'12_MEA');
SAM0_13_AFR(A,B) = SAM0(A,B,'13_AFR');
SAM0_14_CPA(A,B) = SAM0(A,B,'14_CPA');
SAM0_15_SAS(A,B) = SAM0(A,B,'15_SAS');
SAM0_16_PAS(A,B) = SAM0(A,B,'16_PAS');
SAM0_17_PAO(A,B) = SAM0(A,B,'17_PAO');

execute_unload "SAM_Initial",
SAM0_01_KOR, SAM0_02_CHN, SAM0_03_JPN, SAM0_04_RUS, SAM0_05_MNG, SAM0_06_PRK,
SAM0_07_NAM, SAM0_08_LAM, SAM0_09_WEU, SAM0_10_EEU, SAM0_11_FSU, SAM0_12_MEA,
SAM0_13_AFR, SAM0_14_CPA, SAM0_15_SAS, SAM0_16_PAS, SAM0_17_PAO
;

PARAMETER
SAM1(A,B,Z) New (balanced) matrix
SAM1_01_KOR(A,B),
SAM1_02_CHN(A,B),
SAM1_03_JPN(A,B),
SAM1_04_RUS(A,B),
SAM1_05_MNG(A,B),
SAM1_06_PRK(A,B), 
SAM1_07_NAM(A,B),
SAM1_08_LAM(A,B),
SAM1_09_WEU(A,B),
SAM1_10_EEU(A,B),
SAM1_11_FSU(A,B),
SAM1_12_MEA(A,B), 
SAM1_13_AFR(A,B),
SAM1_14_CPA(A,B),
SAM1_15_SAS(A,B),
SAM1_16_PAS(A,B),
SAM1_17_PAO(A,B)
;

SAM1(A,B,Z)  = SAM0(A,B,z) ;
SAM1_01_KOR(A,B) = SAM0(A,B,'01_KOR');
SAM1_02_CHN(A,B) = SAM0(A,B,'02_CHN');
SAM1_03_JPN(A,B) = SAM0(A,B,'03_JPN');
SAM1_04_RUS(A,B) = SAM0(A,B,'04_RUS');
SAM1_05_MNG(A,B) = SAM0(A,B,'05_MNG');
*SAM1_06_PRK(A,B) = SAM0(A,B,'06_PRK');
SAM1_07_NAM(A,B) = SAM0(A,B,'07_NAM');
SAM1_08_LAM(A,B) = SAM0(A,B,'08_LAM');
SAM1_09_WEU(A,B) = SAM0(A,B,'09_WEU');
SAM1_10_EEU(A,B) = SAM0(A,B,'10_EEU');
SAM1_11_FSU(A,B) = SAM0(A,B,'11_FSU');
SAM1_12_MEA(A,B) = SAM0(A,B,'12_MEA');
SAM1_13_AFR(A,B) = SAM0(A,B,'13_AFR');
SAM1_14_CPA(A,B) = SAM0(A,B,'14_CPA');
SAM1_15_SAS(A,B) = SAM0(A,B,'15_SAS');
SAM1_16_PAS(A,B) = SAM0(A,B,'16_PAS');
SAM1_17_PAO(A,B) = SAM0(A,B,'17_PAO');

*Balanced PRK SAM using SAMBAL (GEMPACK)
$call gdxxrw Input_w-t\PRK_SAM.xlsx @Input_w-t\PRK_SAM.txt output = Input_w-t\PRK_SAM.gdx 
$gdxIn Input_w-t\PRK_SAM.gdx
$load SAM1_06_PRK

SAM1(A,B,'06_PRK') = SAM1_06_PRK(A,B);

execute_unload "SAM_BAL",
SAM1_01_KOR, SAM1_02_CHN, SAM1_03_JPN, SAM1_04_RUS, SAM1_05_MNG, SAM1_06_PRK,
SAM1_07_NAM, SAM1_08_LAM, SAM1_09_WEU, SAM1_10_EEU, SAM1_11_FSU, SAM1_12_MEA,
SAM1_13_AFR, SAM1_14_CPA, SAM1_15_SAS, SAM1_16_PAS, SAM1_17_PAO
;