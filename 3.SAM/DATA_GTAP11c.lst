2449  10_EEU.  162_ww_r_10EEU
2450  11_FSU.  163_ww_r_11FSU
2451  12_MEA. 164_ww_r_12MEA
2452  13_AFR. 165_ww_r_13AFR
2453  14_CPA. 166_ww_r_14CPA
2454  15_SAS. 167_ww_r_15SAS
2455  16_PAS. 168_ww_r_16PAS
2456  17_PAO. 169_ww_r_17PAO
2457  /
2458  ;
2459   
2460  CO(i,z) = SUM[(C1,PRI1)$[sam_sce14(i,C1)], SAM1(C1,PRI1,Z)];
2461  CGO(i,z) = SUM[(C1,GOV1)$[sam_sce14(i,C1)], SAM1(C1,GOV1,Z)];
2462  INVO(i,z) = SUM[(C1,INV1)$[sam_sce14(i,C1)], SAM1(C1,INV1,Z)];
2463  DIO(i,j,z) = SUM[(C1,A1)$[sam_sce14(i,C1)$sam_sce13(j,A1)], SAM1(C1,A1,Z)];
2464  IMO(i,zj,z) = SUM[(World1,C1)$[sam_sce24(zj,World1)$sam_sce14(i,C1)], SAM1(World1,C1,Z)];
2465  EXO(i,zj,z) = IMO(i,zj,z);
2466  EXTO(i,z) = SUM(zj, EXO(i,z,zj));
2467  tmrg('20_LTRP',ij,zj,z) = SUM[(MAR1,C1)$[sam_sce21(zj,MAR1)$sam_sce14(ij,C1)],SAM1(MAR1,C1,Z)];
2468  tmrg('21_WTRP',ij,zj,z) = SUM[(MAR2,C1)$[sam_sce22(zj,MAR2)$sam_sce14(ij,C1)],SAM1(MAR2,C1,Z)];
2469  tmrg('22_ATRP',ij,zj,z) = SUM[(MAR3,C1)$[sam_sce23(zj,MAR3)$sam_sce14(ij,C1)],SAM1(MAR3,C1,Z)];
2470  MRGNO('20_LTRP',z) = SAM1('51_c_LTRP','150_M1c20_L_pvst',Z);
2471  MRGNO('21_WTRP',z) = SAM1('52_c_WTRP','151_M2c21_W_pvst',Z);
2472  MRGNO('22_ATRP',z) = SAM1('53_c_ATRP','152_M3c22_A_pvst',Z);
2473  TIMO(i,zj,z) = SUM[(ITAX1,C1)$[sam_sce19(zj,ITAX1)$sam_sce14(i,C1)], SAM1(ITAX1,C1,Z)];
2474  TIXO(i,z,zj) = SUM[(ETAX1,C1)$[sam_sce20(zJ,ETAX1)$sam_sce14(i,C1)], SAM1(ETAX1,C1,Z)];
2475  TIWO2(l,j,z) = SUM[(tf1,A1)$[sam_sce17(l,tf1)$sam_sce13(j,A1)], SAM1(tf1,A1,Z)];
2476  TIWO2_J(l,z) = SUM(j, TIWO2(l,j,z));
2477  TIWO(j,z) = SUM(l, TIWO2(l,j,z));
2478  TIWO_J(z) = SUM(j, TIWO(j,z));
2479  TIKO(k,j,z) = SUM[(tf2,A1)$[sam_sce18(k,tf2)$sam_sce13(j,A1)], SAM1(tf2,A1,Z)];
2480  TIKO_J(k,z) = SUM(j, TIKO(k,j,z));
2481  TIPO(j,z) = SUM[(PTX1,A1)$[sam_sce13(j,A1)], SAM1(PTX1,A1,Z)];
2482  TICO(i,z) = SUM[(PTX1,C1)$[sam_sce14(i,C1)], SAM1(PTX1,C1,Z)];
2483  TDHO(z) = SUM[(DTX1),SAM1(DTX1,'175_TOT',Z)];
2484  DTAX('land',z) = SAM1('172_DIRTAX','55_Land',Z);
2485  DTAX('slab ',z) = SAM1('172_DIRTAX','56_UnSkLab',Z);
2486  DTAX('ulab',z) = SAM1('172_DIRTAX','57_SkLab',Z);
2487  DTAX('cap',z) = SAM1('172_DIRTAX','58_Capital',Z);
2488  DTAX('natr',z) = SAM1('172_DIRTAX','59_NatRes',Z);
2489  LDO2(l,j,Z) = SUM[(L1,A1)$[sam_sce15(l,L1)$sam_sce13(j,A1)], SAM1(L1,A1,Z)];
2490  LDO2_J(l,z) = SUM(j,LDO2(l,j,z));
2491  LDO(j,z) = SUM(l,LDO2(l,j,z));
2492  LDO_J(z) = SUM(j,LDO(j,z));
2493  RKDO(k,j,Z) = SUM[(K1,A1)$[sam_sce16(k,K1)$sam_sce13(j,A1)], SAM1(K1,A1,Z)];
2494  * Once again, to avoid descrepencies, domestic purchases are calculated by substracting imports, transport margins and indirect taxes from total domestic absorption.
2495  DDO(i,Z) = CO(i,Z)+CGO(i,Z)+INVO(i,Z)+SUM[j,DIO(i,j,Z)]-TICO(i,Z)-SUM[zj,TIMO(i,zj,Z)]-SUM[zj,IMO(i,zj,Z)]-SUM[(ij,zj),tmrg(ij,i,zj,Z)];
2496  MAKE(j,i,z) = SUM[(A1,C1)$[sam_sce13(j,A1)$sam_sce14(i,C1)], SAM1(A1,C1,Z)];
2497   
2498  *==============================================================================
2499  * Equilibrate data
2500  *==============================================================================
2501  * Equilibrium on the world margin market
2502  *  The first step would be to equilibrate international markets. As there is a small difference between supply of margins and demand, we chose to adjust
2503  *  the supply side by increasing or reducing each region's production proportionately.
2504  MRGNO(i,z)$MRGNO(i,z) = MRGNO(i,z)*SUM[(ij,zj,zjj),tmrg(i,ij,zj,zjj)] /SUM[zjj,MRGNO(i,zjj)];
2505   
2506  *Equilibrium in each region
2507  *  As exports have already been set equal to imports, the remaining differences would appear in the national data. Total production is first set equal to
2508  *  the sum of production for the domestic market (DSO), adjusted production of margins (MRGNO) and exports.
2509  DSO_I(i,z) = DDO(i,Z);
2510  XSO_I(i,z) = DDO(i,z)+MRGNO(i,z)+SUM[zj,EXO(i,z,zj)-TIXO(i,z,zj)];
2511  XSO(j,i,z) = XSO_I(i,z)*[MAKE(j,i,z)/sum(jj,MAKE(jj,i,z))];
2512  XSTO(j,z) = SUM(i, XSO(j,i,z));
2513  EXTO(i,z) = SUM[zj,EXO(i,z,zj)];
2514  DSO(j,i,z) = DDO(i,z)*[MAKE(j,i,z)/sum(jj,MAKE(jj,i,z))];
2515   
2516  *Balancing
2517  * The operating surplus is the variable that was used to equilibrate the regional data.
2518  * As all other variables (income, savings and so on) will be calculated based on the variables described in these steps, there should not be any other descrepency.
2519  RKDO('cap',j,z) = XSTO(j,z)-SUM[i,DIO(i,j,z)]-LDO(j,z)-TIWO(j,z)-TIPO(j,z)-SUM[k,TIKO(k,j,z)]-RKDO('land',j,z) -RKDO('natr',j,z);
2520  TotalCost(j,z) = SUM[i,DIO(i,j,z)]+LDO(j,z)+TIWO(j,z)+TIPO(j,z)+SUM[k,TIKO(k,j,z)+RKDO(k,j,z)];
2521   
2522  *================================================================================
2523  execute_unload 'Input_w-t\DATA_AGG-2019_GTAP11c_Regen.gdx',
2524   
