2066  SAM0(A,B,z) initial matrix ,
2067  SAM0_01_KOR(A,B),
2068  SAM0_02_CHN(A,B),
2069  SAM0_03_JPN(A,B),
2070  SAM0_04_RUS(A,B),
2071  SAM0_05_MNG(A,B),
2072  SAM0_06_PRK(A,B),
2073  SAM0_07_NAM(A,B),
2074  SAM0_08_LAM(A,B),
2075  SAM0_09_WEU(A,B),
2076  SAM0_10_EEU(A,B),
2077  SAM0_11_FSU(A,B),
2078  SAM0_12_MEA(A,B),
2079  SAM0_13_AFR(A,B),
2080  SAM0_14_CPA(A,B),
2081  SAM0_15_SAS(A,B),
2082  SAM0_16_PAS(A,B),
2083  SAM0_17_PAO(A,B)
2084  ;
2085   
2086  SAM0(INT,JNT,z) = EPS;
2087   
2088  *Acitivities
2089  SAM0(C1,A1,Z)  = SUM[(i,j)$[sam_sce2(C1,i)$sam_sce1(A1,j)], DIO(i,j,Z)];
2090  SAM0(L1,A1,Z)  = SUM[(l,j)$[sam_sce3(L1,l)$sam_sce1(A1,j)], LDO2(l,j,Z)];
2091  SAM0(K1,A1,Z)  = SUM[(k,j)$[sam_sce4(K1,k)$sam_sce1(A1,j)], RKDO(k,j,Z)];
2092  SAM0(tf1,A1,Z)  = SUM[(l,j)$[sam_sce7(tf1,l)$sam_sce1(A1,j)], TIWO2(l,j,Z)];
2093  SAM0(tf2,A1,Z)  = SUM[(k,j)$[sam_sce8(tf2,k)$sam_sce1(A1,j)], TIKO(k,j,Z)];
2094  SAM0(PTX1,A1,Z) = SUM[(j)$[sam_sce1(A1,j)], TIPO(j,Z)];
2095   
2096  *Commodities
2097  SAM0(A1,C1,Z)       = SUM[(i,j)$[sam_sce1(A1,j)$sam_sce2(C1,i)],  XSO(j,i,z)];
2098  SAM0(ITAX1,C1,Z)  = SUM[(i,zj)$[sam_sce5(ITAX1,zj)$sam_sce2(C1,i)], TIMO(i,zj,Z)];
2099  SAM0(ETAX1,C1,Z)  = SUM[(i,zj)$[sam_sce6(ETAX1,zj)$sam_sce2(C1,i)], TIXO(i,Z,zj)];
2100  SAM0(MAR1,C1,Z)  = SUM[(ij,zj)$[sam_sce9(MAR1,zj)$sam_sce2(C1,ij)],tmrg('20_LTRP',ij,zj,Z)];
2101  SAM0(MAR2,C1,Z)  = SUM[(ij,zj)$[sam_sce10(MAR2,zj)$sam_sce2(C1,ij)],tmrg('21_WTRP',ij,zj,Z)];
2102  SAM0(MAR3,C1,Z)  = SUM[(ij,zj)$[sam_sce11(MAR3,zj)$sam_sce2(C1,ij)],tmrg('22_ATRP',ij,zj,Z)];
2103  SAM0(WORLD1,C1,Z) = SUM[(i,zj)$[sam_sce12(WORLD1,zj)$sam_sce2(C1,i)], IMO(i,zj,Z)];
2104  SAM0(PTX1,C1,Z) = SUM[(i)$[sam_sce2(C1,i)], TICO(i,Z)];
2105   
2106  *Factors
2107  SAM0(PRI1,L1,Z)  = sum{(l)$[sam_sce3(L1,l)],LDO2_J(l,Z)};
2108  SAM0(PRI1,K1,Z)  = sum{(k)$[sam_sce4(K1,k)],RKDO_J(k,Z)};
2109  SAM0(DTX1,L1,Z)  = sum{(l)$[sam_sce3(L1,l)],DTAX(l,Z)};
2110  SAM0(DTX1,K1,Z)  = sum{(k)$[sam_sce4(K1,k)],DTAX(k,Z)};
2111   
2112  *Import tariffs
2113  SAM0(PTX1,ITAX1,Z) = SUM[(zj)$[sam_sce5(ITAX1,zj)], sum(i,TIMO(i,zj,Z))];
2114   
2115  *Export taxes
2116  SAM0(PTX1,ETAX1,Z) = SUM[(zj)$[sam_sce6(ETAX1,zj)], sum(i,TIXO(i,Z,zj))];
2117   
2118  *Factor taxes
2119  SAM0(PTX1,tf1,Z)  = sum{(l)$[sam_sce7(tf1,l)],sum(j,TIWO2(l,j,Z))};
2120  SAM0(PTX1,tf2,Z)  = sum{(k)$[sam_sce8(tf2,k)],sum(j,TIKO(k,j,Z))};
2121   
2122  *Transaction cost
2123  SAM0('150_M1c20_L_pvst',MAR1,Z) = SUM[(zj)$[sam_sce9(MAR1,zj)],sum(ij,tmrg('20_LTRP',ij,zj,Z))];
2124  SAM0('151_M2c21_W_pvst',MAR2,Z) = SUM[(zj)$[sam_sce10(MAR2,zj)],sum(ij,tmrg('21_WTRP',ij,zj,Z))];
2125  SAM0('152_M3c22_A_pvst',MAR3,Z) = SUM[(zj)$[sam_sce11(MAR3,zj)],sum(ij,tmrg('22_ATRP',ij,zj,Z))];
2126   
2127  SAM0('51_c_LTRP','150_M1c20_L_pvst',Z)= MRGNO('20_LTRP',Z);
2128  SAM0('52_c_WTRP','151_M2c21_W_pvst',Z)= MRGNO('21_WTRP',Z);
2129  SAM0('53_c_ATRP','152_M3c22_A_pvst',Z)= MRGNO('22_ATRP',Z);
2130   
2131  SAM0(INV1,'150_M1c20_L_pvst',Z) = sum(B,SAM0('150_M1c20_L_pvst',B,Z))-SAM0('51_c_LTRP','150_M1c20_L_pvst',Z);
2132  SAM0(INV1,'151_M2c21_W_pvst',Z) = sum(B,SAM0('151_M2c21_W_pvst',B,Z))-SAM0('52_c_WTRP','151_M2c21_W_pvst',Z);
2133  SAM0(INV1,'152_M3c22_A_pvst',Z) = sum(B,SAM0('152_M3c22_A_pvst',B,Z))-SAM0('53_c_ATRP','152_M3c22_A_pvst',Z);
2134   
2135  *Import&Export
2136  SAM0(C1,WORLD1,Z)= SUM[(i,zj)$[sam_sce12(WORLD1,zj)$sam_sce2(C1,i)],EXO(i,Z,zj)];
2137   
2138  *Balance of Trade
2139  SAM0(INV1,WORLD1,Z)= SUM(B,SAM0(WORLD1,B,Z))-SUM(C1,SAM0(C1,WORLD1,Z));
2140   
2141  *Household
2142  SAM0(C1,PRI1,Z)= SUM[(i)$[sam_sce2(C1,I)], CO(i,Z)];
2143  SAM0(INV1,PRI1,Z)= SUM(B,SAM0(PRI1,B,Z))- SUM(C1,SAM0(C1,PRI1,Z));
2144   
2145  *Indirect tax
2146  SAM0(GOV1,PTX1,Z)= SUM(B,SAM0(PTX1,B,Z));
2147   
2148  *Direct tax
2149  SAM0(GOV1,DTX1,Z)=  TDHO(z) ;
2150  *SAM0(GOV1,DTX1,Z)= SUM(B,SAM0(DTX1,B,Z));
2151   
2152  *Government
2153  SAM0(C1,GOV1,Z)= SUM[(i)$[sam_sce2(C1,I)], CGO(i,Z)];
2154   
2155  *Saving-Investment
2156  SAM0(C1,INV1,Z)= SUM[(i)$[sam_sce2(C1,I)], INVO(i,Z)];
2157  SAM0(INV1,GOV1,Z)= SUM(C1, SAM0(C1,INV1,Z))-SUM(B,SAM0(INV1,B,Z));
2158   
2159  *Total
2160  SAM0('175_TOT',B,Z)= SUM(A,SAM0(A,B,Z));
2161  SAM0(A,'175_TOT',Z)= SUM(B,SAM0(A,B,Z));
2162   
2163  SAM0_01_KOR(A,B) = SAM0(A,B,'01_KOR');
2164  SAM0_02_CHN(A,B) = SAM0(A,B,'02_CHN');
2165  SAM0_03_JPN(A,B) = SAM0(A,B,'03_JPN');
2166  SAM0_04_RUS(A,B) = SAM0(A,B,'04_RUS');
2167  SAM0_05_MNG(A,B) = SAM0(A,B,'05_MNG');
2168  SAM0_06_PRK(A,B) = SAM0(A,B,'06_PRK');
2169  SAM0_07_NAM(A,B) = SAM0(A,B,'07_NAM');
2170  SAM0_08_LAM(A,B) = SAM0(A,B,'08_LAM');
2171  SAM0_09_WEU(A,B) = SAM0(A,B,'09_WEU');
2172  SAM0_10_EEU(A,B) = SAM0(A,B,'10_EEU');
2173  SAM0_11_FSU(A,B) = SAM0(A,B,'11_FSU');
2174  SAM0_12_MEA(A,B) = SAM0(A,B,'12_MEA');
2175  SAM0_13_AFR(A,B) = SAM0(A,B,'13_AFR');
2176  SAM0_14_CPA(A,B) = SAM0(A,B,'14_CPA');
2177  SAM0_15_SAS(A,B) = SAM0(A,B,'15_SAS');
2178  SAM0_16_PAS(A,B) = SAM0(A,B,'16_PAS');
2179  SAM0_17_PAO(A,B) = SAM0(A,B,'17_PAO');
2180   
