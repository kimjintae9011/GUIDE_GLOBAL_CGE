  !  (There is no CREATION information on this file.)
 
 
  --> Reading the Command file.
 
 auxiliary files = sambal;
 File INFILE = SAM0.har;
 Updated File INFILE = SAM1.har;
 start with MMNZ = 21251 ; ! suitable for SAM size 64*64
 method = Gragg;
 steps = 13 15 17;
 log file = yes;
 verbal description = SAM balancing;
 exogenous ShockDiff fmult fsam;
 rest endogenous;
 
 !swap fmult("gov") = ROWTOT("gov");
 !FINAL_LEVEL ROWTOT("gov") = 150000; ! to make gov col add to 150000 !
 
 xSet EXOGENE  # commodity #
 (c_AGRICULT,c_COAL,c_OIL,c_GAS,c_MINING,c_FOODPRO,c_TEXTILES,
 c_WOODPRO,c_PAPERPRO,c_PETROLCOAL,c_CHEMICAL,c_NONMET,c_IRONSTL,c_NONFERR,
 c_MACHINE,c_TRANSEQ,c_OTHERIND,c_ELEC,c_CONSTRUC,c_LTRP,c_WTRP,c_ATRP,
 c_SER);
 
 xSubset EXOGENE  is subset of ACC;
 
 xSet WW_R  # ww_r_country #
 (ww_r_01KOR, ww_r_02CHN, ww_r_03JPN, ww_r_04RUS, ww_r_05MNG, ww_r_06PRK
 ,ww_r_07NAM, ww_r_08LAM, ww_r_09WEU, ww_r_10EEU, ww_r_11FSU, ww_r_12MEA, ww_r_13AFR
 ,ww_r_14CPA, ww_r_15SAS, ww_r_16PAS,ww_r_17PAO);
 
 xSubset WW_R is subset of ACC;
 
 xSet EXOACT  # activity #
 (a_AGRICULT,a_COAL,a_OIL,a_GAS,a_MINING,a_FOODPRO,a_TEXTILES,a_WOODPRO,a_PAPERPRO,
 a_PETROLCOAL,a_CHEMICAL,a_NONMET,a_IRONSTL,a_NONFERR,a_MACHINE,a_TRANSEQ,a_OTHERIND,
 a_TnD,a_eNuclear,a_eCoal,a_eGas,a_eOil,a_eWind,a_eSolar,a_eHydro,a_eOther,
 a_CONSTRUC,a_LTRP,a_WTRP,a_ATRP,a_SER);
 
 xSubset EXOACT is subset of ACC;
 
 xSet EXOFACTOR  # factors #
 (Land,UnSkLab,SkLab,Capital,NatRes);
 
 xSubset EXOFACTOR is subset of ACC;
 
 swap fsam(EXOGENE,"ww_r_01KOR")    =p_sam(EXOGENE,"ww_r_01KOR");
 swap fsam(EXOGENE,"ww_r_02CHN")    =p_sam(EXOGENE,"ww_r_02CHN");
 swap fsam(EXOGENE,"ww_r_03JPN")    =p_sam(EXOGENE,"ww_r_03JPN");
 swap fsam(EXOGENE,"ww_r_04RUS")    =p_sam(EXOGENE,"ww_r_04RUS");
 swap fsam(EXOGENE,"ww_r_05MNG")    =p_sam(EXOGENE,"ww_r_05MNG");
 swap fsam(EXOGENE,"ww_r_07NAM")    =p_sam(EXOGENE,"ww_r_07NAM");
 swap fsam(EXOGENE,"ww_r_08LAM")    =p_sam(EXOGENE,"ww_r_08LAM");
 swap fsam(EXOGENE,"ww_r_09WEU")    =p_sam(EXOGENE,"ww_r_09WEU");
 swap fsam(EXOGENE,"ww_r_10EEU")    =p_sam(EXOGENE,"ww_r_10EEU");
 swap fsam(EXOGENE,"ww_r_11FSU")    =p_sam(EXOGENE,"ww_r_11FSU");
 swap fsam(EXOGENE,"ww_r_12MEA")    =p_sam(EXOGENE,"ww_r_12MEA");
 swap fsam(EXOGENE,"ww_r_13AFR")    =p_sam(EXOGENE,"ww_r_13AFR");
 swap fsam(EXOGENE,"ww_r_15SAS")    =p_sam(EXOGENE,"ww_r_15SAS");
 swap fsam(EXOGENE,"ww_r_16PAS")    =p_sam(EXOGENE,"ww_r_16PAS");
 swap fsam(EXOGENE,"ww_r_17PAO")    =p_sam(EXOGENE,"ww_r_17PAO");
 
 swap fsam("Land","a_AGRICULT")     =p_sam("Land","a_AGRICULT")   ;
 swap fsam("UnSkLab",EXOACT)        =p_sam("UnSkLab",EXOACT)      ;
 swap fsam("SkLab",EXOACT)          =p_sam("SkLab",EXOACT)        ;
 swap fsam("Capital",EXOACT)        =p_sam("Capital",EXOACT)      ;
 swap fsam("NatRes","a_AGRICULT")   =p_sam("NatRes","a_AGRICULT") ;
 swap fsam("NatRes","a_COAL")       =p_sam("NatRes","a_COAL")     ;
 swap fsam("NatRes","a_OIL")        =p_sam("NatRes","a_OIL")      ;
 swap fsam("NatRes","a_GAS")        =p_sam("NatRes","a_GAS")      ;
 swap fsam("NatRes","a_MINING")     =p_sam("NatRes","a_MINING")   ;
 
 FINAL_LEVEL ShockDiff = uniform 0;  ! to eliminate (row-col) differences !
 
 
 
 
 
 
 
 
 
