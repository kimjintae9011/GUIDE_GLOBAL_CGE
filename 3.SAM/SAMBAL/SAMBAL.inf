      1   ! TABLO program to balance a square SAM!
      2   ! Mark Horridge October 2003 !
      3   ! Revised to use levels notation May 2008 !
      4    
      5   ! SAM BALANCING PROGRAM FOR SQUARE SAMS
      6     Adjusts original matrix SAM(row,col)
      7     with scaling factors or multipliers MULT(i)
      8     so that   new SAM(row,col) = old SAM(row,col)*MULT(row)/MULT(col)
      9     and       Row totals of new SAM = Col totals of new SAM
     10   Also allows selected row or col totals to be held to specific values
     11    
     12   More explanations are in the accompanying files README.TXT and SAMBAL.DOC. !
     13    
     14   ! These statements put GEMPACK into 'levels' mode !
     15   Variable    (default=levels);
     16   Variable    (default=change);
     17   Equation    (default=levels);
     18   Formula     (default=initial);
     19   Coefficient (default=parameter);
     20    
     21   File INFILE # The original SAM #; ! the update file will contain new SAM !
     22    
     23   Set ACC # SAM accounts # read elements from file INFILE header "ACC";
     24    
     25   Variable (percent_change) ! so % variable will be p_SAM. We prefer % here
     26   because scaling rule is expressed in proportional terms !
     27    (all,r,ACC)(all,c,ACC) SAM(r,c) # Social Accounting Matrix #;
     28   Read SAM from file INFILE header "SAM0";
     29    
     30   ! Compute row-col differences in levels and in changes !
     31   Variable
     32    (all,r,ACC) ROWTOT(r) # Current row total #;
     33    (all,c,ACC) COLTOT(c) # Current col total #;
     34    (all,a,ACC) DIFF(a)   # Imbalance = ROWTOT-COLTOT#;
     35   Formula&Equation
     36   E_ROWTOT (all,r,ACC) ROWTOT(r) = sum{c,ACC, SAM(r,c)};
       !  EQUATION(LINEAR) E_ROWTOT
          (ALL,r,ACC) c_ROWTOT(r) = SUM(c,ACC,SAM(r,c) / 100.0  * p_SAM(r,c))

           ;  ! 

     37   Formula&Equation
     38   E_COLTOT (all,c,ACC) COLTOT(c) = sum{r,ACC, SAM(r,c)};
       !  EQUATION(LINEAR) E_COLTOT
          (ALL,c,ACC) c_COLTOT(c) = SUM(r,ACC,SAM(r,c) / 100.0  * p_SAM(r,c))

           ;  ! 

     39   Formula&Equation
     40   E_DIFF   (all,a,ACC) DIFF(a)   = ROWTOT(a) - COLTOT(a);
       !  EQUATION(LINEAR) E_DIFF
          (ALL,a,ACC) c_DIFF(a) = c_ROWTOT(a) - c_COLTOT(a) ;  ! 

     41    
     42   Coefficient (all,r,ACC)(all,c,ACC) Z(r,c) # Error weights #;
     43   Formula     (all,r,ACC)(all,c,ACC) Z(r,c) = 1.0;
     44   ! Z is a parameter you can use to hold particular SAM cells fixed, or to force
     45     some cells to vary more than others. If Z(r,c)=0, SAM(r,c) will not change.
     46     If Z(r,c)=0.5, SAM(r,c) will change less than other cells with Z=1.0.
     47     But be warned -- the more cells you hold fixed, the greater the changes
     48     needed in other cells !
     49    
     50   ! Next equation:
     51    (i)   causes zero SAM cells to remain zero [pSAM(r,c) = 0]
     52    (ii)  causes +ve  SAM cells to be scaled by a factor [MULT(r)/MULT(c)]
     53    (iii) causes -ve  SAM cells to be scaled by a factor [MULT(c)/MULT(r)] !
     54   Coefficient (all,r,ACC)(all,c,ACC) ZZ(r,c) # Sign-adjusted error weights #;
     55   Formula     (all,r,ACC)(all,c,ACC) ZZ(r,c) = if (SAM(r,c)>0, +Z(r,c))
     56                                              + if (SAM(r,c)<0, -Z(r,c));
     57   Variable
     58   (linear, percent_change) (all,a,ACC) mult(a)
     59                      # Percent change in Multipliers (initial value = 1) #;
     60   (linear, percent_change) (all,a,ACC) fmult(a)
     61                      # Slack to allow extra constraint #;
     62   (linear, percent_change) (all,r,ACC)(all,c,ACC) fsam(r,c)
     63                      # Slack to allow extra constraint #;
     64   Equation (linear) E_p_SAM (all,r,ACC)(all,c,ACC)
     65      p_SAM(r,c) =   ZZ(r,c)*[mult(r) - mult(c) + fmult(r) + fmult(c)+fsam(r,c)];
     66   !Substitute p_SAM using E_p_SAM;!
     67   ! The additional fmult scale, normally exogenous and zero, could be freed
     68     to accomodate an additional rowsum (=colsum) constraint. For example, we
     69     might wish to set the total size of government spending. !
     70    
     71   ! Since each cell is scaled by MULT(r)/MULT(c)
     72     doubling all MULT would yield the same revised SAM.
     73     To determine the average absolute size of the MULT
     74     we need an additional normalization rule, for example:!
     75   Equation (linear) E_slack
     76      sum{r,ACC,sum{c,ACC, ABS[SAM(r,c)]*[mult(r)+mult(c)]}} = 0;
     77   ! The form of the normalization rule affects the average absolute size of the
     78   MULTs, but does not affect the final updated SAM. !
     79    
     80   ! For empty SAM rows or columns, the multiplier would be undetermined.
     81     So multiplier must be set to zero change for these "inactive" accounts. !
     82   Set INACTIVE = (all,a,ACC: [sum{c,ACC, ABS[SAM(a,c)]}=0]
     83                           or [sum{r,ACC, ABS[SAM(r,a)]}=0]);
     84   Equation (linear) E_multA (all,a,INACTIVE)  mult(a) = 0;
     85    
     86   !  We wish to shock the DIFF terms to zero -- but there is a difficulty.
     87      Sum of all ROWTOTs = matrix total = sum of all COLTOTs
     88      Therefore, sum of DIFFs is necessarily zero
     89        -- so we cannot independently shock all DIFF elements.
     90      To get round the problem, we construct an ancillary exogenous variable
     91      ShockDiff, which is equal to DIFF plus an endogenous slack variable.
     92      We will shock ShockDiff by the desired change in DIFF (slack should turn out
     93      to be zero or tiny). !
     94   Set ACTIVE   =  ACC - INACTIVE;
     95   Variable
     96   (linear, orig_level=DIFF) (all,a,ACC) ShockDiff(a)  # variable to shock #;
     97   (linear) slack # Slack variable to accommodate not-quite-independent shocks #;
     98   Equation
     99    (linear) E_multB (all,a,ACTIVE)  c_Diff(a) = ShockDiff(a)  + slack;
    100    




