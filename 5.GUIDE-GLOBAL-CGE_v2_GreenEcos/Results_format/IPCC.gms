IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.3.c','Railways','CH4','Gg_CO2eq/yr',year_IPCC)                                               = eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.3.d','Water-borne_Navigation','CH4','Gg_CO2eq/yr',year_IPCC)                                 = sum(Water,valCH4I2(Water,Country,year_IPCC,'%CurrentSce%'));
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.3.e','Other_Transportation','CH4','Gg_CO2eq/yr',year_IPCC)                                   = eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.4','Residential&other_sectors','CH4','Gg_CO2eq/yr',year_IPCC)                                = sum(Other,valCH4I2(Other,Country,year_IPCC,'%CurrentSce%'))+valTCH4H(Country,year_IPCC,'%CurrentSce%');
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.5','Non-Specified','CH4','Gg_CO2eq/yr',year_IPCC)                                            = eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.B.1','Solid_Fuels','CH4','Gg_CO2eq/yr',year_IPCC)                                              = NONCO2_coef('1.B.1','CH4',Country)*valQ('02_COAL',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps;
