*==============================================================================
* Assignment of solution values to result parameters
*==============================================================================

*CO2
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.1.a','Main_Electricity_Heat_Production','CO2','Gg_CO2eq/yr',year_IPCC)                       = sum(Supply_elec,valCO2I2(Supply_elec,Country,year_IPCC,'%CurrentSce%')+valCO2NE2(Supply_elec,Country,year_IPCC,'%CurrentSce%'));
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.1.bc','Petroleum_Refining','CO2','Gg_CO2eq/yr',year_IPCC)                                    = sum(Supply_petrol,valCO2I2(Supply_petrol,Country,year_IPCC,'%CurrentSce%')+valCO2NE2(Supply_petrol,Country,year_IPCC,'%CurrentSce%'));
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.2','Manufacturing_Industries&Construction','CO2','Gg_CO2eq/yr',year_IPCC)                    = sum(Indcon,valCO2I2(Indcon,Country,year_IPCC,'%CurrentSce%')+valCO2NE2(Indcon,Country,year_IPCC,'%CurrentSce%'));
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.3.a','Civil_Aviation','CO2','Gg_CO2eq/yr',year_IPCC)                                         = sum(Air,valCO2I2(Air,Country,year_IPCC,'%CurrentSce%')+valCO2NE2(Air,Country,year_IPCC,'%CurrentSce%'));
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.3.b_noRES','Road_Transportation_no_resuspension','CO2','Gg_CO2eq/yr',year_IPCC)              = sum(Roadrail,valCO2I2(Roadrail,Country,year_IPCC,'%CurrentSce%')+valCO2NE2(Roadrail,Country,year_IPCC,'%CurrentSce%'));
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.3.c','Railways','CO2','Gg_CO2eq/yr',year_IPCC)                                               = eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.3.d','Water-borne_Navigation','CO2','Gg_CO2eq/yr',year_IPCC)                                 = sum(Water,valCO2I2(Water,Country,year_IPCC,'%CurrentSce%')+valCO2NE2(Water,Country,year_IPCC,'%CurrentSce%'));
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.3.e','Other_Transportation','CO2','Gg_CO2eq/yr',year_IPCC)                                   = eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.4','Residential&other_sectors','CO2','Gg_CO2eq/yr',year_IPCC)                                = sum(Other,valCO2I2(Other,Country,year_IPCC,'%CurrentSce%')+valCO2NE2(Other,Country,year_IPCC,'%CurrentSce%'))+valTCO2H(Country,year_IPCC,'%CurrentSce%');
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.5','Non-Specified','CO2','Gg_CO2eq/yr',year_IPCC)                                            = eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.B.1','Solid_Fuels','CO2','Gg_CO2eq/yr',year_IPCC)                                              = NONCO2_coef('1.B.1','CO2',Country)*valQ('02_COAL',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps;
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.B.2','Oil&Natural_Gas','CO2','Gg_CO2eq/yr',year_IPCC)                                          = NONCO2_coef('1.B.2','CO2',Country)*(valQ('03_OIL',Country,year_IPCC,'%CurrentSce%')+valQ('04_GAS',Country,year_IPCC,'%CurrentSce%'))*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps;

IPCC(model_IPCC, '%CurrentSce%', Country,'2.IPPU','2.A.1','Cement_production','CO2','Gg_CO2eq/yr',year_IPCC)                                          = NONCO2_coef('2.A.1','CO2',Country)*valXS('12_Nonmet','12_Nonmet',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'2.IPPU','2.A.2','Lime_production','CO2','Gg_CO2eq/yr',year_IPCC)                                            = NONCO2_coef('2.A.2','CO2',Country)*valXS('12_Nonmet','12_Nonmet',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'2.IPPU','2.A.3','Glass_Production','CO2','Gg_CO2eq/yr',year_IPCC)                                           = NONCO2_coef('2.A.3','CO2',Country)*valXS('12_Nonmet','12_Nonmet',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'2.IPPU','2.A.4','Other_Process_Uses_of_Carbonates','CO2','Gg_CO2eq/yr',year_IPCC)                           = NONCO2_coef('2.A.4','CO2',Country)*valXS('11_CHEMICAL','11_CHEMICAL',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'2.IPPU','2.B','Chemical_Industry','CO2','Gg_CO2eq/yr',year_IPCC)                                            = NONCO2_coef('2.B','CO2',Country)*valXS('11_CHEMICAL','11_CHEMICAL',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'2.IPPU','2.C','Metal_Industry','CO2','Gg_CO2eq/yr',year_IPCC)                                               = NONCO2_coef('2.C','CO2',Country)*valXS('13_IRONSTL','13_IRONSTL',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'2.IPPU','2.D','Non-Energy_Products_from_Fuels&Solvent_Use','CO2','Gg_CO2eq/yr',year_IPCC)                   = NONCO2_coef('2.D','CO2',Country)*valXS('11_CHEMICAL','11_CHEMICAL',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'2.IPPU','2.E','Electronics_Industry','CO2','Gg_CO2eq/yr',year_IPCC)                                         = NONCO2_coef('2.E','CO2',Country)*valXS('15_MACHINE','15_MACHINE',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'2.IPPU','2.F','Product_Uses_as_Substitutes_for_Ozone_Depleting_Substances','CO2','Gg_CO2eq/yr',year_IPCC)   = NONCO2_coef('2.F','CO2',Country)*valXS('15_MACHINE','15_MACHINE',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'2.IPPU','2.G','Other_Product_Manufacture&Use','CO2','Gg_CO2eq/yr',year_IPCC)                                = NONCO2_coef('2.G','CO2',Country)*valXS('15_MACHINE','15_MACHINE',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;

IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.A.1','Enteric_Fermentation','CO2','Gg_CO2eq/yr',year_IPCC)                                      = NONCO2_coef('3.A.1','CO2',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.A.2','Manure_Management','CO2','Gg_CO2eq/yr',year_IPCC)                                         = NONCO2_coef('3.A.2','CO2',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.C.1','Emissions_from_biomass_burning','CO2','Gg_CO2eq/yr',year_IPCC)                            = NONCO2_coef('3.C.1','CO2',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.C.2','Liming','CO2','Gg_CO2eq/yr',year_IPCC)                                                    = NONCO2_coef('3.C.2','CO2',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ; 
IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.C.3','Urea_application','CO2','Gg_CO2eq/yr',year_IPCC)                                          = NONCO2_coef('3.C.3','CO2',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.C.4','Direct_N2O_Emissions_from managed_soils','CO2','Gg_CO2eq/yr',year_IPCC)                   = NONCO2_coef('3.C.4','CO2',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.C.5','Indirect_N2O_Emissions_from_managed_soils','CO2','Gg_CO2eq/yr',year_IPCC)                 = NONCO2_coef('3.C.5','CO2',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.C.6','Indirect_N2O_Emissions_from_manure_management','CO2','Gg_CO2eq/yr',year_IPCC)             = NONCO2_coef('3.C.6','CO2',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.C.7','Rice_cultivations','CO2','Gg_CO2eq/yr',year_IPCC)                                         = NONCO2_coef('3.C.7','CO2',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;

IPCC(model_IPCC, '%CurrentSce%', Country,'4.Waste','4.A','Solid_Waste_Disposal','CO2','Gg_CO2eq/yr',year_IPCC)                                        = NONCO2_coef('4.A','CO2',Country)*valGDP_MP_REAL(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'4.Waste','4.B','Biological_Treatment_of_Solid_Waste','CO2','Gg_CO2eq/yr',year_IPCC)                         = NONCO2_coef('4.B','CO2',Country)*valGDP_MP_REAL(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'4.Waste','4.C','Incineration&Open_Burning_of_Waste','CO2','Gg_CO2eq/yr',year_IPCC)                          = NONCO2_coef('4.C','CO2',Country)*valGDP_MP_REAL(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'4.Waste','4.D','Wastewater_Treatment&Discharge','CO2','Gg_CO2eq/yr',year_IPCC)                              = NONCO2_coef('4.D','CO2',Country)*valGDP_MP_REAL(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;

IPCC(model_IPCC, '%CurrentSce%', Country,'5.Other','5.A','Indirect_N2O_emissions','CO2','Gg_CO2eq/yr',year_IPCC)                                      = NONCO2_coef('5.A','CO2',Country)*valGDP_MP_REAL(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
IPCC(model_IPCC, '%CurrentSce%', Country,'5.Other','5.B','Fossil_fuel_fires','CO2','Gg_CO2eq/yr',year_IPCC)                                           = NONCO2_coef('5.B','CO2',Country)*valGDP_MP_REAL(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;

IPCC(model_IPCC, '%CurrentSce%', Country,'6.M&A_Bunker','6.A','Marine_Bunker','CO2','Gg_CO2eq/yr',year_IPCC)                                          = valTCO2_Marine(Country,year_IPCC,'%CurrentSce%')+eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'6.M&A_Bunker','6.B','Aviation_Bunker','CO2','Gg_CO2eq/yr',year_IPCC)                                        = valTCO2_Aviation(Country,year_IPCC,'%CurrentSce%')+eps ;

*CH4
IPCC(model_IPCC, '%CurrentSce%', Country,'1.Energy','1.A.1.a','Main_Electricity_Heat_Production','CH4','Gg_CO2eq/yr',year_IPCC)                       = sum(Supply_elec,valCH4I2(Supply_elec,Country,year_IPCC,'%CurrentSce%'));
