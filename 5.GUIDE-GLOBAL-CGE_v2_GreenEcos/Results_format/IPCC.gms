IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.C.3','Urea_application','F-gas','Gg_CO2eq/yr',year_IPCC)                                          = NONCO2_coef('3.C.3','F-gas',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.C.4','Direct_N2O_Emissions_from managed_soils','F-gas','Gg_CO2eq/yr',year_IPCC)                   = NONCO2_coef('3.C.4','F-gas',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.C.5','Indirect_N2O_Emissions_from_managed_soils','F-gas','Gg_CO2eq/yr',year_IPCC)                 = NONCO2_coef('3.C.5','F-gas',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.C.6','Indirect_N2O_Emissions_from_manure_management','F-gas','Gg_CO2eq/yr',year_IPCC)             = NONCO2_coef('3.C.6','F-gas',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'3.AFOLU','3.C.7','Rice_cultivations','F-gas','Gg_CO2eq/yr',year_IPCC)                                         = NONCO2_coef('3.C.7','F-gas',Country)*valXS('01_AGRICULT','01_AGRICULT',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps ;
 
IPCC(model_IPCC, '%CurrentSce%', Country,'4.Waste','4.A','Solid_Waste_Disposal','F-gas','Gg_CO2eq/yr',year_IPCC)                                        = NONCO2_coef('4.A','F-gas',Country)*valGDP_MP_REAL(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'4.Waste','4.B','Biological_Treatment_of_Solid_Waste','F-gas','Gg_CO2eq/yr',year_IPCC)                         = NONCO2_coef('4.B','F-gas',Country)*valGDP_MP_REAL(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'4.Waste','4.C','Incineration&Open_Burning_of_Waste','F-gas','Gg_CO2eq/yr',year_IPCC)                          = NONCO2_coef('4.C','F-gas',Country)*valGDP_MP_REAL(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'4.Waste','4.D','Wastewater_Treatment&Discharge','F-gas','Gg_CO2eq/yr',year_IPCC)                              = NONCO2_coef('4.D','F-gas',Country)*valGDP_MP_REAL(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps ;
 
IPCC(model_IPCC, '%CurrentSce%', Country,'5.Other','5.A','Indirect_N2O_emissions','F-gas','Gg_CO2eq/yr',year_IPCC)                                      = NONCO2_coef('5.A','F-gas',Country)*valGDP_MP_REAL(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps ;
IPCC(model_IPCC, '%CurrentSce%', Country,'5.Other','5.B','Fossil_fuel_fires','F-gas','Gg_CO2eq/yr',year_IPCC)                                           = NONCO2_coef('5.B','F-gas',Country)*valGDP_MP_REAL(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')+eps ;
    
