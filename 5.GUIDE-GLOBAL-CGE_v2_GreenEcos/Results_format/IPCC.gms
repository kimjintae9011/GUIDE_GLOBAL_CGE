IPCC(model_IPCC, '%CurrentSce%', Country,'2.IPPU','2.A.1','Cement_production','CH4','Gg_CO2eq/yr',year_IPCC)                                          = NONCO2_coef('2.A.1','CH4',Country)*valXS('12_Nonmet','12_Nonmet',Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%')*valNONCO2_RR(Country,year_IPCC,'%CurrentSce%') ;
