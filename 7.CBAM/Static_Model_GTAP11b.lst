 675  *==============================================================================
 676  *   3.1.2 Rescaling the variables
 677  *==============================================================================
 678  * GTAP 8.1 data are in millions of (2004 and 2007) US dollars
 679  * (see www.gtap.agecon.purdue.edu/resources/download/5679.pdf)
 680  * With RES = 10000, model results are in tens of billions (10G$)= 백억
 681  RES              = 10000;
 682  *RES = 1;
 683  * NOTE: In GTAP parlance, "agents' prices" are prices paid by buyers, and
 684  *       "market prices" are prices received by sellers.
 685   
 686  * Household consumption = GTAP domestic purchases (VDPA) + import purchases (VIPA)
 687  * by households at agents' prices.
 688  CO(i,z)          = CO(i,z)/RES;
 689   
 690  * Public final consumption = domestic purchases (VDGA) + import purchases (VIGA)
 691  * by government at agents' prices.
 692  CGO(i,z)         = CGO(i,z)/RES;
 693   
 694  * Domestic purchases = domestic absorption:
 695  * (CO + CGO + INVO + DIO) - [ imports (IMO) + transport margins (tmrg)
 696  *                              + indirect taxes (TICO + TIMO) ]
 697  DDO(i,z)         = DDO(i,z)/RES;
 698   
 699  * Capital depreciation (DEP)
 700  DEPO(z)          = DEPO(z)/RES;
 701   
 702  * Intermediate consumption = domestic purchases (VDFA) + import purchases (VIFA)
 703  * by firms belonging to sectors other than CGDS, at agents' prices.
 704  DIO(i,j,z)       = DIO(i,j,z)/RES;
 705   
 706  * Domestic supply = domestic demand (DDO) in GTAP_AGG.gms
 707  DSO(j,i,z)        = DSO(j,i,z)/RES;
 708  DSO_I(i,z)        = DSO_I(i,z)/RES;
 709   
 710  * Exports = exports at world prices (VXWD) = imports at world prices
 711  * Note: the GTAP variable VXWD is NOT used in the DATA_AGG.gms program; the
 712  * value recorded in DATA_AGG.gdx is actually identical to IMO
 713  EXO(i,z,zj)      = EXO(i,z,zj)/RES;
 714   
 715  * Imports = imports at world prices (VIWS) - sum of transport margins on imports (VTWR)
 716  IMO(i,z,zj)      = IMO(i,z,zj)/RES;
 717   
 718  * Demand for investment purposes = domestic purchases (VDFA)+ import purchases (VIFA)
 719  * by firms of the CGDS sector at agents' prices.
 720  INVO(i,z)        = INVO(i,z)/RES;
 721   
 722  * Total capital stock at the beginning of the period (VKB)
 723  KSTO(z)          = KSTO(z)/RES;
 724   
 725  * Labor demand = Remuneration of labor at market prices, before taxes
 726  * (components of VFM, "primary factor purchases, by households, at market prices")
 727  LDO(l,j,z)       = LDO(l,j,z)/RES;
 728   
 729  * Supply of transport margins at market prices (VST), adjusted proportionately
 730  * so that MRGNO = sum of tmrg for every margin commodity
 731  MRGNO(i,z)       = MRGNO(i,z)/RES;
 732   
 733  * Remuneration of capital at market prices, before taxes
 734  * (components of VFM, "primary factor purchases, by households, at market prices")
 735  RKDO(k,j,z)      = RKDO(k,j,z)/RES;
 736  *RKDO('cap', '29_WTRP','15_RestofWorld') = eps;
 737  * Direct taxes = factor payment at market prices (VFM)
 738  *                - primary factor sales at agents' prices (EVOA)
 739  TDHO(z)          = TDHO(z)/RES;
 740   
 741  * Domestic taxes on commodities = demand at agents' prices - demand at market prices:
 742  * Include 6 pairs of GTAP components
 743  *       VDPA - VDPM
 744  *       VIPA - VIPM
 745  *       VDGA - VDGM
 746  *       VIGA - VIGM
 747  *       VDFA - VDFM
 748  *       VIFA - VIFM
 749  TICO(i,z)        = TICO(i,z)/RES;
 750   
 751  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 752  *                                     - factor-based subsidies (FBEP).
 753  TIKO(k,j,z)      = TIKO(k,j,z)/RES;
 754   
 755  * Import duties = "ordinary" import duties (TFRV)
 756  TIMO(i,z,zj)     = TIMO(i,z,zj)/RES;
 757   
 758  * Taxes on production = MINUS "ordinary output subsidies" (OSEP)
 759  TIPO(j,z)        = TIPO(j,z)/RES;
 760   
 761  * Net taxes on factor of production = factor employment tax revenue (FTRV)
 762  *                                     - factor-based subsidies (FBEP).
 763  TIWO(l,j,z)      = TIWO(l,j,z)/RES;
 764   
 765  * Taxes on exports = export tax equivalent of the Multi-Fiber Agreement (MFA)
 766  * quota premium(MFRV) + "ordinary" export taxes (XTRV)
 767  TIXO(i,z,zj)     = TIXO(i,z,zj)/RES;
 768   
 769  * Transport margins at world prices = sum of margins on imports (VTWR)
 770  tmrg(i,ij,z,zj)  = tmrg(i,ij,z,zj)/RES;
 771   
 772  * Domestic output = domestic supply (DSO) + supply of transport margins (MRGNO)
 773  *                   + exports (EXO) - taxes on exports (TIXO)
 774   
 775  XSO_I(i,z)        = XSO_I(i,z)/RES;
 776  XSO(j,i,z)        = XSO(j,i,z)/RES;
 777  XSTO(j,z)         = XSTO(j,z)/RES;
 778   
 779  *==============================================================================
 780  *  3.3 Exogenous prices and parameters
 781  *==============================================================================
 782   
 783  *  Price elasticity (should be equal to one to verify homogeneity)
 784  eta = 1;
 785   
 786  *==============================================================================
 787  * CES and CET elasticities
 788  *==============================================================================
 789  * CES elasticities are defined using GTAP8.1 data for imports
 790  * (sigma_M1 and sigma_M2) and value added (sigma_VA)
 791  * Other exogenous parameters can be defined if the Excel file VAL_PAR.XLS
 792  PARAMETER
 793  PARZ;
 794  *$exit
 795   
 797  *$exit
**** File: C:\Users\kimc0\GUIDE_GLOBAL_CGE\CBAM\Input_w-1\VAL_PAR_250805.gdx
**** Msg : No such file or directory
 798  $GDXIN Input_w-1\VAL_PAR_250805.gdx
****                                    $510
**** 510  Unable to open gdx file for $GDXIN
 799  $LOAD sigma_KD, sigma_LD, sigma_KLE, sigma_X1, sigma_X2, sigma_X3, sigma_X0, sigma_y, PARZ
****      $502
**** 502  GDXIN  file not open - ignore rest of line
 800   
 801  *------------------------------------------------------------------------------
 802  * CES - composite capital
 803  * We assume that the elasticity between the different type of capital
 804  * is twice that used for value added.
 805  * If the user wishes to assume otherwise, he can fill the appropriate area in
 806  * the Excel file VAL_PAR.xls and delete following line:
 807   sigma_KD(j,z)   = 2*sigma_VA(j,z);
 808   
 809   sigma_M1('04_GAS',Z) = 6;
 810   
 811  * CES - IMP sourcing
 812   sigma_M2('03_OIL',Z) = 2;
 813   sigma_M2('04_GAS',Z) = 2;
 814   
 815   sigma_X2(i,Z)  = 2;
 816   
 817  * CES - composite Power sector
 818   sigma_X4(z)    = 2;
 819   
 820  * sigma_KD(j,z)   = 0.5;
 821  *------------------------------------------------------------------------------
 822  * CES - composite labor
 823  * We assume that the elasticity between the different type of labor
 824  * is twice that used for value added.
 825  * If the user wishes to assume otherwise, he can fill the appropriate area in
 826  * the Excel file VAL_PAR.xls and delete following line:
 827   sigma_LD(j,z)   = 2*sigma_VA(j,z);
 828   
 829  * sigma_LD(j,z)   = 0.5;
 830  *------------------------------------------------------------------------------
 831  * CES - composite KLE, KE, ENER
 832   sigma_KLE('10_PETROLCOAL',z)  = 0.9 ;
 833   sigma_ENER(j,z) = 0.9 ;
 834   
 835  *------------------------------------------------------------------------------
 836  * CET - total output
 837  * We arbitrarily assume that the transformation elasticity between total exports,
 838  * domestic supply and margins is equal to 2 for all sectors and all region.
 839  * If the user wishes to assume otherwise, he can fill the appropriate area in
 840  * the Excel file VAL_PAR.xls.
 841   
 842  *------------------------------------------------------------------------------
 843  * CET - exports
 844  * We arbitrarily assume that the transformation elasticity between exports
 845  * to the different partners is equal to 3 for all sectors and all region.
 846  * If the user wishes to assume otherwise, he can fill the appropriate area in
 847  * the Excel file VAL_PAR.xls.
 848   
 849  *------------------------------------------------------------------------------
 850  * LES parameters - Frisch
 851  * We assume that the Frisch parameter is -1.1 for rich regions/countries and
 852  * -1.5 for other regions/countries.
 853   frisch(zrich)   = -1.1;
 854   frisch(zother)  = -1.5;
 855   
 856  * If the user wishes to assume otherwise, he can fill the appropriate area in
 857  * the Excel file VAL_PAR.xls, delete the previous 2 lines and uncomment the
 858  * following line:
 859   frisch(z)      = PARZ(z,'frisch');
****                       $141       $116
**** 116  Label is unknown
**** 141  Symbol declared but no values have been assigned. Check for missing
****         data definition, assignment, data loading or implicit assignment
****         via a solve statement. Suppress with $onImplicitAssign.
****         A wild shot: You may have spurious commas in the explanatory
****         text of a declaration. Check symbol reference list.
 860   
 861  *------------------------------------------------------------------------------
 862  * LES parameters - Income elasticity of consumption
 863  * We arbitrarily assume that the income elasticity between is the same for all
 864  * region/country.
 865  * If the user wishes to assume otherwise, he can fill the appropriate area in
 866  * the Excel file VAL_PAR.xls.
 867   
 868  *------------------------------------------------------------------------------
 869  *  Slopes of taxation functions
 870  *   One can either choose to assign a value to the intercept and calibrate
 871  *   the slopes accordingly, or the other way around. This type of modelling
 872  *   can be useful to take into account known marginal savings or taxation rates
 873  *   or to deal with negative average saving rates in cases where savings are
 874  *   negative for some household groups.
 875  *   When no further information is available, one can simply set the intercepts
 876  *   to zero and calibrate an average rate: this is what we do here for ttdh0O.
 877  *   If the user wishes to assume otherwise, he can fill the appropriate area in
 878  *   the Excel file VAL_PAR.xls.
 879  * ttdh0O(z)       = PARZ(z,'ttdh0O');
 880   
 881   ttdh0O(z)       = 0;
 882  *   The slope ttdh1O is calibrated below in the mane GAMS file
 883   
 884  *------------------------------------------------------------------------------
 885  *  Elasticity - Investment demand function
 886  * We arbitrarily assume that this elasticity is equal to 2 for all types of
 887  * capital, all sectors and all regions.
 888  * If the user wishes to assume otherwise, he can fill the appropriate area in
 889  * the Excel file VAL_PAR.xls.
 890   
 891  *------------------------------------------------------------------------------
 892  * Also we need to assign values to some prices
 893  * All of the prices below, EXCEPT eO, may be set at arbitrary values
 894  * without loss of generality.
 895  *
 896  * In the case of eO, although exchange rates may be given arbitrary values
 897  * in the model, they must all be equal for calibration at this stage. The reason
 898  * is that the supply of margin transport services MRGNO must equal global demand.
 899  * Since there is a single world price for international transport margins
 900  * (rather than bilateral world prices for other commodities) the unit of
 901  * measurement of the volume of margin services must be the same for all regions,
 902  * and in turn, that implies that the divisor that converts the nominal value to
 903  * volume be the same for all regions. Since that divisor involves the exchange
 904  * rate, all exchange rates must be equal.
 905   
 906  * Normally, prices that may be given arbitrary values are set at 1:
 907   eO(z)           = 1;
 908   PEO(i,z,zj)     = 1;
 909   PLO(i,z)        = 1;
 910   PWMGO(i)        = 1;
 911   WO(l,z)         = 1;
 912   
 913  *==============================================================================
 914  * 4 Calibration
 915  *==============================================================================
 916  *  4.1 Calculation of income and savings related variables and parameters
 917  *==============================================================================
 918   YHKO(z)         = SUM[(k,j),RKDO(k,j,z)];
 919   YHLO(z)         = SUM[(l,j),LDO(l,j,z)];
 920   YHO(z)          = YHLO(z)+YHKO(z);
 921   YDHO(z)         = YHO(z)-TDHO(z);
 922   CTHO(z)         = SUM[i,CO(i,z)];
 923   SHO(z)          = YDHO(z)-CTHO(z);
 924   
 925   TICTO(z)        = SUM[i,TICO(i,z)];
 926   TIMTO(z)        = SUM[(i,zj),TIMO(i,zj,z)];
 927   TIWTO(z)        = SUM[(l,j),TIWO(l,j,z)];
 928   TIKTO(z)        = SUM[(k,j),TIKO(k,j,z)];
 929   TIPTO(z)        = SUM[j,TIPO(j,z)];
 930   TIXTO(z)        = SUM[(i,zj),TIXO(i,z,zj)];
 931   TPRODNO(z)      = TIKTO(z)+TIWTO(z)+TIPTO(z);
 932   TPRCTSO(z)      = TICTO(z)+TIMTO(z)+TIXTO(z);
 933   YGO(z)          = TDHO(z)+TPRCTSO(z)+TPRODNO(z);
 934   GO(z)           = SUM[i,CGO(i,z)];
 935   SGO(z)          = YGO(z)-GO(z);
 936   
 937   YROWO(z)        = SUM[(i,zj),IMO(i,zj,z)]+SUM[(i,ij,zj),tmrg(i,ij,zj,z)];
 938   SROWO(z)        = YROWO(z)-SUM[(i,zj),EXO(i,z,zj)]-SUM[i,MRGNO(i,z)];
 939   CABO(z)         = -SROWO(z);
 940   
 941   ITO(z)          = SHO(z)+SGO(z)+SROWO(z);
 942   
 943  *==============================================================================
 944  *  4.2 Calibration of parameters and other variables
 945  *==============================================================================
 946  *  4.2.1 Calibration of investment and government spending shares
 947  *==============================================================================
 948   gamma_GVT(i,z)  = CGO(i,z)/SUM[ij,CGO(ij,z)];
 949   gamma_INV(i,z)  = INVO(i,z)/SUM[ij,INVO(ij,z)] ;
 950   
 951  *==============================================================================
 952  *  4.2.2 Calibration of other prices and revised volumes (part 1)
 953  *==============================================================================
 954   LDO(l,j,z)      = LDO(l,j,z)/WO(l,z);
 955   LDCO(j,z)       = SUM[l,LDO(l,j,z)];
 956   LDCO('01_AGRICULT','01_KOR')       = 1.629;
 957   LSO(l,z)        = SUM[j,LDO(l,j,z)];
 958   EXO(i,z,zj)     = [EXO(i,z,zj)-TIXO(i,z,zj)]/PEO(i,z,zj);
 959   EXTO(i,z)       = SUM[zj,EXO(i,z,zj)];
 960   
 961   PWXO(i,z,zj)$EXO(i,z,zj)
 962                   = {[PEO(i,z,zj)*EXO(i,z,zj)+TIXO(i,z,zj)]/EXO(i,z,zj)}/eO(z);
 963   
 964   PETO(i,z)       = SUM[zj,PEO(i,z,zj)*EXO(i,z,zj)]/EXTO(i,z);
 965   PWMO(i,z,zj)    = PWXO(i,z,zj);
 966   IMO(i,zj,z)     = EXO(i,zj,z);
 967   IMTO(i,z)       = SUM[zj,IMO(i,zj,z)];
 968   
 969   DSO(j,i,z)       = DSO(j,i,z)/PLO(i,z);
 970   DSO_I(i,z)       = SUM(j,DSO(j,i,z));
 971   DSO_J(j,z)       = SUM(i,DSO(j,i,z));
 972   QO(i,z)         = IMTO(i,z)+DDO(i,z);
 973   
 974   MRGNO(i,z)$MRGNO(i,z)
 975                   = MRGNO(i,z)/[eO(z)*PWMGO(i)];
 976   
 977   XSO_I(i,z)      = EXTO(i,z)+DDO(i,z)+MRGNO(i,z);
 978   XSTO(j,z)       = sum(i, XSO(j,i,z));
 979   
 980   IMO2(zj,z)      = sum(i,IMO(i,zj,z));
 981   
 982   PO(i,z)        = [PETO(i,z)*EXTO(i,z)+PLO(i,z)*DSO_I(i,z)
 983                    +eO(z)*PWMGO(i)*MRGNO(i,z)]/XSO_I(i,z);
 984   
 985   PO2(j,i,z)$XSO(j,i,z) = 1;
 986   
 987   PO3(i,j,z)$XSO(j,i,z) = 1;
 988   
 989   PIO(i,z)       = SUM[j$XSO(j,i,z),PO2(J,I,z)*XSO(j,i,z)]/XSO_I(i,z);
 990   
 991   PTO(j,z)       = SUM[i$XSO(j,i,z),PO2(j,i,z)*XSO(j,i,z)]/XSTO(j,z);
 992   
 993   PPO(j,z)       = [SUM[l,TIWO(l,j,z)+WO(l,z)*LDO(l,j,z)]
 994                    +SUM[k,TIKO(k,j,z)+RKDO(k,j,z)]
 995                    +SUM[nene,DIO(nene,j,z)]+SUM[ene,DIO(ene,j,z)]]/XSTO(j,z);
 996   
 997   
 998   theta2(j,i,z) = DSO(j,i,z)/sum(jj, DSO(jj,i,z));
 999   
1000   EXTTO(j,i,z)$DSO(j,i,z) = theta2(j,i,z)*EXTO(i,z);
1001   
1002  *==============================================================================
1003  *  4.3 Calibration of tax rates, margins, prices and volumes
1004  *==============================================================================
1005  *  4.3.1 Margin rates and tax rates
1006  *==============================================================================
1007   ttixO(i,z,zj)   = [eO(z)*PWXO(i,z,zj)/PEO(i,z,zj)]-1;
1008   tticO(i,z)      = TICO(i,z)/{PLO(i,z)*DDO(i,z)
1009                     +SUM[zj,IMO(i,zj,z)*eO(z)*PWMO(i,zj,z)
1010                     +TIMO(i,zj,z)+SUM[ij,tmrg(ij,i,zj,z)]]};
1011   
1012   tmrg(i,ij,zj,z)$IMO(ij,zj,z)
1013                   = tmrg(i,ij,zj,z)/(PWMGO(i)*eO(z)*IMO(ij,zj,z));
1014   
1015   ttimO(i,zj,z)$IMO(i,zj,z)
1016                   = TIMO(i,zj,z)/{IMO(i,zj,z)*eO(z)*(PWMO(i,zj,z)
1017                    +SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)])};
1018   
1019   ttiwO(l,j,z)$LDO(l,j,z)
1020                   = TIWO(l,j,z)/[WO(l,z)*LDO(l,j,z)];
1021   
1022   ttikO(k,j,z)$RKDO(k,j,z)
1023                   = TIKO(k,j,z)/RKDO(k,j,z);
1024   
1025   ttipO(j,z)   = [PTO(j,z)/PPO(j,z)]-1;
1026   
1027   ttdh1O(z)       = [TDHO(z)-ttdh0O(z)]/YHO(z);
1028   
