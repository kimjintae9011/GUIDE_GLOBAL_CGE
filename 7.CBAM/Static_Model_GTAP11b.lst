2837  *  4.11 CO2FACTOR and CTAX
2838  *==============================================================================
2839  Parameters
2840   CO2FACTOR(ene,j,z)     CO2 emissions factor (tCO2 per 100$)
2841   CTAX0(z)               initial Carbon tax 100$ per ton CO2
2842   TCTAX0(z)              initial Government Revenue from Carbon tax
2843  ;
2844   
2845   CO2FACTOR(ene,j,z) = 0 ;
2846   CO2FACTOR('02_COAL',j,z)$DEO('02_COAL',j,z) = [sum(p_coal,CO2IO(p_coal,j,z))/DEO('02_COAL',j,z)]*(1000/(10**8));
2847   CO2FACTOR('04_GAS',j,z)$DEO('04_GAS',j,z) = [sum(p_gas,CO2IO(p_gas,j,z))/DEO('04_GAS',j,z)]*(1000/(10**8));
2848   CO2FACTOR('10_PETROLCOAL',j,z)$DEO('10_PETROLCOAL',j,z) = [sum(p_oilproduct,CO2IO(p_oilproduct,j,z))/DEO('10_PETROLCOAL',j,z)]*(1000/(10**8));
2849   
2850   CO2FACTOR('10_PETROLCOAL','10_PETROLCOAL',z) = 0;
2851   
2852   CTAX0(z) = 0;
2853   TCTAX0(z) = 0;
2854   
2855   TCBAMO(z3) = sum((i,zj), CP0(zj)*CO2ICO(i,zj)*IMO(i,zj,z3)*PWMO(i,zj,z3));
2856   
2857   ttip_shareO(j,z) = XSTO(j,z)/sum(jj, XSTO(j,z));
2858   deltattipO(j,z)  = -ttip_shareO(j,z)*TCBAMO(z)/(XSTO(j,z)*PPO(j,z));
2859   
2860   ttiw_shareO(l,j,z) = LDO(l,j,z)/SUM((lj,jj),LDO(l,jj,z));
2861   deltattiwO(l,j,z)  = -ttiw_shareO(l,j,z)*TCBAMO(z)/WO(l,z)*LDO(l,j,z);
