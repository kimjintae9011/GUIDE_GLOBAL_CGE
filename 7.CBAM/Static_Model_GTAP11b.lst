1935  ;
1936  *
1937   
1938  *f_balstfur(flow)
1939  *f_cokeoven(flow)
1940  * WEB(f_balstfur, 'p4_COKCOAL', z) = WEB(f_cokeoven, 'p66_TOTAL', z) ;
1941  * WEB(f_cokeoven, 'p4_COKCOAL', z) = WEB(f_cokeoven, 'p66_TOTAL', z) ;
1942   
1943   TCoke_Share(f_cokeoven,p_coal,z)$(WEB(f_cokeoven, p_coal, z) lt 0)  = WEB(f_cokeoven, p_coal, z)$(WEB(f_cokeoven, p_coal, z) lt 0)/sum(p_coal2, WEB(f_cokeoven, p_coal2, z)$(WEB(f_cokeoven, p_coal2, z) lt 0)) ;
1944   TBlast_Share(f_balstfur,p_coal,z)$(WEB(f_balstfur, p_coal, z) lt 0) = WEB(f_balstfur, p_coal, z)$(WEB(f_balstfur, p_coal, z) lt 0)/sum(p_coal2, WEB(f_balstfur, p_coal2, z)$(WEB(f_balstfur, p_coal2, z) lt 0)) ;
1945   
1946  display TCoke_Share, TBlast_Share ;
1947   
1948  *Coal
1949   Coal_DIO(p_coal,'01_AGRICULT',z) = sum((f_agri), WEB(f_agri, p_coal, z));
1950   Coal_DIO(p_coal,'02_COAL',z) = -1*sum((f_coa), WEB(f_coa, p_coal, z));
1951   Coal_DIO(p_coal,'03_OIL',z) = -1*sum((f_oil), WEB(f_oil, p_coal, z));
1952   Coal_DIO(p_coal,'04_GAS',z) = -1*sum((f_gas), WEB(f_gas, p_coal, z));
1953   Coal_DIO(p_coal,'05_MINING',z) = sum((f_mining), WEB(f_mining, p_coal, z));
1954   Coal_DIO(p_coal,'06_FOODPRO',z) = sum((f_foodpro), WEB(f_foodpro, p_coal, z));
1955   Coal_DIO(p_coal,'07_TEXTILES',z) = sum((f_textiles), WEB(f_textiles, p_coal, z));
1956   Coal_DIO(p_coal,'08_WOODPRO',z) = sum((f_woodpro), WEB(f_woodpro, p_coal, z));
1957   Coal_DIO(p_coal,'09_PAPERPRO',z) = sum((f_paperpro), WEB(f_paperpro, p_coal, z));
1958   Coal_DIO(p_coal,'10_PETROLCOAL',z) = -1*sum((f_petrolcoal), WEB(f_petrolcoal, p_coal, z));
1959   Coal_DIO(p_coal,'11_CHEMICAL',z) = sum((f_chemical), WEB(f_chemical, p_coal, z));
1960   Coal_DIO(p_coal,'12_NONMET',z) = sum((f_nonmet), WEB(f_nonmet, p_coal, z));
1961   Coal_DIO(p_coal,'13_IRONSTL',z) = sum((f_ironstl), WEB(f_ironstl, p_coal, z))
1962   + sum(f_cokeoven, -1*TCoke_Share(f_cokeoven,p_coal,z)*WEB(f_cokeoven, 'p66_TOTAL', z))
1963   + sum(f_balstfur, -1*TBlast_Share(f_balstfur,p_coal,z)*WEB(f_balstfur, 'p66_TOTAL', z))
1964   + sum((f_Eblastcoke), -1*WEB(f_Eblastcoke, p_coal, z))
