2813   EHI(p_oilproduct,z)$(CO('10_PETROLCOAL',z) gt 0)        = Oilp_CO(p_oilproduct,z)/CO('10_PETROLCOAL',z);
2814   EHI(p_elecheat,z)$(CO('18_ELEC',z) gt 0)                = Elec_CO(p_elecheat,z)/CO('18_ELEC',z);
2815   
2816   EEO(p_coal,j,z)       = Coal_DIO(p_coal,j,z) ;
2817   EEO(p_gas,j,z)        = Gas_DIO(p_gas,j,z) ;
2818   EEO(p_oil,j,z)        = Oil_DIO(p_oil,j,z) ;
2819   EEO(p_oilproduct,j,z) = Oilp_DIO(p_oilproduct,j,z) ;
2820   EEO(p_elecheat,j,z)   = Elec_DIO(p_elecheat,j,z) ;
2821   
2822   NEO(p_coal,j,z)       = NCoal_DIO(p_coal,j,z) ;
2823   NEO(p_gas,j,z)        = NGas_DIO(p_gas,j,z) ;
2824   NEO(p_oilproduct,j,z) = NOilp_DIO(p_oilproduct,j,z) ;
2825   
