2386  *execute_unload 'DIO_wKLEM', DEO, DIO ;
2387   
2388  *==============================================================================
2389  *  4.3.2 Calibration of other prices and revised volumes (part 2)
2390  *==============================================================================
2391   PDO(i,z)        = PLO(i,z)*(1+tticO(i,z));
2392   PMO(i,zj,z)     = eO(z)*(1+tticO(i,z))*(1+ttimO(i,zj,z))
2393                     *(PWMO(i,zj,z)+SUM[ij,PWMGO(ij)*tmrg(ij,i,zj,z)]+CP0(zj)*CO2ICO(i,zj)*eO(z)*PWMO(i,zj,z));
2394   PMTO(i,z)       = SUM[zj,PMO(i,zj,z)*IMO(i,zj,z)]/IMTO(i,z);
2395   PCO(i,z)        = [PMTO(i,z)*IMTO(i,z)+PDO(i,z)*DDO(i,z)]/QO(i,z);
2396   CO(i,z)         = CO(i,z)/PCO(i,z);
2397   CGO(i,z)        = CGO(i,z)/PCO(i,z);
2398   DIO(nene,j,z)   = DIO(nene,j,z)/PCO(nene,z);
2399   DEO(ene,j,z)    = DIO(ene,j,z)/PCO(ene,z);
2400   INVO(i,z)       = INVO(i,z)/PCO(i,z);
2401   CIO(j,z)        = SUM[nene,DIO(nene,j,z)];
2402   CEO(j,z)        = SUM[ene,DEO(ene,j,z)];
2403   
2404   DITO(nene,z)     = SUM[j,DIO(nene,j,z)];
2405   DITO(ene,z)      = SUM[j,DEO(ene,j,z)];
2406   
2407   PO4(ene,j,z)    = PCO(ene,z);
2408   
2409   PCIO(j,z)       = SUM[nene,PCO(nene,z)*DIO(nene,j,z)]/CIO(j,z);
2410   PCEO(j,z)       = SUM[ene,PCO(ene,z)*DEO(ene,j,z)]/CEO(j,z) ;
2411   
2412   WTIO(l,j,z)     = WO(l,z)*(1+ttiwO(l,j,z));
2413   
2414   WCO(j,z)$LDCO(j,z)
2415                   = SUM[l,WTIO(l,j,z)*LDO(l,j,z)]/LDCO(j,z);
2416   
2417  *==============================================================================
2418  *  4.3.3 Calibration of other prices and revised volumes (part 3)
2419  *==============================================================================
2420  * The price of capital is arbitrary:
2421   PKO(z) = 1;
2422   
2423  * The calibration of depreciation rates is based on two hypotheses:
2424  * 1. The rate of depreciation is the same for all types of capital and all
2425  *    industries in each region (this hypothesis is made to accommodate the fact
2426  *    that, in the GTAP data base, capital consumption allowance is not detailed;
2427  *    as a matter of fact, the GTAP capital consumption allowance is set at
2428  *    4% of the value of the capital stock).
2429  * 2. The rental rate of capital is uniform across industries and types of
2430  *    capital in each region.
2431  * These hypotheses lead to the following formula:
2432   
2433  * From GTAP, we know KSTO.
2434   KSTO(z)         = KSTO(z)/PKO(z);
2435   
2436  * Assuming a uniform depreciation rate for all types
2437  * of capital and all industries:
2438   delta(z)        = DEPO(z)/[PKO(z)*KSTO(z)];
2439   
2440  *display delta, DEPO, PKO, KSTO ;
2441   
2442  * From GTAP, we know KSTO. Assuming a uniform rental rate R for all types
2443  * of capital and all industries:
2444   RKO(k,z)        = SUM[(kj,jj),RKDO(kj,jj,z)]/KSTO(z);
2445   RKO(k,z)        =1;
2446   
2447   RO(k,j,z)$RKDO(k,j,z)
2448                   = RKO(k,z);
2449   
2450  * Then from the GTAP value of income paid to capital RKD we calibrate KDO:
2451   KDO(k,j,z)$RKDO(k,j,z)
2452                   = RKDO(k,j,z)/RO(k,j,z);
2453   
2454  * The supply of capital is equal to demand:
2455   KSO(k,z)        = SUM[j,KDO(k,j,z)];
2456   
2457   A_K(z)          = 1/PKO(z)*{PROD[i$gamma_INV(i,z),(PCO(i,Z)/gamma_INV(i,z))
2458                     **gamma_INV(i,z)]};
2459   
2460   KDCO(j,z)       = SUM[k,KDO(k,j,z)];
2461   
2462   RTIO(k,j,z)     = RO(k,j,z)*(1+ttikO(k,j,z));
2463   RCO(j,z)$KDCO(j,z)
2464                   = SUM[k,RTIO(k,j,z)*KDO(k,j,z)]/KDCO(j,z);
2465   
2466  *display KDO, RKDO, RO
2467   
2468  *==============================================================================
2469  *  4.3.4 Calibration of other prices and revised volumes (part 4)
2470  *==============================================================================
2471   VAO(j,z)        = LDCO(j,z)+KDCO(j,z);
2472   
2473   
2474   PVAO(j,z)       = [WCO(j,z)*LDCO(j,z)+RCO(j,z)*KDCO(j,z)]/VAO(j,z);
2475   
2476  * PIXGDPO is tautologically equal to 1, based on its formula
2477  * PIXGDPO(z)      = {SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
2478  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
2479  *                   *SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]
2480  *                   /SUM[j,{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]}**0.5;
2481   PIXGDPO(z)      = 1;
2482   
2483  * PIXGDP_WO is tautologically equal to 1, based on its formula
2484  * PIXGDP_WO       = {SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
2485  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
2486  *                   *SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)/eO(z)]
2487  *                   /SUM[(j,z),{(PVAO(j,z)*VAO(j,z)+TIPO(j,z))/VAO(j,z)}*VAO(j,z)]/eO(z)}**0.5;
2488   PIXGDP_WO       = 1;
2489   
2490  * PIXCONO(z) is tautologically equal to 1, based on its formula
2491  * PIXCONO(z)      = SUM[i,PCO(i,z)*CO(i,z)]
2492  *                  /SUM[i,PCO(i,z)*CO(i,z)];
2493   PIXCONO(z)      = 1;
2494   
2495  * PIXINVO(z) is tautologically equal to 1, based on its formula
