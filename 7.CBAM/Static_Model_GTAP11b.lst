2343   
2344  ***Direct emissions
2345   CO2IO(p_coal,j,z)$Coal_DIO(p_coal,j,z) = Coal_DIO(p_coal,j,z)*41.868*GHGsEF(p_coal,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
****                                                                             $141
**** LINE   1067 INPUT       C:\Users\kimc0\GUIDE_GLOBAL_CGE\CBAM\Static_Model_GTAP11b.gms
**** 141  Symbol declared but no values have been assigned. Check for missing
****         data definition, assignment, data loading or implicit assignment
****         via a solve statement. Suppress with $onImplicitAssign.
****         A wild shot: You may have spurious commas in the explanatory
****         text of a declaration. Check symbol reference list.
2346   CO2IO(p_gas,j,z)$Gas_DIO(p_gas,j,z)  = Gas_DIO(p_gas,j,z)*41.868*GHGsEF(p_gas,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
2347   CO2IO(p_oilproduct,j,z)$Oilp_DIO(p_oilproduct,j,z)  = Oilp_DIO(p_oilproduct,j,z)*41.868*GHGsEF(p_oilproduct,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
2348   
2349   CO2HO(p_coal,z)$Coal_CO(p_coal,z) = Coal_CO(p_coal,z)*41.868*GHGsEF(p_coal,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
2350   CO2HO(p_gas,z)$Gas_CO(p_gas,z) = Gas_CO(p_gas,z)*41.868*GHGsEF(p_gas,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
2351   CO2HO(p_oilproduct,z)$Oilp_CO(p_oilproduct,z) = Oilp_CO(p_oilproduct,z)*41.868*GHGsEF(p_oilproduct,'CO2EF')*1*(44/12)*0.001*GWP('CO2EF') ;
2352   
2353  ***Indirect emissions
2354   CO2IO(p_elec,j,z) = {sum((p_coal,elec),CO2IO(p_coal,elec,z))+sum((p_oilproduct,elec),CO2IO(p_oilproduct,elec,z))+sum((p_gas,elec),CO2IO(p_gas,elec,z))}*{sum(p_elecheat,Elec_DIO(p_elecheat,j,z))/sum((p_elecheat,jj),Elec_DIO(p_elecheat,jj,z))};
2355   
2356  ***Total emissions
2357   TCO2IO(j,z)  = sum(product, CO2IO(product,j,z));
2358   
2359  ***carbon content
2360  * CO2ICO(i,zj)  = TCO2IO(j,zj)*10**7/XSTO(j,zj);
2361   XSTO2(i,zj)   = sum(j$(INDtoCOM(j,i)),XSTO(j,zj));
2362   TCO2IO2(i,z)  = sum(j$(INDtoCOM(j,i)),TCO2IO(j,z));
2363   CO2ICO(i,zj)  = TCO2IO2(i,zj)/XSTO2(i,zj)*1e-7;
2364   CO2ICO(i3,zj) = 0 ;
2365   CP0(z)=0;
2366   
