2827   EHO(p_gas,z)          = Gas_CO(p_gas,z) ;
2828   EHO(p_oil,z)          = Oil_CO(p_oil,z) ;
2829   EHO(p_oilproduct,z)   = Oilp_CO(p_oilproduct,z) ;
